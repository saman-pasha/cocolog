;;;; cocolog -- a re-read in swipl's order, assert, consult and retract
;;;
;;; A PIECE OF THE KNOWLEDGE BASE, split out of lib/kb.cicili for size
;;; (2.16.1, where that file had reached 8 080 lines). The four pieces are ONE
;;; translation unit, emitted in this order by cocolog.cicili and by the test
;;; binaries that link the store: kb, kb-compile, kb-pred, kb-consult. So a
;;; function here calls only what an earlier piece defined or `decl-kb'
;;; declared, exactly as when they were one file. lib/kb.cicili keeps the
;;; compiler's tables and macros and every declaration.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

(generic impl-kb-consult
  ()

  ;;; ---- a re-read in swipl's order (2.14.1) --------------------------------
  ;;;
  ;;; SWI'S RELOAD KEEPS WHAT DID NOT CHANGE WHERE IT STOOD, and puts what
  ;;; is new beside it. Probed against swipl 9.0.4 (test/files/
  ;;; reload_order.pl): a pointer starts at the predicate's first clause,
  ;;; and each clause the file says now looks from it for one equal to it
  ;;; -- a variant, whatever its variables are called -- that the file put
  ;;; there before or that no file did (asserted). Found, that one stays
  ;;; where it stands (an asserted one becomes the file's) and the pointer
  ;;; moves past it; not found, the new clause goes in before the pointer.
  ;;; What the file put there and does not say again goes. Another file's
  ;;; clause is never a candidate, nor anything behind the pointer, and a
  ;;; file read for the first time appends. So `[asserted]' re-read with
  ;;; `[file2, file3]' is `[file2, file3, asserted]', where through 2.14.0
  ;;; the new clauses went after it.
  ;;;
  ;;; HERE THE FILE'S OLD CLAUSES STILL GO AT ITS FIRST CLAUSE, as through
  ;;; 2.14.0 (`coco_pred_forget_from', which keeps the logical update view):
  ;;; between the clauses of the read they are out of sight, as swipl's are,
  ;;; erased until a clause matches them. A match puts the new clause where
  ;;; the old one stood -- the same clause in the same place. A candidate is
  ;;; looked up by its shape (`coco_reload_hash') and told by a walk of it
  ;;; beside the new clause (`coco_reload_variant'). The pointer is
  ;;; an ordinal into the clauses the predicate held at the first clause
  ;;; (O, `coco_reload'), and "before the pointer" is before the first of
  ;;; them from it that is still there, found by its cell. A predicate that
  ;;; held nothing but the file's own clauses needs none of it: every clause
  ;;; goes after the last, which is that order, and it has no state.
  ;;;
  ;;; What differs, and is stated: a muted read (a module read again) adopts
  ;;; no asserted clause, whose rows the knowledge base keeps; a directive
  ;;; that asserts at the end of the predicate being read puts it before
  ;;; the read's next clauses where swipl puts it after them when the pointer
  ;;; still stands on a clause of the file's; and a compaction while the
  ;;; read runs (a directive's four million cells of garbage) moves every
  ;;; cell O holds, after which the read's clauses of the predicate go after
  ;;; its last clause.

  (static)
  (func coco_reload_free ((coco_reload * rl))
        (if (== rl nil) (return))
        (free (cast (void *) (-> rl cell)))
        (free (cast (void *) (-> rl kind)))
        (free (cast (void *) (-> rl hash)))
        (free (cast (void *) (-> rl bnext)))
        (free (cast (void *) (-> rl bhead)))
        (free (cast (void *) rl)))

  ;;; A TERM'S CELL, past its references, on the heap or -- IN -- in the
  ;;; store, which lays a compound out as the heap does and shares the
  ;;; machine's tables of floats, strings and numbers: T's index is
  ;;; answered and its cell put in C.
  (static) (inline)
  (func coco_reload_at ((coco_machine * m) (coco_store * st) (size_t t) (int in)
                        (u64 * c)) (out size_t)
        (if in
            (block (set t (coco_store_deref st t)) (set (cof c) (nth t (-> st cells))))
          (block (set t (coco_deref m t)) (set (cof c) (nth t (-> m heap)))))
        (return t))

  ;;; THE SHAPE A RELOAD LOOKS UP A CLAUSE BY: a hash of the term T, on the
  ;;; heap or IN the store, that two variants share -- each functor, atom
  ;;; and number, the bytes of each string, in the order a walk from the
  ;;; left meets them, and a variable as a variable, whichever it is. One
  ;;; term hashes alike in either place. Two clauses of one hash are told
  ;;; apart by `coco_reload_variant'. A walk, not the text the store
  ;;; writes, and of the clause where it lies: written out, a re-read beside
  ;;; the program's clauses cost three times the read (2.14.1's first cut).
  (static)
  (func coco_reload_hash ((coco_machine * m) (coco_store * st) (size_t t) (int in)) (out u64)
        (let ((u64 h . 1469598103934665603) (size_t * wl . nil) (size_t wlen . 0)
              (size_t wcap . 0) (int ok . 1) (int running . 1))
          (set wl (coco_wpairs_take m (aof wcap)))
          (while running
            (let ((u64 c . 0) (u64 v . 0) (size_t a . #'(coco_reload_at m st t in (aof c))))
              (set h (* (xor h (cast u64 (coco-tag c))) 1099511628211))
              (cond
                ((coco-tag-is REF c) (set v 0))
                ((coco-tag-is FLT c)
                 (let ((double x . #'(nth (cast size_t (coco-payload c)) (-> m floats))))
                   (memcpy (aof v) (aof x) (sizeof double))))
                ((coco-tag-is STR c)
                 (let ((size_t i . #'(cast size_t (coco-payload c))))
                   (set v (cast u64 ($ (nth i (-> m strings)) n)))
                   (for ((size_t j . 0)) (< j ($ (nth i (-> m strings)) n)) ((++ j))
                     (set h (* (xor h (cast u64 (bitand (cast int (nth j ($ (nth i (-> m strings)) p))) 255)))
                               1099511628211)))))
                ((coco-tag-is BIG c)
                 (set v (cast u64 (nth (cast size_t (coco-payload c)) (-> m bigs)))))
                ((coco-tag-is RAT c)
                 (let ((size_t i . #'(coco-rat-index c)))
                   (set v (xor (cast u64 ($ (nth i (-> m rats)) n))
                               (* (cast u64 ($ (nth i (-> m rats)) d)) 1099511628211)))))
                ;; an atom, an integer, a functor: the cell is the identity
                (#t (set v c)))
              (set h (* (xor h v) 1099511628211))
              ;; a compound's arguments are the cells after its header
              (if (coco-tag-is FUN c)
                  (let ((u32 n . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity)))
                    (for ((u32 i . n)) (> i 0) ((set i (- i 1)))
                      (if (and ok (not (coco_pairs_push m (aof wl) (aof wlen) (aof wcap)
                                                        (+ a (cast size_t i)) 0)))
                          (set ok 0))))))
            ;; no memory for the walk: the hash so far, which only costs a
            ;; variant its match
            (if (or (not ok) (== wlen 0))
                (set running 0)
              (block
               (set t (nth (- wlen 2) wl))
               (set wlen (- wlen 2)))))
          (coco_wpairs_give m wl wcap)
          (return h)))

  ;;; WHETHER THE HEAP TERM A AND THE STORE'S TERM S ARE VARIANTS: one
  ;;; shape, and each variable of one where one variable of the other
  ;;; stands. The map holds both ways, A's variable to S's and S's to A's,
  ;;; a store index keyed past every heap one (2^39 on). 0 too when there
  ;;; was no memory for the walk.
  (static)
  (func coco_reload_variant ((coco_machine * m) (coco_store * st) (size_t a) (size_t s))
        (out int)
        (let ((size_t * wl . nil) (size_t wlen . 0) (size_t wcap . 0)
              (int ok . 1) (int running . 1) (coco_varmap vm)
              (size_t far . #'(<< (cast size_t 1) 39)))
          (set wl (coco_wpairs_take m (aof wcap)))
          (coco_varmap_take m (aof vm))
          (while running
            (let ((u64 ca . 0) (u64 cs . 0))
              (set a (coco_reload_at m st a 0 (aof ca)))
              (set s (coco_reload_at m st s 1 (aof cs)))
              (cond
                ((coco-tag-is REF ca)
                 (if (not (coco-tag-is REF cs))
                     (set ok 0)
                   (let ((size_t x . 0))
                     (if (coco_varmap_get (aof vm) a (aof x))
                         (if (!= x s) (set ok 0))
                       (if (coco_varmap_get (aof vm) (+ s far) (aof x))
                           (set ok 0)
                         (if (not (and (coco_varmap_put (aof vm) a s)
                                       (coco_varmap_put (aof vm) (+ s far) a)))
                             (set ok 0)))))))
                ((coco-tag-is REF cs) (set ok 0))
                ((!= (coco-tag ca) (coco-tag cs)) (set ok 0))
                ((coco-tag-is FLT ca) (if (not (coco_flt_eq m ca cs)) (set ok 0)))
                ((coco-tag-is STR ca) (if (not (coco_str_eq m ca cs)) (set ok 0)))
                ((coco-tag-is RAT ca) (if (not (coco_rat_eq m ca cs)) (set ok 0)))
                ((coco-tag-is BIG ca)
                 (if (!= (nth (cast size_t (coco-payload ca)) (-> m bigs))
                         (nth (cast size_t (coco-payload cs)) (-> m bigs)))
                     (set ok 0)))
                ;; an atom, an integer, a functor: the cells, and a functor's
                ;; arguments after it, in both places
                ((!= ca cs) (set ok 0))
                ((coco-tag-is FUN ca)
                 (let ((u32 n . #'($ (nth (cast size_t (coco-payload ca)) (-> m functors)) arity)))
                   (for ((u32 i . n)) (> i 0) ((set i (- i 1)))
                     (if (and ok (not (coco_pairs_push m (aof wl) (aof wlen) (aof wcap)
                                                       (+ a (cast size_t i)) (+ s (cast size_t i)))))
                         (set ok 0)))))
                (#t (block))))
            (if (or (== ok 0) (== wlen 0))
                (set running 0)
              (block
               (set s (nth (- wlen 1) wl))
               (set a (nth (- wlen 2) wl))
               (set wlen (- wlen 2)))))
          (coco_varmap_give m (aof vm))
          (coco_wpairs_give m wl wcap)
          (return ok)))

  ;;; THE RELOAD OF PI, begun at the file's first clause of it: O, the
  ;;; clauses PI holds then, each one's kind -- the file's own (ORIGIN, of
  ;;; the store's mute MUTE), asserted (no file, no module: a candidate
  ;;; only in a read that is not muted, whose adoption the knowledge base
  ;;; can be told), or another's -- and the candidates in buckets by their
  ;;; shapes (`coco_reload_hash'). Taken BEFORE the file's old clauses go;
  ;;; their cells stay in the store, orphaned, until it compacts. Nil when
  ;;; O holds nothing but the file's own clauses, the new ones then going
  ;;; after the last in the order the file says them, or when there is no
  ;;; memory, which places them as a first read does.
  (static)
  (func coco_reload_begin ((coco_store * st) (coco_machine * m) (size_t pi)
                           (u64 origin) (int mute)) (out coco_reload *)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (size_t n . 0) (size_t present . 0) (size_t ncand . 0) (size_t k . 0)
              (coco_reload * rl . nil))
          (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
            (if (not (coco_pred_dead p i))
                (block
                 (set n (+ n 1))
                 (if (not (and (== (nth i (-> p origins)) origin) (== (nth i (-> p muted)) mute)))
                     (set present (+ present 1))))))
          (if (== present 0) (return nil))
          (set rl (cast (coco_reload *) (calloc 1 (sizeof coco_reload))))
          (if (== rl nil) (return nil))
          (set (-> rl n) n)
          (set (-> rl cell) (cast (size_t *) (calloc n (sizeof size_t))))
          (set (-> rl kind) (cast (u8 *) (calloc n 1)))
          (set (-> rl hash) (cast (u64 *) (calloc n (sizeof u64))))
          (set (-> rl bnext) (cast (size_t *) (calloc n (sizeof size_t))))
          (if (or (== (-> rl cell) nil) (== (-> rl kind) nil) (== (-> rl hash) nil)
                  (== (-> rl bnext) nil))
              (block (coco_reload_free rl) (return nil)))
          (set (-> rl ncomp) (-> st ncompacts))
          ;; O in order, each candidate's shape read where it lies in the store
          (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
            (if (not (coco_pred_dead p i))
                (let ((u64 o . #'(nth i (-> p origins))) (int mu . #'(nth i (-> p muted))))
                  (set (nth k (-> rl cell)) (nth i (-> p clauses)))
                  (cond
                    ((and (== o origin) (== mu mute)) (set (nth k (-> rl kind)) 1))
                    ((and (not mute) (== o 0) (== mu 0)) (set (nth k (-> rl kind)) 2))
                    (#t (set (nth k (-> rl kind)) 0)))
                  (if (!= (nth k (-> rl kind)) 0)
                      (block
                       (set (nth k (-> rl hash)) (coco_reload_hash m st (nth i (-> p clauses)) 1))
                       (set ncand (+ ncand 1))))
                  (set k (+ k 1)))))
          ;; the buckets, each one's chain in ascending order
          (set (-> rl nb) 8)
          (while (< (-> rl nb) (* ncand 2)) (set (-> rl nb) (* (-> rl nb) 2)))
          (set (-> rl bhead) (cast (size_t *) (calloc (-> rl nb) (sizeof size_t))))
          (if (== (-> rl bhead) nil) (block (coco_reload_free rl) (return nil)))
          (set k n)
          (while (> k 0)
            (set k (- k 1))
            (if (!= (nth k (-> rl kind)) 0)
                (let ((size_t b . #'(cast size_t (bitand (nth k (-> rl hash))
                                                         (cast u64 (- (-> rl nb) 1))))))
                  (set (nth k (-> rl bnext)) (nth b (-> rl bhead)))
                  (set (nth b (-> rl bhead)) (+ k 1)))))
          (return rl)))

  ;;; THE CANDIDATE FOR THE NEW CLAUSE CLAUSE, of shape H: O's first from
  ;;; the pointer that is the file's own or asserted and a variant of it
  ;;; (`coco_reload_variant', where it lies in the store), or O's length
  ;;; for none. A bucket's chain is ascending, and what the pointer
  ;;; has passed is dropped from its head for good.
  (static)
  (func coco_reload_find ((coco_store * st) (coco_machine * m) (coco_reload * rl)
                          (size_t clause) (u64 h)) (out size_t)
        (let ((size_t b . #'(cast size_t (bitand h (cast u64 (- (-> rl nb) 1)))))
              (size_t j . 0))
          (while (and (!= (nth b (-> rl bhead)) 0)
                      (< (- (nth b (-> rl bhead)) 1) (-> rl ptr)))
            (set (nth b (-> rl bhead)) (nth (- (nth b (-> rl bhead)) 1) (-> rl bnext))))
          (set j (nth b (-> rl bhead)))
          (while (!= j 0)
            (let ((size_t i . #'(- j 1)))
              (if (and (or (== (nth i (-> rl kind)) 1) (== (nth i (-> rl kind)) 2))
                       (== (nth i (-> rl hash)) h))
                  (if (coco_reload_variant m st clause (nth i (-> rl cell))) (return i)))
              (set j (nth i (-> rl bnext)))))
          (return (-> rl n))))

  ;;; WHERE O'S CLAUSE I IS NOW, one that was there: where it was found
  ;;; last, or after, or before -- live, by its cell -- or nowhere, and it
  ;;; is passed for good (retracted, or taken by another read).
  (static)
  (func coco_reload_locate ((coco_reload * rl) (coco_pred * p) (size_t i)) (out size_t)
        (let ((size_t c . #'(nth i (-> rl cell))) (size_t at . #'(-> rl at)))
          (for ((size_t k . at)) (< k (-> p nclauses)) ((++ k))
            (if (and (== (nth k (-> p clauses)) c) (not (coco_pred_dead p k)))
                (block (set (-> rl at) k) (return k))))
          (for ((size_t k . 0)) (and (< k at) (< k (-> p nclauses))) ((++ k))
            (if (and (== (nth k (-> p clauses)) c) (not (coco_pred_dead p k)))
                (block (set (-> rl at) k) (return k))))
          (set (nth i (-> rl kind)) 3)
          (return (coco_no_clause))))

  ;;; WHERE A CLAUSE GOES IN BEFORE THE POINTER: before O's first clause
  ;;; from it that is still there, or after P's last when none is.
  (static)
  (func coco_reload_pos ((coco_reload * rl) (coco_pred * p)) (out size_t)
        (if (< (-> rl anc) (-> rl ptr)) (set (-> rl anc) (-> rl ptr)))
        (while (< (-> rl anc) (-> rl n))
          (let ((u8 kd . #'(nth (-> rl anc) (-> rl kind))))
            (if (or (== kd 0) (== kd 2))
                (let ((size_t k . #'(coco_reload_locate rl p (-> rl anc))))
                  (if (!= k (coco_no_clause)) (return k)))))
          (set (-> rl anc) (+ (-> rl anc) 1)))
        (return (-> p nclauses)))

  ;;; THE CLAUSE THE FILE SAYS NOW, CLAUSE on the heap, looked for among O
  ;;; from the pointer (`coco_reload_find'). One the program asserted
  ;;; becomes the file's where it stands, the pointer past it -- 1, and the
  ;;; caller adds nothing; the file's own old one, gone at the first
  ;;; clause, moves the pointer past it, and the caller puts the new one
  ;;; where it stood (`coco_reload_insert', before the next that is still
  ;;; there); none leaves the pointer where it is, and the new one goes in
  ;;; before it. A compaction since the reload began has moved every cell
  ;;; O holds, the file's old clauses' among them: none is a candidate or
  ;;; a place any more, and the read's clauses of PI go after its last.
  (static)
  (func coco_reload_adopt ((coco_store * st) (coco_machine * m) (coco_reload * rl)
                           (size_t pi) (size_t clause) (u64 origin)) (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (u64 h . 0) (size_t q . 0))
          (if (!= (-> st ncompacts) (-> rl ncomp))
              (block
               (for ((size_t i . 0)) (< i (-> rl n)) ((++ i))
                 (set (nth i (-> rl kind)) 3))
               (set (-> rl ncomp) (-> st ncompacts))))
          (set h (coco_reload_hash m st clause 0))
          (while 1
            (set q (coco_reload_find st m rl clause h))
            (if (>= q (-> rl n)) break)
            (if (== (nth q (-> rl kind)) 1)
                ;; the file's own: the new clause stands where it stood
                (block (set (nth q (-> rl kind)) 3) (set (-> rl ptr) (+ q 1)) break))
            ;; asserted: the file's now, if it is still there
            (let ((size_t k . #'(coco_reload_locate rl p q)))
              (if (!= k (coco_no_clause))
                  (block
                   (set (nth q (-> rl kind)) 3)
                   (set (-> rl ptr) (+ q 1))
                   (with-green-write nil
                     (set (nth k (-> p origins)) origin))
                   ;; and the knowledge base writes it again, with its
                   ;; file's name (`coco_zg_sync_pred')
                   (if (and (not (coco_store_is_muted st)) (!= (-> st on_assert) nil))
                       ((-> st on_assert) st (-> st ctx) (nth k (-> p clauses))))
                   (return 1)))))
          (return 0)))

  ;;; EVERY LIVE CLAUSE OF PI FROM POSITION K DIES WHERE IT STANDS -- one
  ;;; death, which the calls open on PI live through and still see -- and
  ;;; comes again after CLAUSE, a copy each, in order: a call open sees what
  ;;; it saw when it began, and a new call the order the file says. O's
  ;;; clauses among them are their copies from now on. The copies and the
  ;;; room for them are made BEFORE anything dies, so that no memory for
  ;;; them changes nothing and puts CLAUSE after the last, as an assertz
  ;;; goes; 0 only when that would not grow either.
  (static)
  (func coco_reload_relocate ((coco_store * st) (coco_machine * m) (coco_reload * rl)
                              (size_t pi) (size_t k) (size_t clause) (u64 key)
                              (u64 origin) (int muted)) (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (size_t n0 . #'(-> p nclauses)) (size_t nl . 0) (size_t * ls . nil)
              (size_t * cps . nil) (u32 era . 0) (size_t j . #'(-> rl anc)) (int ok . 1))
          (for ((size_t i . k)) (< i n0) ((++ i))
            (if (not (coco_pred_dead p i)) (set nl (+ nl 1))))
          ;; the positions, and after them the copies
          (set ls (cast (size_t *) (malloc (* (+ (* nl 2) 1) (sizeof size_t)))))
          (if (== ls nil) (return (coco_pred_add_clause st m pi clause 1 key origin muted)))
          (set cps (+ ls nl))
          (set nl 0)
          (for ((size_t i . k)) (< i n0) ((++ i))
            (if (not (coco_pred_dead p i))
                (block (set (nth nl ls) i) (set nl (+ nl 1)))))
          (for ((size_t x . 0)) (and ok (< x nl)) ((++ x))
            (let ((size_t mark . #'(-> m heap_len))
                  (size_t h . #'(coco_store_get m st (nth (nth x ls) (-> p clauses)))))
              (if (-> m oom)
                  (set ok 0)
                (block
                 (set (nth x cps) (coco_store_put st m h))
                 (if (-> st oom) (set ok 0))))
              (set (-> m heap_len) mark)))
          (if ok (set ok (coco_pred_room st p (+ nl 1))))
          (if ok
              (block (set era (coco_tomb_open st m pi))
                     (if (== era 0) (set ok 0))))
          (if (not ok)
              (block (free (cast (void *) ls))
                     (return (coco_pred_add_clause st m pi clause 1 key origin muted))))
          (for ((size_t x . 0)) (< x nl) ((++ x))
            (coco_tomb_set p (nth x ls) era))
          (if (not (coco_pred_add_clause st m pi clause 1 key origin muted))
              (block (free (cast (void *) ls)) (return 0)))
          (for ((size_t x . 0)) (< x nl) ((++ x))
            (let ((size_t i . #'(nth x ls))
                  (size_t old . #'(nth i (-> p clauses))))
              (coco_pred_add_clause st m pi (nth x cps) 1 (nth i (-> p keys))
                                    (nth i (-> p origins)) (nth i (-> p muted)))
              ;; O's clause, if this is one, is the copy from now on
              (while (and (< j (-> rl n))
                          (not (or (== (nth j (-> rl kind)) 0) (== (nth j (-> rl kind)) 2))))
                (set j (+ j 1)))
              (if (and (< j (-> rl n)) (== (nth j (-> rl cell)) old))
                  (block (set (nth j (-> rl cell)) (nth x cps)) (set j (+ j 1))))))
          (free (cast (void *) ls))
          (set (-> rl at) (+ n0 1))
          (return 1)))

  ;;; THE NEW CLAUSE PUT IN BEFORE THE POINTER (`coco_reload_pos'), or
  ;;; after the last when nothing from the pointer is still there, which is
  ;;; where an assertz goes, the index kept. A call open on PI that has a
  ;;; clause before that place still to try and one after it would see the
  ;;; new one, which came after it began: then the clauses from the place
  ;;; come again after the new one (`coco_reload_relocate').
  (static)
  (func coco_reload_insert ((coco_store * st) (coco_machine * m) (coco_reload * rl)
                            (size_t pi) (size_t clause) (u64 key) (u64 origin) (int muted))
        (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (size_t k . 0))
          ;; the dead gone first if no frame is open to want them, so the
          ;; place found below is where the clause goes
          (if (!= (-> p ntomb) 0) (coco_tomb_try_sweep st m pi))
          (set k (coco_reload_pos rl p))
          (if (>= k (-> p nclauses))
              (return (coco_pred_add_clause st m pi clause 1 key origin muted)))
          (with-green-write nil
            (if (!= (coco_frames_on m st pi 3 0 k) 0)
                (return (coco_reload_relocate st m rl pi k clause key origin muted)))
            (if (not (coco_pred_insert_at st m pi k clause key origin muted)) (return 0))
            (set (-> rl at) (+ k 1))
            (return 1))))

  ;;; PI'S PLACE IN THE CONSULT'S SEEN SET S, and at the file's first clause
  ;;; of it the reconsult: the reload begun -- for a file read into this
  ;;; store again, or a predicate that holds the file's clauses from before
  ;;; -- and then what the file put there last time taken out. *RL is the
  ;;; predicate's reload, nil for clauses that are appended. 0 when the set
  ;;; would not grow.
  (static)
  (func coco_reload_for ((coco_store * st) (coco_machine * m) (coco_origin_seen * s)
                         (size_t pi) (u64 origin) (const char * origin_path)
                         (int at) (coco_reload ** rl)) (out int)
        (set (cof rl) nil)
        ;; a file's clauses of one predicate come together, mostly
        (if (and (!= (-> s last) 0) (== (nth (- (-> s last) 1) (-> s pis)) pi))
            (block (set (cof rl) (nth (- (-> s last) 1) (-> s rls))) (return 1)))
        (for ((size_t i . 0)) (< i (-> s n)) ((++ i))
          (if (== (nth i (-> s pis)) pi)
              (block
                ;; NOT TOGETHER: this predicate had a clause earlier, and
                ;; the last clause was another predicate's (3.17.0, swipl's
                ;; warning). A predicate declared discontiguous is exempt.
                (if (and (!= (-> s last) 0) (!= (-> s last) (+ i 1))
                         (== 0 (bitand ($ (nth pi (-> st preds)) declared) 3))
                         (or (not (coco_store_is_muted st)) (-> st ownload))
                         (!= origin_path nil))
                    (let ((char what [512])
                          (size_t prev . #'(nth (- (-> s last) 1) (-> s pis)))
                          (const char * cur . #'(coco_atom_name m ($ (nth pi (-> st preds)) name)))
                          (const char * was . #'(coco_atom_name m ($ (nth prev (-> st preds)) name))))
                      (snprintf what (sizeof what)
                                "Clauses of %s/%u are not together in the source-file\nEarlier definition at %s:%zu\nCurrent predicate: %s/%u\nUse :- discontiguous %s/%u. to suppress this message"
                                cur (cast unsigned ($ (nth pi (-> st preds)) arity))
                                origin_path (nth i (-> s lines))
                                was (cast unsigned ($ (nth prev (-> st preds)) arity))
                                cur (cast unsigned ($ (nth pi (-> st preds)) arity)))
                      (coco_load_message "Warning" origin_path at what)))
                (set (-> s last) (+ i 1))
                (set (cof rl) (nth i (-> s rls)))
                (return 1))))
        (if (not (coco_store_grow st (cast (void **) (aof (-> s pis)))
                                (aof (-> s cap)) (+ (-> s n) 1) (sizeof size_t)))
            (return 0))
        (if (not (coco_store_grow st (cast (void **) (aof (-> s rls)))
                                (aof (-> s rcap)) (+ (-> s n) 1) (sizeof size_t)))
            (return 0))
        (if (not (coco_store_grow st (cast (void **) (aof (-> s lines)))
                                (aof (-> s lcap)) (+ (-> s n) 1) (sizeof size_t)))
            (return 0))
        (let ((coco_reload * r . nil) (int mute . #'(coco_store_is_muted st)))
          (if (or (-> s again) (coco_pred_holds st pi origin mute))
              (set r (coco_reload_begin st m pi origin mute)))
          (set (nth (-> s n) (-> s pis)) pi)
          (set (nth (-> s n) (-> s rls)) r)
          (set (nth (-> s n) (-> s lines)) (cast size_t at))
          (set (-> s n) (+ (-> s n) 1))
          (set (-> s last) (-> s n))
          (coco_pred_forget_from st m pi origin)
          (set (cof rl) r)
          (return 1)))

  ;;; THE RECONSULT, as one predicate at a time: the clauses of PI that
  ;;; ORIGIN put there are taken out, in place, and the rest close up. The
  ;;; cells stay in the store, orphaned, as a retract leaves them; the
  ;;; positions have shifted, so the index is dropped; and the backend hears
  ;;; once, through the retract hook, which rewrites the predicate whole.
  ;;;
  ;;; ONLY THE CLAUSES OF THE STORE'S OWN MUTE (2.14.0): a muted forget --
  ;;; a module read again -- takes the module's clauses, which never reached
  ;;; the knowledge base, and tells the backend nothing; an unmuted one
  ;;; takes the program's, and tells it. A module's clauses carry their
  ;;; file's path too since 2.14.0, and a forget that took the other kind
  ;;; would leave the knowledge base and this store holding different
  ;;; things -- or, unmuted over a predicate never read, rewrite it from
  ;;; nothing. `coco_pred_forget_from', after the walk.
  ;;;
  ;;; Whether clause I of P is one a forget takes: ORIGIN's under MUTE (0
  ;;; or 1), or, MUTE 2, any muted one.
  (static) (inline)
  (func coco_forget_match ((coco_pred * p) (size_t i) (u64 origin) (int mute)) (out int)
        (if (== mute 2) (return (!= (nth i (-> p muted)) 0)))
        (return (and (== (nth i (-> p origins)) origin) (== (nth i (-> p muted)) mute))))

  ;;; The two forgets' one walk: the live clauses of PI that
  ;;; `coco_forget_match' takes.
  (func coco_pred_forget_where ((coco_store * st) (coco_machine * m) (size_t pi)
                                (u64 origin) (int mute)) (out int)
        (if (>= pi (-> st npreds)) (return 0))
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (size_t kept . 0) (int gone . 0) (size_t swept . 0)
              ;; the backend hears of the program's clauses alone
              (int tell . #'(and (== mute 0) (not (coco_store_is_muted st)) (!= (-> st on_retract) nil))))
          ;; THE LOGICAL UPDATE VIEW: with a call open on the predicate, the
          ;; file's clauses die where they stand and stay for it, and what
          ;; the file says now comes after every one of them
          (let ((u32 era . #'(coco_tomb_open st m pi)))
            (if (!= era 0)
                (block
                  (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
                    (if (and (coco_forget_match p i origin mute) (== (nth i (-> p tomb)) 0))
                        (block (coco_tomb_set p i era) (set gone (+ gone 1)))))
                  (if (== gone 0) (return 0))
                  (if tell ((-> st on_retract) st (-> st ctx) pi))
                  (return gone))))
          ;; no call open: taken out, and the dead of an earlier change with them
          (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
            (cond
              ((coco_pred_dead p i)
               (set swept (+ swept 1))
               (coco_store_orphan st m (nth i (-> p clauses))))
              ((coco_forget_match p i origin mute)
               (set gone (+ gone 1))
               (coco_store_orphan st m (nth i (-> p clauses))))
              (#t
                (if (!= kept i)
                    (block (set (nth kept (-> p clauses)) (nth i (-> p clauses)))
                           (set (nth kept (-> p keys)) (nth i (-> p keys)))
                           (set (nth kept (-> p origins)) (nth i (-> p origins)))
                           (set (nth kept (-> p muted)) (nth i (-> p muted)))
                           (set (nth kept (-> p codes)) (nth i (-> p codes)))))
                (set kept (+ kept 1)))))
          (if (and (== gone 0) (== swept 0)) (return 0))
          (set (-> p nclauses) kept)
          (set (-> p tver) (+ (-> p tver) 1))
          (if (!= (-> p tomb) nil)
              (block (free (cast (void *) (-> p tomb)))
                     (set (-> p tomb) nil) (set (-> p tomb_cap) 0)
                     (set (-> p ntomb) 0) (set (-> p tprobe) 0) (set (-> p tera) 0)))
          (coco_pred_nprobe p)
          (coco_pred_unindex p)
          (if (== gone 0) (return 0))
          (if tell ((-> st on_retract) st (-> st ctx) pi))
          (return gone)))

  (func coco_pred_forget_from ((coco_store * st) (coco_machine * m) (size_t pi) (u64 origin)) (out int)
        (if (== origin 0) (return 0))
        (return (coco_pred_forget_where st m pi origin (coco_store_is_muted st))))

  ;;; A LIBRARY'S OWN CLAUSES OF A PREDICATE A PROGRAM FILE TOOK OVER
  ;;; (3.1.0, `coco_pred_take_over'): every muted clause of PI, whatever
  ;;; its file -- a compiled-in module's Prolog half beside its C row
  ;;; (last/2's, for the partial list it declines) -- which swipl keeps in a
  ;;; module of their own, where the program's definition does not see
  ;;; them. One namespace has them in the predicate the program now
  ;;; defines. They never reached the knowledge base, so it hears nothing.
  (func coco_pred_forget_muted ((coco_store * st) (coco_machine * m) (size_t pi)) (out int)
        (return (coco_pred_forget_where st m pi 0 2)))

  ;;; A LIBRARY'S CALL OF A NAME A PROGRAM FILE TOOK OVER IS THE SYSTEM'S
  ;;; (3.1.0): G with each goal in it that calls a taken name made
  ;;; `system:G' (`coco_colon'), as swipl's library modules call system's
  ;;; predicate where a user file defined one of its name -- the vendored
  ;;; aggregate.pl's succ/2 among them. A goal is looked for in a control
  ;;; structure (`,', `;', `->', `*->', the bar, `\+', not/1, once/1,
  ;;; ignore/1, call/1) and in the goal arguments of the builtins that run one
  ;;; (catch/3, findall/3,4, forall/2, aggregate_all/3, bagof/3 and setof/3
  ;;; past their `^', with_output_to/2 and the three cleanups). G itself
  ;;; where nothing in it is taken; a goal already qualified is left as it
  ;;; was written, and so are a variable and a closure (call/N's,
  ;;; maplist/N's), which the program gives. A goal that runs goals and is
  ;;; taken itself (forall/2, findall/4, not/1, ignore/1) is made the
  ;;; system's whole, its goals as well; and an atom goal as any other.
  ;;; Built on the machine's heap, 256 deep at most.
  (func coco_sys_goal ((coco_machine * m) (coco_store * st) (size_t g) (int depth)) (out size_t)
        (set g (coco_deref m g))
        (if (> depth 256) (return g))
        (if (coco-tag-is ATOM (nth g (-> m heap)))
            (return (? (coco_pred_taken st (coco_name_of m g) 0)
                       (coco_make2 m ":" (coco_new_atom m "system") g)
                       g)))
        (if (not (coco-tag-is FUN (nth g (-> m heap)))) (return g))
        (let ((u64 nid . #'(coco_name_of m g))
              (u32 n . #'(coco_arity m g))
              (const char * nm . #'(coco_atom_name m (coco_name_of m g)))
              ;; bit I for each argument I that is a goal; CARET when
              ;; bagof/3's and setof/3's goal is reached past its `^'
              (u32 mask . 0) (int caret . 0))
          (cond
            ((== n 1)
             (if (or (== 0 (strcmp nm "\\+")) (== 0 (strcmp nm "not"))
                     (== 0 (strcmp nm "once")) (== 0 (strcmp nm "ignore"))
                     (== 0 (strcmp nm "call")))
                 (set mask 1)))
            ((== n 2)
             (cond
               ((== 0 (strcmp nm ":")) (return g))
               ((or (== 0 (strcmp nm ",")) (== 0 (strcmp nm ";"))
                    (== 0 (strcmp nm "->")) (== 0 (strcmp nm "*->"))
                    (== 0 (strcmp nm "|"))
                    (== 0 (strcmp nm "forall")) (== 0 (strcmp nm "call_cleanup")))
                (set mask 3))
               ((== 0 (strcmp nm "with_output_to")) (set mask 2))))
            ((== n 3)
             (cond
               ((== 0 (strcmp nm "catch")) (set mask 5))
               ((or (== 0 (strcmp nm "findall")) (== 0 (strcmp nm "aggregate_all"))) (set mask 2))
               ((or (== 0 (strcmp nm "bagof")) (== 0 (strcmp nm "setof")))
                (block (set mask 2) (set caret 1)))
               ((== 0 (strcmp nm "setup_call_cleanup")) (set mask 7))))
            ((== n 4)
             (cond
               ((== 0 (strcmp nm "findall")) (set mask 2))
               ((== 0 (strcmp nm "setup_call_catcher_cleanup")) (set mask 11)))))
          (if (== mask 0)
              (if (coco_pred_taken st nid n)
                  (return (coco_make2 m ":" (coco_new_atom m "system") g))
                  (return g)))
          ;; the goal arguments; the term is made again only where one changed
          (let ((size_t args [4]) (int changed . 0))
            (for ((u32 i . 0)) (< i n) ((++ i))
              (set (nth i args) (coco_deref m (coco_arg m g i)))
              (if (!= 0 (bitand mask (<< (cast u32 1) i)))
                  (let ((size_t a . #'(nth i args)) (size_t r . 0))
                    (if caret
                        ;; V^G: the goal past every `^'
                        (let ((size_t vs [64]) (u32 nv . 0))
                          (while (and (< nv 64) (coco_is_compound2 m a "^"))
                            (set (nth nv vs) (coco_deref m (coco_arg m a 0)))
                            (set nv (+ nv 1))
                            (set a (coco_deref m (coco_arg m a 1))))
                          (set r (coco_sys_goal m st a (+ depth 1)))
                          (if (!= r a)
                              (block
                                (while (> nv 0)
                                  (set nv (- nv 1))
                                  (set r (coco_make2 m "^" (nth nv vs) r)))
                                (set (nth i args) r)
                                (set changed 1))))
                        (block
                          (set r (coco_sys_goal m st a (+ depth 1)))
                          (if (!= r a) (block (set (nth i args) r) (set changed 1))))))))
            (let ((size_t r . #'(? changed (coco_make m nm n args) g)))
              (if (coco_pred_taken st nid n)
                  (return (coco_make2 m ":" (coco_new_atom m "system") r)))
              (return r)))))

  ;;; EVERY LIBRARY CLAUSE'S CALLS OF A TAKEN NAME MADE THE SYSTEM'S (3.1.0,
  ;;; `coco_pred_take_over'): each clause a library's load made -- muted,
  ;;; of a predicate no program file defines -- whose body `coco_sys_goal'
  ;;; changes is put again with that body in its place, its key, origin and
  ;;; mute as they were and its program dropped (a body part way through
  ;;; it goes on, as a retracted clause's does). A clause read later is made
  ;;; so as it is added (`coco_assert_from'). The clauses are read onto the
  ;;; heap one at a time, and the heap wound back after each.
  (func coco_sys_library ((coco_store * st) (coco_machine * m))
        (for ((size_t pi . 0)) (< pi (-> st npreds)) ((++ pi))
          (if (and ($ (nth pi (-> st preds)) library) (not ($ (nth pi (-> st preds)) own))
                   (not ($ (nth pi (-> st preds)) taken)))
              (let ((int touched . 0))
                (for ((size_t i . 0)) (< i ($ (nth pi (-> st preds)) nclauses)) ((++ i))
                  (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
                    (if (and (!= (nth i (-> p muted)) 0) (not (coco_pred_dead p i)))
                        (let ((size_t mark . #'(-> m heap_len))
                              (size_t c . #'(coco_store_get m st (nth i (-> p clauses))))
                              (size_t h . 0) (size_t bd . 0))
                          (coco_clause_parts m c (aof h) (aof bd))
                          (if (!= bd 0)
                              (let ((size_t nb . #'(coco_sys_goal m st bd 0)))
                                (if (!= nb (coco_deref m bd))
                                    (let ((size_t stored . #'(coco_store_put st m (coco_make2 m ":-" h nb))))
                                      (set p (aof (nth pi (-> st preds))))
                                      (coco_store_orphan st m (nth i (-> p clauses)))
                                      (set (nth i (-> p clauses)) stored)
                                      (set (nth i (-> p codes)) nil)
                                      (set touched 1)))))
                          (set (-> m heap_len) mark)))))
                (if touched (coco_pred_unindex (aof (nth pi (-> st preds)))))))))

  (func coco_assert ((coco_store * st) (coco_machine * m) (size_t clause) (int at_end)) (out int)
        (return (coco_assert_from st m clause at_end 0 nil 0 nil)))

  ;;; ---- a clause as swipl's compiler keeps it (3.15.0) ---------------------
  ;;;
  ;;; SWIPL'S clause/2 GIVES BACK WHAT ITS COMPILER MADE OF A CLAUSE, and so
  ;;; does cocolog's: the clause is stored so (`coco_clause_compile', at
  ;;; every assert, consult and read of a stored clause), and runs as it
  ;;; did. Probed against swipl 9.0.4 (test/files/clause_body.pl):
  ;;;
  ;;; - THE BODY'S CONJUNCTIONS ARE ONE: `(a, b), c' is `a, b, c', and so in
  ;;;   the arms of `;', `->', `*->' and under `\+' -- the constructs the
  ;;;   compiler compiles in place -- and never in a goal's argument
  ;;;   (call/1's, findall/3's, catch/3's, not/1's).
  ;;; - A VARIABLE WHERE A GOAL STANDS IS call/1 of it (`p(X) :- X' is
  ;;;   `p(X) :- call(X)'), as `M:X' is call(M:X), the module as written.
  ;;; - A BAR IS ITS DISJUNCTION (3.2.0): '|'(A, B) where the body runs it is
  ;;;   ;(A, B), and a bar in a goal's argument stays as it was written and
  ;;;   runs as `;' when it is called (`coco_construct').
  ;;; - A GOAL OF NO ARGUMENTS, `f()', is the atom it calls (3.12.0).
  ;;; - `user:G' is G, and any other qualifier is said of each goal under it:
  ;;;   `foo:(a, b)' is `foo:a, foo:b', through the constructs, an inner one
  ;;;   winning (`foo:user:b' is `b'). Those the compiler makes no call of
  ;;;   lose it -- `!', `true', `fail', `=/2', `==/2', `\==/2' and the type
  ;;;   tests (`coco_cbody_inline') -- and under a variable M each goal is
  ;;;   call(M:G).
  ;;; - A UNIFICATION WITH A VARIABLE THE CLAUSE NAMES NOWHERE ELSE is
  ;;;   `true' (`b, _ = 2, d' is `b, true, d').
  ;;; - THE UNIFICATIONS THAT BEGIN THE BODY GO INTO THE HEAD, under swipl's
  ;;;   flag `optimise_unify' (`coco_cbody_scan'): `p(X) :- X = f(Y), q(Y)'
  ;;;   is `p(f(Y)) :- q(Y)', and a body left with nothing is `true'.
  ;;; - `$(G)' IS COMPILED IN PLACE (3.20.0), its G an arm (`$((a, (b,
  ;;;   c)))' is `$((a, b, c))', `$(X)' `$(call(X))'), and keeps no qualifier
  ;;;   of its own: `foo:$(p)' is `$(foo:p)'.
  ;;; - G@M IS SAID OF EACH GOAL UNDER IT (3.20.0), as a qualifier is,
  ;;;   through the constructs and into a `$': `@((a ; b), m)' is `@(a, m) ;
  ;;;   @(b, m)', `@($(p), m)' `$(@(p, m))', the innermost `@' winning and
  ;;;   a qualifier staying inside it (`foo:@(p, m)' is `@(foo:p, m)',
  ;;;   `@(user:p, m)' `@(p, m)'); the goals the compiler makes no call of
  ;;;   lose it, and under a variable qualifier each goal is call(@(M:G, A)).
  ;;; - A VARIABLE GOAL UNDER A VARIABLE MODULE is call(M:X) (3.20.0; through
  ;;;   3.19.5 `M:(a, X)' made it call(call(M:X))).
  ;;; The compile's state: the clause, its variables counted on the first
  ;;; question (COUNTED 1, or -1 where the walk gave up), the goals that
  ;;; went into the head, and AT the module of the `@' the walk is inside
  ;;; (`(size_t)-1' for none).
  (struct coco_cbody
    (member size_t        clause)
    (member int           counted)
    (member coco_varmap * vm)
    (member size_t *      drop)
    (member u32           ndrop)
    (member size_t        at))

  ;;; Each unbound variable's occurrences in the whole clause, once: an
  ;;; explicit stack, and past twice the heap's length and 64 nodes the
  ;;; clause is a cycle (an assert of one is refused at its put) or a DAG
  ;;; too wide to count -- and then no variable is any count, so nothing is
  ;;; made `true' and nothing moves.
  (static)
  (func coco_cbody_count ((coco_machine * m) (coco_cbody * cb)) (out int)
        (if (!= (-> cb counted) 0) (return (? (> (-> cb counted) 0) 1 0)))
        (let ((size_t * stk . nil) (size_t sn . 0) (size_t scap . 64)
              (size_t budget . #'(+ (* 2 (-> m heap_len)) 64)) (int ok . 1))
          (set stk (cast (size_t *) (malloc (* scap (sizeof size_t)))))
          (if (== stk nil) (block (set (-> cb counted) -1) (return 0)))
          (set (nth 0 stk) (-> cb clause))
          (set sn 1)
          (while (and ok (> sn 0))
            (let ((size_t t . #'(coco_deref m (nth (- sn 1) stk))) (u64 c . 0))
              (set sn (- sn 1))
              (if (== budget 0) (block (set ok 0) break))
              (set budget (- budget 1))
              (set c (nth t (-> m heap)))
              (cond
                ((coco-tag-is REF c)
                 (let ((size_t k . 0))
                   (if (not (coco_varmap_get (-> cb vm) t (aof k))) (set k 0))
                   (if (not (coco_varmap_put (-> cb vm) t (+ k 1))) (set ok 0))))
                ((coco-tag-is FUN c)
                 (let ((u32 n . #'(coco_arity m t)))
                   (if (> (+ sn (cast size_t n)) scap)
                       (let ((size_t ncap . #'(* 2 (+ sn (cast size_t n))))
                             (size_t * grown . nil))
                         (set grown (cast (size_t *) (realloc (cast (void *) stk) (* ncap (sizeof size_t)))))
                         (if (== grown nil)
                             (set ok 0)
                             (block (set stk grown) (set scap ncap)))))
                   (if ok
                       (for ((u32 i . 0)) (< i n) ((++ i))
                         (set (nth sn stk) (coco_arg m t i))
                         (set sn (+ sn 1)))))))))
          (free stk)
          (set (-> cb counted) (? ok 1 -1))
          (return ok)))

  ;;; How often the clause names V: 0 where it could not be counted.
  (static)
  (func coco_cbody_n ((coco_machine * m) (coco_cbody * cb) (size_t v)) (out size_t)
        (if (not (coco_cbody_count m cb)) (return 0))
        (let ((size_t k . 0))
          (if (not (coco_varmap_get (-> cb vm) v (aof k))) (return 0))
          (return k)))

  (static)
  (func coco_cbody_isvar ((coco_machine * m) (size_t t)) (out int)
        (return (coco-tag-is REF (nth (coco_deref m t) (-> m heap)))))

  ;;; A `=/2' one side of which the clause names nowhere else: `true'.
  (static)
  (func coco_cbody_void ((coco_machine * m) (coco_cbody * cb) (size_t g)) (out int)
        (let ((size_t a . #'(coco_deref m (coco_arg m g 0)))
              (size_t b . #'(coco_deref m (coco_arg m g 1))))
          (return (or (and (coco_cbody_isvar m a) (== (coco_cbody_n m cb a) 1))
                      (and (coco_cbody_isvar m b) (== (coco_cbody_n m cb b) 1))))))

  ;;; The goals swipl's compiler makes no call of, which lose a qualifier.
  (static)
  (func coco_cbody_inline ((u32 n) (const char * nm)) (out int)
        (if (== n 0)
            (return (or (== 0 (strcmp nm "!")) (or (== 0 (strcmp nm "true")) (== 0 (strcmp nm "fail"))))))
        (if (== n 2)
            (return (or (== 0 (strcmp nm "=")) (or (== 0 (strcmp nm "==")) (== 0 (strcmp nm "\\=="))))))
        (if (!= n 1) (return 0))
        (return (or (or (or (== 0 (strcmp nm "var")) (== 0 (strcmp nm "nonvar")))
                        (or (== 0 (strcmp nm "integer")) (== 0 (strcmp nm "float"))))
                    (or (or (or (== 0 (strcmp nm "number")) (== 0 (strcmp nm "atomic")))
                            (or (== 0 (strcmp nm "atom")) (== 0 (strcmp nm "string"))))
                        (or (or (== 0 (strcmp nm "callable")) (== 0 (strcmp nm "compound")))
                            (== 0 (strcmp nm "rational")))))))

  ;;; Which construct G is, by its characters (`coco_cbody_goal'): 1 `,',
  ;;; 2 `;', 3 '|', 4 `->', 5 `*->', 6 `\+', 7 `:', 8 `=', 9 `$/1', 10
  ;;; `@/2', 0 none. A name is compared only where its first byte could be a
  ;;; construct's: a strcmp a node cost the translator's consult 1.3
  ;;; million instructions (3.2.0).
  (static)
  (func coco_cbody_kind ((coco_machine * m) (size_t g)) (out int)
        (if (not (coco-tag-is FUN (nth g (-> m heap)))) (return 0))
        (let ((u32 n . #'(coco_arity m g))
              (const char * nm . #'(coco_atom_name m (coco_name_of m g)))
              (int c0 . 0) (int c1 . 0))
          (if (or (== n 0) (> n 2)) (return 0))
          (set c0 (bitand (cast int (nth 0 nm)) 255))
          (if (== n 1)
              (block
                (if (and (== c0 (coco-ch "$")) (== (nth 1 nm) 0)) (return 9))
                (return (? (and (== c0 92) (and (== (bitand (cast int (nth 1 nm)) 255) (coco-ch "+"))
                                                (== (nth 2 nm) 0)))
                           6 0))))
          (if (not (or (or (or (== c0 (coco-ch ",")) (== c0 (coco-ch ";"))) (or (== c0 (coco-ch "|")) (== c0 (coco-ch "-"))))
                       (or (or (== c0 (coco-ch "*")) (== c0 (coco-ch ":")))
                           (or (== c0 (coco-ch "=")) (== c0 (coco-ch "@"))))))
              (return 0))
          (set c1 (bitand (cast int (nth 1 nm)) 255))
          (if (== c1 0)
              (cond ((== c0 (coco-ch ",")) (return 1))
                    ((== c0 (coco-ch ";")) (return 2))
                    ((== c0 (coco-ch "|")) (return 3))
                    ((== c0 (coco-ch ":")) (return 7))
                    ((== c0 (coco-ch "=")) (return 8))
                    ((== c0 (coco-ch "@")) (return 10))
                    (#t (return 0))))
          (if (and (== c0 (coco-ch "-")) (and (== c1 (coco-ch ">")) (== (nth 2 nm) 0))) (return 4))
          (if (and (== c0 (coco-ch "*")) (== 0 (strcmp nm "*->"))) (return 5))
          (return 0)))

  ;;; G as written under MOD: G with none (`(size_t)-1'), call(M:G) under a
  ;;; variable M, M:G under an atom.
  (static)
  (func coco_cbody_qual ((coco_machine * m) (size_t g) (size_t mod)) (out size_t)
        (if (== mod (cast size_t -1)) (return g))
        (let ((size_t q . #'(coco_make2 m ":" mod g)))
          (if (coco-tag-is REF (nth (coco_deref m mod) (-> m heap))) (return (coco_make1 m "call" q)))
          (return q)))

  ;;; G as written under MOD and inside the `@' the walk is in (3.20.0):
  ;;; `coco_cbody_qual''s answer outside one, else @(G, A) with G
  ;;; qualified, call/1 of it under a variable MOD
  (static)
  (func coco_cbody_wrap ((coco_machine * m) (coco_cbody * cb) (size_t g) (size_t mod)) (out size_t)
        (if (== (-> cb at) (cast size_t -1)) (return (coco_cbody_qual m g mod)))
        (let ((size_t q . #'(? (== mod (cast size_t -1)) g (coco_make2 m ":" mod g)))
              (size_t r . 0))
          (set r (coco_make2 m "@" q (-> cb at)))
          (if (and (!= mod (cast size_t -1)) (coco-tag-is REF (nth (coco_deref m mod) (-> m heap))))
              (return (coco_make1 m "call" r)))
          (return r)))

  (decl) (func coco_cbody_goal ((coco_machine * m) (coco_cbody * cb) (size_t g) (size_t mod)
                                (int depth)) (out size_t))

  ;;; An arm of a construct: never none (a goal moved into the head begins
  ;;; the body, never an arm), and `true' if it were.
  (static)
  (func coco_cbody_arm ((coco_machine * m) (coco_cbody * cb) (size_t g) (size_t mod) (int depth))
        (out size_t)
        (let ((size_t r . #'(coco_cbody_goal m cb g mod depth)))
          (if (== r (cast size_t -1)) (return (coco_new_atom m "true")))
          (return r)))

  ;;; One goal of a conjunction pushed on V, or the goals of one that
  ;;; distributing a qualifier made (`foo:(a, b)'), one by one.
  (static)
  (func coco_cbody_push ((coco_machine * m) (size_t r) (size_t ** v) (size_t * vn)
                         (size_t * vcap) (size_t * loc)) (out int)
        (while #t
          (let ((size_t t . r) (int last . 1))
            (if (and (!= r (cast size_t -1)) (== (coco_cbody_kind m (coco_deref m r)) 1))
                (block (set t (coco_deref m (coco_arg m (coco_deref m r) 0))) (set last 0)))
            (if (>= (cof vn) (cof vcap))
                (let ((size_t ncap . #'(* 2 (cof vcap))) (size_t * grown . nil))
                  (if (== (cof v) loc)
                      (block
                        (set grown (cast (size_t *) (malloc (* ncap (sizeof size_t)))))
                        (if (!= grown nil) (memcpy (cast (void *) grown) (cast (void *) loc) (* (cof vn) (sizeof size_t)))))
                      (set grown (cast (size_t *) (realloc (cast (void *) (cof v)) (* ncap (sizeof size_t))))))
                  (if (== grown nil) (return 0))
                  (set (cof v) grown)
                  (set (cof vcap) ncap)))
            (set (nth (cof vn) (cof v)) t)
            (set (cof vn) (+ (cof vn) 1))
            (if last (return 1))
            (set r (coco_deref m (coco_arg m (coco_deref m r) 1))))))

  ;;; A conjunction made one: its right spine walked, a conjunction to the
  ;;; left of a `,' gone into, each goal compiled, the ones the head took
  ;;; left out. G itself where it was one already and no goal changed; none
  ;;; where no goal is left.
  (static)
  (func coco_cbody_conj ((coco_machine * m) (coco_cbody * cb) (size_t g) (size_t mod) (int depth))
        (out size_t)
        (let ((size_t loc [32]) (size_t * v . loc) (size_t vn . 0) (size_t vcap . 32)
              (int same . 1) (int ok . 1) (size_t t . g) (size_t r . 0))
          ;; the spine, and the goals to the left of each `,'
          (while ok
            (let ((size_t a . 0) (int k . #'(coco_cbody_kind m t)))
              (if (!= k 1)
                  (block
                    (set r (coco_cbody_goal m cb t mod (+ depth 1)))
                    (if (!= r t) (set same 0))
                    (set ok (coco_cbody_push m r (aof v) (aof vn) (aof vcap) loc))
                    break))
              (set a (coco_deref m (coco_arg m t 0)))
              (if (== (coco_cbody_kind m a) 1) (set same 0))
              (set r (coco_cbody_goal m cb a mod (+ depth 1)))
              (if (!= r a) (set same 0))
              (set ok (coco_cbody_push m r (aof v) (aof vn) (aof vcap) loc))
              (set t (coco_deref m (coco_arg m t 1)))))
          (if (not ok)
              (block (if (!= v loc) (free v)) (return (coco_cbody_wrap m cb g mod))))
          (if same (block (if (!= v loc) (free v)) (return g)))
          ;; made again, from its last goal back
          (set r (cast size_t -1))
          (let ((size_t i . vn))
            (while (> i 0)
              (set i (- i 1))
              (if (!= (nth i v) (cast size_t -1))
                  (set r (? (== r (cast size_t -1)) (nth i v) (coco_make2 m "," (nth i v) r))))))
          (if (!= v loc) (free v))
          (return r)))

  ;;; ONE GOAL OF A BODY COMPILED under MOD (`(size_t)-1' for none), as
  ;;; `coco_clause_compile' says: the term swipl's clause/2 gives back, G
  ;;; itself where nothing changed, none (`(size_t)-1') for a goal the head
  ;;; took. 256 deep at most, as `coco_sys_goal'; deeper stays as written.
  (func coco_cbody_goal ((coco_machine * m) (coco_cbody * cb) (size_t g) (size_t mod) (int depth))
        (out size_t)
        (set g (coco_deref m g))
        (if (> depth 256) (return (coco_cbody_wrap m cb g mod)))
        ;; a variable goal: call/1 of it as it stands, qualified and inside
        ;; its `@', one call/1 under a variable module too
        (if (coco-tag-is REF (nth g (-> m heap)))
            (block
              (if (and (== (-> cb at) (cast size_t -1))
                       (or (== mod (cast size_t -1))
                           (not (coco-tag-is REF (nth (coco_deref m mod) (-> m heap))))))
                  (return (coco_make1 m "call" (coco_cbody_qual m g mod))))
              (if (== (-> cb at) (cast size_t -1))
                  (return (coco_cbody_qual m g mod)))
              (return (coco_make1 m "call"
                                  (coco_make2 m "@" (? (== mod (cast size_t -1)) g (coco_make2 m ":" mod g))
                                              (-> cb at))))))
        (if (and (coco-tag-is FUN (nth g (-> m heap))) (== (coco_arity m g) 0))
            (set g (coco_new_atom_id m (coco_name_of m g))))
        (if (not (coco_is_callable m g)) (return (coco_cbody_qual m g mod)))
        (let ((int k . #'(coco_cbody_kind m g)) (u64 nid . #'(coco_name_of m g)))
          (cond
            ((== k 1) (return (coco_cbody_conj m cb g mod depth)))
            ;; $(G): G an arm, in place
            ((== k 9)
             (let ((size_t a . #'(coco_deref m (coco_arg m g 0)))
                   (size_t ra . #'(coco_cbody_arm m cb a mod (+ depth 1))))
               (if (== ra a) (return g))
               (return (coco_make1 m "$" ra))))
            ;; G@M: G's goals each inside M, the innermost `@' winning (an M
            ;; that is no module, a load and an assert refuse)
            ((== k 10)
             (let ((size_t gg . #'(coco_deref m (coco_arg m g 0)))
                   (size_t am . #'(coco_deref m (coco_arg m g 1)))
                   (size_t sat . #'(-> cb at)) (size_t r . 0))
               (set (-> cb at) am)
               (set r (coco_cbody_goal m cb gg mod (+ depth 1)))
               (set (-> cb at) sat)
               (return r)))
            ((and (>= k 2) (<= k 5))
             (let ((size_t a . #'(coco_deref m (coco_arg m g 0)))
                   (size_t b . #'(coco_deref m (coco_arg m g 1)))
                   (size_t ra . #'(coco_cbody_arm m cb a mod (+ depth 1)))
                   (size_t rb . #'(coco_cbody_arm m cb b mod (+ depth 1))))
               (if (and (!= k 3) (and (== ra a) (== rb b))) (return g))
               (return (coco_make2 m (? (== k 3) ";" (coco_atom_name m nid)) ra rb))))
            ((== k 6)
             (let ((size_t a . #'(coco_deref m (coco_arg m g 0)))
                   (size_t ra . #'(coco_cbody_arm m cb a mod (+ depth 1))))
               (if (== ra a) (return g))
               (return (coco_make1 m "\\+" ra))))
            ((== k 7)
             (let ((size_t mm . #'(coco_deref m (coco_arg m g 0)))
                   (size_t gg . #'(coco_deref m (coco_arg m g 1))))
               (cond
                 ;; M:X, X a variable: call/1 of it as written, inside its
                 ;; `@' (3.20.0)
                 ((coco-tag-is REF (nth gg (-> m heap)))
                  (return (coco_make1 m "call" (? (== (-> cb at) (cast size_t -1)) g
                                                  (coco_make2 m "@" g (-> cb at))))))
                 ((and (coco-tag-is ATOM (nth mm (-> m heap))) (not (coco_is_nil m mm)))
                  (block
                    (if (== 0 (strcmp (coco_atom_name m (coco_name_of m mm)) "user"))
                        (return (coco_cbody_goal m cb gg (cast size_t -1) (+ depth 1))))
                    (return (coco_cbody_goal m cb gg mm (+ depth 1)))))
                 ((coco-tag-is REF (nth mm (-> m heap)))
                  (return (coco_cbody_goal m cb gg mm (+ depth 1))))
                 ;; an M that is no module: as written, and the call raises
                 (#t (return (coco_cbody_qual m g mod))))))
            ((and (== k 8) (coco_cbody_void m cb g))
             (return (coco_new_atom m "true")))
            ((== k 8)
             (for ((u32 i . 0)) (< i (-> cb ndrop)) ((++ i))
               (if (== (nth i (-> cb drop)) g) (return (cast size_t -1)))))))
        (if (and (== mod (cast size_t -1)) (== (-> cb at) (cast size_t -1))) (return g))
        (if (coco_cbody_inline (coco_arity m g) (coco_atom_name m (coco_name_of m g))) (return g))
        (return (coco_cbody_wrap m cb g mod)))

  ;;; THE UNIFICATIONS THAT BEGIN THE BODY (3.15.0), as swipl's compiler
  ;;; takes them into the head: the leading goals walked, a `true' and a
  ;;; `=/2' passed, anything else ending the walk. A `=/2' of a variable
  ;;; and something that is not one, where the variable is an argument of
  ;;; HEAD and the clause names it nowhere else (twice in all), moves: the
  ;;; argument becomes the other side (MOVED's I is it, TO the term) and the
  ;;; goal leaves the body. Any other `=/2' stays and the walk goes on, a
  ;;; void one (`coco_cbody_void') becoming `true'. Not swipl's: its
  ;;; compiler moves a variable the body names again too (`p(X) :- X = 1,
  ;;; X = 2' is `p(1) :- A = 2'), where the later goal then means another
  ;;; thing than it says -- here such a clause keeps its unification.
  (static)
  (func coco_cbody_scan ((coco_machine * m) (coco_cbody * cb) (size_t head) (size_t g)
                         (size_t * moved) (size_t * to) (int depth)) (out int)
        (set g (coco_deref m g))
        (while (== (coco_cbody_kind m g) 1)
          (if (or (> depth 256)
                  (not (coco_cbody_scan m cb head (coco_arg m g 0) moved to (+ depth 1))))
              (return 0))
          (set g (coco_deref m (coco_arg m g 1))))
        (if (and (coco-tag-is ATOM (nth g (-> m heap)))
                 (== 0 (strcmp (coco_atom_name m (coco_name_of m g)) "true")))
            (return 1))
        (if (!= (coco_cbody_kind m g) 8) (return 0))
        (if (coco_cbody_void m cb g) (return 1))
        (let ((size_t a . #'(coco_deref m (coco_arg m g 0)))
              (size_t b . #'(coco_deref m (coco_arg m g 1)))
              (int av . 0) (int bv . 0) (size_t x . 0) (size_t t . 0))
          (set av (coco_cbody_isvar m a))
          (set bv (coco_cbody_isvar m b))
          (if (== av bv) (return 1))
          (set x (? av a b))
          (set t (? av b a))
          (if (!= (coco_cbody_n m cb x) 2) (return 1))
          (for ((u32 i . 0)) (< i (coco_arity m head)) ((++ i))
            (if (== (coco_deref m (coco_arg m head i)) x)
                (block
                  (set (nth i moved) i)
                  (set (nth i to) t)
                  (set (nth (-> cb ndrop) (-> cb drop)) g)
                  (set (-> cb ndrop) (+ (-> cb ndrop) 1))
                  (return 1))))
          (return 1)))

  ;;; THE CLAUSE `H :- B' AS SWIPL'S COMPILER KEEPS IT (3.15.0): its body
  ;;; compiled (`coco_cbody_goal'), and with LIFT the unifications that
  ;;; begin it moved into its head (`coco_cbody_scan'), which
  ;;; `coco_assert_from' asks only of a static predicate's clause. The
  ;;; scan and the count of the variables read SRC, the clause as written
  ;;; (`(size_t)-1' for CLAUSE itself), where a qualified unification still
  ;;; ends the walk and a void one still names its variable; CLAUSE may be
  ;;; SRC compiled already, whose goals the walk left are SRC's own cells.
  ;;; CLAUSE itself where nothing changed.
  (func coco_clause_compile ((coco_machine * m) (size_t clause) (int lift) (size_t src)) (out size_t)
        (let ((size_t h . #'(coco_deref m (coco_arg m clause 0)))
              (size_t b . #'(coco_deref m (coco_arg m clause 1)))
              (size_t sb . b)
              (coco_varmap vm . '{ nil nil 0 0 0 })
              (coco_cbody cb)
              (size_t * moved . nil) (size_t * to . nil) (size_t * drop . nil)
              (u32 n . 0) (size_t nb . 0) (size_t nh . 0))
          (coco_varmap_take m (aof vm))
          (if (!= src (cast size_t -1)) (set sb (coco_deref m (coco_arg m src 1))))
          (set ($ cb clause) (? (== src (cast size_t -1)) clause src))
          (set ($ cb counted) 0)
          (set ($ cb vm) (aof vm))
          (set ($ cb drop) nil)
          (set ($ cb ndrop) 0)
          (set ($ cb at) (cast size_t -1))
          (set nh h)
          (if (and lift (and (coco_optimise_unify)
                             (and (coco-tag-is FUN (nth h (-> m heap))) (> (coco_arity m h) 0))))
              (let ((size_t f . sb))
                ;; only a body that begins with `true' or a `=/2' is asked
                (while (== (coco_cbody_kind m f) 1) (set f (coco_deref m (coco_arg m f 0))))
                (if (or (== (coco_cbody_kind m f) 8)
                        (and (coco-tag-is ATOM (nth f (-> m heap)))
                             (== 0 (strcmp (coco_atom_name m (coco_name_of m f)) "true"))))
                    (block
                      (set n (coco_arity m h))
                      (set moved (cast (size_t *) (malloc (* (cast size_t n) (sizeof size_t)))))
                      (set to (cast (size_t *) (malloc (* (cast size_t n) (sizeof size_t)))))
                      (set drop (cast (size_t *) (malloc (* (cast size_t n) (sizeof size_t)))))
                      (if (and (!= moved nil) (and (!= to nil) (!= drop nil)))
                          (block
                            (for ((u32 i . 0)) (< i n) ((++ i)) (set (nth i moved) (cast size_t -1)))
                            (set ($ cb drop) drop)
                            (coco_cbody_scan m (aof cb) h sb moved to 0)
                            (if (> ($ cb ndrop) 0)
                                (let ((size_t * args . #'(cast (size_t *) (malloc (* (cast size_t n) (sizeof size_t))))))
                                  (if (== args nil)
                                      (set ($ cb ndrop) 0)
                                      (block
                                        (for ((u32 i . 0)) (< i n) ((++ i))
                                          (set (nth i args) (? (== (nth i moved) (cast size_t -1))
                                                               (coco_arg m h i) (nth i to))))
                                        (set nh (coco_make m (coco_atom_name m (coco_name_of m h)) n args))
                                        (free args)))))))))))
          (set nb (coco_cbody_goal m (aof cb) b (cast size_t -1) 0))
          (if (== nb (cast size_t -1)) (set nb (coco_new_atom m "true")))
          (free moved) (free to) (free drop)
          (coco_varmap_give m (aof vm))
          (if (and (== nh h) (== nb b)) (return clause))
          (return (coco_make2 m ":-" nh nb))))

  ;;; THE HOOKS print_message/2 READS (2.16.0): `prolog:message//1' and
  ;;; `prolog:error_message//1', the two a program extends to give a term of
  ;;; its own its text. One namespace keeps them apart from a program's own
  ;;; message/3 by name: their clauses are '$prolog_message'/3 and
  ;;; '$prolog_error_message'/3, which library(print_message) calls. Any
  ;;; other qualified head loses its qualifier, as it always did.
  (static)
  (func coco_hook_head ((coco_machine * m) (size_t mod) (size_t h)) (out size_t)
        (set mod (coco_deref m mod))
        (set h (coco_deref m h))
        (if (not (coco-tag-is ATOM (nth mod (-> m heap)))) (return h))
        (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m mod)) "prolog")) (return h))
        (if (or (not (coco_is_callable m h)) (!= (coco_arity m h) 3)) (return h))
        (let ((const char * nm . #'(coco_atom_name m (coco_name_of m h))) (const char * to . nil)
              (size_t args [3]))
          (if (== 0 (strcmp nm "message")) (set to "$prolog_message"))
          (if (== 0 (strcmp nm "error_message")) (set to "$prolog_error_message"))
          (if (== to nil) (return h))
          (set (nth 0 args) (coco_arg m h 0))
          (set (nth 1 args) (coco_arg m h 1))
          (set (nth 2 args) (coco_arg m h 2))
          (return (coco_make m to 3 args))))

  (func coco_assert_stored ((coco_store * st) (coco_machine * m) (size_t t)) (out int)
        (let ((int was . #'(-> st nomove)) (int ok . 0))
          (set t (coco_deref m t))
          (set (-> st nomove) 1)
          (if (and (coco_is_callable m t) (== (coco_arity m t) 2)
                   (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) "$from"))
                   (coco-tag-is ATOM (nth (coco_deref m (coco_arg m t 0)) (-> m heap))))
              (set ok (coco_assert_from st m (coco_arg m t 1) 1
                                        (+ (coco_name_of m (coco_deref m (coco_arg m t 0))) 1) nil 0 nil))
              (set ok (coco_assert_from st m t 1 0 nil 0 nil)))
          (set (-> st nomove) was)
          (return ok)))

  ;;; ---- a single-sided predicate's rules (3.19.0, `Head => Body') ------

  ;;; whether the term on the heap is a rule as `coco_assert_from' stores
  ;;; it: `H :- '$ssu', ...'
  (func coco_ssu_clause ((coco_machine * m) (size_t clause)) (out int)
        (set clause (coco_deref m clause))
        (if (not (coco_is_compound2 m clause ":-")) (return 0))
        (let ((size_t b . #'(coco_deref m (coco_arg m clause 1))))
          (if (not (coco_is_compound2 m b ",")) (return 0))
          (let ((size_t a . #'(coco_deref m (coco_arg m b 0))))
            (return (and (coco-tag-is ATOM (nth a (-> m heap)))
                         (== 0 (strcmp (coco_atom_name m (coco_name_of m a)) "$ssu")))))))

  ;;; THE MODULE A READ NAMES (3.26.0): its module/2's, `ssu_mod', for a
  ;;; predicate whose first clause the read adds -- `user' and `system'
  ;;; name none, as swipl's determinism error names neither
  (func coco_pred_note_mod ((coco_store * st) (coco_machine * m) (size_t pi))
        (let ((const char * mn . #'(coco_atom_name m (- (-> m ssu_mod) 1))))
          (if (and (!= 0 (strcmp mn "user")) (!= 0 (strcmp mn "system")))
              (set ($ (nth pi (-> st preds)) pmod) (-> m ssu_mod)))))

  ;;; A READ NOTES THE PREDICATE, once, from its own base on
  ;;; (`coco_consult_oid'): its end puts the last clause after it
  (func coco_ssu_note ((coco_machine * m) (size_t pi))
        (let ((size_t i . #'(-> m nssu)))
          (while (> i 0)
            (if (== (nth (- i 1) (-> m ssu_pis)) pi) (return))
            (set i (- i 1))))
        (if (>= (-> m nssu) (-> m ssu_cap))
            (let ((size_t ncap . #'(? (== (-> m ssu_cap) 0) 16 (* (-> m ssu_cap) 2)))
                  (void * grown . #'(realloc (cast (void *) (-> m ssu_pis)) (* ncap (sizeof size_t)))))
              (if (== grown nil) (return))
              (set (-> m ssu_pis) (cast (size_t *) grown))
              (set (-> m ssu_cap) ncap)))
        (set (nth (-> m nssu) (-> m ssu_pis)) pi)
        (set (-> m nssu) (+ (-> m nssu) 1)))

  ;;; THE LAST CLAUSE, `H :- '$ssu_none'(Mod, G)', H the predicate's head of
  ;;; fresh variables, MOD the module's atom id plus one, 0 for user, and
  ;;; for a pattern any module (-1). G is H, or for a predicate swipl names
  ;;; otherwise (3.26.1, a row of *frame-contexts*) H under swipl's name,
  ;;; its arguments H's, and the row's module stands for MOD:
  ;;; '$max_member_'(T, a, M) raises existence_error(matching_rule,
  ;;; lists:max_member_(T, a, M)), as swipl's lists:max_member_/3 does
  (static)
  (func coco_ssu_last ((coco_store * st) (coco_machine * m) (size_t pi) (u64 mod)) (out size_t)
        (let ((u64 nid . #'($ (nth pi (-> st preds)) name))
              (u32 n . #'($ (nth pi (-> st preds)) arity))
              (size_t h . 0) (size_t g . 0) (size_t md . 0) (size_t fc . 0)
              (size_t rmod . 0) (int hasmod . 0))
          (if (== n 0)
              (set h (coco_new_atom_id m nid))
              (block
               (set h (coco_push_struct_raw m (coco-cell FUN (coco_functor_id m nid n)) n))
               (for ((u32 i . 0)) (< i n) ((++ i))
                 (set (nth (+ h (+ (cast size_t i) 1)) (-> m heap))
                      (coco-cell REF (+ h (+ (cast size_t i) 1)))))))
          (set g h)
          (if (coco_frame_ctx m nid n (aof fc))
              (let ((size_t ind . #'(coco_deref m (coco_arg m fc 0))))
                (if (coco_is_compound2 m ind ":")
                    (block
                     (set rmod (coco_deref m (coco_arg m ind 0)))
                     (set hasmod 1)
                     (set ind (coco_deref m (coco_arg m ind 1)))))
                (if (and (> n 0) (coco_is_compound2 m ind "/"))
                    (let ((size_t sn . #'(coco_deref m (coco_arg m ind 0)))
                          (size_t sa . #'(coco_deref m (coco_arg m ind 1))))
                      (if (and (coco-tag-is ATOM (nth sn (-> m heap)))
                               (coco-is-int (nth sa (-> m heap)))
                               (== (coco_int_val m (nth sa (-> m heap))) (cast i64 n))
                               (!= (coco_name_of m sn) nid))
                          (block
                           (set g (coco_push_struct_raw
                                   m (coco-cell FUN (coco_functor_id m (coco_name_of m sn) n)) n))
                           (for ((u32 i . 0)) (< i n) ((++ i))
                             (set (nth (+ g (+ (cast size_t i) 1)) (-> m heap))
                                  (coco-cell REF (+ h (+ (cast size_t i) 1)))))))))))
          (cond ((== mod (cast u64 -1)) (set md (coco_new_var m)))
                (hasmod (set md rmod))
                ((== mod 0) (set md (coco_new_atom m "user")))
                (#t (set md (coco_new_atom_id m (- mod 1)))))
          (return (coco_make2 m ":-" h (coco_make2 m "$ssu_none" md g)))))

  ;;; AN ASSERT KEEPS THE LAST CLAUSE LAST: the one there goes and a new one
  ;;; is put after the rule just added, wherever that went
  (func coco_ssu_keep_last ((coco_store * st) (coco_machine * m) (size_t pi))
        (coco_retract st m (coco_ssu_last st m pi (cast u64 -1)))
        (coco_assert_from st m (coco_ssu_last st m pi 0) 1 0 nil 0 nil))

  ;;; A READ'S END (`coco_consult_oid'): the last clause after each
  ;;; predicate it noted from BASE on, the file's own -- a re-read puts it
  ;;; where the last one stood -- and the notes taken back. It names no
  ;;; path, so it is never a clause the not-together warning speaks of
  (func coco_consult_ssu_close ((coco_store * st) (coco_machine * m) (size_t base)
                                (u64 oid) (coco_origin_seen * seen))
        (let ((size_t i . #'(+ base 0)))
          (while (< i (-> m nssu))
            (coco_assert_from st m (coco_ssu_last st m (nth i (-> m ssu_pis)) (-> m ssu_mod)) 1 oid nil 0 seen)
            (set i (+ i 1))))
        (set (-> m nssu) base))

  ;;; WHAT clause/2 AND listing/1 SHOW for a stored body B: a rule's guard,
  ;;; its cut and its body as swipl's clause/2 does -- `Guard, !, Body', and
  ;;; the body alone for a rule with no guard -- and -1 for the last clause,
  ;;; which neither shows; any other body as it is
  (func coco_ssu_body ((coco_machine * m) (size_t b)) (out size_t)
        (set b (coco_deref m b))
        (if (and (coco_is_compound2 m b "$ssu_none") (== (coco_arity m b) 2))
            (return (cast size_t -1)))
        (if (not (coco_is_compound2 m b ",")) (return b))
        (let ((size_t a . #'(coco_deref m (coco_arg m b 0)))
              (size_t r . #'(coco_deref m (coco_arg m b 1))))
          (if (not (and (coco-tag-is ATOM (nth a (-> m heap)))
                        (== 0 (strcmp (coco_atom_name m (coco_name_of m a)) "$ssu"))))
              (return b))
          (if (coco_is_compound2 m r ",")
              (let ((size_t c . #'(coco_deref m (coco_arg m r 0))))
                (if (and (coco-tag-is ATOM (nth c (-> m heap)))
                         (== 0 (strcmp (coco_atom_name m (coco_name_of m c)) "!")))
                    (return (coco_deref m (coco_arg m r 1))))))
          (return r)))

  ;;; WHAT listing/1 WRITES for a stored clause T: a rule as swipl writes it,
  ;;; `Head => Body' or `Head, Guard => Body' -- the goals between the mark
  ;;; and the first cut its guard -- and -1 for the last clause, which it
  ;;; does not write; any other clause as it is
  (func coco_ssu_rule ((coco_machine * m) (size_t t)) (out size_t)
        (set t (coco_deref m t))
        (if (not (coco_is_compound2 m t ":-")) (return t))
        (let ((size_t h . #'(coco_arg m t 0))
              (size_t b . #'(coco_deref m (coco_arg m t 1))))
          (if (coco_is_compound2 m b "$ssu_none") (return (cast size_t -1)))
          (if (not (coco_ssu_clause m t)) (return t))
          (let ((size_t r . #'(coco_deref m (coco_arg m b 1)))
                (size_t gs [64]) (size_t ng . 0) (size_t body . 0) (int found . 0))
            (while (not found)
              (let ((size_t g . r) (size_t rest . 0) (int more . 0))
                (if (coco_is_compound2 m r ",")
                    (block (set g (coco_deref m (coco_arg m r 0)))
                           (set rest (coco_arg m r 1))
                           (set more 1)))
                (if (and (coco-tag-is ATOM (nth g (-> m heap)))
                         (== 0 (strcmp (coco_atom_name m (coco_name_of m g)) "!")))
                    (block (set found 1)
                           (set body (? more (coco_deref m rest) (coco_new_atom m "true"))))
                  (block
                    ;; no commit, or a guard longer than this keeps: as stored
                    (if (or (not more) (>= ng 64)) (return t))
                    (set (nth ng gs) g)
                    (set ng (+ ng 1))
                    (set r (coco_deref m rest))))))
            (if (== ng 0) (return (coco_make2 m "=>" h body)))
            (let ((size_t gd . #'(nth (- ng 1) gs)) (size_t i . #'(- ng 1)))
              (while (> i 0)
                (set i (- i 1))
                (set gd (coco_make2 m "," (nth i gs) gd)))
              (return (coco_make2 m "=>" (coco_make2 m "," h gd) body))))))

  (func coco_assert_from ((coco_store * st) (coco_machine * m) (size_t clause)
                          (int at_end) (u64 origin) (const char * origin_path)
                          (int at) (coco_origin_seen * seen)) (out int)
        (set clause (coco_deref m clause))
        (set (nth 0 (-> st assert_err)) (cast char 0))
        ;; and the last read's reason, so a refusal below is this one's
        (set (nth 0 (-> st fetch_err)) (cast char 0))

        ;; A GRAMMAR RULE IS NOT REWRITTEN HERE (3.13.0): the consult
        ;; translates what a file holds (`coco_consult_owned'), and an
        ;; assert stores `a --> b' as the clause of `-->'/2 it is, as
        ;; swipl's does. Through 3.12.0 every rule that came this way was
        ;; translated, the asserted ones too.

        ;; A SINGLE-SIDED RULE (3.19.0, swipl's SSU), `Head => Body' or
        ;; `Head, Guard => Body', is STORED as `Head :- '$ssu', !, Body' or
        ;; `Head :- '$ssu', Guard, !, Body': the leading `'$ssu'' tells the
        ;; compiler to MATCH the head, as subsumes_term/2 does -- binding none
        ;; of the call's variables (`coco_clause_code', the `_S' opcodes) --
        ;; and the cut commits to the first rule whose head and guard hold.
        ;; A read puts a last clause after the predicate's rules, which raises
        ;; existence_error(matching_rule, Goal) when none matched
        ;; (`coco_consult_ssu_close'), and an assert keeps one there
        ;; (`coco_ssu_keep_last'); clause/2 and listing/1 show the rule as
        ;; swipl's do and hide the last clause (`coco_ssu_body',
        ;; `coco_ssu_rule'). Through 3.18.0 the rule was `Head :- !, Body',
        ;; which bound a call's variable where swipl's raises, and ordsets.pl's
        ;; predicates beside library(lists)'s stand-ins answered every solution
        ;; twice or more.
        (if (and (coco_is_callable m clause) (== (coco_arity m clause) 2)
                 (== 0 (strcmp (coco_atom_name m (coco_name_of m clause)) "=>")))
            (let ((size_t lh . #'(coco_deref m (coco_arg m clause 0))) (size_t gd . 0) (int hasg . 0)
                  (size_t rest . #'(coco_make2 m "," (coco_new_atom m "!") (coco_arg m clause 1))))
              (if (and (coco_is_callable m lh) (== (coco_arity m lh) 2)
                       (== 0 (strcmp (coco_atom_name m (coco_name_of m lh)) ",")))
                  (block (set gd (coco_arg m lh 1)) (set hasg 1)
                         (set lh (coco_deref m (coco_arg m lh 0)))))
              (if hasg (set rest (coco_make2 m "," gd rest)))
              (set clause (coco_make2 m ":-" lh (coco_make2 m "," (coco_new_atom m "$ssu") rest)))))

        ;; A MODULE-QUALIFIED HEAD IS STRIPPED HERE. cocolog has one
        ;; namespace, so `error:has_type(T, X) :- B' can only mean
        ;; `has_type(T, X) :- B' -- and a vendored SWI file is entitled to the
        ;; qualified spelling (assoc.pl extends error:has_type/2 that way).
        ;; The clause TERM is rebuilt rather than just the predicate choice,
        ;; because the stored head has to unify with unqualified calls.
        (let ((size_t qh) (size_t qb))
          (coco_clause_parts m clause (aof qh) (aof qb))
          (set qh (coco_deref m qh))
          (if (and (coco_is_callable m qh) (== (coco_arity m qh) 2)
                   (== 0 (strcmp (coco_atom_name m (coco_name_of m qh)) ":")))
              (let ((size_t inner . #'(coco_hook_head m (coco_arg m qh 0) (coco_arg m qh 1))))
                (set clause (? (== qb 0) inner (coco_make2 m ":-" inner qb))))))

        ;; the head decides which predicate this belongs to
        (let ((size_t head . clause) (int claim . 0) (size_t src . clause))
          ;; THE CLAUSE AS SWIPL'S COMPILER KEEPS IT (3.15.0, `coco_clause_compile'):
          ;; its conjunctions one, a variable goal call/1 of it, its bars `;',
          ;; its qualifiers on each goal; the unifications that begin it go into
          ;; the head below, once the predicate is known, read from SRC
          (if (and (coco_is_callable m clause) (== (coco_arity m clause) 2)
                   (== 0 (strcmp (coco_atom_name m (coco_name_of m clause)) ":-")))
              (set clause (coco_clause_compile m clause 0 (cast size_t -1))))
          (if (and (coco_is_callable m clause) (== (coco_arity m clause) 2))
              (if (== 0 (strcmp (coco_atom_name m (coco_name_of m clause)) ":-"))
                  (set head (coco_deref m (coco_arg m clause 0)))))
          ;; A HEAD OF NO ARGUMENTS, `f()', is the atom's (3.12.0): the
          ;; clause is f/0's, and swipl's clause/2 and listing/1 show `f'
          (if (and (coco-tag-is FUN (nth head (-> m heap))) (== (coco_arity m head) 0))
              (let ((size_t ah . #'(coco_new_atom_id m (coco_name_of m head))))
                (set clause (? (== head clause) ah (coco_make2 m ":-" ah (coco_arg m clause 1))))
                (set head ah)))
          (if (not (coco_is_callable m head)) (return 0))

          ;; A PROGRAM FILE'S CLAUSE FOR A BUILTIN'S NAME (3.1.0), swipl's
          ;; rule: a clause a file of the program's own gives a predicate
          ;; the engine or a compiled-in module implements is refused for an
          ;; ISO one -- before the predicate is touched, and reported in
          ;; swipl's words as a clause too long for a row is -- and takes
          ;; any other over (`coco_pred_take_over', below). A library's
          ;; clause is muted and asks nothing -- but one for a predicate
          ;; taken over already is kept out, as the take-over put the
          ;; library's out (a module's half is read at a query's start, which
          ;; can come after `run' consulted the program); neither does an
          ;; assert, as the store keeps facts under a builtin's name
          ;; (`number(dos)').
          (if (and (coco_store_is_muted st) (not (-> st ownload)) (!= (-> st ntaken) 0)
                   (coco_pred_taken st (coco_name_of m head) (coco_arity m head)))
              (return 1))
          ;; and a library's call of a taken name is the system's
          ;; (`coco_sys_goal'): a module's half read at a query's start, a
          ;; library loaded after the program took the name over
          (if (and (coco_store_is_muted st) (not (-> st ownload)) (!= (-> st ntaken) 0)
                   (!= head clause))
              (let ((size_t bd . #'(coco_deref m (coco_arg m clause 1)))
                    (size_t nb . #'(coco_sys_goal m st (coco_arg m clause 1) 0)))
                (if (!= nb bd)
                    (set clause (coco_make2 m ":-" (coco_arg m clause 0) nb)))))
          (if (and (!= origin 0) (or (not (coco_store_is_muted st)) (-> st ownload)))
              (block
                (set claim (coco_claim_kind m (coco_name_of m head) (coco_arity m head)))
                ;; one redefine_system_predicate/1 named (`redef'): taken over
                ;; as any other, but a construct, which a clause never reaches
                (if (== claim 2)
                    (let ((size_t rp . #'(coco_pred_find st (coco_name_of m head) (coco_arity m head))))
                      (if (and (< rp (-> st npreds)) ($ (nth rp (-> st preds)) redef))
                          (set claim (? (coco_is_construct m (coco_name_of m head)) 0 1)))))
                (if (== claim 2)
                    (let ((coco_strbuf b) (size_t mark . #'(-> m heap_len)))
                      (coco_sb_init (aof b))
                      (coco_write_mode m (aof b)
                                       (coco_make2 m "/" (coco_new_atom_id m (coco_name_of m head))
                                                   (coco_new_int m (cast i64 (coco_arity m head))))
                                       25 0)
                      (snprintf (-> st assert_err) 256 "No permission to modify static procedure `%s'"
                                (? (== ($ b s) nil) "?" ($ b s)))
                      (coco_sb_free (aof b))
                      (set (-> m heap_len) mark)
                      (return 0)))))

          ;; WILL IT FIT? Asked HERE -- before the predicate is touched at
          ;; all, and above the reconsult forget in particular, because the
          ;; backend only finds out at COMMIT and by then the whole
          ;; transaction is lost. See `clause_max' on the store: measured, a
          ;; clause of 8014 characters took every other clause the process
          ;; had written down with it.
          ;;
          ;; THE TERM MEASURED IS THE ONE THE BACKEND WILL WRITE, `'$from''
          ;; wrapper and all, so a long path counts against the clause here
          ;; exactly as it will on the way out.
          ;;
          ;; A LOCAL STORE PAYS NOTHING: `clause_max' is 0, and there is no
          ;; row for a clause to fit into. A module's clauses pay nothing
          ;; either -- muted means they never reach one.
          (if (and (!= (-> st clause_max) 0) (not (coco_store_is_muted st)))
              (let ((coco_strbuf b) (size_t len . 0)
                    (size_t mark . #'(-> m heap_len))
                    (size_t t . clause))
                (if (!= origin 0)
                    (set t (coco_make2 m "$from"
                                       (coco_new_atom m (coco_atom_name m (- origin 1)))
                                       t)))
                (coco_sb_init (aof b))
                (coco_write_storable m (aof b) t)
                (set len (? (== ($ b s) nil) 0 (strlen ($ b s))))
                (coco_sb_free (aof b))
                (set (-> m heap_len) mark)
                ;; THE PREDICATE'S NAME SHARES THE ROW, and this is the only
                ;; place that knows it -- `clause_max' is per-store and was
                ;; settled from the page and the knowledge base's name. It is
                ;; one byte per character, measured.
                (let ((const char * pname . #'(coco_atom_name m (coco_name_of m head))))
                  (let ((size_t room . #'(? (>= (strlen pname) (-> st clause_max))
                                            0
                                            (- (-> st clause_max) (strlen pname)))))
                    (if (> len room)
                        (block
                         (snprintf (-> st assert_err) 256
                                   "%s/%u: a clause of %lu characters, and a row holds %lu -- store it as several clauses"
                                   pname (coco_arity m head)
                                   (cast ulong len) (cast ulong room))
                         (return 0)))))))

          (let ((size_t pi . #'(coco_pred_make st (coco_name_of m head) (coco_arity m head)))
                (size_t stored) (coco_reload * rl . nil))
            (if (>= pi (-> st npreds)) (return 0))
            ;; a read under a module/2 (its `ssu_mod', 0 outside every read)
            ;; names the predicate's module, if its first clause is that
            ;; read's (3.26.0)
            (if (and (!= (-> m ssu_mod) 0)
                     (== ($ (nth pi (-> st preds)) pmod) 0)
                     (== ($ (nth pi (-> st preds)) nclauses) 0))
                (coco_pred_note_mod st m pi))
            ;; A PREDICATE A READ DEFINES UNDER generate_debug_info FALSE
            ;; HIDES ITS CHILDREN FROM THE TRACER (3.27.0, `pattrs' 32,
            ;; swipl's HIDE_CHILDS): its first clause decides, as swipl's
            ;; assert_term decides it -- set under false, cleared under true
            ;; -- and no clause after it does. A library's predicate (64: its
            ;; first clause a compiled-in module's text or a preloaded
            ;; library's, `noexp') is decided again by each clause a read
            ;; gives it: a program's clause for it would be a predicate of its
            ;; own in swipl, user's, and here there is one namespace
            (if (and (> (-> m lreads) 0)
                     (or (== ($ (nth pi (-> st preds)) nclauses) 0)
                         (bitand ($ (nth pi (-> st preds)) pattrs) 64)))
                (set ($ (nth pi (-> st preds)) pattrs)
                     (bitor (bitand ($ (nth pi (-> st preds)) pattrs) -97)
                            (bitor (? (-> st noexp) 64 0) (? (-> m nodbg) 32 0)))))
            ;; the two expansion hooks are multifile in swipl, so their
            ;; clauses may stand apart; term_expansion/2,4 is the one the
            ;; system does not otherwise declare here (3.17.0's warning
            ;; would speak of every file that defines it beside another)
            (if (and (or (== 0 (strcmp (coco_atom_name m (coco_name_of m head)) "term_expansion"))
                         (== 0 (strcmp (coco_atom_name m (coco_name_of m head)) "goal_expansion")))
                     (or (== (coco_arity m head) 2) (== (coco_arity m head) 4)))
                (set ($ (nth pi (-> st preds)) declared)
                     (bitor ($ (nth pi (-> st preds)) declared) 2)))
            ;; THE PREDICATE IS FETCHED BEFORE THE CLAUSE IS ADDED, and that is
            ;; not an optimisation -- it is what makes `assertz' mean append
            ;; when the predicate lives in a shared store. Marking it loaded
            ;; instead (which is what this did) left the local store holding
            ;; ONLY the new clause, and a backend that writes a predicate back
            ;; wholesale then replaced the shared one with it. Five facts in
            ;; the database became one.
            ;;
            ;; It cannot recurse: coco_pred_ensure marks the predicate loaded
            ;; before it calls the hook, so the asserts the hook itself makes
            ;; find it already loaded.
            ;;
            ;; A MUTED ASSERT DOES NOT FETCH, and that is the same rule read
            ;; the other way: a module's clause never writes through, so there
            ;; is no shared predicate for it to be appended to, and nothing to
            ;; read first. Leaving `loaded' at zero also leaves the predicate
            ;; honest -- the first REAL call still fetches, exactly once, as it
            ;; would have without the module.
            ;;
            ;; MEASURED, on one `edge_fact(X)' through a Zeytun edge, because
            ;; the number is the whole argument. Before this guard: 440 HTTP
            ;; requests and 91.4 SECONDS -- and 168 of those requests were
            ;; there before the vendored libraries were, from the Coco halves
            ;; of the modules compiled in. After: ONE request, 447ms. The line
            ;; was asking the database about a predicate per library clause,
            ;; every start-up, in an arrangement where a predicate is a page
            ;; over the network.
            ;;
            ;; AND A PREDICATE THAT COULD NOT BE READ IS NOT WRITTEN (2.11.1).
            ;; The backend writes a predicate back whole (`coco_zg_sync_pred'),
            ;; so a clause added over a read that failed -- or over the part
            ;; of it that arrived -- took every unread row out of the
            ;; database. The clause is refused, the store's `fetch_err' says
            ;; why, `coco_assert_goal' raises it, and a consult reports it as
            ;; it reports a clause too long for a row and goes on.
            (if (not (coco_store_is_muted st))
                (if (not (coco_pred_ensure st pi))
                    (block
                      (snprintf (-> st assert_err) 256
                                "%s/%u: the knowledge base could not be read, so the clause was not added: %s"
                                (coco_atom_name m (coco_name_of m head)) (coco_arity m head)
                                (-> st fetch_err))
                      (return 0))))
            ;; THE UNIFICATIONS THAT BEGIN THE BODY GO INTO THE HEAD OF A
            ;; STATIC PREDICATE'S CLAUSE (3.15.0), as swipl's compiler takes
            ;; them: a file's (a library's carries its file), and the first an
            ;; assert gives a predicate that has none and was never declared
            ;; dynamic -- its later asserts, a `:- dynamic' predicate's and one
            ;; retractall/1 made are a dynamic predicate's, which swipl compiles
            ;; as written. Never a clause the backend kept (`nomove'), read back.
            (if (and (!= head clause)
                     (and (not (-> st nomove))
                          (and (not ($ (nth pi (-> st preds)) dynamic))
                               (or (!= origin 0)
                                   (== (coco_pred_live (aof (nth pi (-> st preds)))) 0)))))
                (let ((size_t nc . #'(coco_clause_compile m clause 1 src)))
                  (if (!= nc clause)
                      (block
                        (set clause nc)
                        (set head (coco_deref m (coco_arg m clause 0)))))))
            ;; the program's from here on, ahead of the builtin (3.1.0)
            (if (and (== claim 1) (not ($ (nth pi (-> st preds)) taken)))
                (coco_pred_take_over st m pi head))
            ;; THE RECONSULT: the first clause this consult adds to the
            ;; predicate first takes out what the same file put there last
            ;; time -- after the fetch, so the rows are here to be taken out,
            ;; and before the add, so this consult's own clauses stay. A
            ;; re-read places each clause as swipl's reload does (2.14.1,
            ;; `coco_reload_for'): where the clause it is a variant of stood,
            ;; or before swipl's pointer -- and one the program asserted that
            ;; it is a variant of becomes the file's, and nothing is added.
            (if (and (!= origin 0) (!= seen nil))
                (if (not (coco_reload_for st m seen pi origin origin_path at (aof rl))) (return 0)))
            ;; a single-sided rule a read gives (3.19.0): the read's end puts
            ;; the last clause after its predicate's rules
            (if (and (> (-> m lreads) 0) (coco_ssu_clause m clause)) (coco_ssu_note m pi))
            (if (and (!= rl nil) (coco_reload_adopt st m rl pi clause origin))
                (return 1))
            ;; A CYCLIC CLAUSE IS REFUSED (1.10.19), as SWI refuses one with
            ;; `representation_error(cyclic_term)' (`coco_assert_goal' says
            ;; so): the put stores a cycle as its factors, which no clause
            ;; may be, and counts it -- so the count moving means the cells
            ;; are taken back and nothing is added
            (let ((size_t cp . #'(-> m cyc_puts))
                  (size_t base . #'(-> st len)))
              (set stored (coco_store_put st m clause))
              (if (!= cp (-> m cyc_puts))
                  (block (set (-> st len) base) (return 0))))
            ;; THE KEY IS TAKEN FROM THE HEAP HEAD, before the clause is a
            ;; store term: the accessors here read the machine's heap, the
            ;; head has just been dereferenced, and what goes into the store
            ;; is a copy of exactly this term. Doing it on the way in is what
            ;; keeps the index free -- nothing ever walks the clauses to
            ;; work out what they are keyed on.
            (if (not (? (!= rl nil)
                        (coco_reload_insert st m rl pi stored (coco_arg_key m head) origin
                                            (? (coco_store_is_muted st) 1 0))
                        (coco_pred_add_clause st m pi stored at_end (coco_arg_key m head) origin
                                              (? (coco_store_is_muted st) 1 0))))
                (return 0))
            ;; muted means this is a module's clause, not the program's.
            ;; ON THE FIRST CLAUSE ONLY, because that is where the pre-warm
            ;; table is consulted and a table lookup per clause would be a
            ;; string compare per clause of every module in the process.
            (if (and (coco_store_is_muted st) (not ($ (nth pi (-> st preds)) library)))
                (block
                  (set ($ (nth pi (-> st preds)) library) 1)
                  (set ($ (nth pi (-> st preds)) own) (-> st ownload))
                  ;; AND THE PRE-WARM ANSWERS FOR IT. `loaded' stays 0 here
                  ;; otherwise -- the comment above says why -- but when the
                  ;; process has already asked the backend about this exact
                  ;; name and arity and been given nothing, asking again is a
                  ;; round trip for an answer that is in hand.
                  (if (coco_prewarm_has (coco_atom_name m ($ (nth pi (-> st preds)) name))
                                        ($ (nth pi (-> st preds)) arity))
                      (set ($ (nth pi (-> st preds)) loaded) 1))))
            (if (and (not (coco_store_is_muted st)) (!= (-> st on_assert) nil))
                ((-> st on_assert) st (-> st ctx) stored))
            ;; and one a program asserts keeps the last clause last
            (if (and (== (-> m lreads) 0) (coco_ssu_clause m clause)) (coco_ssu_keep_last st m pi))
            (return 1))))

  ;;; What a `:- if(G)' may ask, read below the engine. A directive takes
  ;;; effect while the file is still being read, so the condition cannot be
  ;;; run as a goal -- the same bind that makes `op/3' a special case. What
  ;;; the vendored SWI libraries actually probe is whether some VM intrinsic
  ;;; exists (`current_predicate(\'$btree_find_node\'/5)' in assoc.pl), and
  ;;; THAT is answerable from the store: cocolog has no such predicate, by
  ;;; construction. So: `true', `fail'/`false', `\+'/1, and
  ;;; `current_predicate(Name/Arity)' against the store. Anything else is
  ;;; refused by name rather than guessed at.
  (static)
  (func coco_cond_eval ((coco_store * st) (coco_machine * m) (size_t g)
                        (int * truth) (char * err) (size_t errlen)) (out int)
        (set g (coco_deref m g))
        (if (not (coco_is_callable m g))
            (block (snprintf err errlen "if: the condition must be callable") (return 0)))
        (let ((const char * name . #'(coco_atom_name m (coco_name_of m g)))
              (u32 n . #'(coco_arity m g)))
          (if (and (== n 0) (== 0 (strcmp name "true")))
              (block (set (cof truth) 1) (return 1)))
          (if (and (== n 0) (or (== 0 (strcmp name "fail")) (== 0 (strcmp name "false"))))
              (block (set (cof truth) 0) (return 1)))
          (if (and (== n 1) (== 0 (strcmp name "\\+")))
              (block (if (not (coco_cond_eval st m (coco_arg m g 0) truth err errlen))
                         (return 0))
                     (set (cof truth) (? (== (cof truth) 0) 1 0))
                     (return 1)))
          (if (and (== n 1) (== 0 (strcmp name "current_predicate")))
              (let ((size_t spec . #'(coco_deref m (coco_arg m g 0))))
                (if (or (not (coco_is_callable m spec)) (!= (coco_arity m spec) 2)
                        (!= 0 (strcmp (coco_atom_name m (coco_name_of m spec)) "/")))
                    (block (snprintf err errlen "if: current_predicate wants Name/Arity")
                           (return 0)))
                (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
                      (size_t ar . #'(coco_deref m (coco_arg m spec 1))))
                  (if (or (not (coco_is_callable m nm)) (!= (coco_arity m nm) 0))
                      (block (snprintf err errlen "if: current_predicate wants an atom name")
                             (return 0)))
                  (let ((u64 c . #'(nth ar (-> m heap))))
                    (if (not (coco-is-int c))
                        (block (snprintf err errlen "if: current_predicate wants an integer arity")
                               (return 0)))
                    ;; an arity past 32 bits names no predicate (2.0.0)
                    (if (coco-tag-is BIG c) (block (set (cof truth) 0) (return 1)))
                    (let ((size_t pi . #'(coco_pred_find st (coco_name_of m nm)
                                                        (cast u32 (coco-signed-payload c)))))
                      (set (cof truth) (? (< pi (-> st npreds)) 1 0))
                      (return 1))))))
          (snprintf err errlen "if: cannot decide `%s/%u' while reading" name n)
          (return 0)))

  ;;; CONSULTING A FILE REPLACES THE CLAUSES IT PUT THERE LAST TIME. Every
  ;;; clause read here is owned by the file, under its REAL path -- so
  ;;; `tutorials/x.pl' and `./tutorials/x.pl' are one file and replace each
  ;;; other, while the name as given stays in the messages -- and the first
  ;;; clause of each predicate takes the file's old clauses of it out before
  ;;; going in. What a program asserted, and what another file put there,
  ;;; is untouched: the store used to APPEND, so the second of the three
  ;;; processes a tutorial runs against one store held two copies of every
  ;;; clause, and a generator without a cut answered once per copy. A
  ;;; caller naming no file owns nothing, and a module's text (muted) is
  ;;; owned only when its loader names the file (`coco_consult_owner',
  ;;; 2.14.0).
  (static) (decl) (func coco_consult_owned ((coco_store * st) (coco_machine * m)
                                           (const char * text) (const char * origin)
                                           (u64 oid) (coco_origin_seen * seen)
                                           (char * err) (size_t errlen)
                                           (coco_initgoals * up) (const char ** incs)
                                           (int ninc)) (out int))
  (static) (decl) (func coco_consult_oid ((coco_store * st) (coco_machine * m)
                                         (const char * text) (const char * origin)
                                         (u64 oid) (int reread) (int again)
                                         (char * err) (size_t errlen)) (out int))

  (func coco_consult_again ((coco_store * st) (coco_machine * m) (const char * text)
                            (const char * origin) (int again)
                            (char * err) (size_t errlen)) (out int)
        (let ((u64 oid . 0))
          (if (and (!= origin nil) (not (coco_store_is_muted st)))
              (let ((char full [4096]))
                ;; `realpath' is in <stdlib.h> but not in the std POSIX
                ;; declarations; it is declared beside this one so the call
                ;; is checked like any other.
                (if (!= nil (realpath origin full))
                    (set oid (+ (coco_intern m full) 1))
                  (set oid (+ (coco_intern m origin) 1)))))
          (return (coco_consult_oid st m text origin oid 1 again err errlen))))

  (func coco_consult ((coco_store * st) (coco_machine * m) (const char * text)
                    (const char * origin)
                    (char * err) (size_t errlen)) (out int)
        (return (coco_consult_again st m text origin 0 err errlen)))

  ;;; THE BALL THAT ENDED A LOAD (3.1.0, the machine's `lball'), taken by
  ;;; the one who can throw it: read on to the heap into OUT, its cells
  ;;; counted dead, and the machine's word cleared. 0 when none is kept.
  (func coco_load_ball_take ((coco_store * st) (coco_machine * m) (size_t * out)) (out int)
        (if (== (-> m lball) 0) (return 0))
        (set (cof out) (coco_store_read m st (- (-> m lball) 1)))
        (set (-> st dead) (+ (-> st dead) (-> m lball_size)))
        (set (-> m lball) 0)
        (set (-> m lball_size) 0)
        (return 1))

  ;;; and dropped by a host that only says why the load stopped
  (func coco_load_ball_drop ((coco_store * st) (coco_machine * m))
        (if (== (-> m lball) 0) (return))
        (set (-> st dead) (+ (-> st dead) (-> m lball_size)))
        (set (-> m lball) 0)
        (set (-> m lball_size) 0))

  ;;; a module's text read again is a file read again (`lb_reread'), and
  ;;; its first read places nothing
  (func coco_consult_owner ((coco_store * st) (coco_machine * m) (const char * text)
                          (const char * origin) (const char * owner) (int reread)
                          (char * err) (size_t errlen)) (out int)
        (return (coco_consult_oid st m text origin
                                  (? (== owner nil) 0 (+ (coco_intern m owner) 1))
                                  reread reread err errlen)))

  ;;; WHAT THE FILE NO LONGER SAYS GOES TOO (2.14.0), as SWI's reload takes
  ;;; out a predicate the new text does not define. The first clause of
  ;;; each predicate the consult reads replaced the file's old clauses of
  ;;; it (`coco_assert_from'); a predicate it did not read keeps them --
  ;;; through 2.13, every one of them, so a file edited to drop `q/1' went
  ;;; on answering `q/1' from its last read. Every predicate SEEN did not
  ;;; mark loses OID's clauses of the store's mute here, and one left with
  ;;; none is unknown, as in swipl. Asked only of a consult that read its
  ;;; text to the end: one that stopped (an `:- if' nested too deep, a
  ;;; condition that would not run) did not read what came after, and what
  ;;; it did not read is not the file's absence. A syntax error no longer
  ;;; stops one (3.1.0): its clause is passed over, and a predicate whose
  ;;; every clause would not read is no longer the file's -- as swipl's,
  ;;; which reloads `q(1 :- .' over `q(1).' into an unknown q/1.
  (static)
  (func coco_consult_forget_rest ((coco_store * st) (coco_machine * m) (u64 oid)
                                  (coco_origin_seen * seen))
        (let ((int mute . #'(coco_store_is_muted st)) (size_t np . #'(-> st npreds))
              (char * mark . nil))
          (if (== np 0) (return))
          (set mark (cast (char *) (calloc np 1)))
          (if (== mark nil) (return))
          (for ((size_t i . 0)) (< i (-> seen n)) ((++ i))
            (if (< (nth i (-> seen pis)) np) (set (nth (nth i (-> seen pis)) mark) 1)))
          (for ((size_t pi . 0)) (< pi np) ((++ pi))
            (if (and (== (nth pi mark) 0) (coco_pred_holds st pi oid mute))
                (coco_pred_forget_from st m pi oid)))
          (free mark)))

  (func coco_consult_oid ((coco_store * st) (coco_machine * m) (const char * text)
                          (const char * origin) (u64 oid) (int reread) (int again)
                          (char * err) (size_t errlen)) (out int)
        (let ((coco_origin_seen seen) (int n . 0))
          (memset (aof seen) 0 (sizeof coco_origin_seen))
          (set ($ seen again) again)
          ;; the loop registers its `initialization/1' goals as roots and
          ;; leaves on several paths, so the registration is dropped HERE,
          ;; whichever way it came out -- and so are the heap roots it holds
          ;; around a goal that may collect, and the word that let it (`dgc',
          ;; which the loop takes for itself and gives back to nobody).
          ;; A FIRST READ (a module's into a new store) has nothing of its
          ;; own to replace, and passes no SEEN: a module's clauses each
          ;; looked their predicate up in it, a walk per clause.
          (let ((size_t depth . #'(-> st nroots)) (size_t hdepth . #'(-> m nhroots))
                (int dgc . #'(-> m dgc))
                ;; THE SINGLE-SIDED PREDICATES THIS READ GIVES RULES (3.19.0),
                ;; noted after an outer read's, and its module, user until a
                ;; module/2 says otherwise
                (size_t sbase . #'(-> m nssu)) (u64 smod . #'(-> m ssu_mod))
                ;; and generate_debug_info, scoped to the read as swipl's
                ;; file-scoped flags are: what it sets, its end puts back
                ;; (3.27.0)
                (int snodbg . #'(-> m nodbg)))
            (set (-> m ssu_mod) 0)
            ;; THE READS UNDER WAY (3.7.0): the outermost runs the main goal
            ;; a nested one hands it (`ltop', which every outermost read
            ;; sets as it begins: no read but a nested one reads it)
            (set (-> m lreads) (+ (-> m lreads) 1))
            (set n (coco_consult_owned st m text origin oid (aof seen) err errlen
                                       nil nil 0))
            ;; its end puts the last clause after each of its predicates'
            ;; rules, a read's own as the rules are
            (if (>= n 0)
                (coco_consult_ssu_close st m sbase oid (? reread (aof seen) nil))
                (set (-> m nssu) sbase))
            (set (-> m ssu_mod) smod)
            (set (-> m nodbg) snodbg)
            (set (-> m lreads) (- (-> m lreads) 1))
            (set (-> st nroots) depth)
            (set (-> m nhroots) hdepth)
            (set (-> m dgc) dgc))
          (if (and reread (!= oid 0) (>= n 0))
              (coco_consult_forget_rest st m oid (aof seen)))
          (if (!= ($ seen rls) nil)
              (for ((size_t i . 0)) (< i ($ seen n)) ((++ i))
                (coco_reload_free (nth i ($ seen rls)))))
          (free (cast (void *) ($ seen rls)))
          (free (cast (void *) ($ seen lines)))
          (free (cast (void *) ($ seen pis)))
          ;; a reconsult has just orphaned the file's previous clauses --
          ;; but not under a ball that ended the load, whose cell its taker
          ;; reads next (3.1.0)
          (if (== (-> m lball) 0) (coco_store_maybe_compact st m))
          (return n)))

  ;;; A CONSULT THAT STOPS SAYS WHERE (1.11.9), as SWI places a load's
  ;;; messages: FILE:LINE: before the reason the stop left in ERR, so a
  ;;; caller prints it whole. A text that came from no file says its line.
  (static)
  (func coco_consult_where ((char * err) (size_t errlen) (const char * origin) (int at))
        (let ((char what [512]))
          (snprintf what 512 "%s" err)
          (if (!= origin nil)
              (snprintf err errlen "%s:%d: %s" origin at what)
            (snprintf err errlen "line %d: %s" at what))))

  ;;; A SYNTAX ERROR IS REPORTED WHERE IT STANDS AND THE LOAD GOES ON (3.1.0),
  ;;; on one line as swipl places it (1.11.9): the file, the line from 1 and
  ;;; the column from 0 -- in bytes, as swipl's -- of the token the reader
  ;;; failed at, and the reason. Through 3.0.4 it ended the consult. The
  ;;; reason is swipl's sentence for its id (3.10.0, messages.pl's
  ;;; syntax_error//1: `Operator expected', `Unbalanced operator'), at the
  ;;; column swipl gives it -- an operator clash at the operator before it
  ;;; -- where through 3.9.0 it was the reader's own words.
  (static)
  (func coco_consult_syntax_say ((coco_machine * m) (coco_reader * r) (const char * origin))
        (let ((int eline . 1) (int ecol . 0) (char what [1100]) (char why [600])
              (int a1 . 0) (int a2 . 0)
              (const char * id . #'(coco_reader_load_error r (aof eline) (aof ecol) (aof a1) (aof a2))))
          (coco_syntax_sentence id a1 a2 (-> m double_quotes) why (sizeof why))
          (if (!= origin nil)
              (snprintf what (sizeof what) "%s:%d:%d: Syntax error: %s" origin eline ecol why)
            (snprintf what (sizeof what) "line %d, column %d: Syntax error: %s" eline ecol why))
          (coco_load_note "ERROR" nil 0 what)))

  ;;; a term a qualifier may name: an atom, and not the list's end
  (static)
  (func coco_module_name ((coco_machine * m) (size_t q)) (out int)
        (return (and (coco-tag-is ATOM (nth q (-> m heap))) (not (coco_is_nil m q)))))

  ;;; A VARIABLE WHERE A GOAL OR A MODULE STANDS, as swipl's compiler takes
  ;;; it (3.19.3, pl-comp.c). A variable goal swipl's analysis counts once
  ;;; is no goal (NOT_CALLABLE): the clause is refused as a number goal is,
  ;;; with type_error(callable, Body), its qualifiers taken off, and `p :-
  ;;; X.' and `p :- foo:X.' are instantiation errors. The count is the
  ;;; clause's occurrences (analyseVariables2), but that a disjunction of
  ;;; the body's control counts the variables new to it as the larger of
  ;;; its branches, and a \+ inside one leaves the branches its own new
  ;;; ones: `(X ; X)' counts X once, `(X | X)' twice, `(\+ X ; X)' twice.
  ;;; A variable module no goal before it set is an instantiation error
  ;;; (getTargetModule), a void one too: the head sets its variables, a
  ;;; goal those it holds -- but ==/2 and \==/2 of two variables, or of one
  ;;; and an atom or an integer of 32 bits, which swipl compiles in place
  ;;; and which set nothing (compileBodyEQ) -- a branch starts from what
  ;;; was set before its disjunction, every variable a disjunction names is
  ;;; set after it, and a \+ keeps what it set. Through 3.19.2 each such
  ;;; clause went in, its variable called. Asked only of a clause with a
  ;;; variable where a goal or a module stands, by both walks
  ;;; (`coco_consult_body_refused', assert's `coco_body_check'): the
  ;;; first fault of the compile's order is the answer. Probed against
  ;;; swipl 9.0.4 case by case (test/files/fresh_goals.pl).
  ;;;
  ;;; The state: the variables kept (where a goal, a module or an operand
  ;;; of ==/2 or \==/2 stands), each its index in VM, its count in TIMES
  ;;; and its FLAG (1 set where the compile stands, 2 void), the two in one
  ;;; block; ST the walks' stack, the machine's pair stack borrowed; BL the
  ;;; count's branch list, pairs of an index and a saved count, an entry
  ;;; where a variable's count leaves 0 (swipl's opens with a disjunction,
  ;;; which answers the same), the machine's clause slots borrowed; BUDGET
  ;;; the nodes a walk may still visit, past which a DAG is no clause the
  ;;; question is asked of. IDS are the consult's `cids', ==/2's and
  ;;; \==/2's names after them.
  (struct coco_fv
    (member coco_varmap * vm)
    (member char *        flag)
    (member int *         times)
    (member size_t        n)
    (member size_t        cap)
    (member size_t *      st)
    (member size_t        sn)
    (member size_t        scap)
    (member size_t *      bl)
    (member size_t        bln)
    (member size_t        blcap)
    (member size_t        budget))

  ;;; the index of a variable kept, or -1
  (static)
  (func coco_fv_at ((coco_fv * fv) (size_t cell)) (out i64)
        (let ((size_t k . 0))
          (if (coco_varmap_get (-> fv vm) cell (aof k)) (return (cast i64 k)))
          (return -1)))

  ;;; a variable to keep: 0 when there was no room
  (static)
  (func coco_fv_keep ((coco_fv * fv) (size_t cell)) (out int)
        (if (>= (coco_fv_at fv cell) 0) (return 1))
        (if (>= (-> fv n) (-> fv cap))
            (let ((size_t ncap . #'(? (== (-> fv cap) 0) 16 (* (-> fv cap) 2)))
                  (int * nt . nil))
              ;; the counts and, after them, the flags
              (set nt (cast (int *) (malloc (* ncap (+ (sizeof int) 1)))))
              (if (== nt nil) (return 0))
              (if (> (-> fv n) 0)
                  (block (memcpy nt (-> fv times) (* (-> fv n) (sizeof int)))
                         (memcpy (+ (cast (char *) nt) (* ncap (sizeof int))) (-> fv flag) (-> fv n))))
              (free (-> fv times))
              (set (-> fv times) nt)
              (set (-> fv flag) (+ (cast (char *) nt) (* ncap (sizeof int))))
              (set (-> fv cap) ncap)))
        (if (not (coco_varmap_put (-> fv vm) cell (-> fv n))) (return 0))
        (set (nth (-> fv n) (-> fv flag)) 0)
        (set (nth (-> fv n) (-> fv times)) 0)
        (set (-> fv n) (+ (-> fv n) 1))
        (return 1))

  ;;; room for K more words on the walks' stack: 0 when there was none
  (static)
  (func coco_fv_room ((coco_fv * fv) (size_t k)) (out int)
        (if (<= (+ (-> fv sn) k) (-> fv scap)) (return 1))
        (let ((size_t ncap . #'(* 2 (+ (+ (-> fv sn) k) 32))) (void * g . nil))
          (set g (realloc (cast (void *) (-> fv st)) (* ncap (sizeof size_t))))
          (if (== g nil) (return 0))
          (set (-> fv st) (cast (size_t *) g))
          (set (-> fv scap) ncap)
          (return 1)))

  ;;; a frame of four words, and a word
  (static)
  (func coco_fv_push4 ((coco_fv * fv) (size_t k) (size_t a) (size_t b) (size_t c)) (out int)
        (if (not (coco_fv_room fv 4)) (return 0))
        (let ((size_t * p . #'(+ (-> fv st) (-> fv sn))))
          (set (nth 0 p) k)
          (set (nth 1 p) a)
          (set (nth 2 p) b)
          (set (nth 3 p) c)
          (set (-> fv sn) (+ (-> fv sn) 4))
          (return 1)))

  (static)
  (func coco_fv_push1 ((coco_fv * fv) (size_t a)) (out int)
        (if (not (coco_fv_room fv 1)) (return 0))
        (set (nth (-> fv sn) (-> fv st)) a)
        (set (-> fv sn) (+ (-> fv sn) 1))
        (return 1))

  ;;; an entry of the branch list, for the variable of index I
  (static)
  (func coco_fv_branch ((coco_fv * fv) (size_t i)) (out int)
        (if (> (+ (-> fv bln) 2) (-> fv blcap))
            (let ((size_t ncap . #'(* 2 (+ (-> fv bln) 32))) (void * g . nil))
              (set g (realloc (cast (void *) (-> fv bl)) (* ncap (sizeof size_t))))
              (if (== g nil) (return 0))
              (set (-> fv bl) (cast (size_t *) g))
              (set (-> fv blcap) ncap)))
        (set (nth (-> fv bln) (-> fv bl)) i)
        (set (nth (+ (-> fv bln) 1) (-> fv bl)) 0)
        (set (-> fv bln) (+ (-> fv bln) 2))
        (return 1))

  ;;; the variables kept, down the body's control spine
  (static)
  (func coco_fv_collect ((coco_machine * m) (coco_fv * fv) (size_t b) (const u64 * ids)) (out int)
        (let ((int ok . 1) (int next . 0))
          (set (-> fv sn) 0)
          (while ok
            (set next 0)
            (set b (coco_deref m b))
            (if (coco-tag-is REF (nth b (-> m heap)))
                (set ok (coco_fv_keep fv b))
              (if (and (coco_is_callable m b) (not (coco_is_nil m b)))
                  (let ((u64 nid . #'(coco_name_of m b)) (u32 n . #'(coco_arity m b)))
                    (if (and (== n 1) (or (== nid (nth 4 ids)) (== nid (nth 11 ids))))
                        (block (set b (coco_arg m b 0)) (set next 1))
                      (if (== n 2)
                          (cond
                            ((== nid (nth 7 ids))
                             (let ((size_t q . #'(coco_deref m (coco_arg m b 0))))
                               (if (coco-tag-is REF (nth q (-> m heap))) (set ok (coco_fv_keep fv q)))
                               (set b (coco_arg m b 1))
                               (set next 1)))
                            ;; G@M (3.20.0): its module, then its goal
                            ((== nid (nth 12 ids))
                             (let ((size_t q . #'(coco_deref m (coco_arg m b 1))))
                               (if (coco-tag-is REF (nth q (-> m heap))) (set ok (coco_fv_keep fv q)))
                               (set b (coco_arg m b 0))
                               (set next 1)))
                            ((or (or (== nid (nth 0 ids)) (== nid (nth 1 ids)))
                                 (or (or (== nid (nth 2 ids)) (== nid (nth 3 ids))) (== nid (nth 6 ids))))
                             (if (not (coco_fv_push1 fv (coco_arg m b 1))) (set ok 0))
                             (set b (coco_arg m b 0))
                             (set next 1))
                            ((or (== nid (nth 9 ids)) (== nid (nth 10 ids)))
                             (let ((size_t x . #'(coco_deref m (coco_arg m b 0)))
                                   (size_t y . #'(coco_deref m (coco_arg m b 1))))
                               (if (coco-tag-is REF (nth x (-> m heap))) (set ok (coco_fv_keep fv x)))
                               (if (and ok (coco-tag-is REF (nth y (-> m heap))))
                                   (set ok (coco_fv_keep fv y)))))))))))
            (if (and ok (not next))
                (block (if (== (-> fv sn) 0) break)
                       (set (-> fv sn) (- (-> fv sn) 1))
                       (set b (nth (-> fv sn) (-> fv st))))))
          (return ok)))

  ;;; a term whose arguments the count walks as control too
  (static)
  (func coco_fv_control ((coco_machine * m) (size_t t) (const u64 * ids)) (out int)
        (let ((u64 nid . #'(coco_name_of m t)) (u32 n . #'(coco_arity m t)))
          (if (== n 1) (return (or (== nid (nth 4 ids)) (== nid (nth 11 ids)))))
          (if (!= n 2) (return 0))
          (return (or (or (or (== nid (nth 0 ids)) (== nid (nth 1 ids)))
                          (or (== nid (nth 2 ids)) (== nid (nth 3 ids))))
                      (or (or (== nid (nth 6 ids)) (== nid (nth 7 ids)))
                          (== nid (nth 12 ids)))))))

  ;;; SWIPL'S COUNT of each variable kept: T walked with CONTROL 1 where
  ;;; it is the body's control, 0 in the head and inside a goal. Frames:
  ;;; 0 a term (A, X the control), 1 a disjunction's left branch done (A
  ;;; its right, X the control, Y where its entries begin), 2 its right
  ;;; done, 3 a \+'s goal done.
  (static)
  (func coco_fv_count ((coco_machine * m) (coco_fv * fv) (size_t t) (size_t control)
                       (const u64 * ids)) (out int)
        (let ((int ok . 1))
          (set (-> fv sn) 0)
          (set ok (coco_fv_push4 fv 0 t control 0))
          (while (and ok (> (-> fv sn) 0))
            (let ((size_t * f . #'(+ (-> fv st) (- (-> fv sn) 4)))
                  (size_t k . 0) (size_t a . 0) (size_t x . 0) (size_t y . 0))
              (set k (nth 0 f))
              (set a (nth 1 f))
              (set x (nth 2 f))
              (set y (nth 3 f))
              (set (-> fv sn) (- (-> fv sn) 4))
              (cond
                ((== k 0)
                 (let ((size_t v . #'(coco_deref m a)) (u64 c . 0))
                   (if (== (-> fv budget) 0)
                       (set ok 0)
                     (block
                      (set (-> fv budget) (- (-> fv budget) 1))
                      (set c (nth v (-> m heap)))
                      (cond
                        ((coco-tag-is REF c)
                         (let ((i64 i . #'(coco_fv_at fv v)))
                           (if (>= i 0)
                               (block
                                ;; first met, or met again after a left branch
                                ;; set its count back
                                (if (== (nth i (-> fv times)) 0)
                                    (set ok (coco_fv_branch fv (cast size_t i))))
                                (set (nth i (-> fv times)) (+ (nth i (-> fv times)) 1))))))
                        ((coco-tag-is FUN c)
                         (let ((u64 nid . #'(coco_name_of m v)) (u32 n . #'(coco_arity m v)))
                           (cond
                             ((and x (and (== n 2) (== nid (nth 1 ids))))
                              (set ok (and (coco_fv_push4 fv 1 (coco_arg m v 1) x (-> fv bln))
                                           (coco_fv_push4 fv 0 (coco_arg m v 0) x 0))))
                             ((and x (and (== n 1) (== nid (nth 4 ids))))
                              (set ok (and (coco_fv_push4 fv 3 0 0 (-> fv bln))
                                           (coco_fv_push4 fv 0 (coco_arg m v 0) x 0))))
                             (#t
                              (let ((size_t x2 . #'(? (and x (coco_fv_control m v ids)) 1 0)) (u32 j . n))
                                (while (and ok (> j 0))
                                  (set j (- j 1))
                                  (set ok (coco_fv_push4 fv 0 (coco_arg m v j) x2 0)))))))))))))
                ((== k 1)
                 ;; the left branch's counts kept, and the right's from 0
                 (let ((size_t i . y))
                   (while (< i (-> fv bln))
                     (set (nth (+ i 1) (-> fv bl))
                          (cast size_t (nth (nth i (-> fv bl)) (-> fv times))))
                     (set (nth (nth i (-> fv bl)) (-> fv times)) 0)
                     (set i (+ i 2)))
                   (set ok (and (coco_fv_push4 fv 2 0 0 y) (coco_fv_push4 fv 0 a x 0)))))
                ((== k 2)
                 ;; each the larger of its two branches
                 (let ((size_t i . y))
                   (while (< i (-> fv bln))
                     (let ((size_t vi . #'(nth i (-> fv bl)))
                           (int sv . #'(cast int (nth (+ i 1) (-> fv bl)))))
                       (if (< (nth vi (-> fv times)) sv) (set (nth vi (-> fv times)) sv)))
                     (set i (+ i 2)))))
                (#t
                 ;; a \+'s new variables are no branch's
                 (set (-> fv bln) y)))))
          (return ok)))

  ;;; every variable kept that T holds is set, as a goal's first use sets
  ;;; it; on the walks' stack above what is there
  (static)
  (func coco_fv_mark ((coco_machine * m) (coco_fv * fv) (size_t t)) (out int)
        (let ((size_t base . #'(-> fv sn)) (int ok . 1))
          (while ok
            (set t (coco_deref m t))
            (if (== (-> fv budget) 0) (block (set ok 0) break))
            (set (-> fv budget) (- (-> fv budget) 1))
            (let ((u64 c . #'(nth t (-> m heap))))
              (cond
                ((coco-tag-is REF c)
                 (let ((i64 i . #'(coco_fv_at fv t)))
                   (if (>= i 0) (set (nth i (-> fv flag)) (bitor (nth i (-> fv flag)) 1)))))
                ((coco-tag-is FUN c)
                 (let ((u32 n . #'(coco_arity m t)))
                   (for ((u32 j . 0)) (< j n) ((++ j))
                     (if (not (coco_fv_push1 fv (coco_arg m t j))) (set ok 0)))))))
            (if (not ok) break)
            (if (== (-> fv sn) base) break)
            (set (-> fv sn) (- (-> fv sn) 1))
            (set t (nth (-> fv sn) (-> fv st))))
          (set (-> fv sn) base)
          (return ok)))

  ;;; ==/2 AND \==/2 IN PLACE, setting nothing: two variables the compile
  ;;; keeps a place for, or one and an atom or an integer of 32 bits (a
  ;;; portable constant); anything else is a call, which sets its
  ;;; variables
  (static)
  (func coco_fv_placed ((coco_machine * m) (coco_fv * fv) (size_t v)) (out int)
        (if (not (coco-tag-is REF (nth v (-> m heap)))) (return 0))
        (let ((i64 i . #'(coco_fv_at fv v)))
          (return (and (>= i 0) (not (bitand (nth i (-> fv flag)) 2))))))

  (static)
  (func coco_fv_const ((coco_machine * m) (size_t v)) (out int)
        (let ((u64 c . #'(nth v (-> m heap))))
          (if (coco-tag-is ATOM c) (return 1))
          (if (coco-tag-is INT c)
              (let ((i64 x . #'(coco-signed-payload c)))
                (return (and (>= x (- 0 2147483648)) (<= x 2147483647)))))
          (return 0)))

  (static)
  (func coco_fv_inline ((coco_machine * m) (coco_fv * fv) (size_t g)) (out int)
        (let ((size_t x . #'(coco_deref m (coco_arg m g 0)))
              (size_t y . #'(coco_deref m (coco_arg m g 1))))
          (if (coco_fv_placed m fv x) (return (or (coco_fv_placed m fv y) (coco_fv_const m y))))
          (return (and (coco_fv_const m x) (coco_fv_placed m fv y)))))

  ;;; THE COMPILE'S ORDER: B's goals as swipl compiles them, and the first
  ;;; fault -- 1 a goal that is none, 2 a module no goal set (Q), 4 a
  ;;; module that is no atom (Q) -- or 0; -1 when a walk ran out. Frames:
  ;;; 0 a goal (A), 1 a disjunction's else (A, X where the flags its start
  ;;; saved stand on the stack), 2 its end, right above them.
  (static)
  (func coco_fv_walk ((coco_machine * m) (coco_fv * fv) (size_t b) (const u64 * ids) (size_t * q))
        (out int)
        (let ((int ok . 1) (int r . 0))
          (set (-> fv sn) 0)
          (set ok (coco_fv_push4 fv 0 b 0 0))
          (while (and ok (and (== r 0) (> (-> fv sn) 0)))
            (let ((size_t * f . #'(+ (-> fv st) (- (-> fv sn) 4)))
                  (size_t k . 0) (size_t a . 0) (size_t x . 0))
              (set k (nth 0 f))
              (set a (nth 1 f))
              (set x (nth 2 f))
              (set (-> fv sn) (- (-> fv sn) 4))
              (cond
                ((== k 0)
                 (let ((size_t g . #'(coco_deref m a)))
                   (cond
                     ((coco-tag-is REF (nth g (-> m heap)))
                      (let ((i64 i . #'(coco_fv_at fv g)))
                        (if (or (< i 0) (bitand (nth i (-> fv flag)) 2))
                            (set r 1)
                          (set (nth i (-> fv flag)) (bitor (nth i (-> fv flag)) 1)))))
                     ((or (not (coco_is_callable m g)) (coco_is_nil m g)) (set r 1))
                     (#t
                      (let ((u64 nid . #'(coco_name_of m g)) (u32 n . #'(coco_arity m g)))
                        (cond
                          ((and (== n 2) (== nid (nth 0 ids)))
                           (set ok (and (coco_fv_push4 fv 0 (coco_arg m g 1) 0 0)
                                        (coco_fv_push4 fv 0 (coco_arg m g 0) 0 0))))
                          ((and (== n 2) (or (== nid (nth 1 ids)) (== nid (nth 6 ids))))
                           ;; the flags saved, then its end, its else and its
                           ;; first branch (an if-then-else's condition and
                           ;; then, walked by the `->' rule below)
                           (let ((size_t lv . #'(-> fv sn)) (size_t nw . #'(/ (+ (-> fv n) 7) 8)))
                             (set ok (coco_fv_room fv nw))
                             (if ok
                                 (block
                                  (memcpy (cast (void *) (+ (-> fv st) lv)) (-> fv flag) (-> fv n))
                                  (set (-> fv sn) (+ lv nw))
                                  (set ok (and (and (coco_fv_push4 fv 2 g lv 0) (coco_fv_push4 fv 1 g lv 0))
                                               (coco_fv_push4 fv 0 (coco_arg m g 0) 0 0)))))))
                          ((and (== n 2) (or (== nid (nth 2 ids)) (== nid (nth 3 ids))))
                           (set ok (and (coco_fv_push4 fv 0 (coco_arg m g 1) 0 0)
                                        (coco_fv_push4 fv 0 (coco_arg m g 0) 0 0))))
                          ((and (== n 1) (or (== nid (nth 4 ids)) (== nid (nth 11 ids))))
                           (set ok (coco_fv_push4 fv 0 (coco_arg m g 0) 0 0)))
                          ;; M:G, and G@M (3.20.0): the module, then the goal
                          ((and (== n 2) (or (== nid (nth 7 ids)) (== nid (nth 12 ids))))
                           (let ((u32 mi . #'(? (== nid (nth 12 ids)) 1 0))
                                 (size_t mq . 0))
                             (set mq (coco_deref m (coco_arg m g mi)))
                             (cond
                               ((coco-tag-is REF (nth mq (-> m heap)))
                                ;; one the count takes for a singleton is never
                                ;; set where it stands
                                (let ((i64 i . #'(coco_fv_at fv mq)))
                                  (if (or (< i 0) (not (bitand (nth i (-> fv flag)) 1)))
                                      (block (set (cof q) mq) (set r 2))
                                    (set ok (coco_fv_push4 fv 0 (coco_arg m g (- 1 mi)) 0 0)))))
                               ((coco_module_name m mq)
                                (set ok (coco_fv_push4 fv 0 (coco_arg m g (- 1 mi)) 0 0)))
                               (#t (set (cof q) mq) (set r 4)))))
                          (#t
                           (if (not (and (== n 2) (and (or (== nid (nth 9 ids)) (== nid (nth 10 ids)))
                                                         (coco_fv_inline m fv g))))
                               (set ok (coco_fv_mark m fv g))))))))))
                ((== k 1)
                 ;; the else starts from what was set before the disjunction
                 (memcpy (-> fv flag) (cast (void *) (+ (-> fv st) x)) (-> fv n))
                 (set ok (coco_fv_push4 fv 0 (coco_arg m a 1) 0 0)))
                (#t
                 ;; and after it every variable it names is set (what the
                 ;; else set is among them); the saved flags go
                 (set (-> fv sn) x)
                 (set ok (and (coco_fv_mark m fv (coco_arg m a 0)) (coco_fv_mark m fv (coco_arg m a 1))))))))
          (if (not ok) (return -1))
          (return r)))

  ;;; The answer for head H and body B, as the walk above gives it (Q the
  ;;; module of a 2 or a 4); -1 when it could not be asked: a cycle, which
  ;;; the store refuses, a DAG past four times the heap, no memory.
  (static)
  (func coco_fresh_fault ((coco_machine * m) (size_t h) (size_t b) (const u64 * ids) (size_t * q))
        (out int)
        (let ((coco_varmap vm . '{ nil nil 0 0 0 }) (coco_fv fv) (int r . -1))
          (if (or (!= 1 (coco_acyclic m h)) (!= 1 (coco_acyclic m b))) (return -1))
          (memset (aof fv) 0 (sizeof coco_fv))
          (coco_varmap_take m (aof vm))
          (set ($ fv vm) (aof vm))
          (set ($ fv st) (coco_wpairs_take m (aof ($ fv scap))))
          (set ($ fv bl) (coco_cslots_take m 64 (aof ($ fv blcap))))
          (set ($ fv budget) (+ (* 4 (-> m heap_len)) 4096))
          (if (and (coco_fv_collect m (aof fv) b ids)
                   (and (coco_fv_count m (aof fv) h 0 ids) (coco_fv_count m (aof fv) b 1 ids)))
              (block
               (for ((size_t i . 0)) (< i ($ fv n)) ((++ i))
                 (if (== (nth i ($ fv times)) 1) (set (nth i ($ fv flag)) 2)))
               (set ($ fv sn) 0)
               (if (coco_fv_mark m (aof fv) h)
                   (set r (coco_fv_walk m (aof fv) b ids q)))))
          (free ($ fv times))
          (coco_wpairs_give m ($ fv st) ($ fv scap))
          (if (!= ($ fv bl) nil) (coco_cslots_give m ($ fv bl) ($ fv blcap)))
          (coco_varmap_give m (aof vm))
          (return r)))

  ;;; A BODY HOLDS ONLY GOALS (3.1.0, a load's, as assert's
  ;;; `coco_body_callable'): 1 when every goal of B's control spine -- under
  ;;; `,', `;', `->', `*->', `\+' and since 3.2.0 the bar -- is a callable
  ;;; term or a variable (call/1 of it, as ISO has it), 0 when one is not;
  ;;; the list's end is none (3.19.2, swipl 7's: `p :- [].' went in).
  ;;; IDS are those names' ids, `:-''s, the bar's, `:''s and `=>''s,
  ;;; interned once a consult; a body read from text is no cycle, and its
  ;;; depth is the reader's.
  ;;;
  ;;; A GOAL QUALIFIED BY A MODULE IS ITS GOAL (3.19.2, swipl's): under
  ;;; `M:G' the walk goes on into G, and an M that is neither an atom nor a
  ;;; variable is the fault -- 2, with M in MOD. Through 3.19.1 `M:G' was a
  ;;; callable term and nothing more, and `p :- foo:3' went in. FV is set
  ;;; where a variable stands for a goal or a module before the walk ends
  ;;; (3.19.3): the clause is then asked by `coco_fresh_fault'.
  ;;; `$(G)' AND G@M ARE CONTROL TOO (3.20.0, swipl's): G walked, and an M
  ;;; of G@M asked before its G, as `M:G''s is (IDS[11] and IDS[12]).
  (static)
  (func coco_consult_goals ((coco_machine * m) (size_t b) (const u64 * ids) (size_t * mod) (int * fv))
        (out int)
        (while 1
          (set b (coco_deref m b))
          (if (coco-tag-is REF (nth b (-> m heap))) (block (set (cof fv) 1) (return 1)))
          (if (or (not (coco_is_callable m b)) (coco_is_nil m b)) (return 0))
          (let ((u64 nid . #'(coco_name_of m b)) (u32 n . #'(coco_arity m b)))
            (if (and (== n 1) (or (== nid (nth 4 ids)) (== nid (nth 11 ids))))
                (block (set b (coco_arg m b 0)) continue))
            (if (and (== n 2) (or (== nid (nth 7 ids)) (== nid (nth 12 ids))))
                (let ((int at . #'(== nid (nth 12 ids))) (size_t q . 0))
                  (set q (coco_deref m (coco_arg m b (? at 1 0))))
                  (if (coco-tag-is REF (nth q (-> m heap))) (set (cof fv) 1))
                  (if (not (or (coco-tag-is REF (nth q (-> m heap))) (coco_module_name m q)))
                      (block (set (cof mod) q) (return 2)))
                  (set b (coco_arg m b (? at 0 1)))
                  continue))
            (if (not (and (== n 2) (or (or (== nid (nth 0 ids)) (== nid (nth 1 ids)))
                                         (or (== nid (nth 2 ids)) (== nid (nth 3 ids)))
                                         (== nid (nth 6 ids)))))
                (return 1))
            (let ((int r . #'(coco_consult_goals m (coco_arg m b 0) ids mod fv)))
              (if (!= r 1) (return r)))
            (set b (coco_arg m b 1))))
        (return 1))

  ;;; THE QUALIFIERS ON TOP OF A HEAD OR A CLAUSE, taken off as swipl's
  ;;; strip_module does (3.19.2): T is left on what they qualify; 0 when
  ;;; that is all, 2 for a variable module, 4 for one that is no atom (in
  ;;; OUT)
  (static)
  (func coco_consult_unqualify ((coco_machine * m) (size_t * t) (const u64 * ids) (size_t * out))
        (out int)
        (set (cof t) (coco_deref m (cof t)))
        (while (and (coco_is_callable m (cof t))
                    (and (== (coco_arity m (cof t)) 2) (== (coco_name_of m (cof t)) (nth 7 ids))))
          (let ((size_t q . #'(coco_deref m (coco_arg m (cof t) 0))))
            (if (coco-tag-is REF (nth q (-> m heap))) (return 2))
            (if (not (coco_module_name m q)) (block (set (cof out) q) (return 4)))
            (set (cof t) (coco_deref m (coco_arg m (cof t) 1)))))
        (return 0))

  ;;; A BODY'S REFUSAL, as swipl's compiler gives it (3.19.2): the
  ;;; qualifiers on its top taken off, and the rest walked -- a goal that is
  ;;; no goal names what was left (`foo:(a, 3)' names `a,3', `(a, foo:3)'
  ;;; the whole), and a module that is no atom names itself, the walk's
  ;;; first fault winning. Under a variable module on top, a body that will
  ;;; not do is an instantiation error, its module's fault still its own.
  ;;; 0, 1 (OUT the body), 2 or 4 (OUT the module), as
  ;;; `coco_consult_refused' answers. A variable where a goal or a module
  ;;; stands (3.19.3) has the clause asked as swipl's compiler asks it,
  ;;; head H and all, by `coco_fresh_fault', whose first fault is the
  ;;; answer: a void goal one as a number is, a module no goal set an
  ;;; instantiation error.
  (static)
  (func coco_consult_body_refused ((coco_machine * m) (size_t h) (size_t b) (const u64 * ids)
                                   (size_t * out))
        (out int)
        (let ((size_t q . 0) (int r . 0) (int fv . 0) (int vtop . 0) (size_t b0 . b))
          (set b (coco_deref m b))
          (while (and (coco_is_callable m b)
                      (and (== (coco_arity m b) 2) (== (coco_name_of m b) (nth 7 ids))))
            (set q (coco_deref m (coco_arg m b 0)))
            (if (coco-tag-is REF (nth q (-> m heap)))
                (block (set vtop 1) (set fv 1) (set b (coco_arg m b 1)) break))
            (if (not (coco_module_name m q)) (block (set (cof out) q) (return 4)))
            (set b (coco_deref m (coco_arg m b 1))))
          (set r (coco_consult_goals m b ids out (aof fv)))
          (if fv
              (let ((int f . #'(coco_fresh_fault m h b0 ids (aof q))))
                (if (== f 0) (return 0))
                (if (== f 2) (return 2))
                (if (== f 4) (block (set (cof out) q) (return 4)))
                ;; a goal that is none: the body its qualifiers left, or under
                ;; a variable module, or when what they left is a variable,
                ;; an instantiation error (swipl's PL_error of a type error)
                (if (== f 1)
                    (block (set b (coco_deref m b))
                           (if (or vtop (coco-tag-is REF (nth b (-> m heap)))) (return 2))
                           (set (cof out) b)
                           (return 1)))))
          (if vtop (return (? (== r 1) 0 (? (== r 2) 4 2))))
          (if (== r 1) (return 0))
          (if (== r 0) (block (set (cof out) b) (return 1)))
          (return 4)))

  ;;; WHAT A LOAD REFUSES OF A CLAUSE, as swipl's does (3.1.0): 1 with the
  ;;; term the report names in OUT -- the clause when it is no callable term
  ;;; (`3.', `1.5.'), its head when that is none, the whole body when a goal
  ;;; in it is no goal (`foo :- 3.', `bar :- (a, 1).'); 2 for a variable
  ;;; where the clause or its head stands; 3 for `[].', which swipl passes
  ;;; over in silence; 0 for a clause that may go on. Through 3.0.4 the
  ;;; first ended the consult (`not a clause') and the body went in.
  ;;;
  ;;; THE QUALIFIERS AND A SINGLE-SIDED RULE ARE ASKED TOO (3.19.2, swipl's):
  ;;; `foo:3.' names `3', `3:foo.' is type_error(module, 3), `M:foo.' an
  ;;; instantiation error, the clause's qualifiers (`foo:(p :- 3)') and the
  ;;; head's taken off as the body's are (`coco_consult_body_refused'); 4
  ;;; is a module's fault, OUT the module. A single-sided rule's body is its
  ;;; guard, a cut and its body, `x, 3 => true' naming `3,!,true', and
  ;;; under a qualifier its head is not split, as swipl's: `foo:(p, g =>
  ;;; b)' is a clause of `,'/2, 5 (the store, which peels the qualifier,
  ;;; would have split it).
  (static)
  (func coco_consult_refused ((coco_machine * m) (size_t t) (const u64 * ids) (size_t * out))
        (out int)
        (let ((int r . 0) (int qual . 0) (int hasb . 0) (size_t h . 0) (size_t b . 0))
          (set t (coco_deref m t))
          (if (coco-tag-is REF (nth t (-> m heap))) (return 2))
          (if (coco_is_nil m t) (return 3))
          (set h t)
          (set r (coco_consult_unqualify m (aof t) ids out))
          (if (!= r 0) (return r))
          (if (!= t h) (set qual 1))
          (if (coco-tag-is REF (nth t (-> m heap))) (return 2))
          (if (not (coco_is_callable m t)) (block (set (cof out) t) (return 1)))
          (if (and (== (coco_arity m t) 2)
                   (or (== (coco_name_of m t) (nth 5 ids)) (== (coco_name_of m t) (nth 8 ids))))
              (block
               (set h (coco_deref m (coco_arg m t 0)))
               (set b (coco_arg m t 1)) (set hasb 1)
               (if (and (== (coco_name_of m t) (nth 8 ids))
                        (and (coco_is_callable m h)
                             (and (== (coco_arity m h) 2) (== (coco_name_of m h) (nth 0 ids)))))
                   (block
                    ;; a qualified rule's guard is no guard: a clause of `,'/2
                    (if qual (return 5))
                    (set b (coco_make2 m "," (coco_arg m h 1)
                                       (coco_make2 m "," (coco_new_atom m "!") b)))
                    (set h (coco_deref m (coco_arg m h 0))))))
            (set h t))
          (set r (coco_consult_unqualify m (aof h) ids out))
          (if (!= r 0) (return r))
          (if (coco-tag-is REF (nth h (-> m heap))) (return 2))
          (if (not (coco_is_callable m h)) (block (set (cof out) h) (return 1)))
          (if hasb (return (coco_consult_body_refused m h b ids out)))
          (return 0)))

  ;;; swipl's sentence for a refused clause: `Type error: `callable'
  ;;; expected, found `3' (an integer)', the culprit written as print/1
  ;;; writes it and its kind named as the error text names one
  (static)
  (func coco_consult_type_text ((coco_machine * m) (const char * type) (size_t c)
                                (char * out) (size_t len))
        (let ((coco_strbuf b) (u64 w . 0) (const char * kind . "a compound"))
          (set c (coco_deref m c))
          (set w (nth c (-> m heap)))
          (cond
            ((coco_is_nil m c) (set kind "an empty_list"))
            ((coco-tag-is ATOM w) (set kind "an atom"))
            ((coco-is-int w) (set kind "an integer"))
            ((coco-tag-is STR w) (set kind "a string"))
            ((coco-rat-p w) (set kind "a rational"))
            ((coco-tag-is FLT w) (set kind "a float")))
          (coco_sb_init (aof b))
          (coco_write_term m (aof b) c 1 0)
          (snprintf out len "Type error: `%s' expected, found `%s' (%s)"
                    type (? (== ($ b s) nil) "?" ($ b s)) kind)
          (coco_sb_free (aof b))))

  (static)
  (func coco_consult_refusal ((coco_machine * m) (size_t c) (char * out) (size_t len))
        (coco_consult_type_text m "callable" c out len))

  ;;; swipl's sentence for a grammar rule that will not translate (3.13.0),
  ;;; the message of the ball its boot/dcg.pl throws: KIND is the
  ;;; translator's (`coco_dcg_ekind'), C its culprit
  (static)
  (func coco_consult_dcg_refusal ((coco_machine * m) (int kind) (size_t c)
                                  (char * out) (size_t len))
        (cond
          ((== kind COCO_DCG_INST)
           (snprintf out len "Arguments are not sufficiently instantiated"))
          ((== kind COCO_DCG_CALLABLE) (coco_consult_type_text m "callable" c out len))
          ((== kind COCO_DCG_LIST) (coco_consult_type_text m "list_or_partial_list" c out len))
          ((== kind COCO_DCG_NONTERM)
           (let ((coco_strbuf b))
             (coco_sb_init (aof b))
             (coco_write_term m (aof b) (coco_deref m c) 1 0)
             (snprintf out len "No permission to define dcg_nonterminal `%s'"
                       (? (== ($ b s) nil) "?" ($ b s)))
             (coco_sb_free (aof b))))
          (#t (snprintf out len "Not enough resources: memory"))))

  ;;; WHETHER PATH IS OPEN ON THE WAY DOWN to an include (3.5.0), or the way
  ;;; is sixty-four files deep: an include of it would read it again, and
  ;;; it again, for ever -- which swipl does, until it is killed
  (static)
  (func coco_include_open ((const char ** incs) (int ninc) (const char * path)) (out int)
        (if (>= ninc 64) (return 1))
        (for ((int i . 0)) (< i ninc) ((++ i))
          (if (and (!= (nth i incs) nil) (== 0 (strcmp (nth i incs) path))) (return 1)))
        (return 0))

  ;;; and the ball that ends the load then, error(permission_error(include,
  ;;; source_sink, Spec), _), cocolog's: put on the machine (`lball') for
  ;;; whoever asked for the load to throw, its text in ERR
  (static)
  (func coco_include_refused ((coco_store * st) (coco_machine * m) (size_t spec)
                              (char * err) (size_t errlen))
        (let ((size_t mark . #'(-> m heap_len)) (coco_strbuf b) (size_t pa [3]) (size_t ball . 0))
          (set (nth 0 pa) (coco_new_atom m "include"))
          (set (nth 1 pa) (coco_new_atom m "source_sink"))
          (set (nth 2 pa) spec)
          (set ball (coco_make2 m "error" (coco_make m "permission_error" 3 pa) (coco_new_var m)))
          (coco_sb_init (aof b))
          (coco_write_term m (aof b) (coco_deref m spec) 1 0)
          (snprintf err errlen "No permission to include source_sink `%s'"
                    (? (== ($ b s) nil) "?" ($ b s)))
          (coco_sb_free (aof b))
          (let ((size_t c . #'(coco_store_put st m ball)))
            (set (-> m lball) (+ c 1))
            (set (-> m lball_size) (- (-> st len) c)))
          (set (-> m heap_len) mark)))

  ;;; THE PROGRAM'S EXPANSION HOOKS (3.14.0), what a load and expand_term/2
  ;;; ask before they call one: 1 when term_expansion/2 has a live clause,
  ;;; 2 when goal_expansion/2 has one of the program's own -- read from a
  ;;; file of the program (the predicate `own'), or consulted or asserted
  ;;; unmuted. library(yall)'s `system:goal_expansion/2', in the one
  ;;; namespace beside a program's, is neither: it is swipl's lambda
  ;;; expansion, which a plain swipl file never meets (there yall is
  ;;; autoloaded, not loaded), and it calls prolog_load_context/2, which
  ;;; cocolog does not have.
  (func coco_xhook_bits ((coco_store * st) (coco_machine * m)) (out int)
        (let ((int bits . 0) (size_t pi . 0) (size_t n . 0) (size_t i . 0))
          (set pi (coco_pred_find st (coco_intern m "term_expansion") 2))
          (if (and (< pi (-> st npreds)) (> (coco_pred_ready st pi) 0))
              (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
                (set n (-> p nclauses))
                (set i 0)
                (while (< i n)
                  (if (not (coco_pred_dead p i)) (block (set bits 1) break))
                  (set i (+ i 1)))))
          (set pi (coco_pred_find st (coco_intern m "goal_expansion") 2))
          (if (and (< pi (-> st npreds)) (> (coco_pred_ready st pi) 0))
              (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
                (set n (-> p nclauses))
                (set i 0)
                (while (< i n)
                  (if (and (not (coco_pred_dead p i))
                           (or (-> p own) (== (nth i (-> p muted)) 0)))
                      (block (set bits (bitor bits 2)) break))
                  (set i (+ i 1)))))
          (return bits)))

  ;;; and what a load asks: the bits, where a hook can run at all -- a goal
  ;;; hook installed (none in a test binary) and the text no compiled-in
  ;;; module's own (`noexp')
  (static)
  (func coco_xhook_load ((coco_store * st) (coco_machine * m)) (out int)
        (if (or (== coco_goal_hook nil) (-> st noexp)) (return 0))
        (return (coco_xhook_bits st m)))

  ;;; ONE EXPANSION ASKED OF THE PROGRAM AT A LOAD (3.14.0): NAME(A, T, X)
  ;;; -- or NAME(T, X) when A is 0 -- run through the load's goal hook (an
  ;;; engine of its own; no collection), 1 with X in OUT, 0 when it failed,
  ;;; -1 when it raised an error(_, _), its message in ERR and no
  ;;; backtrace, as swipl reports an expansion's error, and -2 for any
  ;;; other ball, which ends the load as a directive's does (the hook kept
  ;;; it, `lball'). X's binding is kept and its trail
  ;;; entries dropped: every cell it names is above the mark the load winds
  ;;; the heap back to, which takes them all.
  (static)
  (func coco_consult_xcall ((coco_store * st) (coco_machine * m) (const char * name)
                            (size_t a) (size_t t) (size_t * out)
                            (const char * file) (int line) (const char * src)
                            (const char * text) (size_t off)
                            (char * err) (size_t errlen)) (out int)
        (let ((size_t x . #'(coco_new_var m)) (size_t g . 0) (size_t tl . #'(-> m trail_len))
              (int r . 0)
              ;; source_location/2 and prolog_load_context/2 answer the
              ;; term's place while the hook runs, as swipl's do
              (const char * sfile . #'(-> m sloc_file)) (int sline . #'(-> m sloc_line))
              (const char * ssrc . #'(-> m sloc_src)) (const char * stext . #'(-> m sloc_text))
              (size_t soff . #'(-> m sloc_off)))
          (if (== a 0)
              (set g (coco_make2 m name t x))
            (let ((size_t args [3]))
              (set (nth 0 args) a) (set (nth 1 args) t) (set (nth 2 args) x)
              (set g (coco_make m name 3 args))))
          (set (-> m sloc_file) file) (set (-> m sloc_line) line) (set (-> m sloc_src) src)
          (set (-> m sloc_text) text) (set (-> m sloc_off) off)
          (set r (coco_goal_hook st m g 0 err errlen))
          (set (-> m sloc_file) sfile) (set (-> m sloc_line) sline) (set (-> m sloc_src) ssrc)
          (set (-> m sloc_text) stext) (set (-> m sloc_off) soff)
          (if (== r 1)
              (block (set (-> m trail_len) tl)
                     (set (cof out) (coco_deref m x))
                     (return 1)))
          (if (== r 0) (return 0))
          (if (== r -2) (return -2))
          (return -1)))

  ;;; a clause's head is one of the two hooks: term_expansion/2 or
  ;;; goal_expansion/2, qualified or not, a fact or a rule -- after which
  ;;; the load asks the hooks again
  (static)
  (func coco_xhook_head ((coco_machine * m) (size_t c) (u64 te) (u64 ge)) (out int)
        (set c (coco_deref m c))
        (if (coco_is_compound2 m c ":-") (set c (coco_deref m (coco_arg m c 0))))
        (while (coco_is_compound2 m c ":") (set c (coco_deref m (coco_arg m c 1))))
        (if (or (not (coco_is_callable m c)) (!= (coco_arity m c) 2)) (return 0))
        (return (or (== (coco_name_of m c) te) (== (coco_name_of m c) ge))))

  ;;; the clause a grammar rule was translated to makes its predicate a
  ;;; non-terminal (3.14.0, `coco_pred_nt_mark'), as swipl's load records
  ;;; every rule's, one an expansion gave among them
  (static)
  (func coco_consult_nt_mark ((coco_store * st) (coco_machine * m) (size_t c))
        (set c (coco_deref m c))
        (if (coco_is_compound2 m c ":-") (set c (coco_deref m (coco_arg m c 0))))
        (while (coco_is_compound2 m c ":") (set c (coco_deref m (coco_arg m c 1))))
        (if (coco_is_callable m c) (coco_pred_nt_mark st (coco_name_of m c) (coco_arity m c))))

  ;;; a term that is `:- if(_)', `:- elif(_)', `:- else' or `:- endif',
  ;;; which swipl's conditional reading takes before term_expansion/2 sees
  ;;; anything
  (static)
  (func coco_consult_cond_dir ((coco_machine * m) (size_t t)) (out int)
        (set t (coco_deref m t))
        (if (not (coco_is_compound1 m t ":-")) (return 0))
        (let ((size_t d . #'(coco_deref m (coco_arg m t 0))) (const char * dn . nil) (u32 da . 0))
          (if (not (coco_is_callable m d)) (return 0))
          (set dn (coco_atom_name m (coco_name_of m d)))
          (set da (coco_arity m d))
          (if (== da 1) (return (or (== 0 (strcmp dn "if")) (== 0 (strcmp dn "elif")))))
          (if (== da 0) (return (or (== 0 (strcmp dn "else")) (== 0 (strcmp dn "endif")))))
          (return 0)))

  ;;; what term_expansion/2 gave is its terms when it is a proper list, as
  ;;; swipl's '$expand_terms' reads it, and one term otherwise
  (static)
  (func coco_consult_xlist ((coco_machine * m) (size_t xs)) (out int)
        (let ((size_t n . #'(-> m heap_len)))
          (set xs (coco_deref m xs))
          (while (and (coco_is_cons m xs) (> n 0))
            (set xs (coco_deref m (coco_arg m xs 1)))
            (set n (- n 1)))
          (return (coco_is_nil m xs))))

  ;;; the term is the atom end_of_file, which ends the file where it stands
  ;;; (3.14.0), as swipl's: read there, or given by term_expansion/2
  (static)
  (func coco_consult_eof ((coco_machine * m) (size_t t) (u64 eof)) (out int)
        (let ((size_t c . #'(nth (coco_deref m t) (-> m heap))))
          (return (and (coco-tag-is ATOM c) (== (coco-payload c) eof)))))

  ;;; a ball that is no error(_, _) ends the load, as a directive's does:
  ;;; its message said as a script's load says it
  (static)
  (func coco_consult_init_failed ((char * err) (size_t errlen))
        (let ((char * msg . #'(strdup err)))
          (if (!= msg nil)
              (block (snprintf err errlen "Prolog initialisation failed:\nERROR: %s" msg)
                     (free msg)))))

  ;;; SINGLETON VARIABLES, AS SWI WARNS OF THEM AT A LOAD (3.17.0): a
  ;;; variable the clause names and uses once. The reader has the names and
  ;;; their cells; this walks the clause, counts each cell and writes SWI's
  ;;; `Singleton variables: [X, Y]'. A name `_X' (an underscore and a
  ;;; capital) or `__x' is the reader's way of saying "do not warn", as
  ;;; SWI's warn_singleton(); `_x' is warned of, as SWI's is (3.19.5;
  ;;; through 3.19.4 every name beginning `_' was passed over).

  ;;; THE COMPILER'S WARNINGS OF A CLAUSE (3.19.1; by swipl's own two passes
  ;;; since 3.19.5), swipl's second block, which its compiler gives where the
  ;;; reader gave the first (pl-comp.c 9.0.4).
  ;;;
  ;;; FIRST ITS COUNT OF THE VARIABLES (analyseVariables2, `coco_cwa_walk',
  ;;; whose every occurrence counted is the reader's count too): each named
  ;;; variable's occurrences, a disjunction of the body's control
  ;;; counting the variables new to it as the larger of its two branches. A
  ;;; variable new to a disjunction that either branch names once is a
  ;;; branch's singleton, until the clause names it again after the
  ;;; disjunction; one new to a \+ that it names once is the \+'s, which
  ;;; nothing clears. Said in the order swipl's compiler keeps the variables
  ;;; (a head argument's by its place, every other by its first occurrence),
  ;;; a line each at most: `Singleton variable in branch: Y', `... in \+: Y',
  ;;; or, of a name marked singleton (`_X', `__x') counted twice or more,
  ;;; `Singleton-marked variable appears more than once: _X'. Through 3.19.4
  ;;; a branch's singleton was one first met at its last occurrence, and
  ;;; `p :- (X ; foo((X ; X))).' and `p :- (X ; bar(X, X)).' were not said.
  ;;;
  ;;; THEN THE COMPILE (`coco_cwc_walk'), goal by goal, of a clause whose
  ;;; count met one of the tests below (no other has a line to say): the
  ;;; head and every goal set the variables they name, but the tests
  ;;; compiled in place.
  ;;; Said as they are met: a test ==/2 or \==/2 with a void operand (named
  ;;; once, or `_'), which is then a call and sets the rest, or of two
  ;;; variables one of them unset, which sets neither (`Test is always
  ;;; false: X==Y', `... true: X==X'); and (3.19.5) a type test -- var,
  ;;; nonvar, integer, rational, float, number, atomic, atom, string,
  ;;; compound, callable -- of a void or unset variable, or of a bound term,
  ;;; whose answer the compiler knows (`Test is always true: var(X)', `...
  ;;; false: atom(f(X))'), then a call. A branch starts from what was set
  ;;; before its disjunction, and what either set is set after it; a \+
  ;;; keeps what it set. A line is said only when its test names a
  ;;; variable, as swipl's messages.pl drops one that names none (`var(a)').
  ;;;
  ;;; A goal no control construct is (a meta-call's argument among them) is
  ;;; only its occurrences. `|' is a branch of the compile and not of the
  ;;; count, and of both in a grammar rule, whose translation makes it `;';
  ;;; a grammar rule's `{}' holds goals and a list is a terminal; `M:G' is
  ;;; G, and so are `$(G)' and `@(G, M)', but in a grammar rule, where they
  ;;; are non-terminals. A qualified clause `M:(H :- B)' is the clause; a
  ;;; qualified grammar rule or single-sided rule is none, as swipl
  ;;; translates neither. A directive has none of it. Probed against swipl
  ;;; 9.0.4 case by case (test/files/warnings_branch.pl,
  ;;; test/files/warnings_tests.pl).

  ;;; the reader's index of a variable's cell, or -1: an anonymous `_'
  (static)
  (func coco_cw_index ((coco_reader * r) (size_t cell)) (out i64)
        (for ((size_t i . 0)) (< i (-> r nvars)) ((++ i))
          (if (== (nth i (-> r var_cells)) cell) (return (cast i64 i))))
        (return -1))

  ;;; each named variable's occurrences in T, added to LEFT: the reader's
  ;;; count where the count below could not keep its branch list
  (static)
  (func coco_cw_count ((coco_machine * m) (coco_reader * r) (size_t t) (int * left)) (out void)
        (set t (coco_deref m t))
        (let ((u64 c . #'(nth t (-> m heap))))
          (if (coco-tag-is REF c)
              (let ((i64 i . #'(coco_cw_index r t)))
                (if (>= i 0) (set (nth i left) (+ (nth i left) 1)))
                (return)))
          (if (coco-tag-is FUN c)
              (let ((u32 ar . #'(coco_arity m t)))
                (for ((u32 k . 0)) (< k ar) ((++ k))
                     (coco_cw_count m r (+ t k 1) left))))))

  ;;; a line of the block: a newline before every line but the first
  (static)
  (func coco_cw_line ((coco_strbuf * b) (const char * what) (const char * name)) (out void)
        (if (> (-> b len) 0) (coco_sb_putc b (cast char 10)))
        (coco_sb_put b what)
        (coco_sb_put b name))

  ;;; swipl's atom_is_named_var(): 1 a name its warnings name, -1 one
  ;;; marked singleton (`_X', `__x'), 0 `_' alone
  (static)
  (func coco_cw_kind ((const char * vn)) (out int)
        (if (!= (nth 0 vn) (cast char 95)) (return 1))
        (if (== (nth 1 vn) (cast char 95)) (return -1))
        (if (== (nth 1 vn) (cast char 0)) (return 0))
        (if (and (>= (nth 1 vn) (cast char 65)) (<= (nth 1 vn) (cast char 90))) (return -1))
        (return 1))

  ;;; THE COUNT'S STATE (swipl's VarDef): per named variable its count, its
  ;;; bits (1 a branch's singleton, 2 a \+'s, 4 met) and its place in
  ;;; swipl's order, a head argument's its position and every other ARITY
  ;;; and its rank (NEXT the rank to give), and TOTAL its occurrences, the
  ;;; reader's count; BI, BST and BSF the branch list (pl-comp.c's
  ;;; branch_vars), a variable's index, its count saved from a left branch
  ;;; and its bits, BN long; ON a branch list open; TESTS a test the
  ;;; compile knows the answer of met, without which it is not walked; OK
  ;;; no growth refused, without which nothing is said
  (struct coco_cwa
    (member int *         times)
    (member int *         total)
    (member char *        fl)
    (member i64 *         key)
    (member i64           next)
    (member i64           arity)
    (member int *         bi)
    (member int *         bst)
    (member char *        bsf)
    (member size_t        bn)
    (member size_t        bcap)
    (member int           on)
    (member int           tests)
    (member int           ok))

  ;;; a variable onto the branch list (pushBranchVar)
  (static)
  (func coco_cwa_push ((coco_cwa * a) (int i)) (out void)
        (if (>= (-> a bn) (-> a bcap))
            (let ((size_t nc . #'(? (== (-> a bcap) 0) 32 (* 2 (-> a bcap))))
                  (void * g . nil))
              (set g (realloc (cast (void *) (-> a bi)) (* nc (sizeof int))))
              (if (== g nil) (block (set (-> a ok) 0) (return)))
              (set (-> a bi) (cast (int *) g))
              (set g (realloc (cast (void *) (-> a bst)) (* nc (sizeof int))))
              (if (== g nil) (block (set (-> a ok) 0) (return)))
              (set (-> a bst) (cast (int *) g))
              (set g (realloc (cast (void *) (-> a bsf)) nc))
              (if (== g nil) (block (set (-> a ok) 0) (return)))
              (set (-> a bsf) (cast (char *) g))
              (set (-> a bcap) nc)))
        (set (nth (-> a bn) (-> a bi)) i)
        (set (nth (-> a bn) (-> a bst)) 0)
        (set (nth (-> a bn) (-> a bsf)) (cast char 0))
        (set (-> a bn) (+ (-> a bn) 1)))

  ;;; an occurrence of the named variable I (-1 an anonymous one), ARG its
  ;;; place where it stands as a head argument, else -1: its first makes it
  ;;; a variable of a branch open (one a left branch counted back to 0 is
  ;;; on that list already); any other clears a branch's singleton
  (static)
  (func coco_cwa_var ((coco_cwa * a) (i64 i) (i64 arg)) (out void)
        (if (< i 0) (return))
        (set (nth i (-> a total)) (+ (nth i (-> a total)) 1))
        (if (== (bitand (nth i (-> a fl)) 4) 0)
            (block
              (set (nth i (-> a fl)) (cast char 4))
              (set (nth i (-> a times)) 1)
              (if (>= arg 0)
                  (set (nth i (-> a key)) arg)
                (block (set (nth i (-> a key)) (+ (-> a arity) (-> a next)))
                       (set (-> a next) (+ (-> a next) 1))))
              (if (-> a on) (coco_cwa_push a (cast int i)))
              (return)))
        (set (nth i (-> a times)) (+ (nth i (-> a times)) 1))
        (set (nth i (-> a fl)) (cast char (bitand (nth i (-> a fl)) 6))))

  ;;; WHAT A GOAL IS TO THE TWO WALKS, by its name's first character before
  ;;; any strcmp, as a name is mostly letters: swipl's control functors
  ;;; (pl-funct.c's CONTROL_F) 1 `,'/2, 2 `;'/2, 3 `|'/2, 4 `->'/2, 5
  ;;; `*->'/2, 6 `\+'/1, 7 `:'/2, 8 `@'/2 and 9 `$'/1; 10 a grammar rule's
  ;;; `{}'/1; the tests the compile knows the answer of, 11 `=='/2, 12
  ;;; `\=='/2, 13 var/1, 14 nonvar/1 and 15 pl-comp.c's other type tests;
  ;;; 0 any other
  (static)
  (func coco_cw_goal_kind ((const char * nm) (u32 ar)) (out int)
        (let ((int c . #'(cast int (nth 0 nm))))
          (if (== ar 2)
              (block
                (if (== c 44) (return (? (== (nth 1 nm) (cast char 0)) 1 0)))
                (if (== c 59) (return (? (== (nth 1 nm) (cast char 0)) 2 0)))
                (if (== c 124) (return (? (== (nth 1 nm) (cast char 0)) 3 0)))
                (if (== c 45) (return (? (== 0 (strcmp nm "->")) 4 0)))
                (if (== c 42) (return (? (== 0 (strcmp nm "*->")) 5 0)))
                (if (== c 58) (return (? (== (nth 1 nm) (cast char 0)) 7 0)))
                (if (== c 64) (return (? (== (nth 1 nm) (cast char 0)) 8 0)))
                (if (== c 61) (return (? (== 0 (strcmp nm "==")) 11 0)))
                (if (== c 92) (return (? (== 0 (strcmp nm "\\==")) 12 0)))
                (return 0)))
          (if (!= ar 1) (return 0))
          (if (== c 92) (return (? (== 0 (strcmp nm "\\+")) 6 0)))
          (if (== c 36) (return (? (== (nth 1 nm) (cast char 0)) 9 0)))
          (if (== c 123) (return (? (== 0 (strcmp nm "{}")) 10 0)))
          (if (== c 118) (return (? (== 0 (strcmp nm "var")) 13 0)))
          (if (== c 110)
              (return (? (== 0 (strcmp nm "nonvar")) 14 (? (== 0 (strcmp nm "number")) 15 0))))
          (if (== c 105) (return (? (== 0 (strcmp nm "integer")) 15 0)))
          (if (== c 114) (return (? (== 0 (strcmp nm "rational")) 15 0)))
          (if (== c 102) (return (? (== 0 (strcmp nm "float")) 15 0)))
          (if (== c 97)
              (return (? (or (== 0 (strcmp nm "atom")) (== 0 (strcmp nm "atomic"))) 15 0)))
          (if (== c 115) (return (? (== 0 (strcmp nm "string")) 15 0)))
          (if (== c 99)
              (return (? (or (== 0 (strcmp nm "compound")) (== 0 (strcmp nm "callable"))) 15 0)))
          (return 0)))

  ;;; THE COUNT: CTL the body's control (0 a head, an argument), DCG a
  ;;; grammar rule's body as written. The last argument is walked in the
  ;;; loop, as swipl's right recursion, so a long conjunction is no depth.
  (static)
  (func coco_cwa_walk ((coco_machine * m) (coco_reader * r) (coco_cwa * a) (size_t t)
                       (int ctl) (int dcg)) (out void)
        (while (-> a ok)
          (set t (coco_deref m t))
          (let ((u64 c . #'(nth t (-> m heap))))
            (if (coco-tag-is REF c)
                (block (coco_cwa_var a (coco_cw_index r t) -1) (return)))
            (if (not (coco-tag-is FUN c)) (return))
            (let ((u32 ar . #'(coco_arity m t)) (int kd . 0))
              (if (== ar 0) (return))
              (if ctl (set kd (coco_cw_goal_kind (coco_atom_name m (coco_name_of m t)) ar)))
              ;; a disjunction: the right branch counts the left's variables
              ;; again from 0; one either branch names once is a branch's
              ;; singleton, and the count is the larger of the two
              (if (or (== kd 2) (and dcg (== kd 3)))
                  (let ((int was . #'(-> a on)) (size_t start . 0) (size_t mid . 0) (size_t end . 0))
                    (if (not was) (block (set (-> a on) 1) (set (-> a bn) 0)))
                    (set start (-> a bn))
                    (coco_cwa_walk m r a (coco_arg m t 0) 1 dcg)
                    (set mid (-> a bn))
                    (for ((size_t k . start)) (< k mid) ((++ k))
                         (let ((int i . #'(nth k (-> a bi))))
                           (set (nth k (-> a bst)) (nth i (-> a times)))
                           (set (nth k (-> a bsf)) (cast char (bitand (nth i (-> a fl)) 3)))
                           (set (nth i (-> a times)) 0)
                           (set (nth i (-> a fl)) (cast char (bitand (nth i (-> a fl)) 4)))))
                    (coco_cwa_walk m r a (coco_arg m t 1) 1 dcg)
                    (set end (-> a bn))
                    (for ((size_t k . start)) (< k end) ((++ k))
                         (let ((int i . #'(nth k (-> a bi))))
                           (if (or (== (nth k (-> a bst)) 1) (== (nth i (-> a times)) 1))
                               (set (nth i (-> a fl)) (cast char (bitor (nth i (-> a fl)) 1))))
                           (if (< (nth i (-> a times)) (nth k (-> a bst)))
                               (set (nth i (-> a times)) (nth k (-> a bst))))
                           (set (nth i (-> a fl)) (cast char (bitor (nth i (-> a fl)) (nth k (-> a bsf)))))
                           (set (nth k (-> a bst)) 0)
                           (set (nth k (-> a bsf)) (cast char 0))))
                    (if (not was) (block (set (-> a on) 0) (set (-> a bn) 0)))
                    (return)))
              ;; a \+: a variable new to it, named once there, is its
              ;; singleton; its variables leave the branch list
              (if (== kd 6)
                  (let ((int was . #'(-> a on)) (size_t start . 0))
                    (if (not was) (block (set (-> a on) 1) (set (-> a bn) 0)))
                    (set start (-> a bn))
                    (coco_cwa_walk m r a (coco_arg m t 0) 1 dcg)
                    (for ((size_t k . start)) (< k (-> a bn)) ((++ k))
                         (let ((int i . #'(nth k (-> a bi))))
                           (if (== (nth i (-> a times)) 1)
                               (set (nth i (-> a fl)) (cast char (bitor (nth i (-> a fl)) 2))))))
                    (if (not was)
                        (block (set (-> a on) 0) (set (-> a bn) 0))
                      (set (-> a bn) start))
                    (return)))
              (if (and dcg (== kd 10))
                  (block (set t (coco_arg m t 0)) (set dcg 0) continue))
              ;; a test the compile knows the answer of: the compile is
              ;; walked
              (if (and (not dcg) (>= kd 11)) (set (-> a tests) 1))
              ;; a control construct's arguments are control too; `$/1' and
              ;; `@/2' are a grammar rule's non-terminals, which its
              ;; translation calls
              (if (not (or (and (>= kd 1) (<= kd 7))
                           (and (not dcg) (or (== kd 8) (== kd 9)))))
                  (set ctl 0))
              (for ((u32 k . 0)) (< (+ k 1) ar) ((++ k))
                   (coco_cwa_walk m r a (coco_arg m t k) ctl dcg))
              (set t (coco_arg m t (- ar 1)))))))

  ;;; THE COUNT'S LINES, in swipl's order of its variables (the smallest
  ;;; place first), a line each at most
  (static)
  (func coco_cwa_say ((coco_reader * r) (coco_cwa * a) (coco_strbuf * b)) (out void)
        (let ((size_t n . #'(-> r nvars)) (i64 last . -1) (int any . 0))
          (for ((size_t i . 0)) (< i n) ((++ i))
               (let ((int kind . #'(coco_cw_kind (nth i (-> r var_names)))))
                 (if (or (and (> kind 0) (bitand (nth i (-> a fl)) 3))
                         (and (< kind 0) (> (nth i (-> a times)) 1)))
                     (set any 1))))
          (if (not any) (return))
          (while #t
            (let ((i64 best . -1) (size_t bix . 0))
              (for ((size_t i . 0)) (< i n) ((++ i))
                   (if (and (bitand (nth i (-> a fl)) 4)
                            (and (> (nth i (-> a key)) last)
                                 (or (< best 0) (< (nth i (-> a key)) best))))
                       (block (set best (nth i (-> a key))) (set bix i))))
              (if (< best 0) (return))
              (set last best)
              (let ((const char * vn . #'(nth bix (-> r var_names)))
                    (int kind . #'(coco_cw_kind (nth bix (-> r var_names)))))
                (if (and (> kind 0) (bitand (nth bix (-> a fl)) 3))
                    (coco_cw_line b (? (bitand (nth bix (-> a fl)) 1)
                                       "Singleton variable in branch: "
                                       "Singleton variable in \\+: ")
                                  vn)
                  (if (and (< kind 0) (> (nth bix (-> a times)) 1))
                      (coco_cw_line b "Singleton-marked variable appears more than once: " vn))))))))

  ;;; T is the callable NAME/AR (T dereferenced)
  (static)
  (func coco_cw_named ((coco_machine * m) (size_t t) (const char * name) (u32 ar)) (out int)
        (if (not (coco_is_callable m t)) (return 0))
        (if (!= (coco_arity m t) ar) (return 0))
        (return (? (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) name)) 1 0)))

  ;;; THE COMPILE'S PASS: ST a named variable's 1 where the compile stands
  ;;; once it is set. Every named variable of T set: T compiled as a call's
  ;;; arguments.
  (static)
  (func coco_cwc_mark ((coco_machine * m) (coco_reader * r) (char * st) (size_t t)) (out void)
        (while #t
          (set t (coco_deref m t))
          (let ((u64 c . #'(nth t (-> m heap))))
            (if (coco-tag-is REF c)
                (let ((i64 i . #'(coco_cw_index r t)))
                  (if (>= i 0) (set (nth i st) (cast char 1)))
                  (return)))
            (if (not (coco-tag-is FUN c)) (return))
            (let ((u32 ar . #'(coco_arity m t)))
              (if (== ar 0) (return))
              (for ((u32 k . 0)) (< (+ k 1) ar) ((++ k))
                   (coco_cwc_mark m r st (coco_arg m t k)))
              (set t (coco_arg m t (- ar 1)))))))

  ;;; T names a variable of the reader's
  (static)
  (func coco_cwc_names ((coco_machine * m) (coco_reader * r) (size_t t)) (out int)
        (while #t
          (set t (coco_deref m t))
          (let ((u64 c . #'(nth t (-> m heap))))
            (if (coco-tag-is REF c) (return (>= (coco_cw_index r t) 0)))
            (if (not (coco-tag-is FUN c)) (return 0))
            (let ((u32 ar . #'(coco_arity m t)))
              (if (== ar 0) (return 0))
              (for ((u32 k . 0)) (< (+ k 1) ar) ((++ k))
                   (if (coco_cwc_names m r (coco_arg m t k)) (return 1)))
              (set t (coco_arg m t (- ar 1)))))))

  ;;; `Test is always true: T' (TRUTH 1) or `... false: T', T written as
  ;;; swipl's messages.pl writes it, quoted and in the reader's names; not
  ;;; said where T names no variable, as swipl's drops it
  (static)
  (func coco_cwc_say ((coco_machine * m) (coco_reader * r) (coco_strbuf * b)
                      (int truth) (size_t t)) (out void)
        (if (not (coco_cwc_names m r t)) (return))
        (let ((size_t n . #'(-> r nvars))
              (u64 * ids . #'(cast (u64 *) (malloc (* (+ n 1) (sizeof u64)))))
              (size_t * ocells . #'(-> m wcells)) (u64 * onames . #'(-> m wnames))
              (size_t onn . #'(-> m nwnames)))
          (if (== ids nil) (return))
          (for ((size_t i . 0)) (< i n) ((++ i))
               (set (nth i ids) (coco_intern m (nth i (-> r var_names)))))
          (coco_cw_line b (? truth "Test is always true: " "Test is always false: ") "")
          (set (-> m wcells) (-> r var_cells))
          (set (-> m wnames) ids)
          (set (-> m nwnames) n)
          (coco_write_mode m b t 17 0)
          (set (-> m wcells) ocells)
          (set (-> m wnames) onames)
          (set (-> m nwnames) onn)
          (free ids)))

  ;;; void: anonymous, or named once by swipl's count
  (static)
  (func coco_cwc_void ((coco_cwa * a) (i64 i)) (out int)
        (return (or (< i 0) (== (nth i (-> a times)) 1))))

  ;;; ==/2 (EQ 1) or \==/2 (pl-comp.c's compileBodyEQ and compileBodyNEQ)
  (static)
  (func coco_cwc_eq ((coco_machine * m) (coco_reader * r) (coco_cwa * a) (char * st)
                     (size_t t) (int eq) (coco_strbuf * b)) (out void)
        (let ((size_t x . #'(coco_deref m (coco_arg m t 0)))
              (size_t y . #'(coco_deref m (coco_arg m t 1)))
              (int vx . 0) (int vy . 0) (i64 ix . -1) (i64 iy . -1))
          (set vx (coco-tag-is REF (nth x (-> m heap))))
          (set vy (coco-tag-is REF (nth y (-> m heap))))
          (if vx (set ix (coco_cw_index r x)))
          (if vy (set iy (coco_cw_index r y)))
          ;; a void operand: never ==, and the test is then a call, which
          ;; sets what it names
          (if (or (and vx (coco_cwc_void a ix)) (and vy (coco_cwc_void a iy)))
              (block (coco_cwc_say m r b (not eq) t)
                     (coco_cwc_mark m r st t)
                     (return)))
          ;; two variables, one of them unset: never == unless the same, and
          ;; compiled in place, setting neither
          (if (and vx vy)
              (block
                (if (or (== (nth ix st) 0) (== (nth iy st) 0))
                    (coco_cwc_say m r b (== eq (== x y)) t))
                (return)))
          ;; a variable and a portable constant: in place too
          (if (or (and vx (coco_fv_const m y)) (and vy (coco_fv_const m x))) (return))
          (coco_cwc_mark m r st t)))

  ;;; a type test KD (13 var, 14 nonvar, 15 another) of T's argument
  ;;; (compileBodyVar1, compileBodyNonVar1, compileTypeTest): of a void
  ;;; variable, or of one unset, always var and never anything else; of a
  ;;; bound term, its answer, which only a compound can name a variable for
  ;;; -- nonvar, compound and callable; then a call
  (static)
  (func coco_cwc_type ((coco_machine * m) (coco_reader * r) (coco_cwa * a) (char * st)
                       (size_t t) (int kd) (coco_strbuf * b)) (out void)
        (let ((size_t x . #'(coco_deref m (coco_arg m t 0))))
          (if (coco-tag-is REF (nth x (-> m heap)))
              (let ((i64 i . #'(coco_cw_index r x)))
                (if (coco_cwc_void a i)
                    (block (coco_cwc_say m r b (== kd 13) t) (return)))
                (if (== (nth i st) 0)
                    (block (coco_cwc_say m r b (== kd 13) t)
                           (set (nth i st) (cast char 1))))
                (return)))
          (if (coco-tag-is FUN (nth x (-> m heap)))
              (let ((const char * nm . #'(coco_atom_name m (coco_name_of m t))))
                (coco_cwc_say m r b (or (== kd 14) (or (== 0 (strcmp nm "compound"))
                                                     (== 0 (strcmp nm "callable"))))
                              t)))
          (coco_cwc_mark m r st x)))

  ;;; THE COMPILE, a goal of the body as the compiler meets it; DCG 1 in a
  ;;; grammar rule's body, where a list is a terminal and `{}' holds goals.
  ;;; A conjunction's last goal and a construct's goal are walked in the loop.
  (static)
  (func coco_cwc_walk ((coco_machine * m) (coco_reader * r) (coco_cwa * a) (char * st)
                       (size_t t) (int dcg) (coco_strbuf * b)) (out void)
        (while #t
          (set t (coco_deref m t))
          (if (not (coco_is_callable m t))
              (block (coco_cwc_mark m r st t) (return)))
          (let ((u32 ar . #'(coco_arity m t)) (int kd . 0) (size_t n . #'(-> r nvars)))
            (if (== ar 0) (return))
            (set kd (coco_cw_goal_kind (coco_atom_name m (coco_name_of m t)) ar))
            (if (== kd 1)
                (block (coco_cwc_walk m r a st (coco_arg m t 0) dcg b)
                       (set t (coco_arg m t 1)) continue))
            ;; each branch from what was set before the disjunction, and
            ;; after it what either set; an if-then-else's condition and
            ;; then are its first branch, walked in turn by the `->' rule
            (if (or (== kd 2) (== kd 3))
                (let ((char * s0 . #'(cast (char *) (malloc (+ n 1)))))
                  (if (== s0 nil) (block (coco_cwc_mark m r st t) (return)))
                  (memcpy s0 st n)
                  (coco_cwc_walk m r a st (coco_arg m t 0) dcg b)
                  (for ((size_t i . 0)) (< i n) ((++ i))
                       (let ((char l . #'(nth i st)))
                         (set (nth i st) (nth i s0))
                         (set (nth i s0) l)))
                  (coco_cwc_walk m r a st (coco_arg m t 1) dcg b)
                  (for ((size_t i . 0)) (< i n) ((++ i))
                       (set (nth i st) (cast char (bitor (nth i st) (nth i s0)))))
                  (free s0)
                  (return)))
            (if (or (== kd 4) (== kd 5))
                (block (coco_cwc_walk m r a st (coco_arg m t 0) dcg b)
                       (set t (coco_arg m t 1)) continue))
            (if (== kd 6)
                (block (set t (coco_arg m t 0)) continue))
            (if (== kd 7)
                (block (coco_cwc_mark m r st (coco_arg m t 0))
                       (set t (coco_arg m t 1)) continue))
            ;; `$(G)' and `@(G, M)' compile G in place, but in a grammar
            ;; rule, where they are non-terminals
            (if (and (not dcg) (== kd 9))
                (block (set t (coco_arg m t 0)) continue))
            (if (and (not dcg) (== kd 8))
                (block (coco_cwc_mark m r st (coco_arg m t 1))
                       (set t (coco_arg m t 0)) continue))
            (if (and dcg (== kd 10))
                (block (set t (coco_arg m t 0)) (set dcg 0) continue))
            (if (and (not dcg) (or (== kd 11) (== kd 12)))
                (block (coco_cwc_eq m r a st t (== kd 11) b) (return)))
            (if (and (not dcg) (>= kd 13))
                (block (coco_cwc_type m r a st t kd b) (return)))
            (coco_cwc_mark m r st t)
            (return))))

  ;;; a qualifier's module counted and passed: T's term under its `M:'s
  (static)
  (func coco_cw_unqualify ((coco_machine * m) (coco_reader * r) (coco_cwa * a) (size_t t)) (out size_t)
        (set t (coco_deref m t))
        (while (coco_cw_named m t ":" 2)
          (coco_cwa_walk m r a (coco_arg m t 0) 0 0)
          (set t (coco_deref m (coco_arg m t 1))))
        (return t))

  ;;; BOTH BLOCKS OF A TERM READ, from one count of it (3.19.5; 3.19.1's
  ;;; reader count and its compiler's walk were two): the reader's, said
  ;;; here from every named variable's occurrences, and, for a clause, the
  ;;; compiler's, handed back in CW (nil for none) to be said once the
  ;;; clause is stored, after its not-together warning, as swipl's. A
  ;;; directive has the reader's block alone; a clause's compile is walked
  ;;; only where its count met a test whose answer the compile knows.
  (static)
  (func coco_consult_singletons ((coco_machine * m) (coco_reader * r) (size_t t)
                                 (const char * origin) (int at) (char ** cw)) (out void)
        (let ((coco_strbuf b) (int any . 0) (size_t n . #'(-> r nvars)) (coco_cwa a)
              (void * blk . nil) (char * st . nil) (size_t t0 . t)
              (size_t h . 0) (size_t g . 0) (size_t body . 0) (size_t pb . 0)
              (int dcg . 0) (int hasb . 0) (int hasg . 0) (int haspb . 0) (int dir . 0))
          (set (nth 0 cw) nil)
          (if (== n 0) (return))
          ;; one block for the five arrays: places, counts, totals, bits and
          ;; the compile's set
          (set blk (calloc (+ n 1) (+ (sizeof i64) (+ (* 2 (sizeof int)) 2))))
          (if (== blk nil) (return))
          (memset (aof a) 0 (sizeof coco_cwa))
          (set ($ a key) (cast (i64 *) blk))
          (set ($ a times) (cast (int *) (+ (cast (char *) blk) (* (+ n 1) (sizeof i64)))))
          (set ($ a total) (+ ($ a times) (+ n 1)))
          (set ($ a fl) (cast (char *) (+ ($ a total) (+ n 1))))
          (set st (+ ($ a fl) (+ n 1)))
          (set ($ a ok) 1)
          (set t (coco_deref m t))
          (if (or (coco_cw_named m t ":-" 1) (coco_cw_named m t "?-" 1))
              (block (set dir 1) (coco_cwa_walk m r (aof a) (coco_arg m t 0) 0 0))
            (let ((size_t u . #'(coco_cw_unqualify m r (aof a) t)))
              ;; a clause's qualifiers are no part of it; swipl translates
              ;; neither a qualified rule nor a qualified grammar rule
              (cond
                ((coco_cw_named m u ":-" 2)
                 (set h (coco_arg m u 0)) (set body (coco_arg m u 1)) (set hasb 1))
                ((and (== u t) (coco_cw_named m t "=>" 2))
                 (let ((size_t h0 . #'(coco_deref m (coco_arg m t 0))))
                   (if (coco_cw_named m h0 "," 2)
                       (block (set h (coco_arg m h0 0)) (set g (coco_arg m h0 1)) (set hasg 1))
                     (set h h0)))
                 (set body (coco_arg m t 1)) (set hasb 1))
                ((and (== u t) (coco_cw_named m t "-->" 2))
                 (let ((size_t h0 . #'(coco_deref m (coco_arg m t 0))))
                   ;; a pushback is its translation's last unification
                   (if (coco_cw_named m h0 "," 2)
                       (block (set h (coco_arg m h0 0)) (set pb (coco_arg m h0 1)) (set haspb 1))
                     (set h h0)))
                 (set body (coco_arg m t 1)) (set hasb 1) (set dcg 1))
                (#t (set h u)))
              ;; the head's qualifier is no argument of it
              (set h (coco_cw_unqualify m r (aof a) h))
              (let ((u32 ar . 0))
                (if (coco_is_callable m h) (set ar (coco_arity m h)))
                ;; a grammar rule's translation takes two arguments more
                (set ($ a arity) (+ (cast i64 ar) (? dcg 2 0)))
                (if (coco_is_callable m h)
                    (for ((u32 k . 0)) (< k ar) ((++ k))
                         (let ((size_t x . #'(coco_deref m (coco_arg m h k))))
                           (if (coco-tag-is REF (nth x (-> m heap)))
                               (coco_cwa_var (aof a) (coco_cw_index r x) (cast i64 k))
                             (coco_cwa_walk m r (aof a) x 0 0))))
                  (coco_cwa_walk m r (aof a) h 0 0)))
              (if hasg (coco_cwa_walk m r (aof a) g 1 0))
              (if hasb (coco_cwa_walk m r (aof a) body 1 dcg))
              (if haspb (coco_cwa_walk m r (aof a) pb 0 0))))
          ;; a branch list refused its growth: the reader's count again, by
          ;; a walk of its own, and no compiler's block
          (if (not ($ a ok))
              (block (memset (cast (void *) ($ a total)) 0 (* (+ n 1) (sizeof int)))
                     (coco_cw_count m r t0 ($ a total))))
          (coco_sb_init (aof b))
          (coco_sb_put (aof b) "Singleton variables: [")
          (for ((size_t i . 0)) (< i n) ((++ i))
               (let ((const char * nm . #'(nth i (-> r var_names))))
                 (if (and (> (coco_cw_kind nm) 0) (== 1 (nth i ($ a total))))
                     (block
                       (if any (coco_sb_putc (aof b) (cast char 44)))
                       (coco_sb_put (aof b) nm)
                       (set any 1)))))
          (if any
              (block
                (coco_sb_put (aof b) "]")
                (coco_load_message "Warning" origin at ($ b s))))
          (coco_sb_reset (aof b))
          (if (and (not dir) ($ a ok))
              (block
                (coco_cwa_say r (aof a) (aof b))
                (if ($ a tests)
                    (block
                      (coco_cwc_mark m r st h)
                      (if hasg (coco_cwc_walk m r (aof a) st g 0 (aof b)))
                      (if hasb (coco_cwc_walk m r (aof a) st body dcg (aof b)))))))
          (if (> ($ b len) 0)
              (set (nth 0 cw) ($ b s))
            (coco_sb_free (aof b)))
          (free ($ a bi))
          (free ($ a bst))
          (free ($ a bsf))
          (free blk)))

  ;;; the compiler's block a term left unsaid, at any exit of the load
  (func coco_cw_cleanup ((char ** p)) (out void)
        (free (nth 0 p)))

  ;;; A FILE AN INCLUDE READS (3.5.0) is read by this same function, inside
  ;;; the one that included it: UP is that load's goals put off to its end,
  ;;; which the included file's join, INCS the files open on the way down
  ;;; to it and NINC how many -- nil, nil and 0 for a load of its own, which
  ;;; keeps its goals itself and runs them when it is read.
  (static)
  (func coco_consult_owned ((coco_store * st) (coco_machine * m) (const char * text)
                            (const char * origin) (u64 oid) (coco_origin_seen * seen)
                            (char * err) (size_t errlen)
                            (coco_initgoals * up) (const char ** incs) (int ninc)) (out int)
        (let ((coco_reader r) (size_t t) (int rc . 1) (int n . 0) (size_t mark)
              ;; the compiler's warnings of the term in hand, said once its
              ;; clause is stored (`coco_consult_singletons'), freed at any exit
              (defer () coco_cw_cleanup) (char * cwarn . nil)
              ;; `:- if/elif/else/endif' -- conditional reading, sixteen deep.
              ;; A frame remembers whether its current branch is being TAKEN
              ;; and whether any branch of the if has ALREADY run (so a later
              ;; `elif'/`else' in the same if stays off). Everything read
              ;; while any frame is not taking is dropped, directives too --
              ;; except these four, which keep the nesting straight.
              (int csp . 0) (int ctaking [16]) (int ctaken [16]) (int active . 1)
              ;; and the line each frame's `:- if' stands on, which an if
              ;; left open at the end names (3.1.0)
              (int cline [16])
              ;; the control names a body is walked by, `:-', `:' and `=>',
              ;; interned once (`coco_consult_refused'), ==/2's and
              ;; \==/2's (`coco_fresh_fault', 3.19.3), and `$' and `@'
              ;; (3.20.0)
              (u64 cids [13])
              ;; WHERE THE CLAUSE IN HAND BEGINS, counted forward and never
              ;; back: `scanned' is how far the newline count has read and
              ;; `line' the answer at that point, so the whole file is walked
              ;; once however many clauses it holds. The reader keeps one
              ;; token in hand, so this is the line the clause STARTS on --
              ;; which is the line SWI names too.
              (size_t scanned . 0) (int line . 1) (int at . 1)
              (coco_initgoals inits)
              ;; the goals put off: this load's own, or the one that
              ;; included this file's (3.5.0)
              (coco_initgoals * ip . up)
              ;; and the files an include is read inside, this load's first
              (const char * own [65])
              ;; MAY A GOAL RUN FROM HERE COLLECT THE HEAP (1.9.6)? Only if
              ;; whoever called the consult said so (`dgc', lib/term.cicili),
              ;; and only around a call whose cells this frame has registered:
              ;; the clause in hand and the mark the heap is wound back to.
              ;; Taken here, so the reader and the store never run under it.
              (int vouch . #'(-> m dgc))
              ;; THE PROGRAM'S EXPANSION HOOKS (3.14.0): which of the two
              ;; there are (`coco_xhook_load'), asked again after anything
              ;; that may define one, and the names they are asked by
              (int xbits . 0) (u64 te_id . 0) (u64 ge_id . 0) (u64 eof_id . 0) (int ateof . 0)
              (int atbof . 0))
          (set (-> m dgc) 0)
          ;; a backtrace no report took (a window's, whose ball it handed
          ;; back) is not this load's: only a goal run from here writes one
          ;; to report
          (coco_bt_say m 0)
          (if (== incs nil)
              (block (set (nth 0 own) origin) (set incs own) (set ninc 1)))
          (if (== up nil)
              (block
               (memset (aof inits) 0 (sizeof coco_initgoals))
               (set ip (aof inits))
               ;; the outermost read's list takes a nested read's main
               (if (== (-> m lreads) 1) (set (-> m ltop) (cast (void *) (aof inits))))
               ;; the goals put off to the end are cell indices; a compaction
               ;; before they run must move them too. `coco_consult'
               ;; unregisters.
               (coco_store_root_push st (aof ($ inits cells)) (aof ($ inits len)))))
          (set (nth 0 cids) (coco_intern m ","))
          (set (nth 1 cids) (coco_intern m ";"))
          (set (nth 2 cids) (coco_intern m "->"))
          (set (nth 3 cids) (coco_intern m "*->"))
          (set (nth 4 cids) (coco_intern m "\\+"))
          (set (nth 5 cids) (coco_intern m ":-"))
          (set (nth 6 cids) (coco_intern m "|"))
          (set (nth 7 cids) (coco_intern m ":"))
          (set (nth 8 cids) (coco_intern m "=>"))
          (set (nth 9 cids) (coco_intern m "=="))
          (set (nth 10 cids) (coco_intern m "\\=="))
          (set (nth 11 cids) (coco_intern m "$"))
          (set (nth 12 cids) (coco_intern m "@"))
          (set te_id (coco_intern m "term_expansion"))
          (set ge_id (coco_intern m "goal_expansion"))
          (set eof_id (coco_intern m "end_of_file"))
          (set xbits (coco_xhook_load st m))
          ;; asked before the first read or never: a hook the file defines
          ;; is no hook at its start
          (set atbof (? (and (== up nil) (bitand xbits 1)) 0 1))
          (coco_reader_init (aof r) m text)
          (while (== rc 1)
            ;; each clause is read on to the heap, copied into the store, and
            ;; the heap wound back -- so consulting a large file does not leave
            ;; a copy of it in the machine as well as in the store
            (set mark (-> m heap_len))
            (while (< scanned ($ r pos))
              (if (== (nth scanned text) (cast char 10)) (set line (+ line 1)))
              (set scanned (+ scanned 1)))
            (set at line)
            ;; AND ITS START IS ONE (3.14.0), `begin_of_file', as swipl's:
            ;; a loaded file's, not an included one's, and dropped when no
            ;; expansion answers it (rc 3)
            (if (not atbof)
                (block (set atbof 1)
                       (set t (coco_new_atom m "begin_of_file"))
                       (set rc 3))
              (set rc (coco_read_clause (aof r) (aof t))))
            ;; A SYNTAX ERROR SKIPS ITS CLAUSE AND THE LOAD GOES ON (3.1.0),
            ;; as swipl's: reported where it stands, and the reader taken up
            ;; after the full stop that ends the clause it was in, as swipl's
            ;; raw read of a clause's text finds it (`coco_reader_resync').
            ;; Through 3.0.4 the consult ended there and the rest of the file
            ;; was not read: one typo near the top and nothing under it loaded.
            (if (== rc -1)
                (block
                  (coco_consult_syntax_say m (aof r) origin)
                  (set (-> m heap_len) mark)
                  (coco_reader_resync (aof r))
                  (set rc 1)
                  continue))
            ;; THE FILE'S END IS A TERM term_expansion/2 IS ASKED OF
            ;; (3.14.0), once, as swipl's: what it gives is read as the
            ;; file's last terms -- the loaded file's, never an included
            ;; one's, whose end is no term to swipl
            (if (and (== rc 0) (and (== up nil) (and (not ateof) (bitand xbits 1))))
                (block (set ateof 1)
                       (set t (coco_new_atom m "end_of_file"))
                       (set rc 2)))
            (if (or (== rc 1) (or (== rc 2) (== rc 3)))
                (block
                 (set active 1)
                 (let ((int ci . 0))
                   (while (< ci csp)
                     (if (== (nth ci ctaking) 0) (set active 0))
                     (set ci (+ ci 1))))
                 ;; SWI WARNS OF A SINGLETON VARIABLE AT THE LOAD, before
                 ;; expansion, and the reader still holds the names here.
                 (if (!= cwarn nil) (block (free cwarn) (set cwarn nil)))
                 (if (and active (== rc 1)
                          (or (not (coco_store_is_muted st)) (-> st ownload)))
                     (coco_consult_singletons m (aof r) t origin at (aof cwarn)))
                 ;; A TERM IS ASKED OF THE PROGRAM'S term_expansion/2 FIRST
                 ;; (3.14.0), as swipl's load asks it: every term read where
                 ;; the file is taken -- a directive too, the conditional
                 ;; ones aside, and before a grammar rule is translated --
                 ;; and the end of the file. What it gives is read in its
                 ;; place: a proper list as its terms, `[]' none, and an
                 ;; error(_, _) it raises reported at the term, which is
                 ;; dropped. Its terms are on the heap above the mark the
                 ;; clause winds back to, so the mark moves over them and no
                 ;; goal run for one may collect (`vouch').
                 (let ((size_t xs . 0) (int xr . 0) (int xlist . 0) (int xgo . 1) (int xstop . 0)
                       (size_t omark . mark) (size_t xmark . #'(cast size_t -1)) (int ovouch . vouch)
                       ;; where the term in hand begins, or the text's end
                       (size_t toff . #'(? (== rc 2) ($ r len) (? (== rc 3) 0 ($ r cstart)))))
                   (if (and active (and (bitand xbits 1) (not (coco_consult_cond_dir m t))))
                       (block
                        (set xr (coco_consult_xcall st m "term_expansion" 0 t (aof xs) origin at (nth 0 incs) text toff err errlen))
                        (cond
                          ((== xr 1)
                           (set mark (-> m heap_len))
                           (set xmark mark)
                           (set vouch 0)
                           (set xlist (coco_consult_xlist m xs)))
                          ((== xr -2)
                           (coco_consult_init_failed err errlen)
                           (set (-> m heap_len) omark)
                           (if (== up nil) (coco_inits_free ip))
                           (coco_reader_free (aof r))
                           (return -1))
                          ((== xr -1)
                           (coco_load_message "ERROR" origin at err)
                           (set (nth 0 err) (cast char 0))
                           (set xgo 0)))))
                   ;; the file's end or start that no expansion answered is
                   ;; no term
                   (if (and (>= rc 2) (!= xr 1)) (set xgo 0))
                   (while xgo
                     (if xlist
                         (block
                          (set xs (coco_deref m xs))
                          (if (not (coco_is_cons m xs)) break)
                          (set t (coco_deref m (coco_arg m xs 0)))
                          (set xs (coco_arg m xs 1)))
                       (block
                        (if (== xr 1) (set t xs))
                        (set xgo 0)))
                     ;; `end_of_file' ENDS THE FILE WHERE IT STANDS (3.14.0),
                     ;; as swipl's: written in it, or given by an expansion,
                     ;; whose terms after it are dropped
                     (if (coco_consult_eof m t eof_id) (block (set xstop 1) break))
                 ;; `:- G' IS A DIRECTIVE AND NOT A CLAUSE. It used to go
                 ;; straight into coco_assert, which took it for a clause whose
                 ;; head was `:-' of arity one and filed it under a predicate of
                 ;; that name -- so `:- dynamic counter/1.' quietly became a
                 ;; fact nothing would ever call, and the file looked consulted.
                 (if (coco_is_compound1 m t ":-")
                     (let ((size_t d . #'(coco_deref m (coco_arg m t 0)))
                           (const char * dn . "") (u32 da . 0) (int handled . 0))
                       (if (coco_is_callable m d)
                           (block (set dn (coco_atom_name m (coco_name_of m d)))
                                  (set da (coco_arity m d))))
                       (if (and (== da 1) (== 0 (strcmp dn "if")))
                           (block
                            (set handled 1)
                            (if (>= csp 16)
                                (block (snprintf err errlen "if: nested too deep")
                                       (coco_consult_where err errlen origin at)
                                       (coco_reader_free (aof r)) (return -1)))
                            (let ((int truth . 0))
                              ;; inside a skipped region the condition is not
                              ;; even evaluated -- the frame only keeps count
                              (if active
                                  (if (not (coco_cond_eval st m (coco_arg m d 0)
                                                           (aof truth) err errlen))
                                      (block (coco_consult_where err errlen origin at)
                                             (coco_reader_free (aof r)) (return -1))))
                              (set (nth csp ctaking) (? (and active truth) 1 0))
                              (set (nth csp ctaken) (? (and active truth) 1 0))
                              (set (nth csp cline) at)
                              (set csp (+ csp 1)))))
                       ;; AN elif, else OR endif WITH NO if OPEN IS REPORTED,
                       ;; AND THE LOAD GOES ON (3.1.0), swipl's two lines;
                       ;; through 3.0.4 the consult ended there
                       (if (and (== da 1) (== 0 (strcmp dn "elif")))
                           (block
                            (set handled 1)
                            (if (== csp 0)
                                (coco_load_message "ERROR" origin at ":- elif without :- if")
                            (let ((int truth . 0) (int outer . 1) (int ci . 0))
                              (while (< ci (- csp 1))
                                (if (== (nth ci ctaking) 0) (set outer 0))
                                (set ci (+ ci 1)))
                              (if (and outer (== (nth (- csp 1) ctaken) 0))
                                  (block
                                   (if (not (coco_cond_eval st m (coco_arg m d 0)
                                                            (aof truth) err errlen))
                                       (block (coco_consult_where err errlen origin at)
                                              (coco_reader_free (aof r)) (return -1)))
                                   (set (nth (- csp 1) ctaking) truth)
                                   (if truth (set (nth (- csp 1) ctaken) 1)))
                                (set (nth (- csp 1) ctaking) 0))))))
                       (if (and (== da 0) (== 0 (strcmp dn "else")))
                           (block
                            (set handled 1)
                            (if (== csp 0)
                                (coco_load_message "ERROR" origin at ":- else without :- if")
                            (let ((int outer . 1) (int ci . 0))
                              (while (< ci (- csp 1))
                                (if (== (nth ci ctaking) 0) (set outer 0))
                                (set ci (+ ci 1)))
                              (if (and outer (== (nth (- csp 1) ctaken) 0))
                                  (block (set (nth (- csp 1) ctaking) 1)
                                         (set (nth (- csp 1) ctaken) 1))
                                (set (nth (- csp 1) ctaking) 0))))))
                       (if (and (== da 0) (== 0 (strcmp dn "endif")))
                           (block
                            (set handled 1)
                            (if (== csp 0)
                                (coco_load_message "ERROR" origin at ":- endif without :- if")
                              (set csp (- csp 1)))))
                       ;; `:- include(File).' READS FILE WHERE IT STANDS
                       ;; (3.5.0), as swipl's: found as a load finds a file,
                       ;; beside this one first (`coco_include_hook'), and
                       ;; read by this load -- its clauses this file's own,
                       ;; owned as its are (OID, SEEN), so a reconsult takes
                       ;; them with it; its goals put off to this load's end,
                       ;; each named by the file it stood in; its reports and
                       ;; source_location/2 naming that file and its lines.
                       ;; A spec that names nothing it can read ENDS THE LOAD,
                       ;; swipl's ball raised out of it (`lball'), and so does
                       ;; an include of a file already open on the way down
                       ;; to it, or sixty-four deep, which swipl reads again
                       ;; for ever. Through 3.4.0 it was a goal, and an
                       ;; unknown procedure.
                       (if (and active (and (== da 1) (and (== 0 (strcmp dn "include"))
                                                           (!= coco_include_hook nil))))
                           (let ((char ipath [4096]) (char * itext . nil) (int ir . 0) (int k . 0)
                                 (const char * sfile . #'(-> m sloc_file))
                                 (int sline . #'(-> m sloc_line)))
                             (set handled 1)
                             ;; looked for where this file is
                             (set (-> m sloc_file) origin)
                             (set (-> m sloc_line) at)
                             (set ir (coco_include_hook st m (coco_arg m d 0) ipath (sizeof ipath)
                                                        (aof itext) err errlen))
                             (set (-> m sloc_file) sfile)
                             (set (-> m sloc_line) sline)
                             (if (and (== ir 1) (coco_include_open incs ninc ipath))
                                 (block (free (cast (void *) itext))
                                        (set itext nil)
                                        (coco_include_refused st m (coco_arg m d 0) err errlen)
                                        (set ir 0)))
                             ;; an include of a file that is there defines,
                             ;; though the file holds nothing (3.6.0,
                             ;; `ldefs'), as swipl's
                             (if (== ir 1) (set (-> m ldefs) (+ (-> m ldefs) 1)))
                             (if (== ir 1)
                                 (let ((const char * was . #'(-> ip file)) (size_t * mp . nil)
                                       (size_t ml . 1) (int pushed . 0))
                                   (set (nth ninc incs) ipath)
                                   (set (-> ip file) ipath)
                                   ;; its goals may collect, as a directive's
                                   ;; may: the mark this frame winds back to
                                   ;; registered as a position
                                   (set mp (aof mark))
                                   (set pushed (coco_heap_pos_push m (aof mp) (aof ml)))
                                   (set (-> m dgc) (? pushed vouch 0))
                                   (set k (coco_consult_owned st m itext ipath oid seen err errlen
                                                              ip incs (+ ninc 1)))
                                   (set (-> m dgc) 0)
                                   (if pushed (coco_heap_root_pop m))
                                   (set (-> ip file) was)
                                   (free (cast (void *) itext))
                                   (if (>= k 0) (set n (+ n k)))))
                             ;; THE LOAD ENDS HERE when the include read
                             ;; nothing, or what it read ended: what was read
                             ;; stands, and a script's load says ERR, swipl's
                             ;; `Prolog initialisation failed'
                             (if (or (== ir 0) (< k 0))
                                 (block
                                  (if (== ir 0)
                                      (let ((char * msg . #'(strdup err)))
                                        (if (!= msg nil)
                                            (block (snprintf err errlen
                                                             "Prolog initialisation failed:\nERROR: %s"
                                                             msg)
                                                   (free msg)))))
                                  (set (-> m heap_len) mark)
                                  (if (== up nil) (coco_inits_free ip))
                                  (coco_reader_free (aof r))
                                  (return -1)))))
                       ;; REPORTED, AND THE LOAD GOES ON. A directive is a
                       ;; goal now, and a goal that fails or throws is news
                       ;; about that goal -- not a reason to throw away the
                       ;; clauses under it, which is what returning -1 here
                       ;; used to do: one `:- initialization(main).' at the
                       ;; top of a file and NOTHING in it was loaded.
                       ;;
                       ;; THE MARK IS REGISTERED around it (1.9.6), as a
                       ;; position: a goal that collects slides the cells
                       ;; below it down, and the wind-back below must land
                       ;; where they now end, not above it. The clause is not:
                       ;; coco_directive registers the goal it names in a
                       ;; failure's message, and the one read of the clause
                       ;; here -- the message for a `use_module' that loaded
                       ;; nothing -- follows a directive that runs no goal.
                       ;; Unregistered, the goal runs as it did, collecting
                       ;; nothing.
                       ;;
                       ;; ITS GOAL IS ASKED OF THE PROGRAM'S goal_expansion/2
                       ;; FIRST (3.14.0), as swipl's '$execute_directive'
                       ;; expands it (`'$expand_clause'/3' in lib/dcg.cicili):
                       ;; what that gives runs, and an error(_, _) it raises
                       ;; is reported at the directive, which does not run
                       (if (and (== handled 0) (and active (bitand xbits 2)))
                           (let ((size_t gx . 0) (int gr . 0))
                             (set gr (coco_consult_xcall st m "$expand_clause" (coco_new_int m 1) t (aof gx)
                                                         origin at (nth 0 incs) text toff err errlen))
                             (cond
                               ((== gr 1) (set t gx))
                               ((== gr -2)
                                (coco_consult_init_failed err errlen)
                                (set (-> m heap_len) omark)
                                (if (== up nil) (coco_inits_free ip))
                                (coco_reader_free (aof r))
                                (return -1))
                               ((== gr -1)
                                (coco_load_message "ERROR" origin at err)
                                (set (nth 0 err) (cast char 0))
                                (set handled 1)))))
                       (if (and (== handled 0) active)
                           (let ((size_t * mp . nil) (size_t ml . 1) (int pushed . 0) (int dr . 0)
                                 (size_t * tp . nil) (size_t tl . 1) (int theld . 0)
                                 (const char * sfile . #'(-> m sloc_file))
                                 (int sline . #'(-> m sloc_line))
                                 (const char * ssrc . #'(-> m sloc_src))
                                 (const char * stext . #'(-> m sloc_text))
                                 (size_t soff . #'(-> m sloc_off)))
                             (set mp (aof mark))
                             (set pushed (coco_heap_pos_push m (aof mp) (aof ml)))
                             ;; and the clause, which the Warning after a goal
                             ;; that raised names (3.1.0): the goal may collect
                             (set tp (aof t))
                             (set theld (and pushed (coco_heap_root_push m (aof tp) (aof tl))))
                             (set (-> m dgc) (? (and pushed theld) vouch 0))
                             ;; source_location/2 answers the directive's file
                             ;; and line while its goal runs (2.16.0)
                             (set (-> m sloc_file) origin)
                             (set (-> m sloc_line) at)
                             ;; and prolog_load_context/2 the rest (3.14.0)
                             (set (-> m sloc_src) (nth 0 incs))
                             (set (-> m sloc_text) text)
                             (set (-> m sloc_off) toff)
                             (set dr (coco_directive st m (coco_arg m t 0) ip at err errlen))
                             (set (-> m sloc_file) sfile)
                             (set (-> m sloc_line) sline)
                             (set (-> m sloc_src) ssrc)
                             (set (-> m sloc_text) stext)
                             (set (-> m sloc_off) soff)
                             (set (-> m dgc) 0)
                             (if theld (coco_heap_root_pop m))
                             (if pushed (coco_heap_root_pop m))
                             (if (== dr 2) (coco_load_message "Warning" origin at err))
                             (if (or (== dr 0) (== dr 3)) (coco_load_message "ERROR" origin at err))
                             ;; and where it was raised, when its goal raised
                             ;; it (1.10.17): `lb_goal_hook' keeps the lines
                             ;; then and only then
                             (coco_bt_say m (or (== dr 0) (== dr 3)))
                             ;; BOTH, IN SWI'S ORDER: why nothing was loaded,
                             ;; or the error(_, _) a goal raised (3.1.0), then
                             ;; that the directive failed, named
                             (if (== dr 3)
                                 (block (coco_directive_failed m (coco_arg m t 0) err errlen)
                                        (coco_load_message "Warning" origin at err)))
                             ;; A BALL THAT IS NO error(_, _) ENDS THE LOAD
                             ;; (3.1.0), as swipl's: what was read stands, the
                             ;; rest of the file is not read, and the ball, kept
                             ;; on the machine (`lball'), is whoever asked for
                             ;; the load's to throw -- a script's load says
                             ;; ERR, swipl's `Prolog initialisation failed'
                             (if (== dr 4)
                                 (let ((char * msg . #'(strdup err)))
                                   (if (!= msg nil)
                                       (block (snprintf err errlen
                                                        "Prolog initialisation failed:\nERROR: %s" msg)
                                              (free msg)))
                                   (set (-> m heap_len) mark)
                                   (if (== up nil) (coco_inits_free ip))
                                   (coco_reader_free (aof r))
                                   (return -1)))))
                      ;; a directive may have defined a hook, or loaded a
                      ;; file that did
                      (set xbits (coco_xhook_load st m))
                      (set (-> m heap_len) mark))
                   (block
                    (if active
                        (block
                         ;; A CLAUSE THE STORE CAN EXPLAIN REFUSING IS
                         ;; REPORTED AND THE LOAD GOES ON, the way a directive
                         ;; that failed does. The rest of the file is not the
                         ;; refused clause's fault, and losing it is how ONE
                         ;; clause over the row limit came to empty a whole
                         ;; predicate. So is a clause that is no clause
                         ;; (3.1.0, swipl's `Type error: `callable' expected'
                         ;; naming it, its head or its body), which through
                         ;; 3.0.4 ended the consult or, a body with a number
                         ;; for a goal, went in.
                         (let ((size_t culprit . 0) (int dk . 0) (int refused . 0) (int gerr . 0) (int isdcg . 0))
                           ;; A GRAMMAR RULE IS TRANSLATED HERE AND NOWHERE
                           ;; ELSE (3.13.0, swipl's): a file's rules -- a
                           ;; program's, a library's, a module's own -- come
                           ;; this way, and an assert stores a rule as the
                           ;; `-->'/2 clause it is. One that will not
                           ;; translate is reported in swipl's words, its
                           ;; ball's (`coco_consult_dcg_refusal'), and passed
                           ;; over, as a clause that is no clause is.
                           (if (coco_dcg_is_rule m t)
                               (let ((coco_dcg_err derr) (size_t tr . 0))
                                 (set ($ derr kind) COCO_DCG_OK)
                                 (set ($ derr culprit) 0)
                                 (set tr (coco_dcg_rule m t 1 (aof derr)))
                                 (if (== tr 0)
                                     (block (set dk (? (== ($ derr kind) COCO_DCG_OK)
                                                       COCO_DCG_OOM ($ derr kind)))
                                            (set culprit ($ derr culprit)))
                                   (block (set t tr) (set isdcg 1)))))
                           ;; A RULE'S BODY IS ASKED OF THE PROGRAM'S
                           ;; goal_expansion/2 (3.14.0), as swipl's
                           ;; '$expand_clauses' asks it, a grammar rule's once
                           ;; it is translated: what that gives is stored, and
                           ;; an error(_, _) it raises is reported at the
                           ;; clause, which is dropped
                           (if (and (== dk 0) (and (bitand xbits 2) (coco_is_compound2 m t ":-")))
                               (let ((size_t gx . 0) (int gr . 0))
                                 (set gr (coco_consult_xcall st m "$expand_clause" (coco_new_int m 1) t (aof gx)
                                                             origin at (nth 0 incs) text toff err errlen))
                                 (cond
                                   ((== gr 1) (set t gx))
                                   ((== gr -2)
                                    (coco_consult_init_failed err errlen)
                                    (set (-> m heap_len) omark)
                                    (if (== up nil) (coco_inits_free ip))
                                    (coco_reader_free (aof r))
                                    (return -1))
                                   ((== gr -1) (set gerr 1)))))
                           (if (and (== dk 0) (not gerr))
                               (set refused (coco_consult_refused m t cids (aof culprit))))
                           (cond
                             (gerr
                              (coco_load_message "ERROR" origin at err)
                              (set (nth 0 err) (cast char 0)))
                             ((!= dk 0)
                              (coco_consult_dcg_refusal m dk culprit err errlen)
                              (coco_load_message "ERROR" origin at err)
                              (set (nth 0 err) (cast char 0)))
                             ((== refused 1)
                              (coco_consult_refusal m culprit err errlen)
                              (coco_load_message "ERROR" origin at err)
                              (set (nth 0 err) (cast char 0)))
                             ((== refused 2)
                              (coco_load_message "ERROR" origin at
                                                 "Arguments are not sufficiently instantiated"))
                             ((== refused 3) (set culprit 0))
                             ((== refused 4)
                              (coco_consult_type_text m "module" culprit err errlen)
                              (coco_load_message "ERROR" origin at err)
                              (set (nth 0 err) (cast char 0)))
                             ((== refused 5)
                              (coco_load_message "ERROR" origin at
                                                 "No permission to modify static procedure `(',')/2'"))
                             ((not (coco_assert_from st m t 1 oid origin at seen))
                              (if (!= (nth 0 (-> st assert_err)) (cast char 0))
                                  (block (snprintf err errlen "%s" (-> st assert_err))
                                         (coco_load_message "ERROR" origin at err)
                                         (set (nth 0 err) (cast char 0)))
                                (coco_load_message "ERROR" origin at "not a clause")))
                             (#t (set n (+ n 1))
                                 ;; THE COMPILER'S WARNINGS OF IT (3.19.1),
                                 ;; after any not-together warning its store
                                 ;; gave, as swipl's: of the clause read, so
                                 ;; none for what an expansion gave instead
                                 (if (and (!= cwarn nil) (!= xr 1))
                                     (block (coco_load_message "Warning" origin at cwarn)
                                            (free cwarn) (set cwarn nil)))
                                 ;; a clause defines (3.6.0, `ldefs')
                                 (set (-> m ldefs) (+ (-> m ldefs) 1))
                                 ;; a grammar rule makes its predicate a
                                 ;; non-terminal (3.14.0), as swipl's load
                                 (if isdcg (coco_consult_nt_mark st m t))
                                 ;; and one of a hook's asks the hooks again
                                 (if (coco_xhook_head m t te_id ge_id)
                                     (set xbits (coco_xhook_load st m))))))))
                    (set (-> m heap_len) mark))))
                   ;; the terms an expansion gave are done: the heap goes
                   ;; back below them -- unless a global's copy read since
                   ;; raised the mark over its cells (`coco_heap_pos_push',
                   ;; the gcache's fill), which then stays -- and an
                   ;; `end_of_file' among them, or the file's own end, ends
                   ;; the file. A term no expansion answered leaves the mark
                   ;; as its directive left it: raised, or moved by a
                   ;; collection
                   (if (== mark xmark) (set mark omark))
                   (set vouch ovouch)
                   (set (-> m heap_len) mark)
                   (if (or xstop (== rc 2)) (set rc 0))
                   (if (== rc 3) (set rc 1))))))
          ;; AN `:- if' LEFT OPEN AT THE END IS REPORTED (3.1.0), as swipl
          ;; does, on the line the text ends on, naming where the outermost
          ;; open one stands; what it held was read or skipped as it said
          (if (> csp 0)
              (let ((int eline . 1) (char what [1100]))
                (for ((size_t i . 0)) (< i ($ r len)) ((++ i))
                  (if (== (nth i text) (cast char 10)) (set eline (+ eline 1))))
                (if (!= origin nil)
                    (snprintf what (sizeof what) "Unterminated conditional compilation from %s:%d"
                              origin (nth 0 cline))
                  (snprintf what (sizeof what) "Unterminated conditional compilation from line %d"
                            (nth 0 cline)))
                (coco_load_message "ERROR" origin eline what)))
          (coco_reader_free (aof r))
          ;; AN INCLUDED FILE'S GOALS are the load's that included it, run
          ;; at that load's end (3.5.0), as swipl's
          (if (!= up nil) (return n))

          ;; ---- and now the goals the file put off ------------------------
          ;;
          ;; IN THE ORDER THEY WERE WRITTEN, each one read back out of the
          ;; store on to a heap that is wound again after it: an
          ;; initialization goal is a goal, not a clause, and nothing it
          ;; leaves on the heap is wanted once it has answered. Each is
          ;; reported at the file it stood in, an included one's its own.
          ;;
          ;; A `main' GOAL (3.7.0, swipl's) is no source file's: in a read
          ;; that defined nothing it is dropped, as swipl drops it, and a
          ;; nested read hands it up to the outermost read's list (`ltop'),
          ;; which runs the last one registered after every after_load goal
          ;; -- the whole load done -- and halts. Through 3.6.0 a nested
          ;; one ran at its own file's end, the rest of the outer file
          ;; unread, and every main in file order with the other goals.
          (let ((coco_initgoals * top . #'(cast (coco_initgoals *) (-> m ltop))))
            (for ((size_t i . 0)) (< i ($ inits len)) ((++ i))
              (if (== (nth i ($ inits modes)) 1)
                  (if (== (-> m ldefs) 0)
                      (set (nth i ($ inits modes)) 3)
                    (if (and (!= top nil) (!= top (aof inits)))
                        (block
                         (coco_inits_hand top (nth i ($ inits cells)) (nth i ($ inits lines))
                                          (? (== (nth i ($ inits files)) nil) origin
                                             (nth i ($ inits files))))
                         (set (nth i ($ inits modes)) 3)))))))
          (let ((int halt_after . 0) (int halt_code . 0) (size_t lastmain . 0) (int hasmain . 0)
                (int ran . 0))
            (for ((size_t k . 0)) (<= k ($ inits len)) ((++ k))
             (let ((size_t i . k))
              (if (< k ($ inits len))
                  (block (if (== (nth k ($ inits modes)) 3) continue)
                         (if (== (nth k ($ inits modes)) 1)
                             (block (set lastmain k) (set hasmain 1) continue)))
                (block (if (not hasmain) break)
                       (set i lastmain)
                       (set ran 1)))
              (let ((size_t back . #'(-> m heap_len))
                    (int code . 0)
                    (const char * gorg . #'(? (== (nth i ($ inits files)) nil) origin
                                              (nth i ($ inits files)))))
                ;; NOT AT HEAP CELL 0 (3.1.0): a goal there is the goal in
                ;; flight `kcall' 0, which reads as none, and the error of a
                ;; builtin it is would name no predicate (`coco_err_ctx') --
                ;; and a load that winds its heap back clause by clause
                ;; leaves it empty. A cell first, gone with the wind-back.
                (if (== (-> m heap_len) 0) (coco_new_var m))
                (if (== coco_goal_hook nil)
                    (block (coco_load_note "ERROR" gorg (nth i ($ inits lines))
                                           "initialization: there is no engine over this store")
                           (set code 2))
                  (let ((size_t span . 0)
                        (size_t goal . #'(coco_store_get_span m st (nth i ($ inits cells)) (aof span)))
                        (int gr . 0) (int main . #'(? (== (nth i ($ inits modes)) 1) 1 0))
                        (coco_strbuf gtext))
                    ;; fetched, the goal's cells are orphans
                    (set (-> st dead) (+ (-> st dead) span))
                    ;; A `main' GOAL IS NAMED IN ITS REPORT, `user:main', as
                    ;; swipl names it (3.1.0): written now, before it runs
                    ;; and collects, and as it was asked
                    (coco_sb_init (aof gtext))
                    (if main
                        (coco_write_term m (aof gtext)
                                         (coco_make2 m ":" (coco_new_atom m "user") goal) 1 0))
                    ;; THE `main' GOAL IS THE PROGRAM, NOT PART OF THE LOAD,
                    ;; so it writes through even when the file is a module
                    ;; -- and `-s FILE' makes it one, whose load is muted. It
                    ;; stands where `-s' would have called main, whose writes
                    ;; reach the knowledge base; muted, G's stayed in this
                    ;; process and ended with it.
                    ;; and it may collect, with the mark it is wound back to
                    ;; registered -- nothing else of the heap is read after
                    (let ((int was . #'(-> st muted)) (size_t * bp . nil) (size_t bl . 1)
                          (int pushed . 0))
                      (set bp (aof back))
                      (set pushed (coco_heap_pos_push m (aof bp) (aof bl)))
                      (if main (set (-> st muted) 0))
                      (set (-> m dgc) (? pushed vouch 0))
                      (set gr (coco_goal_hook st m goal (? main 2 1) err errlen))
                      (set (-> m dgc) 0)
                      (if pushed (coco_heap_root_pop m))
                      (set (-> st muted) was))
                    ;; SWI'S TWO VOICES, measured: an `after_load' goal that
                    ;; fails is a Warning and the program carries on, while a
                    ;; `main' one that fails is an ERROR and the exit status
                    ;; -- because there it IS the program. The `main' one's
                    ;; are `F:L: user:main: false' and `F:L: user:main
                    ;; MESSAGE', on one line (3.1.0, swipl's '$run_init_goal'/2;
                    ;; through 3.0 `main: false' and `main: raised exception:'
                    ;; over the message), and under `verbose' silent -- swipl
                    ;; -q's -- a main that failed says nothing (3.1.0), as
                    ;; swipl's does: it exits 1, and every other report here
                    ;; prints as it does
                    (cond
                      ((== gr 1) (set code 0))
                      ((and (== gr 0) main)
                       (let ((char what [1100]))
                         (snprintf what (sizeof what) "%s: false"
                                   (? (== ($ gtext s) nil) "user:main" ($ gtext s)))
                         (if (not (coco_verbose_silent))
                             (coco_load_note "ERROR" gorg (nth i ($ inits lines)) what))
                         (set code 1)))
                      ((== gr 0)
                       (block (coco_load_note "Warning" gorg (nth i ($ inits lines))
                                              "Initialization goal failed")
                              (set code 1)))
                      ((!= main 0)
                       (let ((char what [6000]))
                         (snprintf what (sizeof what) "%s %s"
                                   (? (== ($ gtext s) nil) "user:main" ($ gtext s)) err)
                         (coco_load_note "ERROR" gorg (nth i ($ inits lines)) what)
                         (set code 2)))
                      ;; FLUSH, NOT INDENTED, on the second line. SWI's
                      ;; four-space indent belongs to the DIRECTIVE message
                      ;; -- `coco_load_message' keeps it because that is
                      ;; where swipl writes it -- but the slot after
                      ;; `ERROR:' in an initialization report is the one
                      ;; swipl fills with its thread tag and the context of
                      ;; the throw, and cocolog has neither. Indenting into
                      ;; an empty slot was the last thing between the two
                      ;; messages: they are word for word now.
                      (#t (block (coco_load_note "ERROR" gorg (nth i ($ inits lines))
                                                 "Initialization goal raised exception:")
                                 (coco_say_lines "ERROR" "" err)
                                 (set code 2))))
                    ;; where it was raised, as a directive's (1.10.17)
                    (coco_bt_say m (and (!= gr 1) (!= gr 0)))
                    (coco_sb_free (aof gtext))))
                (if (== (nth i ($ inits modes)) 1)
                    (block (set halt_after 1) (set halt_code code)))
                (set (-> m heap_len) back))
              (if ran break)))
            (coco_inits_free (aof inits))
            ;; `initialization(G, main)' MAKES G THE PROGRAM, and SWI halts
            ;; when it is done -- 0 proved, 1 failed, 2 threw, which are the
            ;; three answers `swipl -g' ends with as well. Anything the
            ;; process was going to do next, including the goal the CLI was
            ;; given, is not done: that is the point of the word `main'. What
            ;; the run wrote is finished as the CLI finishes its own goal's:
            ;; committed when G proved or failed, rolled back when it threw.
            (if halt_after
                (coco_halt_load st halt_code (? (== halt_code 2) 0 1))))
          (return n)))

  ;;; CLAUSE I OF PI TAKEN OUT, its cells SPAN long in the store: retract/1's
  ;;; answer (3.28.0, `coco_db_walk', and '$retractall'/1's through
  ;;; `coco_retract'). 1.
  (func coco_retract_at ((coco_store * st) (coco_machine * m) (size_t pi) (size_t i)
                         (size_t span)) (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
          ;; THE LOGICAL UPDATE VIEW: with a call open on the predicate the
          ;; clause dies where it stands, for the calls open now to try still
          ;; and no later call to see (`coco_tomb_set'); the database loses
          ;; it now
          (let ((u32 era . #'(coco_tomb_open st m pi)))
            (if (!= era 0)
                (block
                  (coco_tomb_set p i era)
                  (set (-> p dynamic) 1)
                  (if (and (not (coco_store_is_muted st))
                           (!= (-> st on_retract) nil))
                      ((-> st on_retract) st (-> st ctx) pi))
                  (return 1))))
          ;; none open, and the dead of an earlier change go with it
          (if (!= (-> p ntomb) 0)
              (block
               (coco_tomb_set p i 1)
               (coco_pred_sweep st m pi)
               (set (-> p dynamic) 1)
               (if (and (not (coco_store_is_muted st))
                        (!= (-> st on_retract) nil))
                   ((-> st on_retract) st (-> st ctx) pi))
               (return 1)))
          ;; drop it from the predicate; the cells are orphaned until the
          ;; next compaction (`coco_store_compact'), and its compiled
          ;; program goes now
          (set (-> st dead) (+ (-> st dead) span))
          (coco_code_drop st (nth i (-> p clauses)))
          (set (nth i (-> p codes)) nil)
          ;; The index keys shift with them, and the chains -- which hold
          ;; POSITIONS -- are dropped: everything after this clause has just
          ;; been renumbered.
          (for ((size_t j . i)) (< (+ j 1) (-> p nclauses)) ((++ j))
            (set (nth j (-> p clauses)) (nth (+ j 1) (-> p clauses)))
            (set (nth j (-> p keys)) (nth (+ j 1) (-> p keys)))
            (set (nth j (-> p origins)) (nth (+ j 1) (-> p origins)))
            (set (nth j (-> p muted)) (nth (+ j 1) (-> p muted)))
            (set (nth j (-> p codes)) (nth (+ j 1) (-> p codes))))
          (set (-> p nclauses) (- (-> p nclauses) 1))
          (coco_pred_nprobe p)
          (set (-> p tver) (+ (-> p tver) 1))
          (coco_pred_unindex p)
          ;; anything retractable is dynamic by definition, whether or not
          ;; anybody said so
          (set (-> p dynamic) 1)
          ;; and the database is told. NOTHING IS WOUND BACK HERE: the whole
          ;; point of `retract(counter(X))' is that X is left bound to what
          ;; was retracted, and the term it is bound into is the copy the
          ;; caller made on the heap. The hook keeps its own heap use to
          ;; itself.
          (if (and (not (coco_store_is_muted st))
                   (!= (-> st on_retract) nil))
              ((-> st on_retract) st (-> st ctx) pi))
          (return 1)))

  (func coco_retract ((coco_store * st) (coco_machine * m) (size_t clause)) (out int)
        (set clause (coco_deref m clause))
        (let ((size_t head . clause) (size_t body . 0) (int has_body . 0))
          (if (and (coco_is_callable m clause) (== (coco_arity m clause) 2))
              (if (== 0 (strcmp (coco_atom_name m (coco_name_of m clause)) ":-"))
                  (block (set head (coco_deref m (coco_arg m clause 0)))
                         (set body (coco_arg m clause 1))
                         (set has_body 1))))
          (if (not (coco_is_callable m head)) (return 0))
          ;; INTERNED, not merely found. `retract' is a builtin, so its argument
          ;; is never solved as a goal and nothing has put the predicate in the
          ;; store; with `coco_pred_find' a fresh interpreter's first `retract'
          ;; failed against a knowledge base that plainly had the clause.
          ;; Interning is what makes `coco_pred_ensure' below able to ask.
          (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m head)
                                               (coco_arity m head))))
            (if (>= pi (-> st npreds)) (return 0))
            ;; a predicate that could not be read is not written either
            ;; (`coco_assert_from' says why): -1, and nothing is taken
            (if (not (coco_pred_ensure st pi)) (return -1))
            (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
                  ;; the head's first-argument key, the same cell the index keeps
                  ;; per clause: two different non-zero keys cannot unify, so a
                  ;; candidate with the wrong one is skipped BEFORE it is copied
                  (u64 hkey . #'(coco_arg_key m head)))
              (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
                ;; WITHOUT THIS, RETRACT WAS QUADRATIC WITH A LARGE CONSTANT: every
                ;; candidate was copied whole on to the heap and then unified, so
                ;; 2 999 retracts by key over 3 000 clauses of 16 KB copied some
                ;; thirty-six billion cells -- 153 s, measured -- for work the
                ;; key decides in one comparison
                (if (and (!= hkey 0) (!= (nth i (-> p keys)) 0)
                         (!= hkey (nth i (-> p keys))))
                    continue)
                ;; a clause that died under an open call is retracted already
                (if (coco_pred_dead p i) continue)
                (let ((size_t mark . #'(-> m heap_len))
                      (size_t tmark . #'(-> m trail_len))
                      ;; SPAN is the clause's cells in the store, which the
                      ;; copy's length is not (`coco_store_get_span')
                      (size_t span . 0)
                      (size_t cand . #'(coco_store_get_span m st (nth i (-> p clauses)) (aof span)))
                      (size_t chead . 0) (size_t cbody . 0) (int ok . 0))
                  ;; the candidate arrives as a fresh copy, so unifying against
                  ;; it cannot bind anything in the store
                  (set chead cand)
                  (if (and (coco_is_callable m cand) (== (coco_arity m cand) 2))
                      (if (== 0 (strcmp (coco_atom_name m (coco_name_of m cand)) ":-"))
                          (block (set chead (coco_arg m cand 0))
                                 (set cbody (coco_arg m cand 1)))))
                  (set ok (coco_unify m head chead))
                  ;; THE BODY ALWAYS CONSTRAINS -- SWI's rule, and the bug a
                  ;; CivV capture paid to find: the shorthand `retract(F)' IS
                  ;; `retract((F :- true))', and a stored FACT's body IS the
                  ;; atom `true'. The old code skipped the body check entirely
                  ;; for the shorthand -- so it pulled a same-headed RULE out
                  ;; from over the facts -- and refused every fact in the
                  ;; explicit form, so `retract((f(x) :- true))' failed
                  ;; against a base that plainly held f(x). One `true' atom on
                  ;; the heap (clause/2's own trick, builtins.cicili) makes
                  ;; the two forms one rule: the asked body unifies against
                  ;; the candidate's, a missing side standing in as `true'.
                  ;; The atoms are re-made each round because a mismatch winds
                  ;; the heap back to the mark below.
                  (if ok
                      (block
                       (if (== cbody 0) (set cbody (coco_new_atom m "true")))
                       (if (== has_body 0) (set body (coco_new_atom m "true")))
                       (set ok (coco_unify m body cbody))))
                  (if ok
                      (return (coco_retract_at st m pi i span)))
                  (coco_undo_to m tmark)
                  (set (-> m heap_len) mark))))
            (return 0))))

  ) ; impl-kb-consult

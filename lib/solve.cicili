;;;; cocolog -- the resolution engine
;;;
;;; NOTHING HERE RECURSES IN C, and that is the whole point of the file. A
;;; Prolog interpreter is naturally written as a recursive solve() that calls
;;; itself for each subgoal and uses the C stack as its continuation -- it is
;;; half the length that way. But a machine whose continuation is the C stack
;;; cannot be stopped and written to a database, because the C stack is not
;;; data. cocolog exists to be suspended and resumed, so the continuation is a
;;; term on the heap and the choice points are an array of integers, and the
;;; engine is a loop over them.
;;;
;;; What that buys is in state.cicili: freezing a machine is writing out four
;;; arrays, and thawing one is reading them back. There is no other way to get
;;; that, and every other design decision here follows from it.
;;;
;;; THE CONTINUATION. `'$k'(Goal, Barrier, Rest)', with the atom `[]' at the
;;; end. Barrier is the choice-stack height that a `!' in Goal cuts back to --
;;; carried per goal rather than kept in a register, because a suspended
;;; machine has to remember the barrier of every pending goal, not just the
;;; current one.
;;;
;;; THE CHOICE POINT. Two kinds, and no more:
;;;
;;;   CLAUSE  more clauses of a predicate remain to be tried. Holds which
;;;           predicate and which clause is next.
;;;   GOAL    an alternative goal to run instead -- the right arm of `;', the
;;;           `true' of a negation. Holds the goal.
;;;
;;; Both record the trail and heap heights at the moment they were made, and
;;; backtracking winds both back. Truncating the heap is what reclaims the
;;; terms a failed branch built; it is safe because everything the choice point
;;; needs to resume -- its continuation, its goal -- was built BEFORE the mark.
;;;
;;; CUT IS TRUNCATION. `!' sets the choice stack's height back to the barrier
;;; its goal was carried with. That is all a cut is here, and it is why the
;;; barrier has to travel with the goal.
;;;
;;; THE LAST CLAUSE DROPS ITS CHOICE POINT. Without that a recursive predicate
;;; leaves one behind per iteration and the choice stack grows with the
;;; recursion even when nothing can backtrack into it. With it, a deterministic
;;; recursion runs in constant choice-stack space.
;;;
;;; BUILTINS ARE A TABLE. *builtins* below is read by the macro layer to emit
;;; the dispatcher -- grouped by arity, so a name is only compared against the
;;; builtins that could match it. Adding one is a line in the table and a
;;; function; the dispatcher cannot fall out of step with the table because it
;;; is generated from it.
;;;
;;; A TARGET USING THIS FILE NEEDS <math.h> AND -lm. The arithmetic builtins
;;; reach pow, sqrt, fabs and llround; lib/std/c declares them for inference
;;; but the header still has to be included by the target that emits code.
;;;
;;; EVERY BUILTIN HERE IS DETERMINISTIC. A builtin that could leave a choice
;;; point behind -- `between/3', `clause/2' -- would need the engine's choice
;;; stack in its hands, and would then be the one piece of the system that
;;; could not be written by anyone else. They belong in the Prolog-level
;;; library instead, where they are three lines and cost nothing.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;;; ------------------------------------------------------------------
;;;; The builtin table
;;;; ------------------------------------------------------------------

;;; name, arity, and the function that runs it. Each answers 1 for success and
;;; 0 for failure; an error is reported by filling in the engine's `err' and
;;; answering -1.
(DEFPARAMETER *builtins*
  '(("="            2 coco_bi_unify)
    ("\\="          2 coco_bi_not_unify)
    ("=="           2 coco_bi_eq)
    ("\\=="         2 coco_bi_neq)
    ("@<"           2 coco_bi_lt)
    ("@>"           2 coco_bi_gt)
    ("@=<"          2 coco_bi_le)
    ("@>="          2 coco_bi_ge)
    ("compare"      3 coco_bi_compare)

    ("var"          1 coco_bi_var)
    ("nonvar"       1 coco_bi_nonvar)
    ("atom"         1 coco_bi_atom)
    ("number"       1 coco_bi_number)
    ("integer"      1 coco_bi_integer)
    ("float"        1 coco_bi_float)
    ("atomic"       1 coco_bi_atomic)
    ("compound"     1 coco_bi_compound)
    ("callable"     1 coco_bi_callable)
    ("is_list"      1 coco_bi_is_list)

    ("is"           2 coco_bi_is)
    ("=:="          2 coco_bi_num_eq)
    ("=\\="         2 coco_bi_num_neq)
    ("<"            2 coco_bi_num_lt)
    (">"            2 coco_bi_num_gt)
    ("=<"           2 coco_bi_num_le)
    (">="           2 coco_bi_num_ge)

    ("functor"      3 coco_bi_functor)
    ("arg"          3 coco_bi_arg)
    ("=.."          2 coco_bi_univ)
    ("copy_term"    2 coco_bi_copy_term)

    ("atom_length"  2 coco_bi_atom_length)
    ("atom_codes"   2 coco_bi_atom_codes)
    ("atom_concat"  3 coco_bi_atom_concat)
    ("number_codes" 2 coco_bi_number_codes)

    ("write"        1 coco_bi_write)
    ("print"        1 coco_bi_write)
    ("writeln"      1 coco_bi_writeln)
    ("write_canonical" 1 coco_bi_write_canonical)
    ("nl"           0 coco_bi_nl)

    ("assert"       1 coco_bi_assertz)
    ("asserta"      1 coco_bi_asserta)
    ("assertz"      1 coco_bi_assertz)
    ("retract"      1 coco_bi_retract)

    ("dynamic"      1 coco_bi_dynamic)
    ("listing"      0 coco_bi_listing_all)
    ("listing"      1 coco_bi_listing)

    ("halt"         0 coco_bi_halt)))

;;; Grouped by arity, so a goal of arity 3 never runs a strcmp against a
;;; builtin of arity 1. FOUND says whether the name was a builtin at all --
;;; which is what tells the engine to go looking in the knowledge base instead.
(DEFMACRO coco-emit-builtin-dispatch ()
  (LET ((arities (SORT (REMOVE-DUPLICATES (MAPCAR #'SECOND *builtins*)) #'<)))
    `(func coco_builtin ((coco_engine * e) (const char * name) (u32 arity) (size_t g) (int * found))
       (out int)
       (set (cof found) 1)
       (cond
         ,@(MAPCAR
            (LAMBDA (n)
              `((== arity ,n)
                (cond
                  ,@(MAPCAR (LAMBDA (row) `((== 0 (strcmp name ,(FIRST row)))
                                            (return (,(THIRD row) e g))))
                            (REMOVE-IF-NOT (LAMBDA (r) (= (SECOND r) n)) *builtins*))
                  (#t (set (cof found) 0) (return 0)))))
            arities)
         (#t (set (cof found) 0) (return 0))))))

;;; The binary arithmetic operators, as (name int-op float-op). Both operands
;;; are integers only if neither is a float, which is the rule `is/2' follows
;;; throughout: integer arithmetic stays exact until a float enters it.
(DEFPARAMETER *arith-binops*
  '(("+" +) ("-" -) ("*" *)))

;;; Expands inside `coco_arith_binary' and nowhere else, and reads the names that
;;; function has already bound: `ai'/`af' and `bi'/`bf' are the two operands as
;;; integer and as float, `both_int' says which pair to use, and `iv'/`fv'/`isf'
;;; are where the answer goes. Naming them here rather than passing eight forms
;;; keeps the call site to one word -- the same arrangement lib/std uses for
;;; the words its front-end macros recognise.
(DEFMACRO coco-emit-arith-binops ()
  `(cond
     ,@(MAPCAR (LAMBDA (row)
                 `((== 0 (strcmp name ,(FIRST row)))
                   (if both_int
                       (block (set (cof iv) (,(SECOND row) ai bi))
                              (set (cof isf) 0))
                     (block (set (cof fv) (,(SECOND row) af bf))
                            (set (cof isf) 1)))
                   (return 1)))
               *arith-binops*)
     (#t (return 0))))


;;;; ------------------------------------------------------------------
;;;; Declarations
;;;; ------------------------------------------------------------------

(generic decl-solve
  ()

  ;;; A CATCH frame is not an alternative and never offers one -- backtracking
  ;;; through it pops it and keeps going. What it is is a MARK: `throw/1' walks
  ;;; the stack looking for one whose catcher matches, and the trail and heap
  ;;; marks every frame already carries are exactly what "put the machine back
  ;;; as it was when the catch was entered" means.
  ;;;
  ;;; IT COSTS NOTHING IN state.cicili, which was the reason to do it this way.
  ;;; A frame is written out field by field with its kind, and the catcher and
  ;;; the recovery goal ride in `call' as one `'$catch'(C, R)' term on the heap
  ;;; -- and the heap is serialised already. A frozen machine inside a `catch'
  ;;; comes back inside it.
  ;;; DEAD is a GOAL frame the soft cut has taken the alternative away from.
  ;;; It is a KIND and not a flag on the frame because the frames travel in a
  ;;; frozen machine as a fixed row of numbers, and the kind is already one of
  ;;; them -- a new field would change that format for every blob ever written,
  ;;; while a new kind is a value no old blob contains.
  ;;;
  ;;; It cannot simply be popped instead. The frames are an array and every
  ;;; barrier, every `$cut' height and every restored `nchoices' is an INDEX
  ;;; into it, so removing one from the middle would move all of them.
  (enum coco_choice_kind (COCO_CH_CLAUSE . 0) (COCO_CH_GOAL . 1) (COCO_CH_CATCH . 2)
                         (COCO_CH_DEAD . 3))

  (struct coco_choice
    (member int      kind)
    (member size_t   goals)        ; the continuation to put back
    (member size_t   trail_mark)
    (member size_t   heap_mark)
    (member size_t   call)         ; the goal being solved, or the alternative
    (member size_t   pred)
    (member size_t   clause_ix)    ; the next clause to try
    (member size_t   barrier))     ; the cut barrier the alternative runs under

  (struct coco_engine
    (member coco_machine * m)
    (member coco_store *   st)

    (member size_t      goals)     ; the continuation: '$k'(G,B,Rest) or []
    (member coco_choice * choices)
    (member size_t      nchoices)
    (member size_t      choice_cap)

    (member size_t      query)     ; the goal as asked, kept for reporting
    (member u64         steps)
    (member u64         max_steps) ; 0 is no limit
    (member int         resume)    ; a solution has been reported; go back first
    (member int         halted)
    (member int         halt_code)
    (member char        err [192]))

  (decl) (func coco_engine_init ((coco_engine * e) (coco_machine * m) (coco_store * st)))
  (decl) (func coco_engine_free ((coco_engine * e)))

  ;;; Points the engine at a goal. Discards any state from a previous query.
  (decl) (func coco_engine_ask ((coco_engine * e) (size_t goal)))

  ;;; Runs to the next solution. 1 = one was found and the bindings stand,
  ;;; 0 = there are no more, -1 = something went wrong and `e->err' says what.
  (decl) (func coco_engine_next ((coco_engine * e)) (out int))

  ;;; Reads GOAL as text and asks it. Answers 1, or 0 with `e->err' set.
  (decl) (func coco_engine_ask_text ((coco_engine * e) (const char * text)) (out int))

  (decl) (func coco_builtin ((coco_engine * e) (const char * name) (u32 arity)
                           (size_t g) (int * found)) (out int))

  ;;; ---- the module seam ---------------------------------------------------
  ;;;
  ;;; TWO NULL FUNCTION POINTERS, and this file consults them and knows nothing
  ;;; else about modules -- not what one is, nor how many there are. It is the
  ;;; arrangement kb.cicili uses for the knowledge base, for the same reason: a
  ;;; cocolog built without a module is the cocolog that existed before modules,
  ;;; because the hooks stay null and the cost is one null check per goal that
  ;;; was going to reach the knowledge base anyway.
  ;;;
  ;;; CALL runs a goal that is not a control construct and not a core builtin,
  ;;; setting FOUND if some module owned the name and arity. It is consulted
  ;;; AFTER the core builtins, so no module can redefine `=' or `is' underneath
  ;;; a program, and BEFORE the knowledge base, so a module predicate is not
  ;;; silently shadowed by a clause somebody asserted.
  ;;;
  ;;; LOAD is given a store and asked to put the modules' own clauses in it. It
  ;;; runs when a query is asked rather than when a store is made, because a
  ;;; store can be emptied under the engine -- thawing a machine does exactly
  ;;; that -- and the clauses have to come back.
  ;;; ---- all the solutions of a goal --------------------------------------
  ;;;
  ;;; Runs GOAL to exhaustion on a NESTED ENGINE sharing this one's machine and
  ;;; store, and answers a list of copies of TEMPLATE, one per solution. This
  ;;; is what `findall/3' is, and `forall/2' and `aggregate_all/3' after it --
  ;;; but it lives here rather than in a module because a module cannot see the
  ;;; engine, and running a goal to exhaustion is exactly seeing the engine.
  ;;;
  ;;; THE SOLUTIONS GO THROUGH THE STORE AND NOT THE HEAP. Backtracking
  ;;; truncates the heap to the choice point's mark, so a copy made on the heap
  ;;; during the search is gone by the time the search ends -- the collection
  ;;; would come back empty or, worse, pointing at cells that had been reused.
  ;;; The store never shrinks, which is the property `assert' already relies on,
  ;;; so each solution is put there and read back afterwards.
  ;;;
  ;;; IT IS DETERMINATE, and has to be: it makes no choice point of its own and
  ;;; cannot be suspended half way, so a machine frozen during a `findall' is
  ;;; frozen before it or after it and never inside it.
  ;;;
  ;;; Answers 1, or 0 with `e->err' carrying whatever went wrong inside.
  (decl) (func coco_engine_findall ((coco_engine * e) (size_t template) (size_t goal)
                                  (size_t * out)) (out int))

  ;;; Throws BALL, exactly as `throw/1' does. A module's C half uses this to
  ;;; raise an error a program can catch, rather than filling in `err' and
  ;;; stopping the query -- which is what every builtin here used to do and is
  ;;; why cocolog failed where SWI threw.
  ;;;
  ;;; Answers 1 when a `catch/3' took it, in which case the caller must return
  ;;; 1 as well and let the engine run the recovery goal; and 0 when nothing
  ;;; caught it, in which case `err' says so and the caller returns -1.
  (decl) (func coco_m_thrown ((coco_engine * e) (size_t ball)) (out int))

  (decl) (func coco_extern_install
               ((func call ((coco_engine * e) (const char * name) (u32 arity)
                            (size_t g) (int * found)) (out int))
                (func load ((coco_store * st) (coco_machine * m) (coco_engine * e))
                      (out int))))

  ;;; Puts back one choice-point frame read out of a frozen machine. The
  ;;; predicate arrives as a name and an arity rather than as an index -- see
  ;;; state.cicili for why -- and is interned into whatever store this machine
  ;;; is being resumed against.
  (decl) (func coco_choice_restore ((coco_engine * e) (int kind) (size_t goals)
                                  (size_t trail_mark) (size_t heap_mark) (size_t call)
                                  (size_t clause_ix) (size_t barrier)
                                  (const char * pred_name) (u32 pred_arity)) (out int))

  ) ; decl-solve


;;;; ------------------------------------------------------------------
;;;; Implementation
;;;; ------------------------------------------------------------------

(generic impl-solve
  ()

  (static)
  (func coco_eng_grow ((coco_engine * e) (size_t need)) (out int)
        (if (<= need (-> e choice_cap)) (return 1))
        (let ((size_t ncap . #'(? (== (-> e choice_cap) 0) 64 (-> e choice_cap)))
              (coco_choice * nb))
          (while (< ncap need) (set ncap (* ncap 2)))
          (set nb (cast (coco_choice *) (realloc (-> e choices) (* ncap (sizeof coco_choice)))))
          (if (== nb nil) (return 0))
          (set (-> e choices) nb)
          (set (-> e choice_cap) ncap)
          (return 1)))

  ;;; ---- the module seam -------------------------------------------------

  ;; No initialiser: a static is null until `coco_extern_install' says otherwise,
  ;; and `. nil' cannot be written inside a generic in this package -- `nil'
  ;; there is the symbol `cocolog::nil', which dots the form with something
  ;; that is not a list and stops the specifier walking it.
  (static) (var func coco_extern_call ((coco_engine * e) (const char * name)
                                     (u32 arity) (size_t g) (int * found))
                 (out int))
  (static) (var func coco_extern_load ((coco_store * st) (coco_machine * m)
                                     (coco_engine * e)) (out int))

  (func coco_extern_install
        ((func call ((coco_engine * e) (const char * name) (u32 arity)
                     (size_t g) (int * found)) (out int))
         (func load ((coco_store * st) (coco_machine * m) (coco_engine * e)) (out int)))
        (set coco_extern_call call)
        (set coco_extern_load load))

  (static)
  (func coco_fail_err ((coco_engine * e) (const char * what)) (out int)
        (snprintf (-> e err) 192 "%s" what)
        (return -1))

  ;;; ---- errors a program can catch ---------------------------------------
  ;;;
  ;;; The core builtins used to stop the query through `coco_fail_err', which is
  ;;; why cocolog FAILED wherever SWI threw. They raise `error(Formal, _)' now,
  ;;; exactly as the modules do -- the difference is only that these are on the
  ;;; engine's side of the seam, so they build the term here rather than
  ;;; through the module API.
  ;;;
  ;;; 2 means "the continuation is already set", which is what a caught throw
  ;;; leaves behind; -1 means nothing caught it.
  (static) (decl) (func coco_throw ((coco_engine * e) (size_t ball)) (out int))

  (static)
  (func coco_raise ((coco_engine * e) (size_t formal)) (out int)
        (let ((size_t ball . #'(coco_make2 (-> e m) "error" formal
                                         (coco_new_var (-> e m)))))
          (return (? (== 1 (coco_throw e ball)) 2 -1))))

  (static)
  (func coco_type_error ((coco_engine * e) (const char * type) (size_t culprit)) (out int)
        (return (coco_raise e (coco_make2 (-> e m) "type_error"
                                      (coco_new_atom (-> e m) type) culprit))))

  (static)
  (func coco_instantiation_error ((coco_engine * e)) (out int)
        (return (coco_raise e (coco_new_atom (-> e m) "instantiation_error"))))

  (static)
  (func coco_evaluation_error ((coco_engine * e) (const char * what)) (out int)
        (return (coco_raise e (coco_make1 (-> e m) "evaluation_error"
                                      (coco_new_atom (-> e m) what)))))

  ;;; `existence_error(procedure, Name/Arity)', the one a call to a predicate
  ;;; nobody defined raises. The indicator is built before the ball because
  ;;; `coco_raise' consumes it, and `/' is an ordinary two-argument term here --
  ;;; the writer turns it back into `foo/2' from the operator table.
  (static)
  (func coco_existence_error ((coco_engine * e) (const char * kind)
                              (const char * name) (u32 arity)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t ind . #'(coco_make2 m "/" (coco_new_atom m name)
                                          (coco_new_int m (cast i64 arity)))))
          (return (coco_raise e (coco_make2 m "existence_error"
                                            (coco_new_atom m kind) ind)))))

  ;;; ---- the continuation --------------------------------------------------

  ;;; '$k'(Goal, Barrier, Rest). Built with coco_make rather than the term DSL
  ;;; because all three arguments are values the engine is holding, not a shape
  ;;; known when this was written.
  (static)
  (func coco_k_push ((coco_engine * e) (size_t goal) (size_t barrier) (size_t rest)) (out size_t)
        (let ((size_t args [3]))
          (set (nth 0 args) goal)
          (set (nth 1 args) (coco_new_int (-> e m) (cast i64 barrier)))
          (set (nth 2 args) rest)
          (return (coco_make (-> e m) "$k" 3 args))))

  (static)
  (func coco_k_empty ((coco_engine * e)) (out size_t)
        (return (coco_new_atom (-> e m) "[]")))

  (static)
  (func coco_k_is_empty ((coco_engine * e) (size_t k)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (set k (coco_deref m k))
          (return (? (coco-tag-is ATOM (nth k (-> m heap))) 1 0))))

  ;;; ---- choice points -----------------------------------------------------

  ;;; Answers whether the frame was made, NOT where it went. The index is
  ;;; `nchoices - 1' and the caller reads it there: an earlier version answered
  ;;; with the index and the callers tested it against 0, which is the index of
  ;;; the FIRST choice point -- so every disjunction and every negation
  ;;; attempted with an empty choice stack silently did nothing at all.
  (static)
  (func coco_push_choice ((coco_engine * e) (int kind) (size_t call) (size_t goals) (size_t barrier))
        (out int)
        (if (not (coco_eng_grow e (+ (-> e nchoices) 1))) (return 0))
        (let ((coco_choice * c . #'(aof (nth (-> e nchoices) (-> e choices)))))
          (memset c 0 (sizeof coco_choice))
          (set (-> c kind) kind)
          (set (-> c call) call)
          (set (-> c goals) goals)
          (set (-> c barrier) barrier)
          (set (-> c trail_mark) ($ (cof (-> e m)) trail_len))
          (set (-> c heap_mark) ($ (cof (-> e m)) heap_len))
          (set (-> e nchoices) (+ (-> e nchoices) 1))
          (return 1)))

  ;;; ---- clause selection --------------------------------------------------

  ;;; Tries the clauses of the choice point at CI, from `clause_ix' on. On a
  ;;; head that unifies it sets the continuation and answers 1; when the
  ;;; clauses run out it pops the choice point and answers 0.
  ;;;
  ;;; THE LAST MATCHING CLAUSE POPS ITS OWN CHOICE POINT. A predicate whose
  ;;; final clause matched has nothing left to backtrack into, and leaving the
  ;;; frame behind would make every recursive call cost one -- which is the
  ;;; difference between a loop that runs in constant space and one that does
  ;;; not.
  (static)
  (func coco_select_clause ((coco_engine * e) (size_t ci)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st)))
          (while 1
            (let ((coco_choice * c . #'(aof (nth ci (-> e choices))))
                  (coco_pred * p . #'(aof (nth (-> c pred) (-> st preds)))))
              (if (>= (-> c clause_ix) (-> p nclauses))
                  (block (set (-> e nchoices) ci) (return 0)))
              (let ((size_t cl . #'(nth (-> c clause_ix) (-> p clauses)))
                    (size_t call . #'(-> c call))
                    (size_t goals . #'(-> c goals))
                    (size_t hmark . #'(-> c heap_mark))
                    (size_t tmark . #'(-> c trail_mark))
                    (int last . 0))
                (set (-> c clause_ix) (+ (-> c clause_ix) 1))
                (set last (? (>= (-> c clause_ix) (-> p nclauses)) 1 0))
                ;; the clause arrives as a fresh copy on the heap, so unifying
                ;; against its head cannot bind anything in the store
                (let ((size_t ct . #'(coco_store_get m st cl))
                      (size_t head) (size_t body))
                  (coco_clause_parts m ct (aof head) (aof body))
                  (if (coco_unify m call head)
                      (block
                       ;; a `!' in the body cuts back to before this call
                       (if last (set (-> e nchoices) ci))
                       (set (-> e goals)
                            (? (== body 0) goals (coco_k_push e body ci goals)))
                       (return 1)))
                  ;; that head did not match: put the machine back and try again
                  (coco_undo_to m tmark)
                  (set ($ (cof m) heap_len) hmark)))))
          (return 0)))

  ;;; ---- backtracking ------------------------------------------------------

  ;;; Winds the machine back to the newest choice point that still has
  ;;; something to try, and puts the continuation back. Answers 0 when there is
  ;;; nothing left anywhere, which is the query failing.
  (static)
  (func coco_backtrack ((coco_engine * e)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (while (> (-> e nchoices) 0)
            (let ((size_t ci . #'(- (-> e nchoices) 1))
                  (int kind) (size_t call) (size_t goals) (size_t barrier))
              (let ((coco_choice * c . #'(aof (nth ci (-> e choices)))))
                (coco_undo_to m (-> c trail_mark))
                (set ($ (cof m) heap_len) (-> c heap_mark))
                (set kind (-> c kind))
                (set call (-> c call))
                (set goals (-> c goals))
                (set barrier (-> c barrier)))
              (if (== kind COCO_CH_GOAL)
                  (block (set (-> e nchoices) ci)
                         (set (-> e goals) (coco_k_push e call barrier goals))
                         (return 1)))
              ;; a catch offers no alternative, and neither does a frame the
              ;; soft cut killed: drop it and keep going down
              (if (or (== kind COCO_CH_CATCH) (== kind COCO_CH_DEAD))
                  (block (set (-> e nchoices) ci) continue))
              (if (coco_select_clause e ci) (return 1))))
          (return 0)))

  ;;; ---- throwing ----------------------------------------------------------

  ;;; Unwinds to the nearest enclosing `catch/3' whose catcher unifies with
  ;;; BALL, and leaves the engine about to run that catch's recovery goal.
  ;;; Answers 1 when it found one and -1 when nothing caught it.
  ;;;
  ;;; THE BALL GOES INTO THE STORE FIRST, and that is the whole difficulty.
  ;;; Unwinding truncates the heap to the frame's mark, and the ball was built
  ;;; above that mark -- by the time there is somewhere to put it, it is gone.
  ;;; The store does not shrink, which is the property `assert' and `findall'
  ;;; already rely on, so the ball is put there and read back out on to the
  ;;; heap once the machine has been wound back.
  ;;;
  ;;; A CATCHER THAT DOES NOT MATCH MUST LEAVE NOTHING BEHIND. Trying it is a
  ;;; unification, so it is done between a mark and an undo -- otherwise a
  ;;; failed match would bind the catcher of an outer frame on the way past.
  (static)
  (func coco_throw ((coco_engine * e) (size_t ball)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t cell . #'(coco_store_put (-> e st) (-> e m) ball)))

          (while (> (-> e nchoices) 0)
            (let ((size_t ci . #'(- (-> e nchoices) 1))
                  (int kind) (size_t call) (size_t goals) (size_t barrier))
              (let ((coco_choice * c . #'(aof (nth ci (-> e choices)))))
                (set kind (-> c kind))
                (set call (-> c call))
                (set goals (-> c goals))
                (set barrier (-> c barrier))
                ;; back to how things stood when this frame was made
                (coco_undo_to m (-> c trail_mark))
                (set ($ (cof m) heap_len) (-> c heap_mark)))

              (if (!= kind COCO_CH_CATCH)
                  (block (set (-> e nchoices) ci) continue))

              ;; `'$catch'(Catcher, Recovery)', built before the frame was
              ;; pushed and so below its heap mark -- it survived the unwinding
              (let ((size_t mark . #'($ (cof m) trail_len))
                    (size_t fresh . #'(coco_store_get m st cell))
                    (size_t catcher . #'(coco_arg m call 0))
                    (size_t recovery . #'(coco_arg m call 1)))
                (if (coco_unify m catcher fresh)
                    (block (set (-> e nchoices) ci)
                           (set (-> e goals) (coco_k_push e recovery barrier goals))
                           (return 1)))
                (coco_undo_to m mark))
              (set (-> e nchoices) ci)))

          ;; nothing caught it. The ball is read back one last time so that the
          ;; message can name it, which is the difference between a report a
          ;; person can act on and `an error occurred'.
          (let ((coco_strbuf b))
            (coco_sb_init (aof b))
            (coco_write_term m (aof b) (coco_store_get m st cell) 1 0)
            (snprintf (-> e err) 192 "uncaught exception: %s"
                      (? (== ($ b s) nil) "?" ($ b s)))
            (coco_sb_free (aof b)))
          (return -1)))

  (func coco_m_thrown ((coco_engine * e) (size_t ball)) (out int)
        (return (? (== 1 (coco_throw e ball)) 1 0)))

  ;;; ---- calling ------------------------------------------------------------

  ;;; if-then-else, and the three things built out of it. Reads as:
  ;;;
  ;;;   push an alternative that runs ELSE
  ;;;   run COND, then cut away that alternative, then run THEN
  ;;;
  ;;; The cut is a `'$cut'(H)' goal put between them, where H is the height the
  ;;; stack had before the alternative was pushed. COND runs under a barrier of
  ;;; its own, so a `!' inside a condition is local to it -- which is what the
  ;;; standard says and what makes `( ! ; true )' behave.
  (static)
  (func coco_ite ((coco_engine * e) (size_t c) (size_t t) (size_t els) (size_t k) (size_t b))
        (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t h0 . #'(-> e nchoices)))
          (if (not (coco_push_choice e COCO_CH_GOAL els k b)) (return 0))
          (let ((size_t k1 . #'(coco_k_push e t b k))
                (size_t cut . #'(coco_make1 m "$cut" (coco_new_int m (cast i64 h0)))))
            (set (-> e goals) (coco_k_push e c (-> e nchoices) (coco_k_push e cut b k1))))
          (return 1)))

  ;;; The SOFT cut, `(C *-> T ; E)'. It differs from if-then-else in one
  ;;; place and one only: when C succeeds, T runs for EVERY solution of C, not
  ;;; just the first. So the alternative that runs E has to go while C's own
  ;;; choice points stay -- which is why `$cut' will not do here. `$cut'
  ;;; truncates the stack to a height, and everything C pushed is above the
  ;;; frame holding E.
  ;;;
  ;;; `$softcut'(H) kills the one frame at H instead, leaving the rest alone.
  (static)
  (func coco_soft_ite ((coco_engine * e) (size_t c) (size_t t) (size_t els)
                       (size_t k) (size_t b))
        (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t h0 . #'(-> e nchoices)))
          (if (not (coco_push_choice e COCO_CH_GOAL els k b)) (return 0))
          (let ((size_t k1 . #'(coco_k_push e t b k))
                (size_t sc . #'(coco_make1 m "$softcut" (coco_new_int m (cast i64 h0)))))
            (set (-> e goals) (coco_k_push e c (-> e nchoices) (coco_k_push e sc b k1))))
          (return 1)))

  ;;; ---- the loop -----------------------------------------------------------

  (func coco_engine_init ((coco_engine * e) (coco_machine * m) (coco_store * st))
        (memset e 0 (sizeof coco_engine))
        (set (-> e m) m)
        (set (-> e st) st))

  (func coco_engine_free ((coco_engine * e))
        (free (-> e choices))
        (memset e 0 (sizeof coco_engine)))

  (func coco_engine_ask ((coco_engine * e) (size_t goal))
        (set (-> e nchoices) 0)
        (set (-> e steps) 0)
        (set (-> e resume) 0)
        (set (-> e halted) 0)
        (set (nth 0 (-> e err)) (cast char 0))
        (set (-> e query) goal)
        (set (-> e goals) (coco_k_push e goal 0 (coco_k_empty e))))

  (func coco_engine_findall ((coco_engine * e) (size_t template) (size_t goal)
                          (size_t * out)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (coco_engine sub)
              (size_t * kept . nil) (size_t n . 0) (size_t cap . 0)
              (int ok . 1) (int rc . 0))

          ;; WHERE THE MACHINE STOOD BEFORE THE SEARCH. The sub-engine's last
          ;; solution leaves its bindings on the trail: the final clause of a
          ;; predicate drops its own choice point, so there is no frame left to
          ;; backtrack through and undo them. Without this, `findall(X, p(X,Y),
          ;; L)' comes back with Y still bound to whatever the last solution
          ;; made it -- which is invisible until something reuses Y, and then
          ;; the next goal sees one solution where there were four.
          (let ((size_t tmark . #'($ (cof m) trail_len))
                (size_t hmark . #'($ (cof m) heap_len)))

          (coco_engine_init (aof sub) m st)
          ;; the inner search spends the outer one's remaining budget, so a
          ;; `cocolog step' with a step limit cannot be overrun by a findall
          (if (!= (-> e max_steps) 0)
              (set ($ sub max_steps)
                   (? (>= (-> e steps) (-> e max_steps)) 1
                      (- (-> e max_steps) (-> e steps)))))
          (coco_engine_ask (aof sub) goal)

          (while 1
            (set rc (coco_engine_next (aof sub)))
            (if (== rc -1)
                (block (snprintf (-> e err) 192 "%s" ($ sub err)) (set ok 0) break))
            (if (== rc 0) break)
            (if (>= n cap)
                (let ((size_t ncap . #'(? (== cap 0) 16 (* cap 2)))
                      (size_t * nb))
                  (set nb (cast (size_t *) (realloc kept (* ncap (sizeof size_t)))))
                  (if (== nb nil)
                      (block (coco_fail_err e "out of memory in findall")
                             (set ok 0) break))
                  (set kept nb)
                  (set cap ncap)))
            ;; into the STORE, because the heap under us is about to be wound
            ;; back past this point
            (set (nth n kept) (coco_store_put st m template))
            (set n (+ n 1)))

          ;; the outer engine's step count includes the inner search: a goal
          ;; that costs a million inferences inside a findall costs them
          (set (-> e steps) (+ (-> e steps) ($ sub steps)))
          (coco_engine_free (aof sub))

          (if (not ok) (block (coco_undo_to m tmark)
                              (set ($ (cof m) heap_len) hmark)
                              (free kept)
                              (return 0)))

          ;; put the machine back as it was, THEN build the answer. The
          ;; solutions are in the store and not on the heap, so truncating here
          ;; costs nothing and reclaims everything the search built.
          (coco_undo_to m tmark)
          (set ($ (cof m) heap_len) hmark)

          ;; back out of the store, in order, and on to the list
          (let ((size_t lst . #'(coco_new_atom m "[]")))
            (for ((size_t i . n)) (> i 0) ((-- i))
              (set lst (coco_cons m (coco_store_get m st (nth (- i 1) kept)) lst)))
            (free kept)
            (set (cof out) lst))
          (return 1))))

  (func coco_engine_ask_text ((coco_engine * e) (const char * text)) (out int)
        (let ((size_t g))
          (if (not (coco_read_term_from (-> e m) text (aof g)))
              (block (snprintf (-> e err) 192 "could not read the goal") (return 0)))
          (coco_engine_ask e g)
          (return 1)))

  (func coco_engine_next ((coco_engine * e)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st)))

          ;; THE MODULES' OWN CLAUSES, IF THEY ARE NOT IN THIS STORE YET. Here
          ;; and not in `coco_engine_ask' because a store can be emptied under a
          ;; running engine -- thawing a machine into it does exactly that --
          ;; and this is the one function every path goes through. The hook's
          ;; own guard makes the usual case two loads and a comparison.
          (if (!= coco_extern_load nil)
              (if (not (coco_extern_load st m e))
                  (return (coco_fail_err e "a module's clauses would not load"))))

          ;; a solution was reported last time; the next one is behind a
          ;; backtrack, not in front of the current continuation
          (if (-> e resume)
              (block (set (-> e resume) 0)
                     (if (not (coco_backtrack e)) (return 0))))

          (while 1
            (set (-> e steps) (+ (-> e steps) 1))
            (if (and (!= (-> e max_steps) 0) (> (-> e steps) (-> e max_steps)))
                (return (coco_fail_err e "inference limit reached")))
            (if (-> e halted) (return 0))

            ;; nothing left to prove: that is a solution
            (if (coco_k_is_empty e (-> e goals))
                (block (set (-> e resume) 1) (return 1)))

            ;; take the first goal off the continuation
            (let ((size_t kf . #'(coco_deref m (-> e goals)))
                  (size_t g) (size_t b) (size_t k) (int ok . 1))
              (set g (coco_deref m (coco_arg m kf 0)))
              (set b (cast size_t (coco-signed-payload (nth (coco_deref m (coco_arg m kf 1)) (-> m heap)))))
              (set k (coco_arg m kf 2))

              (let ((u64 gc . #'(nth g (-> m heap))))
                (if (coco-tag-is REF gc)
                    (return (coco_instantiation_error e)))
                (if (not (coco_is_callable m g))
                    (return (coco_type_error e "callable" g))))

              (let ((const char * name . #'(coco_atom_name m (coco_name_of m g)))
                    (u32 n . #'(coco_arity m g)))
                (cond

                  ;; ---- control constructs ----
                  ((and (== n 0) (== 0 (strcmp name "true")))
                   (set (-> e goals) k))

                  ((and (== n 0) (or (== 0 (strcmp name "fail")) (== 0 (strcmp name "false"))))
                   (set ok 0))

                  ((and (== n 2) (== 0 (strcmp name ",")))
                   (set (-> e goals)
                        (coco_k_push e (coco_arg m g 0) b (coco_k_push e (coco_arg m g 1) b k))))

                  ((and (== n 0) (== 0 (strcmp name "!")))
                   ;; cut: the stack goes back to the barrier this goal carried
                   (if (< b (-> e nchoices)) (set (-> e nchoices) b))
                   (set (-> e goals) k))

                  ((and (== n 1) (== 0 (strcmp name "$cut")))
                   (let ((size_t h . #'(cast size_t (coco-signed-payload
                                                     (nth (coco_deref m (coco_arg m g 0)) (-> m heap))))))
                     (if (< h (-> e nchoices)) (set (-> e nchoices) h)))
                   (set (-> e goals) k))

                  ((and (== n 1) (== 0 (strcmp name "$softcut")))
                   ;; kill the one frame holding the else-branch, and nothing
                   ;; else. Guarded on the kind as well as the height: if the
                   ;; frame at H is no longer the one this soft cut pushed --
                   ;; which a machine thawed mid-proof could arrange -- killing
                   ;; it would take away somebody else's alternative.
                   (let ((size_t h . #'(cast size_t (coco-signed-payload
                                                     (nth (coco_deref m (coco_arg m g 0)) (-> m heap))))))
                     (if (< h (-> e nchoices))
                         (if (== ($ (nth h (-> e choices)) kind) COCO_CH_GOAL)
                             (set ($ (nth h (-> e choices)) kind) COCO_CH_DEAD))))
                   (set (-> e goals) k))

                  ((and (== n 2) (== 0 (strcmp name ";")))
                   (let ((size_t l . #'(coco_deref m (coco_arg m g 0))))
                     ;; (C -> T ; E) is one construct, not a disjunction whose
                     ;; left arm happens to be an implication
                     (if (and (coco_is_callable m l) (== (coco_arity m l) 2))
                         (block
                          (if (== 0 (strcmp (coco_atom_name m (coco_name_of m l)) "->"))
                              (block (coco_ite e (coco_arg m l 0) (coco_arg m l 1) (coco_arg m g 1) k b)
                                     (continue)))
                          ;; `(C *-> T ; E)' is one construct too
                          (if (== 0 (strcmp (coco_atom_name m (coco_name_of m l)) "*->"))
                              (block (coco_soft_ite e (coco_arg m l 0) (coco_arg m l 1)
                                                    (coco_arg m g 1) k b)
                                     (continue)))))
                     (if (not (coco_push_choice e COCO_CH_GOAL (coco_arg m g 1) k b))
                         (return (coco_fail_err e "out of memory")))
                     (set (-> e goals) (coco_k_push e (coco_arg m g 0) b k))))

                  ((and (== n 2) (== 0 (strcmp name "->")))
                   ;; a bare if-then fails when the condition does
                   (coco_ite e (coco_arg m g 0) (coco_arg m g 1) (coco_new_atom m "fail") k b))

                  ((and (== n 2) (== 0 (strcmp name "*->")))
                   ;; a bare soft cut has no else to take away, so it is just
                   ;; `(C, T)' -- but routed through the same construct, so that
                   ;; the cut barrier C runs under is the one it would have had
                   ;; with an else branch present.
                   (coco_soft_ite e (coco_arg m g 0) (coco_arg m g 1)
                                  (coco_new_atom m "fail") k b))

                  ((and (== n 1) (or (== 0 (strcmp name "\\+")) (== 0 (strcmp name "not"))))
                   (coco_ite e (coco_arg m g 0) (coco_new_atom m "fail") (coco_new_atom m "true") k b))

                  ((and (== n 1) (== 0 (strcmp name "call")))
                   ;; call/1 is opaque to cut: the goal runs under a barrier of
                   ;; its own, so a `!' inside it cannot cut the caller
                   (set (-> e goals) (coco_k_push e (coco_arg m g 0) (-> e nchoices) k)))

                  ((and (== n 3) (== 0 (strcmp name "catch")))
                   ;; The catcher and the recovery goal are put on the heap as
                   ;; one term BEFORE the frame is pushed, so that the frame's
                   ;; heap mark is above them and unwinding cannot take them.
                   ;;
                   ;; The goal runs under a barrier of its own, so a `!' inside
                   ;; a `catch' is local to it -- the same rule `call/1'
                   ;; follows, and what stops a cut from removing the very
                   ;; frame that is meant to catch.
                   (let ((size_t cr . #'(coco_make2 m "$catch"
                                                  (coco_arg m g 1) (coco_arg m g 2))))
                     (if (not (coco_push_choice e COCO_CH_CATCH cr k b))
                         (return (coco_fail_err e "out of memory")))
                     (set (-> e goals)
                          (coco_k_push e (coco_arg m g 0) (-> e nchoices) k))))

                  ((and (== n 1) (== 0 (strcmp name "throw")))
                   ;; never fails and never simply succeeds: it either transfers
                   ;; control to a recovery goal or ends the query
                   (if (coco_m_thrown e (coco_arg m g 0)) (block) (return -1)))

                  ((and (> n 1) (== 0 (strcmp name "call")))
                   ;; `call(G, A, B, ...)' -- G with the extra arguments added
                   ;; to the end of it. This is what makes a predicate that
                   ;; takes another predicate possible at all: `max_member/3'
                   ;; in the lists library is `call(Pred, X, Y)' and nothing
                   ;; else, and without this it could not be written.
                   ;;
                   ;; THE CLOSURE MAY ALREADY CARRY ARGUMENTS. `call(plus(1),
                   ;; 2, X)' is `plus(1, 2, X)', so the goal built here is the
                   ;; closure's own arguments followed by the call's -- which
                   ;; is why it is rebuilt rather than the extra ones being
                   ;; pushed onto it.
                   (let ((size_t c . #'(coco_deref m (coco_arg m g 0))))
                     (if (not (coco_is_callable m c))
                         (return (coco_type_error e "callable" c)))
                     (let ((u32 have . #'(coco_arity m c))
                           (u32 extra . #'(- n 1)))
                       (if (> (+ have extra) 255)
                           (return (coco_fail_err e "call/N: too many arguments")))
                       (let ((size_t built)
                             (size_t * args . #'(cast (size_t *)
                                                      (malloc (* (+ have extra)
                                                                 (sizeof size_t))))))
                         (if (== args nil) (return (coco_fail_err e "out of memory")))
                         (for ((u32 i . 0)) (< i have) ((++ i))
                           (set (nth i args) (coco_arg m c i)))
                         (for ((u32 i . 0)) (< i extra) ((++ i))
                           (set (nth (+ have i) args) (coco_arg m g (+ i 1))))
                         (set built (coco_make m (coco_atom_name m (coco_name_of m c))
                                             (+ have extra) args))
                         (free args)
                         ;; opaque to cut, exactly as call/1 is
                         (set (-> e goals) (coco_k_push e built (-> e nchoices) k)))))) 

                  (#t
                   ;; ---- a builtin, or a predicate ----
                   (let ((int found . 0) (int rc . 0))
                     (set rc (coco_builtin e name n g (aof found)))
                     ;; not a core builtin: a module may still own it
                     (if (and (not found) (!= coco_extern_call nil))
                         (set rc (coco_extern_call e name n g (aof found))))
                     (if found
                         (block
                          (if (== rc -1) (return -1))
                          ;; 2 MEANS THE BUILTIN SET THE CONTINUATION ITSELF,
                          ;; which is what a builtin that threw and was caught
                          ;; has done: `coco_throw' has already pointed the
                          ;; engine at the recovery goal, and putting `k' back
                          ;; here would throw that away and carry on as if
                          ;; nothing had been raised.
                          (cond ((== rc 2) (block))
                                ((== rc 1) (set (-> e goals) k))
                                (#t (set ok 0))))
                       ;; nobody's builtin: the knowledge base decides
                       (let ((size_t pi . #'(coco_pred_of st m g)))
                         (cond
                          ((>= pi ($ (cof st) npreds))
                           ;; A RAISE FROM INSIDE THE LOOP IS NOT A `return'.
                           ;; `coco_raise' answers 2 when a catcher took the ball
                           ;; and the continuation already points at the recovery
                           ;; goal -- so the loop carries on. Returning that 2
                           ;; would leave this function answering something every
                           ;; caller reads as success.
                           (if (!= 2 (coco_type_error e "callable" g)) (return -1)))
                          (#t
                           (coco_pred_ensure st pi)
                           (cond
                            ((> ($ (nth pi ($ (cof st) preds)) nclauses) 0)
                             (block
                              (if (not (coco_push_choice e COCO_CH_CLAUSE g k b))
                                  (return (coco_fail_err e "out of memory")))
                              (let ((size_t ci . #'(- (-> e nchoices) 1)))
                                (set ($ (nth ci (-> e choices)) pred) pi)
                                (set ($ (nth ci (-> e choices)) clause_ix) 0)
                                (if (not (coco_select_clause e ci)) (set ok 0)))))
                            ;; NO CLAUSES IS NOT THE SAME AS UNDEFINED. A
                            ;; predicate the program declared dynamic -- or that
                            ;; an `assert' brought into being and a `retract'
                            ;; emptied again -- exists and simply has nothing to
                            ;; prove, so it fails. One nobody ever defined is a
                            ;; different thing, and the libraries these clauses
                            ;; came from are written expecting it to raise.
                            (($ (nth pi ($ (cof st) preds)) dynamic) (set ok 0))
                            (#t
                             (if (!= 2 (coco_existence_error e "procedure" name n))
                                 (return -1))))))))))))

              (if (not ok)
                  (if (not (coco_backtrack e)) (return 0)))))
          (return 0)))

  ;;;; ----------------------------------------------------------------
  ;;;; Builtins
  ;;;; ----------------------------------------------------------------
  ;;; Each takes the engine and the goal, and answers 1 for success, 0 for
  ;;; failure, -1 for an error with `e->err' filled in. None of them makes a
  ;;; choice point, so none of them can succeed twice -- see the head of this
  ;;; file for why that is a rule and not an accident.

  (static) (func coco_a ((coco_engine * e) (size_t g) (u32 i)) (out size_t)
                 (return (coco_deref (-> e m) (coco_arg (-> e m) g i))))

  ;;; ---- unification and comparison ----

  (func coco_bi_unify ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco_unify (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1)) 1 0)))

  ;;; `\=' must leave nothing behind: it unifies to find out, then unbinds
  ;;; whatever that did. The trail mark is the whole implementation.
  (func coco_bi_not_unify ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t tmark . #'($ (cof (-> e m)) trail_len))
              (int r))
          (set r (coco_unify m (coco_arg m g 0) (coco_arg m g 1)))
          (coco_undo_to m tmark)
          (return (? r 0 1))))

  (func coco_bi_eq  ((coco_engine * e) (size_t g)) (out int)
        (return (? (== 0 (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1))) 1 0)))
  (func coco_bi_neq ((coco_engine * e) (size_t g)) (out int)
        (return (? (!= 0 (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1))) 1 0)))
  (func coco_bi_lt  ((coco_engine * e) (size_t g)) (out int)
        (return (? (<  (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1)) 0) 1 0)))
  (func coco_bi_gt  ((coco_engine * e) (size_t g)) (out int)
        (return (? (>  (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1)) 0) 1 0)))
  (func coco_bi_le  ((coco_engine * e) (size_t g)) (out int)
        (return (? (<= (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1)) 0) 1 0)))
  (func coco_bi_ge  ((coco_engine * e) (size_t g)) (out int)
        (return (? (>= (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1)) 0) 1 0)))

  (func coco_bi_compare ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (int c . #'(coco_compare (-> e m) (coco_arg (-> e m) g 1) (coco_arg (-> e m) g 2)))
              (const char * s))
          (set s (? (< c 0) "<" (? (> c 0) ">" "=")))
          (return (? (coco_unify m (coco_arg m g 0) (coco_new_atom m s)) 1 0))))

  ;;; ---- type tests ----

  (func coco_bi_var ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is REF (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 1 0)))
  (func coco_bi_nonvar ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is REF (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 0 1)))
  (func coco_bi_atom ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is ATOM (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 1 0)))
  (func coco_bi_integer ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is INT (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 1 0)))
  (func coco_bi_float ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is FLT (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 1 0)))
  (func coco_bi_number ((coco_engine * e) (size_t g)) (out int)
        (let ((u64 c . #'(nth (coco_a e g 0) ($ (cof (-> e m)) heap))))
          (return (? (or (coco-tag-is INT c) (coco-tag-is FLT c)) 1 0))))
  (func coco_bi_compound ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is FUN (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 1 0)))
  (func coco_bi_atomic ((coco_engine * e) (size_t g)) (out int)
        (let ((u64 c . #'(nth (coco_a e g 0) ($ (cof (-> e m)) heap))))
          (return (? (or (coco-tag-is REF c) (coco-tag-is FUN c)) 0 1))))
  (func coco_bi_callable ((coco_engine * e) (size_t g)) (out int)
        (return (coco_is_callable (-> e m) (coco_a e g 0))))

  ;;; A proper list and nothing else: a partial list `[a|X]' is not one, and
  ;;; neither is a cyclic term -- which is what the step limit is for.
  (func coco_bi_is_list ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0))
              (u64 guard . 0))
          (while 1
            (set t (coco_deref m t))
            (let ((u64 c . #'(nth t (-> m heap))))
              (if (coco-tag-is ATOM c)
                  (return (? (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) "[]")) 1 0)))
              (if (not (coco-tag-is FUN c)) (return 0))
              (if (!= (coco_arity m t) 2) (return 0))
              (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m t)) ".")) (return 0))
              (set t (coco_arg m t 1))
              (set guard (+ guard 1))
              (if (> guard 10000000) (return 0))))
          (return 0)))

  ;;; ---- arithmetic ----

  ;;; The names this expands under are bound by the parameter list below: that
  ;;; is the contract `coco-emit-arith-binops' documents.
  (static)
  (func coco_arith_simple ((const char * name) (int both_int)
                         (i64 ai) (double af) (i64 bi) (double bf)
                         (int * isf) (i64 * iv) (double * fv)) (out int)
        (coco-emit-arith-binops))

  (static)
  (func coco_arith_binary ((coco_engine * e) (const char * name) (int both_int)
                         (i64 ai) (double af) (i64 bi) (double bf)
                         (int * isf) (i64 * iv) (double * fv)) (out int)
        (if (coco_arith_simple name both_int ai af bi bf isf iv fv) (return 1))
        (cond
          ;; `/' answers an integer when it divides exactly and a float when it
          ;; does not, which is what most Prologs do and what surprises fewest
          ;; people; `//' is always integer division.
          ((== 0 (strcmp name "/"))
           (if both_int
               (block (if (== bi 0) (return (coco_evaluation_error e "zero_divisor")))
                      (if (== 0 (% ai bi))
                          (block (set (cof iv) (/ ai bi)) (set (cof isf) 0))
                        (block (set (cof fv) (/ (cast double ai) (cast double bi)))
                               (set (cof isf) 1))))
             (block (set (cof fv) (/ af bf)) (set (cof isf) 1)))
           (return 1))
          ((== 0 (strcmp name "//"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (if (== bi 0) (return (coco_evaluation_error e "zero_divisor")))
           (set (cof iv) (/ ai bi)) (set (cof isf) 0) (return 1))
          ((== 0 (strcmp name "mod"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (if (== bi 0) (return (coco_evaluation_error e "zero_divisor")))
           ;; mod follows the sign of the divisor, rem follows the dividend
           (set (cof iv) (- (% ai bi) (? (and (!= (% ai bi) 0)
                                              (< (* (% ai bi) bi) 0)) (- 0 bi) 0)))
           (set (cof isf) 0) (return 1))
          ((== 0 (strcmp name "rem"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (if (== bi 0) (return (coco_evaluation_error e "zero_divisor")))
           (set (cof iv) (% ai bi)) (set (cof isf) 0) (return 1))
          ((== 0 (strcmp name "min"))
           (if both_int (block (set (cof iv) (? (< ai bi) ai bi)) (set (cof isf) 0))
             (block (set (cof fv) (? (< af bf) af bf)) (set (cof isf) 1)))
           (return 1))
          ((== 0 (strcmp name "max"))
           (if both_int (block (set (cof iv) (? (> ai bi) ai bi)) (set (cof isf) 0))
             (block (set (cof fv) (? (> af bf) af bf)) (set (cof isf) 1)))
           (return 1))
          ((== 0 (strcmp name "**"))
           (set (cof fv) (pow af bf)) (set (cof isf) 1) (return 1))
          ((== 0 (strcmp name ">>"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (set (cof iv) (>> ai bi)) (set (cof isf) 0) (return 1))
          ((== 0 (strcmp name "<<"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (set (cof iv) (<< ai bi)) (set (cof isf) 0) (return 1))
          (#t (return (coco_fail_err e "unknown arithmetic function")))))

  ;;; Evaluates an arithmetic expression. Recursive over the DEPTH of the
  ;;; expression, which is bounded by the text that was read -- unlike the
  ;;; resolution loop, this cannot be suspended half way and does not need to
  ;;; be.
  (static) (decl) (func coco_arith ((coco_engine * e) (size_t t)
                                  (int * isf) (i64 * iv) (double * fv)) (out int))

  (func coco_arith ((coco_engine * e) (size_t t) (int * isf) (i64 * iv) (double * fv)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (set t (coco_deref m t))
          (let ((u64 c . #'(nth t (-> m heap))))
            (cond
              ((coco-tag-is REF c) (return (coco_instantiation_error e)))
              ((coco-tag-is INT c) (set (cof iv) (coco-signed-payload c)) (set (cof isf) 0) (return 1))
              ((coco-tag-is FLT c)
               (set (cof fv) (nth (cast size_t (coco-payload c)) (-> m floats)))
               (set (cof isf) 1) (return 1))
              ((coco-tag-is ATOM c)
               (let ((const char * nm . #'(coco_atom_name m (coco_name_of m t))))
                 (if (== 0 (strcmp nm "pi"))
                     (block (set (cof fv) 3.14159265358979323846) (set (cof isf) 1) (return 1)))
                 (if (== 0 (strcmp nm "e"))
                     (block (set (cof fv) 2.71828182845904523536) (set (cof isf) 1) (return 1)))
                 (return (coco_type_error e "evaluable" t))))
              (#t
               (let ((const char * nm . #'(coco_atom_name m (coco_name_of m t)))
                     (u32 n . #'(coco_arity m t)))
                 (if (== n 1)
                     (let ((int s0) (i64 i0) (double f0) (int rc))
                       (set rc (coco_arith e (coco_arg m t 0) (aof s0) (aof i0) (aof f0)))
                       (if (!= rc 1) (return rc))
                       (cond
                         ((== 0 (strcmp nm "-"))
                          (if s0 (block (set (cof fv) (- 0.0 f0)) (set (cof isf) 1))
                            (block (set (cof iv) (- 0 i0)) (set (cof isf) 0)))
                          (return 1))
                         ((== 0 (strcmp nm "+"))
                          (if s0 (block (set (cof fv) f0) (set (cof isf) 1))
                            (block (set (cof iv) i0) (set (cof isf) 0)))
                          (return 1))
                         ((== 0 (strcmp nm "abs"))
                          (if s0 (block (set (cof fv) (fabs f0)) (set (cof isf) 1))
                            (block (set (cof iv) (? (< i0 0) (- 0 i0) i0)) (set (cof isf) 0)))
                          (return 1))
                         ((== 0 (strcmp nm "sign"))
                          (if s0 (block (set (cof fv) (? (> f0 0.0) 1.0 (? (< f0 0.0) -1.0 0.0)))
                                        (set (cof isf) 1))
                            (block (set (cof iv) (? (> i0 0) 1 (? (< i0 0) -1 0))) (set (cof isf) 0)))
                          (return 1))
                         ((== 0 (strcmp nm "float"))
                          (set (cof fv) (? s0 f0 (cast double i0))) (set (cof isf) 1) (return 1))
                         ((== 0 (strcmp nm "integer"))
                          (set (cof iv) (? s0 (cast i64 (llround f0)) i0)) (set (cof isf) 0) (return 1))
                         ((== 0 (strcmp nm "truncate"))
                          (set (cof iv) (? s0 (cast i64 f0) i0)) (set (cof isf) 0) (return 1))
                         ((== 0 (strcmp nm "sqrt"))
                          (set (cof fv) (sqrt (? s0 f0 (cast double i0)))) (set (cof isf) 1) (return 1))
                         (#t (return (coco_fail_err e "unknown arithmetic function")))))
                   (if (== n 2)
                       (let ((int s0) (i64 i0) (double f0) (int s1) (i64 i1) (double f1)
                             (int rc) (int both))
                         (set rc (coco_arith e (coco_arg m t 0) (aof s0) (aof i0) (aof f0)))
                         (if (!= rc 1) (return rc))
                         (set rc (coco_arith e (coco_arg m t 1) (aof s1) (aof i1) (aof f1)))
                         (if (!= rc 1) (return rc))
                         (set both (? (and (== s0 0) (== s1 0)) 1 0))
                         ;; each operand is offered as both, and `both' says
                         ;; which pair the operator should read
                         (return (coco_arith_binary e nm both
                                                  i0 (? s0 f0 (cast double i0))
                                                  i1 (? s1 f1 (cast double i1))
                                                  isf iv fv)))
                     (return (coco_fail_err e "unknown arithmetic function"))))))))
          (return 0)))

  (func coco_bi_is ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (int isf) (i64 iv) (double fv) (int rc))
          (set rc (coco_arith e (coco_arg m g 1) (aof isf) (aof iv) (aof fv)))
          (if (!= rc 1) (return rc))
          (let ((size_t r . #'(? isf (coco_new_float m fv) (coco_new_int m iv))))
            (return (? (coco_unify m (coco_arg m g 0) r) 1 0)))))

  ;;; The six numeric comparisons. Both sides are evaluated, then compared as
  ;;; doubles unless both stayed integers -- so 1 =:= 1.0 is true, as it must
  ;;; be, while 1 == 1.0 is false, as it also must be.
  (static)
  (func coco_num_cmp ((coco_engine * e) (size_t g) (int * out_c)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (int s0) (i64 i0) (double f0) (int s1) (i64 i1) (double f1) (int rc))
          (set rc (coco_arith e (coco_arg m g 0) (aof s0) (aof i0) (aof f0)))
          (if (!= rc 1) (return rc))
          (set rc (coco_arith e (coco_arg m g 1) (aof s1) (aof i1) (aof f1)))
          (if (!= rc 1) (return rc))
          (if (and (== s0 0) (== s1 0))
              (set (cof out_c) (? (< i0 i1) -1 (? (> i0 i1) 1 0)))
            (let ((double a . #'(? s0 f0 (cast double i0)))
                  (double b . #'(? s1 f1 (cast double i1))))
              (set (cof out_c) (? (< a b) -1 (? (> a b) 1 0)))))
          (return 1)))

  (func coco_bi_num_eq  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (== c 0) 1 0))))
  (func coco_bi_num_neq ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (!= c 0) 1 0))))
  (func coco_bi_num_lt  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (< c 0) 1 0))))
  (func coco_bi_num_gt  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (> c 0) 1 0))))
  (func coco_bi_num_le  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (<= c 0) 1 0))))
  (func coco_bi_num_ge  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (>= c 0) 1 0))))

  ;;; ---- term construction and inspection ----

  (func coco_bi_functor ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0)))
          (let ((u64 c . #'(nth t (-> m heap))))
            (if (not (coco-tag-is REF c))
                ;; taking a term apart
                (let ((size_t nm) (size_t ar))
                  (if (coco-tag-is FUN c)
                      (block (set nm (coco_new_atom m (coco_atom_name m (coco_name_of m t))))
                             (set ar (coco_new_int m (cast i64 (coco_arity m t)))))
                    (block (set nm (coco_push m c))
                           (set ar (coco_new_int m 0))))
                  (if (not (coco_unify m (coco_arg m g 1) nm)) (return 0))
                  (return (? (coco_unify m (coco_arg m g 2) ar) 1 0)))))
          ;; building one: name and arity must both be given
          (let ((size_t nt . #'(coco_a e g 1))
                (size_t at . #'(coco_a e g 2)))
            (if (not (coco-tag-is INT (nth at (-> m heap))))
                (return (coco_instantiation_error e)))
            (let ((i64 n . #'(coco-signed-payload (nth at (-> m heap)))))
              (if (< n 0) (return (coco_fail_err e "functor/3 wants an arity of 0 or more")))
              (if (== n 0) (return (? (coco_unify m (coco_arg m g 0) nt) 1 0)))
              (if (not (coco-tag-is ATOM (nth nt (-> m heap))))
                  (return (coco_type_error e "atomic" (coco_a e g 1))))
              (let ((size_t h . #'(coco_open_struct m (coco_atom_name m (coco_name_of m nt))
                                                 (cast u32 n))))
                (for ((i64 i . 0)) (< i n) ((++ i)) (coco_new_var m))
                (return (? (coco_unify m (coco_arg m g 0) h) 1 0)))))))

  (func coco_bi_arg ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t it . #'(coco_a e g 0))
              (size_t t . #'(coco_a e g 1)))
          (if (not (coco-tag-is INT (nth it (-> m heap))))
              (return (coco_instantiation_error e)))
          (if (not (coco-tag-is FUN (nth t (-> m heap)))) (return 0))
          (let ((i64 i . #'(coco-signed-payload (nth it (-> m heap))))
                (u32 n . #'(coco_arity m t)))
            (if (or (< i 1) (> i (cast i64 n))) (return 0))
            (return (? (coco_unify m (coco_arg m g 2) (coco_arg m t (cast u32 (- i 1)))) 1 0)))))

  ;;; `=..' both ways. Taking apart is a walk; building needs the list to be
  ;;; proper, which is checked as it is walked rather than beforehand.
  (func coco_bi_univ ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0)))
          (let ((u64 c . #'(nth t (-> m heap))))
            (if (not (coco-tag-is REF c))
                (let ((size_t lst . #'(coco_new_atom m "[]")))
                  (if (coco-tag-is FUN c)
                      (block (let ((u32 n . #'(coco_arity m t)) (u32 i))
                               (set i n)
                               (while (> i 0)
                                 (set i (- i 1))
                                 (set lst (coco_cons m (coco_arg m t i) lst))))
                             (set lst (coco_cons m (coco_new_atom m (coco_atom_name m (coco_name_of m t))) lst)))
                    (set lst (coco_cons m (coco_push m c) lst)))
                  (return (? (coco_unify m (coco_arg m g 1) lst) 1 0)))))
          ;; building from a list
          (let ((size_t lst . #'(coco_a e g 1))
                (size_t * items . nil) (size_t n . 0) (size_t cap . 0) (int ok . 1))
            (while 1
              (set lst (coco_deref m lst))
              (let ((u64 c . #'(nth lst (-> m heap))))
                (if (coco-tag-is ATOM c)
                    (block (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m lst)) "[]"))
                               (set ok 0))
                           break))
                (if (not (coco-tag-is FUN c)) (block (set ok 0) break))
                (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m lst)) ".")) (block (set ok 0) break))
                (if (>= n cap)
                    (let ((size_t ncap . #'(? (== cap 0) 8 (* cap 2))))
                      (set items (cast (size_t *) (realloc items (* ncap (sizeof size_t)))))
                      (if (== items nil) (block (set ok 0) break))
                      (set cap ncap)))
                (set (nth n items) (coco_arg m lst 0))
                (set n (+ n 1))
                (set lst (coco_arg m lst 1))))
            (if (or (not ok) (== n 0))
                (block (free items) (return (coco_fail_err e "=.. wants a proper non-empty list"))))
            (let ((size_t hd . #'(coco_deref m (nth 0 items))) (size_t built))
              (if (== n 1)
                  (set built (coco_push m (nth hd (-> m heap))))
                (block
                 (if (not (coco-tag-is ATOM (nth hd (-> m heap))))
                     (block (free items) (return (coco_fail_err e "=.. wants an atom at the head"))))
                 (set built (coco_make m (coco_atom_name m (coco_name_of m hd)) (cast u32 (- n 1))
                                     (+ items 1)))))
              (free items)
              (return (? (coco_unify m (coco_arg m g 0) built) 1 0))))))

  (func coco_bi_copy_term ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t c . #'(coco_copy (-> e m) (coco_arg (-> e m) g 0))))
          (return (? (coco_unify m (coco_arg m g 1) c) 1 0))))

  ;;; ---- atoms and text ----

  ;;; The printed form of a term, into B. Used by the atom builtins, which are
  ;;; all "write it, then do something with the characters".
  (static)
  (func coco_text_of ((coco_engine * e) (size_t t) (coco_strbuf * b)) (out int)
        (coco_sb_init b)
        (return (coco_write_term (-> e m) b t 0 0)))

  (func coco_bi_atom_length ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0))
              (coco_strbuf b) (int r))
          (if (coco-tag-is REF (nth t (-> m heap)))
              (return (coco_instantiation_error e)))
          (coco_text_of e t (aof b))
          (set r (coco_unify m (coco_arg m g 1) (coco_new_int m (cast i64 ($ b len)))))
          (coco_sb_free (aof b))
          (return (? r 1 0))))

  (static)
  (func coco_codes_of ((coco_engine * e) (const char * s) (size_t n)) (out size_t)
        (let ((coco_machine * m . #'(-> e m))
              (size_t lst . #'(coco_new_atom (-> e m) "[]")))
          (while (> n 0)
            (set n (- n 1))
            (set lst (coco_cons m (coco_new_int m (cast i64 (cast uchar (nth n s)))) lst)))
          (return lst)))

  ;;; Collects a code list into B. Answers 0 if it is not a proper list of
  ;;; character codes.
  (static)
  (func coco_codes_to_text ((coco_engine * e) (size_t lst) (coco_strbuf * b)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (coco_sb_init b)
          (while 1
            (set lst (coco_deref m lst))
            (let ((u64 c . #'(nth lst (-> m heap))))
              (if (coco-tag-is ATOM c)
                  (return (? (== 0 (strcmp (coco_atom_name m (coco_name_of m lst)) "[]")) 1 0)))
              (if (not (coco-tag-is FUN c)) (return 0))
              (if (!= (coco_arity m lst) 2) (return 0))
              (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m lst)) ".")) (return 0))
              (let ((size_t h . #'(coco_deref m (coco_arg m lst 0))))
                (if (not (coco-tag-is INT (nth h (-> m heap)))) (return 0))
                (coco_sb_putc b (cast char (coco-signed-payload (nth h (-> m heap))))))
              (set lst (coco_arg m lst 1))))
          (return 0)))

  (func coco_bi_atom_codes ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0)))
          (if (not (coco-tag-is REF (nth t (-> m heap))))
              (let ((coco_strbuf b) (int r))
                (coco_text_of e t (aof b))
                (set r (coco_unify m (coco_arg m g 1) (coco_codes_of e ($ b s) ($ b len))))
                (coco_sb_free (aof b))
                (return (? r 1 0))))
          (let ((coco_strbuf b) (int r))
            (if (not (coco_codes_to_text e (coco_arg m g 1) (aof b)))
                (block (coco_sb_free (aof b))
                       (return (coco_instantiation_error e))))
            (set r (coco_unify m (coco_arg m g 0)
                             (coco_new_atom m (? (== ($ b s) nil) "" ($ b s)))))
            (coco_sb_free (aof b))
            (return (? r 1 0)))))

  (func coco_bi_number_codes ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0)))
          (if (not (coco-tag-is REF (nth t (-> m heap))))
              (let ((coco_strbuf b) (int r))
                (coco_text_of e t (aof b))
                (set r (coco_unify m (coco_arg m g 1) (coco_codes_of e ($ b s) ($ b len))))
                (coco_sb_free (aof b))
                (return (? r 1 0))))
          (let ((coco_strbuf b) (size_t num) (int r))
            (if (not (coco_codes_to_text e (coco_arg m g 1) (aof b)))
                (block (coco_sb_free (aof b))
                       (return (coco_instantiation_error e))))
            ;; the reader is what decides what a number looks like, so it is
            ;; the reader that reads it back -- there is no second parser here
            (if (not (coco_read_term_from m (? (== ($ b s) nil) "" ($ b s)) (aof num)))
                (block (coco_sb_free (aof b)) (return 0)))
            (coco_sb_free (aof b))
            (let ((u64 c . #'(nth (coco_deref m num) (-> m heap))))
              (if (not (or (coco-tag-is INT c) (coco-tag-is FLT c))) (return 0)))
            (set r (coco_unify m (coco_arg m g 0) num))
            (return (? r 1 0)))))

  (func coco_bi_atom_concat ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t a . #'(coco_a e g 0))
              (size_t b . #'(coco_a e g 1)))
          (if (or (coco-tag-is REF (nth a (-> m heap))) (coco-tag-is REF (nth b (-> m heap))))
              (return (coco_instantiation_error e)))
          (let ((coco_strbuf ab) (coco_strbuf bb) (int r))
            (coco_text_of e a (aof ab))
            (coco_text_of e b (aof bb))
            (if (!= ($ bb s) nil) (coco_sb_put (aof ab) ($ bb s)))
            (set r (coco_unify m (coco_arg m g 2)
                             (coco_new_atom m (? (== ($ ab s) nil) "" ($ ab s)))))
            (coco_sb_free (aof ab))
            (coco_sb_free (aof bb))
            (return (? r 1 0)))))

  ;;; ---- output ----

  (func coco_bi_write ((coco_engine * e) (size_t g)) (out int)
        (coco_print_term (-> e m) stdout (coco_arg (-> e m) g 0))
        (return 1))

  (func coco_bi_writeln ((coco_engine * e) (size_t g)) (out int)
        (coco_print_term (-> e m) stdout (coco_arg (-> e m) g 0))
        (fputc 10 stdout)
        (return 1))

  (func coco_bi_write_canonical ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_canonical (-> e m) (aof b) (coco_arg (-> e m) g 0))
          (if (!= ($ b s) nil) (fputs ($ b s) stdout))
          (coco_sb_free (aof b))
          (return 1)))

  (func coco_bi_nl ((coco_engine * e) (size_t g)) (out int)
        (fputc 10 stdout)
        (return 1))

  ;;; ---- the database ----

  ;;; ASSERTING INTO A PREDICATE IS WHAT MAKES IT DYNAMIC, which is SWI's rule
  ;;; and the one that makes `existence_error' safe to raise at all. Without it,
  ;;; asserting a fact and retracting it again would leave a predicate that is
  ;;; neither defined nor declared, and the next call to it would raise where
  ;;; every other Prolog quietly fails.
  ;;;
  ;;; Only the GOAL marks. `coco_consult' asserts through the same function, and
  ;;; marking there would make every consulted predicate dynamic and put a
  ;;; `:- dynamic' line above all of them in `listing'.
  (static)
  (func coco_assert_goal ((coco_engine * e) (size_t g) (int at_end)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t c . #'(coco_deref m (coco_arg m g 0)))
              (size_t head))
          (set head c)
          ;; a rule marks the predicate its HEAD names, not `:-'/2
          (if (and (coco_is_callable m c) (== (coco_arity m c) 2))
              (if (== 0 (strcmp (coco_atom_name m (coco_name_of m c)) ":-"))
                  (set head (coco_deref m (coco_arg m c 0)))))
          (if (not (coco_assert (-> e st) m c at_end)) (return 0))
          (if (coco_is_callable m head)
              (coco_pred_dynamic (-> e st) (coco_name_of m head) (coco_arity m head)))
          (return 1)))

  (func coco_bi_asserta ((coco_engine * e) (size_t g)) (out int)
        (return (coco_assert_goal e g 0)))

  (func coco_bi_assertz ((coco_engine * e) (size_t g)) (out int)
        (return (coco_assert_goal e g 1)))

  (func coco_bi_retract ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco_retract (-> e st) (-> e m) (coco_arg (-> e m) g 0)) 1 0)))

  ;;; `dynamic(Spec)' as a goal, which is the same thing `:- dynamic Spec.'
  ;;; does when a file is consulted -- one implementation, reached two ways.
  (func coco_bi_dynamic ((coco_engine * e) (size_t g)) (out int)
        (let ((char err [192]))
          (if (not (coco_dynamic_spec (-> e st) (-> e m) (coco_arg (-> e m) g 0)
                                    err (sizeof err)))
              (return (coco_fail_err e err)))
          (return 1)))

  ;;; ---- listing ------------------------------------------------------------

  ;;; One predicate, written so that it reads back. A `:- dynamic' line first if
  ;;; it is one, then a clause per line, then a blank line.
  ;;;
  ;;; IT ASKS THE BACKEND FIRST. A predicate whose clauses are still in the
  ;;; database has an empty list here until somebody calls it, and a `listing'
  ;;; that showed nothing for a predicate that plainly has clauses would be
  ;;; worse than no listing at all.
  ;;; Answers whether it printed anything: a predicate that is neither declared
  ;;; nor has any clauses is one this store merely has a name for -- interned by
  ;;; a call that failed, or left behind by retracting the last clause of
  ;;; something never declared -- and listing a blank line for it says nothing.
  (static)
  (func coco_listing_pred ((coco_engine * e) (size_t pi)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (coco_strbuf b))
          (coco_pred_ensure st pi)
          (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
                (const char * nm . #'(coco_atom_name m ($ (nth pi (-> st preds)) name)))
                (int dyn . #'($ (nth pi (-> st preds)) dynamic)))

            (if (and (not dyn) (== (-> p nclauses) 0)) (return 0))

            (if dyn
                (printf ":- dynamic %s/%u.\n\n" nm
                        (cast unsigned ($ (nth pi (-> st preds)) arity))))

            (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
              (let ((size_t mark . #'(-> m heap_len))
                    (size_t t . #'(coco_store_get m st (nth i (-> p clauses)))))
                (coco_sb_init (aof b))
                ;; quoted, so an atom that needs them gets them and the line can
                ;; be pasted back into a file
                (coco_write_term m (aof b) t 1 0)
                (if (!= ($ b s) nil) (fputs ($ b s) stdout))
                (fputs ".\n" stdout)
                (coco_sb_free (aof b))
                ;; the clause was copied on to the heap only to be written
                (set (-> m heap_len) mark)))
            ;; the blank line separates predicates. A declared predicate with no
            ;; clauses has already had one after its `:- dynamic' line.
            (if (or (> (-> p nclauses) 0) (not dyn)) (fputs "\n" stdout))
            (return 1))))

  ;;; `listing' with no argument is the PROGRAM, not everything reachable. A
  ;;; module's clauses are in the same store -- that is what makes them
  ;;; callable -- but a person asking what they have written does not want the
  ;;; Files library back, any more than SWI's `listing' hands back library(lists).
  ;;; `listing(Name)' still shows them: asking for one by name is asking about
  ;;; that one specifically.
  (func coco_bi_listing_all ((coco_engine * e) (size_t g)) (out int)
        (coco_store_warm (-> e st))
        ;; `npreds' is read each time round rather than once: `coco_pred_ensure'
        ;; inside the listing can intern predicates the clauses it fetches
        ;; mention, and the loop should reach those too.
        (for ((size_t i . 0)) (< i ($ (cof (-> e st)) npreds)) ((++ i))
          (if (not ($ (nth i ($ (cof (-> e st)) preds)) library))
              (coco_listing_pred e i)))
        (return 1))

  ;;; `listing(Name)' lists every arity of that name; `listing(Name/Arity)' the
  ;;; one. Both are what other Prologs do, and a program that knows only the
  ;;; name of what it asserted should not have to count its arguments.
  (func coco_bi_listing ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t spec . #'(coco_a e g 0))
              (int shown . 0))

          ;; ASKED BEFORE ANYTHING IS DECIDED, for either shape of argument.
          ;; What the backend holds is not only which predicates there are but
          ;; which of them were DECLARED, and a `listing(counter/1)' that found
          ;; the clauses and missed the `:- dynamic' line would be quietly
          ;; wrong in a way that reads back as a different program.
          (coco_store_warm st)

          (if (coco_is_compound2 m spec "/")
              (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
                    (size_t ar . #'(coco_deref m (coco_arg m spec 1))))
                (if (not (coco-tag-is ATOM (nth nm (-> m heap))))
                    (return (coco_fail_err e "listing/1 needs a name")))
                (if (not (coco-tag-is INT (nth ar (-> m heap))))
                    (return (coco_fail_err e "listing/1 needs an arity")))
                ;; interned rather than merely looked up: a predicate this
                ;; interpreter has not called yet is not in the store, and
                ;; `listing' of it should say what the knowledge base holds
                ;; rather than what this process happens to have reached.
                (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m nm)
                                                     (cast u32 (coco-signed-payload
                                                                (nth ar (-> m heap)))))))
                  (if (>= pi (-> st npreds)) (return 0))
                  (return (coco_listing_pred e pi)))))

          (if (not (coco-tag-is ATOM (nth spec (-> m heap))))
              (return (coco_fail_err e "listing/1 needs a name or Name/Arity")))

          ;; By name: every arity of it. The store has no index from a name to
          ;; its arities, so this is a walk -- over what warming put there.
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (if (== ($ (nth i (-> st preds)) name) (coco_name_of m spec))
                (if (coco_listing_pred e i) (set shown 1))))
          (return shown)))

  (func coco_bi_halt ((coco_engine * e) (size_t g)) (out int)
        (set (-> e halted) 1)
        (return 1))

  (func coco_choice_restore ((coco_engine * e) (int kind) (size_t goals)
                           (size_t trail_mark) (size_t heap_mark) (size_t call)
                           (size_t clause_ix) (size_t barrier)
                           (const char * pred_name) (u32 pred_arity)) (out int)
        (if (not (coco_eng_grow e (+ (-> e nchoices) 1))) (return 0))
        (let ((coco_choice * c . #'(aof (nth (-> e nchoices) (-> e choices)))))
          (memset c 0 (sizeof coco_choice))
          (set (-> c kind) kind)
          (set (-> c goals) goals)
          (set (-> c trail_mark) trail_mark)
          (set (-> c heap_mark) heap_mark)
          (set (-> c call) call)
          (set (-> c clause_ix) clause_ix)
          (set (-> c barrier) barrier)
          (if (== kind COCO_CH_CLAUSE)
              (let ((size_t pi . #'(coco_pred_intern (-> e st)
                                                   (coco_intern (-> e m) pred_name)
                                                   pred_arity)))
                (if (>= pi ($ (cof (-> e st)) npreds)) (return 0))
                ;; ask the backend for this predicate NOW rather than when the
                ;; frame is next tried: `clause_ix' is a position in its clause
                ;; list, and a list that has not been fetched yet is empty
                (coco_pred_ensure (-> e st) pi)
                (set (-> c pred) pi)))
          (set (-> e nchoices) (+ (-> e nchoices) 1))
          (return 1)))

  ;;; The dispatcher comes last because it names every builtin above it, and a
  ;;; call needs the definition to have been seen.
  (coco-emit-builtin-dispatch)

  ) ; impl-solve

;;;; cocolog -- the resolution engine
;;;
;;; NOTHING HERE RECURSES IN C, and that is the whole point of the file. A
;;; Prolog interpreter is naturally written as a recursive solve() that calls
;;; itself for each subgoal and uses the C stack as its continuation -- it is
;;; half the length that way. But a machine whose continuation is the C stack
;;; cannot be stopped and written to a database, because the C stack is not
;;; data. cocolog exists to be suspended and resumed, so the continuation is a
;;; term on the heap and the choice points are an array of integers, and the
;;; engine is a loop over them.
;;;
;;; What that buys is in state.cicili: freezing a machine is writing out four
;;; arrays, and thawing one is reading them back. There is no other way to get
;;; that, and every other design decision here follows from it.
;;;
;;; THE CONTINUATION. `'$k'(Goal, Barrier, Rest)', with the atom `[]' at the
;;; end. Barrier is the choice-stack height that a `!' in Goal cuts back to --
;;; carried per goal rather than kept in a register, because a suspended
;;; machine has to remember the barrier of every pending goal, not just the
;;; current one.
;;;
;;; THE CHOICE POINT. Two kinds, and no more:
;;;
;;;   CLAUSE  more clauses of a predicate remain to be tried. Holds which
;;;           predicate and which clause is next.
;;;   GOAL    an alternative goal to run instead -- the right arm of `;', the
;;;           `true' of a negation. Holds the goal.
;;;
;;; Both record the trail and heap heights at the moment they were made, and
;;; backtracking winds both back. Truncating the heap is what reclaims the
;;; terms a failed branch built; it is safe because everything the choice point
;;; needs to resume -- its continuation, its goal -- was built BEFORE the mark.
;;;
;;; CUT IS TRUNCATION. `!' sets the choice stack's height back to the barrier
;;; its goal was carried with. That is all a cut is here, and it is why the
;;; barrier has to travel with the goal.
;;;
;;; THE LAST CLAUSE DROPS ITS CHOICE POINT. Without that a recursive predicate
;;; leaves one behind per iteration and the choice stack grows with the
;;; recursion even when nothing can backtrack into it. With it, a deterministic
;;; recursion runs in constant choice-stack space.
;;;
;;; BUILTINS ARE A TABLE. *builtins* below is read by the macro layer to emit
;;; the dispatcher -- grouped by arity, so a name is only compared against the
;;; builtins that could match it. Adding one is a line in the table and a
;;; function; the dispatcher cannot fall out of step with the table because it
;;; is generated from it.
;;;
;;; A TARGET USING THIS FILE NEEDS <math.h> AND -lm. The arithmetic builtins
;;; reach pow, sqrt, fabs and llround; lib/std/c declares them for inference
;;; but the header still has to be included by the target that emits code.
;;;
;;; EVERY BUILTIN HERE IS DETERMINISTIC. A builtin that could leave a choice
;;; point behind -- `between/3', `clause/2' -- would need the engine's choice
;;; stack in its hands, and would then be the one piece of the system that
;;; could not be written by anyone else. They belong in the Prolog-level
;;; library instead, where they are three lines and cost nothing.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;;; ------------------------------------------------------------------
;;;; The builtin table
;;;; ------------------------------------------------------------------

;;; name, arity, and the function that runs it. Each answers 1 for success and
;;; 0 for failure; an error is reported by filling in the engine's `err' and
;;; answering -1.
(DEFPARAMETER *builtins*
  '(("trace"        0 coco_bi_trace)
    ("notrace"      0 coco_bi_notrace)
    ("="            2 coco_bi_unify)
    ("\\="          2 coco_bi_not_unify)
    ("=="           2 coco_bi_eq)
    ("\\=="         2 coco_bi_neq)
    ("@<"           2 coco_bi_lt)
    ("@>"           2 coco_bi_gt)
    ("@=<"          2 coco_bi_le)
    ("@>="          2 coco_bi_ge)
    ("compare"      3 coco_bi_compare)

    ("var"          1 coco_bi_var)
    ("nonvar"       1 coco_bi_nonvar)
    ("atom"         1 coco_bi_atom)
    ("number"       1 coco_bi_number)
    ("integer"      1 coco_bi_integer)
    ("float"        1 coco_bi_float)
    ("atomic"       1 coco_bi_atomic)
    ("compound"     1 coco_bi_compound)
    ("callable"     1 coco_bi_callable)
    ("is_list"      1 coco_bi_is_list)

    ("is"           2 coco_bi_is)
    ("=:="          2 coco_bi_num_eq)
    ("=\\="         2 coco_bi_num_neq)
    ("<"            2 coco_bi_num_lt)
    (">"            2 coco_bi_num_gt)
    ("=<"           2 coco_bi_num_le)
    (">="           2 coco_bi_num_ge)

    ("functor"      3 coco_bi_functor)
    ("arg"          3 coco_bi_arg)
    ("=.."          2 coco_bi_univ)
    ("copy_term"    2 coco_bi_copy_term)

    ("atom_length"  2 coco_bi_atom_length)
    ("atom_codes"   2 coco_bi_atom_codes)
    ;; ---- SWI's string type ---------------------------------------------
    ;; A STRING IS NOT AN ATOM AND NOT A CODE LIST, which is the whole point:
    ;; an atom is a NUL-terminated name in a table, so it cannot carry a NUL;
    ;; a code list is a list, so it cannot be told from one. See lib/term.cicili.
    ("string"        1 coco_bi_string)
    ("string_length" 2 coco_bi_string_length)
    ("atom_string"   2 coco_bi_atom_string)
    ("string_to_atom" 2 coco_bi_string_to_atom)
    ("number_string" 2 coco_bi_number_string)
    ("string_codes"  2 coco_bi_string_codes)
    ("string_chars"  2 coco_bi_string_chars)
    ("string_concat" 3 coco_bi_string_concat)
    ("text_concat"   3 coco_bi_text_concat)
    ("string_lower"  2 coco_bi_string_lower)
    ("string_upper"  2 coco_bi_string_upper)
    ("term_string"   2 coco_bi_term_string)
    ("split_string"  4 coco_bi_split_string)
    ("atom_concat"  3 coco_bi_atom_concat)
    ("number_codes" 2 coco_bi_number_codes)

    ("write"        1 coco_bi_write)
    ("print"        1 coco_bi_write)
    ("writeln"      1 coco_bi_writeln)
    ("write_canonical" 1 coco_bi_write_canonical)
    ("nl"           0 coco_bi_nl)

    ("assert"       1 coco_bi_assertz)
    ("asserta"      1 coco_bi_asserta)
    ("assertz"      1 coco_bi_assertz)
    ("retract"      1 coco_bi_retract)

    ("dynamic"      1 coco_bi_dynamic)
    ("listing"      0 coco_bi_listing_all)
    ("listing"      1 coco_bi_listing)

    ("vacuum_kb"    0 coco_bi_vacuum_kb)
    ("vacuum_kb"    1 coco_bi_vacuum_kb)

    ("halt"         0 coco_bi_halt)))

;;;; ------------------------------------------------------------------
;;;; The engine's vocabulary, as interned ids
;;;; ------------------------------------------------------------------
;;;
;;; A GOAL'S NAME IS ALREADY AN INTEGER. `coco_name_of' answers the
;;; interned atom id; the dispatcher used to turn it back into a `char *'
;;; and compare it with `strcmp' -- against fifteen control constructs,
;;; then against every core builtin of that arity, then against every
;;; loaded module's own table. MEASURED, on a tail-recursive loop of
;;; 600 003 inferences: 1 360 103 strcmp calls, 22.7 per inference, and
;;; __strcmp_avx2 at 25.09% of all instructions -- the largest single cost
;;; in the interpreter. On 8-queens it was 14.57%.
;;;
;;; So every name the dispatcher tests is interned ONCE per machine into
;;; `m->ids', and the tests are integer comparisons. The list below is the
;;; constructs; the builtins add themselves, so a builtin gains an id by
;;; being in the table above and nowhere else.
(DEFPARAMETER *construct-names*
  '("true" "fail" "false" "$true" "$fail" "$trace_exit" "," "!" "$cut"
    "$softcut" ";" "->" "*->" "\\+" "not" "once" "ignore" "call" "catch"
    "$catch_exit" "throw" "trace" "notrace"
    ;; not dispatched on, but BUILT on every inference: the continuation's
    ;; functor, its end, and the catch marker. Interned here so the engine
    ;; pushes them by id -- see `*functor-names*' and `coco-fid' below.
    "$k" "[]" "$catch"
    ;; the record a body's later goals are reached from (Stage 5)
    "$e"
    ;; the neck, so a clause splits into head and body without a strcmp
    ":-"))

;;; THE FUNCTORS THE ENGINE BUILDS, interned once beside the names. Every
;;; one of these was `coco_make' with a C string -- `strlen', the atom
;;; table's hash and probe, then the functor table's -- on every goal
;;; proven, for `'$k'/3', and on every if-then-else, catch and traced call
;;; for the rest. Measured on a clause of 32 trivial body goals: building
;;; the continuation by name was 31 % of the interpreter's instructions.
;;; The index of each is settled here, at expansion time, as `ids' are.
(DEFPARAMETER *functor-names*
  '(("$k" 3) ("$cut" 1) ("$softcut" 1) ("$catch" 2) ("$catch_exit" 1)
    ("$trace_exit" 3)))

(DEFUN coco-fid-index (name arity)
  (OR (POSITION (LIST name arity) *functor-names* :TEST #'EQUAL)
      (ERROR "coco: no functor id for ~S/~D -- add it to *functor-names*" name arity)))

;;; `(coco-fid m "$k" 3)' is `m->fids[K]', with K settled at expansion time.
(DEFMACRO coco-fid (m name arity) `(nth ,(coco-fid-index name arity) (-> ,m fids)))

;;; THE EVALUABLE FUNCTORS, interned beside the dispatch names (1.8.46).
;;; `is/2' compared the operator's name with `strcmp' down a chain -- the
;;; name read back from the atom table, then `+', `-', `*', `/' ... until
;;; one matched: 390 instructions for `N - 1', the strcmp alone a sixth of
;;; them. By id it is integer compares. The three spelled with a backslash
;;; are the COCO_OP_* arrays (a Cicili string may not end in one): a SYMBOL
;;; in this list names such an array, and `coco-id' finds it by that name.
(DEFPARAMETER *arith-names*
  '("+" "-" "*" "/" "//" "div" "mod" "rem" "min" "max" "**" "^" "gcd" ">>" "<<"
    COCO_OP_AND COCO_OP_OR "xor" "pi" "e" COCO_OP_NOT "msb" "abs" "sign"
    "float" "integer" "truncate" "round" "floor" "ceiling" "sqrt" "sin" "cos"
    "tan" "asin" "acos" "atan" "exp" "log"))

;;; Constructs first, then every builtin name once, then the evaluable
;;; functors. The ORDER is what fixes the indices, so it is computed here
;;; and nowhere else.
(DEFPARAMETER *dispatch-names*
  (LET ((names (COPY-LIST *construct-names*)))
    (DOLIST (row *builtins*)
      (UNLESS (MEMBER (FIRST row) names :TEST #'STRING=)
        (SETF names (APPEND names (LIST (FIRST row))))))
    (DOLIST (name *arith-names*)
      (UNLESS (MEMBER name names :TEST #'STRING=)
        (SETF names (APPEND names (LIST name)))))
    names))

;;; 192 is the array in `coco_machine'. A Cicili array size is one token, so
;;; the bound cannot be computed there -- it is checked HERE instead, at
;;; expansion time, which turns "one builtin too many" into a build error
;;; with a name on it rather than a write past the end of a struct.
(DEFUN coco-check-ids ()
  (WHEN (> (LENGTH *dispatch-names*) 192)
    (ERROR "coco: ~D dispatch names, and coco_machine.ids holds 192"
           (LENGTH *dispatch-names*))))

(DEFUN coco-id-index (name)
  (OR (POSITION name *dispatch-names* :TEST #'STRING=)
      (ERROR "coco: no dispatch id for ~S -- add it to *construct-names*" name)))

;;; `(coco-id m "once")' is `m->ids[K]', with K settled at expansion time.
(DEFMACRO coco-id (m name) `(nth ,(coco-id-index name) (-> ,m ids)))

;;; Interning them all costs one hash apiece, once per machine, and buys
;;; every inference after it. The functors come after the names, because
;;; each one is its name's id and an arity.
(DEFMACRO coco-emit-id-fill ()
  (coco-check-ids)
  (WHEN (> (LENGTH *functor-names*) 16)
    (ERROR "coco: ~D functor names, and coco_machine.fids holds 16"
           (LENGTH *functor-names*)))
  `(func coco_ids_fill ((coco_machine * m))
     ,@(LOOP FOR name IN *dispatch-names* FOR i FROM 0
             COLLECT `(set (nth ,i (-> m ids)) (coco_intern m ,name)))
     ,@(LOOP FOR row IN *functor-names* FOR i FROM 0
             COLLECT `(set (nth ,i (-> m fids))
                           (coco_functor_id m (coco-id m ,(FIRST row)) ,(SECOND row))))
     ;; THE CONSTRUCT MASK: one byte per atom interned so far, set for the
     ;; construct names, so the loop tells a construct from a predicate
     ;; with one load (`coco_is_construct'). An atom interned later is not
     ;; a construct, and its id is past the mask's end.
     (free (-> m cmask))
     (set (-> m cmask) (cast (u8 *) (calloc (-> m atoms_len) 1)))
     (set (-> m cmask_len) (? (== (-> m cmask) nil) 0 (-> m atoms_len)))
     ,@(LOOP FOR name IN *construct-names* FOR i FROM 0
             COLLECT `(if (< (nth ,i (-> m ids)) (-> m cmask_len))
                          (set (nth (nth ,i (-> m ids)) (-> m cmask)) 1)))
     (set (-> m ids_ready) 1)))

(DEFMACRO coco_is_construct (m nid)
  `(and (< ,nid (-> ,m cmask_len)) (!= 0 (nth ,nid (-> ,m cmask)))))

;;; Grouped by arity, so a goal of arity 3 never tests a builtin of arity 1.
;;; FOUND says whether the name was a builtin at all -- which is what tells
;;; the engine to go looking in the knowledge base instead.
(DEFMACRO coco-emit-builtin-dispatch ()
  (LET ((arities (SORT (REMOVE-DUPLICATES (MAPCAR #'SECOND *builtins*)) #'<)))
    `(func coco_builtin ((coco_engine * e) (u64 nid) (u32 arity) (size_t g) (int * found))
       (out int)
       (let ((coco_machine * m . #'(-> e m)))
         (set (cof found) 1)
         (cond
           ,@(MAPCAR
              (LAMBDA (n)
                `((== arity ,n)
                  (cond
                    ,@(MAPCAR (LAMBDA (row) `((== nid (coco-id m ,(FIRST row)))
                                              (return (,(THIRD row) e g))))
                              (REMOVE-IF-NOT (LAMBDA (r) (= (SECOND r) n)) *builtins*))
                    (#t (set (cof found) 0) (return 0)))))
              arities)
           (#t (set (cof found) 0) (return 0)))))))

;;; THE SAME TABLE, BY ROW. `coco_builtin_index' answers which row of
;;; `*builtins*' a name and arity are, or -1, by the chain `coco_builtin'
;;; walks; the engine asks it once per functor and keeps the row on the
;;; functor (`bix' in term.cicili). `coco_builtin_call' runs row K: a
;;; switch, so a remembered builtin costs one jump where the chain cost
;;; every row of its arity -- 23 comparisons for an arity-2 predicate of
;;; the program's own, which is not a builtin at all, on every call.
(DEFMACRO coco-emit-builtin-index ()
  (LET ((arities (SORT (REMOVE-DUPLICATES (MAPCAR #'SECOND *builtins*)) #'<)))
    `(func coco_builtin_index ((coco_machine * m) (u64 nid) (u32 arity)) (out int)
       (cond
         ,@(MAPCAR
            (LAMBDA (n)
              `((== arity ,n)
                (cond
                  ,@(LOOP FOR row IN *builtins* FOR i FROM 0
                          WHEN (= (SECOND row) n)
                          COLLECT `((== nid (coco-id m ,(FIRST row))) (return ,i)))
                  (#t (return -1)))))
            arities)
         (#t (return -1))))))

(DEFMACRO coco-emit-builtin-call ()
  `(func coco_builtin_call ((coco_engine * e) (int ix) (size_t g)) (out int)
     (switch ix
       ,@(LOOP FOR row IN *builtins* FOR i FROM 0
               COLLECT `(case ,i (return (,(THIRD row) e g))))
       (default (return 0)))))

;;; The binary arithmetic operators, as (name int-op float-op). Both operands
;;; are integers only if neither is a float, which is the rule `is/2' follows
;;; throughout: integer arithmetic stays exact until a float enters it.
(DEFPARAMETER *arith-binops*
  '(("+" +) ("-" -) ("*" *)))

;;; Expands inside `coco_arith_binary' and nowhere else, and reads the names that
;;; function has already bound: `ai'/`af' and `bi'/`bf' are the two operands as
;;; integer and as float, `both_int' says which pair to use, and `iv'/`fv'/`isf'
;;; are where the answer goes. Naming them here rather than passing eight forms
;;; keeps the call site to one word -- the same arrangement lib/std uses for
;;; the words its front-end macros recognise.
(DEFMACRO coco-emit-arith-binops ()
  `(cond
     ,@(MAPCAR (LAMBDA (row)
                 `((== nid (coco-id m ,(FIRST row)))
                   (if both_int
                       (block (set (cof iv) (,(SECOND row) ai bi))
                              (set (cof isf) 0))
                     (block (set (cof fv) (,(SECOND row) af bf))
                            (set (cof isf) 1)))
                   (return 1)))
               *arith-binops*)
     (#t (return 0))))


;;;; ------------------------------------------------------------------
;;;; Declarations
;;;; ------------------------------------------------------------------

(generic decl-solve
  ()

  ;;; A CATCH frame is not an alternative and never offers one -- backtracking
  ;;; through it pops it and keeps going. What it is is a MARK: `throw/1' walks
  ;;; the stack looking for one whose catcher matches, and the trail and heap
  ;;; marks every frame already carries are exactly what "put the machine back
  ;;; as it was when the catch was entered" means.
  ;;;
  ;;; IT COSTS NOTHING IN state.cicili, which was the reason to do it this way.
  ;;; A frame is written out field by field with its kind, and the catcher and
  ;;; the recovery goal ride in `call' as one `'$catch'(C, R)' term on the heap
  ;;; -- and the heap is serialised already. A frozen machine inside a `catch'
  ;;; comes back inside it.
  ;;; DEAD is a GOAL frame the soft cut has taken the alternative away from.
  ;;; It is a KIND and not a flag on the frame because the frames travel in a
  ;;; frozen machine as a fixed row of numbers, and the kind is already one of
  ;;; them -- a new field would change that format for every blob ever written,
  ;;; while a new kind is a value no old blob contains.
  ;;;
  ;;; It cannot simply be popped instead. The frames are an array and every
  ;;; barrier, every `$cut' height and every restored `nchoices' is an INDEX
  ;;; into it, so removing one from the middle would move all of them.
  ;;; CATCH_RETRY is what turns a catch frame back ON. A catch whose goal has
  ;;; EXITED must stop catching -- a `throw' after it belongs to whoever is
  ;;; outside -- and the frame was simply left active, so
  ;;;
  ;;;     catch(( catch(true, _, assertz(seen)), throw(b) ), B, true)
  ;;;
  ;;; ran the INNER recovery and then went on from after the inner catch,
  ;;; with the outer one never hearing about `b'. The exit marks the frame
  ;;; DEAD; this frame, pushed above the goal's own alternatives, marks it
  ;;; live again if anything ever fails back INTO the goal, and carries the
  ;;; index of the frame it revives in `clause_ix' -- a field a catch frame
  ;;; does not use, and a number, so a frozen machine still travels as a row
  ;;; of numbers with no new field in it.
  (enum coco_choice_kind (COCO_CH_CLAUSE . 0) (COCO_CH_GOAL . 1) (COCO_CH_CATCH . 2)
                         (COCO_CH_DEAD . 3) (COCO_CH_CATCH_RETRY . 4))

  (struct coco_choice
    (member int      kind)
    (member size_t   goals)        ; the continuation to put back
    (member size_t   trail_mark)
    (member size_t   heap_mark)
    (member size_t   call)         ; the goal being solved, or the alternative
    (member size_t   pred)
    (member size_t   clause_ix)    ; the next clause to try
    (member size_t   barrier)      ; the cut barrier the alternative runs under
    ;; the argument the call is indexed on, chosen when the call made the
    ;; frame (`coco_pred_select') and 0, the first, for every predicate the
    ;; first argument will do for -- not part of a frozen machine, whose
    ;; atoms are another process's: a thawed frame is keyed on the first
    ;; argument, which is slower and exactly as right
    (member u32      ixpos))

  ;;; THE TRACER'S SHADOW of a choice frame. One per frame, index-aligned,
  ;;; and DELIBERATELY NOT part of the frozen state: the frames travel in a
  ;;; frozen machine as a fixed row of numbers and this changes that row for
  ;;; nobody. A thawed machine resumed under --trace starts with these
  ;;; zeroed, which reads as "print no Redo and no Fail for what happened
  ;;; before the thaw" -- the right answer.
  ;;;
  ;;; GOAL is the traced call the frame belongs to -- the call itself for a
  ;;; CLAUSE frame, the enclosing call for a disjunction's frame -- and
  ;;; DEPTH its port depth. PRINTR says whether resuming this frame is a
  ;;; Redo worth a line: a `;' the program wrote is, the frame `->' pushes
  ;;; for its else branch is not, because entering an else is not a redo.
  ;;; EXITED remembers that the call has passed its Exit port, so a resumed
  ;;; frame whose remaining heads all fail is discarded in silence -- which
  ;;; is what SWI's clause indexing does by never keeping the frame at all.
  (struct coco_tchoice
    (member size_t   goal)
    (member int      depth)
    (member int      printr)
    (member int      exited))

  (struct coco_engine
    (member coco_machine * m)
    (member coco_store *   st)

    (member size_t      goals)     ; the continuation: '$k'(G,B,Rest) or []
    (member coco_choice * choices)
    (member size_t      nchoices)
    (member size_t      choice_cap)

    (member size_t      query)     ; the goal as asked, kept for reporting
    (member u64         steps)
    (member u64         max_steps) ; 0 is no limit
    (member int         resume)    ; a solution has been reported; go back first
    (member int         halted)
    (member int         halt_code)

    ;; the four-port tracer: on or off, the shadow frames, and the current
    ;; call context -- the innermost traced call whose body is running, so
    ;; a new Call knows its depth and a disjunction's frame knows whose
    ;; Redo it would be
    (member int         trace)
    (member coco_tchoice * tchoices)
    (member int         trace_depth)
    (member size_t      trace_goal)

    ;; AN UNCAUGHT BALL, for whoever is running this engine from outside.
    ;; `coco_throw' already puts every ball in the store -- it has to, because
    ;; unwinding truncates the heap out from under it -- and until now the
    ;; cell index died with the call, so a NESTED engine's exception reached
    ;; its caller as a message and nothing else. A caller that wants to
    ;; re-raise it in its own engine needs the term, and this is where the
    ;; term is. Zero when nothing was thrown; `coco_engine_init' memsets.
    (member int         has_ball)
    (member size_t      ball_cell)
    (member size_t      ball_size)    ; cells it occupies, for the store's count of the dead

    ;; MAY THE HEAP COLLECTOR RUN UNDER THIS ENGINE? Off unless the host
    ;; that made the engine turns it on, because a collection moves cells and
    ;; only the host knows whether it keeps cell indices of its own across
    ;; `coco_engine_next'. The CLI's commands, the REPL (which registers its
    ;; variables) and `coco_m_run_isolated' say yes; a test binary or an
    ;; embedder that has not looked says nothing, and keeps the behaviour it
    ;; had. See `coco_heap_gc'.
    (member int         gc)

    ;; HOW MANY TIMES A MODULE HAS DECLINED A GOAL WHOSE NAME IT KNOWS --
    ;; `coco_m_decline', the module saying "not these arguments" or "not in
    ;; this state". The engine reads it across a resolving walk and keeps
    ;; nothing on the functor when it moved: see the dispatch in `step'.
    (member u64         declines)

    ;; THE NEXT GOAL, HANDED OVER IN THE ENGINE: the first goal of the clause
    ;; just entered and its cut barrier (`coco_try_clause'), which the next
    ;; step takes from here instead of from a `'$k'' frame built for it only
    ;; to be taken apart again -- on naive reverse, 57 of the 95
    ;; instructions an inference spent on frames. Nothing outside the step
    ;; ever meets it: the loop pushes it back as an ordinary frame before a
    ;; collection, a stop at the inference limit or a halt (`coco_k_flush'),
    ;; so a frozen machine, the collector and the tracer see the
    ;; continuation they always saw. `nset' says it holds one; zero after
    ;; `coco_engine_init', which memsets.
    (member size_t      ngoal)
    (member size_t      nbar)
    (member int         nset)

    ;; AND THE NEXT GOAL NEVER BUILT (Stage 3; `nset' 2): its functor, its
    ;; arity and its arguments, which the clause just entered wrote here
    ;; instead of into a goal term (`coco_code', `rbody'). The step tries a
    ;; plain predicate's deterministic call straight from them
    ;; (`coco_try_clause' given the bank), and builds the term
    ;; (`coco_areg_term') for anything else and before anything reads the
    ;; continuation. TWO BANKS of eight: the head reads the call's bank
    ;; while the body writes the next call's into the other, so a program
    ;; that could not run still has its call to build the term from.
    ;; `acur' is the call's.
    (member size_t      areg [16])
    (member u64         afid)
    (member u32         aarity)
    (member int         acur)

    (member char        err [192])

    ;; COLLECTED INSIDE A NESTED ENGINE (1.9.4). OUTER is the engine whose
    ;; builtin started this one (`coco_engine_next' links it; a
    ;; `coco_engine *'), and while this engine is itself part way through
    ;; a module's predicate, KGOAL and KCALL are that call's continuation
    ;; and goal, kept here rather than in the loop's C locals so that a
    ;; collection the predicate's nested engine runs can rewrite them.
    ;; PTRAIL and PHEAP are the marks the builtin that started THIS engine
    ;; winds the machine back to when it is done -- a choice point, as far
    ;; as the collector is concerned, between the outer engine's frames and
    ;; this one's (`coco_heap_collect').
    (member void *      outer)
    (member size_t      kgoal)
    (member size_t      kcall)
    (member size_t      ptrail)
    (member size_t      pheap))

  ;;; What `--trace' asks for: engines made after this is set trace from
  ;;; their first goal. A per-engine affair after that -- `trace/0' and
  ;;; `notrace/0' flip the engine, not this.
  (var int coco_trace_default . 0)

  (decl) (func coco_engine_init ((coco_engine * e) (coco_machine * m) (coco_store * st)))
  (decl) (func coco_engine_free ((coco_engine * e)))

  ;;; Points the engine at a goal. Discards any state from a previous query.
  (decl) (func coco_engine_ask ((coco_engine * e) (size_t goal)))

  ;;; Runs to the next solution. 1 = one was found and the bindings stand,
  ;;; 0 = there are no more, -1 = something went wrong and `e->err' says what.
  (decl) (func coco_engine_next ((coco_engine * e)) (out int))

  ;;; Reads GOAL as text and asks it. Answers 1, or 0 with `e->err' set.
  (decl) (func coco_engine_ask_text ((coco_engine * e) (const char * text)) (out int))

  ;;; THE CONTINUATION AS TERMS, FOR A FREEZE (Stage 5): every goal of an
  ;;; environment that the engine or one of its choice frames will still
  ;;; reach turned into the goal term and `'$k'' frame it stands for, built
  ;;; on the heap, the frames' heap marks raised over them -- the machine a
  ;;; freeze writes, which a thaw anywhere reads as it always did. SV keeps
  ;;; what it changed, and `coco_engine_materialize_undo' puts it back, the
  ;;; heap wound back with it, so the live machine goes on with its
  ;;; environments. 0, and nothing changed, when memory ran short.
  (struct coco_kmat
    (member size_t   heap_len)
    (member size_t   goals)
    (member size_t   n)
    (member size_t * cgoals)
    (member size_t * ccalls)
    (member size_t * cmarks))
  (decl) (func coco_engine_materialize ((coco_engine * e) (coco_kmat * sv)) (out int))
  (decl) (func coco_engine_materialize_undo ((coco_engine * e) (coco_kmat * sv)))

  (decl) (func coco_builtin ((coco_engine * e) (u64 nid) (u32 arity)
                           (size_t g) (int * found)) (out int))

  ;;; Interns the dispatcher's whole vocabulary into `m->ids'. Called once
  ;;; per machine, from the top of `coco_engine_next'.
  (decl) (func coco_ids_fill ((coco_machine * m)))
  (decl) (func coco_builtin_index ((coco_machine * m) (u64 nid) (u32 arity)) (out int))
  (decl) (func coco_builtin_call ((coco_engine * e) (int ix) (size_t g)) (out int))

  ;;; ---- the module seam ---------------------------------------------------
  ;;;
  ;;; TWO NULL FUNCTION POINTERS, and this file consults them and knows nothing
  ;;; else about modules -- not what one is, nor how many there are. It is the
  ;;; arrangement kb.cicili uses for the knowledge base, for the same reason: a
  ;;; cocolog built without a module is the cocolog that existed before modules,
  ;;; because the hooks stay null and the cost is one null check per goal that
  ;;; was going to reach the knowledge base anyway.
  ;;;
  ;;; CALL runs a goal that is not a control construct and not a core builtin,
  ;;; setting FOUND if some module owned the name and arity. It is consulted
  ;;; AFTER the core builtins, so no module can redefine `=' or `is' underneath
  ;;; a program, and BEFORE the knowledge base, so a module predicate is not
  ;;; silently shadowed by a clause somebody asserted.
  ;;;
  ;;; LOAD is given a store and asked to put the modules' own clauses in it. It
  ;;; runs when a query is asked rather than when a store is made, because a
  ;;; store can be emptied under the engine -- thawing a machine does exactly
  ;;; that -- and the clauses have to come back.
  ;;; ---- all the solutions of a goal --------------------------------------
  ;;;
  ;;; Runs GOAL to exhaustion on a NESTED ENGINE sharing this one's machine and
  ;;; store, and answers a list of copies of TEMPLATE, one per solution. This
  ;;; is what `findall/3' is, and `forall/2' and `aggregate_all/3' after it --
  ;;; but it lives here rather than in a module because a module cannot see the
  ;;; engine, and running a goal to exhaustion is exactly seeing the engine.
  ;;;
  ;;; THE SOLUTIONS GO THROUGH THE STORE AND NOT THE HEAP. Backtracking
  ;;; truncates the heap to the choice point's mark, so a copy made on the heap
  ;;; during the search is gone by the time the search ends -- the collection
  ;;; would come back empty or, worse, pointing at cells that had been reused.
  ;;; The store never shrinks, which is the property `assert' already relies on,
  ;;; so each solution is put there and read back afterwards.
  ;;;
  ;;; IT IS DETERMINATE, and has to be: it makes no choice point of its own and
  ;;; cannot be suspended half way, so a machine frozen during a `findall' is
  ;;; frozen before it or after it and never inside it.
  ;;;
  ;;; Answers 1; 0 with `e->err' carrying whatever went wrong inside; or 2
  ;;; when the goal THREW and a catch frame of the outer engine took the
  ;;; ball, in which case the engine already points at that catch's recovery
  ;;; goal and the caller must answer 2 in its turn rather than setting a
  ;;; continuation of its own.
  ;;;
  ;;; THE SEARCH MAY COLLECT THE HEAP (1.9.4), and a collection moves cells:
  ;;; GP, when not nil, is the caller's goal cell, given back where the
  ;;; collector left it -- a caller that reads its goal's arguments after
  ;;; the search reads them from there.
  (decl) (func coco_engine_findall ((coco_engine * e) (size_t template) (size_t goal)
                                  (size_t * out) (size_t * gp)) (out int))

  ;;; A NESTED ENGINE COLLECTS A REGION WORTH IT (1.9.4). A builtin about to
  ;;; run a nested engine raises the machine's threshold to its heap mark
  ;;; plus the floor, and puts it back after (`coco_gc_nested_end' with
  ;;; what this answered): the search collects once it has made a floor's
  ;;; worth of cells of its own, and a short one never does -- the mark it
  ;;; is wound back to reclaims those for nothing, where a collection there
  ;;; marks every live cell of every engine. Measured on the linter, whose
  ;;; every clause is linted inside a findall: four collections, 0.86 % of
  ;;; its instructions, for a peak 28 % lower (52.7 MB, not 73.2).
  (decl) (func coco_gc_nested_begin ((coco_machine * m) (size_t hmark)) (out size_t))
  (decl) (func coco_gc_nested_end ((coco_machine * m) (size_t saved)))

  ;;; ---- a goal under a ceiling -------------------------------------------
  ;;;
  ;;; Runs GOAL on a nested engine, exactly as findall does, but bounded to
  ;;; LIMIT inferences and stopping at the FIRST solution. Here for findall's
  ;;; reason: a step ceiling is a property of an engine, and a module cannot
  ;;; see one.
  ;;;
  ;;; WHY IT IS NEEDED AT ALL. `max_steps' was set only by the composition
  ;;; root -- `cocolog step' -- so nothing a PROGRAM ran could be bounded from
  ;;; inside a program. A server whose pages are clauses cannot live with
  ;;; that: one page that loops takes the whole process with it, and no amount
  ;;; of care in the other pages helps.
  ;;;
  ;;; IT COMMITS TO THE FIRST SOLUTION and says so rather than borrowing SWI's
  ;;; name for something subtly different -- which is the rule this file
  ;;; already states about bagof/setof, that a predicate agreeing until it
  ;;; does not is worse than one that never claimed to. The sub-engine's
  ;;; choice points die with it, so there is nothing to backtrack into.
  ;;;
  ;;; THE CEILING IS THE LOWER OF TWO. A goal asking for a million inferences
  ;;; inside a `cocolog step' that has a thousand left gets the thousand:
  ;;; findall already narrows this way, and a fence that could RAISE a budget
  ;;; would be a way around the outer one rather than a limit.
  ;;;
  ;;; AN EXCEPTION COMES OUT AS AN EXCEPTION, which findall's version of this
  ;;; does not manage -- there, an uncaught throw inside ends the query with
  ;;; its message and no `catch/3' outside ever sees it. It matters more here:
  ;;; library(httpd) answers 500 for a page that throws, and it can only do
  ;;; that if it can catch one. The ball survives because `coco_throw' puts
  ;;; every ball in the store before unwinding, and the nested engine now says
  ;;; which cell; it is read back on to the heap and thrown again in the outer
  ;;; engine, where an enclosing catch can match it.
  ;;;
  ;;; Answers 1 (succeeded, and its BINDINGS ARE KEPT), 0 (failed), 2 (the
  ;;; ceiling was reached), 3 (it threw and an outer `catch/3' took it, so the
  ;;; caller must answer 2 -- "the continuation is already set"), or -1 (it
  ;;; threw and nothing caught it, `e->err' set). Everything but 1 puts the
  ;;; machine back exactly as it was. GP is the caller's goal cell, as for
  ;;; findall: the goal may collect the heap.
  (decl) (func coco_engine_call_limited ((coco_engine * e) (size_t goal)
                                       (u64 limit) (u64 * used) (size_t * gp)) (out int))

  ;;; Throws BALL, exactly as `throw/1' does. A module's C half uses this to
  ;;; raise an error a program can catch, rather than filling in `err' and
  ;;; stopping the query -- which is what every builtin here used to do and is
  ;;; why cocolog failed where SWI threw.
  ;;;
  ;;; Answers 1 when a `catch/3' took it, in which case the caller must return
  ;;; 1 as well and let the engine run the recovery goal; and 0 when nothing
  ;;; caught it, in which case `err' says so and the caller returns -1.
  (decl) (func coco_m_thrown ((coco_engine * e) (size_t ball)) (out int))

  ;;; ---- what an exception READS like --------------------------------------
  ;;;
  ;;; SWI'S WORDS for a ball, so that a person who has read one of these
  ;;; before does not have to read this one twice. `error(existence_error(
  ;;; procedure, main/0), _)' is `Unknown procedure: main/0' and not a term
  ;;; with a variable in it, which is what a reader had to decode before.
  ;;;
  ;;; MEASURED AGAINST swipl, not remembered: `X is foo+1' says "Arithmetic:
  ;;; `foo/0' is not a function", a ball that is not an `error/2' at all says
  ;;; "Unknown message: my_ball", and an error term with no message of its
  ;;; own says "Unknown error term:". Those three are exactly the cases a
  ;;; guess gets wrong.
  ;;;
  ;;; THE TERM IS STILL THERE for anything that wants it -- this is a way to
  ;;; SAY a ball, not a replacement for having one.
  (decl) (func coco_error_text ((coco_machine * m) (size_t ball)
                              (char * out) (size_t len)))

  ;;; The same for the exception an engine ended on, which is the shape every
  ;;; caller of `coco_engine_next' actually has: 1 and OUT filled when the
  ;;; engine stopped on a ball, 0 when whatever went wrong was not one (a
  ;;; syntax error in the query, a goal that is not callable) and `e->err' is
  ;;; the only thing to say.
  (decl) (func coco_engine_error_text ((coco_engine * e) (char * out) (size_t len))
               (out int))

  (decl) (func coco_extern_install
               ((func call ((coco_engine * e) (const char * name) (u32 arity)
                            (size_t g) (int * found)) (out int))
                (func load ((coco_store * st) (coco_machine * m) (coco_engine * e))
                      (out int))))

  ;;; THE MODULE WALK, RESOLVED ONCE PER FUNCTOR. `call' above asks every
  ;;; registered module in turn, and each compares the name with `strcmp'
  ;;; against its predicates of that arity -- on every call of every
  ;;; predicate that is not a core builtin, the user's own included:
  ;;; measured on naive reverse, 25 % of the interpreter's instructions.
  ;;; With these two installed, the first call of a functor goes through
  ;;; `resolving', the same walk, which also says WHICH module claimed the
  ;;; name; the engine keeps that on the functor (`dmod' in term.cicili)
  ;;; under the registry's generation of the moment, and every later call
  ;;; is `call_at' on that one module, or the knowledge base directly when
  ;;; none claimed it. A module registered later raises the generation
  ;;; (`coco_extern_generation'), so every functor is asked again. Null
  ;;; until installed: the walk is then as it was.
  ;;;
  ;;; WHICH IS TRUE ONLY OF A DISPATCHER WHOSE CLAIM IS ITS NAME AND ARITY.
  ;;; torch turns `tensor_execution/3' down by its arguments (the DCG form
  ;;; `tensor_execution(graph)' is a clause of library(tensor_expr)) and
  ;;; every `tensor_*' name by its backend; a first call it declined left
  ;;; the functor with the knowledge base for good, and its own shape then
  ;;; raised a domain error (1.8.42-1.8.44). So a dispatcher that knows a
  ;;; name and declines this goal says so -- `coco_m_decline' -- and a walk
  ;;; during which one did keeps NOTHING on the functor: the next call
  ;;; walks again, as every call did before. An owner that declines sends
  ;;; the goal on through the whole walk, which is what the walk did.
  (decl) (func coco_extern_install_resolve
               ((func resolving ((coco_engine * e) (const char * name) (u32 arity)
                                 (size_t g) (int * found) (size_t * out_at)) (out int))
                (func call_at ((coco_engine * e) (size_t at) (const char * name) (u32 arity)
                               (size_t g) (int * found)) (out int))))

  ;;; Puts back one choice-point frame read out of a frozen machine. The
  ;;; predicate arrives as a name and an arity rather than as an index -- see
  ;;; state.cicili for why -- and is interned into whatever store this machine
  ;;; is being resumed against.
  (decl) (func coco_choice_restore ((coco_engine * e) (int kind) (size_t goals)
                                  (size_t trail_mark) (size_t heap_mark) (size_t call)
                                  (size_t clause_ix) (size_t barrier)
                                  (const char * pred_name) (u32 pred_arity)) (out int))

  ) ; decl-solve


;;;; ------------------------------------------------------------------
;;;; Implementation
;;;; ------------------------------------------------------------------

(generic impl-solve
  ()

  (static)
  (func coco_eng_grow ((coco_engine * e) (size_t need)) (out int)
        (if (<= need (-> e choice_cap)) (return 1))
        (let ((size_t ncap . #'(? (== (-> e choice_cap) 0) 64 (-> e choice_cap)))
              (coco_choice * nb)
              (coco_tchoice * tb))
          (while (< ncap need) (set ncap (* ncap 2)))
          (set nb (cast (coco_choice *) (realloc (-> e choices) (* ncap (sizeof coco_choice)))))
          (if (== nb nil) (return 0))
          (set (-> e choices) nb)
          ;; the shadow frames grow in step, so an index into one is an
          ;; index into the other
          (set tb (cast (coco_tchoice *) (realloc (-> e tchoices) (* ncap (sizeof coco_tchoice)))))
          (if (== tb nil) (return 0))
          (set (-> e tchoices) tb)
          (set (-> e choice_cap) ncap)
          (return 1)))

  ;;; A Redo re-enters not only its own frame but, implicitly, every call
  ;;; it is nested in: their environments are live again, and SWI prints
  ;;; their Fail when the failure finally crosses them. An ancestor is an
  ;;; older frame at a strictly shallower depth.
  (static)
  (func coco_trace_reopen ((coco_engine * e) (size_t below) (int depth))
        (let ((i64 fi . #'(- (cast i64 below) 1)))
          (while (>= fi 0)
            (if (and (== ($ (nth (cast size_t fi) (-> e choices)) kind) COCO_CH_CLAUSE)
                     (< ($ (nth (cast size_t fi) (-> e tchoices)) depth) depth))
                (set ($ (nth (cast size_t fi) (-> e tchoices)) exited) 0))
            (set fi (- fi 1)))))

  ;;; ---- the four ports ----------------------------------------------------
  ;;; SWI's line, byte for byte: three spaces, the port, the depth in round
  ;;; brackets, the goal as the writer prints it. On stderr, where SWI puts
  ;;; it, so a traced program's own output stays clean on stdout.

  (static)
  (func coco_trace_line ((const char * port) (int depth) (const char * text))
        (fprintf stderr "   %s: (%d) %s\n" port depth (? (== text nil) "?" text)))

  (static)
  (func coco_trace_port ((coco_engine * e) (const char * port) (int depth) (size_t g))
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_term (-> e m) (aof b) g 1 0)
          (coco_trace_line port depth ($ b s))
          (coco_sb_free (aof b))))

  ;;; ---- the module seam -------------------------------------------------

  ;; No initialiser: a static is null until `coco_extern_install' says otherwise,
  ;; and `. nil' cannot be written inside a generic in this package -- `nil'
  ;; there is the symbol `cocolog::nil', which dots the form with something
  ;; that is not a list and stops the specifier walking it.
  (static) (var func coco_extern_call ((coco_engine * e) (const char * name)
                                     (u32 arity) (size_t g) (int * found))
                 (out int))
  (static) (var func coco_extern_load ((coco_store * st) (coco_machine * m)
                                     (coco_engine * e)) (out int))

  (func coco_extern_install
        ((func call ((coco_engine * e) (const char * name) (u32 arity)
                     (size_t g) (int * found)) (out int))
         (func load ((coco_store * st) (coco_machine * m) (coco_engine * e)) (out int)))
        (set coco_extern_call call)
        (set coco_extern_load load))

  (static) (var func coco_extern_resolving ((coco_engine * e) (const char * name) (u32 arity)
                                            (size_t g) (int * found) (size_t * out_at)) (out int))
  (static) (var func coco_extern_call_at ((coco_engine * e) (size_t at) (const char * name)
                                          (u32 arity) (size_t g) (int * found)) (out int))
  ;; the registry's generation: 0 is what a fresh functor carries, so it
  ;; starts at 1 and whoever changes the registry raises it
  (var u32 coco_extern_generation . 1)

  (func coco_extern_install_resolve
        ((func resolving ((coco_engine * e) (const char * name) (u32 arity)
                          (size_t g) (int * found) (size_t * out_at)) (out int))
         (func call_at ((coco_engine * e) (size_t at) (const char * name) (u32 arity)
                        (size_t g) (int * found)) (out int)))
        (set coco_extern_resolving resolving)
        (set coco_extern_call_at call_at)
        (set coco_extern_generation (+ coco_extern_generation 1)))

  (static)
  (func coco_fail_err ((coco_engine * e) (const char * what)) (out int)
        (snprintf (-> e err) 192 "%s" what)
        (return -1))

  ;;; ---- errors a program can catch ---------------------------------------
  ;;;
  ;;; The core builtins used to stop the query through `coco_fail_err', which is
  ;;; why cocolog FAILED wherever SWI threw. They raise `error(Formal, _)' now,
  ;;; exactly as the modules do -- the difference is only that these are on the
  ;;; engine's side of the seam, so they build the term here rather than
  ;;; through the module API.
  ;;;
  ;;; 2 means "the continuation is already set", which is what a caught throw
  ;;; leaves behind; -1 means nothing caught it.
  (static) (decl) (func coco_throw ((coco_engine * e) (size_t ball)) (out int))

  (static)
  (func coco_raise ((coco_engine * e) (size_t formal)) (out int)
        (let ((size_t ball . #'(coco_make2 (-> e m) "error" formal
                                         (coco_new_var (-> e m)))))
          (return (? (== 1 (coco_throw e ball)) 2 -1))))

  (static)
  (func coco_type_error ((coco_engine * e) (const char * type) (size_t culprit)) (out int)
        (return (coco_raise e (coco_make2 (-> e m) "type_error"
                                      (coco_new_atom (-> e m) type) culprit))))

  (static)
  (func coco_instantiation_error ((coco_engine * e)) (out int)
        (return (coco_raise e (coco_new_atom (-> e m) "instantiation_error"))))

  (static)
  (func coco_evaluation_error ((coco_engine * e) (const char * what)) (out int)
        (return (coco_raise e (coco_make1 (-> e m) "evaluation_error"
                                      (coco_new_atom (-> e m) what)))))

  ;;; `existence_error(procedure, Name/Arity)', the one a call to a predicate
  ;;; nobody defined raises. The indicator is built before the ball because
  ;;; `coco_raise' consumes it, and `/' is an ordinary two-argument term here --
  ;;; the writer turns it back into `foo/2' from the operator table.
  (static)
  (func coco_existence_error ((coco_engine * e) (const char * kind)
                              (const char * name) (u32 arity)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t ind . #'(coco_make2 m "/" (coco_new_atom m name)
                                          (coco_new_int m (cast i64 arity)))))
          (return (coco_raise e (coco_make2 m "existence_error"
                                            (coco_new_atom m kind) ind)))))

  ;;; `permission_error(Operation, Type, Culprit)', ISO's shape: the operation
  ;;; was understood and is refused here. What raises it today is `vacuum_kb'
  ;;; against a store whose arrangement cannot vacuum or whose operator did
  ;;; not say `--vacuum'.
  (static)
  (func coco_permission_error ((coco_engine * e) (const char * op)
                               (const char * type) (size_t culprit)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t args [3]))
          (set (nth 0 args) (coco_new_atom m op))
          (set (nth 1 args) (coco_new_atom m type))
          (set (nth 2 args) culprit)
          (return (coco_raise e (coco_make m "permission_error" 3 args)))))

  ;;; ---- the continuation --------------------------------------------------

  ;;; A CONTINUATION THAT WOULD NOT FIT. The three builders of the
  ;;; continuation -- `coco_k_push', `coco_k_push_roots', `coco_areg_term'
  ;;; -- answer 0 and write nothing when the heap would not grow, and a
  ;;; caller that stores the 0 as the continuation or as the next goal never
  ;;; runs it: this stops the run at the next step's top, which tests
  ;;; `halted' on every step anyway. 2 is not a halt but memory, and
  ;;; `coco_engine_next' turns it into the error before any host reads it.
  ;;; Through 1.9.3 `coco_k_push' wrote its frame over cells 1 to 3 and the
  ;;; other two left cell 0 as the continuation or the goal.
  (static)
  (func coco_k_room ((coco_engine * e)) (out size_t)
        (if (== (-> e halted) 0) (set (-> e halted) 2))
        (return 0))

  ;;; '$k'(Goal, Barrier, Rest). Built with coco_make rather than the term DSL
  ;;; because all three arguments are values the engine is holding, not a shape
  ;;; known when this was written.
  (static)
  (func coco_k_push ((coco_engine * e) (size_t goal) (size_t barrier) (size_t rest)) (out size_t)
        (let ((coco_machine * m . #'(-> e m))
              (size_t h . 0))
          ;; `coco_engine_ask' pushes the first frame before the loop has
          ;; interned anything, and a thawed machine arrives with nothing
          ;; interned: two loads and a branch, once per machine
          (if (not (-> m ids_ready)) (coco_ids_fill m))
          ;; FOUR CELLS, RESERVED ONCE: the header, the goal and the rest as
          ;; `coco_make' would store them -- dereferenced, which is what
          ;; keeps the chain one link long -- and the barrier AS THE CELL
          ;; ITSELF, an INT in its slot rather than a REF to one pushed
          ;; beside it. Every reader dereferences, and an INT dereferences
          ;; to itself; the collector keeps a kept compound's slots whatever
          ;; they hold. One push and one cell fewer per goal proven.
          (set h (coco_push_struct m (coco-cell FUN (coco-fid m "$k" 3)) 3))
          ;; no room: nothing written over cell 0's neighbours
          (if (== h 0) (return (coco_k_room e)))
          (set (nth (+ h 1) (-> m heap)) (coco-cell REF (coco_deref m goal)))
          (set (nth (+ h 2) (-> m heap)) (coco-int-cell (cast i64 barrier)))
          (set (nth (+ h 3) (-> m heap)) (coco-cell REF (coco_deref m rest)))
          (return h)))

  ;;; A BODY'S GOALS AS ONE RUN OF FRAMES: the N roots a compiled body
  ;;; built (`coco_clause_run') go on the continuation as N `'$k'' frames
  ;;; reserved in ONE growth check and written back to front, each frame's
  ;;; rest the frame after it and the last's the continuation that was
  ;;; there -- cell for cell what N calls of `coco_k_push' would have left,
  ;;; so nothing that reads a continuation can tell. Answers the first
  ;;; goal's frame, or REST itself for a body with no goals (a fact), or 0
  ;;; when the heap would not grow (`coco_k_room').
  (static)
  (func coco_k_push_roots ((coco_engine * e) (const size_t * roots) (size_t n)
                           (size_t barrier) (size_t rest)) (out size_t)
        (let ((coco_machine * m . #'(-> e m))
              (size_t h . #'(-> m heap_len)))
          (if (== n 0) (return rest))
          (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                            (aof (-> m heap_cap)) (+ h (* n 4)) (sizeof u64)))
              (return (coco_k_room e)))
          (set (-> m heap_len) (+ h (* n 4)))
          (let ((u64 hdr . #'(coco-cell FUN (coco-fid m "$k" 3)))
                (u64 bar . #'(coco-int-cell (cast i64 barrier)))
                (size_t next . #'(coco_deref m rest))
                (size_t i . n))
            (while (> i 0)
              (set i (- i 1))
              (let ((size_t f . #'(+ h (* i 4))))
                (set (nth f (-> m heap)) hdr)
                (set (nth (+ f 1) (-> m heap)) (coco-cell REF (coco_deref m (nth i roots))))
                (set (nth (+ f 2) (-> m heap)) bar)
                (set (nth (+ f 3) (-> m heap)) (coco-cell REF next))
                (set next f))))
          (return h)))

  ;;; THE GOAL IN THE REGISTERS, BUILT: the term `coco_clause_run_r' did
  ;;; not build, its header and one slot an argument, each slot pointing at
  ;;; the argument the register holds -- cell for cell what the body program
  ;;; would have left. Answers the term, or 0 when the heap would not grow
  ;;; (`coco_k_room').
  (static)
  (func coco_areg_term ((coco_engine * e)) (out size_t)
        (let ((coco_machine * m . #'(-> e m))
              (u32 n . #'(-> e aarity))
              (size_t * a . #'(aof (nth (* (cast size_t (-> e acur)) 8) (-> e areg))))
              (size_t h . 0))
          (set h (coco_push_struct_raw m (coco-cell FUN (-> e afid)) n))
          ;; no room: nothing written over cell 0's neighbours
          (if (== h 0) (return (coco_k_room e)))
          (for ((u32 i . 0)) (< i n) ((++ i))
            (set (nth (+ h (+ (cast size_t i) 1)) (-> m heap)) (coco-cell REF (nth i a))))
          (return h)))

  ;;; THE HANDED-OVER GOAL BACK ON THE CONTINUATION, as the frame
  ;;; `coco_try_clause' did not build for it (`ngoal' on the engine). Called
  ;;; before anything reads the continuation as a term -- a collection, and
  ;;; every return from the loop that can leave the machine to be frozen or
  ;;; resumed. Two loads and a branch when nothing is held. Answers 0, with
  ;;; nothing changed, when the heap would not grow (`coco_k_room').
  (static)
  (func coco_k_flush ((coco_engine * e)) (out int)
        ;; a goal in the registers is built first, and then goes back as
        ;; any handed-over goal does
        (if (== (-> e nset) 2)
            (let ((size_t t . #'(coco_areg_term e)))
              (if (== t 0) (return 0))
              (set (-> e ngoal) t)
              (set (-> e nset) 1)))
        (if (-> e nset)
            (let ((size_t f . #'(coco_k_push e (-> e ngoal) (-> e nbar) (-> e goals))))
              (if (== f 0) (return 0))
              (set (-> e nset) 0)
              (set (-> e goals) f)))
        (return 1))

  ;;; ---- the continuation as terms, for a freeze (Stage 5) -----------------
  ;;;
  ;;; A FROZEN MACHINE CARRIES NO ENVIRONMENT. Its image is the heap, the
  ;;; trail and the frames as numbers, and an environment names its code by
  ;;; an address that means nothing in the process that thaws it -- which
  ;;; has its own store, compiled afresh. So a freeze builds what every
  ;;; position it can still reach stands for -- the goal term and `'$k''
  ;;; frame entering the clause built through 1.9.2 -- writes the image,
  ;;; and winds the heap back: the live machine keeps its environments, and
  ;;; the image is one 1.9.2 could have written. The frames' heap marks are
  ;;; raised to the top in the image, so a thawed machine that backtracks
  ;;; keeps the terms built here: a cell kept past a backtrack is only
  ;;; garbage, and every binding is undone by the trail, which is
  ;;; unconditional. What is built is built from the cells as the clause's
  ;;; entry left them, never dereferenced through a binding made since: a
  ;;; choice frame comes back to its goals with those bindings undone.

  ;;; Which continuation cells are built already, and as what: open
  ;;; addressing, the key a cell's index plus one, so what frames and
  ;;; environments share is built once.
  (struct coco_kmemo
    (member u64 *    keys)
    (member size_t * vals)
    (member size_t   cap)
    (member size_t   len))

  (static)
  (func coco_kmemo_slot ((size_t cap) (u64 key)) (out size_t)
        (let ((u64 h . #'(* key (cast u64 0x9E3779B97F4A7C15))))
          (set h (xor h (>> h 29)))
          (return (cast size_t (bitand h (cast u64 (- cap 1)))))))

  (static)
  (func coco_kmemo_get ((coco_kmemo * t) (u64 key) (size_t * out)) (out int)
        (if (== (-> t cap) 0) (return 0))
        (let ((size_t i . #'(coco_kmemo_slot (-> t cap) key)))
          (while (!= (nth i (-> t keys)) 0)
            (if (== (nth i (-> t keys)) key)
                (block (set (cof out) (nth i (-> t vals))) (return 1)))
            (set i (bitand (+ i 1) (- (-> t cap) 1))))
          (return 0)))

  (static)
  (func coco_kmemo_put ((coco_kmemo * t) (u64 key) (size_t val)) (out int)
        ;; under half full before the probe that places it
        (if (> (* (+ (-> t len) 1) 2) (-> t cap))
            (let ((size_t ncap . #'(? (== (-> t cap) 0) 1024 (* (-> t cap) 2)))
                  (u64 * nk . #'(cast (u64 *) (calloc ncap (sizeof u64))))
                  (size_t * nv . #'(cast (size_t *) (calloc ncap (sizeof size_t)))))
              (if (or (== nk nil) (== nv nil)) (block (free nk) (free nv) (return 0)))
              (for ((size_t i . 0)) (< i (-> t cap)) ((++ i))
                (if (!= (nth i (-> t keys)) 0)
                    (let ((size_t j . #'(coco_kmemo_slot ncap (nth i (-> t keys)))))
                      (while (!= (nth j nk) 0) (set j (bitand (+ j 1) (- ncap 1))))
                      (set (nth j nk) (nth i (-> t keys)))
                      (set (nth j nv) (nth i (-> t vals))))))
              (free (-> t keys)) (free (-> t vals))
              (set (-> t keys) nk) (set (-> t vals) nv) (set (-> t cap) ncap)))
        (let ((size_t i . #'(coco_kmemo_slot (-> t cap) key)))
          (while (!= (nth i (-> t keys)) 0) (set i (bitand (+ i 1) (- (-> t cap) 1))))
          (set (nth i (-> t keys)) key)
          (set (nth i (-> t vals)) val)
          (set (-> t len) (+ (-> t len) 1))
          (return 1)))

  (static)
  (func coco_kstk_push ((size_t ** s) (size_t * len) (size_t * cap) (size_t v)) (out int)
        (if (>= (cof len) (cof cap))
            (let ((size_t ncap . #'(? (== (cof cap) 0) 256 (* (cof cap) 2)))
                  (void * nb . #'(realloc (cast (void *) (cof s)) (* ncap (sizeof size_t)))))
              (if (== nb nil) (return 0))
              (set (cof s) (cast (size_t *) nb))
              (set (cof cap) ncap)))
        (set (nth (cof len) (cof s)) v)
        (set (cof len) (+ (cof len) 1))
        (return 1))

  ;;; A `'$k'' FRAME FROM CELLS AS THEY ARE: the goal's cell and the
  ;;; barrier's copied, not dereferenced, over REST. 0 when the heap would
  ;;; not grow.
  (static)
  (func coco_k_frame ((coco_machine * m) (u64 gcell) (u64 bcell) (size_t rest)) (out size_t)
        (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN (coco-fid m "$k" 3)) 3)))
          (if (== h 0) (return 0))
          (set (nth (+ h 1) (-> m heap)) gcell)
          (set (nth (+ h 2) (-> m heap)) bcell)
          (set (nth (+ h 3) (-> m heap)) (coco-cell REF rest))
          (return h)))

  ;;; THE CONTINUATION C0 AS TERMS, into OUT: every position in it turned
  ;;; into its goal -- the term the environment holds, or a call built from
  ;;; its slots, or a cut -- in a `'$k'' frame over what follows it, and
  ;;; every frame above one built again over what that became; a frame
  ;;; with nothing of the kind under it is itself. ITERATIVE, a stack of
  ;;; cells: a deep recursion's continuation is a chain as long as it is
  ;;; deep. A cell is built once what follows it is (MEMO), so a chain is
  ;;; walked once however many frames share it. 0 when memory ran short.
  (static)
  (func coco_k_resolve ((coco_engine * e) (coco_kmemo * memo) (size_t c0) (size_t * out)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t * stk . nil) (size_t slen . 0) (size_t scap . 0)
              (u64 khdr . #'(coco-cell FUN (coco-fid m "$k" 3)))
              (int ok . 1))
          (set c0 (coco_deref m c0))
          (set ok (coco_kstk_push (aof stk) (aof slen) (aof scap) c0))
          (while (and ok (> slen 0))
            (let ((size_t c . #'(nth (- slen 1) stk))
                  (u64 cv . 0) (size_t nx . 0) (size_t got . 0)
                  (size_t env . 0) (u32 i . 0) (int kind . 0))
              (set cv (nth c (-> m heap)))
              (if (coco_kmemo_get memo (+ (cast u64 c) 1) (aof got))
                  (block (set slen (- slen 1)) continue))
              ;; what follows this cell: KIND 1 a frame, 2 a position, 0
              ;; the empty continuation (or nothing this knows), itself
              (cond
                ((== cv khdr)
                 (set kind 1)
                 (set nx (coco_deref m (+ c 3))))
                ((coco-tag-is POS cv)
                 (let ((size_t pay . #'(cast size_t (coco-payload cv)))
                       (coco_code * ecd . nil) (u32 un . 0))
                   (set kind 2)
                   (set env (- c (>> pay 16)))
                   (set i (cast u32 (bitand pay 65535)))
                   (set ecd (coco-env-code m env))
                   (set un ($ (nth i (-> ecd egoals)) next))
                   (set nx (? (== un 0) (coco_deref m (+ env 2)) (coco-env-pos env ecd un))))))
              (cond
                ((== kind 0)
                 (set ok (coco_kmemo_put memo (+ (cast u64 c) 1) c))
                 (set slen (- slen 1)))
                ((coco_kmemo_get memo (+ (cast u64 nx) 1) (aof got))
                 (let ((size_t res . c))
                   (if (== kind 2)
                       ;; unit I of the environment, in its frame: the term
                       ;; that frame held (`coco_unit_term'), under the
                       ;; barrier it had
                       (let ((coco_code * cd . #'(coco-env-code m env))
                             (coco_egoal * eg . nil) (size_t g . 0) (size_t bv . 0))
                         (set eg (aof (nth i (-> cd egoals))))
                         (set bv (? (== (-> eg bslot) 0) (coco-env-barrier m env)
                                    (+ (cast size_t (coco-signed-payload
                                                     (nth (coco-env-slot-at env cd (- (-> eg bslot) 1))
                                                          (-> m heap))))
                                       1)))
                         (if (not (coco_unit_term m cd env i (aof g))) (set ok 0))
                         (if ok
                             (block (set res (coco_k_frame m (coco-cell REF g) (coco-int-cell (cast i64 bv)) got))
                                    (if (== res 0) (set ok 0)))))
                       ;; a frame: itself when what follows it came out as
                       ;; itself, else a copy over what it came out as
                       (if (!= got nx)
                           (block (set res (coco_k_frame m (nth (+ c 1) (-> m heap))
                                                         (nth (+ c 2) (-> m heap)) got))
                                  (if (== res 0) (set ok 0)))))
                   (if ok (set ok (coco_kmemo_put memo (+ (cast u64 c) 1) res)))
                   (set slen (- slen 1))))
                (#t (set ok (coco_kstk_push (aof stk) (aof slen) (aof scap) nx))))))
          (free stk)
          (if (or (not ok) (-> m oom)) (return 0))
          (return (coco_kmemo_get memo (+ (cast u64 c0) 1) out))))

  (func coco_engine_materialize ((coco_engine * e) (coco_kmat * sv)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_kmemo memo . '{ nil nil 0 0 })
              (size_t n . #'(-> e nchoices))
              (size_t r . 0) (int ok . 1))
          (memset sv 0 (sizeof coco_kmat))
          (if (not (-> m ids_ready)) (coco_ids_fill m))
          ;; a goal handed over goes back on the continuation first, and
          ;; stays there: a frame is a continuation the live machine reads
          ;; as well as it read the goal held
          (if (not (coco_k_flush e)) (return 0))
          (set (-> sv heap_len) (-> m heap_len))
          (set (-> sv goals) (-> e goals))
          (set (-> sv n) n)
          (if (> n 0)
              (block
               (set (-> sv cgoals) (cast (size_t *) (malloc (* n (sizeof size_t)))))
               (set (-> sv ccalls) (cast (size_t *) (malloc (* n (sizeof size_t)))))
               (set (-> sv cmarks) (cast (size_t *) (malloc (* n (sizeof size_t)))))
               (if (or (== (-> sv cgoals) nil) (== (-> sv ccalls) nil) (== (-> sv cmarks) nil))
                   (block (free (-> sv cgoals)) (free (-> sv ccalls)) (free (-> sv cmarks))
                          (memset sv 0 (sizeof coco_kmat))
                          (return 0)))
               (for ((size_t i . 0)) (< i n) ((++ i))
                 (set (nth i (-> sv cgoals)) ($ (nth i (-> e choices)) goals))
                 (set (nth i (-> sv ccalls)) ($ (nth i (-> e choices)) call))
                 (set (nth i (-> sv cmarks)) ($ (nth i (-> e choices)) heap_mark)))))
          (if (coco_k_resolve e (aof memo) (-> e goals) (aof r))
              (set (-> e goals) r)
              (set ok 0))
          (for ((size_t i . 0)) (and ok (< i n)) ((++ i))
            (if (coco_k_resolve e (aof memo) ($ (nth i (-> e choices)) goals) (aof r))
                (set ($ (nth i (-> e choices)) goals) r)
                (set ok 0))
            ;; A CHOICE WHOSE ALTERNATIVE IS A POSITION (Stage 6: a
            ;; construct's else, a disjunction's right arm) gets back the
            ;; term `coco_ite' and the disjunction gave it, over the goals
            ;; just built, as 1.9.2 kept it
            (if (and ok (== ($ (nth i (-> e choices)) kind) COCO_CH_GOAL)
                     (coco-tag-is POS (nth ($ (nth i (-> e choices)) call) (-> m heap))))
                (let ((size_t pc . #'($ (nth i (-> e choices)) call))
                      (size_t pay . 0) (size_t env . 0) (size_t g . 0))
                  (set pay (cast size_t (coco-payload (nth pc (-> m heap)))))
                  (set env (- pc (>> pay 16)))
                  (if (coco_unit_term m (coco-env-code m env) env (cast u32 (bitand pay 65535)) (aof g))
                      (set ($ (nth i (-> e choices)) call) g)
                      (set ok 0)))))
          ;; what was built must outlive every backtrack the image makes
          (if (and ok (> (-> m heap_len) (-> sv heap_len)))
              (for ((size_t i . 0)) (< i n) ((++ i))
                (set ($ (nth i (-> e choices)) heap_mark) (-> m heap_len))))
          (free ($ memo keys)) (free ($ memo vals))
          (if (not ok) (block (coco_engine_materialize_undo e sv) (return 0)))
          (return 1)))

  (func coco_engine_materialize_undo ((coco_engine * e) (coco_kmat * sv))
        (let ((coco_machine * m . #'(-> e m)))
          (set (-> m heap_len) (-> sv heap_len))
          (set (-> e goals) (-> sv goals))
          (for ((size_t i . 0)) (and (< i (-> sv n)) (< i (-> e nchoices))) ((++ i))
            (set ($ (nth i (-> e choices)) goals) (nth i (-> sv cgoals)))
            (set ($ (nth i (-> e choices)) call) (nth i (-> sv ccalls)))
            (set ($ (nth i (-> e choices)) heap_mark) (nth i (-> sv cmarks))))
          (free (-> sv cgoals))
          (free (-> sv ccalls))
          (free (-> sv cmarks))
          (memset sv 0 (sizeof coco_kmat))))

  ;;; WHETHER THE CLAUSE'S FIRST GOAL GOES INTO THE REGISTERS: it has the
  ;;; form for it (`rblen'), nothing is traced, and its functor is stamped
  ;;; a plain predicate of this store as of now (`fgen') -- the only goal
  ;;; the next step can try from them. Anything else is built as the term
  ;;; it always was, at no cost to a body whose first goal is a builtin.
  ;;; A FIRST GOAL THAT IS A BUILTIN OR A CONSTRUCT never will be a plain
  ;;; predicate, and its register form is switched off for good the first
  ;;; time that is known (`bix' answers once the builtin has been called
  ;;; once): a body that starts with `is' or `=<' pays one load, not three.
  (static)
  (func coco_regs_never ((coco_engine * e) (coco_code * cd) (coco_functor * f))
        (if (or (>= (-> f bix) 2) (coco_is_construct (-> e m) (-> f name)))
            (set (-> cd rblen) 0)))

  (static)
  (func coco_regs_ok ((coco_engine * e) (coco_code * cd)) (out int)
        (if (or (== (-> cd rblen) 0) (!= (-> e trace) 0)) (return 0))
        (let ((coco_functor * f . #'(aof (nth (cast size_t (-> cd rfid)) (-> (-> e m) functors)))))
          (if (and (== (-> f fgen) coco_extern_generation)
                   (== (-> f pst) (cast (void *) (-> e st)))
                   (== (-> f pserial) (-> (-> e st) serial)))
              (return 1))
          (coco_regs_never e cd f)
          (return 0)))

  (static)
  (func coco_k_empty ((coco_engine * e)) (out size_t)
        (let ((coco_machine * m . #'(-> e m)))
          (if (not (-> m ids_ready)) (coco_ids_fill m))
          (return (coco_new_atom_id m (coco-id m "[]")))))

  ;;; A BODY'S CONJUNCTION, PUSHED AS ONE CHAIN. `(A, (B, (C, D)))' used to
  ;;; go on the continuation as one goal, and the loop took it apart one `,'
  ;;; per step: a full iteration -- the step count, the collector's check,
  ;;; the dereference and the construct tests -- for every goal in the
  ;;; body, before the goal itself got an iteration of its own. Measured on
  ;;; a clause of 32 trivial body goals, the `,' steps were 18 % of the
  ;;; interpreter's instructions. Here the right spine is walked once and
  ;;; its goals pushed last first, so the continuation comes out exactly
  ;;; as the loop would have built it -- the same `'$k'' cells, the same
  ;;; barrier on each -- and a frozen machine thaws the same either way.
  ;;;
  ;;; THE SPINE IS BOUNDED. A body longer than the buffer leaves its tail
  ;;; on the continuation as one `,' goal, which the loop still takes
  ;;; apart as before; nothing is lost, only the shortcut.
  (static)
  (func coco_k_push_body ((coco_engine * e) (size_t body) (size_t barrier) (size_t rest))
        (out size_t)
        (let ((coco_machine * m . #'(-> e m))
              (size_t items [64])
              (size_t n . 0)
              (size_t g . #'(coco_deref m body)))
          (if (not (-> m ids_ready)) (coco_ids_fill m))
          (while (and (< n 63)
                      (coco-tag-is FUN (nth g (-> m heap)))
                      (== (coco_arity m g) 2)
                      (== (coco_name_of m g) (coco-id m ",")))
            (set (nth n items) (coco_arg m g 0))
            (set n (+ n 1))
            (set g (coco_deref m (coco_arg m g 1))))
          (set (nth n items) g)
          (set n (+ n 1))
          (while (> n 0)
            (set n (- n 1))
            (set rest (coco_k_push e (nth n items) barrier rest)))
          (return rest)))

  ;;; ---- choice points -----------------------------------------------------

  ;;; Answers whether the frame was made, NOT where it went. The index is
  ;;; `nchoices - 1' and the caller reads it there: an earlier version answered
  ;;; with the index and the callers tested it against 0, which is the index of
  ;;; the FIRST choice point -- so every disjunction and every negation
  ;;; attempted with an empty choice stack silently did nothing at all.
  (static)
  (func coco_push_choice ((coco_engine * e) (int kind) (size_t call) (size_t goals) (size_t barrier))
        (out int)
        (if (not (coco_eng_grow e (+ (-> e nchoices) 1))) (return 0))
        (let ((coco_choice * c . #'(aof (nth (-> e nchoices) (-> e choices)))))
          (memset c 0 (sizeof coco_choice))
          (set (-> c kind) kind)
          (set (-> c call) call)
          (set (-> c goals) goals)
          (set (-> c barrier) barrier)
          (set (-> c trail_mark) ($ (cof (-> e m)) trail_len))
          (set (-> c heap_mark) ($ (cof (-> e m)) heap_len))
          ;; the shadow frame: the current call context, and silent -- the
          ;; two places a resume IS a Redo (a clause frame, a written `;')
          ;; say so themselves after pushing
          (let ((coco_tchoice * tc . #'(aof (nth (-> e nchoices) (-> e tchoices)))))
            (set (-> tc goal) (-> e trace_goal))
            (set (-> tc depth) (-> e trace_depth))
            ;; resuming any in-body alternative -- a `;', an `->' else, a
            ;; `\+' else -- is a Redo of the call it sits in, SWI says so;
            ;; at the toplevel the context goal is 0 and nothing prints
            (set (-> tc printr) (? (== kind COCO_CH_GOAL) 1 0))
            (set (-> tc exited) 0))
          (set (-> e nchoices) (+ (-> e nchoices) 1))
          (return 1)))

  ;;; ONE CLAUSE TRIED against CALL -- the IX'th of predicate P -- with
  ;;; GOALS and BARRIER for its body: compiled when it can be
  ;;; (`coco_clause_code', lib/kb.cicili, its program kept in the
  ;;; predicate's own slot after the first ask) -- its head program, then
  ;;; its body program, whose first goal is handed to the next step
  ;;; (`ngoal') and the rest go on the continuation last first
  ;;; (`coco_k_push_roots'); flushed, that is exactly the continuation
  ;;; `coco_k_push_body' pushes for a copied body -- else matched in the
  ;;; store (`coco_store_unify': the
  ;;; store is never bound, a heap cell is made only where an unbound
  ;;; variable of the call takes a piece of the head) and its body copied
  ;;; over the same variable map. A program that could not RUN (-1: no
  ;;; memory for its frame or its goals) is wound back and the clause
  ;;; matched in the store, because skipping it as a head that did not
  ;;; match would be a wrong answer. Answers 1 with the continuation set;
  ;;; 0 with the machine wound back to the marks it had on the way in --
  ;;; which are a choice frame's own marks when the caller has one: every
  ;;; caller arrives with the machine exactly at them (the step's two
  ;;; calls, `coco_select_clause' after a frame was pushed, after
  ;;; `coco_backtrack' wound back to it, or after the clause before failed
  ;;; and was wound back here), so they are read here and not passed.
  ;;;
  ;;; ARGS, when not nil, are the call's arguments in the registers and
  ;;; CALL is not read (the step's register path): a program that could
  ;;; not be had or could not run then answers -1 with the machine wound
  ;;; back, for the caller to build the call and send it the long way,
  ;;; since there is no term here to match in the store.
  ;;;
  ;;; HOW MANY GUARDS A CLAUSE ENTERED NOW MAY RUN (Stage 4): none under
  ;;; trace, whose ports are printed from goals, and under an inference
  ;;; limit only as many as the limit has steps left -- the guard after
  ;;; them is left to the step, which stops at the limit exactly where it
  ;;; always stopped. The step that entered the clause is counted already,
  ;;; and guard I would have been step STEPS + 1 + I. Asked only of a
  ;;; code with guards (`ex' 1 or 3), so not whether there are any: asked
  ;;; that again behind the question `ex' answers, it cost the counting
  ;;; loop 3 instructions a turn.
  (static)
  (func coco_guard_budget ((coco_engine * e) (coco_code * cd)) (out u32)
        (if (!= (-> e trace) 0) (return 0))
        (if (== (-> e max_steps) 0) (return (-> cd ngd)))
        (if (>= (-> e steps) (-> e max_steps)) (return 0))
        (let ((u64 left . #'(- (-> e max_steps) (-> e steps))))
          (return (? (< left (cast u64 (-> cd ngd))) (cast u32 left) (-> cd ngd)))))

  ;;; THE CLAUSE MATCHED IN THE STORE AND ITS BODY COPIED, for a program
  ;;; that could not be had or could not run (`coco_store_unify': the store
  ;;; is never bound, a heap cell is made only where an unbound variable of
  ;;; the call takes a piece of the head, and the body copied over the same
  ;;; variable map). 1 entered, the body over GOALS; 0 the head did not
  ;;; match, the machine wound back to TMARK and HMARK.
  (func coco_try_store ((coco_engine * e) (size_t cl) (size_t call) (size_t goals)
                        (size_t barrier) (size_t tmark) (size_t hmark)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (coco_varmap vm . '{ nil nil 0 0 0 })
              (size_t shead . 0) (size_t sbody . 0) (int matched . 0))
          (coco_store_clause_parts st m cl (coco-id m ":-") (aof shead) (aof sbody))
          (coco_varmap_take m (aof vm))
          (set matched (coco_store_unify m st call shead (aof vm)))
          (if matched
              (block
               (set (-> e goals)
                    (? (== sbody 0) goals
                       (coco_k_push_body e (coco_store_get_vm m st sbody (aof vm)) barrier goals)))
               (coco_varmap_give m (aof vm))
               (return 1)))
          (coco_varmap_give m (aof vm))
          (coco_undo_to m tmark)
          (set ($ (cof m) heap_len) hmark)
          (return 0)))

  ;;; A CLAUSE THAT MAKES AN ENVIRONMENT, ENTERED (Stage 5): its head, its
  ;;; first goal handed to the next step as `coco_try_clause' hands one,
  ;;; and the environment for the goals after it, whose body returns to
  ;;; GOALS; the continuation becomes the environment's first position. A
  ;;; function of its own, so that a clause without an environment pays one
  ;;; test for there being one: asked in `coco_try_clause', the request cost
  ;;; naive reverse 16 instructions a call. NOT STATIC, and neither is
  ;;; `coco_try_store', so that the compiler has no reason to fold either
  ;;; into `coco_try_clause' for having one caller: folded in, they cost
  ;;; every clause entry 7 instructions more. Answers as `coco_try_clause'
  ;;; answers.
  ;;;
  ;;; A BODY THAT STARTS WITH GUARDS (`ex' 3, Stage 6) runs them as
  ;;; `coco_try_clause' runs a guarded body's -- the ones that ran are
  ;;; inferences, the one that failed too -- and makes the environment only
  ;;; when every one of them ran. Guards that stopped short leave the body
  ;;; built from the one they stopped at (ER's next still 0), handed over
  ;;; and pushed as `coco_try_clause' hands over and pushes a body.
  (func coco_try_env ((coco_engine * e) (coco_code * cd) (size_t cl) (size_t call)
                      (const size_t * args) (size_t goals) (size_t barrier)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t tmark . #'($ (cof m) trail_len))
              (size_t hmark . #'($ (cof m) heap_len))
              (size_t roots [64]) (size_t ng . 0)
              (int nxt . #'(- 1 (-> e acur)))
              (size_t * regs . nil)
              (coco_envreq er) (int matched . -1))
          (if (and (-> cd ehand) (coco_regs_ok e cd))
              (set regs (aof (nth (* (cast size_t nxt) 8) (-> e areg)))))
          (set ($ er parent) goals)
          (set ($ er barrier) barrier)
          (set ($ er next) 0)
          (if (== (-> cd ex) 3)
              (let ((u32 gdone . 0))
                (set matched (coco_clause_run_ge m st cd call args roots (aof ng) regs (aof er)
                                                 (coco_guard_budget e cd) (aof gdone)))
                (if (!= matched -1) (set (-> e steps) (+ (-> e steps) (cast u64 gdone)))))
              (set matched (coco_clause_run_e m st cd call args roots (aof ng) regs (aof er))))
          (if (and (== matched 1) (== ($ er next) 0))
              ;; the guards stopped short: no environment, and the body from
              ;; the guard they stopped at, which is never in the registers.
              ;; Its later goals a frame each, pushed one at a time from the
              ;; last: `coco_k_push_roots' called here as well stopped being
              ;; inline in `coco_try_clause', where every body's are pushed
              (let ((size_t k . goals) (size_t i . ng))
                (if (> ng 0)
                    (block (set (-> e ngoal) (coco_deref m (nth 0 roots)))
                           (set (-> e nbar) barrier)
                           (set (-> e nset) 1)))
                (while (and (> i 1) (!= k 0))
                  (set i (- i 1))
                  (set k (coco_k_push e (nth i roots) barrier k)))
                (set (-> e goals) k)
                (return 1)))
          (if (== matched 1)
              (block
               ;; the first goal handed over, unless it is a unit itself
               ;; (Stage 6), which the continuation starts at
               (cond
                 ((!= regs nil)
                  (set (-> e afid) (-> cd rfid))
                  (set (-> e aarity) (-> cd rarity))
                  (set (-> e acur) nxt)
                  (set (-> e nbar) barrier)
                  (set (-> e nset) 2))
                 ((> ng 0)
                  (set (-> e ngoal) (coco_deref m (nth 0 roots)))
                  (set (-> e nbar) barrier)
                  (set (-> e nset) 1)))
               (set (-> e goals) ($ er next))
               (return 1)))
          (coco_undo_to m tmark)
          (set ($ (cof m) heap_len) hmark)
          (if (== matched 0) (return 0))
          ;; a program that could not run: the long way, or for a call in
          ;; the registers back to the caller, to build it first
          (if (!= args nil) (return -1))
          (return (coco_try_store e cl call goals barrier tmark hmark))))

  (static)
  (func coco_try_clause ((coco_engine * e) (coco_pred * p) (size_t ix) (size_t call)
                         (const size_t * args) (size_t goals) (size_t barrier)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t tmark . #'($ (cof m) trail_len))
              (size_t hmark . #'($ (cof m) heap_len))
              (size_t cl . #'(nth ix (-> p clauses)))
              (coco_code * cd . #'(cast (coco_code *) (nth ix (-> p codes))))
              (int matched . -1))
          ;; the program from the predicate's own slot, or from the store's
          ;; table (which compiles it the first time) and into the slot
          (if (== cd nil)
              (block (set cd (coco_clause_code st m cl))
                     (set (nth ix (-> p codes)) (cast (void *) cd))))
          (if (!= cd nil)
              (let ((size_t roots [64]) (size_t ng . 0)
                    (int nxt . #'(- 1 (-> e acur)))
                    (size_t * regs . nil))
                ;; the first goal into the registers, when the next step can
                ;; try it from there (`coco_regs_ok'): the bank the call is
                ;; not in
                (if (coco_regs_ok e cd)
                    (set regs (aof (nth (* (cast size_t nxt) 8) (-> e areg)))))
                (cond
                  ;; NOT THE PLAIN EXECUTOR (`ex'): guards (1), an
                  ;; environment (2) or both (3) -- one test for all three,
                  ;; the one the guards had, so a plain clause pays nothing
                  ;; for the others.
                  ;; A BODY THAT MAKES AN ENVIRONMENT (Stage 5) is entered
                  ;; by `coco_try_env' unless something is traced: the
                  ;; tracer prints its ports from goals, so under it every
                  ;; body is built as it always was. THE GUARDS THAT RAN
                  ;; ARE INFERENCES (Stage 4), the one that failed too:
                  ;; `statistics(inferences)' and the inference limit count
                  ;; what they counted when each was a step. A program that
                  ;; could not run is wound back below and stepped through
                  ;; from its head, so it counts nothing here. Guards that
                  ;; stopped before the last leave the one they stopped at
                  ;; as the next goal, built: the registers were not
                  ;; written.
                  ((!= (-> cd ex) 0)
                   (cond
                     ((== (-> cd ex) 1)
                      (let ((u32 gdone . 0))
                        (set matched (coco_clause_run_g m st cd call args roots (aof ng) regs
                                                        (coco_guard_budget e cd) (aof gdone)))
                        (if (!= matched -1) (set (-> e steps) (+ (-> e steps) (cast u64 gdone))))
                        (if (< gdone (-> cd ngd)) (set regs nil))))
                     ((== (-> e trace) 0)
                      (return (coco_try_env e cd cl call args goals barrier)))
                     ;; traced, a body with guards and an environment is
                     ;; built from its first guard, as every guarded body
                     ;; is under trace: none of them runs here
                     ((== (-> cd ex) 3)
                      (let ((u32 gdone . 0))
                        (set matched (coco_clause_run_g m st cd call args roots (aof ng) nil
                                                        0 (aof gdone)))
                        (set regs nil)))
                     ((and (== regs nil) (== args nil))
                      (set matched (coco_clause_run m st cd call roots (aof ng))))
                     (#t
                      (set matched (coco_clause_run_r m st cd call args roots (aof ng) regs)))))
                  ((and (== regs nil) (== args nil))
                   (set matched (coco_clause_run m st cd call roots (aof ng))))
                  (#t
                   (set matched (coco_clause_run_r m st cd call args roots (aof ng) regs))))
                (if (== matched 1)
                    (block
                     ;; THE FIRST GOAL GOES TO THE NEXT STEP IN THE ENGINE
                     ;; (`ngoal', or the registers), and only the rest go on
                     ;; the continuation. Every caller of this function is a
                     ;; step about to end -- the loop's own call, or
                     ;; `coco_select_clause' from the loop or from
                     ;; `coco_backtrack' -- so the next thing to run is the
                     ;; loop's top, which flushes or takes it. The goals
                     ;; that go on the continuation start at FROM: the
                     ;; first root when the first goal is in the registers
                     ;; (its term was never built, so it is not a root), the
                     ;; second when it is handed over. ONE call of
                     ;; `coco_k_push_roots', which the compiler then
                     ;; inlines; with a call in each arm it did not, and a
                     ;; body that starts with a builtin paid 3 instructions
                     ;; an inference for it.
                     (let ((size_t from . 0))
                       (cond
                         ((!= regs nil)
                          (set (-> e afid) (-> cd rfid))
                          (set (-> e aarity) (-> cd rarity))
                          (set (-> e acur) nxt)
                          (set (-> e nbar) barrier)
                          (set (-> e nset) 2))
                         ((> ng 0)
                          (set (-> e ngoal) (coco_deref m (nth 0 roots)))
                          (set (-> e nbar) barrier)
                          (set (-> e nset) 1)
                          (set from 1)))
                       (set (-> e goals) (? (== ng from) goals
                                            (coco_k_push_roots e (aof (nth from roots)) (- ng from)
                                                               barrier goals))))
                     (return 1)))
                (if (== matched -1)
                    (block (coco_undo_to m tmark)
                           (set ($ (cof m) heap_len) hmark)))))
          (if (and (== matched -1) (!= args nil)) (return -1))
          (if (== matched -1)
              (return (coco_try_store e cl call goals barrier tmark hmark)))
          ;; that head did not match: put the machine back
          (coco_undo_to m tmark)
          (set ($ (cof m) heap_len) hmark)
          (return 0)))

  ;;; ---- clause selection --------------------------------------------------

  ;;; Tries the clauses of the choice point at CI, from `clause_ix' on. On a
  ;;; head that unifies it sets the continuation and answers 1; when the
  ;;; clauses run out it pops the choice point and answers 0.
  ;;;
  ;;; THE LAST MATCHING CLAUSE POPS ITS OWN CHOICE POINT. A predicate whose
  ;;; final clause matched has nothing left to backtrack into, and leaving the
  ;;; frame behind would make every recursive call cost one -- which is the
  ;;; difference between a loop that runs in constant space and one that does
  ;;; not.
  ;;; FIRST-ARGUMENT INDEXING ENTERS HERE, and it is two calls. The key is
  ;;; the call's own first argument (`coco_arg_key'), and `coco_pred_next_clause'
  ;;; answers which clause to try -- skipping, without copying or unifying
  ;;; them, every clause whose head cannot match. What that removes is the
  ;;; expensive half of a failed attempt: a clause arrives as a FRESH COPY on
  ;;; the heap and is thrown away again when the head does not unify, so a
  ;;; probe into a table of facts used to copy the whole table.
  ;;;
  ;;; `clause_ix' GOES ON MEANING WHAT IT MEANT -- the next ORDINAL to try,
  ;;; not a position in an index -- because a frozen machine's choice frames
  ;;; carry it (lib/state.cicili) and a machine thawed by another process
  ;;; must resume where it stopped.
  (static)
  (func coco_select_clause ((coco_engine * e) (size_t ci)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st)))
          (while 1
            (let ((coco_choice * c . #'(aof (nth ci (-> e choices))))
                  (coco_pred * p . #'(aof (nth (-> c pred) (-> st preds)))))
              ;; THE ARGUMENT THE CALL IS INDEXED ON is the frame's, chosen
              ;; when the call was made (`coco_pred_select', the engine's
              ;; probe) and read here at every retry; its key is read again
              ;; from the call's own argument. 0, the first argument, for a
              ;; frame under the floor, made under trace, or thawed: the
              ;; choice is not frozen, so the frozen format is 1.9.0's. Any
              ;; argument is sound -- a clause it would skip fails its head.
              (let ((u32 kpos . #'(-> c ixpos))
                    (u64 key . 0)
                    (size_t ix . 0))
                (set key (? (== kpos 0) (coco_arg_key m (-> c call))
                            (coco_call_arg_key m (-> c call) kpos)))
                (set ix (? (== kpos 0) (coco_pred_next_clause st p key (-> c clause_ix))
                           (coco_pred_next_at st m p kpos key (-> c clause_ix))))
                (if (== ix (coco_no_clause))
                    (block (set (-> e nchoices) ci) (return 0)))
              (let ((size_t call . #'(-> c call))
                    (size_t goals . #'(-> c goals))
                    (int last . 0))
                (set (-> c clause_ix) (+ ix 1))
                ;; AND THE DETERMINISM COMES FROM THE SECOND ASK. A predicate
                ;; with no further candidate leaves no choice point behind --
                ;; which is what makes an indexed lookup deterministic where
                ;; the walk used to keep a frame alive to the end of the
                ;; table.
                (set last (? (== (? (== kpos 0) (coco_pred_next_clause st p key (-> c clause_ix))
                                    (coco_pred_next_at st m p kpos key (-> c clause_ix)))
                                 (coco_no_clause))
                             1 0))
                ;; one clause, compiled or matched in the store -- see
                ;; `coco_try_clause'. A `!' in the body cuts back to before
                ;; this call. Under trace the frame STAYS even on the last
                ;; clause: failing back past it is what prints the Fail port,
                ;; and a popped frame fails in silence
                (if (coco_try_clause e p ix call nil goals ci)
                    (block
                     (if (and last (== (-> e trace) 0)) (set (-> e nchoices) ci))
                     (return 1)))
                ;; that head did not match: the machine is back at the marks;
                ;; try the next
                ))))
          (return 0)))

  ;;; THE CALL IN THE REGISTERS HAS MORE THAN ONE CANDIDATE: its frame made
  ;;; here, as the dispatch makes one, over the term built first -- so the
  ;;; term sits under the frame's heap mark -- rather than built and sent
  ;;; down to be dispatched and probed again. Answers what
  ;;; `coco_select_clause' answers, or -1 with no memory for the frame. A
  ;;; function of its own, so the step's fast path stays small.
  (static)
  (func coco_regs_choice ((coco_engine * e) (size_t pi) (size_t ix0)) (out int)
        (let ((size_t g . #'(coco_areg_term e))
              (size_t k . #'(-> e goals))
              (size_t b . #'(-> e nbar)))
          (set (-> e nset) 0)
          (if (not (coco_push_choice e COCO_CH_CLAUSE g k b)) (return -1))
          (let ((size_t ci . #'(- (-> e nchoices) 1)))
            (set ($ (nth ci (-> e choices)) pred) pi)
            (set ($ (nth ci (-> e choices)) clause_ix) ix0)
            (set ($ (nth ci (-> e choices)) ixpos) 0)
            (return (? (coco_select_clause e ci) 1 0)))))

  ;;; THE NEXT UNIT OF AN ENVIRONMENT (Stages 5 and 6), the continuation
  ;;; having named its position P: the continuation moves on to the unit
  ;;; after it (`next'), or from the body's last (EXECUTE) to the one the
  ;;; body returns to -- after which nothing reaches the environment but a
  ;;; choice frame that still names one of its positions -- and the unit is
  ;;; taken by its kind, under the barrier it was given (`bslot'). A term,
  ;;; built at entry, is handed to the step from its slot as a clause's
  ;;; first goal is handed over (`ngoal', `nset' 1), and dispatched as a
  ;;; frame's goal was. A call goes into the registers (`nset' 2) when its
  ;;; functor is stamped a plain predicate of this store as of now,
  ;;; untraced (`fgen', what `coco_regs_ok' asks of a first goal), and is
  ;;; built from the slots and handed over otherwise, which stamps one that
  ;;; is plain the first time it is dispatched. The rest are done here, each
  ;;; the step its goal was: a cut; `true' and `fail'; a `,' going on to its
  ;;; first item; an if-then-else pushing the choice that runs its else,
  ;;; writing the height it went in at into its slot and going on to its
  ;;; condition; the cut after the condition, to that height; a disjunction
  ;;; pushing the choice that runs its right arm and going on to its left.
  ;;; UNDER TRACE every unit is handed over as the term its frame held
  ;;; (`coco_unit_term'), and runs as it did through 1.9.2, port for port.
  ;;; 1 when a goal was handed over; 0 when the unit was done here; -2 when
  ;;; it failed; -1 when the heap would not grow.
  ;;;
  ;;; WHAT IT READS IS SETTLED AT COMPILE TIME (`coco_egoal''s offsets): the
  ;;; continuation after the unit, its barrier's cell, its slot and its
  ;;; parts' positions are each the header plus one number, and the kind is
  ;;; a switch. A call whose arguments are all variables has them copied
  ;;; here, slot to register (`rvars'); any other is run by its register
  ;;; program (`coco_env_regs'). Recomputed from the counts at every take,
  ;;; and with the call's every argument a dispatched word in a function of
  ;;; its own, an environment made the lookup benchmark's loop 3.9 % dearer
  ;;; than its frames were; settled here, with the loop taking a handed-over
  ;;; goal in the same step, it is 6.5 % cheaper.
  (static)
  (func coco_env_take ((coco_engine * e) (size_t p)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t pay . #'(cast size_t (coco-payload (nth p (-> m heap)))))
              (size_t env . #'(- p (>> pay 16)))
              (coco_code * cd . #'(coco-env-code m env))
              (coco_egoal * eg . #'(aof (nth (bitand pay 65535) (-> cd egoals))))
              ;; the continuation after it, and its barrier: the
              ;; environment's, or a condition's height plus one
              (size_t nk . #'(+ env (cast size_t (-> eg noff))))
              (size_t bar . #'(+ (cast size_t (coco-signed-payload (nth (+ env (cast size_t (-> eg boff)))
                                                                       (-> m heap))))
                                 (cast size_t (-> eg badd)))))
          (if (-> e trace)
              (let ((size_t g . 0))
                (if (not (coco_unit_term m cd env (cast u32 (bitand pay 65535)) (aof g))) (return -1))
                (set (-> e goals) nk)
                (set (-> e ngoal) (coco_deref m g))
                (set (-> e nbar) bar)
                (set (-> e nset) 1)
                (return 1)))
          (switch (cast int (-> eg kind))
            (case (cc-eg "TERM")
              (set (-> e goals) nk)
              (set (-> e ngoal) (coco_deref m (+ env (cast size_t (-> eg soff)))))
              (set (-> e nbar) bar)
              (set (-> e nset) 1)
              (return 1))
            (case (cc-eg "CALL")
              (let ((coco_functor * f . #'(aof (nth (cast size_t (-> eg fid)) (-> m functors)))))
                (set (-> e goals) nk)
                (if (and (== (-> f fgen) coco_extern_generation)
                         (== (-> f pst) (cast (void *) (-> e st)))
                         (== (-> f pserial) (-> (-> e st) serial)))
                    (let ((int nxt . #'(- 1 (-> e acur)))
                          (size_t * rg . #'(aof (nth (* (cast size_t nxt) 8) (-> e areg)))))
                      ;; arguments that are all variables, copied here; any
                      ;; other register form run by its program
                      (if (-> eg rvars)
                          (let ((u64 * rp . #'(+ (-> cd ebody) (-> eg rat)))
                                (size_t eb . #'(+ env 4)))
                            (for ((u32 j . 0)) (< j (-> eg rlen)) ((++ j))
                              (let ((u64 w . #'(nth j rp)))
                                (set (nth (cast size_t (cc_n w)) rg) (coco_deref m (+ eb (cc_k w)))))))
                          (if (not (coco_env_regs m cd env (cast u32 (bitand pay 65535)) rg))
                              (return -1)))
                      (set (-> e afid) (-> eg fid))
                      (set (-> e aarity) (-> eg arity))
                      (set (-> e acur) nxt)
                      (set (-> e nbar) bar)
                      (set (-> e nset) 2)
                      (return 1)))
                (let ((size_t g . 0))
                  (if (not (coco_env_term m cd env (cast u32 (bitand pay 65535)) (aof g))) (return -1))
                  (set (-> e ngoal) g)
                  (set (-> e nbar) bar)
                  (set (-> e nset) 1)
                  (return 1))))
            (case (cc-eg "ITE")
              (let ((size_t h0 . #'(-> e nchoices)))
                (set (nth (+ env (cast size_t (-> eg soff))) (-> m heap)) (coco-int-cell (cast i64 h0)))
                (if (not (coco_push_choice e COCO_CH_GOAL (+ env (cast size_t (-> eg coff))) nk bar))
                    (return -1))
                (set (-> e goals) (+ env (cast size_t (-> eg aoff))))
                (return 0)))
            (case (cc-eg "CUTC")
              (let ((size_t h0 . #'(cast size_t (coco-signed-payload
                                                 (nth (+ env (cast size_t (-> eg soff))) (-> m heap))))))
                (if (< h0 (-> e nchoices)) (set (-> e nchoices) h0))
                (set (-> e goals) nk)
                (return 0)))
            (case (cc-eg "CONJ")
              (set (-> e goals) (+ env (cast size_t (-> eg aoff))))
              (return 0))
            (case (cc-eg "CUT")
              (if (< bar (-> e nchoices)) (set (-> e nchoices) bar))
              (set (-> e goals) nk)
              (return 0))
            (case (cc-eg "TRUE")
              (set (-> e goals) nk)
              (return 0))
            (case (cc-eg "DISJ")
              (if (not (coco_push_choice e COCO_CH_GOAL (+ env (cast size_t (-> eg coff))) nk bar))
                  (return -1))
              (set (-> e goals) (+ env (cast size_t (-> eg aoff))))
              (return 0))
            ;; `fail', `false' and a construct's `$fail'
            (default (return -2)))
          (return -2)))

  ;;; ---- backtracking ------------------------------------------------------

  ;;; Winds the machine back to the newest choice point that still has
  ;;; something to try, and puts the continuation back. Answers 0 when there is
  ;;; nothing left anywhere, which is the query failing.
  (static)
  (func coco_backtrack ((coco_engine * e)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (while (> (-> e nchoices) 0)
            (let ((size_t ci . #'(- (-> e nchoices) 1))
                  (int kind) (size_t call) (size_t goals) (size_t barrier))
              (let ((coco_choice * c . #'(aof (nth ci (-> e choices)))))
                (coco_undo_to m (-> c trail_mark))
                (set ($ (cof m) heap_len) (-> c heap_mark))
                (set kind (-> c kind))
                (set call (-> c call))
                (set goals (-> c goals))
                (set barrier (-> c barrier)))
              (if (== kind COCO_CH_GOAL)
                  (block
                   ;; a `;' the program wrote: taking its other arm is a Redo
                   ;; of the call it sits in, printed with the bindings just
                   ;; undone. The else-frames of `->' pass in silence, and
                   ;; either way the call context is the one the frame was
                   ;; made under.
                   (if (-> e trace)
                       (let ((coco_tchoice * tc . #'(aof (nth ci (-> e tchoices)))))
                         (if (and (!= (-> tc printr) 0) (!= (-> tc goal) 0))
                             (block
                              (coco_trace_port e "Redo" (-> tc depth) (-> tc goal))
                              ;; the redone call's own frame, and every call
                              ;; it is nested in, are open episodes again
                              (let ((i64 fi . #'(- (cast i64 ci) 1)))
                                (while (>= fi 0)
                                  (if (and (== ($ (nth (cast size_t fi) (-> e choices)) kind) COCO_CH_CLAUSE)
                                           (== ($ (nth (cast size_t fi) (-> e choices)) call) (-> tc goal))
                                           (== ($ (nth (cast size_t fi) (-> e tchoices)) depth) (-> tc depth)))
                                      (block (set ($ (nth (cast size_t fi) (-> e tchoices)) exited) 0)
                                             break))
                                  (set fi (- fi 1))))
                              (coco_trace_reopen e ci (-> tc depth))))
                         (set (-> e trace_goal) (-> tc goal))
                         (set (-> e trace_depth) (-> tc depth))))
                   (set (-> e nchoices) ci)
                   ;; an alternative that is a position (Stage 6: a
                   ;; construct's else, a disjunction's right arm) is the
                   ;; continuation itself, its unit leading on to the rest
                   (if (coco-tag-is POS (nth call (-> m heap)))
                       (set (-> e goals) call)
                       (set (-> e goals) (coco_k_push e call barrier goals)))
                   (return 1)))
              ;; WE ARE FAILING BACK INTO A CATCH'S GOAL, so that catch is
              ;; catching again. It offers no alternative of its own -- the
              ;; frame below it does, which is why this one sits above them.
              (if (== kind COCO_CH_CATCH_RETRY)
                  (let ((size_t ri . #'($ (nth ci (-> e choices)) clause_ix)))
                    (if (and (< ri ci) (== ($ (nth ri (-> e choices)) kind) COCO_CH_DEAD))
                        (set ($ (nth ri (-> e choices)) kind) COCO_CH_CATCH))
                    (set (-> e nchoices) ci)
                    continue))
              ;; a catch offers no alternative, and neither does a frame the
              ;; soft cut killed: drop it and keep going down
              (if (or (== kind COCO_CH_CATCH) (== kind COCO_CH_DEAD))
                  (block (set (-> e nchoices) ci) continue))
              ;; a clause frame. The goal is painted BEFORE selection, which
              ;; binds it to whichever head matches -- SWI's Redo shows the
              ;; call as it stood, not the head it is about to try.
              (let ((char * rtext . nil) (int rD . 0) (size_t rg . 0)
                    (int rexited . 0) (int traced . 0))
                (if (-> e trace)
                    (let ((coco_tchoice * tc . #'(aof (nth ci (-> e tchoices)))))
                      (if (and (!= (-> tc printr) 0) (!= (-> tc goal) 0))
                          (block (set traced 1)
                                 (set rD (-> tc depth))
                                 (set rg (-> tc goal))
                                 (set rexited (-> tc exited))
                                 (let ((coco_strbuf tb))
                                   (coco_sb_init (aof tb))
                                   (coco_write_term m (aof tb) rg 1 0)
                                   (set rtext ($ tb s)))))))
                (if (coco_select_clause e ci)
                    (block
                     (if traced
                         (block (coco_trace_line "Redo" rD rtext)
                                (set ($ (nth ci (-> e tchoices)) exited) 0)
                                (coco_trace_reopen e ci rD)
                                (set (-> e trace_goal) rg)
                                (set (-> e trace_depth) rD)))
                     (if (!= rtext nil) (free rtext))
                     (return 1)))
                ;; out of heads. A call that had exited goes quietly -- the
                ;; silence SWI's clause indexing buys by never keeping the
                ;; frame -- and one that had not fails here, out loud.
                (if (and traced (== rexited 0)) (coco_trace_line "Fail" rD rtext))
                (if (!= rtext nil) (free rtext)))))
          (return 0)))

  ;;; ---- throwing ----------------------------------------------------------

  ;;; Unwinds to the nearest enclosing `catch/3' whose catcher unifies with
  ;;; BALL, and leaves the engine about to run that catch's recovery goal.
  ;;; Answers 1 when it found one and -1 when nothing caught it.
  ;;;
  ;;; THE BALL GOES INTO THE STORE FIRST, and that is the whole difficulty.
  ;;; Unwinding truncates the heap to the frame's mark, and the ball was built
  ;;; above that mark -- by the time there is somewhere to put it, it is gone.
  ;;; The store does not shrink under a caller -- a compaction runs only at
  ;;; the safe points `coco_store_compact' names -- which is the property
  ;;; `assert' and `findall' already rely on, so the ball is put there and
  ;;; read back out on to the heap once the machine has been wound back.
  ;;;
  ;;; A CATCHER THAT DOES NOT MATCH MUST LEAVE NOTHING BEHIND. Trying it is a
  ;;; unification, so it is done between a mark and an undo -- otherwise a
  ;;; failed match would bind the catcher of an outer frame on the way past.
  (static)
  (func coco_throw ((coco_engine * e) (size_t ball)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t cell . #'(coco_store_put (-> e st) (-> e m) ball))
              (size_t size . #'(- ($ (cof (-> e st)) len) cell)))

          (while (> (-> e nchoices) 0)
            (let ((size_t ci . #'(- (-> e nchoices) 1))
                  (int kind) (size_t call) (size_t goals) (size_t barrier))
              (let ((coco_choice * c . #'(aof (nth ci (-> e choices)))))
                (set kind (-> c kind))
                (set call (-> c call))
                (set goals (-> c goals))
                (set barrier (-> c barrier))
                ;; back to how things stood when this frame was made
                (coco_undo_to m (-> c trail_mark))
                (set ($ (cof m) heap_len) (-> c heap_mark)))

              (if (!= kind COCO_CH_CATCH)
                  (block (set (-> e nchoices) ci) continue))

              ;; `'$catch'(Catcher, Recovery)', built before the frame was
              ;; pushed and so below its heap mark -- it survived the unwinding
              (let ((size_t mark . #'($ (cof m) trail_len))
                    (size_t fresh . #'(coco_store_get m st cell))
                    (size_t catcher . #'(coco_arg m call 0))
                    (size_t recovery . #'(coco_arg m call 1)))
                (if (coco_unify m catcher fresh)
                    (block
                     (if (-> e trace)
                         (block (set (-> e trace_goal) ($ (nth ci (-> e tchoices)) goal))
                                (set (-> e trace_depth) ($ (nth ci (-> e tchoices)) depth))))
                     (set (-> e nchoices) ci)
                     (set (-> e goals) (coco_k_push e recovery barrier goals))
                     ;; the ball is on the heap and its cell an orphan
                     (set (-> st dead) (+ (-> st dead) size))
                     (coco_store_maybe_compact st m)
                     (return 1)))
                (coco_undo_to m mark))
              (set (-> e nchoices) ci)))

          ;; nothing caught it. The cell is kept so an OUTER engine can throw
          ;; this same ball again -- see `coco_engine_call_limited' -- and the
          ;; ball is read back one last time so that the message can name it,
          ;; which is the difference between a report a person can act on and
          ;; `an error occurred'.
          (set (-> e has_ball) 1)
          (set (-> e ball_cell) cell)
          (set (-> e ball_size) size)
          (let ((coco_strbuf b))
            (coco_sb_init (aof b))
            (coco_write_term m (aof b) (coco_store_get m st cell) 1 0)
            (snprintf (-> e err) 192 "uncaught exception: %s"
                      (? (== ($ b s) nil) "?" ($ b s)))
            (coco_sb_free (aof b)))
          (return -1)))

  (func coco_m_thrown ((coco_engine * e) (size_t ball)) (out int)
        (return (? (== 1 (coco_throw e ball)) 1 0)))

  ;;; ---- what an exception reads like ---------------------------------------

  ;; One argument of an error term, written the way a message would show it.
  (static)
  (func coco_err_say ((coco_machine * m) (size_t t) (char * out) (size_t len))
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_term m (aof b) t 1 0)
          (snprintf out len "%s" (? (== ($ b s) nil) "?" ($ b s)))
          (coco_sb_free (aof b))))

  (func coco_error_text ((coco_machine * m) (size_t ball) (char * out) (size_t len))
        (let ((size_t b . #'(coco_deref m ball))
              (char a1 [256]) (char a2 [256]) (char a3 [256]))
          ;; A ball that is not `error(Formal, Context)' is not an error term
          ;; at all -- `throw(my_ball)' is a perfectly good throw -- and SWI
          ;; says so in those words rather than pretending to explain it.
          (if (not (and (coco_is_callable m b) (== (coco_arity m b) 2)
                        (== 0 (strcmp (coco_atom_name m (coco_name_of m b)) "error"))))
              (block (coco_err_say m b a1 (sizeof a1))
                     (snprintf out len "Unknown message: %s" a1)
                     (return)))
          (let ((size_t f . #'(coco_deref m (coco_arg m b 0)))
                (const char * fn . "") (u32 fa . 0))
            (if (coco_is_callable m f)
                (block (set fn (coco_atom_name m (coco_name_of m f)))
                       (set fa (coco_arity m f))))

            (if (and (== fa 0) (== 0 (strcmp fn "instantiation_error")))
                (block (snprintf out len "Arguments are not sufficiently instantiated")
                       (return)))

            (if (and (== fa 2) (== 0 (strcmp fn "existence_error")))
                (let ((size_t k . #'(coco_deref m (coco_arg m f 0))))
                  (coco_err_say m k a1 (sizeof a1))
                  (coco_err_say m (coco_arg m f 1) a2 (sizeof a2))
                  (if (== 0 (strcmp a1 "procedure"))
                      (block (snprintf out len "Unknown procedure: %s" a2) (return)))
                  (snprintf out len "%s `%s' does not exist" a1 a2)
                  (return)))

            (if (and (== fa 2) (== 0 (strcmp fn "type_error")))
                (block
                 (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                 (coco_err_say m (coco_arg m f 1) a2 (sizeof a2))
                 ;; `X is foo+1' is a type_error(evaluable, foo/0) and SWI
                 ;; does NOT say "type error" for it -- measured
                 (if (== 0 (strcmp a1 "evaluable"))
                     (block (snprintf out len "Arithmetic: `%s' is not a function" a2)
                            (return)))
                 (snprintf out len "Type error: `%s' expected, found `%s'" a1 a2)
                 (return)))

            (if (and (== fa 2) (== 0 (strcmp fn "domain_error")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (coco_err_say m (coco_arg m f 1) a2 (sizeof a2))
                       (snprintf out len "Domain error: `%s' expected, found `%s'" a1 a2)
                       (return)))

            (if (and (== fa 3) (== 0 (strcmp fn "permission_error")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (coco_err_say m (coco_arg m f 1) a2 (sizeof a2))
                       (coco_err_say m (coco_arg m f 2) a3 (sizeof a3))
                       (snprintf out len "No permission to %s %s `%s'" a1 a2 a3)
                       (return)))

            (if (and (== fa 1) (== 0 (strcmp fn "evaluation_error")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (snprintf out len "Arithmetic: evaluation error: `%s'" a1)
                       (return)))

            (if (and (== fa 1) (== 0 (strcmp fn "representation_error")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (snprintf out len "Cannot represent due to `%s'" a1)
                       (return)))

            (if (and (== fa 1) (== 0 (strcmp fn "resource_error")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (snprintf out len "Not enough resources: `%s'" a1)
                       (return)))

            (if (and (== fa 1) (== 0 (strcmp fn "syntax_error")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (snprintf out len "Syntax error: %s" a1)
                       (return)))

            ;; cocolog's own ball, which carries a sentence and not a term:
            ;; `cocolog_error('use_module: p.pl: no such file')' is already
            ;; the message, and wrapping it in "Unknown error term" would
            ;; hide the one useful thing in it.
            (if (and (== fa 1) (== 0 (strcmp fn "cocolog_error")))
                (let ((size_t w . #'(coco_deref m (coco_arg m f 0))))
                  (if (and (coco_is_callable m w) (== (coco_arity m w) 0))
                      (block (snprintf out len "%s" (coco_atom_name m (coco_name_of m w)))
                             (return)))
                  (coco_err_say m w a1 (sizeof a1))
                  (snprintf out len "%s" a1)
                  (return)))

            (coco_err_say m f a1 (sizeof a1))
            (snprintf out len "Unknown error term: %s" a1))))

  (func coco_engine_error_text ((coco_engine * e) (char * out) (size_t len)) (out int)
        (if (not (-> e has_ball)) (return 0))
        (coco_error_text (-> e m)
                         (coco_store_get (-> e m) (-> e st) (-> e ball_cell))
                         out len)
        (return 1))

  ;;; ---- calling ------------------------------------------------------------

  ;;; if-then-else, and the three things built out of it. Reads as:
  ;;;
  ;;;   push an alternative that runs ELSE
  ;;;   run COND, then cut away that alternative, then run THEN
  ;;;
  ;;; The cut is a `'$cut'(H)' goal put between them, where H is the height the
  ;;; stack had before the alternative was pushed. COND runs under a barrier of
  ;;; its own, so a `!' inside a condition is local to it -- which is what the
  ;;; standard says and what makes `( ! ; true )' behave.
  (static)
  (func coco_ite ((coco_engine * e) (size_t c) (size_t t) (size_t els) (size_t k) (size_t b))
        (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t h0 . #'(-> e nchoices)))
          (if (not (coco_push_choice e COCO_CH_GOAL els k b)) (return 0))
          (let ((size_t k1 . #'(coco_k_push e t b k))
                (size_t cut . #'(coco_make1_f m (coco-fid m "$cut" 1) (coco_new_int m (cast i64 h0)))))
            (set (-> e goals) (coco_k_push e c (-> e nchoices) (coco_k_push e cut b k1))))
          (return 1)))

  ;;; The SOFT cut, `(C *-> T ; E)'. It differs from if-then-else in one
  ;;; place and one only: when C succeeds, T runs for EVERY solution of C, not
  ;;; just the first. So the alternative that runs E has to go while C's own
  ;;; choice points stay -- which is why `$cut' will not do here. `$cut'
  ;;; truncates the stack to a height, and everything C pushed is above the
  ;;; frame holding E.
  ;;;
  ;;; `$softcut'(H) kills the one frame at H instead, leaving the rest alone.
  (static)
  (func coco_soft_ite ((coco_engine * e) (size_t c) (size_t t) (size_t els)
                       (size_t k) (size_t b))
        (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t h0 . #'(-> e nchoices)))
          (if (not (coco_push_choice e COCO_CH_GOAL els k b)) (return 0))
          (let ((size_t k1 . #'(coco_k_push e t b k))
                (size_t sc . #'(coco_make1_f m (coco-fid m "$softcut" 1) (coco_new_int m (cast i64 h0)))))
            (set (-> e goals) (coco_k_push e c (-> e nchoices) (coco_k_push e sc b k1))))
          (return 1)))

  ;;; ---- the heap collector ---------------------------------------------------
  ;;;
  ;;; THE HEAP WAS RECLAIMED BY BACKTRACKING AND BY NOTHING ELSE, which is
  ;;; exactly right for a failure-driven loop and does nothing for a
  ;;; recursion that succeeds: `count(2000000)' -- three lines of Prolog --
  ;;; held 560 MB at the end, every continuation it had ever built still on
  ;;; the heap. A binarized machine allocates a continuation per inference
  ;;; (DESIGN-compiling.md section 10.1), so this was the binding limit on
  ;;; how long a deterministic program could run.
  ;;;
  ;;; A SLIDING COMPACTOR, MARK THEN SLIDE, AND IT KEEPS ORDER. Order is the
  ;;; property everything else stands on: a choice point's `heap_mark' says
  ;;; "every cell made after me is above here", backtracking truncates to it,
  ;;; and the binding rule (younger to older) says no cell points forward
  ;;; past a mark without a trail entry to undo it. A collector that kept
  ;;; the cells in order keeps all three true: a cell's new index is the
  ;;; number of kept cells below it, so everything below a mark stays below
  ;;; the mark's new value and everything above stays above. A copying
  ;;; collector would have to be taught the marks; this one gets them free.
  ;;;
  ;;; THE ROOTS are everything that names a cell from outside the heap: the
  ;;; continuation, the query (the CLI prints it), the tracer's current goal,
  ;;; and for every choice frame its goal and its continuation and the
  ;;; tracer's shadow goal -- plus the arrays a host registered with
  ;;; `coco_heap_root_push'. Marking follows the CURRENT bindings, which
  ;;; keeps a little more than strictly needed (a variable a choice point
  ;;; would unbind keeps its present value alive) and never less.
  ;;;
  ;;; THE TRAIL IS COMPACTED WITH IT, and needs to be: every binding is
  ;;; trailed, so a deterministic loop grew the trail as surely as the heap
  ;;; (32 MB beside the 560). An entry is kept only if some choice point
  ;;; could undo it -- one made before the entry, with the bound cell below
  ;;; that choice point's heap mark -- and only if the cell is kept at all.
  ;;; With no choice points the trail empties.
  ;;;
  ;;; ONE THING HIDES AN INDEX IN AN INTEGER: the tracer's `$trace_exit'
  ;;; marker carries the goal it closes and the call it returns to as INT
  ;;; arguments, so a frozen machine stays a row of numbers. Those two are
  ;;; treated as roots and rewritten like any other index.
  ;;;
  ;;; WHEN: at the top of the engine's loop, between two steps, which is the
  ;;; one place no C frame of the engine holds an index -- and only when its
  ;;; host said yes (`gc' on the engine). A nested engine says yes when the
  ;;; builtin that started it registered every cell its own frame holds and
  ;;; its outer engine may collect (1.9.4): the engines part way through a
  ;;; step are found on the machine's chain (`eng', `outer'). After a
  ;;; collection the next one waits until the heap has grown by as much
  ;;; again as survived, and by at least `coco_gc_floor' cells: amortised,
  ;;; the work is a constant per cell allocated.
  ;;;
  ;;; NOT COMPACTED HERE: the float and string tables (the store shares
  ;;; them by index -- see `coco_store_put_node'), and the atom table (a
  ;;; frozen machine's cells name atoms by id).

  ;;; Cells per collection at the least: 4M, 32 MB. A program whose heap
  ;;; never reaches it never collects, so everything small behaves exactly
  ;;; as it did. `COCOLOG_GC_CELLS' sets it -- small values make every run a
  ;;; stress test of the roots, which is what it is there for.
  (static)
  (func coco_gc_floor () (out size_t)
        (let ((const char * s . #'(getenv "COCOLOG_GC_CELLS"))
              (size_t v . 0))
          (if (and (!= s nil) (!= (nth 0 s) (cast char 0)))
              (set v (cast size_t (strtoull s nil 10))))
          (return (? (> v 0) v 4194304))))

  ;;; A population count, written out as the usual SWAR sum: the compiler's
  ;;; builtin is not something Cicili declares. Each mask is below 2^63, so
  ;;; each is a plain literal.
  (static)
  (func coco_gc_popcount ((u64 x)) (out u64)
        (set x (- x (bitand (>> x 1) 6148914691236517205)))
        (set x (+ (bitand x 3689348814741910323) (bitand (>> x 2) 3689348814741910323)))
        (set x (bitand (+ x (>> x 4)) 1085102592571150095))
        (return (>> (* x 72340172838076673) 56)))

  (static)
  (func coco_gc_marked ((u64 * bits) (size_t i)) (out int)
        (return (? (== 0 (bitand (nth (>> i 6) bits) (<< (cast u64 1) (bitand i 63)))) 0 1)))

  ;;; Where cell I lands: the number of kept cells below it. PRE holds the
  ;;; count before each word, so this is a load and a popcount. Defined for
  ;;; every I up to and including the old heap length -- a choice point's
  ;;; mark is often exactly that -- which is why PRE is one longer than BITS.
  (static)
  (func coco_gc_rank ((u64 * bits) (size_t * pre) (size_t i)) (out size_t)
        (let ((size_t w . #'(>> i 6))
              (size_t b . #'(bitand i 63)))
          (if (== b 0) (return (nth w pre)))
          (return (+ (nth w pre)
                     (cast size_t (coco_gc_popcount
                                   (bitand (nth w bits) (- (<< (cast u64 1) b) 1))))))))

  (static)
  (func coco_gc_push ((size_t ** s) (size_t * len) (size_t * cap) (size_t v)) (out int)
        (if (>= (cof len) (cof cap))
            (let ((size_t ncap . #'(? (== (cof cap) 0) 1024 (* (cof cap) 2)))
                  (void * nb))
              (set nb (realloc (cast (void *) (cof s)) (* ncap (sizeof size_t))))
              (if (== nb nil) (return 0))
              (set (cof s) (cast (size_t *) nb))
              (set (cof cap) ncap)))
        (set (nth (cof len) (cof s)) v)
        (set (cof len) (+ (cof len) 1))
        (return 1))

  ;;; Marks everything reachable from ROOT. Iterative, like every other walk
  ;;; over terms here: a list is a chain of compounds as long as the list.
  ;;; A compound's header marks all its arguments, so a kept compound stays
  ;;; contiguous; an argument cell reached on its own (a variable inside a
  ;;; structure nobody else keeps) is kept on its own, which is sound
  ;;; because every cell describes itself. Answers 0 only when the mark stack
  ;;; could not grow -- and then the collection is abandoned, because acting
  ;;; on an incomplete mark is the one thing a collector must never do.
  ;;; TEXIT is `$trace_exit'/3's functor id; NMARKERS counts them.
  (static)
  (func coco_gc_mark ((coco_machine * m) (u64 * bits) (size_t ** s) (size_t * len)
                      (size_t * cap) (u64 texit) (size_t * nmarkers) (size_t root)) (out int)
        (let ((size_t n . #'(-> m heap_len)))
          (if (or (>= root n) (coco_gc_marked bits root)) (return 1))
          (if (not (coco_gc_push s len cap root)) (return 0))
          (while (> (cof len) 0)
            (set (cof len) (- (cof len) 1))
            (let ((size_t t . #'(nth (cof len) (cof s))))
              (if (or (>= t n) (coco_gc_marked bits t)) continue)
              (set (nth (>> t 6) bits)
                   (bitor (nth (>> t 6) bits) (<< (cast u64 1) (bitand t 63))))
              (let ((u64 c . #'(nth t (-> m heap))))
                (cond
                  ((coco-tag-is REF c)
                   (let ((size_t p . #'(cast size_t (coco-payload c))))
                     (if (and (!= p t) (< p n) (not (coco_gc_marked bits p)))
                         (if (not (coco_gc_push s len cap p)) (return 0)))))
                  ;; A POSITION KEEPS ITS WHOLE ENVIRONMENT (Stage 5): the
                  ;; header it names, and so every slot and every other
                  ;; position -- the distance back is the environment's own,
                  ;; which a compound kept whole keeps
                  ((coco-tag-is POS c)
                   (let ((size_t hd . #'(- t (>> (cast size_t (coco-payload c)) 16))))
                     (if (and (< hd n) (not (coco_gc_marked bits hd)))
                         (if (not (coco_gc_push s len cap hd)) (return 0)))))
                  ((coco-tag-is FUN c)
                   (let ((u64 f . #'(coco-payload c))
                         (u32 a . #'($ (nth (cast size_t f) (-> m functors)) arity)))
                     (for ((u32 k . 0)) (< k a) ((++ k))
                       (let ((size_t q . #'(+ t (+ (cast size_t k) 1))))
                         (if (and (< q n) (not (coco_gc_marked bits q)))
                             (if (not (coco_gc_push s len cap q)) (return 0)))))
                     ;; the tracer's marker: its first and third arguments are
                     ;; goal indices written as integers, and they are roots
                     (if (== f texit)
                         (block
                          (set (cof nmarkers) (+ (cof nmarkers) 1))
                          (for ((u32 k . 0)) (< k 3) ((set k (+ k 2)))
                            (let ((size_t j . #'(coco_deref m (+ t (+ (cast size_t k) 1)))))
                              (if (coco-tag-is INT (nth j (-> m heap)))
                                  (let ((i64 q . #'(coco-signed-payload (nth j (-> m heap)))))
                                    (if (and (>= q 0) (< (cast size_t q) n)
                                             (not (coco_gc_marked bits (cast size_t q))))
                                        (if (not (coco_gc_push s len cap (cast size_t q)))
                                            (return 0)))))))))))))))
          (return 1)))

  ;;; A root's new value: its rank if it named a cell, unchanged if it did
  ;;; not -- a stale index (a thawed machine's shadow frames are not zeroed
  ;;; by the realloc that makes them) is left to mean what it meant, nothing.
  ;;; LIMIT is N for a cell and N+1 for a mark, which may equal the length.
  (static)
  (func coco_gc_moved ((u64 * bits) (size_t * pre) (size_t limit) (size_t i)) (out size_t)
        (return (? (< i limit) (coco_gc_rank bits pre i) i)))

  ;;; RETIRED CODES (Stage 5): a dead clause's code is kept while an
  ;;; environment names it, and the mark has just found every environment
  ;;; there is -- a marked `'$e'' compound whose first slot is the address
  ;;; of a code on the store's retired list. Those are kept, the rest freed
  ;;; (`coco_code_sweep'). An address is looked up among the retired ones,
  ;;; so a program's own `'$e'' term, whatever it holds, keeps nothing that
  ;;; is not one, and touches nothing.
  (static)
  (func coco_gc_codes ((coco_engine * e) (u64 * bits) (size_t n))
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (coco_kmemo set . '{ nil nil 0 0 })
              (u64 epoch . #'(+ (cast u64 (-> m gc_count)) 1))
              (u64 eid . #'(coco-id m "$e"))
              (size_t nw . #'(>> (+ n 63) 6))
              (coco_code * cd . nil))
          (set cd (cast (coco_code *) (-> st retired)))
          (while (!= cd nil)
            ;; no memory for the table: nothing is freed this time
            (if (not (coco_kmemo_put (aof set) (cast u64 (cast size_t cd)) 1))
                (block (free ($ set keys)) (free ($ set vals)) (return)))
            (set cd (cast (coco_code *) (-> cd rnext))))
          (for ((size_t w . 0)) (< w nw) ((++ w))
            (if (!= (nth w bits) 0)
                (for ((size_t b . 0)) (< b 64) ((++ b))
                  (let ((size_t t . #'(+ (<< w 6) b)))
                    (if (and (< (+ t 1) n) (coco_gc_marked bits t))
                        (let ((u64 c . #'(nth t (-> m heap))))
                          (if (and (coco-tag-is FUN c)
                                   (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) eid)
                                   (>= ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 4)
                                   (coco-tag-is INT (nth (+ t 1) (-> m heap))))
                              (let ((size_t got . 0)
                                    (u64 a . #'(cast u64 (coco-signed-payload (nth (+ t 1) (-> m heap))))))
                                (if (and (!= a 0) (coco_kmemo_get (aof set) a (aof got)))
                                    (let ((coco_code * rc . #'(cast (coco_code *) (cast size_t a))))
                                      (set (-> rc gcmark) epoch)))))))))))
          (free ($ set keys)) (free ($ set vals))
          (coco_code_sweep st epoch)))

  ;;; NOT STATIC (1.9.4): a static function with one caller is inlined
  ;;; whatever its size, and the collector inlined into `coco_engine_run'
  ;;; cost the step loop the register it kept the engine in -- four
  ;;; instructions a step on naive reverse, once the collector learned the
  ;;; chain of engines. It runs once in millions of steps.
  (func coco_heap_collect ((coco_engine * e))
        (let ((coco_machine * m . #'(-> e m))
              (size_t n . #'(-> m heap_len))
              (size_t nw . #'(>> (+ n 63) 6))
              (u64 * bits . nil) (size_t * pre . nil)
              (size_t * stk . nil) (size_t slen . 0) (size_t scap . 0)
              (u64 * fixed . nil) (size_t nmarkers . 0)
              (u64 texit . 0) (int ok . 1)
              (size_t ** tmp . nil) (size_t ** hmp . nil) (size_t nbar . 0))
          (set texit (coco_functor_id m (coco-id m "$trace_exit") 3))
          (set bits (cast (u64 *) (calloc (+ nw 1) (sizeof u64))))
          (set pre (cast (size_t *) (malloc (* (+ nw 1) (sizeof size_t)))))
          (if (or (== bits nil) (== pre nil)) (set ok 0))

          ;; ---- mark: EVERY ENGINE ON THE MACHINE'S CHAIN (1.9.4), this
          ;; one first and then each whose builtin started the one inside
          ;; it -- its continuation, its query, the tracer's goal and its
          ;; frames, and for an engine part way through a module's call that
          ;; call's goal and continuation (`kcall', `kgoal'). Through 1.9.3
          ;; only an engine alone on its machine collected.
          (let ((coco_engine * x . e))
            (while (and ok (!= x nil))
              (if ok (set ok (coco_gc_mark m bits (aof stk) (aof slen) (aof scap) texit
                                           (aof nmarkers) (-> x goals))))
              (if ok (set ok (coco_gc_mark m bits (aof stk) (aof slen) (aof scap) texit
                                           (aof nmarkers) (-> x query))))
              (if ok (set ok (coco_gc_mark m bits (aof stk) (aof slen) (aof scap) texit
                                           (aof nmarkers) (-> x trace_goal))))
              (if (and ok (!= x e))
                  (block
                   (set ok (coco_gc_mark m bits (aof stk) (aof slen) (aof scap) texit
                                         (aof nmarkers) (-> x kgoal)))
                   (if ok (set ok (coco_gc_mark m bits (aof stk) (aof slen) (aof scap) texit
                                                (aof nmarkers) (-> x kcall))))))
              (for ((size_t k . 0)) (and ok (< k (-> x nchoices))) ((++ k))
                (set ok (coco_gc_mark m bits (aof stk) (aof slen) (aof scap) texit
                                      (aof nmarkers) ($ (nth k (-> x choices)) call)))
                (if ok (set ok (coco_gc_mark m bits (aof stk) (aof slen) (aof scap) texit
                                             (aof nmarkers) ($ (nth k (-> x choices)) goals))))
                (if (and ok (!= (-> x tchoices) nil))
                    (set ok (coco_gc_mark m bits (aof stk) (aof slen) (aof scap) texit
                                          (aof nmarkers) ($ (nth k (-> x tchoices)) goal)))))
              ;; a frame per choice point, and one for the marks a nested
              ;; engine's builtin winds back to
              (set nbar (+ nbar (-> x nchoices)))
              (if (!= (-> x outer) nil) (set nbar (+ nbar 1)))
              (set x (cast (coco_engine *) (-> x outer)))))

          ;; THE TRAIL'S BARRIERS, OLDEST FIRST: the outermost engine's choice
          ;; points, then for each engine inside it the marks its builtin took
          ;; before starting it (`ptrail', `pheap') and that engine's own
          ;; points -- each made after everything before it in this order, so
          ;; their trail marks never fall (the trail pass below needs that)
          (if (and ok (> nbar 0))
              (let ((size_t nch . 0) (size_t at . 0) (coco_engine ** ch . nil))
                (let ((coco_engine * x . e))
                  (while (!= x nil) (set nch (+ nch 1)) (set x (cast (coco_engine *) (-> x outer)))))
                (set tmp (cast (size_t **) (malloc (* nbar (sizeof (size_t *))))))
                (set hmp (cast (size_t **) (malloc (* nbar (sizeof (size_t *))))))
                (set ch (cast (coco_engine **) (malloc (* nch (sizeof (coco_engine *))))))
                (if (or (== tmp nil) (== hmp nil) (== ch nil)) (set ok 0))
                (if ok
                    (let ((coco_engine * x . e) (size_t d . 0))
                      (while (!= x nil)
                        (set (nth d ch) x)
                        (set d (+ d 1))
                        (set x (cast (coco_engine *) (-> x outer))))
                      ;; outermost first
                      (while (> d 0)
                        (set d (- d 1))
                        (let ((coco_engine * y . #'(nth d ch)))
                          (if (!= (-> y outer) nil)
                              (block (set (nth at tmp) (aof (-> y ptrail)))
                                     (set (nth at hmp) (aof (-> y pheap)))
                                     (set at (+ at 1))))
                          (for ((size_t k . 0)) (< k (-> y nchoices)) ((++ k))
                            (set (nth at tmp) (aof ($ (nth k (-> y choices)) trail_mark)))
                            (set (nth at hmp) (aof ($ (nth k (-> y choices)) heap_mark)))
                            (set at (+ at 1)))))))
                (free (cast (void *) ch))))

          (for ((size_t r . 0)) (and ok (< r (-> m nhroots))) ((++ r))
            (let ((size_t * arr . #'(cof ($ (nth r (-> m hroots)) cells)))
                  (size_t alen . #'(cof ($ (nth r (-> m hroots)) len))))
              (for ((size_t i . 0)) (and ok (< i alen)) ((++ i))
                (set ok (coco_gc_mark m bits (aof stk) (aof slen) (aof scap) texit
                                      (aof nmarkers) (nth i arr))))))
          (if (and ok (> nmarkers 0))
              (block (set fixed (cast (u64 *) (calloc (+ nw 1) (sizeof u64))))
                     (if (== fixed nil) (set ok 0))))

          (if (not ok)
              ;; NOTHING HAS MOVED YET, so giving up is free: only memory ran
              ;; out, and the next try waits until the heap has doubled
              (block (free bits) (free pre) (free stk) (free fixed)
                     (free (cast (void *) tmp)) (free (cast (void *) hmp))
                     (set (-> m gc_next) (* (-> m heap_len) 2))
                     (return)))

          ;; ---- the retired codes no environment names any more (Stage 5),
          ;; while the mark still says which environments there are
          (if (!= (-> (-> e st) retired) nil) (coco_gc_codes e bits n))

          ;; ---- where everything goes ----
          (set (nth 0 pre) 0)
          (for ((size_t w . 0)) (< w nw) ((++ w))
            (set (nth (+ w 1) pre) (+ (nth w pre) (cast size_t (coco_gc_popcount (nth w bits))))))

          ;; ---- the tracer's integer indices, while the old ones can still
          ;; be followed: every marker's two INT cells, each rewritten once
          (if (> nmarkers 0)
              (for ((size_t w . 0)) (< w nw) ((++ w))
                (if (!= (nth w bits) 0)
                    (for ((size_t b . 0)) (< b 64) ((++ b))
                      (let ((size_t t . #'(+ (<< w 6) b)))
                        (if (and (< t n) (coco_gc_marked bits t)
                                 (coco-tag-is FUN (nth t (-> m heap)))
                                 (== (coco-payload (nth t (-> m heap))) texit))
                            (for ((u32 k . 0)) (< k 3) ((set k (+ k 2)))
                              (let ((size_t j . #'(coco_deref m (+ t (+ (cast size_t k) 1)))))
                                (if (and (coco-tag-is INT (nth j (-> m heap)))
                                         (not (coco_gc_marked fixed j)))
                                    (let ((i64 q . #'(coco-signed-payload (nth j (-> m heap)))))
                                      (set (nth (>> j 6) fixed)
                                           (bitor (nth (>> j 6) fixed) (<< (cast u64 1) (bitand j 63))))
                                      (if (and (>= q 0) (< (cast size_t q) n))
                                          (set (nth j (-> m heap))
                                               (coco-int-cell (cast i64 (coco_gc_rank bits pre (cast size_t q))))))))))))))))

          ;; ---- the trail, against the OLD heap marks, over the barriers in
          ;; the order they were made (`tmp', `hmp': every engine's choice
          ;; points and each nested engine's starting marks) ----
          (let ((size_t tl . #'(-> m trail_len))
                (size_t kept . 0) (size_t f . 0))
            (for ((size_t p . 0)) (< p tl) ((++ p))
              ;; every barrier made at or before this entry: its new trail
              ;; mark is the number of entries kept before it
              (while (and (< f nbar) (<= (cof (nth f tmp)) p))
                (set (cof (nth f tmp)) kept)
                (set f (+ f 1)))
              (if (> f 0)
                  (let ((size_t v . #'(nth p (-> m trail))))
                    (if (and (< v n) (< v (cof (nth (- f 1) hmp)))
                             (coco_gc_marked bits v))
                        (block (set (nth kept (-> m trail)) (coco_gc_rank bits pre v))
                               (set kept (+ kept 1)))))))
            (while (< f nbar)
              (set (cof (nth f tmp)) kept)
              (set f (+ f 1)))
            (set (-> m trail_len) kept))

          ;; ---- the roots, every engine's on the chain ----
          (let ((coco_engine * x . e))
            (while (!= x nil)
              (set (-> x goals) (coco_gc_moved bits pre n (-> x goals)))
              (set (-> x query) (coco_gc_moved bits pre n (-> x query)))
              (set (-> x trace_goal) (coco_gc_moved bits pre n (-> x trace_goal)))
              (if (!= x e)
                  (block (set (-> x kgoal) (coco_gc_moved bits pre n (-> x kgoal)))
                         (set (-> x kcall) (coco_gc_moved bits pre n (-> x kcall)))))
              (if (!= (-> x outer) nil)
                  (set (-> x pheap) (coco_gc_moved bits pre (+ n 1) (-> x pheap))))
              (for ((size_t k . 0)) (< k (-> x nchoices)) ((++ k))
                (let ((coco_choice * c . #'(aof (nth k (-> x choices)))))
                  (set (-> c call) (coco_gc_moved bits pre n (-> c call)))
                  (set (-> c goals) (coco_gc_moved bits pre n (-> c goals)))
                  (set (-> c heap_mark) (coco_gc_moved bits pre (+ n 1) (-> c heap_mark))))
                (if (!= (-> x tchoices) nil)
                    (set ($ (nth k (-> x tchoices)) goal)
                         (coco_gc_moved bits pre n ($ (nth k (-> x tchoices)) goal)))))
              (set x (cast (coco_engine *) (-> x outer)))))
          (free (cast (void *) tmp)) (free (cast (void *) hmp))
          (for ((size_t r . 0)) (< r (-> m nhroots)) ((++ r))
            (let ((size_t * arr . #'(cof ($ (nth r (-> m hroots)) cells)))
                  (size_t alen . #'(cof ($ (nth r (-> m hroots)) len))))
              (for ((size_t i . 0)) (< i alen) ((++ i))
                (set (nth i arr) (coco_gc_moved bits pre n (nth i arr))))))

          ;; ---- slide: every kept cell down to its rank, references
          ;; rewritten on the way. A cell's rank is never above its index, so
          ;; one pass upward never overwrites a cell it has yet to read.
          (let ((size_t dst . 0))
            (for ((size_t w . 0)) (< w nw) ((++ w))
              (if (!= (nth w bits) 0)
                  (for ((size_t b . 0)) (< b 64) ((++ b))
                    (let ((size_t i . #'(+ (<< w 6) b)))
                      (if (and (< i n) (coco_gc_marked bits i))
                          (let ((u64 c . #'(nth i (-> m heap))))
                            (if (coco-tag-is REF c)
                                (let ((size_t p . #'(cast size_t (coco-payload c))))
                                  (if (< p n)
                                      (set c (coco-cell REF (coco_gc_rank bits pre p))))))
                            (set (nth dst (-> m heap)) c)
                            (set dst (+ dst 1))))))))
            (set (-> m heap_len) dst))

          ;; the next collection waits for as much growth again as survived,
          ;; and for at least the floor
          (let ((size_t floor . #'(coco_gc_floor)))
            (set (-> m gc_next) (+ (-> m heap_len)
                                   (? (> (-> m heap_len) floor) (-> m heap_len) floor))))
          (set (-> m gc_count) (+ (-> m gc_count) 1))
          (free bits) (free pre) (free stk) (free fixed)))

  ;;; THE FREEZE, TORTURED (`COCOLOG_KMAT'). A freeze is right or wrong only
  ;;; on a freeze, and freezes are rare, so this puts every collection
  ;;; through one before anything is marked: 1 materialises the
  ;;; continuation and puts it back, as a freeze does to the live machine
  ;;; around its image (`coco_engine_materialize' and its undo); 2
  ;;; materialises it and keeps it, so the run goes on from the `'$k''
  ;;; frames a thawed machine starts from, and the collection that follows
  ;;; frees the environments nothing names any more. With
  ;;; `COCOLOG_GC_CELLS=2000' that is every 2000 cells; unset, it is one
  ;;; `getenv' per collection. Every answer, every inference count and
  ;;; every stop come out the same either way, which is what a run under
  ;;; it checks. A child process inherits it, as it inherits the floor.
  (static)
  (func coco_kmat_tortured ((coco_engine * e))
        (let ((const char * s . #'(getenv "COCOLOG_KMAT"))
              (int kt . 0))
          (if (and (!= s nil) (!= (nth 0 s) (cast char 0)))
              (set kt (cast int (strtol s nil 10))))
          (if (> kt 0)
              (let ((coco_kmat sv))
                (if (coco_engine_materialize e (aof sv))
                    (if (== kt 1)
                        (coco_engine_materialize_undo e (aof sv))
                        ;; kept: only the record of what it changed goes
                        (block (free ($ sv cgoals)) (free ($ sv ccalls))
                               (free ($ sv cmarks)))))))))

  ;;; A COLLECTION, the freeze's torture first when it is asked for
  (static)
  (func coco_heap_gc ((coco_engine * e))
        (coco_kmat_tortured e)
        (coco_heap_collect e))

  ;;; ---- the loop -----------------------------------------------------------

  (func coco_engine_init ((coco_engine * e) (coco_machine * m) (coco_store * st))
        (memset e 0 (sizeof coco_engine))
        (set (-> e m) m)
        (set (-> e st) st)
        (set (-> e trace) coco_trace_default))

  (func coco_engine_free ((coco_engine * e))
        (free (-> e choices))
        (free (-> e tchoices))
        (memset e 0 (sizeof coco_engine)))

  (func coco_engine_ask ((coco_engine * e) (size_t goal))
        (set (-> e nchoices) 0)
        (set (-> e steps) 0)
        (set (-> e resume) 0)
        (set (-> e halted) 0)
        ;; `halt' is `halt(0)': halt/0 sets only the flag, so the code it
        ;; leaves behind must be zero rather than the last query's
        (set (-> e halt_code) 0)
        ;; and no ball in hand: `has_ball' outlives the query that set it
        ;; otherwise, and the next error that is NOT a ball -- an inference
        ;; limit, a goal that is not callable -- would be reported with the
        ;; last one's term
        ;; and the last one's cell, kept for an outer engine to throw again,
        ;; is an orphan by now: counted, never touched, since a compaction in
        ;; between may already have taken it
        (if (-> e has_ball)
            (let ((coco_store * bst . #'(-> e st)))
              (set (-> bst dead) (+ (-> bst dead) (-> e ball_size)))))
        (set (-> e has_ball) 0)
        (set (nth 0 (-> e err)) (cast char 0))
        (set (-> e query) goal)
        (set (-> e trace_depth) 0)
        (set (-> e trace_goal) 0)
        ;; and no goal handed over by a query that is gone
        (set (-> e nset) 0)
        ;; NOR ANY ENVIRONMENT (Stage 5): with nothing running on the
        ;; machine and a host that lets the collector run -- one that keeps
        ;; no second engine's continuation on this heap -- every code a dead
        ;; clause retired is named by nothing that can run again
        (if (and (-> e gc) (== (-> (-> e m) running) 0) (!= (-> (-> e st) retired) nil))
            (coco_code_retired_free (-> e st)))
        (set (-> e goals) (coco_k_push e goal 0 (coco_k_empty e))))

  ;;; A SEARCH A BUILTIN STARTS COLLECTS ONLY ONCE IT HAS GROWN BY THE FLOOR
  ;;; ITSELF (1.9.4): most are short, and what a findall built goes when it
  ;;; ends, for nothing. So the threshold is raised to the floor above the
  ;;; heap where the search starts (HMARK) and put back when it ends -- unless
  ;;; it is 0 then, a request (`garbage_collect/0') made inside that nothing
  ;;; there could serve, which waits for the outer engine.
  (func coco_gc_nested_begin ((coco_machine * m) (size_t hmark)) (out size_t)
        (let ((size_t saved . #'(-> m gc_next))
              (size_t at . #'(+ hmark (-> m gc_floor))))
          (if (< (-> m gc_next) at) (set (-> m gc_next) at))
          (return saved)))

  (func coco_gc_nested_end ((coco_machine * m) (size_t saved))
        (if (!= (-> m gc_next) 0) (set (-> m gc_next) saved)))

  (func coco_engine_findall ((coco_engine * e) (size_t template) (size_t goal)
                          (size_t * out) (size_t * gp)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (coco_engine sub)
              (size_t * kept . nil) (size_t n . 0) (size_t cap . 0)
              (int ok . 1) (int rc . 0) (int threw . 0) (size_t ball_cell . 0)
              (size_t ball_size . 0) (size_t kept_cells . 0)
              ;; WHAT THIS FRAME HOLDS ON THE HEAP, told to the collector for
              ;; the search (1.9.4): the template, the goal, and the caller's
              ;; own goal cell (GP, nil when it keeps none), each read back
              ;; from here after the search
              (size_t hold [3]) (size_t * holdp . nil) (size_t nhold . 3) (int held . 0)
              (size_t gsaved . 0))
          (set (nth 0 hold) template)
          (set (nth 1 hold) goal)
          (set (nth 2 hold) (? (== gp nil) 0 (cof gp)))
          (set holdp hold)

          ;; WHERE THE MACHINE STOOD BEFORE THE SEARCH. The sub-engine's last
          ;; solution leaves its bindings on the trail: the final clause of a
          ;; predicate drops its own choice point, so there is no frame left to
          ;; backtrack through and undo them. Without this, `findall(X, p(X,Y),
          ;; L)' comes back with Y still bound to whatever the last solution
          ;; made it -- which is invisible until something reuses Y, and then
          ;; the next goal sees one solution where there were four.
          (let ((size_t tmark . #'($ (cof m) trail_len))
                (size_t hmark . #'($ (cof m) heap_len)))

          ;; `kept' holds cell indices of its own until they are read back
          ;; below, so the store is told where they are: a compaction during
          ;; the search -- a `forall/2' IS one -- moves them with the rest
          (coco_store_root_push st (aof kept) (aof n))
          (set held (coco_heap_root_push m (aof holdp) (aof nhold)))
          (coco_engine_init (aof sub) m st)
          ;; the inner search spends the outer one's remaining budget, so a
          ;; `cocolog step' with a step limit cannot be overrun by a findall
          (if (!= (-> e max_steps) 0)
              (set ($ sub max_steps)
                   (? (>= (-> e steps) (-> e max_steps)) 1
                      (- (-> e max_steps) (-> e steps)))))
          (coco_engine_ask (aof sub) goal)
          ;; the trace follows the proof into the inner engine, depth and
          ;; all -- set after the ask, which resets a fresh engine's context
          (set ($ sub trace) (-> e trace))
          (set ($ sub trace_depth) (-> e trace_depth))
          (set ($ sub trace_goal) (-> e trace_goal))
          ;; THE SEARCH MAY COLLECT (1.9.4) when this engine may and nothing
          ;; is traced (the tracer's ports read goals the loop holds): the
          ;; marks the machine is wound back to below go with the inner
          ;; engine, where the collector keeps them true as it moves cells
          (set ($ sub ptrail) tmark)
          (set ($ sub pheap) hmark)
          (set ($ sub gc) (? (and held (-> e gc) (== (-> e trace) 0)) 1 0))
          (set gsaved (coco_gc_nested_begin m hmark))

          (while 1
            (set rc (coco_engine_next (aof sub)))
            (if (== rc -1)
                (block (snprintf (-> e err) 192 "%s" ($ sub err))
                       ;; AND THE BALL WITH IT. The sub-engine's cell is in
                       ;; the store, which both engines share, so the outer
                       ;; one can name what was thrown -- without this a
                       ;; findall whose goal threw reported the raw term
                       ;; where every other error reads as a sentence.
                       ;;
                       ;; The cell is read HERE, before `coco_engine_free'
                       ;; memsets the sub-engine; the ball is thrown again
                       ;; below, once the machine is back where it was.
                       (if ($ sub has_ball)
                           (block (set threw 1) (set ball_cell ($ sub ball_cell))
                                  (set ball_size ($ sub ball_size))))
                       (set ok 0) break))
            (if (== rc 0) break)
            (if (>= n cap)
                (let ((size_t ncap . #'(? (== cap 0) 16 (* cap 2)))
                      (size_t * nb))
                  (set nb (cast (size_t *) (realloc kept (* ncap (sizeof size_t)))))
                  (if (== nb nil)
                      (block (coco_fail_err e "out of memory in findall")
                             (set ok 0) break))
                  (set kept nb)
                  (set cap ncap)))
            ;; into the STORE, because the heap under us is about to be wound
            ;; back past this point -- the template where the collector left it
            (set (nth n kept) (coco_store_put st m (nth 0 hold)))
            (set kept_cells (+ kept_cells (- (-> st len) (nth n kept))))
            (set n (+ n 1)))

          ;; the outer engine's step count includes the inner search: a goal
          ;; that costs a million inferences inside a findall costs them
          (set (-> e steps) (+ (-> e steps) ($ sub steps)))
          (coco_gc_nested_end m gsaved)
          ;; and everything this frame told the collector, as it left it --
          ;; read before the free, which memsets the inner engine
          (set tmark ($ sub ptrail))
          (set hmark ($ sub pheap))
          (if held (coco_heap_root_pop m))
          (if (!= gp nil) (set (cof gp) (nth 2 hold)))
          (coco_engine_free (aof sub))

          ;; AND NOW THROW IT AGAIN, IN THE OUTER ENGINE. The sub-engine is a
          ;; whole engine with a choice stack of its own, so a `throw' inside
          ;; the goal found no catch frame there and came back as an error --
          ;; which every caller turned into -1, ending the query. So
          ;;
          ;;     catch(findall(X, r(X), L), E, true)
          ;;
          ;; did not catch anything, and neither did the same around
          ;; `forall/2' or `aggregate_all/3', which are this function too.
          ;; `coco_engine_call_limited' had the answer already: put the
          ;; machine back first, then throw from here, where the catch frames
          ;; are. 2 means the continuation now points at a recovery goal.
          (if threw
              (block (coco_undo_to m tmark)
                     (set ($ (cof m) heap_len) hmark)
                     (coco_store_root_pop st)
                     (free kept)
                     (set (-> st dead) (+ (-> st dead) (+ kept_cells ball_size)))
                     (return (? (== 1 (coco_throw e (coco_store_get m st ball_cell))) 2 0))))

          (if (not ok) (block (coco_undo_to m tmark)
                              (set ($ (cof m) heap_len) hmark)
                              (coco_store_root_pop st)
                              (free kept)
                              (set (-> st dead) (+ (-> st dead) kept_cells))
                              (return 0)))

          ;; put the machine back as it was, THEN build the answer. The
          ;; solutions are in the store and not on the heap, so truncating here
          ;; costs nothing and reclaims everything the search built.
          (coco_undo_to m tmark)
          (set ($ (cof m) heap_len) hmark)

          ;; back out of the store, in order, and on to the list
          (let ((size_t lst . #'(coco_new_atom m "[]")))
            (for ((size_t i . n)) (> i 0) ((-- i))
              (set lst (coco_cons m (coco_store_get m st (nth (- i 1) kept)) lst)))
            (coco_store_root_pop st)
            (free kept)
            (set (cof out) lst))
          ;; the solutions are on the heap now and their store copies are
          ;; orphans: a safe point, and one that produces garbage
          (set (-> st dead) (+ (-> st dead) kept_cells))
          (coco_store_maybe_compact st m)
          (return 1))))

  (func coco_engine_call_limited ((coco_engine * e) (size_t goal)
                                (u64 limit) (u64 * used) (size_t * gp)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (coco_engine sub)
              (size_t tmark . #'($ (cof m) trail_len))
              (size_t hmark . #'($ (cof m) heap_len))
              (int rc . 0) (int out . 0)
              ;; the caller's goal cell, told to the collector for the run
              ;; (1.9.4; `coco_engine_findall')
              (size_t hold [1]) (size_t * holdp . nil) (size_t nhold . 1) (int held . 0))
          (set (nth 0 hold) (? (== gp nil) 0 (cof gp)))
          (set holdp hold)
          (set held (coco_heap_root_push m (aof holdp) (aof nhold)))
          (coco_engine_init (aof sub) m st)
          (set ($ sub max_steps) limit)
          ;; narrowed to what the OUTER engine has left, never widened
          (if (!= (-> e max_steps) 0)
              (let ((u64 left . #'(? (>= (-> e steps) (-> e max_steps)) 1
                                     (- (-> e max_steps) (-> e steps)))))
                (if (< left limit) (set ($ sub max_steps) left))))
          (coco_engine_ask (aof sub) goal)
          (set ($ sub trace) (-> e trace))
          (set ($ sub trace_depth) (-> e trace_depth))
          (set ($ sub trace_goal) (-> e trace_goal))
          (set ($ sub ptrail) tmark)
          (set ($ sub pheap) hmark)
          (set ($ sub gc) (? (and held (-> e gc) (== (-> e trace) 0)) 1 0))
          (let ((size_t gsaved . #'(coco_gc_nested_begin m hmark)))
            (set rc (coco_engine_next (aof sub)))
            (coco_gc_nested_end m gsaved))
          (set (cof used) ($ sub steps))
          (set tmark ($ sub ptrail))
          (set hmark ($ sub pheap))
          (if held (coco_heap_root_pop m))
          (if (!= gp nil) (set (cof gp) (nth 0 hold)))
          ;; SPENT IS SPENT, whichever way it went: an outer budget that did
          ;; not count a fenced goal's inferences would be a hole big enough
          ;; to drive the whole loop through.
          (set (-> e steps) (+ (-> e steps) ($ sub steps)))
          (let ((int threw . 0) (size_t cell . 0) (size_t bsize . 0))
            (if (== rc 1) (set out 1))
            (if (== rc 0) (set out 0))
            (if (== rc -1)
                (if (== 0 (strcmp ($ sub err) "inference limit reached"))
                    (set out 2)
                  (block
                   ;; read the ball's cell BEFORE the free, which memsets it
                   (if ($ sub has_ball)
                       (block (set threw 1) (set cell ($ sub ball_cell))
                              (set bsize ($ sub ball_size))))
                   (snprintf (-> e err) 192 "%s" ($ sub err))
                   (set out -1))))
            (coco_engine_free (aof sub))
            ;; BINDINGS SURVIVE ONLY A SUCCESS, and on success the heap is NOT
            ;; truncated -- findall can truncate because it copied every
            ;; solution into the store, and this one's answer is the bindings
            ;; themselves, which point at cells the search built.
            (if (!= out 1)
                (block (coco_undo_to m tmark)
                       (set ($ (cof m) heap_len) hmark)))
            ;; and NOW throw it again, in the outer engine, after the machine
            ;; is back where it was -- `coco_throw' unwinds from here to
            ;; whatever catch frame matches, which is at or below this mark
            (if threw
                (block (set (-> st dead) (+ (-> st dead) bsize))
                       (set out (? (== 1 (coco_throw e (coco_store_get m st cell)))
                                   3 -1)))))
          (return out)))

  (func coco_engine_ask_text ((coco_engine * e) (const char * text)) (out int)
        (let ((size_t g))
          (if (not (coco_read_term_from (-> e m) text (aof g)))
              (block (snprintf (-> e err) 192 "could not read the goal") (return 0)))
          (coco_engine_ask e g)
          (return 1)))

  (static)
  ;;; A CONTROL CONSTRUCT, run: `true', `fail', `,', `!', the cuts, `;',
  ;;; `->', `*->', `\+', `once', `ignore', `call', `catch', `throw' and
  ;;; the engine's own markers. Out of the loop, and reached only for a
  ;;; goal whose name is a construct's (`coco_is_construct', one load),
  ;;; because the loop used to test every goal against two dozen construct
  ;;; names in turn before finding it was a predicate's -- which is what
  ;;; most goals are. Answers 1 when the construct ran (the continuation
  ;;; is set, OK says whether it proved), 0 when the name was a construct's
  ;;; but the goal was not (`call/0', `trace/0'), which the loop then
  ;;; treats as a predicate, and 2 when the loop must return RET at once.
  (static)
  (func coco_construct ((coco_engine * e) (u64 nid) (u32 n) (size_t g) (size_t k) (size_t b)
                        (int * ok) (int * ret)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (cond
                  ;; ---- control constructs ----
                  ((and (== n 0) (== nid (coco-id m "true")))
                   (if (-> e trace)
                       (block (coco_trace_port e "Call" (+ (-> e trace_depth) 1) g)
                              (coco_trace_port e "Exit" (+ (-> e trace_depth) 1) g)))
                   (set (-> e goals) k))

                  ((and (== n 0) (or (== nid (coco-id m "fail")) (== nid (coco-id m "false"))))
                   (if (-> e trace)
                       (block (coco_trace_port e "Call" (+ (-> e trace_depth) 1) g)
                              (coco_trace_port e "Fail" (+ (-> e trace_depth) 1) g)))
                   (set (cof ok) 0))

                  ;; the same two as the constructs above manufacture them:
                  ;; silent, because the program never wrote these
                  ((and (== n 0) (== nid (coco-id m "$true")))
                   (set (-> e goals) k))
                  ((and (== n 0) (== nid (coco-id m "$fail")))
                   (set (cof ok) 0))

                  ;; the tracer's own marker: the call it names has proven, so
                  ;; this is its Exit port. Transparent when tracing is off --
                  ;; a machine frozen mid-trace thaws and runs anywhere.
                  ((and (== n 3) (== nid (coco-id m "$trace_exit")))
                   (if (-> e trace)
                       (let ((size_t xg . #'(cast size_t (coco-signed-payload
                                                          (nth (coco_deref m (coco_arg m g 0)) (-> m heap)))))
                             (int xd . #'(cast int (coco-signed-payload
                                                    (nth (coco_deref m (coco_arg m g 1)) (-> m heap)))))
                             (size_t pg . #'(cast size_t (coco-signed-payload
                                                          (nth (coco_deref m (coco_arg m g 2)) (-> m heap))))))
                         (coco_trace_port e "Exit" xd xg)
                         ;; the newest live frame of this call remembers the
                         ;; exit, so failing back past untried heads that
                         ;; cannot match stays silent -- the quiet SWI's
                         ;; clause indexing buys by never keeping the frame
                         (let ((i64 fi . #'(- (cast i64 (-> e nchoices)) 1)))
                           (while (>= fi 0)
                             (if (and (== ($ (nth (cast size_t fi) (-> e choices)) kind) COCO_CH_CLAUSE)
                                      (== ($ (nth (cast size_t fi) (-> e choices)) call) xg)
                                      (== ($ (nth (cast size_t fi) (-> e tchoices)) depth) xd))
                                 (block (set ($ (nth (cast size_t fi) (-> e tchoices)) exited) 1)
                                        break))
                             (set fi (- fi 1))))
                         (set (-> e trace_depth) (- xd 1))
                         (set (-> e trace_goal) pg)))
                   (set (-> e goals) k))

                  ((and (== n 2) (== nid (coco-id m ",")))
                   ;; the whole right spine at once -- see `coco_k_push_body'
                   (set (-> e goals) (coco_k_push_body e g b k)))

                  ((and (== n 0) (== nid (coco-id m "!")))
                   ;; cut: the stack goes back to the barrier this goal carried
                   (if (< b (-> e nchoices)) (set (-> e nchoices) b))
                   (set (-> e goals) k))

                  ((and (== n 1) (== nid (coco-id m "$cut")))
                   (let ((size_t h . #'(cast size_t (coco-signed-payload
                                                     (nth (coco_deref m (coco_arg m g 0)) (-> m heap))))))
                     (if (< h (-> e nchoices)) (set (-> e nchoices) h)))
                   (set (-> e goals) k))

                  ((and (== n 1) (== nid (coco-id m "$softcut")))
                   ;; kill the one frame holding the else-branch, and nothing
                   ;; else. Guarded on the kind as well as the height: if the
                   ;; frame at H is no longer the one this soft cut pushed --
                   ;; which a machine thawed mid-proof could arrange -- killing
                   ;; it would take away somebody else's alternative.
                   (let ((size_t h . #'(cast size_t (coco-signed-payload
                                                     (nth (coco_deref m (coco_arg m g 0)) (-> m heap))))))
                     (if (< h (-> e nchoices))
                         (if (== ($ (nth h (-> e choices)) kind) COCO_CH_GOAL)
                             (set ($ (nth h (-> e choices)) kind) COCO_CH_DEAD))))
                   (set (-> e goals) k))

                  ((and (== n 2) (== nid (coco-id m ";")))
                   (let ((size_t l . #'(coco_deref m (coco_arg m g 0))))
                     ;; (C -> T ; E) is one construct, not a disjunction whose
                     ;; left arm happens to be an implication
                     ;; by the interned ids, as the dispatch is: a `strcmp'
                     ;; here ran on every disjunction
                     (if (and (coco_is_callable m l) (== (coco_arity m l) 2))
                         (block
                          (if (== (coco_name_of m l) (coco-id m "->"))
                              (block (coco_ite e (coco_arg m l 0) (coco_arg m l 1) (coco_arg m g 1) k b)
                                     (return 1)))
                          ;; `(C *-> T ; E)' is one construct too
                          (if (== (coco_name_of m l) (coco-id m "*->"))
                              (block (coco_soft_ite e (coco_arg m l 0) (coco_arg m l 1)
                                                    (coco_arg m g 1) k b)
                                     (return 1)))))
                     (if (not (coco_push_choice e COCO_CH_GOAL (coco_arg m g 1) k b))
                         (block (set (cof ret) (coco_fail_err e "out of memory")) (return 2)))
                     (set (-> e goals) (coco_k_push e (coco_arg m g 0) b k))))

                  ((and (== n 2) (== nid (coco-id m "->")))
                   ;; a bare if-then fails when the condition does. `$fail'
                   ;; rather than `fail': the arm is the construct's own
                   ;; plumbing, and SWI's tracer never shows it
                   (coco_ite e (coco_arg m g 0) (coco_arg m g 1) (coco_new_atom_id m (coco-id m "$fail")) k b))

                  ((and (== n 2) (== nid (coco-id m "*->")))
                   ;; a bare soft cut has no else to take away, so it is just
                   ;; `(C, T)' -- but routed through the same construct, so that
                   ;; the cut barrier C runs under is the one it would have had
                   ;; with an else branch present.
                   (coco_soft_ite e (coco_arg m g 0) (coco_arg m g 1)
                                  (coco_new_atom_id m (coco-id m "$fail")) k b))

                  ((and (== n 1) (or (== nid (coco-id m "\\+")) (== nid (coco-id m "not"))))
                   (coco_ite e (coco_arg m g 0) (coco_new_atom_id m (coco-id m "$fail"))
                             (coco_new_atom_id m (coco-id m "$true")) k b))

                  ;; `once(G)' IS `(G -> true ; fail)' AND NOTHING ELSE, which
                  ;; is why it belongs here rather than in a library. Written
                  ;; as a clause -- `once(G) :- call(G), !.' -- it costs a
                  ;; frame, a `call' and a cut to say what the engine already
                  ;; has a construct for; and the cut then has to be the one
                  ;; that truncates to the clause's own barrier, which is the
                  ;; part a reader has to check. As an if-then-else it is one
                  ;; call into `coco_ite', the same one `\+' is.
                  ;;
                  ;; IT IS ALSO WHERE `once/1' BECOMES OPAQUE TO CUT, as ISO
                  ;; requires: `coco_ite' runs the condition under a barrier of
                  ;; its own -- `(-> e nchoices)' at the moment of the call --
                  ;; so a `!' inside G cuts G and stops there. That is the same
                  ;; rule `call/1' and `catch/3' follow, and getting it from
                  ;; the construct rather than from a hand-written cut is why
                  ;; there is nothing to get wrong.
                  ((and (== n 1) (== nid (coco-id m "once")))
                   (coco_ite e (coco_arg m g 0) (coco_new_atom_id m (coco-id m "$true"))
                             (coco_new_atom_id m (coco-id m "$fail")) k b))

                  ;; `ignore(G)' is the same construct with the failure arm
                  ;; saying yes: run G, keep the first solution's bindings if
                  ;; there was one, succeed either way. The bindings of a
                  ;; FAILED goal are gone before the else arm is reached --
                  ;; the alternative restores the trail to the mark it was
                  ;; pushed with -- so `ignore/1' cannot leak a half-made
                  ;; binding, and that is the engine doing it rather than us.
                  ((and (== n 1) (== nid (coco-id m "ignore")))
                   (coco_ite e (coco_arg m g 0) (coco_new_atom_id m (coco-id m "$true"))
                             (coco_new_atom_id m (coco-id m "$true")) k b))

                  ((and (== n 1) (== nid (coco-id m "call")))
                   ;; call/1 is opaque to cut: the goal runs under a barrier of
                   ;; its own, so a `!' inside it cannot cut the caller
                   (set (-> e goals) (coco_k_push e (coco_arg m g 0) (-> e nchoices) k)))

                  ((and (== n 3) (== nid (coco-id m "catch")))
                   ;; The catcher and the recovery goal are put on the heap as
                   ;; one term BEFORE the frame is pushed, so that the frame's
                   ;; heap mark is above them and unwinding cannot take them.
                   ;;
                   ;; The goal runs under a barrier of its own, so a `!' inside
                   ;; a `catch' is local to it -- the same rule `call/1'
                   ;; follows, and what stops a cut from removing the very
                   ;; frame that is meant to catch.
                   ;;
                   ;; AND THE GOAL IS FOLLOWED BY A MARKER, because a catch
                   ;; that has finished catching has to say so. See
                   ;; `$catch_exit' below and COCO_CH_CATCH_RETRY above.
                   (let ((size_t cr . #'(coco_make2_f m (coco-fid m "$catch" 2)
                                                    (coco_arg m g 1) (coco_arg m g 2)))
                         (size_t ci . #'(-> e nchoices)))
                     (if (not (coco_push_choice e COCO_CH_CATCH cr k b))
                         (block (set (cof ret) (coco_fail_err e "out of memory")) (return 2)))
                     (set (-> e goals)
                          (coco_k_push e (coco_arg m g 0) (-> e nchoices)
                                       (coco_k_push e (coco_make1_f m (coco-fid m "$catch_exit" 1)
                                                                    (coco_new_int m (cast i64 ci)))
                                                    b k)))))

                  ;;; The goal of the catch frame at CI has EXITED. From here
                  ;;; on a throw is somebody else's, so the frame stops being
                  ;;; a catch -- and starts again the moment anything fails
                  ;;; back into the goal, which is what the retry frame is
                  ;;; for. Silent under --trace: the program never wrote it.
                  ;;;
                  ;;; THE RETRY FRAME IS ONLY PUSHED WHEN THERE IS SOMETHING
                  ;;; TO FAIL BACK INTO. A goal that left no alternative can
                  ;;; never be re-entered, so the frame would be a choice
                  ;;; point that exists to do nothing -- and the scan stops at
                  ;;; the first real alternative, so the case that pays for it
                  ;;; is the one that needed it.
                  ((and (== n 1) (== nid (coco-id m "$catch_exit")))
                   (let ((size_t ci . #'(cast size_t (coco-signed-payload
                                                      (nth (coco_deref m (coco_arg m g 0))
                                                           (-> m heap))))))
                     (if (and (< ci (-> e nchoices))
                              (== ($ (nth ci (-> e choices)) kind) COCO_CH_CATCH))
                         (block
                          (set ($ (nth ci (-> e choices)) kind) COCO_CH_DEAD)
                          (let ((int live . 0) (i64 fi . #'(- (cast i64 (-> e nchoices)) 1)))
                            (while (> fi (cast i64 ci))
                              (let ((int fk . #'($ (nth (cast size_t fi) (-> e choices)) kind)))
                                (if (and (!= fk COCO_CH_DEAD) (!= fk COCO_CH_CATCH)
                                         (!= fk COCO_CH_CATCH_RETRY))
                                    (block (set live 1) break)))
                              (set fi (- fi 1)))
                            (if live
                                (block
                                 (if (not (coco_push_choice e COCO_CH_CATCH_RETRY 0 k b))
                                     (block (set (cof ret) (coco_fail_err e "out of memory")) (return 2)))
                                 (set ($ (nth (- (-> e nchoices) 1) (-> e choices)) clause_ix)
                                      ci)))))))
                   (set (-> e goals) k))

                  ((and (== n 1) (== nid (coco-id m "throw")))
                   ;; never fails and never simply succeeds: it either transfers
                   ;; control to a recovery goal or ends the query
                   (if (coco_m_thrown e (coco_arg m g 0)) (block) (block (set (cof ret) -1) (return 2))))

                  ((and (> n 1) (== nid (coco-id m "call")))
                   ;; `call(G, A, B, ...)' -- G with the extra arguments added
                   ;; to the end of it. This is what makes a predicate that
                   ;; takes another predicate possible at all: `max_member/3'
                   ;; in the lists library is `call(Pred, X, Y)' and nothing
                   ;; else, and without this it could not be written.
                   ;;
                   ;; THE CLOSURE MAY ALREADY CARRY ARGUMENTS. `call(plus(1),
                   ;; 2, X)' is `plus(1, 2, X)', so the goal built here is the
                   ;; closure's own arguments followed by the call's -- which
                   ;; is why it is rebuilt rather than the extra ones being
                   ;; pushed onto it.
                   (let ((size_t c . #'(coco_deref m (coco_arg m g 0))))
                     ;; a caught raise (2) is handled: the loop goes on at
                     ;; the recovery goal, as the loop's own two sites do
                     (if (not (coco_is_callable m c))
                         (let ((int rc1 . #'(coco_type_error e "callable" c)))
                           (if (== rc1 2) (return 1))
                           (set (cof ret) rc1)
                           (return 2)))
                     (let ((u32 have . #'(coco_arity m c))
                           (u32 extra . #'(- n 1)))
                       (if (> (+ have extra) 255)
                           (block (set (cof ret) (coco_fail_err e "call/N: too many arguments")) (return 2)))
                       (let ((size_t built)
                             (size_t * args . #'(cast (size_t *)
                                                      (malloc (* (+ have extra)
                                                                 (sizeof size_t))))))
                         (if (== args nil) (block (set (cof ret) (coco_fail_err e "out of memory")) (return 2)))
                         (for ((u32 i . 0)) (< i have) ((++ i))
                           (set (nth i args) (coco_arg m c i)))
                         (for ((u32 i . 0)) (< i extra) ((++ i))
                           (set (nth (+ have i) args) (coco_arg m g (+ i 1))))
                         (set built (coco_make m (coco_atom_name m (coco_name_of m c))
                                             (+ have extra) args))
                         (free args)
                         ;; opaque to cut, exactly as call/1 is
                         (set (-> e goals) (coco_k_push e built (-> e nchoices) k)))))) 

                  (#t (return 0)))
          (return 1)))

  (func coco_engine_run ((coco_engine * e)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st)))

          ;; THE MODULES' OWN CLAUSES, IF THEY ARE NOT IN THIS STORE YET. Here
          ;; and not in `coco_engine_ask' because a store can be emptied under a
          ;; running engine -- thawing a machine into it does exactly that --
          ;; and this is the one function every path goes through. The hook's
          ;; own guard makes the usual case two loads and a comparison.
          ;; A MODULE'S OWN TEXT IS READ AS ITS AUTHOR WROTE IT: the
          ;; `double_quotes' guard that used to sit here, around this one
          ;; call, is inside coco_module_load now (lib/module.cicili),
          ;; because a runtime `use_module' reaches that function without
          ;; passing this hook -- and a library loaded as a GOAL after a
          ;; file had set the flag would not consult. The story is told there.
          (if (!= coco_extern_load nil)
              (if (not (coco_extern_load st m e))
                  (return (coco_fail_err e "a module's clauses would not load"))))

          ;; THE VOCABULARY, INTERNED ONCE PER MACHINE. Here rather than in
          ;; `coco_engine_ask' for the same reason the hook above is: a
          ;; machine can arrive THAWED, with its atom table rebuilt and never
          ;; an ask in sight, and this is the one function every path goes
          ;; through. Two loads and a branch in the usual case.
          (if (not (-> m ids_ready)) (coco_ids_fill m))

          ;; a solution was reported last time; the next one is behind a
          ;; backtrack, not in front of the current continuation
          (if (-> e resume)
              (block (set (-> e resume) 0)
                     (if (not (coco_backtrack e)) (return 0))))

          (while 1
            (set (-> e steps) (+ (-> e steps) 1))
            ;; a stop at the limit, a halt and a collection each see the
            ;; continuation whole: a goal the last step handed over goes back
            ;; in its frame first (`coco_k_flush')
            (if (and (!= (-> e max_steps) 0) (> (-> e steps) (-> e max_steps)))
                (block (coco_k_flush e)
                       (return (coco_fail_err e "inference limit reached"))))
            (if (-> e halted) (block (coco_k_flush e) (return 0)))

            ;; A COLLECTION, AT THE ONE SAFE PLACE: between two steps, with the
            ;; whole state of the proof in the continuation and the frames --
            ;; see `coco_heap_gc'. Once the heap reaches the threshold (0 when
            ;; `garbage_collect/0' asked), an engine collects if its host said
            ;; so, or, nested, if the builtin that started it told the
            ;; collector everything its own frame holds and its outer engine
            ;; may collect too (1.9.4; `coco_engine_findall'): the engines
            ;; part way through a step are found on the machine's chain. Two
            ;; loads and a compare when it does not run -- the host's word is
            ;; asked only past the threshold, since nested engines say yes
            ;; too. A flush that found no room changed nothing, and the run
            ;; stops at the next step's top (`coco_k_room').
            (if (>= (-> m heap_len) (-> m gc_next))
                (if (-> e gc) (if (coco_k_flush e) (coco_heap_gc e))))

            ;; THE NEXT GOAL: the one the clause entered by the last step
            ;; handed over (`ngoal'), or else the continuation's,
            ;; dereferenced ONCE -- a `'$k'' frame, and its first goal comes
            ;; off; the empty continuation, an atom (`coco_k_empty'), and
            ;; that is a solution; or a position in an environment (Stage
            ;; 5), whose goal is handed over as a clause's first goal is
            ;; (`coco_env_take') and taken below in this same step, as a
            ;; frame's goal is -- going round once more for it cost every
            ;; such goal the loop's top again, 3.9 % of lookup -- or, a cut
            ;; or a construct, done there, and that was the step. The frame
            ;; is told by its tag alone, the test the atom had, so a step
            ;; that pops one asks nothing it did not ask through 1.9.2.
            (let ((size_t g . 0) (size_t b . 0) (size_t k . 0) (int ok . 1))
              (if (not (-> e nset))
                  (let ((size_t kf . #'(coco_deref m (-> e goals))))
                    (if (coco-tag-is FUN (nth kf (-> m heap)))
                        (block
                         (set g (coco_deref m (coco_arg m kf 0)))
                         (set b (cast size_t (coco-signed-payload (nth (coco_deref m (coco_arg m kf 1)) (-> m heap)))))
                         (set k (coco_arg m kf 2)))
                        (block
                         (if (coco-tag-is ATOM (nth kf (-> m heap)))
                             (block (set (-> e resume) 1) (return 1)))
                         (let ((int er . #'(coco_env_take e kf)))
                           (if (== er -1) (return (coco_fail_err e "out of memory")))
                           ;; a unit that failed fails as its goal did
                           (if (== er -2)
                               (block (if (not (coco_backtrack e)) (return 0))
                                      continue))
                           ;; a unit done here was the step; one that handed
                           ;; its goal over has it taken below, in this step
                           (if (== er 0) continue))))))
              (if (-> e nset)
                  (block
                   ;; THE NEXT GOAL IN THE REGISTERS (Stage 3): a call the
                   ;; clause just entered wrote as its functor and its
                   ;; arguments, never as a term. Its functor is a plain
                   ;; predicate of this store, untraced: `coco_regs_ok'
                   ;; asked the stamp when the registers were written, and
                   ;; nothing that could change the answer -- a module
                   ;; registered, the store emptied, trace switched on, all
                   ;; of them goals -- can run between that and here, since
                   ;; a stop, a halt or a collection first turns the
                   ;; registers into a term (`coco_k_flush'). A call with
                   ;; one candidate is tried from them right here
                   ;; (`coco_try_clause' given the bank), and the step
                   ;; ends; one with no candidate fails here, and one with
                   ;; more pushes its frame here (`coco_regs_choice').
                   ;; Anything else builds the term (`coco_areg_term') and
                   ;; goes the way a handed-over goal goes, below: no
                   ;; clauses -- the dynamic and the undefined -- a call
                   ;; another argument would choose better, or a program
                   ;; that could not run. Inside the test for a handed-over
                   ;; goal, so a step that takes its goal from a frame asks
                   ;; nothing more than it did.
                   (if (== (-> e nset) 2)
                       (let ((size_t pi . #'($ (nth (cast size_t (-> e afid)) (-> m functors)) pidx))
                             (int r . -1))
                         (set (-> e nset) 0)
                         (coco_pred_ensure st pi)
                         (let ((coco_pred * p . #'(aof (nth pi ($ (cof st) preds)))))
                           (if (> (-> p nclauses) 0)
                               (let ((u64 key . #'(coco_cell_key m (nth (* (cast size_t (-> e acur)) 8)
                                                                       (-> e areg))))
                                     (size_t ix0 . 0) (int det . -1))
                                 (if (coco_pred_first_enough p key)
                                     (set det (coco_pred_probe st p key (aof ix0))))
                                 (cond
                                   ((== det 0) (set r 0))
                                   ;; one: tried from the bank the call is
                                   ;; in -- 1 entered, 0 no match, -1 the
                                   ;; long way below
                                   ((== det 1)
                                    (set r (coco_try_clause
                                            e p ix0 0
                                            (aof (nth (* (cast size_t (-> e acur)) 8) (-> e areg)))
                                            (-> e goals) (-> e nchoices))))
                                   ((== det 2)
                                    (set r (coco_regs_choice e pi ix0))
                                    (if (== r -1) (return (coco_fail_err e "out of memory"))))))))
                         (cond
                           ((== r 1) continue)
                           ((== r 0)
                            (if (not (coco_backtrack e)) (return 0))
                            continue)
                           ;; no room for the term: the run stops at the
                           ;; top (`coco_k_room'), and cell 0 is no goal
                           (#t (set (-> e ngoal) (coco_areg_term e))
                               (if (== (-> e ngoal) 0) continue)))))
                   (set (-> e nset) 0)
                   (set g (-> e ngoal))
                   (set b (-> e nbar))
                   (set k (-> e goals))))

              ;; A RAISE FROM INSIDE THE LOOP IS NOT A `return' (the note at
              ;; the undefined-predicate site below says why): 2 means a
              ;; catcher took the ball and the continuation is the recovery
              ;; goal already, so the loop goes round again. These two sites
              ;; returned the 2, and `catch(call(_), E, true)' ended the
              ;; query silently with the host's exit status 2 (1.8.46).
              (let ((u64 gc . #'(nth g (-> m heap))))
                (if (coco-tag-is REF gc)
                    (block (if (!= 2 (coco_instantiation_error e)) (return -1))
                           continue))
                (if (not (coco_is_callable m g))
                    (block (if (!= 2 (coco_type_error e "callable" g)) (return -1))
                           continue)))

              ;; THE NAME AS AN ID, not as a string: every test below is an
              ;; integer comparison now. `coco_atom_name' is still reached on
              ;; the two paths that need the text -- a module's dispatcher,
              ;; whose interface takes a `char *', and an existence error,
              ;; which prints one.
              (let ((u64 nid . #'(coco_name_of m g))
                    (u32 n . #'(coco_arity m g))
                    (int known . 0) (size_t kpi . 0))
                  ;; A PLAIN PREDICATE ALREADY KNOWN TO BE ONE (`fgen' in
                  ;; term.cicili): stamped with the registry's generation of
                  ;; now, for this store -- then the construct, builtin and
                  ;; module questions below were all answered no when it was
                  ;; stamped and would be again, and the goal goes straight
                  ;; to its predicate. On naive reverse that is 55 of the 120
                  ;; instructions a dispatch cost. Not under trace, where the
                  ;; dispatch runs exactly as it always did: the ports come
                  ;; out the same either way (test/trace.pl), but with the
                  ;; test the compiler makes this loop 11 instructions an
                  ;; inference shorter on nrev. The index is read here and
                  ;; the functor is not held: a module's walk may grow the
                  ;; functor table, and on this path there is no walk to grow
                  ;; it. An atom goal has no functor and asks as before.
                  (if (> n 0)
                      (let ((coco_functor * fk . #'(aof (nth (cast size_t (coco-payload (nth g (-> m heap))))
                                                           (-> m functors)))))
                        (if (and (== (-> fk fgen) coco_extern_generation)
                                 (== (-> fk pst) (cast (void *) st))
                                 (== (-> fk pserial) (-> st serial))
                                 (== (-> e trace) 0))
                            (block (set known 1) (set kpi (-> fk pidx))))))
                  ;; A CONSTRUCT, by one load (`coco_is_construct'), and
                  ;; nothing else is compared against the construct names:
                  ;; most goals are a predicate's, and the predicate path
                  ;; below is where they go straight away
                  (let ((int handled . 0) (int ret . 0))
                    (if (and (not known) (coco_is_construct m nid))
                        (let ((int rc0 . #'(coco_construct e nid n g k b (aof ok) (aof ret))))
                          (if (== rc0 2) (return ret))
                          (set handled rc0)))
                    (if (not handled)
                   ;; ---- a builtin, or a predicate ----
                   (let ((int found . 0) (int rc . 0) (int tport . 0) (int tD . 0))
                     ;; the Call port, before anything runs -- SWI prints it
                     ;; before so much as a head is looked at. trace/0 and
                     ;; notrace/0 stay out of their own trace.
                     (if (and (-> e trace)
                              (not (and (== n 0) (or (== nid (coco-id m "trace"))
                                                     (== nid (coco-id m "notrace"))))))
                         (block (set tport 1)
                                (set tD (+ (-> e trace_depth) 1))
                                (coco_trace_port e "Call" tD g)))
                     ;; A CORE BUILTIN, BY THE ROW THE FUNCTOR REMEMBERS -- asked
                     ;; once (`coco_builtin_index'), then one jump; an atom
                     ;; goal has no functor and walks the chain as before
                     (if (not known)
                         (if (> n 0)
                             (let ((coco_functor * f0 . #'(aof (nth (cast size_t (coco-payload (nth g (-> m heap))))
                                                                  (-> m functors)))))
                               (if (== (-> f0 bix) 0)
                                   (set (-> f0 bix) (cast u32 (+ (coco_builtin_index m nid n) 2))))
                               (if (>= (-> f0 bix) 2)
                                   (block (set found 1)
                                          (set rc (coco_builtin_call e (cast int (- (-> f0 bix) 2)) g)))
                                   (set found 0)))
                             (set rc (coco_builtin e nid n g (aof found)))))
                     ;; not a core builtin: a module may still own it, and
                     ;; the module interface speaks names -- so the text is
                     ;; fetched HERE, on the path that needs it, rather than
                     ;; for every goal
                     (if (and (not known) (not found) (!= coco_extern_call nil))
                         (block
                          ;; THE CALL'S CONTINUATION AND GOAL ON THE ENGINE
                          ;; (1.9.4), not only in this frame: a module's
                          ;; predicate may start a nested engine, and a
                          ;; collection in there rewrites every cell index
                          ;; it can find (`coco_heap_collect') -- these two
                          ;; included, read back below
                          (set (-> e kgoal) k)
                          (set (-> e kcall) g)
                          (if (and (> n 0) (!= coco_extern_resolving nil))
                              ;; by the functor's remembered owner, asked once
                              ;; per generation of the registry -- see
                              ;; `coco_extern_install_resolve'. The functor
                              ;; index is the FUN cell's payload; `g' is
                              ;; dereferenced and callable, so with n > 0 it
                              ;; is one. A functor made by this very call --
                              ;; `coco_functor_id' may grow the table -- is
                              ;; read after the walk, never across it.
                              (let ((size_t fi . #'(cast size_t (coco-payload (nth g (-> m heap))))))
                                (if (!= ($ (nth fi (-> m functors)) dgen) coco_extern_generation)
                                    (let ((size_t at . 0) (u64 d0 . #'(-> e declines)))
                                      (set rc (coco_extern_resolving e (coco_atom_name m nid) n (-> e kcall)
                                                                     (aof found) (aof at)))
                                      ;; a walk in which a module declined says
                                      ;; nothing about the next call: keep none
                                      (if (== (-> e declines) d0)
                                          (block
                                           (set ($ (nth fi (-> m functors)) dmod)
                                                (? found (cast i32 at) -2))
                                           (set ($ (nth fi (-> m functors)) dgen) coco_extern_generation))))
                                  (if (>= ($ (nth fi (-> m functors)) dmod) 0)
                                      (block
                                       (set rc (coco_extern_call_at e (cast size_t ($ (nth fi (-> m functors)) dmod))
                                                                    (coco_atom_name m nid) n (-> e kcall) (aof found)))
                                       ;; the owner declined these arguments: on
                                       ;; through every module, as the walk went
                                       (if (not found)
                                           (set rc (coco_extern_call e (coco_atom_name m nid) n (-> e kcall)
                                                                     (aof found))))))))
                            (set rc (coco_extern_call e (coco_atom_name m nid) n (-> e kcall) (aof found))))
                          (set k (-> e kgoal))
                          (set g (-> e kcall))))
                     (if found
                         (block
                          (if (== rc -1) (return -1))
                          ;; 2 MEANS THE BUILTIN SET THE CONTINUATION ITSELF,
                          ;; which is what a builtin that threw and was caught
                          ;; has done: `coco_throw' has already pointed the
                          ;; engine at the recovery goal, and putting `k' back
                          ;; here would throw that away and carry on as if
                          ;; nothing had been raised.
                          (cond ((== rc 2) (block))
                                ((== rc 1)
                                 (if tport (coco_trace_port e "Exit" tD g))
                                 (set (-> e goals) k))
                                (#t
                                 (if tport (coco_trace_port e "Fail" tD g))
                                 (set ok 0))))
                       ;; nobody's builtin: the knowledge base decides -- the
                       ;; predicate by the index the functor remembers for
                       ;; this store, looked up once (`coco_pred_of' hashes)
                       (let ((size_t pi . 0))
                         (cond
                          ((!= known 0) (set pi kpi))
                          ((> n 0)
                           (let ((coco_functor * f1 . #'(aof (nth (cast size_t (coco-payload (nth g (-> m heap))))
                                                                (-> m functors)))))
                             (if (and (== (-> f1 pst) (cast (void *) st))
                                      (== (-> f1 pserial) (-> st serial)))
                                 (set pi (-> f1 pidx))
                                 (block (set pi (coco_pred_of st m g))
                                        (set (-> f1 pst) (cast (void *) st))
                                        (set (-> f1 pserial) (-> st serial))
                                        (set (-> f1 pidx) pi)))
                             ;; THE STAMP, set only here, where every question
                             ;; has just been asked and answered no: not a
                             ;; construct's name (one of those can turn a goal
                             ;; down by its shape), not a builtin (we are past
                             ;; that test), and no module claims it -- either
                             ;; there is no module seam, or the remembered walk
                             ;; of this very generation found no owner. A walk
                             ;; with a decline in it remembered nothing, so it
                             ;; stamps nothing either.
                             (if (and (< pi ($ (cof st) npreds))
                                      (not (coco_is_construct m nid))
                                      (or (== coco_extern_call nil)
                                          (and (== (-> f1 dgen) coco_extern_generation)
                                               (< (-> f1 dmod) 0))))
                                 (set (-> f1 fgen) coco_extern_generation))))
                          (#t (set pi (coco_pred_of st m g))))
                         (cond
                          ((>= pi ($ (cof st) npreds))
                           ;; A RAISE FROM INSIDE THE LOOP IS NOT A `return'.
                           ;; `coco_raise' answers 2 when a catcher took the ball
                           ;; and the continuation already points at the recovery
                           ;; goal -- so the loop carries on. Returning that 2
                           ;; would leave this function answering something every
                           ;; caller reads as success.
                           (if (!= 2 (coco_type_error e "callable" g)) (return -1)))
                          (#t
                           (coco_pred_ensure st pi)
                           (cond
                            ((> ($ (nth pi ($ (cof st) preds)) nclauses) 0)
                             (let ((int det . -1) (size_t ix0 . 0) (u32 kpos . 0))
                               ;; A DETERMINISTIC CALL GETS NO FRAME. The index is
                               ;; asked for the first candidate and whether there
                               ;; is a second (`coco_pred_probe'); with no second
                               ;; the clause is tried here, over the machine's own
                               ;; marks, with the choice stack as it stands for its
                               ;; cut barrier -- the height a frame would have
                               ;; had, so a `!' in the body cuts the same -- and
                               ;; nothing is pushed to be popped. A frame under
                               ;; trace stays (the Fail port is printed from it),
                               ;; so the trace keeps the path below.
                               ;; WHICH ARGUMENT CHOOSES is asked only of a
                               ;; predicate the first argument will not do for
                               ;; (`coco_pred_first_enough'): almost every rule is
                               ;; under the index floor and is keyed on its
                               ;; first argument as it always was, at no cost.
                               ;; The answer goes into the frame below, if
                               ;; there is one, so a retry reads it rather than
                               ;; asking again (`coco_select_clause').
                               (if (== (-> e trace) 0)
                                   (let ((coco_pred * pp . #'(aof (nth pi ($ (cof st) preds))))
                                         (u64 key . #'(coco_arg_key m g)))
                                     (if (coco_pred_first_enough pp key)
                                         (set det (coco_pred_probe st pp key (aof ix0)))
                                         (let ((coco_ixsel sel . #'(coco_pred_select st m pp g)))
                                           (set kpos ($ sel pos))
                                           (set det (coco_pred_probe_at st m pp kpos ($ sel key) (aof ix0)))))))
                               (cond
                                 ((== det 0) (set ok 0))
                                 ((== det 1)
                                  (if (not (coco_try_clause e (aof (nth pi ($ (cof st) preds))) ix0
                                                            g nil k (-> e nchoices)))
                                      (set ok 0)))
                                 (#t
                              ;; under trace the body exits through a marker,
                              ;; pushed BEFORE the frame so its cells sit
                              ;; below the frame's heap mark and survive
                              ;; every backtrack into it -- the trick the
                              ;; catch frame's `$catch' term already plays
                              (let ((size_t k2 . k))
                                (if tport
                                    (let ((size_t margs [3]))
                                      (set (nth 0 margs) (coco_new_int m (cast i64 g)))
                                      (set (nth 1 margs) (coco_new_int m (cast i64 tD)))
                                      (set (nth 2 margs) (coco_new_int m (cast i64 (-> e trace_goal))))
                                      (set k2 (coco_k_push e (coco_make_f m (coco-fid m "$trace_exit" 3) 3 margs) b k))))
                                (if (not (coco_push_choice e COCO_CH_CLAUSE g k2 b))
                                    (return (coco_fail_err e "out of memory")))
                                (let ((size_t ci . #'(- (-> e nchoices) 1)))
                                  (set ($ (nth ci (-> e choices)) pred) pi)
                                  ;; the first candidate, when it was found above;
                                  ;; 0 under trace, where nothing was asked yet
                                  (set ($ (nth ci (-> e choices)) clause_ix) (? (== det 2) ix0 0))
                                  ;; and the argument it was found on
                                  (set ($ (nth ci (-> e choices)) ixpos) kpos)
                                  ;; this frame IS the traced call
                                  (if tport
                                      (let ((coco_tchoice * tc . #'(aof (nth ci (-> e tchoices)))))
                                        (set (-> tc goal) g)
                                        (set (-> tc depth) tD)
                                        (set (-> tc printr) 1)
                                        (set (-> tc exited) 0)))
                                  (if (not (coco_select_clause e ci))
                                      (block (if tport (coco_trace_port e "Fail" tD g))
                                             (set ok 0))
                                    ;; the body runs inside this call now
                                    (if tport
                                        (block (set (-> e trace_goal) g)
                                               (set (-> e trace_depth) tD))))))))))
                            ;; NO CLAUSES IS NOT THE SAME AS UNDEFINED. A
                            ;; predicate the program declared dynamic -- or that
                            ;; an `assert' brought into being and a `retract'
                            ;; emptied again -- exists and simply has nothing to
                            ;; prove, so it fails. One nobody ever defined is a
                            ;; different thing, and the libraries these clauses
                            ;; came from are written expecting it to raise.
                            (($ (nth pi ($ (cof st) preds)) dynamic)
                             (if tport (coco_trace_port e "Fail" tD g))
                             (set ok 0))
                            ;; ABOUT TO THROW -- SO ASK THE BACKEND FIRST.
                            ;; Resolution loads a predicate's clauses lazily,
                            ;; one predicate at a time, and that path learns
                            ;; the clauses and not the DECLARATIONS: a
                            ;; predicate another process declared dynamic and
                            ;; never wrote to has no clauses to fetch, so this
                            ;; process had never heard of it and raised. But
                            ;; README says a declaration is about the knowledge
                            ;; base and has to outlive the process, and it
                            ;; does -- the row was there, unread.
                            ;;
                            ;; Warming here rather than before every call
                            ;; costs a round trip only on the path that was
                            ;; going to throw, which is not a path anything
                            ;; runs in a loop. If the declaration turns up, the
                            ;; call fails the way an empty dynamic predicate
                            ;; should; if it does not, the error is the same
                            ;; error as before.
                            (#t
                             ;; ONCE PER PREDICATE. The comment above says this
                             ;; path "is not a path anything runs in a loop",
                             ;; and that is exactly what a caller which catches
                             ;; the error does: `library(reasoning/translate)'
                             ;; asks a lesson for a relation the language does
                             ;; not state -- `elision_of/2' in Spanish -- on
                             ;; nearly every word, and paid a whole warm for
                             ;; each. Measured, ten raises on a 400 MB store:
                             ;; 2.57 s before, 0.000 s after.
                             (if (not ($ (nth pi ($ (cof st) preds)) warmed))
                                 (block
                                  (set ($ (nth pi ($ (cof st) preds)) warmed) 1)
                                  (coco_store_warm st)))
                             (if ($ (nth pi ($ (cof st) preds)) dynamic)
                                 (block (if tport (coco_trace_port e "Fail" tD g))
                                        (set ok 0))
                               (if (!= 2 (coco_existence_error e "procedure"
                                                                (coco_atom_name m nid) n))
                                   (return -1)))))))))))))

              (if (not ok)
                  (if (not (coco_backtrack e)) (return 0)))))
          (return 0)))

  ;;; THE PUBLIC ENTRY COUNTS ITSELF IN AND OUT, so the collector can tell
  ;;; whether this engine is the only one part way through a run on the
  ;;; machine (see `running' on the machine). Every return path of the loop
  ;;; comes back through here, which is the reason it is a wrapper and not a
  ;;; counter bumped at each `return' -- there are forty of those.
  (func coco_engine_next ((coco_engine * e)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (int rc . 0))
          ;; the first run on the machine sets the threshold; after it a
          ;; threshold of 0 is `garbage_collect/0''s request, kept
          (if (== (-> m gc_floor) 0)
              (block (set (-> m gc_floor) (coco_gc_floor))
                     (set (-> m gc_next) (-> m gc_floor))))
          (set (-> m running) (+ (-> m running) 1))
          ;; THE CHAIN OF ENGINES ON THE MACHINE: this one, then the one
          ;; whose builtin started it, and so on out (`coco_heap_collect')
          (set (-> e outer) (-> m eng))
          (set (-> m eng) (cast (void *) e))
          (set rc (coco_engine_run e))
          (set (-> m eng) (-> e outer))
          (set (-> m running) (- (-> m running) 1))
          ;; MEMORY, NOT A HALT: a builder of the continuation found no room
          ;; and stopped the run (`coco_k_room'); no host sees the 2
          (if (== (-> e halted) 2)
              (block (set (-> e halted) 0)
                     (set rc (coco_fail_err e "out of memory"))))
          (return rc)))

  ;;;; ----------------------------------------------------------------
  ;;;; Builtins
  ;;;; ----------------------------------------------------------------
  ;;; Each takes the engine and the goal, and answers 1 for success, 0 for
  ;;; failure, -1 for an error with `e->err' filled in. None of them makes a
  ;;; choice point, so none of them can succeed twice -- see the head of this
  ;;; file for why that is a rule and not an accident.

  (static) (func coco_a ((coco_engine * e) (size_t g) (u32 i)) (out size_t)
                 (return (coco_deref (-> e m) (coco_arg (-> e m) g i))))

  ;;; ---- the tracer's switch ----
  ;;; SWI's trace/0 and notrace/0: on from the NEXT goal, off at once.
  ;;; Neither appears in its own trace -- the dispatch keeps them out.

  (func coco_bi_trace ((coco_engine * e) (size_t g)) (out int)
        (set (-> e trace) 1)
        (return 1))

  (func coco_bi_notrace ((coco_engine * e) (size_t g)) (out int)
        (set (-> e trace) 0)
        (return 1))

  ;;; ---- unification and comparison ----

  (func coco_bi_unify ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco_unify (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1)) 1 0)))

  ;;; `\=' must leave nothing behind: it unifies to find out, then unbinds
  ;;; whatever that did. The trail mark is the whole implementation.
  (func coco_bi_not_unify ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t tmark . #'($ (cof (-> e m)) trail_len))
              (int r))
          (set r (coco_unify m (coco_arg m g 0) (coco_arg m g 1)))
          (coco_undo_to m tmark)
          (return (? r 0 1))))

  (func coco_bi_eq  ((coco_engine * e) (size_t g)) (out int)
        (return (? (== 0 (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1))) 1 0)))
  (func coco_bi_neq ((coco_engine * e) (size_t g)) (out int)
        (return (? (!= 0 (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1))) 1 0)))
  (func coco_bi_lt  ((coco_engine * e) (size_t g)) (out int)
        (return (? (<  (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1)) 0) 1 0)))
  (func coco_bi_gt  ((coco_engine * e) (size_t g)) (out int)
        (return (? (>  (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1)) 0) 1 0)))
  (func coco_bi_le  ((coco_engine * e) (size_t g)) (out int)
        (return (? (<= (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1)) 0) 1 0)))
  (func coco_bi_ge  ((coco_engine * e) (size_t g)) (out int)
        (return (? (>= (coco_compare (-> e m) (coco_arg (-> e m) g 0) (coco_arg (-> e m) g 1)) 0) 1 0)))

  (func coco_bi_compare ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (int c . #'(coco_compare (-> e m) (coco_arg (-> e m) g 1) (coco_arg (-> e m) g 2)))
              (const char * s))
          (set s (? (< c 0) "<" (? (> c 0) ">" "=")))
          (return (? (coco_unify m (coco_arg m g 0) (coco_new_atom m s)) 1 0))))

  ;;; ---- type tests ----

  (func coco_bi_var ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is REF (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 1 0)))
  (func coco_bi_nonvar ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is REF (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 0 1)))
  (func coco_bi_atom ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is ATOM (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 1 0)))
  (func coco_bi_integer ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is INT (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 1 0)))
  (func coco_bi_float ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is FLT (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 1 0)))
  (func coco_bi_number ((coco_engine * e) (size_t g)) (out int)
        (let ((u64 c . #'(nth (coco_a e g 0) ($ (cof (-> e m)) heap))))
          (return (? (or (coco-tag-is INT c) (coco-tag-is FLT c)) 1 0))))
  (func coco_bi_compound ((coco_engine * e) (size_t g)) (out int)
        (return (? (coco-tag-is FUN (nth (coco_a e g 0) ($ (cof (-> e m)) heap))) 1 0)))
  (func coco_bi_atomic ((coco_engine * e) (size_t g)) (out int)
        (let ((u64 c . #'(nth (coco_a e g 0) ($ (cof (-> e m)) heap))))
          (return (? (or (coco-tag-is REF c) (coco-tag-is FUN c)) 0 1))))
  (func coco_bi_callable ((coco_engine * e) (size_t g)) (out int)
        (return (coco_is_callable (-> e m) (coco_a e g 0))))

  ;;; A proper list and nothing else: a partial list `[a|X]' is not one, and
  ;;; neither is a cyclic term -- which is what the step limit is for.
  (func coco_bi_is_list ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0))
              (u64 guard . 0))
          (while 1
            (set t (coco_deref m t))
            (let ((u64 c . #'(nth t (-> m heap))))
              (if (coco-tag-is ATOM c)
                  (return (? (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) "[]")) 1 0)))
              (if (not (coco_is_cons m t)) (return 0))
              (set t (coco_arg m t 1))
              (set guard (+ guard 1))
              (if (> guard 10000000) (return 0))))
          (return 0)))

  ;;; ---- arithmetic ----

  ;;; THE THREE OPERATOR NAMES THAT CANNOT BE WRITTEN. A Cicili string
  ;;; literal reaches C raw and may not end in a backslash, so `/\' has no
  ;;; spelling as a literal here at all; `\/' and `\' do, but are built the
  ;;; same way so that the four bitwise cases below read alike and nobody has
  ;;; to remember which one is the exception. 47 is `/', 92 is `\'.
  ;;; lib/syntax.cicili builds the same three names for the operator table,
  ;;; from the same codes, for the same reason.
  (static) (var char COCO_OP_AND [] . '{ 47 92 0 })
  (static) (var char COCO_OP_OR  [] . '{ 92 47 0 })
  (static) (var char COCO_OP_NOT [] . '{ 92 0 })

  ;;; The names this expands under are bound by the parameter list below: that
  ;;; is the contract `coco-emit-arith-binops' documents.
  (static)
  (func coco_arith_simple ((coco_machine * m) (u64 nid) (int both_int)
                         (i64 ai) (double af) (i64 bi) (double bf)
                         (int * isf) (i64 * iv) (double * fv)) (out int)
        (coco-emit-arith-binops))

  ;;; DOES FLOORED DIVISION DIFFER FROM C's? When the remainder is not zero and
  ;;; has the sign the divisor has not: `div' takes one off the quotient and
  ;;; `mod' adds the divisor. THE SIGNS ARE COMPARED, NEVER MULTIPLIED. The test
  ;;; was `(< (* r b) 0)', and a product of a remainder and a divisor passes
  ;;; 2^63 once both are over about three billion: it wrapped, and the answer
  ;;; was right for the small numbers every check used and wrong from there --
  ;;; `2654435761 mod 4294967296' came out 6949403057, `2654435761 div
  ;;; 4294967296' -1, and `-2654435761 mod 4294967296' was left negative.
  (static)
  (func coco_floor_adjusts ((i64 a) (i64 b)) (out int)
        (let ((i64 r . #'(% a b)))
          (return (? (and (!= r 0) (!= (< r 0) (< b 0))) 1 0))))

  (static)
  (func coco_arith_binary ((coco_engine * e) (u64 nid) (int both_int)
                         (i64 ai) (double af) (i64 bi) (double bf)
                         (int * isf) (i64 * iv) (double * fv)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
        (if (coco_arith_simple m nid both_int ai af bi bf isf iv fv) (return 1))
        (cond
          ;; `/' answers an integer when it divides exactly and a float when it
          ;; does not, which is what most Prologs do and what surprises fewest
          ;; people; `//' is always integer division.
          ((== nid (coco-id m "/"))
           (if both_int
               (block (if (== bi 0) (return (coco_evaluation_error e "zero_divisor")))
                      (if (== 0 (% ai bi))
                          (block (set (cof iv) (/ ai bi)) (set (cof isf) 0))
                        (block (set (cof fv) (/ (cast double ai) (cast double bi)))
                               (set (cof isf) 1))))
             (block (set (cof fv) (/ af bf)) (set (cof isf) 1)))
           (return 1))
          ((== nid (coco-id m "//"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (if (== bi 0) (return (coco_evaluation_error e "zero_divisor")))
           (set (cof iv) (/ ai bi)) (set (cof isf) 0) (return 1))
          ((== nid (coco-id m "div"))
           ;; floored division: the quotient mod pairs with, so
           ;; A =:= (A div B) * B + A mod B holds for every sign
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (if (== bi 0) (return (coco_evaluation_error e "zero_divisor")))
           (set (cof iv) (- (/ ai bi) (coco_floor_adjusts ai bi)))
           (set (cof isf) 0) (return 1))
          ((== nid (coco-id m "mod"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (if (== bi 0) (return (coco_evaluation_error e "zero_divisor")))
           ;; mod follows the sign of the divisor, rem follows the dividend
           (set (cof iv) (- (% ai bi) (? (coco_floor_adjusts ai bi) (- 0 bi) 0)))
           (set (cof isf) 0) (return 1))
          ((== nid (coco-id m "rem"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (if (== bi 0) (return (coco_evaluation_error e "zero_divisor")))
           (set (cof iv) (% ai bi)) (set (cof isf) 0) (return 1))
          ((== nid (coco-id m "min"))
           (if both_int (block (set (cof iv) (? (< ai bi) ai bi)) (set (cof isf) 0))
             (block (set (cof fv) (? (< af bf) af bf)) (set (cof isf) 1)))
           (return 1))
          ((== nid (coco-id m "max"))
           (if both_int (block (set (cof iv) (? (> ai bi) ai bi)) (set (cof isf) 0))
             (block (set (cof fv) (? (> af bf) af bf)) (set (cof isf) 1)))
           (return 1))
          ;; SWI answers an integer for an integer base under a non-negative
          ;; integer exponent, and a float everywhere else; `^' reads the same
          ;; table. 64-bit like everything else here: a power that does not
          ;; fit wraps, exactly as `*' does.
          ((or (== nid (coco-id m "**")) (== nid (coco-id m "^")))
           (if (and both_int (>= bi 0))
               (let ((i64 acc . #'1) (i64 base . #'ai) (i64 n . #'bi))
                 (while (> n 0)
                   (if (!= 0 (bitand n 1)) (set acc (* acc base)))
                   (set base (* base base))
                   (set n (>> n 1)))
                 (set (cof iv) acc) (set (cof isf) 0))
             (block (set (cof fv) (pow af bf)) (set (cof isf) 1)))
           (return 1))
          ((== nid (coco-id m "gcd"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (let ((i64 a . #'(? (< ai 0) (- 0 ai) ai))
                 (i64 b . #'(? (< bi 0) (- 0 bi) bi)))
             (while (!= b 0)
               (let ((i64 r . #'(% a b)))
                 (set a b) (set b r)))
             (set (cof iv) a))
           (set (cof isf) 0) (return 1))
          ((== nid (coco-id m ">>"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (set (cof iv) (>> ai bi)) (set (cof isf) 0) (return 1))
          ((== nid (coco-id m "<<"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (set (cof iv) (<< ai bi)) (set (cof isf) 0) (return 1))
          ;; The bitwise three. Integers only -- ISO says type_error(integer)
          ;; for a float here, and a silent truncation would be worse than an
          ;; error, because the answer would look like an answer.
          ;;
          ;; The names come from COCO_OP_* rather than from literals, for the
          ;; reason lib/syntax.cicili gives at the operator table: a Cicili
          ;; string may not end in a backslash, and `/\' does. `\/' and `\'
          ;; could be written, and are spelled the same way so the four read
          ;; alike and nobody has to remember which one is the exception.
          ((== nid (coco-id m COCO_OP_AND))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (set (cof iv) (bitand ai bi)) (set (cof isf) 0) (return 1))
          ((== nid (coco-id m COCO_OP_OR))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (set (cof iv) (bitor ai bi)) (set (cof isf) 0) (return 1))
          ((== nid (coco-id m "xor"))
           (if (not both_int) (return (coco_type_error e "integer" 0)))
           (set (cof iv) (xor ai bi)) (set (cof isf) 0) (return 1))
          (#t (return (coco_fail_err e "unknown arithmetic function"))))))

  ;;; Evaluates an arithmetic expression. Recursive over the DEPTH of the
  ;;; expression, which is bounded by the text that was read -- unlike the
  ;;; resolution loop, this cannot be suspended half way and does not need to
  ;;; be.
  (static) (decl) (func coco_arith ((coco_engine * e) (size_t t)
                                  (int * isf) (i64 * iv) (double * fv)) (out int))

  (func coco_arith ((coco_engine * e) (size_t t) (int * isf) (i64 * iv) (double * fv)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (set t (coco_deref m t))
          (let ((u64 c . #'(nth t (-> m heap))))
            (cond
              ((coco-tag-is REF c) (return (coco_instantiation_error e)))
              ((coco-tag-is INT c) (set (cof iv) (coco-signed-payload c)) (set (cof isf) 0) (return 1))
              ((coco-tag-is FLT c)
               (set (cof fv) (nth (cast size_t (coco-payload c)) (-> m floats)))
               (set (cof isf) 1) (return 1))
              ((coco-tag-is ATOM c)
               (let ((u64 nid . #'(coco_name_of m t)))
                 (if (== nid (coco-id m "pi"))
                     (block (set (cof fv) 3.14159265358979323846) (set (cof isf) 1) (return 1)))
                 (if (== nid (coco-id m "e"))
                     (block (set (cof fv) 2.71828182845904523536) (set (cof isf) 1) (return 1)))
                 (return (coco_type_error e "evaluable" t))))
              (#t
               (let ((u64 nid . #'(coco_name_of m t))
                     (u32 n . #'(coco_arity m t)))
                 (if (== n 1)
                     (let ((int s0) (i64 i0) (double f0) (int rc))
                       (set rc (coco_arith e (coco_arg m t 0) (aof s0) (aof i0) (aof f0)))
                       (if (!= rc 1) (return rc))
                       (cond
                         ((== nid (coco-id m "-"))
                          (if s0 (block (set (cof fv) (- 0.0 f0)) (set (cof isf) 1))
                            (block (set (cof iv) (- 0 i0)) (set (cof isf) 0)))
                          (return 1))
                         ((== nid (coco-id m "+"))
                          (if s0 (block (set (cof fv) f0) (set (cof isf) 1))
                            (block (set (cof iv) i0) (set (cof isf) 0)))
                          (return 1))
                         ;; bitwise complement, on the two's complement the
                         ;; whole engine already uses: \ 0 is -1
                         ((== nid (coco-id m COCO_OP_NOT))
                          (if s0 (return (coco_type_error e "integer" 0)))
                          (set (cof iv) (- (- 0 i0) 1)) (set (cof isf) 0)
                          (return 1))
                         ((== nid (coco-id m "msb"))
                          (if s0 (return (coco_type_error e "integer" 0)))
                          (if (<= i0 0) (return (coco_type_error e "integer" 0)))
                          (let ((i64 b . #'-1) (i64 v . #'i0))
                            (while (> v 0) (set b (+ b 1)) (set v (>> v 1)))
                            (set (cof iv) b))
                          (set (cof isf) 0) (return 1))
                         ((== nid (coco-id m "abs"))
                          (if s0 (block (set (cof fv) (fabs f0)) (set (cof isf) 1))
                            (block (set (cof iv) (? (< i0 0) (- 0 i0) i0)) (set (cof isf) 0)))
                          (return 1))
                         ((== nid (coco-id m "sign"))
                          (if s0 (block (set (cof fv) (? (> f0 0.0) 1.0 (? (< f0 0.0) -1.0 0.0)))
                                        (set (cof isf) 1))
                            (block (set (cof iv) (? (> i0 0) 1 (? (< i0 0) -1 0))) (set (cof isf) 0)))
                          (return 1))
                         ((== nid (coco-id m "float"))
                          (set (cof fv) (? s0 f0 (cast double i0))) (set (cof isf) 1) (return 1))
                         ((== nid (coco-id m "integer"))
                          (set (cof iv) (? s0 (cast i64 (llround f0)) i0)) (set (cof isf) 0) (return 1))
                         ((== nid (coco-id m "truncate"))
                          (set (cof iv) (? s0 (cast i64 f0) i0)) (set (cof isf) 0) (return 1))
                         ((== nid (coco-id m "round"))
                          (set (cof iv) (? s0 (cast i64 (llround f0)) i0)) (set (cof isf) 0) (return 1))
                         ;; floor and ceiling from the truncating cast, which
                         ;; goes toward zero: one step down for a negative
                         ;; fraction, one step up for a positive one
                         ((== nid (coco-id m "floor"))
                          (if s0
                              (let ((i64 w . #'(cast i64 f0)))
                                (set (cof iv) (? (and (< f0 0.0) (!= (cast double w) f0)) (- w 1) w)))
                            (set (cof iv) i0))
                          (set (cof isf) 0) (return 1))
                         ((== nid (coco-id m "ceiling"))
                          (if s0
                              (let ((i64 w . #'(cast i64 f0)))
                                (set (cof iv) (? (and (> f0 0.0) (!= (cast double w) f0)) (+ w 1) w)))
                            (set (cof iv) i0))
                          (set (cof isf) 0) (return 1))
                         ((== nid (coco-id m "sqrt"))
                          (set (cof fv) (sqrt (? s0 f0 (cast double i0)))) (set (cof isf) 1) (return 1))
                         ;; the ISO transcendentals, each libm's own
                         ((== nid (coco-id m "sin"))
                          (set (cof fv) (sin (? s0 f0 (cast double i0)))) (set (cof isf) 1) (return 1))
                         ((== nid (coco-id m "cos"))
                          (set (cof fv) (cos (? s0 f0 (cast double i0)))) (set (cof isf) 1) (return 1))
                         ((== nid (coco-id m "tan"))
                          (set (cof fv) (tan (? s0 f0 (cast double i0)))) (set (cof isf) 1) (return 1))
                         ((== nid (coco-id m "asin"))
                          (set (cof fv) (asin (? s0 f0 (cast double i0)))) (set (cof isf) 1) (return 1))
                         ((== nid (coco-id m "acos"))
                          (set (cof fv) (acos (? s0 f0 (cast double i0)))) (set (cof isf) 1) (return 1))
                         ((== nid (coco-id m "atan"))
                          (set (cof fv) (atan (? s0 f0 (cast double i0)))) (set (cof isf) 1) (return 1))
                         ((== nid (coco-id m "exp"))
                          (set (cof fv) (exp (? s0 f0 (cast double i0)))) (set (cof isf) 1) (return 1))
                         ((== nid (coco-id m "log"))
                          (if (<= (? s0 f0 (cast double i0)) 0.0)
                              (return (coco_evaluation_error e "undefined")))
                          (set (cof fv) (log (? s0 f0 (cast double i0)))) (set (cof isf) 1) (return 1))
                         (#t (return (coco_fail_err e "unknown arithmetic function")))))
                   (if (== n 2)
                       (let ((int s0) (i64 i0) (double f0) (int s1) (i64 i1) (double f1)
                             (int rc) (int both))
                         ;; TWO INTEGER LEAVES UNDER `+', `-' OR `*' -- `N - 1',
                         ;; `A0 + K', most of what a program counts with --
                         ;; are read here, without the two recursive asks
                         ;; and the two dispatches below (1.8.46): 254
                         ;; instructions an `is' on the counting loop, 150
                         ;; after
                         (let ((u64 c0 . #'(nth (coco_deref m (coco_arg m t 0)) (-> m heap)))
                               (u64 c1 . #'(nth (coco_deref m (coco_arg m t 1)) (-> m heap))))
                           (if (and (coco-tag-is INT c0) (coco-tag-is INT c1))
                               (block
                                (set (cof isf) 0)
                                (cond
                                  ((== nid (coco-id m "+"))
                                   (set (cof iv) (+ (coco-signed-payload c0) (coco-signed-payload c1)))
                                   (return 1))
                                  ((== nid (coco-id m "-"))
                                   (set (cof iv) (- (coco-signed-payload c0) (coco-signed-payload c1)))
                                   (return 1))
                                  ((== nid (coco-id m "*"))
                                   (set (cof iv) (* (coco-signed-payload c0) (coco-signed-payload c1)))
                                   (return 1))
                                  (#t (block))))))
                         (set rc (coco_arith e (coco_arg m t 0) (aof s0) (aof i0) (aof f0)))
                         (if (!= rc 1) (return rc))
                         (set rc (coco_arith e (coco_arg m t 1) (aof s1) (aof i1) (aof f1)))
                         (if (!= rc 1) (return rc))
                         (set both (? (and (== s0 0) (== s1 0)) 1 0))
                         ;; each operand is offered as both, and `both' says
                         ;; which pair the operator should read
                         (return (coco_arith_binary e nid both
                                                  i0 (? s0 f0 (cast double i0))
                                                  i1 (? s1 f1 (cast double i1))
                                                  isf iv fv)))
                     (return (coco_fail_err e "unknown arithmetic function"))))))))
          (return 0)))

  (func coco_bi_is ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (int isf) (i64 iv) (double fv) (int rc))
          (set rc (coco_arith e (coco_arg m g 1) (aof isf) (aof iv) (aof fv)))
          (if (!= rc 1) (return rc))
          (let ((size_t r . #'(? isf (coco_new_float m fv) (coco_new_int m iv))))
            (return (? (coco_unify m (coco_arg m g 0) r) 1 0)))))

  ;;; The six numeric comparisons. Both sides are evaluated, then compared as
  ;;; doubles unless both stayed integers -- so 1 =:= 1.0 is true, as it must
  ;;; be, while 1 == 1.0 is false, as it also must be.
  (static)
  (func coco_num_cmp ((coco_engine * e) (size_t g) (int * out_c)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (int s0) (i64 i0) (double f0) (int s1) (i64 i1) (double f1) (int rc))
          (set rc (coco_arith e (coco_arg m g 0) (aof s0) (aof i0) (aof f0)))
          (if (!= rc 1) (return rc))
          (set rc (coco_arith e (coco_arg m g 1) (aof s1) (aof i1) (aof f1)))
          (if (!= rc 1) (return rc))
          (if (and (== s0 0) (== s1 0))
              (set (cof out_c) (? (< i0 i1) -1 (? (> i0 i1) 1 0)))
            (let ((double a . #'(? s0 f0 (cast double i0)))
                  (double b . #'(? s1 f1 (cast double i1))))
              (set (cof out_c) (? (< a b) -1 (? (> a b) 1 0)))))
          (return 1)))

  (func coco_bi_num_eq  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (== c 0) 1 0))))
  (func coco_bi_num_neq ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (!= c 0) 1 0))))
  (func coco_bi_num_lt  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (< c 0) 1 0))))
  (func coco_bi_num_gt  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (> c 0) 1 0))))
  (func coco_bi_num_le  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (<= c 0) 1 0))))
  (func coco_bi_num_ge  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (>= c 0) 1 0))))

  ;;; ---- term construction and inspection ----

  (func coco_bi_functor ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0)))
          (let ((u64 c . #'(nth t (-> m heap))))
            (if (not (coco-tag-is REF c))
                ;; taking a term apart
                (let ((size_t nm) (size_t ar))
                  (if (coco-tag-is FUN c)
                      (block (set nm (coco_new_atom m (coco_atom_name m (coco_name_of m t))))
                             (set ar (coco_new_int m (cast i64 (coco_arity m t)))))
                    (block (set nm (coco_push m c))
                           (set ar (coco_new_int m 0))))
                  (if (not (coco_unify m (coco_arg m g 1) nm)) (return 0))
                  (return (? (coco_unify m (coco_arg m g 2) ar) 1 0)))))
          ;; building one: name and arity must both be given
          (let ((size_t nt . #'(coco_a e g 1))
                (size_t at . #'(coco_a e g 2)))
            (if (not (coco-tag-is INT (nth at (-> m heap))))
                (return (coco_instantiation_error e)))
            (let ((i64 n . #'(coco-signed-payload (nth at (-> m heap)))))
              (if (< n 0) (return (coco_fail_err e "functor/3 wants an arity of 0 or more")))
              (if (== n 0) (return (? (coco_unify m (coco_arg m g 0) nt) 1 0)))
              (if (not (coco-tag-is ATOM (nth nt (-> m heap))))
                  (return (coco_type_error e "atomic" (coco_a e g 1))))
              (let ((size_t h . #'(coco_open_struct m (coco_atom_name m (coco_name_of m nt))
                                                 (cast u32 n))))
                (for ((i64 i . 0)) (< i n) ((++ i)) (coco_new_var m))
                (return (? (coco_unify m (coco_arg m g 0) h) 1 0)))))))

  (func coco_bi_arg ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t it . #'(coco_a e g 0))
              (size_t t . #'(coco_a e g 1)))
          (if (not (coco-tag-is INT (nth it (-> m heap))))
              (return (coco_instantiation_error e)))
          (if (not (coco-tag-is FUN (nth t (-> m heap)))) (return 0))
          (let ((i64 i . #'(coco-signed-payload (nth it (-> m heap))))
                (u32 n . #'(coco_arity m t)))
            (if (or (< i 1) (> i (cast i64 n))) (return 0))
            (return (? (coco_unify m (coco_arg m g 2) (coco_arg m t (cast u32 (- i 1)))) 1 0)))))

  ;;; `=..' both ways. Taking apart is a walk; building needs the list to be
  ;;; proper, which is checked as it is walked rather than beforehand.
  (func coco_bi_univ ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0)))
          (let ((u64 c . #'(nth t (-> m heap))))
            (if (not (coco-tag-is REF c))
                (let ((size_t lst . #'(coco_new_atom m "[]")))
                  (if (coco-tag-is FUN c)
                      (block (let ((u32 n . #'(coco_arity m t)) (u32 i))
                               (set i n)
                               (while (> i 0)
                                 (set i (- i 1))
                                 (set lst (coco_cons m (coco_arg m t i) lst))))
                             (set lst (coco_cons m (coco_new_atom m (coco_atom_name m (coco_name_of m t))) lst)))
                    (set lst (coco_cons m (coco_push m c) lst)))
                  (return (? (coco_unify m (coco_arg m g 1) lst) 1 0)))))
          ;; building from a list
          (let ((size_t lst . #'(coco_a e g 1))
                (size_t * items . nil) (size_t n . 0) (size_t cap . 0) (int ok . 1))
            (while 1
              (set lst (coco_deref m lst))
              (let ((u64 c . #'(nth lst (-> m heap))))
                (if (coco-tag-is ATOM c)
                    (block (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m lst)) "[]"))
                               (set ok 0))
                           break))
                ;; a cell's functor is `'.'/2' or the list is not proper: a
                ;; `'.'/1' passed the name test alone and had its tail read
                ;; from past its end
                (if (not (coco_is_cons m lst)) (block (set ok 0) break))
                (if (>= n cap)
                    (let ((size_t ncap . #'(? (== cap 0) 8 (* cap 2))))
                      (set items (cast (size_t *) (realloc items (* ncap (sizeof size_t)))))
                      (if (== items nil) (block (set ok 0) break))
                      (set cap ncap)))
                (set (nth n items) (coco_arg m lst 0))
                (set n (+ n 1))
                (set lst (coco_arg m lst 1))))
            (if (or (not ok) (== n 0))
                (block (free items) (return (coco_fail_err e "=.. wants a proper non-empty list"))))
            (let ((size_t hd . #'(coco_deref m (nth 0 items))) (size_t built))
              (if (== n 1)
                  (set built (coco_push m (nth hd (-> m heap))))
                (block
                 (if (not (coco-tag-is ATOM (nth hd (-> m heap))))
                     (block (free items) (return (coco_fail_err e "=.. wants an atom at the head"))))
                 (set built (coco_make m (coco_atom_name m (coco_name_of m hd)) (cast u32 (- n 1))
                                     (+ items 1)))))
              (free items)
              (return (? (coco_unify m (coco_arg m g 0) built) 1 0))))))

  (func coco_bi_copy_term ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t c . #'(coco_copy (-> e m) (coco_arg (-> e m) g 0))))
          (return (? (coco_unify m (coco_arg m g 1) c) 1 0))))

  ;;; ---- atoms and text ----

  ;;; The printed form of a term, into B. Used by the atom builtins, which are
  ;;; all "write it, then do something with the characters".
  (static)
  (func coco_text_of ((coco_engine * e) (size_t t) (coco_strbuf * b)) (out int)
        (coco_sb_init b)
        (return (coco_write_term (-> e m) b t 0 0)))

  (func coco_bi_atom_length ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0))
              (coco_strbuf b) (int r))
          (if (coco-tag-is REF (nth t (-> m heap)))
              (return (coco_instantiation_error e)))
          (coco_text_of e t (aof b))
          (set r (coco_unify m (coco_arg m g 1) (coco_new_int m (cast i64 ($ b len)))))
          (coco_sb_free (aof b))
          (return (? r 1 0))))

  (static)
  (func coco_codes_of ((coco_engine * e) (const char * s) (size_t n)) (out size_t)
        (let ((coco_machine * m . #'(-> e m))
              (size_t lst . #'(coco_new_atom (-> e m) "[]")))
          (while (> n 0)
            (set n (- n 1))
            (set lst (coco_cons m (coco_new_int m (cast i64 (cast uchar (nth n s)))) lst)))
          (return lst)))

  ;;; Collects a code list into B. Answers 0 if it is not a proper list of
  ;;; character codes.
  (static)
  (func coco_codes_to_text ((coco_engine * e) (size_t lst) (coco_strbuf * b)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (coco_sb_init b)
          (while 1
            (set lst (coco_deref m lst))
            (let ((u64 c . #'(nth lst (-> m heap))))
              (if (coco-tag-is ATOM c)
                  (return (? (== 0 (strcmp (coco_atom_name m (coco_name_of m lst)) "[]")) 1 0)))
              (if (not (coco_is_cons m lst)) (return 0))
              ;; A CODE OR A ONE-CHARACTER ATOM. `double_quotes' has four
              ;; values and TWO of them make a list, so under `chars' the
              ;; "ab" a program hands string_length/2 IS [a,b] -- and a walk
              ;; that took only codes fell through to writing the term, which
              ;; answers 5. That is the silent wrong answer this whole
              ;; conversion exists to stop, in the other of its two shapes.
              (let ((size_t h . #'(coco_deref m (coco_arg m lst 0))))
                (if (coco-tag-is INT (nth h (-> m heap)))
                    (coco_sb_putc b (cast char (coco-signed-payload (nth h (-> m heap)))))
                    (block
                     (if (not (coco-tag-is ATOM (nth h (-> m heap)))) (return 0))
                     (let ((const char * cs . #'(coco_atom_name m (coco_name_of m h))))
                       (if (!= (strlen cs) 1) (return 0))
                       (coco_sb_putc b (nth 0 cs))))))
              (set lst (coco_arg m lst 1))))
          (return 0)))

  ;;; ---- SWI's string type ------------------------------------------------
  ;;;
  ;;; TEXT IN, STRING OUT is the rule these follow, and it is SWI's. Anything
  ;;; that has text -- an atom, a number, a string -- is accepted where text is
  ;;; wanted; what comes back is a STRING wherever SWI answers one. A code
  ;;; list is text to string_codes/2 and to nothing else, because a list is a
  ;;; list and guessing is how `[104,105]' becomes the word `hi' by accident.

  (func coco_bi_string ((coco_engine * e) (size_t g)) (out int)
        (return (coco_is_string (-> e m) (coco_a e g 0))))

  ;;; The text of ARG, for the predicates below. A string gives its bytes; an
  ;;; atom or a number gives what the writer writes unquoted. Answers 0 for an
  ;;; unbound variable, which every caller turns into instantiation_error.
  (static)
  (func coco_str_arg ((coco_engine * e) (size_t t) (coco_strbuf * b)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t d . #'(coco_deref m t))
              (const char * sp . nil) (size_t sn . 0))
          (if (coco-tag-is REF (nth d (-> m heap))) (return 0))
          (if (coco_string_text m d (aof sp) (aof sn))
              (block (coco_sb_init b)
                     (for ((size_t i . 0)) (< i sn) ((++ i)) (coco_sb_putc b (nth i sp)))
                     (return 1)))
          ;; A PROPER LIST OF CODES IS TEXT, which is SWI's rule and matters
          ;; here more than it does there: `double_quotes' is `codes', so
          ;; `"hello"' IS [104,101,108,108,111] and a porter writes it
          ;; expecting text. Without this, string_length("hello", N) answered
          ;; 21 -- the length of `[104,101,108,108,111]' written out -- which
          ;; is the silent wrong answer this repository exists to refuse.
          ;;
          ;; NOT A GUESS, and the distinction is the one library(json) draws:
          ;; there a bare list is genuinely ambiguous between an array and
          ;; text, so it refuses. Here the argument position says TEXT, and a
          ;; list that is not a proper list of codes still falls through to
          ;; the writer below.
          (if (coco_codes_to_text e d b) (return 1))
          (return (coco_text_of e d b))))

  (static)
  (func coco_str_new ((coco_engine * e) (coco_strbuf * b)) (out size_t)
        (return (coco_new_string (-> e m)
                                 (? (== ($ (cof b) s) nil) "" ($ (cof b) s))
                                 ($ (cof b) len))))

  ;;; ONE RELATION, TWO SPELLINGS. AI is the argument that is an ATOM and SI
  ;;; the one that is a STRING; whichever is bound decides the direction.
  (static)
  (func coco_str_convert ((coco_engine * e) (size_t g) (int ai) (int si)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (coco_strbuf b) (int r))
          (if (coco_str_arg e (coco_arg m g (cast size_t ai)) (aof b))
              (block (set r (coco_unify m (coco_arg m g (cast size_t si))
                                        (coco_str_new e (aof b))))
                     (coco_sb_free (aof b))
                     (return (? r 1 0))))
          (if (not (coco_str_arg e (coco_arg m g (cast size_t si)) (aof b)))
              (return (coco_instantiation_error e)))
          (set r (coco_unify m (coco_arg m g (cast size_t ai))
                             (coco_new_atom m (? (== ($ b s) nil) "" ($ b s)))))
          (coco_sb_free (aof b))
          (return (? r 1 0))))

  ;;; A CHARACTER IS A ONE-CHARACTER ATOM, not a code -- string_chars/2 and
  ;;; string_codes/2 differ in exactly that.
  (static)
  (func coco_chars_of ((coco_engine * e) (const char * s) (size_t n)) (out size_t)
        (let ((coco_machine * m . #'(-> e m))
              (size_t lst . #'(coco_new_atom (-> e m) "[]")))
          (while (> n 0)
            (set n (- n 1))
            (let ((char one [2]))
              (set (nth 0 one) (nth n s))
              (set (nth 1 one) (cast char 0))
              (set lst (coco_cons m (coco_new_atom m one) lst))))
          (return lst)))

  (static)
  (func coco_chars_to_text ((coco_engine * e) (size_t lst) (coco_strbuf * b)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (coco_sb_init b)
          (while 1
            (set lst (coco_deref m lst))
            (let ((u64 c . #'(nth lst (-> m heap))))
              (if (coco-tag-is ATOM c)
                  (return (? (== 0 (strcmp (coco_atom_name m (coco_name_of m lst)) "[]")) 1 0)))
              (if (not (coco_is_cons m lst)) (return 0))
              (let ((size_t h . #'(coco_deref m (coco_arg m lst 0)))
                    (const char * one . nil))
                (set one (coco_atom_name m (coco_name_of m h)))
                (if (or (== one nil) (!= 1 (strlen one))) (return 0))
                (coco_sb_putc b (nth 0 one)))
              (set lst (coco_arg m lst 1))))
          (return 0)))

  ;;; string_codes/2 and string_chars/2 differ only in what the list holds.
  (static)
  (func coco_str_list ((coco_engine * e) (size_t g) (int chars)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (coco_strbuf b) (int r))
          (if (coco_str_arg e (coco_arg m g 0) (aof b))
              (block (set r (coco_unify m (coco_arg m g 1)
                                        (? chars
                                           (coco_chars_of e ($ b s) ($ b len))
                                           (coco_codes_of e ($ b s) ($ b len)))))
                     (coco_sb_free (aof b))
                     (return (? r 1 0))))
          (if (not (? chars
                      (coco_chars_to_text e (coco_arg m g 1) (aof b))
                      (coco_codes_to_text e (coco_arg m g 1) (aof b))))
              (block (coco_sb_free (aof b))
                     (return (coco_instantiation_error e))))
          (set r (coco_unify m (coco_arg m g 0) (coco_str_new e (aof b))))
          (coco_sb_free (aof b))
          (return (? r 1 0))))

  (static)
  (func coco_str_join ((coco_engine * e) (size_t g) (int as_string)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (coco_strbuf a) (coco_strbuf b)
              (coco_strbuf o) (int r))
          (if (not (coco_str_arg e (coco_arg m g 0) (aof a)))
              (return (coco_instantiation_error e)))
          (if (not (coco_str_arg e (coco_arg m g 1) (aof b)))
              (block (coco_sb_free (aof a)) (return (coco_instantiation_error e))))
          (coco_sb_init (aof o))
          (for ((size_t i . 0)) (< i ($ a len)) ((++ i)) (coco_sb_putc (aof o) (nth i ($ a s))))
          (for ((size_t i . 0)) (< i ($ b len)) ((++ i)) (coco_sb_putc (aof o) (nth i ($ b s))))
          (set r (coco_unify m (coco_arg m g 2)
                             (? as_string
                                (coco_str_new e (aof o))
                                (coco_new_atom m (? (== ($ o s) nil) "" ($ o s))))))
          (coco_sb_free (aof a)) (coco_sb_free (aof b)) (coco_sb_free (aof o))
          (return (? r 1 0))))

  ;;; ASCII ONLY, and saying so is better than a table that is right for
  ;;; Latin-1 and wrong for everything else: cocolog is byte-oriented and has
  ;;; no decoder, so a byte above 0x7F is left exactly as it came in.
  (static)
  (func coco_str_case ((coco_engine * e) (size_t g) (int up)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (coco_strbuf b) (int r))
          (if (not (coco_str_arg e (coco_arg m g 0) (aof b)))
              (return (coco_instantiation_error e)))
          (for ((size_t i . 0)) (< i ($ b len)) ((++ i))
               (let ((int c . #'(bitand (cast int (nth i ($ b s))) 255)))
                 (if up
                     (if (and (>= c 97) (<= c 122)) (set (nth i ($ b s)) (cast char (- c 32))))
                   (if (and (>= c 65) (<= c 90)) (set (nth i ($ b s)) (cast char (+ c 32)))))))
          (set r (coco_unify m (coco_arg m g 1) (coco_str_new e (aof b))))
          (coco_sb_free (aof b))
          (return (? r 1 0))))

  (static)
  (func coco_str_member ((char c) (coco_strbuf * set)) (out int)
        (for ((size_t i . 0)) (< i ($ (cof set) len)) ((++ i))
             (if (== (nth i ($ (cof set) s)) c) (return 1)))
        (return 0))

  (func coco_bi_string_length ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (coco_strbuf b) (int r))
          (if (not (coco_str_arg e (coco_arg m g 0) (aof b)))
              (return (coco_instantiation_error e)))
          (set r (coco_unify m (coco_arg m g 1) (coco_new_int m (cast i64 ($ b len)))))
          (coco_sb_free (aof b))
          (return (? r 1 0))))

  ;;; atom_string(?Atom, ?String) -- either way round, as SWI has it.
  (func coco_bi_atom_string ((coco_engine * e) (size_t g)) (out int)
        (return (coco_str_convert e g 0 1)))

  ;;; string_to_atom(?String, ?Atom) -- the same relation, arguments swapped.
  (func coco_bi_string_to_atom ((coco_engine * e) (size_t g)) (out int)
        (return (coco_str_convert e g 1 0)))

  ;;; number_string(?Number, ?String). The reader is what decides what a
  ;;; number looks like, so parsing goes through it rather than through a
  ;;; second opinion in strtod.
  (func coco_bi_number_string ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (coco_strbuf b) (int r))
          (if (coco_str_arg e (coco_arg m g 0) (aof b))
              (block (set r (coco_unify m (coco_arg m g 1) (coco_str_new e (aof b))))
                     (coco_sb_free (aof b))
                     (return (? r 1 0))))
          (if (not (coco_str_arg e (coco_arg m g 1) (aof b)))
              (return (coco_instantiation_error e)))
          ;; THE READER IS WHAT DECIDES WHAT A NUMBER LOOKS LIKE, so it is
          ;; the reader that reads it back -- there is no second parser here.
          (let ((size_t num . 0))
            (if (not (coco_read_term_from m (? (== ($ b s) nil) "" ($ b s)) (aof num)))
                (block (coco_sb_free (aof b)) (return 0)))
            (coco_sb_free (aof b))
            (set num (coco_deref m num))
            (let ((u64 c . #'(nth num (-> m heap))))
              (if (not (or (coco-tag-is INT c) (coco-tag-is FLT c))) (return 0)))
            (return (? (coco_unify m (coco_arg m g 0) num) 1 0)))))

  (func coco_bi_string_codes ((coco_engine * e) (size_t g)) (out int)
        (return (coco_str_list e g 0)))

  (func coco_bi_string_chars ((coco_engine * e) (size_t g)) (out int)
        (return (coco_str_list e g 1)))

  ;;; string_concat(+A, +B, -C). THE SPLIT MODE IS NOT HERE: SWI backtracks
  ;;; over every way of cutting C in two when A and B are unbound, and a C
  ;;; builtin in this engine answers once. sub_string/5 is the predicate for
  ;;; that question and it is a clause, so it can.
  (func coco_bi_string_concat ((coco_engine * e) (size_t g)) (out int)
        (return (coco_str_join e g 1)))

  ;;; text_concat(+A, +B, -C) answers a STRING when either input is one and
  ;;; an ATOM otherwise, which is SWI's rule.
  (func coco_bi_text_concat ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (return (coco_str_join e g
                                 (? (or (coco_is_string m (coco_arg m g 0))
                                        (coco_is_string m (coco_arg m g 1)))
                                    1 0)))))

  (func coco_bi_string_lower ((coco_engine * e) (size_t g)) (out int)
        (return (coco_str_case e g 0)))

  (func coco_bi_string_upper ((coco_engine * e) (size_t g)) (out int)
        (return (coco_str_case e g 1)))

  ;;; term_string(?Term, ?String): write the term, or read the string as one.
  (func coco_bi_term_string ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (coco_strbuf b) (int r)
              (size_t t . #'(coco_a e g 0)))
          (if (not (coco-tag-is REF (nth t (-> m heap))))
              (block (coco_sb_init (aof b))
                     (coco_write_term m (aof b) t 1 0)
                     (set r (coco_unify m (coco_arg m g 1) (coco_str_new e (aof b))))
                     (coco_sb_free (aof b))
                     (return (? r 1 0))))
          (if (not (coco_str_arg e (coco_arg m g 1) (aof b)))
              (return (coco_instantiation_error e)))
          (let ((size_t term . 0))
            (if (not (coco_read_term_from m (? (== ($ b s) nil) "" ($ b s)) (aof term)))
                (block (coco_sb_free (aof b)) (return 0)))
            (coco_sb_free (aof b))
            (return (? (coco_unify m (coco_arg m g 0) term) 1 0)))))

  ;;; split_string(+String, +SepChars, +PadChars, -SubStrings)
  ;;;
  ;;; SWI's, including the two rules everybody trips over: with NO separators
  ;;; the answer is a one-element list holding the padded string, and with
  ;;; separators the answer always has one more element than there were
  ;;; separators -- so `split_string("a,,b", ",", "", X)' gives three, the
  ;;; middle one empty. Padding is stripped from BOTH ends of every field,
  ;;; after splitting.
  (func coco_bi_split_string ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_strbuf str) (coco_strbuf sep) (coco_strbuf pad)
              (size_t out . 0) (int r . 0) (size_t start . 0) (size_t i . 0)
              (size_t * ends . nil) (size_t nends . 0))
          (if (not (coco_str_arg e (coco_arg m g 0) (aof str)))
              (return (coco_instantiation_error e)))
          (if (not (coco_str_arg e (coco_arg m g 1) (aof sep)))
              (block (coco_sb_free (aof str)) (return (coco_instantiation_error e))))
          (if (not (coco_str_arg e (coco_arg m g 2) (aof pad)))
              (block (coco_sb_free (aof str)) (coco_sb_free (aof sep))
                     (return (coco_instantiation_error e))))
          ;; BUILT BACK TO FRONT, because a list is built from its tail.
          (set ends (cast (size_t *) (malloc (* (sizeof size_t) (+ ($ str len) 2)))))
          (if (== ends nil)
              (block (coco_sb_free (aof str)) (coco_sb_free (aof sep))
                     (coco_sb_free (aof pad)) (return 0)))
          (set (nth 0 ends) 0)
          (set nends 1)
          (for ((size_t k . 0)) (< k ($ str len)) ((++ k))
               (if (coco_str_member (nth k ($ str s)) (aof sep))
                   (block (set (nth nends ends) (+ k 1)) (set nends (+ nends 1)))))
          (set out (coco_new_atom m "[]"))
          (set i nends)
          (while (> i 0)
            (set i (- i 1))
            (let ((size_t from . #'(nth i ends))
                  (size_t to . #'(? (< (+ i 1) nends) (- (nth (+ i 1) ends) 1) ($ str len))))
              (while (and (< from to) (coco_str_member (nth from ($ str s)) (aof pad)))
                (set from (+ from 1)))
              (while (and (> to from) (coco_str_member (nth (- to 1) ($ str s)) (aof pad)))
                (set to (- to 1)))
              (set out (coco_cons m (coco_new_string m (+ ($ str s) from) (- to from)) out))))
          (set start start)
          (free ends)
          (set r (coco_unify m (coco_arg m g 3) out))
          (coco_sb_free (aof str)) (coco_sb_free (aof sep)) (coco_sb_free (aof pad))
          (return (? r 1 0))))

  (func coco_bi_atom_codes ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0)))
          (if (not (coco-tag-is REF (nth t (-> m heap))))
              (let ((coco_strbuf b) (int r))
                (coco_text_of e t (aof b))
                (set r (coco_unify m (coco_arg m g 1) (coco_codes_of e ($ b s) ($ b len))))
                (coco_sb_free (aof b))
                (return (? r 1 0))))
          (let ((coco_strbuf b) (int r))
            (if (not (coco_codes_to_text e (coco_arg m g 1) (aof b)))
                (block (coco_sb_free (aof b))
                       (return (coco_instantiation_error e))))
            (set r (coco_unify m (coco_arg m g 0)
                             (coco_new_atom m (? (== ($ b s) nil) "" ($ b s)))))
            (coco_sb_free (aof b))
            (return (? r 1 0)))))

  (func coco_bi_number_codes ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t t . #'(coco_a e g 0)))
          (if (not (coco-tag-is REF (nth t (-> m heap))))
              (let ((coco_strbuf b) (int r))
                (coco_text_of e t (aof b))
                (set r (coco_unify m (coco_arg m g 1) (coco_codes_of e ($ b s) ($ b len))))
                (coco_sb_free (aof b))
                (return (? r 1 0))))
          (let ((coco_strbuf b) (size_t num) (int r))
            (if (not (coco_codes_to_text e (coco_arg m g 1) (aof b)))
                (block (coco_sb_free (aof b))
                       (return (coco_instantiation_error e))))
            ;; the reader is what decides what a number looks like, so it is
            ;; the reader that reads it back -- there is no second parser here
            (if (not (coco_read_term_from m (? (== ($ b s) nil) "" ($ b s)) (aof num)))
                (block (coco_sb_free (aof b)) (return 0)))
            (coco_sb_free (aof b))
            (set num (coco_deref m num))
            ;; the reader reads "+7" as the term +(7); SWI's number_codes
            ;; accepts the written sign, so the wrapping plus is unwrapped
            (let ((u64 c . #'(nth num (-> m heap))))
              (if (and (coco-tag-is FUN c)
                       (== 1 (coco_arity m num))
                       (== 0 (strcmp (coco_atom_name m (coco_name_of m num)) "+")))
                  (block (set num (coco_deref m (coco_arg m num 0)))
                         (set c (nth num (-> m heap)))))
              (if (not (or (coco-tag-is INT c) (coco-tag-is FLT c))) (return 0)))
            (set r (coco_unify m (coco_arg m g 0) num))
            (return (? r 1 0)))))

  ;;; Does S begin with the PN characters of P? An explicit loop rather
  ;;; than strncmp, which this file does not otherwise declare.
  (static)
  (func coco_starts_with ((const char * s) (const char * p) (size_t pn)) (out int)
        (for ((size_t i . 0)) (< i pn) ((++ i))
          (if (!= (nth i s) (nth i p)) (return 0)))
        (return 1))

  ;;; ATOM_CONCAT HAS FOUR MODES AND THIS ENGINE CAN SERVE THREE.
  ;;;
  ;;; (+,+,?) concatenates, which is all it did before. The two modes
  ;;; where the THIRD argument is bound and exactly one of the first two
  ;;; is not are DECIDED rather than searched -- one is a prefix test and
  ;;; the other a suffix test -- and ISO 8.16.6 requires both. Refusing
  ;;; them made `atom_concat(Prefix, _, Name)' throw where every other
  ;;; Prolog answers, which is how this was found: a namespace check in a
  ;;; caller, written the obvious way, raised instead of failing.
  ;;;
  ;;; (-,-,+) is the mode that ENUMERATES every split, and it stays an
  ;;; instantiation_error here on purpose. It needs a choice point, and
  ;;; the note at the top of this file is the reason: a builtin holding
  ;;; the choice stack would be the one piece of this system nobody else
  ;;; could have written. That mode belongs in the Prolog library beside
  ;;; `between/3', where it is a few lines over `sub_atom/5'.
  (func coco_bi_atom_concat ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t a . #'(coco_a e g 0))
              (size_t b . #'(coco_a e g 1))
              (size_t c . #'(coco_a e g 2)))
          (let ((int aref . #'(? (coco-tag-is REF (nth a (-> m heap))) 1 0))
                (int bref . #'(? (coco-tag-is REF (nth b (-> m heap))) 1 0))
                (int cref . #'(? (coco-tag-is REF (nth c (-> m heap))) 1 0)))

            ;; (+,+,?) -- concatenate and unify.
            (if (and (== aref 0) (== bref 0))
                (let ((coco_strbuf ab) (coco_strbuf bb) (int r))
                  (coco_text_of e a (aof ab))
                  (coco_text_of e b (aof bb))
                  (if (!= ($ bb s) nil) (coco_sb_put (aof ab) ($ bb s)))
                  (set r (coco_unify m (coco_arg m g 2)
                                   (coco_new_atom m (? (== ($ ab s) nil) "" ($ ab s)))))
                  (coco_sb_free (aof ab))
                  (coco_sb_free (aof bb))
                  (return (? r 1 0))))

            ;; Nothing is determined without the whole.
            (if (== cref 1) (return (coco_instantiation_error e)))
            (if (and (== aref 1) (== bref 1)) (return (coco_instantiation_error e)))

            ;; The third is bound and exactly one of the first two is.
            (let ((coco_strbuf cb) (coco_strbuf xb) (int r . 0)
                  (const char * cs) (const char * xs)
                  (size_t clen . 0) (size_t xlen . 0))
              (coco_text_of e c (aof cb))
              (coco_text_of e (? (== aref 1) b a) (aof xb))
              (set cs (? (== ($ cb s) nil) "" ($ cb s)))
              (set xs (? (== ($ xb s) nil) "" ($ xb s)))
              (set clen ($ cb len))
              (set xlen ($ xb len))
              (if (> xlen clen)
                  (block (coco_sb_free (aof cb)) (coco_sb_free (aof xb)) (return 0)))
              (if (== bref 1)
                  ;; (+,-,+): A must be a prefix of C, and B is the rest.
                  (block
                    (if (== 0 (coco_starts_with cs xs xlen))
                        (block (coco_sb_free (aof cb)) (coco_sb_free (aof xb)) (return 0)))
                    (set r (coco_unify m (coco_arg m g 1)
                                     (coco_new_atom m (+ cs xlen)))))
                  ;; (-,+,+): B must be a suffix of C, and A is the rest.
                  (block
                    (if (== 0 (coco_starts_with (+ cs (- clen xlen)) xs xlen))
                        (block (coco_sb_free (aof cb)) (coco_sb_free (aof xb)) (return 0)))
                    (if (== clen xlen)
                        (set r (coco_unify m (coco_arg m g 0) (coco_new_atom m "")))
                        ;; clen > xlen here, so the buffer is a real one and
                        ;; cutting it short for one call is safe.
                        (let ((char * cut . #'(cast (char *) cs)) (char keep . 0))
                          (set keep (nth (- clen xlen) cut))
                          (set (nth (- clen xlen) cut) 0)
                          (set r (coco_unify m (coco_arg m g 0) (coco_new_atom m cs)))
                          (set (nth (- clen xlen) cut) keep)))))
              (coco_sb_free (aof cb))
              (coco_sb_free (aof xb))
              (return (? r 1 0))))))

  ;;; ---- output ----

  (func coco_bi_write ((coco_engine * e) (size_t g)) (out int)
        (coco_print_term (-> e m) stdout (coco_arg (-> e m) g 0))
        (return 1))

  (func coco_bi_writeln ((coco_engine * e) (size_t g)) (out int)
        (coco_print_term (-> e m) stdout (coco_arg (-> e m) g 0))
        (fputc 10 stdout)
        (return 1))

  (func coco_bi_write_canonical ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_canonical (-> e m) (aof b) (coco_arg (-> e m) g 0))
          (if (!= ($ b s) nil) (fputs ($ b s) stdout))
          (coco_sb_free (aof b))
          (return 1)))

  (func coco_bi_nl ((coco_engine * e) (size_t g)) (out int)
        (fputc 10 stdout)
        (return 1))

  ;;; ---- the database ----

  ;;; ASSERTING INTO A PREDICATE IS WHAT MAKES IT DYNAMIC, which is SWI's rule
  ;;; and the one that makes `existence_error' safe to raise at all. Without it,
  ;;; asserting a fact and retracting it again would leave a predicate that is
  ;;; neither defined nor declared, and the next call to it would raise where
  ;;; every other Prolog quietly fails.
  ;;;
  ;;; Only the GOAL marks. `coco_consult' asserts through the same function, and
  ;;; marking there would make every consulted predicate dynamic and put a
  ;;; `:- dynamic' line above all of them in `listing'.
  (static)
  (func coco_assert_goal ((coco_engine * e) (size_t g) (int at_end)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t c . #'(coco_deref m (coco_arg m g 0)))
              (size_t head))
          (set head c)
          ;; a rule marks the predicate its HEAD names, not `:-'/2
          (if (and (coco_is_callable m c) (== (coco_arity m c) 2))
              (if (== 0 (strcmp (coco_atom_name m (coco_name_of m c)) ":-"))
                  (set head (coco_deref m (coco_arg m c 0)))))
          ;; A REFUSAL THE STORE CAN EXPLAIN IS AN EXCEPTION, not a failure.
          ;; `coco_assert' runs below the engine and has no ball to throw, so
          ;; it leaves a sentence behind instead -- today, a clause too long
          ;; for a row. `resource_error/1' is ISO's shape and catchable, which
          ;; is the whole point: the alternative was a commit that took every
          ;; other clause of the transaction with it.
          (if (not (coco_assert (-> e st) m c at_end))
              (block
               (if (!= (nth 0 ($ (cof (-> e st)) assert_err)) (cast char 0))
                   (return (coco_raise e (coco_make1 m "resource_error"
                                                     (coco_new_atom m "clause_length")))))
               (return 0)))
          (if (coco_is_callable m head)
              (coco_pred_dynamic (-> e st) (coco_name_of m head) (coco_arity m head)))
          (coco_store_maybe_compact (-> e st) m)
          (return 1)))

  (func coco_bi_asserta ((coco_engine * e) (size_t g)) (out int)
        (return (coco_assert_goal e g 0)))

  (func coco_bi_assertz ((coco_engine * e) (size_t g)) (out int)
        (return (coco_assert_goal e g 1)))

  (func coco_bi_retract ((coco_engine * e) (size_t g)) (out int)
        (let ((int ok . #'(coco_retract (-> e st) (-> e m) (coco_arg (-> e m) g 0))))
          (coco_store_maybe_compact (-> e st) (-> e m))
          (return (? ok 1 0))))

  ;;; `dynamic(Spec)' as a goal, which is the same thing `:- dynamic Spec.'
  ;;; does when a file is consulted -- one implementation, reached two ways.
  (func coco_bi_dynamic ((coco_engine * e) (size_t g)) (out int)
        (let ((char err [192]))
          (if (not (coco_dynamic_spec (-> e st) (-> e m) (coco_arg (-> e m) g 0)
                                    err (sizeof err)))
              (return (coco_fail_err e err)))
          (return 1)))

  ;;; ---- listing ------------------------------------------------------------

  ;;; One predicate, written so that it reads back. A `:- dynamic' line first if
  ;;; it is one, then a clause per line, then a blank line.
  ;;;
  ;;; IT ASKS THE BACKEND FIRST. A predicate whose clauses are still in the
  ;;; database has an empty list here until somebody calls it, and a `listing'
  ;;; that showed nothing for a predicate that plainly has clauses would be
  ;;; worse than no listing at all.
  ;;; Answers whether it printed anything: a predicate that is neither declared
  ;;; nor has any clauses is one this store merely has a name for -- interned by
  ;;; a call that failed, or left behind by retracting the last clause of
  ;;; something never declared -- and listing a blank line for it says nothing.
  (static)
  (func coco_listing_pred ((coco_engine * e) (size_t pi)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (coco_strbuf b))
          (coco_pred_ensure st pi)
          (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
                (const char * nm . #'(coco_atom_name m ($ (nth pi (-> st preds)) name)))
                (int dyn . #'($ (nth pi (-> st preds)) dynamic)))

            (if (and (not dyn) (== (-> p nclauses) 0)) (return 0))

            (if dyn
                (printf ":- dynamic %s/%u.\n\n" nm
                        (cast unsigned ($ (nth pi (-> st preds)) arity))))

            (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
              (let ((size_t mark . #'(-> m heap_len))
                    (size_t t . #'(coco_store_get m st (nth i (-> p clauses)))))
                (coco_sb_init (aof b))
                ;; quoted, so an atom that needs them gets them and the line can
                ;; be pasted back into a file
                (coco_write_term m (aof b) t 1 0)
                (if (!= ($ b s) nil) (fputs ($ b s) stdout))
                (fputs ".\n" stdout)
                (coco_sb_free (aof b))
                ;; the clause was copied on to the heap only to be written
                (set (-> m heap_len) mark)))
            ;; the blank line separates predicates. A declared predicate with no
            ;; clauses has already had one after its `:- dynamic' line.
            (if (or (> (-> p nclauses) 0) (not dyn)) (fputs "\n" stdout))
            (return 1))))

  ;;; `listing' with no argument is the PROGRAM, not everything reachable. A
  ;;; module's clauses are in the same store -- that is what makes them
  ;;; callable -- but a person asking what they have written does not want the
  ;;; Files library back, any more than SWI's `listing' hands back library(lists).
  ;;; `listing(Name)' still shows them: asking for one by name is asking about
  ;;; that one specifically.
  (func coco_bi_listing_all ((coco_engine * e) (size_t g)) (out int)
        (coco_store_warm (-> e st))
        ;; `npreds' is read each time round rather than once: `coco_pred_ensure'
        ;; inside the listing can intern predicates the clauses it fetches
        ;; mention, and the loop should reach those too.
        (for ((size_t i . 0)) (< i ($ (cof (-> e st)) npreds)) ((++ i))
          (if (not ($ (nth i ($ (cof (-> e st)) preds)) library))
              (coco_listing_pred e i)))
        (return 1))

  ;;; `listing(Name)' lists every arity of that name; `listing(Name/Arity)' the
  ;;; one. Both are what other Prologs do, and a program that knows only the
  ;;; name of what it asserted should not have to count its arguments.
  (func coco_bi_listing ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t spec . #'(coco_a e g 0))
              (int shown . 0))

          ;; ASKED BEFORE ANYTHING IS DECIDED, for either shape of argument.
          ;; What the backend holds is not only which predicates there are but
          ;; which of them were DECLARED, and a `listing(counter/1)' that found
          ;; the clauses and missed the `:- dynamic' line would be quietly
          ;; wrong in a way that reads back as a different program.
          (coco_store_warm st)

          (if (coco_is_compound2 m spec "/")
              (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
                    (size_t ar . #'(coco_deref m (coco_arg m spec 1))))
                (if (not (coco-tag-is ATOM (nth nm (-> m heap))))
                    (return (coco_fail_err e "listing/1 needs a name")))
                (if (not (coco-tag-is INT (nth ar (-> m heap))))
                    (return (coco_fail_err e "listing/1 needs an arity")))
                ;; interned rather than merely looked up: a predicate this
                ;; interpreter has not called yet is not in the store, and
                ;; `listing' of it should say what the knowledge base holds
                ;; rather than what this process happens to have reached.
                (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m nm)
                                                     (cast u32 (coco-signed-payload
                                                                (nth ar (-> m heap)))))))
                  (if (>= pi (-> st npreds)) (return 0))
                  (return (coco_listing_pred e pi)))))

          (if (not (coco-tag-is ATOM (nth spec (-> m heap))))
              (return (coco_fail_err e "listing/1 needs a name or Name/Arity")))

          ;; By name: every arity of it. The store has no index from a name to
          ;; its arities, so this is a walk -- over what warming put there.
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (if (== ($ (nth i (-> st preds)) name) (coco_name_of m spec))
                (if (coco_listing_pred e i) (set shown 1))))
          (return shown)))

  (func coco_bi_halt ((coco_engine * e) (size_t g)) (out int)
        (set (-> e halted) 1)
        (return 1))

  ;;; `vacuum_kb' and `vacuum_kb(Live)': the reclaim pass, from inside a
  ;;; program. The store's `vacuum' hook is the whole permission model -- a
  ;;; backend that can vacuum installs it, and the composition root clears it
  ;;; again unless the operator said `--vacuum' -- so a null hook here is a
  ;;; refusal, not an absence: permission_error, with the goal itself as the
  ;;; culprit. Deliberately NOT a quiet success on a local store, because a
  ;;; program that believes it vacuumed and did not is the exact confusion
  ;;; the loud cuda refusal exists to prevent one seam over.
  ;;;
  ;;; Live is the count of live rows left behind -- run it twice and the
  ;;; second answer being the same is what says there was nothing left.
  (func coco_bi_vacuum_kb ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_store * st . #'(-> e st))
              (i64 live . 0))
          (if (== (-> st vacuum) nil)
              (return (coco_permission_error e "vacuum" "knowledge_base" g)))
          (if (not ((-> st vacuum) st (-> st ctx) (aof live)))
              (return (coco_fail_err e "vacuum_kb: the backend refused the pass")))
          (if (== 0 (coco_arity (-> e m) g)) (return 1))
          (return (? (coco_unify (-> e m) (coco_arg (-> e m) g 0)
                                 (coco_new_int (-> e m) live)) 1 0))))

  (func coco_choice_restore ((coco_engine * e) (int kind) (size_t goals)
                           (size_t trail_mark) (size_t heap_mark) (size_t call)
                           (size_t clause_ix) (size_t barrier)
                           (const char * pred_name) (u32 pred_arity)) (out int)
        (if (not (coco_eng_grow e (+ (-> e nchoices) 1))) (return 0))
        ;; the shadow frame ZEROED, which is what the tracer's comment has
        ;; always said a thawed frame gets -- the realloc that makes room for
        ;; it does not zero, and the heap collector reads its goal as a root
        (memset (aof (nth (-> e nchoices) (-> e tchoices))) 0 (sizeof coco_tchoice))
        (let ((coco_choice * c . #'(aof (nth (-> e nchoices) (-> e choices)))))
          (memset c 0 (sizeof coco_choice))
          (set (-> c kind) kind)
          (set (-> c goals) goals)
          (set (-> c trail_mark) trail_mark)
          (set (-> c heap_mark) heap_mark)
          (set (-> c call) call)
          (set (-> c clause_ix) clause_ix)
          (set (-> c barrier) barrier)
          (if (== kind COCO_CH_CLAUSE)
              (let ((size_t pi . #'(coco_pred_intern (-> e st)
                                                   (coco_intern (-> e m) pred_name)
                                                   pred_arity)))
                (if (>= pi ($ (cof (-> e st)) npreds)) (return 0))
                ;; ask the backend for this predicate NOW rather than when the
                ;; frame is next tried: `clause_ix' is a position in its clause
                ;; list, and a list that has not been fetched yet is empty
                (coco_pred_ensure (-> e st) pi)
                (set (-> c pred) pi)))
          (set (-> e nchoices) (+ (-> e nchoices) 1))
          (return 1)))

  ;;; The dispatcher comes last because it names every builtin above it, and a
  ;;; call needs the definition to have been seen.
  (coco-emit-id-fill)

  (coco-emit-builtin-dispatch)
  (coco-emit-builtin-index)

  ;;; THE NAMES THE ENVIRONMENT'S COMPILER TELLS A CONSTRUCT BY (Stage 6),
  ;;; from the vocabulary interned once per machine (lib/kb.cicili asks):
  ;;; NAMES[0 .. 13] the atoms `;', `->', `*->', `\+', `not', `once',
  ;;; `ignore', `,', `true', `fail', `false', `!', `$true' and `$fail', and
  ;;; FCUT the functor `'$cut'/1'. 0, with nothing written, before the
  ;;; vocabulary is interned. Interned at every compile instead, they cost
  ;;; each clause 1 300 instructions.
  (func coco_unit_names ((coco_machine * m) (u64 * names) (u64 * fcut)) (out int)
        (if (not (-> m ids_ready)) (return 0))
        (set (nth 0 names) (coco-id m ";"))
        (set (nth 1 names) (coco-id m "->"))
        (set (nth 2 names) (coco-id m "*->"))
        (set (nth 3 names) (coco-id m "\\+"))
        (set (nth 4 names) (coco-id m "not"))
        (set (nth 5 names) (coco-id m "once"))
        (set (nth 6 names) (coco-id m "ignore"))
        (set (nth 7 names) (coco-id m ","))
        (set (nth 8 names) (coco-id m "true"))
        (set (nth 9 names) (coco-id m "fail"))
        (set (nth 10 names) (coco-id m "false"))
        (set (nth 11 names) (coco-id m "!"))
        (set (nth 12 names) (coco-id m "$true"))
        (set (nth 13 names) (coco-id m "$fail"))
        (set (cof fcut) (coco-fid m "$cut" 1))
        (return 1))
  (coco-emit-builtin-call)

  ) ; impl-solve

;;;; cocolog -- the engine's control: the continuation, choice points, clause
;;;; selection, backtracking, throwing, error text, and calling
;;;
;;; A PIECE OF THE ENGINE, split out of lib/solve.cicili for size (2.16.1,
;;; where that file had reached 11 076 lines). The seven pieces are ONE
;;; translation unit, emitted in this order by cocolog.cicili and by the test
;;; binaries that link the engine: solve, solve-control, solve-gc, solve-loop,
;;; solve-arith, solve-text, solve-db. So a function here calls only what an
;;; earlier piece defined or `decl-solve' declared, exactly as when they were
;;; one file, and a new piece of the engine goes into that list in its place.
;;; lib/solve.cicili keeps the builtin table, the engine's vocabulary and
;;; every declaration: a new builtin's row goes there, its function in the
;;; piece it belongs to.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

(generic impl-solve-control
  ()

  ;;; ---- the continuation --------------------------------------------------

  ;;; A CONTINUATION THAT WOULD NOT FIT. The three builders of the
  ;;; continuation -- `coco_k_push', `coco_k_push_roots', `coco_areg_term'
  ;;; -- answer 0 and write nothing when the heap would not grow, and a
  ;;; caller that stores the 0 as the continuation or as the next goal never
  ;;; runs it: this stops the run at the next step's top, which tests
  ;;; `halted' on every step anyway. 2 is not a halt but memory, and
  ;;; `coco_engine_next' turns it into the error before any host reads it.
  ;;; Through 1.9.3 `coco_k_push' wrote its frame over cells 1 to 3 and the
  ;;; other two left cell 0 as the continuation or the goal.
  (static)
  (func coco_k_room ((coco_engine * e)) (out size_t)
        (if (== (-> e halted) 0) (set (-> e halted) 2))
        (return 0))

  ;;; '$k'(Goal, Barrier, Rest). Built with coco_make rather than the term DSL
  ;;; because all three arguments are values the engine is holding, not a shape
  ;;; known when this was written.
  (static)
  (func coco_k_push ((coco_engine * e) (size_t goal) (size_t barrier) (size_t rest)) (out size_t)
        (let ((coco_machine * m . #'(-> e m))
              (size_t h . 0))
          ;; `coco_engine_ask' pushes the first frame before the loop has
          ;; interned anything, and a thawed machine arrives with nothing
          ;; interned: two loads and a branch, once per machine
          (if (not (-> m ids_ready)) (coco_ids_fill m))
          ;; FOUR CELLS, RESERVED ONCE: the header, the goal and the rest as
          ;; `coco_make' would store them -- dereferenced, which is what
          ;; keeps the chain one link long -- and the barrier AS THE CELL
          ;; ITSELF, an INT in its slot rather than a REF to one pushed
          ;; beside it. Every reader dereferences, and an INT dereferences
          ;; to itself; the collector keeps a kept compound's slots whatever
          ;; they hold. One push and one cell fewer per goal proven.
          (set h (coco_push_struct m (coco-cell FUN (coco-fid m "$k" 3)) 3))
          ;; no room: nothing written over cell 0's neighbours
          (if (== h 0) (return (coco_k_room e)))
          (set (nth (+ h 1) (-> m heap)) (coco-cell REF (coco_deref m goal)))
          (set (nth (+ h 2) (-> m heap)) (coco-int-cell (cast i64 barrier)))
          (set (nth (+ h 3) (-> m heap)) (coco-cell REF (coco_deref m rest)))
          (return h)))

  ;;; A BODY'S GOALS AS ONE RUN OF FRAMES: the N roots a compiled body
  ;;; built (`coco_clause_run') go on the continuation as N `'$k'' frames
  ;;; reserved in ONE growth check and written back to front, each frame's
  ;;; rest the frame after it and the last's the continuation that was
  ;;; there -- cell for cell what N calls of `coco_k_push' would have left,
  ;;; so nothing that reads a continuation can tell. Answers the first
  ;;; goal's frame, or REST itself for a body with no goals (a fact), or 0
  ;;; when the heap would not grow (`coco_k_room').
  (static)
  (func coco_k_push_roots ((coco_engine * e) (const size_t * roots) (size_t n)
                           (size_t barrier) (size_t rest)) (out size_t)
        (let ((coco_machine * m . #'(-> e m))
              (size_t h . #'(-> m heap_len)))
          (if (== n 0) (return rest))
          (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                            (aof (-> m heap_cap)) (+ h (* n 4)) (sizeof u64)))
              (return (coco_k_room e)))
          (set (-> m heap_len) (+ h (* n 4)))
          (let ((u64 hdr . #'(coco-cell FUN (coco-fid m "$k" 3)))
                (u64 bar . #'(coco-int-cell (cast i64 barrier)))
                (size_t next . #'(coco_deref m rest))
                (size_t i . n))
            (while (> i 0)
              (set i (- i 1))
              (let ((size_t f . #'(+ h (* i 4))))
                (set (nth f (-> m heap)) hdr)
                (set (nth (+ f 1) (-> m heap)) (coco-cell REF (coco_deref m (nth i roots))))
                (set (nth (+ f 2) (-> m heap)) bar)
                (set (nth (+ f 3) (-> m heap)) (coco-cell REF next))
                (set next f))))
          (return h)))

  ;;; THE GOAL IN THE REGISTERS, BUILT: the term `coco_clause_run_r' did
  ;;; not build, its header and one slot an argument, each slot pointing at
  ;;; the argument the register holds -- cell for cell what the body program
  ;;; would have left. Answers the term, or 0 when the heap would not grow
  ;;; (`coco_k_room').
  (static)
  (func coco_areg_term ((coco_engine * e)) (out size_t)
        (let ((coco_machine * m . #'(-> e m))
              (u32 n . #'(-> e aarity))
              (size_t * a . #'(aof (nth (* (cast size_t (-> e acur)) 8) (-> e areg))))
              (size_t h . 0))
          (set h (coco_push_struct_raw m (coco-cell FUN (-> e afid)) n))
          ;; no room: nothing written over cell 0's neighbours
          (if (== h 0) (return (coco_k_room e)))
          (for ((u32 i . 0)) (< i n) ((++ i))
            (set (nth (+ h (+ (cast size_t i) 1)) (-> m heap)) (coco-cell REF (nth i a))))
          (return h)))

  ;;; A READ OF THE KNOWLEDGE BASE THAT FAILED, FOR A CALL IN THE REGISTERS
  ;;; (2.11.1): the call built as its term, to be named as the goal in
  ;;; flight, and `coco_fetch_error' raised over it -- 0 when the heap had no
  ;;; room for the term (`coco_k_room' set `halted', and the run stops at the
  ;;; next step's top), else what the raise answers. It and
  ;;; `coco_fetch_error_goal' are (weak), never inlined, so the step loop
  ;;; holds a call where it would hold the ball's construction; the step
  ;;; reaches them only from its way for a predicate with no clauses
  ;;; (`coco_pred_ready' and `coco_pred_count' in lib/kb.cicili say why
  ;;; there).
  (weak)
  (func coco_fetch_error_regs ((coco_engine * e)) (out int)
        (let ((size_t gt . #'(coco_areg_term e)))
          (if (== gt 0) (return 0))
          (set (-> e kcall) gt)
          (return (coco_fetch_error e))))

  ;;; the same for a call that is a term already
  (weak)
  (func coco_fetch_error_goal ((coco_engine * e) (size_t g)) (out int)
        (set (-> e kcall) g)
        (return (coco_fetch_error e)))

  ;;; THE HANDED-OVER GOAL BACK ON THE CONTINUATION, as the frame
  ;;; `coco_try_clause' did not build for it (`ngoal' on the engine). Called
  ;;; before anything reads the continuation as a term -- a collection, and
  ;;; every return from the loop that can leave the machine to be frozen or
  ;;; resumed. Two loads and a branch when nothing is held. Answers 0, with
  ;;; nothing changed, when the heap would not grow (`coco_k_room').
  (static)
  (func coco_k_flush ((coco_engine * e)) (out int)
        ;; a goal in the registers is built first, and then goes back as
        ;; any handed-over goal does
        (if (== (-> e nset) 2)
            (let ((size_t t . #'(coco_areg_term e)))
              (if (== t 0) (return 0))
              (set (-> e ngoal) t)
              (set (-> e nset) 1)))
        (if (-> e nset)
            (let ((size_t f . #'(coco_k_push e (-> e ngoal) (-> e nbar) (-> e goals))))
              (if (== f 0) (return 0))
              (set (-> e nset) 0)
              (set (-> e goals) f)))
        (return 1))

  ;;; ---- the continuation as terms, for a freeze (Stage 5) -----------------
  ;;;
  ;;; A FROZEN MACHINE CARRIES NO ENVIRONMENT. Its image is the heap, the
  ;;; trail and the frames as numbers, and an environment names its code by
  ;;; an address that means nothing in the process that thaws it -- which
  ;;; has its own store, compiled afresh. So a freeze builds what every
  ;;; position it can still reach stands for -- the goal term and `'$k''
  ;;; frame entering the clause built through 1.9.2 -- writes the image,
  ;;; and winds the heap back: the live machine keeps its environments, and
  ;;; the image is one 1.9.2 could have written. The frames' heap marks are
  ;;; raised to the top in the image, so a thawed machine that backtracks
  ;;; keeps the terms built here: a cell kept past a backtrack is only
  ;;; garbage, and every binding is undone by the trail, which is
  ;;; unconditional. What is built is built from the cells as the clause's
  ;;; entry left them, never dereferenced through a binding made since: a
  ;;; choice frame comes back to its goals with those bindings undone.

  ;;; Which continuation cells are built already, and as what: open
  ;;; addressing, the key a cell's index plus one, so what frames and
  ;;; environments share is built once.
  (struct coco_kmemo
    (member u64 *    keys)
    (member size_t * vals)
    (member size_t   cap)
    (member size_t   len))

  (static)
  (func coco_kmemo_slot ((size_t cap) (u64 key)) (out size_t)
        (let ((u64 h . #'(* key (cast u64 0x9E3779B97F4A7C15))))
          (set h (xor h (>> h 29)))
          (return (cast size_t (bitand h (cast u64 (- cap 1)))))))

  (static)
  (func coco_kmemo_get ((coco_kmemo * t) (u64 key) (size_t * out)) (out int)
        (if (== (-> t cap) 0) (return 0))
        (let ((size_t i . #'(coco_kmemo_slot (-> t cap) key)))
          (while (!= (nth i (-> t keys)) 0)
            (if (== (nth i (-> t keys)) key)
                (block (set (cof out) (nth i (-> t vals))) (return 1)))
            (set i (bitand (+ i 1) (- (-> t cap) 1))))
          (return 0)))

  (static)
  (func coco_kmemo_put ((coco_kmemo * t) (u64 key) (size_t val)) (out int)
        ;; under half full before the probe that places it
        (if (> (* (+ (-> t len) 1) 2) (-> t cap))
            (let ((size_t ncap . #'(? (== (-> t cap) 0) 1024 (* (-> t cap) 2)))
                  (u64 * nk . #'(cast (u64 *) (calloc ncap (sizeof u64))))
                  (size_t * nv . #'(cast (size_t *) (calloc ncap (sizeof size_t)))))
              (if (or (== nk nil) (== nv nil)) (block (free nk) (free nv) (return 0)))
              (for ((size_t i . 0)) (< i (-> t cap)) ((++ i))
                (if (!= (nth i (-> t keys)) 0)
                    (let ((size_t j . #'(coco_kmemo_slot ncap (nth i (-> t keys)))))
                      (while (!= (nth j nk) 0) (set j (bitand (+ j 1) (- ncap 1))))
                      (set (nth j nk) (nth i (-> t keys)))
                      (set (nth j nv) (nth i (-> t vals))))))
              (free (-> t keys)) (free (-> t vals))
              (set (-> t keys) nk) (set (-> t vals) nv) (set (-> t cap) ncap)))
        (let ((size_t i . #'(coco_kmemo_slot (-> t cap) key)))
          (while (!= (nth i (-> t keys)) 0) (set i (bitand (+ i 1) (- (-> t cap) 1))))
          (set (nth i (-> t keys)) key)
          (set (nth i (-> t vals)) val)
          (set (-> t len) (+ (-> t len) 1))
          (return 1)))

  (static)
  (func coco_kstk_push ((size_t ** s) (size_t * len) (size_t * cap) (size_t v)) (out int)
        (if (>= (cof len) (cof cap))
            (let ((size_t ncap . #'(? (== (cof cap) 0) 256 (* (cof cap) 2)))
                  (void * nb . #'(realloc (cast (void *) (cof s)) (* ncap (sizeof size_t)))))
              (if (== nb nil) (return 0))
              (set (cof s) (cast (size_t *) nb))
              (set (cof cap) ncap)))
        (set (nth (cof len) (cof s)) v)
        (set (cof len) (+ (cof len) 1))
        (return 1))

  ;;; A `'$k'' FRAME FROM CELLS AS THEY ARE: the goal's cell and the
  ;;; barrier's copied, not dereferenced, over REST. 0 when the heap would
  ;;; not grow.
  (static)
  (func coco_k_frame ((coco_machine * m) (u64 gcell) (u64 bcell) (size_t rest)) (out size_t)
        (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN (coco-fid m "$k" 3)) 3)))
          (if (== h 0) (return 0))
          (set (nth (+ h 1) (-> m heap)) gcell)
          (set (nth (+ h 2) (-> m heap)) bcell)
          (set (nth (+ h 3) (-> m heap)) (coco-cell REF rest))
          (return h)))

  ;;; THE CONTINUATION C0 AS TERMS, into OUT: every position in it turned
  ;;; into its goal -- the term the environment holds, or a call built from
  ;;; its slots, or a cut -- in a `'$k'' frame over what follows it, and
  ;;; every frame above one built again over what that became; a frame
  ;;; with nothing of the kind under it is itself. ITERATIVE, a stack of
  ;;; cells: a deep recursion's continuation is a chain as long as it is
  ;;; deep. A cell is built once what follows it is (MEMO), so a chain is
  ;;; walked once however many frames share it. 0 when memory ran short.
  (static)
  (func coco_k_resolve ((coco_engine * e) (coco_kmemo * memo) (size_t c0) (size_t * out)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t * stk . nil) (size_t slen . 0) (size_t scap . 0)
              (u64 khdr . #'(coco-cell FUN (coco-fid m "$k" 3)))
              (int ok . 1))
          (set c0 (coco_deref m c0))
          (set ok (coco_kstk_push (aof stk) (aof slen) (aof scap) c0))
          (while (and ok (> slen 0))
            (let ((size_t c . #'(nth (- slen 1) stk))
                  (u64 cv . 0) (size_t nx . 0) (size_t got . 0)
                  (size_t env . 0) (u32 i . 0) (int kind . 0))
              (set cv (nth c (-> m heap)))
              (if (coco_kmemo_get memo (+ (cast u64 c) 1) (aof got))
                  (block (set slen (- slen 1)) continue))
              ;; what follows this cell: KIND 1 a frame, 2 a position, 0
              ;; the empty continuation (or nothing this knows), itself
              (cond
                ((== cv khdr)
                 (set kind 1)
                 (set nx (coco_deref m (+ c 3))))
                ((coco-tag-is POS cv)
                 (let ((size_t pay . #'(cast size_t (coco-payload cv)))
                       (coco_code * ecd . nil) (u32 un . 0))
                   (set kind 2)
                   (set env (- c (>> pay 16)))
                   (set i (cast u32 (bitand pay 65535)))
                   (set ecd (coco-env-code m env))
                   (set un ($ (nth i (-> ecd egoals)) next))
                   (set nx (? (== un 0) (coco_deref m (+ env 2)) (coco-env-pos env ecd un))))))
              (cond
                ((== kind 0)
                 (set ok (coco_kmemo_put memo (+ (cast u64 c) 1) c))
                 (set slen (- slen 1)))
                ((coco_kmemo_get memo (+ (cast u64 nx) 1) (aof got))
                 (let ((size_t res . c))
                   (if (== kind 2)
                       ;; unit I of the environment, in its frame: the term
                       ;; that frame held (`coco_unit_term'), under the
                       ;; barrier it had
                       (let ((coco_code * cd . #'(coco-env-code m env))
                             (coco_egoal * eg . nil) (size_t g . 0) (size_t bv . 0))
                         (set eg (aof (nth i (-> cd egoals))))
                         (set bv (? (== (-> eg bslot) 0) (coco-env-barrier m env)
                                    (+ (cast size_t (coco-signed-payload
                                                     (nth (coco-env-slot-at env cd (- (-> eg bslot) 1))
                                                          (-> m heap))))
                                       1)))
                         (if (not (coco_unit_term m cd env i (aof g))) (set ok 0))
                         (if ok
                             (block (set res (coco_k_frame m (coco-cell REF g) (coco-int-cell (cast i64 bv)) got))
                                    (if (== res 0) (set ok 0)))))
                       ;; a frame: itself when what follows it came out as
                       ;; itself, else a copy over what it came out as
                       (if (!= got nx)
                           (block (set res (coco_k_frame m (nth (+ c 1) (-> m heap))
                                                         (nth (+ c 2) (-> m heap)) got))
                                  (if (== res 0) (set ok 0)))))
                   (if ok (set ok (coco_kmemo_put memo (+ (cast u64 c) 1) res)))
                   (set slen (- slen 1))))
                (#t (set ok (coco_kstk_push (aof stk) (aof slen) (aof scap) nx))))))
          (free stk)
          (if (or (not ok) (-> m oom)) (return 0))
          (return (coco_kmemo_get memo (+ (cast u64 c0) 1) out))))

  (func coco_engine_materialize ((coco_engine * e) (coco_kmat * sv)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_kmemo memo . '{ nil nil 0 0 })
              (size_t n . #'(-> e nchoices))
              (size_t r . 0) (int ok . 1))
          (memset sv 0 (sizeof coco_kmat))
          (if (not (-> m ids_ready)) (coco_ids_fill m))
          ;; a goal handed over goes back on the continuation first, and
          ;; stays there: a frame is a continuation the live machine reads
          ;; as well as it read the goal held
          (if (not (coco_k_flush e)) (return 0))
          (set (-> sv heap_len) (-> m heap_len))
          (set (-> sv goals) (-> e goals))
          (set (-> sv n) n)
          (if (> n 0)
              (block
               (set (-> sv cgoals) (cast (size_t *) (malloc (* n (sizeof size_t)))))
               (set (-> sv ccalls) (cast (size_t *) (malloc (* n (sizeof size_t)))))
               (set (-> sv cmarks) (cast (size_t *) (malloc (* n (sizeof size_t)))))
               (if (or (== (-> sv cgoals) nil) (== (-> sv ccalls) nil) (== (-> sv cmarks) nil))
                   (block (free (-> sv cgoals)) (free (-> sv ccalls)) (free (-> sv cmarks))
                          (memset sv 0 (sizeof coco_kmat))
                          (return 0)))
               (for ((size_t i . 0)) (< i n) ((++ i))
                 (set (nth i (-> sv cgoals)) ($ (nth i (-> e choices)) goals))
                 (set (nth i (-> sv ccalls)) ($ (nth i (-> e choices)) call))
                 (set (nth i (-> sv cmarks)) ($ (nth i (-> e choices)) heap_mark)))))
          (if (coco_k_resolve e (aof memo) (-> e goals) (aof r))
              (set (-> e goals) r)
              (set ok 0))
          (for ((size_t i . 0)) (and ok (< i n)) ((++ i))
            (if (coco_k_resolve e (aof memo) ($ (nth i (-> e choices)) goals) (aof r))
                (set ($ (nth i (-> e choices)) goals) r)
                (set ok 0))
            ;; A CHOICE WHOSE ALTERNATIVE IS A POSITION (Stage 6: a
            ;; construct's else, a disjunction's right arm) gets back the
            ;; term `coco_ite' and the disjunction gave it, over the goals
            ;; just built, as 1.9.2 kept it
            (if (and ok (== ($ (nth i (-> e choices)) kind) COCO_CH_GOAL)
                     (coco-tag-is POS (nth ($ (nth i (-> e choices)) call) (-> m heap))))
                (let ((size_t pc . #'($ (nth i (-> e choices)) call))
                      (size_t pay . 0) (size_t env . 0) (size_t g . 0))
                  (set pay (cast size_t (coco-payload (nth pc (-> m heap)))))
                  (set env (- pc (>> pay 16)))
                  (if (coco_unit_term m (coco-env-code m env) env (cast u32 (bitand pay 65535)) (aof g))
                      (set ($ (nth i (-> e choices)) call) g)
                      (set ok 0)))))
          ;; what was built must outlive every backtrack the image makes
          (if (and ok (> (-> m heap_len) (-> sv heap_len)))
              (for ((size_t i . 0)) (< i n) ((++ i))
                (set ($ (nth i (-> e choices)) heap_mark) (-> m heap_len))))
          (free ($ memo keys)) (free ($ memo vals))
          (if (not ok) (block (coco_engine_materialize_undo e sv) (return 0)))
          (return 1)))

  (func coco_engine_materialize_undo ((coco_engine * e) (coco_kmat * sv))
        (let ((coco_machine * m . #'(-> e m)))
          (set (-> m heap_len) (-> sv heap_len))
          (set (-> e goals) (-> sv goals))
          (for ((size_t i . 0)) (and (< i (-> sv n)) (< i (-> e nchoices))) ((++ i))
            (set ($ (nth i (-> e choices)) goals) (nth i (-> sv cgoals)))
            (set ($ (nth i (-> e choices)) call) (nth i (-> sv ccalls)))
            (set ($ (nth i (-> e choices)) heap_mark) (nth i (-> sv cmarks))))
          (free (-> sv cgoals))
          (free (-> sv ccalls))
          (free (-> sv cmarks))
          (memset sv 0 (sizeof coco_kmat))))

  ;;; WHETHER THE CLAUSE'S FIRST GOAL GOES INTO THE REGISTERS: it has the
  ;;; form for it (`rblen'), nothing is traced, and its functor is stamped
  ;;; a plain predicate of this store as of now (`fgen') -- the only goal
  ;;; the next step can try from them. Anything else is built as the term
  ;;; it always was, at no cost to a body whose first goal is a builtin.
  ;;; A FIRST GOAL THAT IS A BUILTIN OR A CONSTRUCT never will be a plain
  ;;; predicate, and its register form is switched off for good the first
  ;;; time that is known (`bix' answers once the builtin has been called
  ;;; once): a body that starts with `is' or `=<' pays one load, not three.
  (static)
  (func coco_regs_never ((coco_engine * e) (coco_code * cd) (coco_functor * f))
        (if (or (>= (-> f bix) 2) (coco_is_construct (-> e m) (-> f name)))
            (set (-> cd rblen) 0)))

  (static)
  (func coco_regs_ok ((coco_engine * e) (coco_code * cd)) (out int)
        (if (or (== (-> cd rblen) 0) (!= (-> e trace) 0)) (return 0))
        (let ((coco_functor * f . #'(aof (nth (cast size_t (-> cd rfid)) (-> (-> e m) functors)))))
          (if (and (== (-> f fgen) coco_extern_generation)
                   (== (-> f pst) (cast (void *) (-> e st)))
                   (== (-> f pserial) (-> (-> e st) serial)))
              (return 1))
          (coco_regs_never e cd f)
          (return 0)))

  (static)
  (func coco_k_empty ((coco_engine * e)) (out size_t)
        (let ((coco_machine * m . #'(-> e m)))
          (if (not (-> m ids_ready)) (coco_ids_fill m))
          (return (coco_new_atom_id m (coco-id m "[]")))))

  ;;; A BODY'S CONJUNCTION, PUSHED AS ONE CHAIN. `(A, (B, (C, D)))' used to
  ;;; go on the continuation as one goal, and the loop took it apart one `,'
  ;;; per step: a full iteration -- the step count, the collector's check,
  ;;; the dereference and the construct tests -- for every goal in the
  ;;; body, before the goal itself got an iteration of its own. Measured on
  ;;; a clause of 32 trivial body goals, the `,' steps were 18 % of the
  ;;; interpreter's instructions. Here the right spine is walked once and
  ;;; its goals pushed last first, so the continuation comes out exactly
  ;;; as the loop would have built it -- the same `'$k'' cells, the same
  ;;; barrier on each -- and a frozen machine thaws the same either way.
  ;;;
  ;;; THE SPINE IS BOUNDED. A body longer than the buffer leaves its tail
  ;;; on the continuation as one `,' goal, which the loop still takes
  ;;; apart as before; nothing is lost, only the shortcut.
  (static)
  (func coco_k_push_body ((coco_engine * e) (size_t body) (size_t barrier) (size_t rest))
        (out size_t)
        (let ((coco_machine * m . #'(-> e m))
              (size_t items [64])
              (size_t n . 0)
              (size_t g . #'(coco_deref m body)))
          (if (not (-> m ids_ready)) (coco_ids_fill m))
          (while (and (< n 63)
                      (coco-tag-is FUN (nth g (-> m heap)))
                      (== (coco_arity m g) 2)
                      (== (coco_name_of m g) (coco-id m ",")))
            (set (nth n items) (coco_arg m g 0))
            (set n (+ n 1))
            (set g (coco_deref m (coco_arg m g 1))))
          (set (nth n items) g)
          (set n (+ n 1))
          (while (> n 0)
            (set n (- n 1))
            (set rest (coco_k_push e (nth n items) barrier rest)))
          (return rest)))

  ;;; ---- choice points -----------------------------------------------------

  ;;; Answers whether the frame was made, NOT where it went. The index is
  ;;; `nchoices - 1' and the caller reads it there: an earlier version answered
  ;;; with the index and the callers tested it against 0, which is the index of
  ;;; the FIRST choice point -- so every disjunction and every negation
  ;;; attempted with an empty choice stack silently did nothing at all.
  (static)
  (func coco_push_choice ((coco_engine * e) (int kind) (size_t call) (size_t goals) (size_t barrier))
        (out int)
        (if (not (coco_eng_grow e (+ (-> e nchoices) 1))) (return 0))
        (let ((coco_choice * c . #'(aof (nth (-> e nchoices) (-> e choices)))))
          (memset c 0 (sizeof coco_choice))
          (set (-> c kind) kind)
          (set (-> c call) call)
          (set (-> c goals) goals)
          (set (-> c barrier) barrier)
          (set (-> c trail_mark) ($ (cof (-> e m)) trail_len))
          (set (-> c heap_mark) ($ (cof (-> e m)) heap_len))
          ;; the shadow frame: the current call context, and silent -- the
          ;; two places a resume IS a Redo (a clause frame, a written `;')
          ;; say so themselves after pushing
          (let ((coco_tchoice * tc . #'(aof (nth (-> e nchoices) (-> e tchoices)))))
            (set (-> tc goal) (-> e trace_goal))
            (set (-> tc depth) (-> e trace_depth))
            ;; resuming any in-body alternative -- a `;', an `->' else, a
            ;; `\+' else -- is a Redo of the call it sits in, SWI says so;
            ;; at the toplevel the context goal is 0 and nothing prints
            (set (-> tc printr) (? (== kind COCO_CH_GOAL) 1 0))
            (set (-> tc exited) 0))
          (set (-> e nchoices) (+ (-> e nchoices) 1))
          (return 1)))

  ;;; ONE CLAUSE TRIED against CALL -- the IX'th of predicate P -- with
  ;;; GOALS and BARRIER for its body: compiled when it can be
  ;;; (`coco_clause_code', lib/kb.cicili, its program kept in the
  ;;; predicate's own slot after the first ask) -- its head program, then
  ;;; its body program, whose first goal is handed to the next step
  ;;; (`ngoal') and the rest go on the continuation last first
  ;;; (`coco_k_push_roots'); flushed, that is exactly the continuation
  ;;; `coco_k_push_body' pushes for a copied body -- else matched in the
  ;;; store (`coco_store_unify': the
  ;;; store is never bound, a heap cell is made only where an unbound
  ;;; variable of the call takes a piece of the head) and its body copied
  ;;; over the same variable map. A program that could not RUN (-1: no
  ;;; memory for its frame or its goals) is wound back and the clause
  ;;; matched in the store, because skipping it as a head that did not
  ;;; match would be a wrong answer. Answers 1 with the continuation set;
  ;;; 0 with the machine wound back to the marks it had on the way in --
  ;;; which are a choice frame's own marks when the caller has one: every
  ;;; caller arrives with the machine exactly at them (the step's two
  ;;; calls, `coco_select_clause' after a frame was pushed, after
  ;;; `coco_backtrack' wound back to it, or after the clause before failed
  ;;; and was wound back here), so they are read here and not passed.
  ;;;
  ;;; ARGS, when not nil, are the call's arguments in the registers and
  ;;; CALL is not read (the step's register path): a program that could
  ;;; not be had or could not run then answers -1 with the machine wound
  ;;; back, for the caller to build the call and send it the long way,
  ;;; since there is no term here to match in the store.
  ;;;
  ;;; HOW MANY GUARDS A CLAUSE ENTERED NOW MAY RUN (Stage 4): none under
  ;;; trace, whose ports are printed from goals, and under an inference
  ;;; limit only as many as the limit has steps left -- the guard after
  ;;; them is left to the step, which stops at the limit exactly where it
  ;;; always stopped. The step that entered the clause is counted already,
  ;;; and guard I would have been step STEPS + 1 + I. Asked only of a
  ;;; code with guards (`ex' 1 or 3), so not whether there are any: asked
  ;;; that again behind the question `ex' answers, it cost the counting
  ;;; loop 3 instructions a turn.
  ;;;
  ;;; UNDER A WINDOW'S CLOCK (1.13.3) the limit is RMAX: the clock moves
  ;;; MAX_STEPS to every step, and read as the limit it would let no guard
  ;;; run, so the clock would time an engine without them. Asked inline: as
  ;;; a call out of line, it cost `coco_try_clause' the registers a call
  ;;; clobbers, and naive reverse, which has no guard, 2 instructions an
  ;;; inference (`tools/flow/zero.sh').
  (static)
  (func coco_guard_budget ((coco_engine * e) (coco_code * cd)) (out u32)
        (if (!= (-> e trace) 0) (return 0))
        (if (== (-> e max_steps) 0) (return (-> cd ngd)))
        (let ((u64 lim . #'(? (-> e tclock) (-> e rmax) (-> e max_steps))))
          (if (== lim 0) (return (-> cd ngd)))
          (if (>= (-> e steps) lim) (return 0))
          (let ((u64 left . #'(- lim (-> e steps))))
            (return (? (< left (cast u64 (-> cd ngd))) (cast u32 left) (-> cd ngd))))))

  ;;; THE CLAUSE MATCHED IN THE STORE AND ITS BODY COPIED, for a program
  ;;; that could not be had or could not run (`coco_store_unify': the store
  ;;; is never bound, a heap cell is made only where an unbound variable of
  ;;; the call takes a piece of the head, and the body copied over the same
  ;;; variable map). 1 entered, the body over GOALS; 0 the head did not
  ;;; match, the machine wound back to TMARK and HMARK.
  (func coco_try_store ((coco_engine * e) (size_t cl) (size_t call) (size_t goals)
                        (size_t barrier) (size_t tmark) (size_t hmark)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (coco_varmap vm . '{ nil nil 0 0 0 })
              (size_t shead . 0) (size_t sbody . 0) (int matched . 0))
          (coco_store_clause_parts st m cl (coco-id m ":-") (aof shead) (aof sbody))
          (coco_varmap_take m (aof vm))
          (set matched (coco_store_unify m st call shead (aof vm)))
          (if matched
              (block
               (set (-> e goals)
                    (? (== sbody 0) goals
                       (coco_k_push_body e (coco_store_get_vm m st sbody (aof vm)) barrier goals)))
               (coco_varmap_give m (aof vm))
               (return 1)))
          (coco_varmap_give m (aof vm))
          (coco_undo_to m tmark)
          (set ($ (cof m) heap_len) hmark)
          (return 0)))

  ;;; A CLAUSE THAT MAKES AN ENVIRONMENT, ENTERED (Stage 5): its head, its
  ;;; first goal handed to the next step as `coco_try_clause' hands one,
  ;;; and the environment for the goals after it, whose body returns to
  ;;; GOALS; the continuation becomes the environment's first position. A
  ;;; function of its own, so that a clause without an environment pays one
  ;;; test for there being one: asked in `coco_try_clause', the request cost
  ;;; naive reverse 16 instructions a call. NOT STATIC, and neither is
  ;;; `coco_try_store', so that the compiler has no reason to fold either
  ;;; into `coco_try_clause' for having one caller: folded in, they cost
  ;;; every clause entry 7 instructions more. Answers as `coco_try_clause'
  ;;; answers.
  ;;;
  ;;; A BODY THAT STARTS WITH GUARDS (`ex' 3, Stage 6) runs them as
  ;;; `coco_try_clause' runs a guarded body's -- the ones that ran are
  ;;; inferences, the one that failed too -- and makes the environment only
  ;;; when every one of them ran. Guards that stopped short leave the body
  ;;; built from the one they stopped at (ER's next still 0), handed over
  ;;; and pushed as `coco_try_clause' hands over and pushes a body.
  (func coco_try_env ((coco_engine * e) (coco_code * cd) (size_t cl) (size_t call)
                      (const size_t * args) (size_t goals) (size_t barrier)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t tmark . #'($ (cof m) trail_len))
              (size_t hmark . #'($ (cof m) heap_len))
              (size_t roots [64]) (size_t ng . 0)
              (int nxt . #'(- 1 (-> e acur)))
              (size_t * regs . nil)
              (coco_envreq er) (int matched . -1))
          (if (and (-> cd ehand) (coco_regs_ok e cd))
              (set regs (aof (nth (* (cast size_t nxt) 8) (-> e areg)))))
          (set ($ er parent) goals)
          (set ($ er barrier) barrier)
          (set ($ er next) 0)
          (if (== (-> cd ex) 3)
              (let ((u32 gdone . 0))
                (set matched (coco_clause_run_ge m st cd call args roots (aof ng) regs (aof er)
                                                 (coco_guard_budget e cd) (aof gdone)))
                (if (!= matched -1) (set (-> e steps) (+ (-> e steps) (cast u64 gdone)))))
              (set matched (coco_clause_run_e m st cd call args roots (aof ng) regs (aof er))))
          (if (and (== matched 1) (== ($ er next) 0))
              ;; the guards stopped short: no environment, and the body from
              ;; the guard they stopped at, which is never in the registers.
              ;; Its later goals a frame each, pushed one at a time from the
              ;; last: `coco_k_push_roots' called here as well stopped being
              ;; inline in `coco_try_clause', where every body's are pushed
              (let ((size_t k . goals) (size_t i . ng))
                (if (> ng 0)
                    (block (set (-> e ngoal) (coco_deref m (nth 0 roots)))
                           (set (-> e nbar) barrier)
                           (set (-> e nset) 1)))
                (while (and (> i 1) (!= k 0))
                  (set i (- i 1))
                  (set k (coco_k_push e (nth i roots) barrier k)))
                (set (-> e goals) k)
                (return 1)))
          (if (== matched 1)
              (block
               ;; the first goal handed over, unless it is a unit itself
               ;; (Stage 6), which the continuation starts at
               (cond
                 ((!= regs nil)
                  (set (-> e afid) (-> cd rfid))
                  (set (-> e aarity) (-> cd rarity))
                  (set (-> e acur) nxt)
                  (set (-> e nbar) barrier)
                  (set (-> e nset) 2))
                 ((> ng 0)
                  (set (-> e ngoal) (coco_deref m (nth 0 roots)))
                  (set (-> e nbar) barrier)
                  (set (-> e nset) 1)))
               (set (-> e goals) ($ er next))
               (return 1)))
          (coco_undo_to m tmark)
          (set ($ (cof m) heap_len) hmark)
          (if (== matched 0) (return 0))
          ;; a program that could not run: the long way, or for a call in
          ;; the registers back to the caller, to build it first
          (if (!= args nil) (return -1))
          (return (coco_try_store e cl call goals barrier tmark hmark))))

  (static)
  (func coco_try_clause ((coco_engine * e) (coco_pred * p) (size_t ix) (size_t call)
                         (const size_t * args) (size_t goals) (size_t barrier)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t tmark . #'($ (cof m) trail_len))
              (size_t hmark . #'($ (cof m) heap_len))
              (size_t cl . #'(nth ix (-> p clauses)))
              (coco_code * cd . #'(cast (coco_code *) (nth ix (-> p codes))))
              (int matched . -1))
          ;; the program from the predicate's own slot, or from the store's
          ;; table (which compiles it the first time) and into the slot
          (if (== cd nil)
              (block (set cd (coco_clause_code st m cl))
                     (set (nth ix (-> p codes)) (cast (void *) cd))))
          (if (!= cd nil)
              (let ((size_t roots [64]) (size_t ng . 0)
                    (int nxt . #'(- 1 (-> e acur)))
                    (size_t * regs . nil))
                ;; the first goal into the registers, when the next step can
                ;; try it from there (`coco_regs_ok'): the bank the call is
                ;; not in
                (if (coco_regs_ok e cd)
                    (set regs (aof (nth (* (cast size_t nxt) 8) (-> e areg)))))
                (cond
                  ;; NOT THE PLAIN EXECUTOR (`ex'): guards (1), an
                  ;; environment (2) or both (3) -- one test for all three,
                  ;; the one the guards had, so a plain clause pays nothing
                  ;; for the others.
                  ;; A BODY THAT MAKES AN ENVIRONMENT (Stage 5) is entered
                  ;; by `coco_try_env' unless something is traced: the
                  ;; tracer prints its ports from goals, so under it every
                  ;; body is built as it always was. THE GUARDS THAT RAN
                  ;; ARE INFERENCES (Stage 4), the one that failed too:
                  ;; `statistics(inferences)' and the inference limit count
                  ;; what they counted when each was a step. A program that
                  ;; could not run is wound back below and stepped through
                  ;; from its head, so it counts nothing here. Guards that
                  ;; stopped before the last leave the one they stopped at
                  ;; as the next goal, built: the registers were not
                  ;; written.
                  ((!= (-> cd ex) 0)
                   (cond
                     ((== (-> cd ex) 1)
                      (let ((u32 gdone . 0))
                        (set matched (coco_clause_run_g m st cd call args roots (aof ng) regs
                                                        (coco_guard_budget e cd) (aof gdone)))
                        (if (!= matched -1) (set (-> e steps) (+ (-> e steps) (cast u64 gdone))))
                        (if (< gdone (-> cd ngd)) (set regs nil))))
                     ((== (-> e trace) 0)
                      (return (coco_try_env e cd cl call args goals barrier)))
                     ;; traced, a body with guards and an environment is
                     ;; built from its first guard, as every guarded body
                     ;; is under trace: none of them runs here
                     ((== (-> cd ex) 3)
                      (let ((u32 gdone . 0))
                        (set matched (coco_clause_run_g m st cd call args roots (aof ng) nil
                                                        0 (aof gdone)))
                        (set regs nil)))
                     ((and (== regs nil) (== args nil))
                      (set matched (coco_clause_run m st cd call roots (aof ng))))
                     (#t
                      (set matched (coco_clause_run_r m st cd call args roots (aof ng) regs)))))
                  ((and (== regs nil) (== args nil))
                   (set matched (coco_clause_run m st cd call roots (aof ng))))
                  (#t
                   (set matched (coco_clause_run_r m st cd call args roots (aof ng) regs))))
                (if (== matched 1)
                    (block
                     ;; THE FIRST GOAL GOES TO THE NEXT STEP IN THE ENGINE
                     ;; (`ngoal', or the registers), and only the rest go on
                     ;; the continuation. Every caller of this function is a
                     ;; step about to end -- the loop's own call, or
                     ;; `coco_select_clause' from the loop or from
                     ;; `coco_backtrack' -- so the next thing to run is the
                     ;; loop's top, which flushes or takes it. The goals
                     ;; that go on the continuation start at FROM: the
                     ;; first root when the first goal is in the registers
                     ;; (its term was never built, so it is not a root), the
                     ;; second when it is handed over. ONE call of
                     ;; `coco_k_push_roots', which the compiler then
                     ;; inlines; with a call in each arm it did not, and a
                     ;; body that starts with a builtin paid 3 instructions
                     ;; an inference for it.
                     (let ((size_t from . 0))
                       (cond
                         ((!= regs nil)
                          (set (-> e afid) (-> cd rfid))
                          (set (-> e aarity) (-> cd rarity))
                          (set (-> e acur) nxt)
                          (set (-> e nbar) barrier)
                          (set (-> e nset) 2))
                         ((> ng 0)
                          (set (-> e ngoal) (coco_deref m (nth 0 roots)))
                          (set (-> e nbar) barrier)
                          (set (-> e nset) 1)
                          (set from 1)))
                       (set (-> e goals) (? (== ng from) goals
                                            (coco_k_push_roots e (aof (nth from roots)) (- ng from)
                                                               barrier goals))))
                     (return 1)))
                (if (== matched -1)
                    (block (coco_undo_to m tmark)
                           (set ($ (cof m) heap_len) hmark)))))
          (if (and (== matched -1) (!= args nil)) (return -1))
          (if (== matched -1)
              (return (coco_try_store e cl call goals barrier tmark hmark)))
          ;; that head did not match: put the machine back
          (coco_undo_to m tmark)
          (set ($ (cof m) heap_len) hmark)
          (return 0)))

  ;;; ---- clause selection --------------------------------------------------

  ;;; Tries the clauses of the choice point at CI, from `clause_ix' on. On a
  ;;; head that unifies it sets the continuation and answers 1; when the
  ;;; clauses run out it pops the choice point and answers 0.
  ;;;
  ;;; THE LAST MATCHING CLAUSE POPS ITS OWN CHOICE POINT. A predicate whose
  ;;; final clause matched has nothing left to backtrack into, and leaving the
  ;;; frame behind would make every recursive call cost one -- which is the
  ;;; difference between a loop that runs in constant space and one that does
  ;;; not.
  ;;; FIRST-ARGUMENT INDEXING ENTERS HERE, and it is two calls. The key is
  ;;; the call's own first argument (`coco_arg_key'), and `coco_pred_next_clause'
  ;;; answers which clause to try -- skipping, without copying or unifying
  ;;; them, every clause whose head cannot match. What that removes is the
  ;;; expensive half of a failed attempt: a clause arrives as a FRESH COPY on
  ;;; the heap and is thrown away again when the head does not unify, so a
  ;;; probe into a table of facts used to copy the whole table.
  ;;;
  ;;; `clause_ix' GOES ON MEANING WHAT IT MEANT -- the next ORDINAL to try,
  ;;; not a position in an index -- because a frozen machine's choice frames
  ;;; carry it (lib/state.cicili) and a machine thawed by another process
  ;;; must resume where it stopped.
  ;;; THE NEXT CLAUSE A FRAME MAY TRY in a predicate with dead clauses: a
  ;;; candidate from FROM on, short of the frame's end (CEND), and dead only
  ;;; if it died while the frame was open (FERA the first death it lived
  ;;; through, 0 for none, so a death of FERA or after). The dead of before
  ;;; are not its.
  (static)
  (func coco_frame_next ((coco_store * st) (coco_machine * m) (coco_pred * p) (u32 kpos)
                         (u64 key) (size_t from) (u32 cend) (u32 fera)) (out size_t)
        (let ((size_t ix . #'(? (== kpos 0) (coco_pred_next_clause st p key from)
                                 (coco_pred_next_at st m p kpos key from))))
          (while (and (< ix (cast size_t cend)) (!= (nth ix (-> p tomb)) 0)
                      (or (== fera 0) (< (nth ix (-> p tomb)) fera)))
            (set ix (? (== kpos 0) (coco_pred_next_clause st p key (+ ix 1))
                       (coco_pred_next_at st m p kpos key (+ ix 1)))))
          (return ix)))

  ;;; THE SELECTION OF A PREDICATE WITH DEAD CLAUSES (the logical update
  ;;; view, lib/kb.cicili), out of line: `coco_select_clause' with each
  ;;; candidate asked of `coco_frame_next'. No sweep can take the dead while
  ;;; this frame is open on the predicate, so they are still there at every
  ;;; turn of the loop. WEAK, so never inlined: inlined into the selection
  ;;; it cost every retry its registers (queens +1.3 % of its work).
  (weak)
  (func coco_select_dead ((coco_engine * e) (size_t ci)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st)))
          (while 1
            (let ((coco_choice * c . #'(aof (nth ci (-> e choices))))
                  (coco_pred * p . #'(aof (nth (-> c pred) (-> st preds))))
                  (u32 kpos . #'(-> c ixpos))
                  (u64 key . 0) (size_t ix . 0) (int last . 0)
                  (size_t call . #'(-> c call)) (size_t goals . #'(-> c goals)))
              (set key (? (== kpos 0) (coco_arg_key m call) (coco_call_arg_key m call kpos)))
              (set ix (coco_frame_next st m p kpos key (-> c clause_ix) (-> c cend) (-> c fera)))
              (if (>= ix (cast size_t (-> c cend)))
                  (block (set (-> e nchoices) ci) (return 0)))
              (set (-> c clause_ix) (+ ix 1))
              (set last (>= (coco_frame_next st m p kpos key (-> c clause_ix) (-> c cend) (-> c fera))
                            (cast size_t (-> c cend))))
              (if (coco_try_clause e p ix call nil goals ci)
                  (block
                   (if (and last (== (-> e trace) 0)) (set (-> e nchoices) ci))
                   (return 1)))))
          (return 0)))

  (static)
  (func coco_select_clause ((coco_engine * e) (size_t ci)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st)))
          (while 1
            (let ((coco_choice * c . #'(aof (nth ci (-> e choices))))
                  (coco_pred * p . #'(aof (nth (-> c pred) (-> st preds)))))
              ;; THE LOGICAL UPDATE VIEW: a predicate with dead clauses
              ;; selects out of line, and every other bounds what it tries by
              ;; the clause count its call began with (`cend'), past which
              ;; `coco_no_clause' lies too -- one compare where the end was
              ;; asked before
              (if (!= (-> p ntomb) 0) (return (coco_select_dead e ci)))
              ;; THE ARGUMENT THE CALL IS INDEXED ON is the frame's, chosen
              ;; when the call was made (`coco_pred_select', the engine's
              ;; probe) and read here at every retry; its key is read again
              ;; from the call's own argument. 0, the first argument, for a
              ;; frame under the floor, made under trace, or thawed: the
              ;; choice is not frozen, so the frozen format is 1.9.0's. Any
              ;; argument is sound -- a clause it would skip fails its head.
              (let ((u32 kpos . #'(-> c ixpos))
                    (u64 key . 0)
                    (size_t ix . 0))
                (set key (? (== kpos 0) (coco_arg_key m (-> c call))
                            (coco_call_arg_key m (-> c call) kpos)))
                (set ix (? (== kpos 0) (coco_pred_next_clause st p key (-> c clause_ix))
                           (coco_pred_next_at st m p kpos key (-> c clause_ix))))
                (if (>= ix (cast size_t (-> c cend)))
                    (block (set (-> e nchoices) ci) (return 0)))
              (let ((size_t call . #'(-> c call))
                    (size_t goals . #'(-> c goals))
                    (int last . 0))
                (set (-> c clause_ix) (+ ix 1))
                ;; AND THE DETERMINISM COMES FROM THE SECOND ASK. A predicate
                ;; with no further candidate leaves no choice point behind --
                ;; which is what makes an indexed lookup deterministic where
                ;; the walk used to keep a frame alive to the end of the
                ;; table.
                (set last (? (>= (? (== kpos 0) (coco_pred_next_clause st p key (-> c clause_ix))
                                    (coco_pred_next_at st m p kpos key (-> c clause_ix)))
                                 (cast size_t (-> c cend)))
                             1 0))
                ;; one clause, compiled or matched in the store -- see
                ;; `coco_try_clause'. A `!' in the body cuts back to before
                ;; this call. Under trace the frame STAYS even on the last
                ;; clause: failing back past it is what prints the Fail port,
                ;; and a popped frame fails in silence
                (if (coco_try_clause e p ix call nil goals ci)
                    (block
                     (if (and last (== (-> e trace) 0)) (set (-> e nchoices) ci))
                     (return 1)))
                ;; that head did not match: the machine is back at the marks;
                ;; try the next
                ))))
          (return 0)))

  ;;; ---- the traced selection, out of line (1.10.12) ----------------------
  ;;;
  ;;; What a traced call or retry does around `coco_select_clause', each a
  ;;; (weak) function, which Cicili emits as one the compiler never inlines:
  ;;; the step loop and `coco_backtrack' call them from branches only
  ;;; tracing takes and stay, for an untraced run, the code they were --
  ;;; written inline, the first window cost nrev two instructions an
  ;;; inference that no untraced run executes, in registers and layout
  ;;; (tools/flow/zero.sh).

  ;;; THE KEY THE SELECTION READS, kept in a window before the selection
  ;;; binds the call: the call's argument the frame is keyed on
  ;;; (`coco_select_clause'), which the head entered may bind by the time
  ;;; the heads are recorded -- `p(K, 2)' entering `p(b, 2)' has K bound to
  ;;; b, and walked again with b's key the heads before it that were tried
  ;;; with none would not be. Asked of a fresh traced call before its
  ;;; selection, and of a retry by `coco_trace_paint'.
  (weak)
  (func coco_rec_hkey ((coco_engine * e) (size_t ci))
        (if (!= (-> e trace) 2) (return))
        (let ((coco_rec * r . #'(cast (coco_rec *) ($ (cof (-> e m)) rec)))
              (coco_choice * c . #'(aof (nth ci (-> e choices)))))
          (if (!= r nil)
              (set (-> r hkey) (coco_call_arg_key (-> e m) (-> c call) (-> c ixpos))))))

  ;;; THE HEADS, AFTER THE SELECTION: in a window, the clauses from START
  ;;; that the selection tried up to the one the frame at CI entered -- or
  ;;; to the predicate's last, when none was (ENTERED 0) -- did not match
  ;;; the call, and the entered one did. They are the index's candidates,
  ;;; walked again with the key the selection read (`coco_rec_hkey') from
  ;;; the frame, which keeps both the next clause to try and, under trace,
  ;;; its place on the last clause too. A clause the index passed over was
  ;;; never tried and is not recorded (1.11.2): through 1.11.1 every clause
  ;;; before the entered one was a head that did not match, and a failed
  ;;; call of a table of 32,046 facts recorded 32,046 heads whose first
  ;;; argument was never asked -- 215,525 of them in one window of the
  ;;; translator's, most of its 31 MB of XML (reported from the reasoning
  ;;; session).
  (weak)
  (func coco_rec_heads ((coco_engine * e) (size_t ci) (size_t start) (int entered))
        (if (!= (-> e trace) 2) (return))
        (let ((coco_machine * m . #'(-> e m))
              (coco_rec * r . #'(cast (coco_rec *) ($ (cof m) rec)))
              (coco_store * st . #'(-> e st))
              (coco_choice * c . #'(aof (nth ci (-> e choices))))
              (coco_pred * p . #'(aof (nth (-> c pred) ($ (cof st) preds))))
              (int depth . #'($ (nth ci (-> e tchoices)) depth))
              (size_t upto . 0)
              (size_t ix . 0))
          (if (or (== r nil) (!= (-> r state) 1)) (return))
          ;; the heads the call could see: short of its end, and none that
          ;; died before it was made (the logical update view)
          (set upto (? entered (- (-> c clause_ix) 1) (cast size_t (-> c cend))))
          (set ix (coco_pred_next_at st m p (-> c ixpos) (-> r hkey) start))
          (while (and (!= ix (coco_no_clause)) (< ix upto))
            (if (not (and (!= (-> p ntomb) 0) (!= (nth ix (-> p tomb)) 0)
                          (or (== (-> c fera) 0) (< (nth ix (-> p tomb)) (-> c fera)))))
                (coco_rec_mark e COCO_REV_NOHEAD depth (-> c call) (+ ix 1)))
            (set ix (coco_pred_next_at st m p (-> c ixpos) (-> r hkey) (+ ix 1))))
          (if entered (coco_rec_mark e COCO_REV_CLAUSE depth (-> c call) (+ upto 1)))))

  ;;; A RETRY'S CALL, painted before the selection binds it: its text for
  ;;; the Redo line the printer writes once a clause is entered (the caller
  ;;; frees it), or, in a window, the Redo recorded now and the clause the
  ;;; selection starts from kept for the heads after it (nil).
  (weak)
  (func coco_trace_paint ((coco_engine * e) (size_t ci) (int depth) (size_t g)) (out char *)
        (if (== (-> e trace) 3) (return nil))
        (if (== (-> e trace) 2)
            (let ((coco_rec * r . #'(cast (coco_rec *) ($ (cof (-> e m)) rec))))
              (if (!= r nil)
                  (block
                   ;; recorded now, as the goal stands before selection
                   ;; binds it, and pending until the retry enters a clause
                   (coco_rec_unpend r)
                   (let ((size_t n0 . #'(-> r nevs)))
                     (set (-> r pntxs) (-> r ntxs))
                     (set (-> r palen) (-> r alen))
                     (coco_rec_port e COCO_REV_REDO depth g 0)
                     (if (> (-> r nevs) n0) (set (-> r pend) (-> r nevs))))
                   (set (-> r hstart) ($ (nth ci (-> e choices)) clause_ix))
                   (coco_rec_hkey e ci)))
              (return nil)))
        (let ((coco_strbuf tb))
          (coco_sb_init (aof tb))
          (coco_write_term (-> e m) (aof tb) g 1 0)
          (return ($ tb s))))

  ;;; the retry entered a clause: its Redo, printed -- or the Redo recorded
  ;;; when the retry began kept, and the heads recorded after it
  (weak)
  (func coco_trace_redo ((coco_engine * e) (size_t ci) (int depth) (const char * text))
        (if (== (-> e trace) 2)
            (let ((coco_rec * r . #'(cast (coco_rec *) ($ (cof (-> e m)) rec))))
              (if (!= r nil)
                  (block (set (-> r pend) 0)
                         (coco_rec_heads e ci (-> r hstart) 1)))
              (return)))
        (if (== (-> e trace) 3) (return))
        (coco_trace_line "Redo" depth text))

  ;;; the retry found no clause: its Fail, printed -- or the heads and the
  ;;; Fail recorded, the goal as backtracking left it
  (weak)
  (func coco_trace_fail ((coco_engine * e) (size_t ci) (int depth) (const char * text))
        (if (== (-> e trace) 2)
            (let ((coco_rec * r . #'(cast (coco_rec *) ($ (cof (-> e m)) rec))))
              (if (!= r nil) (coco_rec_heads e ci (-> r hstart) 0))
              (coco_rec_port e COCO_REV_FAIL depth ($ (nth ci (-> e tchoices)) goal) 0)
              (return)))
        (if (== (-> e trace) 3) (return))
        (coco_trace_line "Fail" depth text))

  ;;; a traced call matched no clause at all: the heads, then its Fail
  (weak)
  (func coco_trace_nomatch ((coco_engine * e) (size_t ci) (int depth) (size_t g))
        (coco_rec_heads e ci 0 0)
        (coco_trace_port e "Fail" depth g))

  ;;; A CUT UNDER TRACE KEEPS ITS OWN CALL'S FRAME (1.10.24). The cut has
  ;;; taken the stack to B; the frame at B is the call whose body the cut
  ;;; is in when it is that call's traced frame -- its goal and its depth
  ;;; the tracer's context, which a deeper call or a `;' never is -- and it
  ;;; is put back, SPENT: nothing left to try, every frame above it gone as
  ;;; the cut said. Backtracking into it is the call's Fail
  ;;; (`coco_trace_spent'), where through 1.10.22 there was no frame to
  ;;; fail from and the call ended in silence -- `fate="open"' in a window.
  ;;; A cut local to `call/1', a condition or `\+' is not the call's: the
  ;;; frame at its height is a deeper call's, or a construct's. Quiet trace
  ;;; (3, `--backtrace') keeps nothing: it prints no port, and a frame kept
  ;;; for each call that cut would be a deep recursion's memory for nothing.
  (weak)
  (func coco_trace_cut ((coco_engine * e) (size_t b))
        (if (== (-> e trace) 3) (return))
        (let ((coco_choice * c . #'(aof (nth b (-> e choices))))
              (coco_tchoice * tc . #'(aof (nth b (-> e tchoices)))))
          (if (and (or (== (-> c kind) COCO_CH_CLAUSE) (== (-> c kind) COCO_CH_SPENT))
                   (!= (-> tc printr) 0)
                   (== (-> tc depth) (-> e trace_depth))
                   (== (-> tc goal) (-> e trace_goal)))
              (block (set (-> c kind) COCO_CH_SPENT)
                     (set (-> e nchoices) (+ b 1))))))

  ;;; A SPENT FRAME BACKTRACKED INTO: the call whose cut kept it has nothing
  ;;; left to try, so this is its Fail -- printed, or recorded in a window,
  ;;; the goal as backtracking left it -- unless it had exited, when it goes
  ;;; in silence as a clause frame out of heads does. No heads are recorded:
  ;;; after the cut no other clause was tried.
  (weak)
  (func coco_trace_spent ((coco_engine * e) (size_t ci))
        (if (== (-> e trace) 0) (return))
        (let ((coco_tchoice * tc . #'(aof (nth ci (-> e tchoices)))))
          (if (and (!= (-> tc printr) 0) (== (-> tc exited) 0))
              (coco_trace_port e "Fail" (-> tc depth) (-> tc goal)))))

  ;;; A CLOCKED FRAME BACKTRACKED INTO (1.13.7): a retry begins, read from
  ;;; the clock here, its predicate kept for the next reading's record
  ;;; (`coco_clock_rclose'), and the frame is a CLAUSE frame again --
  ;;; marked once more at the next reading if it still has clauses to try.
  ;;; (weak), out of `coco_backtrack', as the recorder's functions are
  (weak)
  (func coco_clock_retry ((coco_engine * e) (size_t ci))
        (let ((coco_rec * r . #'(cast (coco_rec *) ($ (cof (-> e m)) rec)))
              (coco_choice * c . #'(aof (nth ci (-> e choices))))
              (u64 now . 0))
          (set (-> c kind) COCO_CH_CLAUSE)
          (if (< ci (-> e tlow)) (set (-> e tlow) ci))
          (if (or (== r nil) (not (-> r ton))) (return))
          (set now (coco_clock_ns))
          ;; one that found no clause ends where this one begins
          (if (coco_clock_rclose r now) (set now (coco_clock_ns)))
          (set (-> r rpend) now)
          (set (-> r rpi) (-> r tcur))
          (set (-> r rpk) (-> r tkcur))
          (set (-> r rpp) (-> c pred))
          (set (-> r rpname) ($ (nth (-> c pred) ($ (cof (-> e st)) preds)) name))
          (set (-> r rparity) ($ (nth (-> c pred) ($ (cof (-> e st)) preds)) arity))))

  ;;; `'$catch_exit'(CI)': the goal of the catch frame at CI has EXITED. From
  ;;; here on a throw is somebody else's, so the frame stops being a catch --
  ;;; and starts again the moment anything fails back into the goal, which is
  ;;; what the retry frame is for. Silent under --trace: the program never
  ;;; wrote it. Answers 0 with no memory for the retry frame, else 1.
  ;;;
  ;;; THE RETRY FRAME IS ONLY PUSHED WHEN THERE IS SOMETHING TO FAIL BACK
  ;;; INTO. A goal that left no alternative can never be re-entered, so the
  ;;; frame would be a choice point that exists to do nothing -- and the scan
  ;;; stops at the first real alternative, so the case that pays for it is the
  ;;; one that needed it.
  ;;;
  ;;; AND THEN THE CATCH FRAME GOES, with the dead ones above it (1.13.4,
  ;;; SWI's I_EXITCATCH): left DEAD, a catch/3 whose goal exited once was a
  ;;; choice point for good, and a recursion that caught around a
  ;;; deterministic call kept one per turn -- a million calls, a million
  ;;; frames and 201 MB of heap in 0.80 s, where with the frame gone they
  ;;; are none, 10 MB and 0.21 s. Every
  ;;; barrier the rest of the run carries was taken before the catch was
  ;;; called, so this is the cut to its height. Under trace every call keeps
  ;;; a frame, so the scan finds one and nothing changes there.
  ;;;
  ;;; (weak), out of the step loop the constructs are inlined into: written
  ;;; there, the store that pops the frame moved the loop's registers, and
  ;;; every `$cut' reloaded the address of `nchoices' from the stack (lookup,
  ;;; one instruction a probe).
  (weak)
  (func coco_catch_exit ((coco_engine * e) (size_t g) (size_t k) (size_t b)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t ci . #'(cast size_t (coco-signed-payload
                                            (nth (coco_deref m (coco_arg m g 0)) (-> m heap))))))
          (if (and (< ci (-> e nchoices))
                   (== ($ (nth ci (-> e choices)) kind) COCO_CH_CATCH))
              (block
               (set ($ (nth ci (-> e choices)) kind) COCO_CH_DEAD)
               (let ((int live . 0) (i64 fi . #'(- (cast i64 (-> e nchoices)) 1)))
                 (while (> fi (cast i64 ci))
                   (let ((int fk . #'($ (nth (cast size_t fi) (-> e choices)) kind)))
                     (if (and (!= fk COCO_CH_DEAD) (!= fk COCO_CH_CATCH)
                              (!= fk COCO_CH_CATCH_RETRY) (!= fk COCO_CH_SPENT))
                         (block (set live 1) break)))
                   (set fi (- fi 1)))
                 (if live
                     (block
                      (if (not (coco_push_choice e COCO_CH_CATCH_RETRY 0 k b)) (return 0))
                      (set ($ (nth (- (-> e nchoices) 1) (-> e choices)) clause_ix) ci))
                     (set (-> e nchoices) ci)))))
          (return 1)))

  ;;; THE CALL IN THE REGISTERS HAS MORE THAN ONE CANDIDATE: its frame made
  ;;; here, as the dispatch makes one, over the term built first -- so the
  ;;; term sits under the frame's heap mark -- rather than built and sent
  ;;; down to be dispatched and probed again. Answers what
  ;;; `coco_select_clause' answers, or -1 with no memory for the frame. A
  ;;; function of its own, so the step's fast path stays small.
  (static)
  (func coco_regs_choice ((coco_engine * e) (size_t pi) (size_t ix0)) (out int)
        (let ((size_t g . #'(coco_areg_term e))
              (size_t k . #'(-> e goals))
              (size_t b . #'(-> e nbar)))
          (set (-> e nset) 0)
          (if (not (coco_push_choice e COCO_CH_CLAUSE g k b)) (return -1))
          (let ((size_t ci . #'(- (-> e nchoices) 1)))
            (set ($ (nth ci (-> e choices)) pred) pi)
            (set ($ (nth ci (-> e choices)) clause_ix) ix0)
            (set ($ (nth ci (-> e choices)) ixpos) 0)
            ;; what the call may try: the clauses there are now (the logical
            ;; update view)
            (let ((coco_pred * p . #'(aof (nth pi ($ (cof (-> e st)) preds)))))
              (set ($ (nth ci (-> e choices)) cend) (cast u32 (-> p nclauses)))
              (set (-> p framed) 1))
            (return (? (coco_select_clause e ci) 1 0)))))

  ;;; THE BUILTINS IN PLACE (Stage 7): unit U of the environment at ENV
  ;;; (whose code is CD), NK the continuation after it and BAR its barrier
  ;;; -- a guard's program over the slots (a GUARDX's one fused word), its
  ;;; term built and handed over only when the program cannot decide; two
  ;;; sides read out of the slots
  ;;; and unified or compared; and any other builtin called by its row on
  ;;; the term built at entry, each the step its goal was. Answers as
  ;;; `coco_env_take' does. OUT OF LINE AND NOT STATIC, so that the step
  ;;; loop the take is part of keeps the registers it had, and the guard's
  ;;; and the sides' runners are inline here instead.
  (func coco_env_place ((coco_engine * e) (coco_code * cd) (size_t env) (u32 u)
                        (size_t nk) (size_t bar)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_egoal * eg . #'(aof (nth u (-> cd egoals)))))
          (set (-> e goals) nk)
          (switch (cast int (-> eg kind))
            (case (cc-eg "GUARD")
              (let ((int gf . 0) (u32 gd . #'(coco_env_guard m cd env u (aof gf))))
                (if (== gd 1) (return 0))
                (if gf (return -2))
                (let ((size_t g . 0))
                  (if (not (coco_env_term m cd env u (aof g))) (return -1))
                  (set (-> e ngoal) g)
                  (set (-> e nbar) bar)
                  (set (-> e nset) 1)
                  (return 1))))
            ;; the same, its program one fused word
            (case (cc-eg "GUARDX")
              (let ((int gf . 0) (u32 gd . #'(coco_env_guardx m cd env u (aof gf))))
                (if (== gd 1) (return 0))
                (if gf (return -2))
                (let ((size_t g . 0))
                  (if (not (coco_env_term m cd env u (aof g))) (return -1))
                  (set (-> e ngoal) g)
                  (set (-> e nbar) bar)
                  (set (-> e nset) 1)
                  (return 1))))
            (case (cc-eg "SIDES")
              (let ((int r . #'(coco_env_sides m cd env u)))
                ;; `=' is no inference, as `coco_bi_unify' counts it (1.12.2)
                (if (== (-> eg form) 0) (set (-> e frees) (+ (-> e frees) 1)))
                (if (== r 1) (return 0))
                (if (== r 0) (return -2))
                (return -1)))
            (case (cc-eg "BUILTIN")
              (let ((int rc . #'(coco_builtin_call e (cast int (-> eg form))
                                                   (coco_deref m (+ env (cast size_t (-> eg soff)))))))
                ;; 2: a catcher took a ball the builtin raised, and the
                ;; continuation is its recovery already
                (cond ((== rc 1) (set (-> e goals) nk) (return 0))
                      ((== rc 2) (return 0))
                      ((== rc 0) (return -2))
                      (#t (return -3)))))
            (default (return -2)))
          (return -2)))

  ;;; THE NEXT UNIT OF AN ENVIRONMENT (Stages 5 and 6), the continuation
  ;;; having named its position P: the continuation moves on to the unit
  ;;; after it (`next'), or from the body's last (EXECUTE) to the one the
  ;;; body returns to -- after which nothing reaches the environment but a
  ;;; choice frame that still names one of its positions -- and the unit is
  ;;; taken by its kind, under the barrier it was given (`bslot'). A term,
  ;;; built at entry, is handed to the step from its slot as a clause's
  ;;; first goal is handed over (`ngoal', `nset' 1), and dispatched as a
  ;;; frame's goal was. A call goes into the registers (`nset' 2) when its
  ;;; functor is stamped a plain predicate of this store as of now,
  ;;; untraced (`fgen', what `coco_regs_ok' asks of a first goal), and is
  ;;; built from the slots and handed over otherwise, which stamps one that
  ;;; is plain the first time it is dispatched. The rest are done here, each
  ;;; the step its goal was: a cut; `true' and `fail'; a `,' going on to its
  ;;; first item; an if-then-else pushing the choice that runs its else,
  ;;; writing the height it went in at into its slot and going on to its
  ;;; condition; the cut after the condition, to that height; a disjunction
  ;;; pushing the choice that runs its right arm and going on to its left.
  ;;; UNDER TRACE every unit is handed over as the term its frame held
  ;;; (`coco_unit_term'), and runs as it did through 1.9.2, port for port.
  ;;; Since Stage 7 a builtin is done here too, where it stands: a guard,
  ;;; two sides, or a builtin called by its row on its term. 1 when a goal
  ;;; was handed over; 0 when the unit was done here; -2 when it failed; -1
  ;;; when the heap would not grow; -3 when a builtin raised an error that
  ;;; nothing caught (`err' filled in).
  ;;;
  ;;; WHAT IT READS IS SETTLED AT COMPILE TIME (`coco_egoal''s offsets): the
  ;;; continuation after the unit, its barrier's cell, its slot and its
  ;;; parts' positions are each the header plus one number, and the kind is
  ;;; a switch. A call whose arguments are all variables has them copied
  ;;; here, slot to register (`rvars'); any other is run by its register
  ;;; program (`coco_env_regs'). Recomputed from the counts at every take,
  ;;; and with the call's every argument a dispatched word in a function of
  ;;; its own, an environment made the lookup benchmark's loop 3.9 % dearer
  ;;; than its frames were; settled here, with the loop taking a handed-over
  ;;; goal in the same step, it is 6.5 % cheaper.
  (static)
  (func coco_env_take ((coco_engine * e) (size_t p)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t pay . #'(cast size_t (coco-payload (nth p (-> m heap)))))
              (size_t env . #'(- p (>> pay 16)))
              (coco_code * cd . #'(coco-env-code m env))
              (coco_egoal * eg . #'(aof (nth (bitand pay 65535) (-> cd egoals))))
              ;; the continuation after it, and its barrier: the
              ;; environment's, or a condition's height plus one
              (size_t nk . #'(+ env (cast size_t (-> eg noff))))
              (size_t bar . #'(+ (cast size_t (coco-signed-payload (nth (+ env (cast size_t (-> eg boff)))
                                                                       (-> m heap))))
                                 (cast size_t (-> eg badd)))))
          (if (-> e trace)
              (let ((size_t g . 0))
                (if (not (coco_unit_term m cd env (cast u32 (bitand pay 65535)) (aof g))) (return -1))
                (set (-> e goals) nk)
                (set (-> e ngoal) (coco_deref m g))
                (set (-> e nbar) bar)
                (set (-> e nset) 1)
                (return 1)))
          (switch (cast int (-> eg kind))
            (case (cc-eg "TERM")
              (set (-> e goals) nk)
              (set (-> e ngoal) (coco_deref m (+ env (cast size_t (-> eg soff)))))
              (set (-> e nbar) bar)
              (set (-> e nset) 1)
              (return 1))
            (case (cc-eg "CALL")
              (let ((coco_functor * f . #'(aof (nth (cast size_t (-> eg fid)) (-> m functors)))))
                (set (-> e goals) nk)
                (if (and (== (-> f fgen) coco_extern_generation)
                         (== (-> f pst) (cast (void *) (-> e st)))
                         (== (-> f pserial) (-> (-> e st) serial)))
                    (let ((int nxt . #'(- 1 (-> e acur)))
                          (size_t * rg . #'(aof (nth (* (cast size_t nxt) 8) (-> e areg)))))
                      ;; arguments that are all variables, copied here; any
                      ;; other register form run by its program
                      (if (-> eg rvars)
                          (let ((u64 * rp . #'(+ (-> cd ebody) (-> eg rat)))
                                (size_t eb . #'(+ env 4)))
                            (for ((u32 j . 0)) (< j (-> eg rlen)) ((++ j))
                              (let ((u64 w . #'(nth j rp)))
                                (set (nth (cast size_t (cc_n w)) rg) (coco_deref m (+ eb (cc_k w)))))))
                          (if (not (coco_env_regs m cd env (cast u32 (bitand pay 65535)) rg))
                              (return -1)))
                      (set (-> e afid) (-> eg fid))
                      (set (-> e aarity) (-> eg arity))
                      (set (-> e acur) nxt)
                      (set (-> e nbar) bar)
                      (set (-> e nset) 2)
                      (return 1)))
                (let ((size_t g . 0))
                  (if (not (coco_env_term m cd env (cast u32 (bitand pay 65535)) (aof g))) (return -1))
                  (set (-> e ngoal) g)
                  (set (-> e nbar) bar)
                  (set (-> e nset) 1)
                  (return 1))))
            (case (cc-eg "ITE")
              (let ((size_t h0 . #'(-> e nchoices)))
                (set (nth (+ env (cast size_t (-> eg soff))) (-> m heap)) (coco-int-cell (cast i64 h0)))
                (if (not (coco_push_choice e COCO_CH_GOAL (+ env (cast size_t (-> eg coff))) nk bar))
                    (return -1))
                (set (-> e goals) (+ env (cast size_t (-> eg aoff))))
                (return 0)))
            (case (cc-eg "CUTC")
              (let ((size_t h0 . #'(cast size_t (coco-signed-payload
                                                 (nth (+ env (cast size_t (-> eg soff))) (-> m heap))))))
                (if (< h0 (-> e nchoices)) (set (-> e nchoices) h0))
                (set (-> e goals) nk)
                (return 0)))
            (case (cc-eg "CONJ")
              (set (-> e goals) (+ env (cast size_t (-> eg aoff))))
              (return 0))
            (case (cc-eg "CUT")
              (if (< bar (-> e nchoices)) (set (-> e nchoices) bar))
              (set (-> e goals) nk)
              (return 0))
            (case (cc-eg "TRUE")
              ;; the program's own `true' is no inference (1.12.2), as the
              ;; construct counts it under trace; a construct's `$true' is
              ;; the inference it was
              (if (== (-> eg fid) (coco-id m "true")) (set (-> e frees) (+ (-> e frees) 1)))
              (set (-> e goals) nk)
              (return 0))
            (case (cc-eg "DISJ")
              (if (not (coco_push_choice e COCO_CH_GOAL (+ env (cast size_t (-> eg coff))) nk bar))
                  (return -1))
              (set (-> e goals) (+ env (cast size_t (-> eg aoff))))
              (return 0))
            ;; `fail', `false' and a construct's `$fail'
            (case (cc-eg "FAIL") (return -2))
            ;; a builtin in place (Stage 7), out of line
            (default (return (coco_env_place e cd env (cast u32 (bitand pay 65535)) nk bar))))
          (return -2)))

  ;;; ---- backtracking ------------------------------------------------------

  ;;; Winds the machine back to the newest choice point that still has
  ;;; something to try, and puts the continuation back. Answers 0 when there is
  ;;; nothing left anywhere, which is the query failing.
  (static)
  (func coco_backtrack ((coco_engine * e)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (while (> (-> e nchoices) 0)
            (let ((size_t ci . #'(- (-> e nchoices) 1))
                  (int kind) (size_t call) (size_t goals) (size_t barrier))
              (let ((coco_choice * c . #'(aof (nth ci (-> e choices)))))
                (coco_undo_to m (-> c trail_mark))
                (set ($ (cof m) heap_len) (-> c heap_mark))
                (set kind (-> c kind))
                (set call (-> c call))
                (set goals (-> c goals))
                (set barrier (-> c barrier)))
              (if (== kind COCO_CH_GOAL)
                  (block
                   ;; a `;' the program wrote: taking its other arm is a Redo
                   ;; of the call it sits in, printed with the bindings just
                   ;; undone. The else-frames of `->' pass in silence, and
                   ;; either way the call context is the one the frame was
                   ;; made under. A frame made in a call's body says so by its
                   ;; depth -- 0 is the toplevel, where nothing prints -- and
                   ;; not by its goal: a goal can be heap cell 0, the first
                   ;; term a fresh machine reads, and through 1.10.22 `cocolog
                   ;; --trace run F t' never printed the Fail of `t'.
                   (if (-> e trace)
                       (let ((coco_tchoice * tc . #'(aof (nth ci (-> e tchoices)))))
                         (if (and (!= (-> tc printr) 0) (> (-> tc depth) 0))
                             (block
                              (coco_trace_port e "Redo" (-> tc depth) (-> tc goal))
                              ;; the redone call's own frame -- the SPENT one its
                              ;; cut kept, or its clause frame -- and every call
                              ;; it is nested in, are open episodes again
                              (let ((i64 fi . #'(- (cast i64 ci) 1)))
                                (while (>= fi 0)
                                  (let ((int fk . #'($ (nth (cast size_t fi) (-> e choices)) kind)))
                                    (if (and (or (== fk COCO_CH_CLAUSE) (== fk COCO_CH_SPENT))
                                             (== ($ (nth (cast size_t fi) (-> e choices)) call) (-> tc goal))
                                             (== ($ (nth (cast size_t fi) (-> e tchoices)) depth) (-> tc depth)))
                                        (block (set ($ (nth (cast size_t fi) (-> e tchoices)) exited) 0)
                                               break)))
                                  (set fi (- fi 1))))
                              (coco_trace_reopen e ci (-> tc depth))))
                         (set (-> e trace_goal) (-> tc goal))
                         (set (-> e trace_depth) (-> tc depth))))
                   (set (-> e nchoices) ci)
                   ;; an alternative that is a position (Stage 6: a
                   ;; construct's else, a disjunction's right arm) is the
                   ;; continuation itself, its unit leading on to the rest
                   (if (coco-tag-is POS (nth call (-> m heap)))
                       (set (-> e goals) call)
                       (set (-> e goals) (coco_k_push e call barrier goals)))
                   (return 1)))
              ;; WE ARE FAILING BACK INTO A CATCH'S GOAL, so that catch is
              ;; catching again. It offers no alternative of its own -- the
              ;; frame below it does, which is why this one sits above them.
              (if (== kind COCO_CH_CATCH_RETRY)
                  (let ((size_t ri . #'($ (nth ci (-> e choices)) clause_ix)))
                    (if (and (< ri ci) (== ($ (nth ri (-> e choices)) kind) COCO_CH_DEAD))
                        (set ($ (nth ri (-> e choices)) kind) COCO_CH_CATCH))
                    (set (-> e nchoices) ci)
                    continue))
              ;; a catch offers no alternative, and neither does a frame the
              ;; soft cut killed, nor a traced call's frame its cut kept --
              ;; which is that call's Fail, out of line (1.10.24): drop it
              ;; and keep going down. A CLOCKED frame is a clause frame a
              ;; window's clock marked: its retry is read where it begins,
              ;; out of line (1.13.7), and it is tried below as any clause
              ;; frame is. Each kind its own equality, as they were: the
              ;; kinds stay a jump table, and a clause frame passes them in
              ;; three instructions -- folded into one test with SPENT
              ;; (`>= SPENT', or SPENT or CLOCKED) they were a chain of
              ;; compares, queens +0.08 % (`tools/flow/zero.sh')
              (if (== kind COCO_CH_CLOCKED) (coco_clock_retry e ci))
              (if (or (== kind COCO_CH_CATCH) (== kind COCO_CH_DEAD) (== kind COCO_CH_SPENT))
                  (block (if (== kind COCO_CH_SPENT) (coco_trace_spent e ci))
                         (set (-> e nchoices) ci) continue))
              ;; a clause frame. The goal is painted BEFORE selection, which
              ;; binds it to whichever head matches -- SWI's Redo shows the
              ;; call as it stood, not the head it is about to try.
              ;; IN A WINDOW (`trace' 2) the painting records the call as
              ;; re-entered, before its heads are tried, and the Redo and the
              ;; Fail record where they would print (`coco_trace_paint' and
              ;; the two after it, out of line, so the untraced path here is
              ;; what it was)
              (let ((char * rtext . nil) (int rD . 0) (size_t rg . 0)
                    (int rexited . 0) (int traced . 0))
                (if (-> e trace)
                    (let ((coco_tchoice * tc . #'(aof (nth ci (-> e tchoices)))))
                      (if (and (!= (-> tc printr) 0) (> (-> tc depth) 0))
                          (block (set traced 1)
                                 (set rD (-> tc depth))
                                 (set rg (-> tc goal))
                                 (set rexited (-> tc exited))
                                 (set rtext (coco_trace_paint e ci rD rg))))))
                (if (coco_select_clause e ci)
                    (block
                     (if traced
                         (block (coco_trace_redo e ci rD rtext)
                                (set ($ (nth ci (-> e tchoices)) exited) 0)
                                (coco_trace_reopen e ci rD)
                                (set (-> e trace_goal) rg)
                                (set (-> e trace_depth) rD)))
                     (if (!= rtext nil) (free rtext))
                     (return 1)))
                ;; out of heads. A call that had exited goes quietly -- the
                ;; silence SWI's clause indexing buys by never keeping the
                ;; frame -- and one that had not fails here, out loud.
                (if (and traced (== rexited 0)) (coco_trace_fail e ci rD rtext))
                (if (!= rtext nil) (free rtext)))))
          (return 0)))

  ;;; ---- throwing ----------------------------------------------------------

  ;;; Unwinds to the nearest enclosing `catch/3' whose catcher unifies with
  ;;; BALL, and leaves the engine about to run that catch's recovery goal.
  ;;; Answers 1 when it found one and -1 when nothing caught it.
  ;;;
  ;;; THE BALL GOES INTO THE STORE FIRST, and that is the whole difficulty.
  ;;; Unwinding truncates the heap to the frame's mark, and the ball was built
  ;;; above that mark -- by the time there is somewhere to put it, it is gone.
  ;;; The store does not shrink under a caller -- a compaction runs only at
  ;;; the safe points `coco_store_compact' names -- which is the property
  ;;; `assert' and `findall' already rely on, so the ball is put there and
  ;;; read back out on to the heap once the machine has been wound back.
  ;;;
  ;;; A CATCHER THAT DOES NOT MATCH MUST LEAVE NOTHING BEHIND. Trying it is a
  ;;; unification, so it is done between a mark and an undo -- otherwise a
  ;;; failed match would bind the catcher of an outer frame on the way past.
  ;;;
  ;;; ---- where a ball nothing caught was raised (1.10.17) -----------------
  ;;;
  ;;; THE BACKTRACE IS WRITTEN AS THE BALL IS THROWN, BEFORE ANYTHING
  ;;; UNWINDS -- the one moment the run is still there to be read -- and only
  ;;; for a ball no catch on the chain would take (`coco_bt_caught'): a
  ;;; program that throws and catches pays a walk over its choice frames and
  ;;; a unification for each catch, and writes nothing. The lines go to the
  ;;; machine's `bt', for the host that reports the error to print after its
  ;;; message (`coco_bt_say': cocolog.cicili's `say_goal_error', a load's
  ;;; report of a directive), each begun `ERROR: ' as SWI begins its own:
  ;;;
  ;;;     ERROR: In:
  ;;;     ERROR:   [5] _G120 is 2/0
  ;;;     ERROR:   [4] oops(2,_G120)
  ;;;
  ;;; For each engine on the chain, the innermost first: the goal it was
  ;;; running (`kcall': the builtin that raised, a module's predicate, the
  ;;; builtin that started the engine inside it, the goal an error names);
  ;;; then, TRACED (`--trace', or `--backtrace''s quiet trace 3), the calls
  ;;; it was made in, one per `$trace_exit' marker with its depth; or
  ;;; UNTRACED, the goals it had left to run -- each `'$k'' frame's goal and
  ;;; each unit of an environment, with the clause the environment is a
  ;;; body of. A run at full speed keeps no record of its calls: one that is
  ;;; last in its body leaves nothing behind, and one that is not leaves the
  ;;; goals after it, which are what there is to show -- and a note says how
  ;;; to have the calls. Each engine's first eight entries and its last four
  ;;; are written, with a count of those between; a goal past 240
  ;;; characters is cut.

  ;;; Would a catch on the chain -- from E out to the first engine whose
  ;;; starter reports its errors itself (`btstop') -- take BALL as things
  ;;; stand? A binding made since a catch was entered only makes its catcher
  ;;; more particular, and the ball here shares variables its copy would
  ;;; not, so a catch this says takes the ball does; one it says does not
  ;;; may still, and then the lines written are never printed.
  (static)
  (func coco_bt_caught ((coco_engine * e) (size_t ball)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (coco_engine * x . e))
          (while (!= x nil)
            (let ((size_t ci . #'(-> x nchoices)))
              (while (> ci 0)
                (set ci (- ci 1))
                (if (== ($ (nth ci (-> x choices)) kind) COCO_CH_CATCH)
                    (let ((size_t mark . #'(-> m trail_len))
                          (int ok . #'(coco_unify m (coco_arg m ($ (nth ci (-> x choices)) call) 0)
                                                  ball)))
                      (coco_undo_to m mark)
                      (if ok (return 1))))))
            (if (-> x btstop) (return 0))
            (set x (cast (coco_engine *) (-> x outer))))
          (return 0)))

  ;;; GOAL as `writeq' writes it, cut at 240 characters (not inside one)
  (static)
  (func coco_bt_text ((coco_machine * m) (coco_strbuf * b) (size_t g))
        (let ((coco_strbuf tb) (size_t n . 0))
          (coco_sb_init (aof tb))
          (coco_write_term m (aof tb) g 1 0)
          (if (== ($ tb s) nil)
              (coco_sb_put b "?")
            (block
             (set n ($ tb len))
             (if (<= n 240)
                 (coco_sb_put_len b ($ tb s) n)
               (block
                (set n 240)
                (while (and (> n 0) (== (bitand (cast int (nth n ($ tb s))) 192) 128))
                  (set n (- n 1)))
                (coco_sb_put_len b ($ tb s) n)
                (coco_sb_put b " ...")))))
          (coco_sb_free (aof tb))))

  ;;; the engine's own goals, never a program's: a cut to a height, a
  ;;; catch's exit, a trace marker, the constructs' `$true' and `$fail'
  (static)
  (func coco_bt_own ((coco_machine * m) (size_t g)) (out int)
        (let ((u64 c . #'(nth g (-> m heap))))
          (if (coco-tag-is ATOM c)
              (let ((u64 a . #'(coco_name_of m g)))
                (return (or (== a (coco-id m "$true")) (== a (coco-id m "$fail"))))))
          (if (coco-tag-is FUN c)
              (let ((u64 f . #'(cast u64 (coco-payload c))))
                (return (or (== f (coco-fid m "$cut" 1)) (== f (coco-fid m "$softcut" 1))
                            (== f (coco-fid m "$catch_exit" 1))
                            (== f (coco-fid m "$trace_exit" 3))))))
          (return 0)))

  ;;; the predicate and the clause (from 1) whose program CD is, by a walk
  ;;; over every predicate's programs; 0 when no live clause has it (its
  ;;; clause retracted while the body ran)
  (static)
  (func coco_bt_clause ((coco_store * st) (void * cd) (size_t * pi) (size_t * ci)) (out int)
        (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
          (let ((coco_pred * p . #'(aof (nth i (-> st preds)))))
            (if (!= (-> p codes) nil)
                (for ((size_t j . 0)) (and (< j (-> p nclauses)) (< j (-> p codes_cap))) ((++ j))
                  (if (and (== (nth j (-> p codes)) cd) (not (coco_pred_dead p j)))
                      (block (set (cof pi) i) (set (cof ci) (+ j 1)) (return 1)))))))
        (return 0))

  ;;; WHAT FOLLOWS CONTINUATION CELL C, and what C is (KIND): 1 a `'$k''
  ;;; frame, 2 a unit of an environment, 0 neither -- the end -- as
  ;;; `coco_k_resolve' reads them
  (static)
  (func coco_bt_next ((coco_machine * m) (size_t c) (int * kind)) (out size_t)
        (let ((u64 cv . #'(nth c (-> m heap))))
          (if (== cv (coco-cell FUN (coco-fid m "$k" 3)))
              (block (set (cof kind) 1) (return (coco_deref m (+ c 3)))))
          (if (coco-tag-is POS cv)
              (let ((size_t pay . #'(cast size_t (coco-payload cv)))
                    (size_t env . 0) (coco_code * cd . nil) (u32 un . 0))
                (set env (- c (>> pay 16)))
                (set cd (coco-env-code m env))
                (set un ($ (nth (cast u32 (bitand pay 65535)) (-> cd egoals)) next))
                (set (cof kind) 2)
                (return (? (== un 0) (coco_deref m (+ env 2)) (coco-env-pos env cd un)))))
          (set (cof kind) 0)
          (return c)))

  ;;; whether the entry at C (of KIND) is written: TRACED, a call's marker;
  ;;; untraced, a goal of the program's -- a unit told by its kind, before
  ;;; any term is built for it
  (static)
  (func coco_bt_shown ((coco_machine * m) (size_t c) (int kind) (int traced)) (out int)
        (if (== kind 1)
            (let ((size_t g . #'(coco_deref m (+ c 1))))
              (if traced
                  (return (== (nth g (-> m heap)) (coco-cell FUN (coco-fid m "$trace_exit" 3)))))
              (return (not (coco_bt_own m g)))))
        (if traced (return 0))
        (let ((size_t pay . #'(cast size_t (coco-payload (nth c (-> m heap)))))
              (size_t env . 0) (coco_code * cd . nil) (coco_egoal * eg . nil))
          (set env (- c (>> pay 16)))
          (set cd (coco-env-code m env))
          (set eg (aof (nth (cast u32 (bitand pay 65535)) (-> cd egoals))))
          (cond
            ((== (-> eg kind) (cc-eg "CUTC")) (return 0))
            ((or (== (-> eg kind) (cc-eg "CUT")) (== (-> eg kind) (cc-eg "TRUE"))
                 (== (-> eg kind) (cc-eg "FAIL")))
             (return (not (or (== (-> eg fid) (coco-id m "$true"))
                              (== (-> eg fid) (coco-id m "$fail"))))))
            ((== (-> eg kind) (cc-eg "TERM"))
             (return (not (coco_bt_own m (coco_deref m (cast size_t (coco-payload
                                                                     (nth (+ env (+ (+ (cast size_t (-> cd nes))
                                                                                       (cast size_t (-> eg tslot)))
                                                                                    4))
                                                                          (-> m heap)))))))))
            (#t (return 1)))))

  ;;; THE ENTRY AT C, one line: TRACED, `[Depth] Goal' read from its
  ;;; marker; untraced, `then Goal', and a unit of an environment other
  ;;; than the last line's names the clause the environment is a body of
  (static)
  (func coco_bt_line ((coco_engine * x) (coco_strbuf * b) (size_t c) (int kind) (int traced)
                      (size_t * lastenv))
        (let ((coco_machine * m . #'(-> x m)))
          (if (== kind 1)
              (let ((size_t g . #'(coco_deref m (+ c 1))))
                (if traced
                    (block
                     (coco_sb_put b "ERROR:   [")
                     (coco_sb_put_i64 b (coco-signed-payload
                                         (nth (coco_deref m (coco_arg m g 1)) (-> m heap))))
                     (coco_sb_put b "] ")
                     (coco_bt_text m b (cast size_t (coco-signed-payload
                                                     (nth (coco_deref m (coco_arg m g 0)) (-> m heap))))))
                  (block (coco_sb_put b "ERROR:   then ")
                         (coco_bt_text m b g)))
                (coco_sb_putc b (cast char 10))
                (return)))
          ;; a unit, built back as the term its frame held
          (let ((size_t pay . #'(cast size_t (coco-payload (nth c (-> m heap)))))
                (size_t env . 0) (coco_code * cd . nil) (size_t g . 0))
            (set env (- c (>> pay 16)))
            (set cd (coco-env-code m env))
            (coco_sb_put b "ERROR:   then ")
            (if (coco_unit_term m cd env (cast u32 (bitand pay 65535)) (aof g))
                (coco_bt_text m b (coco_deref m g))
              (coco_sb_put b "?"))
            (if (!= env (cof lastenv))
                (let ((size_t pi . 0) (size_t ci . 0))
                  (set (cof lastenv) env)
                  (if (coco_bt_clause (-> x st) (cast (void *) cd) (aof pi) (aof ci))
                      (let ((coco_pred * p . #'(aof (nth pi ($ (cof (-> x st)) preds))))
                            (size_t a . #'(coco_new_atom_id m (-> p name)))
                            (size_t n . #'(coco_new_int m (cast i64 (-> p arity)))))
                        (coco_sb_put b "   (clause ")
                        (coco_sb_put_i64 b (cast i64 ci))
                        (coco_sb_put b " of ")
                        (coco_bt_text m b (coco_make2 m "/" a n))
                        (coco_sb_put b ")")))))
            (coco_sb_putc b (cast char 10)))))

  ;;; ONE ENGINE'S PART: the goal it was running, then its entries -- the
  ;;; first eight, a count of those after them but for the last four, and
  ;;; the last four. Answers the lines written.
  (static)
  (func coco_bt_engine ((coco_engine * x) (coco_strbuf * b)) (out int)
        (let ((coco_machine * m . #'(-> x m))
              (int traced . #'(!= (-> x trace) 0))
              (size_t kc . #'(-> x kcall))
              (size_t c . #'(coco_deref m (-> x goals)))
              (size_t ring [4]) (int rkind [4]) (size_t nr . 0) (size_t n . 0)
              (size_t lastenv . 0) (int kind . 0) (size_t nx . 0) (int lines . 0))
          ;; the goal in flight, when it is a cell of the heap
          (if (and (!= kc 0) (< kc (-> m heap_len)))
              (block
               (if traced
                   (block (coco_sb_put b "ERROR:   [")
                          (coco_sb_put_i64 b (cast i64 (+ (-> x trace_depth) 1)))
                          (coco_sb_put b "] "))
                 (coco_sb_put b "ERROR:   "))
               (coco_bt_text m b kc)
               (coco_sb_putc b (cast char 10))
               (set lines 1)
               ;; taken from a frame, it left the frame where it was
               (if (== (nth c (-> m heap)) (coco-cell FUN (coco-fid m "$k" 3)))
                   (if (== (coco_deref m (+ c 1)) kc)
                       (set c (coco_deref m (+ c 3)))))))
          (while 1
            (set nx (coco_bt_next m c (aof kind)))
            (if (== kind 0) break)
            (if (coco_bt_shown m c kind traced)
                (block
                 (set n (+ n 1))
                 (if (<= n 8)
                     (block (coco_bt_line x b c kind traced (aof lastenv))
                            (set lines (+ lines 1)))
                   (block (set (nth (% nr 4) ring) c)
                          (set (nth (% nr 4) rkind) kind)
                          (set nr (+ nr 1))))))
            (set c nx))
          (if (> nr 4)
              (block (coco_sb_put b "ERROR:   ... ")
                     (coco_sb_put_i64 b (cast i64 (- nr 4)))
                     (coco_sb_put b " more ...")
                     (coco_sb_putc b (cast char 10))))
          (for ((size_t k . #'(? (> nr 4) (- nr 4) 0))) (< k nr) ((++ k))
            (coco_bt_line x b (nth (% k 4) ring) (nth (% k 4) rkind) traced (aof lastenv))
            (set lines (+ lines 1)))
          (return lines)))

  ;;; THE LINES, written for E and every engine out from it to the first
  ;;; that reports its own errors, into the machine's `bt'
  (static)
  (func coco_bt_capture ((coco_engine * e))
        (let ((coco_machine * m . #'(-> e m))
              (coco_strbuf b) (coco_engine * x . e) (int untraced . 0) (int lines . 0))
          (coco_sb_init (aof b))
          (coco_sb_put (aof b) "ERROR: In:")
          (coco_sb_putc (aof b) (cast char 10))
          (while (!= x nil)
            (if (== (-> x trace) 0) (set untraced 1))
            (set lines (+ lines (coco_bt_engine x (aof b))))
            (if (-> x btstop) break)
            (set x (cast (coco_engine *) (-> x outer))))
          (if untraced
              (block
               (coco_sb_put (aof b) "ERROR: Note: what each goal had left to run, not the calls it was made in;")
               (coco_sb_putc (aof b) (cast char 10))
               (coco_sb_put (aof b) "ERROR: run with --backtrace to see those.")
               (coco_sb_putc (aof b) (cast char 10))))
          (free (-> m bt))
          (set (-> m bt) nil)
          ;; nothing, or nothing the message does not say: the one line is
          ;; the goal that raised and that goal is the whole query asked --
          ;; `:- foo.' with foo unknown, `cocolog query 'X is 1/0''
          (if (or (== lines 0)
                  (and (== lines 1) (!= (-> e kcall) 0)
                       (== (-> e kcall) (coco_deref m (-> e query)))))
              (coco_sb_free (aof b))
            (set (-> m bt) ($ b s)))))

  ;;; WHAT A THROW PUTS IN THE STORE (1.10.18): the ball, or -- when it
  ;;; holds a cycle -- its factors as `'$cyclic'(Template, [V1=T1, ...])'
  ;;; (`coco_factorize', lib/term.cicili), which `coco_store_read' makes
  ;;; cyclic again; `cyc_puts' counts it, as the store's put counts the
  ;;; ones it factors (1.10.19). Through 1.10.17 `throw(X)' of `X = f(X)'
  ;;; never came back. The put would find the cycle itself since 1.10.19,
  ;;; past twice the heap's length; a ball is small, and asking first
  ;;; costs its quick walk. A ball the heap cannot hold the factors of is
  ;;; thrown as `'$cyclic'', which is no hang.
  (static)
  (func coco_ball_storable ((coco_machine * m) (size_t ball)) (out size_t)
        ;; an atom, a number, a variable: nothing to ask
        (if (not (coco-tag-is FUN (nth (coco_deref m ball) (-> m heap)))) (return ball))
        (if (!= 0 (coco_acyclic m ball)) (return ball))
        (let ((size_t * vars . nil) (size_t nv . 0)
              (size_t f . #'(coco_factorize m ball "$cyclic" (aof vars) (aof nv))))
          (free vars)
          (if (== f 0) (return (coco_new_atom m "$cyclic")))
          (set (-> m cyc_puts) (+ (-> m cyc_puts) 1))
          (return f)))

  ;; defined with the engine's private stores, below `coco_engine_free'
  (decl) (func coco_engine_bstore ((coco_engine * e)) (out coco_store *))

  (static)
  (func coco_throw ((coco_engine * e) (size_t ball)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              ;; A CATCH IN THIS ENGINE takes the ball here, in this
              ;; engine's private store: no other worker can see it, and
              ;; the put must not stop the world. A ball nothing here
              ;; catches is put in the shared store, where an OUTER engine
              ;; can read it -- see `coco_engine_call_limited'.
              (int hascatch . 0)
              (coco_engine * catcher . nil)
              (coco_store * bst . st)
              (size_t pmark . 0)
              (size_t cell . 0) (size_t size . 0)
              ;; a builtin throwing again a ball its engine raised keeps the
              ;; lines that first throw wrote (1.10.17)
              (int keep . #'(-> m btkeep)))
          (set (-> m btkeep) 0)

          ;; IS THERE A CATCH FRAME AT ALL? Only its presence matters for
          ;; where the ball goes; whether its catcher unifies is the scan
          ;; below.
          (for ((size_t i . 0)) (< i (-> e nchoices)) ((++ i))
            (if (== ($ (nth i (-> e choices)) kind) COCO_CH_CATCH)
                (block (set hascatch 1) (set catcher e))))
          ;; A FINDALL'S GOAL RUNS ON A NESTED ENGINE. If this engine has no
          ;; catcher, look at its IMMEDIATE outer engine -- the one whose
          ;; builtin started this search -- and put the ball in that
          ;; engine's private store, so the crossing does not stop the world.
          ;; Do NOT walk further out: each nested builtin has its own
          ;; semantics for a ball (a window records it, with_output_to puts
          ;; stdout back first), and the outer engine's own throw will look
          ;; past itself when its builtin has done that work.
          (if (== catcher nil)
              (let ((coco_engine * x . #'(cast (coco_engine *) (-> e outer))))
                (if (!= x nil)
                    (for ((size_t i . 0)) (< i (-> x nchoices)) ((++ i))
                      (if (== ($ (nth i (-> x choices)) kind) COCO_CH_CATCH)
                          (set catcher x))))))
          (if (!= catcher nil)
              (block
               (set bst (coco_engine_bstore catcher))
               (set pmark (-> bst len))))

          (set cell (coco_store_put bst m (coco_ball_storable m ball)))
          (set size (- (-> bst len) cell))

          ;; a window records the raise, and a journal keeps a portal call's,
          ;; before anything unwinds (1.10.12, 1.10.15)
          (if (!= ($ (cof m) rec) nil) (coco_rec_throw e ball))
          ;; A BALL NO CATCH ON THE CHAIN WOULD TAKE: where it was raised,
          ;; written now, while there is a run to read (1.10.17)
          (if (and coco_backtrace (not keep))
              (if (not (coco_bt_caught e ball)) (coco_bt_capture e)))
          (while (> (-> e nchoices) 0)
            (let ((size_t ci . #'(- (-> e nchoices) 1))
                  (int kind) (size_t call) (size_t goals) (size_t barrier))
              (let ((coco_choice * c . #'(aof (nth ci (-> e choices)))))
                (set kind (-> c kind))
                (set call (-> c call))
                (set goals (-> c goals))
                (set barrier (-> c barrier))
                ;; back to how things stood when this frame was made
                (coco_undo_to m (-> c trail_mark))
                (set ($ (cof m) heap_len) (-> c heap_mark)))

              (if (!= kind COCO_CH_CATCH)
                  (block (set (-> e nchoices) ci) continue))

              ;; `'$catch'(Catcher, Recovery)', built before the frame was
              ;; pushed and so below its heap mark -- it survived the unwinding
              (let ((size_t mark . #'($ (cof m) trail_len))
                    (size_t fresh . #'(coco_store_read m bst cell))
                    (size_t catcher . #'(coco_arg m call 0))
                    (size_t recovery . #'(coco_arg m call 1)))
                (if (coco_unify m catcher fresh)
                    (block
                     (if (-> e trace)
                         (block (set (-> e trace_goal) ($ (nth ci (-> e tchoices)) goal))
                                (set (-> e trace_depth) ($ (nth ci (-> e tchoices)) depth))
                                ;; and a window where it was caught: in the
                                ;; body of the call the catch/3 is in
                                (if (== (-> e trace) 2)
                                    (coco_rec_mark e COCO_REV_CATCH (-> e trace_depth)
                                                   (-> e trace_goal) 0))))
                     (set (-> e nchoices) ci)
                     (set (-> e goals) (coco_k_push e recovery barrier goals))
                     ;; the ball is on the heap and its cell an orphan
                     (if (== bst st)
                         (block
                          (set (-> st dead) (+ (-> st dead) size))
                          (coco_store_maybe_compact st m))
                       ;; the private cell can go with the recovered term
                       (block (set (-> bst len) pmark)
                              (coco_store_shrink_empty bst)))
                     (return 1)))
                (coco_undo_to m mark))
              (set (-> e nchoices) ci)))

          ;; NOTHING IN THIS ENGINE CAUGHT IT. If the catcher is THIS
          ;; engine (a frame whose catcher missed), the private cell is an
          ;; orphan and the ball goes to the shared store for the next
          ;; engine. If the catcher is an OUTER engine, keep it in that
          ;; engine's private store and carry the store with the cell; the
          ;; findall/call_limited rethrow reads it from there.
          (if (!= bst st)
              (if ( == catcher e)
                  (block
                   (set cell (coco_store_put st m (coco_store_read m bst cell)))
                   (set size (- (-> st len) cell))
                   (set (-> bst len) pmark)
                   (coco_store_shrink_empty bst)
                   (set (-> e ball_st) (cast (void *) st))
                   (set (-> e ball_mark) 0))
                (block
                 (set (-> e ball_st) (cast (void *) bst))
                 (set (-> e ball_mark) pmark)))
            (block
             (set (-> e ball_st) (cast (void *) st))
             (set (-> e ball_mark) 0)))

          ;; The cell is kept so an OUTER engine can throw this same ball
          ;; again -- see `coco_engine_call_limited' -- and the ball is read
          ;; back one last time so that the message can name it, which is the
          ;; difference between a report a person can act on and
          ;; `an error occurred'.
          (set (-> e has_ball) 1)
          (set (-> e ball_cell) cell)
          (set (-> e ball_size) size)
          (let ((coco_strbuf b)
                (coco_store * rst . #'(cast (coco_store *) (-> e ball_st))))
            (coco_sb_init (aof b))
            (coco_write_term m (aof b) (coco_store_read m rst cell) 1 0)
            (snprintf (-> e err) 512 "uncaught exception: %s"
                      (? (== ($ b s) nil) "?" ($ b s)))
            (coco_sb_free (aof b)))
          (return -1)))

  (func coco_m_thrown ((coco_engine * e) (size_t ball)) (out int)
        (return (? (== 1 (coco_throw e ball)) 1 0)))

  ;;; ---- what an exception reads like ---------------------------------------

  ;; One argument of an error term, written the way a message would show it.
  (static)
  (func coco_err_say ((coco_machine * m) (size_t t) (char * out) (size_t len))
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_term m (aof b) t 1 0)
          (snprintf out len "%s" (? (== ($ b s) nil) "?" ($ b s)))
          (coco_sb_free (aof b))))

  ;;; A SYNTAX ERROR'S REASON, as swipl's syntax_error//1 says it (3.0.0):
  ;;; `illegal_number' is "Illegal number", `operator_expected' "Operator
  ;;; expected", and a reason it has no sentence for is written as it is (~w)
  (static)
  (func coco_syntax_say ((coco_machine * m) (size_t t) (char * out) (size_t len))
        (let ((size_t d . #'(coco_deref m t)) (const char * w . nil) (coco_strbuf b))
          (if (coco-tag-is ATOM (nth d (-> m heap)))
              (let ((const char * n . #'(coco_atom_name m (coco_name_of m d))))
                (cond ((== 0 (strcmp n "end_of_clause")) (set w "Unexpected end of clause"))
                      ((== 0 (strcmp n "end_of_clause_expected")) (set w "End of clause expected"))
                      ((== 0 (strcmp n "end_of_file")) (set w "Unexpected end of file"))
                      ((== 0 (strcmp n "end_of_file_in_block_comment"))
                       (set w "End of file in /* ... */ comment"))
                      ((== 0 (strcmp n "illegal_number")) (set w "Illegal number"))
                      ((== 0 (strcmp n "long_atom")) (set w "Atom too long (see style_check/1)"))
                      ((== 0 (strcmp n "long_string")) (set w "String too long (see style_check/1)"))
                      ((== 0 (strcmp n "operator_clash")) (set w "Operator priority clash"))
                      ((== 0 (strcmp n "operator_expected")) (set w "Operator expected"))
                      ((== 0 (strcmp n "operator_balance")) (set w "Unbalanced operator"))
                      ((== 0 (strcmp n "quoted_punctuation"))
                       (set w "Operand expected, unquoted comma or bar found"))
                      ((== 0 (strcmp n "list_rest")) (set w "Unexpected comma or bar in rest of list"))
                      ((== 0 (strcmp n "cannot_start_term")) (set w "Illegal start of term"))
                      ((== 0 (strcmp n "void_not_allowed")) (set w "Empty argument list \"()\"")))))
          (if (!= w nil)
              (block (snprintf out len "%s" w) (return)))
          (coco_sb_init (aof b))
          (coco_write_term m (aof b) d 0 0)
          (snprintf out len "%s" (? (== ($ b s) nil) "?" ($ b s)))
          (coco_sb_free (aof b))))

  ;;; THE KIND OF A TYPE ERROR'S CULPRIT, as swipl's type_error_comment//2
  ;;; names it (3.0.0): ` (a compound)', ` (an atom)', ... -- `[]' an
  ;;; empty_list, a proper list a list, a cyclic term a cyclic.
  (static)
  (func coco_err_kind ((coco_machine * m) (size_t t)) (out const char *)
        (let ((size_t d . #'(coco_deref m t)) (u64 c . 0))
          (set c (nth d (-> m heap)))
          (if (coco-tag-is REF c) (return "a var"))
          (if (coco_is_nil m d) (return "an empty_list"))
          (if (coco-tag-is ATOM c) (return "an atom"))
          (if (coco-is-int c) (return "an integer"))
          (if (coco-tag-is STR c) (return "a string"))
          (if (coco-rat-p c) (return "a rational"))
          (if (coco-tag-is FLT c) (return "a float"))
          (if (coco_is_cons m d)
              (let ((size_t l . d) (size_t budget . #'(-> m heap_len)))
                (while (and (coco_is_cons m l) (> budget 0))
                  (set budget (- budget 1))
                  (set l (coco_deref m (coco_arg m l 1))))
                (if (coco_is_nil m l) (return "a list"))))
          (if (not (coco_acyclic m d)) (return "a cyclic"))
          (return "a compound")))

  ;;; Whether a module is one swipl leaves out of a message: user, system,
  ;;; or one whose name begins with `$'.
  (static)
  (func coco_err_hidden ((coco_machine * m) (size_t md)) (out int)
        (let ((const char * s . nil))
          (if (not (coco-tag-is ATOM (nth md (-> m heap)))) (return 0))
          (set s (coco_atom_name m (coco_name_of m md)))
          (return (? (or (== 0 (strcmp s "user"))
                         (or (== 0 (strcmp s "system")) (== (nth 0 s) (cast char 36))))
                     1 0))))

  ;;; Whether T is a name and an arity, both bound: N/A.
  (static)
  (func coco_err_pi ((coco_machine * m) (size_t t)) (out int)
        (if (not (coco_is_compound2 m t "/")) (return 0))
        (return (? (and (coco-tag-is ATOM (nth (coco_deref m (coco_arg m t 0)) (-> m heap)))
                        (coco-is-int (nth (coco_deref m (coco_arg m t 1)) (-> m heap))))
                   1 0)))

  ;;; WHERE A MESSAGE SAYS IT WAS RAISED, swipl's caller//1 (3.0.0): the
  ;;; context(M:N/A, _) of an error is `N/A: ' before its text when M is
  ;;; hidden and `M:N/A: ' else, context(N/A, _) `N/A: ', N written quoted
  ;;; and A plain; anything else, unbound among it, puts nothing. Through
  ;;; 2.16 no error of the engine's had a context to say.
  (static)
  (func coco_err_caller ((coco_machine * m) (size_t ball) (coco_strbuf * b))
        (let ((size_t cx . #'(coco_deref m (coco_arg m ball 1))) (size_t c . 0) (size_t pi . 0))
          (if (not (coco_is_compound2 m cx "context")) (return))
          (set c (coco_deref m (coco_arg m cx 0)))
          (set pi c)
          (if (coco_is_compound2 m c ":")
              (let ((size_t md . #'(coco_deref m (coco_arg m c 0))))
                (if (not (coco-tag-is ATOM (nth md (-> m heap)))) (return))
                (set pi (coco_deref m (coco_arg m c 1)))
                (if (not (coco_err_pi m pi)) (return))
                (if (not (coco_err_hidden m md))
                    (block (coco_write_term m b md 1 0) (coco_sb_put b ":"))))
              (if (not (coco_err_pi m pi)) (return)))
          (coco_write_term m b (coco_deref m (coco_arg m pi 0)) 1 0)
          (coco_sb_put b "/")
          (coco_write_term m b (coco_deref m (coco_arg m pi 1)) 0 0)
          (coco_sb_put b ": ")))

  ;;; WHAT A CONTEXT SAYS BESIDES, swipl's swi_extra//1 (3.0.0): of
  ;;; context(_, Msg) with Msg bound and not '' ` (Msg)', Msg written plain.
  (static)
  (func coco_err_extra ((coco_machine * m) (size_t ball) (coco_strbuf * b))
        (let ((size_t cx . #'(coco_deref m (coco_arg m ball 1))) (size_t w . 0))
          (if (not (coco_is_compound2 m cx "context")) (return))
          (set w (coco_deref m (coco_arg m cx 1)))
          (if (coco-tag-is REF (nth w (-> m heap))) (return))
          (if (and (coco-tag-is ATOM (nth w (-> m heap)))
                   (== (nth 0 (coco_atom_name m (coco_name_of m w))) (cast char 0)))
              (return))
          (coco_sb_put b " (")
          (coco_write_term m b w 0 0)
          (coco_sb_put b ")")))

  (static)
  (func coco_error_body ((coco_machine * m) (size_t ball) (char * out) (size_t len))
        (let ((size_t b . #'(coco_deref m ball))
              (char a1 [256]) (char a2 [256]) (char a3 [256]))
          ;; A ball that is not `error(Formal, Context)' is not an error term
          ;; at all -- `throw(my_ball)' is a perfectly good throw -- and SWI
          ;; says so in those words rather than pretending to explain it.
          (if (not (and (coco_is_callable m b) (== (coco_arity m b) 2)
                        (== 0 (strcmp (coco_atom_name m (coco_name_of m b)) "error"))))
              (block (coco_err_say m b a1 (sizeof a1))
                     (snprintf out len "Unknown message: %s" a1)
                     (return)))
          (let ((size_t f . #'(coco_deref m (coco_arg m b 0)))
                (const char * fn . "") (u32 fa . 0))
            (if (coco_is_callable m f)
                (block (set fn (coco_atom_name m (coco_name_of m f)))
                       (set fa (coco_arity m f))))

            (if (and (== fa 0) (== 0 (strcmp fn "instantiation_error")))
                (block (snprintf out len "Arguments are not sufficiently instantiated")
                       (return)))

            (if (and (== fa 2) (== 0 (strcmp fn "existence_error")))
                (let ((size_t k . #'(coco_deref m (coco_arg m f 0))))
                  (coco_err_say m k a1 (sizeof a1))
                  (coco_err_say m (coco_arg m f 1) a2 (sizeof a2))
                  (if (== 0 (strcmp a1 "procedure"))
                      (block (snprintf out len "Unknown procedure: %s" a2) (return)))
                  (snprintf out len "%s `%s' does not exist" a1 a2)
                  (return)))

            (if (and (== fa 2) (== 0 (strcmp fn "type_error")))
                (block
                 (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                 (coco_err_say m (coco_arg m f 1) a2 (sizeof a2))
                 ;; `X is foo+1' is a type_error(evaluable, foo/0) and SWI
                 ;; does NOT say "type error" for it -- measured
                 (if (== 0 (strcmp a1 "evaluable"))
                     (block (snprintf out len "Arithmetic: `%s' is not a function" a2)
                            (return)))
                 (snprintf out len "Type error: `%s' expected, found `%s' (%s)" a1 a2
                           (coco_err_kind m (coco_arg m f 1)))
                 (return)))

            (if (and (== fa 2) (== 0 (strcmp fn "domain_error")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (coco_err_say m (coco_arg m f 1) a2 (sizeof a2))
                       (snprintf out len "Domain error: `%s' expected, found `%s'" a1 a2)
                       (return)))

            (if (and (== fa 3) (== 0 (strcmp fn "permission_error")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (coco_err_say m (coco_arg m f 1) a2 (sizeof a2))
                       (coco_err_say m (coco_arg m f 2) a3 (sizeof a3))
                       (snprintf out len "No permission to %s %s `%s'" a1 a2 a3)
                       (return)))

            (if (and (== fa 1) (== 0 (strcmp fn "evaluation_error")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (snprintf out len "Arithmetic: evaluation error: `%s'" a1)
                       (return)))

            (if (and (== fa 1) (== 0 (strcmp fn "representation_error")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (snprintf out len "Cannot represent due to `%s'" a1)
                       (return)))

            ;; AND WHAT THE BALL SAYS BESIDES (2.11.1), in SWI's shape, when
            ;; its context is context(P, Why) -- "P: Not enough resources: K
            ;; (Why)", Why unquoted -- which is how a read of the knowledge base
            ;; that failed says which predicate and why (`coco_fetch_error').
            ;; The other formals do not read their context yet.
            ;; (its context, `P: ... (Why)', is the one every error's is
            ;; now, `coco_error_text')
            (if (and (== fa 1) (== 0 (strcmp fn "resource_error")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (snprintf out len "Not enough resources: %s" a1)
                       (return)))

            (if (and (== fa 1) (== 0 (strcmp fn "syntax_error")))
                (block (coco_syntax_say m (coco_arg m f 0) a1 (sizeof a1))
                       (snprintf out len "Syntax error: %s" a1)
                       (return)))

            ;; format/2,3's two (3.0.0), swipl's sentences
            (if (and (== fa 2) (== 0 (strcmp fn "format_argument_type")))
                (let ((coco_strbuf fb))
                  (coco_sb_init (aof fb))
                  (coco_write_term m (aof fb) (coco_deref m (coco_arg m f 0)) 0 0)
                  (snprintf a1 (sizeof a1) "%s" (? (== ($ fb s) nil) "?" ($ fb s)))
                  (coco_sb_free (aof fb))
                  (coco_err_say m (coco_arg m f 1) a2 (sizeof a2))
                  (snprintf out len "Illegal argument to format sequence ~%s: %s" a1 a2)
                  (return)))
            (if (and (== fa 1) (== 0 (strcmp fn "format")))
                (let ((coco_strbuf fb))
                  (coco_sb_init (aof fb))
                  (coco_write_term m (aof fb) (coco_deref m (coco_arg m f 0)) 0 0)
                  (snprintf out len "Format error: %s" (? (== ($ fb s) nil) "?" ($ fb s)))
                  (coco_sb_free (aof fb))
                  (return)))

            ;; A SIGNAL (2.6.0): SWI's sentence, the number then the name.
            ;; Its Context is a fresh variable here, as every cocolog
            ;; error's is, so there is no predicate to put in front.
            (if (and (== fa 2) (== 0 (strcmp fn "signal")))
                (block (coco_err_say m (coco_arg m f 0) a1 (sizeof a1))
                       (coco_err_say m (coco_arg m f 1) a2 (sizeof a2))
                       (snprintf out len "Caught signal %s (%s)" a2 a1)
                       (return)))

            ;; cocolog's own ball, which carries a sentence and not a term:
            ;; `cocolog_error('use_module: p.pl: no such file')' is already
            ;; the message, and wrapping it in "Unknown error term" would
            ;; hide the one useful thing in it.
            (if (and (== fa 1) (== 0 (strcmp fn "cocolog_error")))
                (let ((size_t w . #'(coco_deref m (coco_arg m f 0))))
                  (if (and (coco_is_callable m w) (== (coco_arity m w) 0))
                      (block (snprintf out len "%s" (coco_atom_name m (coco_name_of m w)))
                             (return)))
                  (coco_err_say m w a1 (sizeof a1))
                  (snprintf out len "%s" a1)
                  (return)))

            (coco_err_say m f a1 (sizeof a1))
            (snprintf out len "Unknown error term: %s" a1))))

  ;;; THE MESSAGE OF AN UNCAUGHT ERROR, as swipl prints it (3.0.0): where it
  ;;; was raised (`coco_err_caller'), what it is (`coco_error_body'), and
  ;;; what its context says besides (`coco_err_extra').
  (func coco_error_text ((coco_machine * m) (size_t ball) (char * out) (size_t len))
        (let ((size_t b . #'(coco_deref m ball)) (char body [1024]) (coco_strbuf pre) (coco_strbuf post))
          (coco_error_body m b body (sizeof body))
          (coco_sb_init (aof pre))
          (coco_sb_init (aof post))
          (if (and (coco_is_callable m b) (and (== (coco_arity m b) 2)
                   (== 0 (strcmp (coco_atom_name m (coco_name_of m b)) "error"))))
              (block (coco_err_caller m b (aof pre))
                     (coco_err_extra m b (aof post))))
          (snprintf out len "%s%s%s" (? (== ($ pre s) nil) "" ($ pre s)) body
                    (? (== ($ post s) nil) "" ($ post s)))
          (coco_sb_free (aof pre))
          (coco_sb_free (aof post))))

  (func coco_engine_error_text ((coco_engine * e) (char * out) (size_t len)) (out int)
        (if (not (-> e has_ball)) (return 0))
        (let ((coco_store * bs . #'(? (== (-> e ball_st) nil)
                                      (-> e st)
                                      (cast (coco_store *) (-> e ball_st)))))
          (coco_error_text (-> e m)
                           (coco_store_read (-> e m) bs (-> e ball_cell))
                           out len))
        (return 1))

  ;;; ---- calling ------------------------------------------------------------

  ;;; if-then-else, and the three things built out of it. Reads as:
  ;;;
  ;;;   push an alternative that runs ELSE
  ;;;   run COND, then cut away that alternative, then run THEN
  ;;;
  ;;; The cut is a `'$cut'(H)' goal put between them, where H is the height the
  ;;; stack had before the alternative was pushed. COND runs under a barrier of
  ;;; its own, so a `!' inside a condition is local to it -- which is what the
  ;;; standard says and what makes `( ! ; true )' behave.
  (static)
  (func coco_ite ((coco_engine * e) (size_t c) (size_t t) (size_t els) (size_t k) (size_t b))
        (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t h0 . #'(-> e nchoices)))
          (if (not (coco_push_choice e COCO_CH_GOAL els k b)) (return 0))
          (let ((size_t k1 . #'(coco_k_push e t b k))
                (size_t cut . #'(coco_make1_f m (coco-fid m "$cut" 1) (coco_new_int m (cast i64 h0)))))
            (set (-> e goals) (coco_k_push e c (-> e nchoices) (coco_k_push e cut b k1))))
          (return 1)))

  ;;; The SOFT cut, `(C *-> T ; E)'. It differs from if-then-else in one
  ;;; place and one only: when C succeeds, T runs for EVERY solution of C, not
  ;;; just the first. So the alternative that runs E has to go while C's own
  ;;; choice points stay -- which is why `$cut' will not do here. `$cut'
  ;;; truncates the stack to a height, and everything C pushed is above the
  ;;; frame holding E.
  ;;;
  ;;; `$softcut'(H) kills the one frame at H instead, leaving the rest alone.
  (static)
  (func coco_soft_ite ((coco_engine * e) (size_t c) (size_t t) (size_t els)
                       (size_t k) (size_t b))
        (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t h0 . #'(-> e nchoices)))
          (if (not (coco_push_choice e COCO_CH_GOAL els k b)) (return 0))
          (let ((size_t k1 . #'(coco_k_push e t b k))
                (size_t sc . #'(coco_make1_f m (coco-fid m "$softcut" 1) (coco_new_int m (cast i64 h0)))))
            (set (-> e goals) (coco_k_push e c (-> e nchoices) (coco_k_push e sc b k1))))
          (return 1)))

  ) ; impl-solve-control

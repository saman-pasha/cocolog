;;;; cocolog -- the knowledge base
;;;
;;; A CLAUSE DOES NOT LIVE ON THE HEAP, and it cannot. The heap is truncated on
;;; every backtrack -- that is how a failed branch's terms are reclaimed -- so
;;; anything stored there would be reclaimed along with the branch that
;;; asserted it. Clauses live in a store of their own, which only ever grows,
;;; and are COPIED into the heap with fresh variables each time one is used.
;;; That copy is not an optimisation to be removed later: it is what lets the
;;; same clause be in use at two depths of the same proof at once.
;;;
;;; THE STORE IS THE SEAM THE DATABASE FITS INTO. A predicate that the store
;;; does not have is not immediately a failure -- the store first asks its
;;; `fetch' hook, which is null for a purely local machine and, for a machine
;;; backed by Zigurat, goes and reads the clauses out of a table. Everything
;;; above this file is written against the store and knows nothing about where
;;; clauses come from; everything below it is one function pointer.
;;;
;;; So the three arrangements the project needs are the same code with a
;;; different hook: a standalone interpreter (no hook), an interpreter sharing
;;; a knowledge base over the binary protocol, and one sharing it over Zeytun's
;;; HTTP pages.
;;;
;;; WHY CLAUSES GO INTO THE DATABASE AS TEXT. The obvious alternative is to
;;; store the cells, which would load faster. Text wins on three counts that
;;; matter more: a person can read the table, a Parsi procedure can search it
;;; with an ordinary LIKE, and it does not tie the schema to the cell encoding
;;; -- change a tag and every clause already in the database still loads. The
;;; MACHINE state is stored as cells, because nobody reads that by hand and it
;;; has to come back exactly.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;; THE ONE SHAPE OF A STORE WRITE: begin the green barrier, let the body run,
;;; and release it on every exit, including a failed return. The `defer'
;;; attribute is what makes the second half true; spelling it at each call
;;; site was fifteen copies of the same three lines.
(DEFMACRO with-green-write (e &REST body)
  `(let ((defer () coco_g_write_end_cleanup)
         (int began . #'(coco_g_write_begin ,e)))
     ,@body))

;;; THE CLAUSE COMPILER'S OPCODES, one table read two ways -- the `cc_NAME'
;;; functions the compiler calls (emitted beside it), and `(cc-op "NAME")',
;;; a number at expansion time, for a `case' label in the executor's switch,
;;; which must be a constant. Nothing else may spell an opcode's number.
(DEFPARAMETER *cc-ops*
  '(("GET_VAR" 1)
    ("GET_VAL" 2)
    ("GET_CONST" 3)
    ("GET_STRUCT" 4)
    ("GET_STRUCT_T" 5)
    ("UNIFY_VAR" 6)
    ("UNIFY_VAL" 7)
    ("UNIFY_CONST" 8)
    ("GOAL_STRUCT" 20)
    ("GOAL_ATOM" 21)
    ("GOAL_VAR" 22)
    ("GOAL_VAR_1" 23)
    ("ARG_CONST" 24)
    ("ARG_VAR" 25)
    ("ARG_VAR_1" 26)
    ("ARG_STRUCT" 27)
    ;; the first goal of a body, written into the engine's argument
    ;; registers instead of built as a term (`coco_code', `rbody')
    ("RGOAL" 28)
    ("RARG_CONST" 29)
    ("RARG_VAR" 30)
    ("RARG_VAR_1" 31)
    ("RARG_STRUCT" 32)
    ;; the arithmetic and type tests a body starts with, evaluated when the
    ;; clause is entered (`coco_code', `gbody'): a stack of integers
    ("AG_LOAD" 33)
    ("AG_PUSH" 34)
    ("AG_BIN" 35)
    ("AG_UN" 36)
    ("AG_CMP" 37)
    ("AG_ISF" 38)
    ("AG_ISV" 39)
    ("AG_ISC" 40)
    ("AG_TYPE" 41)
    ;; a body's later goals at entry when it makes an environment (Stage 5,
    ;; `xbody'): a fresh variable for a call's first-met variable, which
    ;; the call builds no term to hold
    ("FRESH" 42)
    ;; a guard in place whose two operands are each a slot or a constant,
    ;; as one word and its two operands (`cc_ufuse', `coco_env_guardx'):
    ;; `X is A op B' over `+', `-' and `*', and the six comparisons
    ("AG_ISX" 43)
    ("AG_CMPX" 44)))

;;; A GUARD'S OPERATORS AND TESTS, by the code in an AG_BIN, AG_UN, AG_CMP or
;;; AG_TYPE word's K. One table read two ways again: the compiler matches a
;;; functor's name against the first column (`cc_guard_code'), and the
;;; executor's `case' labels are `(cc-gop "NAME")'. Three of the names end
;;; or are written with a backslash, which a Cicili string literal cannot
;;; carry, so they are named here by a word and matched by their codes
;;; (`cc_guard_code').
(DEFPARAMETER *cc-gops*
  '(;; binary, integers in and out, each as `coco_arith_binary' computes it
    ("+" 1) ("-" 2) ("*" 3) ("//" 4) ("div" 5) ("mod" 6) ("rem" 7)
    ("min" 8) ("max" 9) (">>" 10) ("<<" 11) ("bitand" 12) ("bitor" 13) ("xor" 14)
    ;; unary
    ("neg" 20) ("pos" 21) ("bitnot" 22) ("abs" 23) ("sign" 24)
    ;; the six comparisons
    ("<" 30) (">" 31) ("=<" 32) (">=" 33) ("=:=" 34) ("numneq" 35)
    ;; the type tests
    ("var" 40) ("nonvar" 41) ("atom" 42) ("integer" 43) ("number" 44)
    ("atomic" 45) ("compound" 46)))

(DEFUN cc-gop-number (name)
  (LET ((row (ASSOC name *cc-gops* :TEST #'STRING=)))
    (UNLESS row (ERROR "cocolog: no guard operator ~S" name))
    (SECOND row)))

(DEFMACRO cc-gop (name) (cc-gop-number name))

;;; HOW THE STEP REACHES ONE UNIT OF A BODY RUN FROM AN ENVIRONMENT (Stages
;;; 5 and 6, `coco_egoal'), by the number in its KIND. A unit is what one
;;; `'$k'' frame held through 1.9.2: a goal built at entry and dispatched
;;; (TERM), its arguments written into the registers and its predicate
;;; tried from them (CALL), a cut (CUT); and since Stage 6 a control
;;; construct as positions in the code -- an if-then-else and the four
;;; written as one (ITE), a disjunction (DISJ), the cut after a condition
;;; (CUTC), a conjunction taken apart (CONJ), and the construct's own
;;; `true' and `fail' (TRUE, FAIL) -- each one step, as each was one goal.
;;; Since Stage 7 a core builtin is done where it stands: arithmetic and a
;;; type test as a guard over the slots (GUARD), `=/2', `==/2' and `\==/2'
;;; from two sides read out of the slots (SIDES), and any other with
;;; arguments called by its row with the term built at entry (BUILTIN).
;;; A guard whose program is one fused word (`cc_ufuse') is its own kind
;;; (GUARDX), so that a guard of several words asks nothing more for it.
(DEFPARAMETER *cc-eg-kinds* '(("TERM" 0) ("CALL" 1) ("CUT" 2) ("ITE" 3) ("DISJ" 4)
                              ("CUTC" 5) ("CONJ" 6) ("TRUE" 7) ("FAIL" 8)
                              ("GUARD" 9) ("SIDES" 10) ("BUILTIN" 11) ("GUARDX" 12)))

(DEFUN cc-eg-number (name)
  (LET ((row (ASSOC name *cc-eg-kinds* :TEST #'STRING=)))
    (UNLESS row (ERROR "cocolog: no later-goal kind ~S" name))
    (SECOND row)))

(DEFMACRO cc-eg (name) (cc-eg-number name))


;;; THE HEAD PROGRAM, WRITTEN ONCE AND RUN TWO WAYS: over a call that is a
;;; term, whose argument I is the cell after its header (`cc-arg-term'),
;;; and over a call that never was one, its arguments in the engine's
;;; registers (`cc-arg-reg', Stage 3 of compiled control). A macro rather
;;; than a branch per instruction, so neither way pays for the other.
(DEFMACRO cc-arg-term (I) `(+ call (+ ,I 1)))
(DEFMACRO cc-arg-reg (I) `(nth ,I args))
(DEFMACRO cc-head-program (ARGAT)
  `(while (and ok (< pc (-> cd hlen)))
     (let ((u64 w . #'(nth pc (-> cd head))))
       (set pc (+ pc 1))
       (switch (cast int (cc_op w))
         (case (cc-op "GET_VAR")
           (set (nth (cc_k w) frame) (coco_deref m (,ARGAT (cast size_t (cc_n w)))))
           break)
         (case (cc-op "GET_VAL")
           (if (not (coco_unify m (nth (cc_k w) frame) (,ARGAT (cast size_t (cc_n w)))))
               (set ok 0))
           break)
         (case (cc-op "GET_CONST")
           (let ((u64 c . #'(nth pc (-> cd head))))
             (set pc (+ pc 1))
             (if (not (cc_match_const m (coco_deref m (,ARGAT (cast size_t (cc_n w)))) c))
                 (set ok 0)))
           break)
         (case (cc-op "GET_STRUCT")
           ;; the argument index is in K, the arity in N
           (let ((u64 fid . #'(nth pc (-> cd head)))
                 (u32 n . #'(cast u32 (cc_n w)))
                 (size_t a . #'(coco_deref m (,ARGAT (cc_k w)))))
             (set pc (+ pc 1))
             (let ((u64 ca . #'(nth a (-> m heap))))
               (cond
                 ((coco-tag-is REF ca)
                  ;; WRITE: the structure is built and the variable bound to it
                  (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN fid) n)))
                    (coco_bind m a h)
                    (set S (+ h 1))
                    (set write 1)))
                 ((and (coco-tag-is FUN ca) (== (coco-payload ca) fid))
                  (set S (+ a 1))
                  (set write 0))
                 (#t (set ok 0)))))
           break)
         (case (cc-op "GET_STRUCT_T")
           ;; the temporary is in K, the arity in N
           (let ((u64 fid . #'(nth pc (-> cd head)))
                 (u32 n . #'(cast u32 (cc_n w)))
                 (size_t a . #'(coco_deref m (nth (cc_k w) frame))))
             (set pc (+ pc 1))
             (let ((u64 ca . #'(nth a (-> m heap))))
               (cond
                 ((coco-tag-is REF ca)
                  (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN fid) n)))
                    (coco_bind m a h)
                    (set S (+ h 1))
                    (set write 1)))
                 ((and (coco-tag-is FUN ca) (== (coco-payload ca) fid))
                  (set S (+ a 1))
                  (set write 0))
                 (#t (set ok 0)))))
           break)
         (case (cc-op "UNIFY_VAR")
           ;; write: the slot IS the variable, and is written as one
           (if write
               (block (set (nth S (-> m heap)) (coco-cell REF S))
                      (set (nth (cc_k w) frame) S))
               (set (nth (cc_k w) frame) (coco_deref m S)))
           (set S (+ S 1))
           break)
         (case (cc-op "UNIFY_VAL")
           (if write
               (coco_set_arg m S (coco_deref m (nth (cc_k w) frame)))
               (if (not (coco_unify m (nth (cc_k w) frame) S)) (set ok 0)))
           (set S (+ S 1))
           break)
         (case (cc-op "UNIFY_CONST")
           (let ((u64 c . #'(nth pc (-> cd head))))
             (set pc (+ pc 1))
             (if write
                 (coco_set_arg m S (coco_push m c))
                 (if (not (cc_match_const m (coco_deref m S) c)) (set ok 0)))
             (set S (+ S 1)))
           break)
         (default (set ok 0))))))

;;; THE BODY PROGRAM, WRITTEN ONCE AND RUN BY THREE EXECUTORS: the one for a
;;; clause entered with registers (`coco_clause_run_r', Stage 3), the one
;;; for a clause whose body starts with guards (`coco_clause_run_g',
;;; Stage 4) and the one for a body that makes an environment
;;; (`coco_clause_run_e', Stage 5). PROG is the program -- the body, or
;;; an environment's entry program (`xbody') -- START is where the goals
;;; to build begin and END where they stop, and REGSOK whether the first
;;; of them goes into the registers instead. A macro, as the head program
;;; is, so that no executor pays for another.
;;;
;;; EVERY GOAL IS ONE RESERVATION: its GOAL_STRUCT carries the cells the
;;; whole goal takes -- header, slots, every nested structure's and every
;;; constant's -- and reserves them in one growth check; the ARG words that
;;; follow carry the OFFSET from the goal's base of the slot they fill and
;;; of the cell they put there, settled when the clause was compiled, so
;;; each is a store or two with nothing to check and no stack of pending
;;; structures to keep (1.8.46; through 1.8.45 the executor walked a frame
;;; stack to find the next slot and grew the heap per structure, as the
;;; copy does).
;;;
;;; THE FIRST GOAL INTO THE REGISTERS (`rbody'): its own header and slots
;;; are never built, its arguments go to REGS, and what it nests is one
;;; reservation of its own (RGOAL, left out when there is nothing to
;;; reserve) -- then the body goes on from the goal after it (`rstart'). A
;;; LOOP OF ITS OWN, ahead of the body's: one loop over both programs paid a
;;; test for the switch from one to the other at every instruction, and the
;;; register form of `app(T, L, R)' cost more than building the term had.
;;; The ARG words of the register form are the body's own, offset from that
;;; reservation.
(DEFMACRO cc-body-program (PROG START END REGSOK)
  `(if (> (-> cd blen) 0)
      (let ((size_t ng . 0) (size_t h . 0) (u64 * prog . #',PROG))
        (set pc ,START)
        (if ,REGSOK
            (let ((u64 * rp . #'(-> cd rbody)) (size_t rn . #'(-> cd rblen)) (size_t rpc . 0))
              (while (and ok (< rpc rn))
                (let ((u64 w . #'(nth rpc rp)))
                  (set rpc (+ rpc 1))
                  (switch (cast int (cc_op w))
                    (case (cc-op "RARG_VAR")
                      ;; register N: frame[K]
                      (set (nth (cast size_t (cc_n w)) regs) (coco_deref m (nth (cc_k w) frame)))
                      break)
                    (case (cc-op "RGOAL")
                      ;; the arity in K, the cells it nests in N: one
                      ;; reservation, and no header
                      (let ((size_t total . #'(cast size_t (cc_n w))))
                        (set h (-> m heap_len))
                        (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                          (aof (-> m heap_cap)) (+ h total) (sizeof u64)))
                            (block (set ok 0) break))
                        (set (-> m heap_len) (+ h total)))
                      break)
                    (case (cc-op "RARG_CONST")
                      ;; register K: the constant, in cell N of the reservation
                      (let ((u64 c . #'(nth rpc rp))
                            (size_t at . #'(+ h (cast size_t (cc_n w)))))
                        (set rpc (+ rpc 1))
                        (set (nth at (-> m heap)) c)
                        (set (nth (cc_k w) regs) at))
                      break)
                    (case (cc-op "RARG_VAR_1")
                      ;; register N: a fresh variable in the cell the
                      ;; next word names, and frame[K] is it
                      (let ((size_t slot . #'(+ h (cast size_t (nth rpc rp)))))
                        (set rpc (+ rpc 1))
                        (set (nth slot (-> m heap)) (coco-cell REF slot))
                        (set (nth (cc_k w) frame) slot)
                        (set (nth (cast size_t (cc_n w)) regs) slot))
                      break)
                    (case (cc-op "RARG_STRUCT")
                      ;; register K: the structure whose header is cell N
                      (let ((u64 fid . #'(nth rpc rp))
                            (size_t at . #'(+ h (cast size_t (cc_n w)))))
                        (set rpc (+ rpc 1))
                        (set (nth at (-> m heap)) (coco-cell FUN fid))
                        (set (nth (cc_k w) regs) at))
                      break)
                    ;; what the goal nests, as the body's own words
                    (case (cc-op "ARG_CONST")
                      (let ((u64 c . #'(nth rpc rp))
                            (size_t at . #'(+ h (cast size_t (cc_n w)))))
                        (set rpc (+ rpc 1))
                        (set (nth at (-> m heap)) c)
                        (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                      break)
                    (case (cc-op "ARG_VAR")
                      (set (nth (+ h (cast size_t (cc_n w))) (-> m heap))
                           (coco-cell REF (coco_deref m (nth (cc_k w) frame))))
                      break)
                    (case (cc-op "ARG_VAR_1")
                      (let ((size_t slot . #'(+ h (cast size_t (cc_n w)))))
                        (set (nth slot (-> m heap)) (coco-cell REF slot))
                        (set (nth (cc_k w) frame) slot))
                      break)
                    (case (cc-op "ARG_STRUCT")
                      (let ((u64 fid . #'(nth rpc rp))
                            (size_t at . #'(+ h (cast size_t (cc_n w)))))
                        (set rpc (+ rpc 1))
                        (set (nth at (-> m heap)) (coco-cell FUN fid))
                        (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                      break)
                    (default (set ok 0)))))
              (set pc (-> cd rstart))))
        ;; the program's length is its end: no END word to dispatch
        (while (and ok (< pc ,END))
          (let ((u64 w . #'(nth pc prog)))
            (set pc (+ pc 1))
            (switch (cast int (cc_op w))
              (case (cc-op "GOAL_STRUCT")
                (let ((u64 fid . #'(nth pc prog))
                      (size_t total . #'(cast size_t (cc_n w))))
                  (set pc (+ pc 1))
                  (set h (-> m heap_len))
                  (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                    (aof (-> m heap_cap)) (+ h total) (sizeof u64)))
                      (block (set ok 0) break))
                  (set (-> m heap_len) (+ h total))
                  (set (nth h (-> m heap)) (coco-cell FUN fid))
                  (if (< ng 64) (block (set (nth ng goals) h) (set ng (+ ng 1)))))
                break)
              (case (cc-op "GOAL_ATOM")
                (let ((u64 c . #'(nth pc prog)))
                  (set pc (+ pc 1))
                  (if (< ng 64) (block (set (nth ng goals) (coco_push m c)) (set ng (+ ng 1)))))
                break)
              (case (cc-op "GOAL_VAR")
                (if (< ng 64) (block (set (nth ng goals) (coco_deref m (nth (cc_k w) frame)))
                                     (set ng (+ ng 1))))
                break)
              (case (cc-op "GOAL_VAR_1")
                (let ((size_t v . #'(coco_new_var m)))
                  (set (nth (cc_k w) frame) v)
                  (if (< ng 64) (block (set (nth ng goals) v) (set ng (+ ng 1)))))
                break)
              (case (cc-op "ARG_CONST")
                ;; the constant in its own cell, the slot pointing at it
                (let ((u64 c . #'(nth pc prog))
                      (size_t at . #'(+ h (cast size_t (cc_n w)))))
                  (set pc (+ pc 1))
                  (set (nth at (-> m heap)) c)
                  (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                break)
              (case (cc-op "ARG_VAR")
                (set (nth (+ h (cast size_t (cc_n w))) (-> m heap))
                     (coco-cell REF (coco_deref m (nth (cc_k w) frame))))
                break)
              (case (cc-op "ARG_VAR_1")
                ;; the slot IS the variable, and is written as one
                (let ((size_t slot . #'(+ h (cast size_t (cc_n w)))))
                  (set (nth slot (-> m heap)) (coco-cell REF slot))
                  (set (nth (cc_k w) frame) slot))
                break)
              (case (cc-op "ARG_STRUCT")
                ;; the header where the compiler placed it; its own
                ;; slots are filled by the words that follow
                (let ((u64 fid . #'(nth pc prog))
                      (size_t at . #'(+ h (cast size_t (cc_n w)))))
                  (set pc (+ pc 1))
                  (set (nth at (-> m heap)) (coco-cell FUN fid))
                  (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                break)
              (case (cc-op "FRESH")
                ;; frame[K] a fresh variable, and no goal: only an
                ;; environment's entry program has these
                (set (nth (cc_k w) frame) (coco_new_var m))
                break)
              (default (set ok 0)))))
        (set (cof ngoals) ng)))
)

;;; AN ENVIRONMENT (Stage 5) is the compound `'$e'(Code, Parent, Barrier,
;;; V1 ... Vn, T1 ... Tm, S1 ... Sj, P1 ... Pk)' at ENV: its code an
;;; integer, the address, which the collector does not follow; the
;;; continuation its body returns to; the barrier its goals cut to; a slot
;;; per variable its later calls read and one per unit built at entry as a
;;; term; a condition slot per if-then-else (Stage 6), the height its
;;; choice went in at, written by its step; and a POS cell for each unit,
;;; the I'th, from 1, saying how far back the header is (over bit 16) and I
;;; (under it). A continuation that names a POS cell is that environment
;;; about to reach that unit, and needs no field of its own anywhere: a
;;; `'$k'' frame's rest, a choice frame, the engine's `goals', the parent
;;; of another environment each hold it in the one cell they always had.
(DEFMACRO coco-env-code (m env)
  `(cast (coco_code *) (cast size_t (coco-signed-payload (nth (+ ,env 1) (-> ,m heap))))))
(DEFMACRO coco-env-barrier (m env)
  `(cast size_t (coco-signed-payload (nth (+ ,env 3) (-> ,m heap)))))
;;; condition slot S's cell, and unit U's position, in the environment at
;;; ENV whose code is CD
(DEFMACRO coco-env-slot-at (env cd s)
  `(+ ,env (+ (+ (+ (cast size_t (-> ,cd nes)) (cast size_t (-> ,cd nterm))) 4) (cast size_t ,s))))
(DEFMACRO coco-env-pos (env cd u)
  `(+ ,env (+ (+ (+ (+ (cast size_t (-> ,cd nes)) (cast size_t (-> ,cd nterm)))
                    (cast size_t (-> ,cd nslot))) 3) (cast size_t ,u))))

;;; AN ENVIRONMENT'S SLOT K: the variable a later call reads where the body
;;; program read the frame. EB is the first slot's cell, four after the
;;; header. Dereferenced for the registers (`coco_env_regs'), as the body
;;; program writes them; ONE LINK for a term (`coco_env_term'), which is
;;; then the term entering the clause would have built -- its argument the
;;; variable as it stood at entry, not what it is bound to now, which is
;;; what a freeze needs of a goal a choice frame will come back to.
(DEFMACRO cc-env-slot (K) `(coco_deref m (+ eb (cast size_t ,K))))
(DEFMACRO cc-env-slot1 (K) `(cast size_t (coco-payload (nth (+ eb (cast size_t ,K)) (-> m heap)))))

;;; THE LATER GOALS AT ENTRY, AND THE ENVIRONMENT (Stage 5): the entry
;;; program over the frame -- each later goal that is a term built as it
;;; always was, its root kept, and each variable a later call meets first
;;; made, all in goal order -- then the environment in ONE reservation:
;;; its header, its code, the continuation the body returns to and its
;;; goals' barrier (ER), a slot per variable the calls read (each the
;;; frame's, `einit'), one per term, and the positions. ER answers the
;;; first position, the continuation after the first goal. The entry
;;; program runs the body program's own words, its roots collected in
;;; TROOTS where the body's go to GOALS.
(DEFMACRO cc-env-entry ()
  `(let ((size_t troots [64]) (size_t nt . 0))
     (let ((size_t * goals . troots) (size_t * ngoals . #'(aof nt)))
       (cc-body-program (-> cd xbody) 0 (-> cd xblen) 0))
     (if ok
         (let ((size_t nes . #'(cast size_t (-> cd nes)))
               (size_t ntm . #'(cast size_t (-> cd nterm)))
               (size_t nsl . #'(cast size_t (-> cd nslot)))
               (size_t npos . #'(cast size_t (-> cd nunit)))
               (size_t eh . #'(-> m heap_len))
               (size_t ps . 0))
           ;; the first position's distance from the header
           (set ps (+ (+ (+ nes ntm) nsl) 4))
           (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                               (aof (-> m heap_cap)) (+ eh (+ ps npos)) (sizeof u64)))
               (set ok 0)
               (block
                (set (-> m heap_len) (+ eh (+ ps npos)))
                (set (nth eh (-> m heap)) (coco-cell FUN (-> cd efid)))
                (set (nth (+ eh 1) (-> m heap)) (coco-int-cell (cast i64 (cast size_t cd))))
                (set (nth (+ eh 2) (-> m heap)) (coco-cell REF (coco_deref m (-> er parent))))
                (set (nth (+ eh 3) (-> m heap)) (coco-int-cell (cast i64 (-> er barrier))))
                (for ((size_t s . 0)) (< s nes) ((++ s))
                  (set (nth (+ eh (+ s 4)) (-> m heap))
                       (coco-cell REF (coco_deref m (nth (cast size_t (nth s (-> cd einit))) frame)))))
                (for ((size_t s . 0)) (< s ntm) ((++ s))
                  (set (nth (+ eh (+ nes (+ s 4))) (-> m heap))
                       (coco-cell REF (coco_deref m (nth s troots)))))
                ;; the condition slots and the positions, alike in every
                ;; environment of this code: one block (`etmpl')
                (memcpy (cast (void *) (aof (nth (+ eh (+ (+ nes ntm) 4)) (-> m heap))))
                        (cast (const void *) (-> cd etmpl)) (* (+ nsl npos) (sizeof u64)))
                (set (-> cd envd) 1)
                (set (-> er next) (+ eh (+ ps (- (cast size_t (-> cd eu0)) 1))))))))))

;;; THE GUARDS' RUNNER, WRITTEN ONCE AND EMITTED THREE TIMES (Stage 6): the
;;; body of `cc_guards_run', for the guards' own executor, and of
;;; `cc_guards_run_e', for the one that makes an environment after them,
;;; each a static function with one caller, which the compiler keeps
;;; inline there; and since Stage 7 of `coco_env_guard', for one goal of an
;;; environment. One function called from two executors became a call of
;;; its own, and cost the counting loop 6 instructions a turn (Stage 5's
;;; first form). The body and not the function, because an attribute
;;; written before a macro that makes a function does not reach it: the
;;; two came out with `(static)' lost, and called.
;;;
;;; RUNS THE GUARDS (PROG, LEN words of it), at most BUDGET goals of them,
;;; over the variables VARAT reaches by number: the frame the head filled
;;; (`cc-frame-var'), or an environment's slots (`cc-env-slot', ENV 1,
;;; whose programs have no AG_ISF: a variable a guard there meets first
;;; was made with the environment, and is bound by AG_ISV). Answers how
;;; many ran to the end; FAILED is set when the next one failed -- the
;;; clause fails, its bindings left for the caller's marks. A goal this
;;; cannot decide -- a variable not bound to an integer, a zero divisor,
;;; anything the step would raise for or answer a float to -- stops the
;;; run BEFORE it has done anything, and that goal and the rest are built
;;; and stepped as they always were.
;;; Every value is computed with the C `coco_arith' uses for it, and a
;;; result is compared with or bound to the left of an `is' as the cell
;;; `coco_new_int' makes of it, which is what `coco_unify' compares.
(DEFMACRO cc-frame-var (K) `(coco_deref m (nth ,K frame)))
(DEFMACRO cc-guards-body (PROG LEN VARAT ENV)
  `      (let ((i64 sk [16]) (u32 sp . 0) (u32 done . 0) (size_t pc . 0)
            (u64 * p . #',PROG) (size_t len . #',LEN))
        (set (cof failed) 0)
        (if (== budget 0) (return 0))
        (while (< pc len)
          (let ((u64 w . #'(nth pc p)) (int fin . 0) (int pass . 1))
            (set pc (+ pc 1))
            (switch (cast int (cc_op w))
              (case (cc-op "AG_LOAD")
                (let ((u64 c . #'(nth (,VARAT (cc_k w)) (-> m heap))))
                  (if (not (coco-tag-is INT c)) (return done))
                  (set (nth sp sk) (coco-signed-payload c))
                  (set sp (+ sp 1)))
                break)
              (case (cc-op "AG_PUSH")
                (set (nth sp sk) (coco-signed-payload (nth pc p)))
                (set pc (+ pc 1))
                (set sp (+ sp 1))
                break)
              (case (cc-op "AG_BIN")
                (let ((i64 a . #'(nth (- sp 2) sk)) (i64 b . #'(nth (- sp 1) sk)) (i64 r . 0)
                      (int ovf . 0))
                  (switch (cast int (cc_k w))
                    ;; in 64 bits, and a result past them is the step's to
                    ;; raise (2.0.0: evaluation_error(int_overflow))
                    (case (cc-gop "+") (if (coco_add_ovf a b (aof r)) (return done)) break)
                    (case (cc-gop "-") (if (coco_sub_ovf a b (aof r)) (return done)) break)
                    (case (cc-gop "*") (if (coco_mul_ovf a b (aof r)) (return done)) break)
                    ;; the least integer over -1 is past 64 bits, and in C
                    ;; traps (SIGFPE), as its remainder does: asked first
                    (case (cc-gop "//")
                      (if (== b 0) (return done))
                      (if (== b -1)
                          (block (if (== a (- -9223372036854775807 1)) (return done))
                                 (set r (- 0 a)) break))
                      (set r (/ a b)) break)
                    (case (cc-gop "div")
                      (if (== b 0) (return done))
                      (if (== b -1)
                          (block (if (== a (- -9223372036854775807 1)) (return done))
                                 (set r (- 0 a)) break))
                      (set r (- (/ a b) (cc_floor_adjusts a b))) break)
                    (case (cc-gop "mod")
                      (if (== b 0) (return done))
                      (if (== b -1) (block (set r 0) break))
                      (set r (+ (% a b) (? (cc_floor_adjusts a b) b 0))) break)
                    (case (cc-gop "rem")
                      (if (== b 0) (return done))
                      (if (== b -1) (block (set r 0) break))
                      (set r (% a b)) break)
                    (case (cc-gop "min") (set r (? (< a b) a b)) break)
                    (case (cc-gop "max") (set r (? (> a b) a b)) break)
                    ;; by any count, as `coco_arith' does (1.14.0): a C shift
                    ;; is undefined past 63 and for a negative count, and the
                    ;; hardware takes the count modulo 64; a bit lost to the
                    ;; left is the step's to raise (2.0.0)
                    (case (cc-gop ">>")
                      (set r (coco_shift_right a b (aof ovf)))
                      (if ovf (return done)) break)
                    (case (cc-gop "<<")
                      (set r (coco_shift_left a b (aof ovf)))
                      (if ovf (return done)) break)
                    (case (cc-gop "bitand") (set r (bitand a b)) break)
                    (case (cc-gop "bitor") (set r (bitor a b)) break)
                    (case (cc-gop "xor") (set r (xor a b)) break)
                    (default (return done)))
                  (set sp (- sp 1))
                  (set (nth (- sp 1) sk) r))
                break)
              (case (cc-op "AG_UN")
                (let ((i64 a . #'(nth (- sp 1) sk)) (i64 r . 0))
                  (switch (cast int (cc_k w))
                    ;; the least integer has no negation in 64 bits: the
                    ;; step raises (2.0.0)
                    (case (cc-gop "neg")
                      (if (== a (- -9223372036854775807 1)) (return done))
                      (set r (- 0 a)) break)
                    (case (cc-gop "pos") (set r a) break)
                    (case (cc-gop "bitnot") (set r (- -1 a)) break)
                    (case (cc-gop "abs")
                      (if (== a (- -9223372036854775807 1)) (return done))
                      (set r (? (< a 0) (- 0 a) a)) break)
                    (case (cc-gop "sign") (set r (? (> a 0) 1 (? (< a 0) -1 0))) break)
                    (default (return done)))
                  (set (nth (- sp 1) sk) r))
                break)
              (case (cc-op "AG_CMP")
                (let ((i64 a . #'(nth (- sp 2) sk)) (i64 b . #'(nth (- sp 1) sk)))
                  (set sp (- sp 2))
                  (switch (cast int (cc_k w))
                    (case (cc-gop "<") (set pass (< a b)) break)
                    (case (cc-gop ">") (set pass (> a b)) break)
                    (case (cc-gop "=<") (set pass (<= a b)) break)
                    (case (cc-gop ">=") (set pass (>= a b)) break)
                    (case (cc-gop "=:=") (set pass (== a b)) break)
                    (case (cc-gop "numneq") (set pass (!= a b)) break)
                    (default (return done))))
                (set fin 1)
                break)
              ;; A RESULT THE 60 BITS OF A CELL CANNOT HOLD IS THE STEP'S TO
              ;; BOX (2.0.0): the guard stops before it has bound or compared
              ;; anything, and makes no call that boxing would cost every
              ;; guard's registers
              (case (cc-op "AG_ISF")
                ;; met first here: the frame slot IS the result
                ,@(COPY-TREE
                   (IF (EQL ENV 1)
                       '((return done))
                       '((set sp (- sp 1))
                         (if (not (coco-fits-cell (nth sp sk))) (return done))
                         (set (nth (cc_k w) frame) (coco_push m (coco-int-cell (nth sp sk))))
                         (set fin 1)
                         break))))
              (case (cc-op "AG_ISV")
                ;; met before: bound to the result, or compared with it
                (let ((size_t v . #'(,VARAT (cc_k w))) (u64 c . 0))
                  (set sp (- sp 1))
                  (if (not (coco-fits-cell (nth sp sk))) (return done))
                  (set c (nth v (-> m heap)))
                  (cond
                    ((coco-tag-is REF c) (coco_bind m v (coco_push m (coco-int-cell (nth sp sk)))))
                    (#t (set pass (== c (coco-int-cell (nth sp sk)))))))
                (set fin 1)
                break)
              (case (cc-op "AG_ISC")
                ;; an integer on the left: compared
                (let ((u64 c . #'(nth pc p)))
                  (set pc (+ pc 1))
                  (set sp (- sp 1))
                  ;; a constant is a cell's: a result past one is not it
                  (set pass (== c (coco-int-cell (nth sp sk))))
                  (if (not (coco-fits-cell (nth sp sk))) (set pass 0)))
                (set fin 1)
                break)
              (case (cc-op "AG_TYPE")
                ;; as the type-test builtins read their argument
                (let ((u64 c . #'(nth (,VARAT (cc_k w)) (-> m heap))))
                  (switch (cast int (cc_n w))
                    (case (cc-gop "var") (set pass (coco-tag-is REF c)) break)
                    (case (cc-gop "nonvar") (set pass (not (coco-tag-is REF c))) break)
                    (case (cc-gop "atom") (set pass (coco-tag-is ATOM c)) break)
                    (case (cc-gop "integer") (set pass (coco-is-int c)) break)
                    (case (cc-gop "number")
                      (set pass (or (coco-is-int c) (or (coco-tag-is FLT c) (coco-rat-p c)))) break)
                    (case (cc-gop "atomic")
                      (set pass (not (or (coco-tag-is REF c) (coco-tag-is FUN c)))) break)
                    (case (cc-gop "compound") (set pass (coco-tag-is FUN c)) break)
                    (default (return done))))
                (set fin 1)
                break)
              (default (return done)))
            ;; a goal ends here: failed, or done and the budget asked
            (if fin
                (block
                 (if (not pass) (block (set (cof failed) 1) (return done)))
                 (set done (+ done 1))
                 (if (>= done budget) (return done))))))
        (return done)))

(DEFUN cc-op-number (name)
  (LET ((row (ASSOC name *cc-ops* :TEST #'STRING=)))
    (UNLESS row (ERROR "cocolog: no clause opcode ~S" name))
    (SECOND row)))

(DEFMACRO cc-op (name) (cc-op-number name))

(generic decl-kb
  ()

  ;;; One key's clauses: where its chain starts and where it ends, so an
  ;;; `assertz' can be linked on in constant time. The table these live in is
  ;;; open-addressed and a slot with KEY 0 is an empty one -- which is why the
  ;;; clauses that match ANY key (0 is that key) are not kept in it but in the
  ;;; predicate's own `varhead'/`vartail' pair.
  (struct coco_kslot
    (member u64      key)
    (member size_t   head)
    (member size_t   tail)
    ;; how many clauses the chain holds: with the key-0 count beside it,
    ;; how many candidates a call of this key has -- which is how the
    ;; engine chooses the argument to index on (`coco_pred_select_key')
    (member size_t   count))

  ;;; ANOTHER ARGUMENT'S INDEX, for a call whose first argument cannot
  ;;; choose (`coco_pred_select_key'): the first argument's table again --
  ;;; a key per clause, chains in ascending position, the key-0 clauses
  ;;; apart -- built from the clauses' own heads the first time a call
  ;;; wants it, kept by `assertz', and dropped by whatever renumbers the
  ;;; clauses, as the first argument's is (`coco_pred_unindex').
  (struct coco_argix
    (member u64 *        keys)
    (member size_t       key_cap)
    (member size_t *     chain)
    (member size_t       chain_cap)
    (member coco_kslot * slots)
    (member size_t       nslots)
    (member size_t       varhead)
    (member size_t       vartail)
    (member size_t       nvar)
    (member int          indexed))

  ;;; One predicate: a name, an arity, and the clauses under it in the order
  ;;; they were asserted. `loaded' says the fetch hook has already been asked
  ;;; about this predicate, so a predicate that genuinely has no clauses is not
  ;;; re-fetched on every call.
  (struct coco_pred
    (member u64      name)
    (member u32      arity)
    ;; THE COUNT A PROBE READS: `nclauses' while no clause is dead, 0 while
    ;; one is (or past 32 bits), so the probe's one test of its count also
    ;; sends a predicate with dead clauses out of line (`coco_pred_probe').
    ;; Kept by `coco_pred_nprobe' after every write of `nclauses' or `ntomb'.
    ;; In the hole after ARITY: no other member moves.
    (member u32      nprobe)
    (member size_t * clauses)          ; indices into the store's cells
    (member size_t   nclauses)
    (member size_t   clause_cap)
    ;; WHERE EACH CLAUSE CAME FROM, parallel to CLAUSES: the interned real
    ;; path of the file that consulted it PLUS ONE -- atom 0 is a real
    ;; atom, and under `run' it is the file's own path, the first thing a
    ;; fresh machine interns -- or 0 for a clause a running program
    ;; asserted, a module's Coco half, or a row that never said. Consulting
    ;; a file again REPLACES the clauses that carry its name and touches
    ;; nothing else -- so a second `run' against the same store holds one
    ;; copy of the program, not two, and what the program asserted stays.
    (member u64 *    origins)
    (member size_t   origin_cap)
    ;; WHETHER A MODULE PUT THIS CLAUSE HERE, parallel to CLAUSES, and the
    ;; only thing that tells a library's clause from the program's once both
    ;; are in one predicate. `origins' cannot: a tier-2 library is consulted
    ;; from a real file and its clauses carry that file's path exactly as a
    ;; program's do, while a compiled-in module's carry 0 exactly as an
    ;; `assertz' does. What is common to every library clause and to no
    ;; program clause is that the store was MUTED when it arrived.
    ;;
    ;; The backend reads it. `coco_zg_sync_pred' rewrites a dirty predicate
    ;; WHOLESALE, and without this it wrote the module's own clauses into the
    ;; knowledge base beside the program's: one `assertz(member(foo,[a]))'
    ;; left THREE rows, and every later process fetched library(lists)'s two
    ;; on top of the copy it already had -- `member(X,[p,q])' answering
    ;; [p,q,q,p,q,q]. Muted clauses never write through, so they must never
    ;; be written back either.
    (member int *    muted)
    (member size_t   muted_cap)
    ;; EACH CLAUSE'S COMPILED PROGRAM, parallel to CLAUSES: the `coco_code'
    ;; the store's code table holds for that clause, or nil until the clause
    ;; is first tried (1.8.46). A call read the table by the clause's cell --
    ;; a hash, a probe and two calls -- on every inference; this is one load.
    ;; The table stays the owner: an entry here is a copy of its pointer,
    ;; moved with the clause when the list shifts (asserta, retract, a
    ;; reconsult), dropped when the clause is (its program is freed), and
    ;; cleared with the table when the store compacts (every cell moved).
    (member void **  codes)
    (member size_t   codes_cap)
    (member int      dynamic)
    (member int      loaded)
    ;; The backend was asked about this predicate and added NOTHING. Kept per
    ;; predicate rather than re-derived, because the only moment it can be seen
    ;; is the fetch itself -- afterwards a predicate with the module's own
    ;; clauses in it looks the same either way. `coco_store_prewarm' reads it.
    (member int      empty_fetch)
    ;; THE DECLARATIONS WERE ASKED FOR WHILE RESOLVING THIS PREDICATE, and the
    ;; answer is not asked for twice. `coco_store_warm' fetches the whole
    ;; knowledge base's `:- dynamic' rows, and the engine calls it on the path
    ;; that is about to raise `existence_error' -- so that a predicate another
    ;; process declared and never wrote to is found rather than refused. That
    ;; path was assumed never to run in a loop and it does: a caller that
    ;; CATCHES the error and asks again pays the whole warm every time.
    ;; Measured on a 400 MB embedded store, ten raises of one unknown
    ;; predicate: 2.57 s, against 0.000 s for a predicate declared dynamic.
    ;; Per predicate rather than per store, so a declaration another process
    ;; makes is still found for every name this one has not yet asked about.
    (member int      warmed)
    ;; Came from a MODULE's Coco half rather than from the program. `listing'
    ;; with no argument skips these -- a person listing what they wrote does
    ;; not want the library back -- while `listing(Name)' still shows them,
    ;; because asking for one by name is asking about it specifically.
    (member int      library)
    ;; ...UNLESS THE MODULE IS A FILE OF THE PROGRAM'S OWN (1.10.28): `-s
    ;; FILE', ensure_loaded/1 and use_module/1 of a path load the program
    ;; as a module, muted like a library's and `library' for the pre-warm,
    ;; and `listing/0', current_predicate/1 and predicate_property/2 count
    ;; it as the program's, as SWI does. Through 1.10.27 they did not
    ;; (reported from cicili-lang).
    (member int      own)

    ;; ---- first-argument indexing ------------------------------------
    ;;
    ;; WITHOUT IT A CALL WALKS THE PREDICATE, and the walk is not a cheap
    ;; one: each clause is COPIED onto the heap with fresh variables and
    ;; unified against the goal, and both are thrown away when the head did
    ;; not match. For a table of facts that is the entire cost -- a thousand
    ;; probes over 200 facts spent them on 199 copies apiece -- and it grows
    ;; with the table: measured against a hash at three sizes, 7x at 200
    ;; facts, 49x at 2000, 411x at 20000. A ratio that grows is the
    ;; signature of a linear scan rather than of a slow interpreter.
    ;;
    ;; KEYS is parallel to CLAUSES and holds each clause head's first
    ;; argument AS A CELL. The cell rather than a hash of it, because every
    ;; term that can be discriminated on already has a canonical machine
    ;; word: an ATOM cell is its interned id, an INT cell is its value, a
    ;; FUN cell is its interned functor. Two heads with the same cell have
    ;; the same principal functor, which is the only question an index of
    ;; this kind answers -- and two with different non-zero cells CANNOT
    ;; unify, which is what makes skipping them sound.
    ;;
    ;; ZERO IS "MATCHES ANYTHING", and five things take it: an unbound
    ;; first argument, a FLOAT (two equal floats may sit at two indices of
    ;; the float table, so a cell comparison would answer no to 1.0 against
    ;; 1.0), a STRING for the same reason -- its table is not interned
    ;; either, and until this was written `p("ab")' as a head could not be
    ;; found by `p("ab")' as a call -- an integer past 60 bits, boxed in a
    ;; table that is not interned either (2.0.0), and a predicate of arity
    ;; zero. No real
    ;; cell is zero: every tag but REF is non-zero in the low bits and a REF
    ;; is never stored here.
    ;;
    ;; CHAIN is parallel too and threads the clauses of one key together in
    ;; ascending position, so selection walks only the candidates and
    ;; `clause_ix' STAYS AN ORDINAL -- which is what a frozen machine's
    ;; choice frame holds (lib/state.cicili), and it must go on meaning what
    ;; it meant.
    ;;
    ;; INDEXED says the table agrees with the clause list. `assertz' keeps
    ;; it agreeing for nothing; `asserta' and `retract' renumber every
    ;; clause after them, so they clear it and the next call that wants the
    ;; index rebuilds it.
    (member u64 *    keys)
    (member size_t   key_cap)
    (member size_t * chain)
    (member size_t   chain_cap)
    (member coco_kslot * slots)
    (member size_t   nslots)           ; a power of two; 0 = no table yet
    (member size_t   varhead)          ; the key-0 clauses, tried whatever
    (member size_t   vartail)          ;   the call's own key is
    (member size_t   nvar)             ;   and how many there are
    (member size_t   kmax)             ; the most clauses one key's chain holds
    (member int      indexed)
    ;; THE OTHER ARGUMENTS' INDEXES, the second to the eighth, one
    ;; `coco_argix' each, made at the first call that wants one: a call
    ;; whose first argument is unbound, or keyed on a value most clauses
    ;; share, is indexed on the bound argument that leaves the fewest
    ;; candidates -- `edge(X, b)', or `word(es, casa, M)' in a table of
    ;; one language. nil until then.
    (member coco_argix * aix)

    ;; ---- the logical update view (ISO's, swipl's) ---------------------
    ;;
    ;; A CALL SEES THE CLAUSES THAT STOOD WHEN IT BEGAN. Its choice frame
    ;; keeps the clause count of that moment (`cend', lib/solve.cicili), so
    ;; an assertz made while it is open is beyond it, and an asserta moves
    ;; it on a clause (`coco_frames_on'). A RETRACT WHILE A CALL ON THIS
    ;; PREDICATE IS OPEN TAKES NOTHING OUT: the clause stays where it is,
    ;; DEAD, its slot in TOMB the death it was, counted in TERA -- and
    ;; each frame open then that had lived through none keeps it as the
    ;; first (`fera', `coco_frames_on'), so the dead a frame may still try
    ;; are the ones from its first on, and a new call tries none. Kept at
    ;; the death and not at the push: a push is every call that leaves a
    ;; choice, a death under an open call is rare. The dead go when no
    ;; frame on the predicate is left (`coco_pred_sweep'), which sets TERA
    ;; back to 0: at the next change of it, at a new call now and then, and
    ;; when a query starts with nothing running. Through 2.2.5 a retry read
    ;; the live list, and a retract under an open call moved the clauses it
    ;; had still to try. TOMB is parallel to CLAUSES when it is not nil,
    ;; and nil whenever NTOMB is 0. Everything that reads the clause list
    ;; as the predicate's clauses skips a slot `coco_pred_dead' names.
    (member u32 *    tomb)
    (member size_t   tomb_cap)
    (member size_t   ntomb)
    (member u32      tera)
    ;; new calls that met the dead, counted to ask now and then whether
    ;; they may go (`coco_pred_probe_dead'), and whether the predicate is
    ;; on the store's list of those with dead clauses (`tpreds')
    (member u32      tprobe)
    (member int      tlisted)
    ;; A CLAUSE FRAME MAY BE OPEN ON IT: set by every push of one, and
    ;; cleared by a walk of the frames that found none (`coco_frames_on'),
    ;; so a predicate no call left a choice on -- a counter, a flag --
    ;; walks no frames when it is changed
    (member int      framed)
    ;; WHERE THE LAST LIVE CLAUSE ASKED FOR BY ITS ORDINAL WAS (`clause/2'
    ;; reads them so, `coco_pred_live_at'): the LORDth live one at LPOS, as
    ;; long as LVER is TVER, which every change of the clause list or of a
    ;; clause's life moves on -- so an enumeration with dead clauses about
    ;; takes a step a clause and not a walk
    (member u32      tver)
    (member u32      lver)
    (member size_t   lord)
    (member size_t   lpos))

  ;;; Forward-declared, because the two hooks below are members of the store
  ;;; and take a pointer to it -- the typedef has to exist before the struct
  ;;; that carries them is written out.
  (decl) (struct coco_store)

  ;;; ONE GLOBAL VARIABLE, as `nb_setval/2' keeps it: a name and the store
  ;;; CELL holding its value. It lives here rather than in the builtins
  ;;; because the table below belongs to the store -- see `globals'.
  (struct coco_global
    (member u64    name)
    (member size_t cell)
    (member size_t size)               ; cells the value occupies, for the count of the dead
    ;; WHICH SETTING THE VALUE IS (1.12.1), unique in this store (`gver'),
    ;; and whether it is ground: a machine keeps a ground value's copy and
    ;; hands it out shared until the global is set again
    (member u64    ver)
    (member int    ground))

  ;;; A ROOT ARRAY SOMEBODY ELSE OWNS, registered with the store for as long
  ;;; as it holds cell indices: where the array pointer lives, because its
  ;;; owner may grow it, and where its length lives. See `coco_store_compact'.
  (struct coco_rootset
    (member size_t ** cells)
    (member size_t *  len))

  ;;; ONE FILE CONSULTED INTO A STORE (2.13.0): its real path and its
  ;;; time_file/2 when it was read. See `loads'.
  (struct coco_loaded
    (member char *   path)
    (member double   time))

  ;;; The clause store. `cells' is a second flat term array with the same
  ;;; encoding as the heap -- it shares the machine's atom and functor tables,
  ;;; so an atom id means the same thing in both.
  (struct coco_store
    (member u64 *     cells)
    (member size_t    len)
    (member size_t    cap)
    ;; `len' at the last compaction, when every cell was live -- the
    ;; growth since is what `coco_store_maybe_compact' measures -- and
    ;; the root arrays other callers hold at the moment, a stack. See
    ;; `coco_store_compact'.
    (member size_t    mark)
    ;; how many compactions this store has run, for `statistics/2'
    (member size_t    ncompacts)
    ;; cells known to be orphans since then, counted where a death is cheap
    ;; to see; a heuristic, so it may overcount and never has to be exact
    (member size_t    dead)
    (member coco_rootset * roots)
    (member size_t    nroots)
    (member size_t    root_cap)

    ;; `nb_setval/2's GLOBALS, AND THEY LIVE HERE BECAUSE A CELL DOES. An
    ;; entry holds an index into `cells' above, which means nothing to any
    ;; other store -- so a table shared between stores hands one store's
    ;; index to another: garbage when it lands in range, SIGSEGV when it
    ;; does not. That was the bug, reported from a running game as an
    ;; intermittent crash with `coco_store_get_node' under `coco_b_getval'
    ;; on the faulting stack, and reproduced as a nested `run_isolated/2'
    ;; answering a clause term where an integer had been stored.
    ;;
    ;; PUTTING THE TABLE IN THE STORE IS WHAT FIXES IT, and three other
    ;; things fall out. It cannot be raced: every store belongs to one
    ;; thread, where a file-scope table is appended to by all of them at
    ;; once -- eight threads writing 800 globals each ABORTED the process
    ;; on an unguarded `realloc', measured. It cannot leak: the entries go
    ;; with `coco_store_free', where a shared table kept a row per store
    ;; that ever set a global, for ever. And the scan stays short: it walks
    ;; this store's names, not every name every store ever used.
    ;;
    ;; THE STORE AND NOT THE ENGINE, deliberately: a negation runs its goal
    ;; in a sub-engine that SHARES this store, so hanging them off the
    ;; engine would lose every `nb_setval/2' made inside a `forall/2'.
    (member coco_global * globals)
    (member size_t    nglobals)
    (member size_t    gcap)
    ;; AND THEY ARE FOUND BY NAME THROUGH A HASH (1.9.4): an open table of
    ;; an entry's index plus one, kept under half full -- see
    ;; `coco_global_find' in lib/builtins.cicili, its only reader
    (member size_t *  gbuckets)
    (member size_t    gbucket_cap)
    ;; the last version a setting of a global took (1.12.1)
    (member u64       gver)
    ;; whether the last put met a variable (1.12.1): a ground value is one
    ;; a machine may keep and hand out shared, and the put knows it free
    (member int       put_vars)

    (member coco_pred * preds)
    (member size_t    npreds)
    (member size_t    pred_cap)
    ;; THE PREDICATES WITH DEAD CLAUSES (`tomb' on the predicate), by index,
    ;; for the sweep a query makes when it starts with nothing running
    (member size_t *  tpreds)
    (member size_t    ntpreds)
    (member size_t    tpred_cap)
    ;; which store this is, for a cache keyed by store: a number no store
    ;; made in this process before it had, given at init (`coco_store_init')
    (member u64       serial)
    ;; compiled clauses by clause cell: open addressing, a key is the cell
    ;; plus one, 0 is empty -- see `coco_clause_code'
    (member size_t *  code_keys)
    (member void **   code_vals)
    (member size_t    code_cap)
    (member size_t    code_len)
    ;; RETIRED CODES (Stage 5): a dead clause's code that an environment on
    ;; the heap may still name, kept out of the table on a list through its
    ;; `rnext' until a heap collection finds no environment naming it
    ;; (`coco_code_sweep'), a query starts with nothing running, or the
    ;; store is freed. A `coco_code *', which this struct cannot name yet.
    (member void *    retired)
    (member size_t    nretired)
    ;; the table that finds a predicate by name and arity -- the functor
    ;; table's shape, see `coco_pred_find'
    (member size_t *  pred_buckets)       ; open addressing, index+1, 0 is empty
    (member size_t    pred_bucket_cap)

    ;; The backend. Called once per predicate, with the store to fill in;
    ;; answers 1 if it looked (whether or not it found anything) and 0 if it
    ;; could not, with the reason in `fetch_err' and `fetch_oom' set when the
    ;; reason was memory. A fetch that answers 0 is asked again by the next
    ;; call (`coco_pred_ensure'). A null hook is a purely local knowledge base.
    (member func fetch ((coco_store * st) (void * ctx) (u64 name) (u32 arity)) (out int))
    (member void *    ctx)

    ;; THE LONGEST CLAUSE THIS BACKEND CAN HOLD, as canonical text, or 0 for a
    ;; store with no such limit -- a purely local one, which keeps clauses in
    ;; memory and has no row to fit them into.
    ;;
    ;; A ROW MUST FIT IN A PAGE. Zigurat allocates a row inside one page
    ;; (65536 bytes by default since 1.10.0, 8192 before, and a store keeps
    ;; the one it was made on) and throws `allocation overflow' if it will
    ;; not fit, and the throw comes at COMMIT: measured on 8192, a clause of
    ;; 8013 characters stores and one of 8014 does not, and the refusal took
    ;; the WHOLE TRANSACTION with it --
    ;; every clause the process had asserted, the small ones before and after
    ;; the big one included, silently as far as the program could tell,
    ;; because its own `findall' had already answered with all of them in it.
    ;;
    ;; So the length is checked HERE, on the way in, where the clause can
    ;; still be refused one at a time and named. See `coco_assert_from'.
    (member size_t    clause_max)

    ;; Why the last assert was refused, as a sentence, or empty. It is a
    ;; buffer on the store because `coco_assert_from' runs BELOW the engine
    ;; and has no ball to throw: the two callers that do -- `assertz/1' and
    ;; the consult loop -- read it and say so in their own shapes.
    (member char      assert_err [256])

    ;; Why the last module load would not consult, as the consult said it
    ;; -- FILE:LINE:COL and the reason -- or empty (1.11.9). The load runs
    ;; under `use_module' and under the engine's ask, neither of which sees
    ;; the consult's own buffer; each reads this and says it.
    (member char      load_err [512])

    ;; WHY THE LAST READ OF A PREDICATE FROM THE BACKEND FAILED (2.11.1), as
    ;; a sentence, or empty; the predicate it was for; and whether memory
    ;; was what it lacked. `coco_pred_ensure' runs below the engine and has
    ;; no ball to throw, so it leaves the three here for the caller that
    ;; does -- `coco_fetch_error' (lib/solve.cicili) raises
    ;; error(resource_error(knowledge_base), context(Name/Arity, Why)) from
    ;; them, or resource_error(memory). The backend's fetch writes the
    ;; sentence; a fetch that fails without one gets a plain one.
    (member char      fetch_err [256])
    (member size_t    fetch_pi)
    (member int       fetch_oom)

    ;; Set when a clause is asserted, so a backend can write through. Null for
    ;; a store that is not backed by anything.
    (member func on_assert ((coco_store * st) (void * ctx) (size_t clause)) (out int))

    ;; And when one is retracted. It takes the PREDICATE rather than the clause,
    ;; because by the time it runs the clause is no longer in the predicate's
    ;; list and there is nothing left to hand over -- and because a backend that
    ;; stores clauses by ordinal has to rewrite the whole predicate anyway, which
    ;; is what `on_assert' already does.
    ;;
    ;; WITHOUT IT A RETRACT WAS LOCAL. It came out of the store in memory and the
    ;; database never heard: the clause was back the next time the predicate was
    ;; fetched, and no other interpreter ever saw it go. An interpreter that can
    ;; assert into a shared knowledge base and not retract from it is halfway to
    ;; being one.
    (member func on_retract ((coco_store * st) (void * ctx) (size_t pi)) (out int))

    ;; Asks the backend to name every predicate it holds, so that the store
    ;; knows they exist. Null for a store that is not backed by anything, which
    ;; already knows everything it has.
    ;;
    ;; WHAT IT IS FOR IS `listing'. Clauses are fetched a predicate at a time
    ;; and only when something calls one, which is what makes a shared knowledge
    ;; base affordable -- but it also means a fresh interpreter knows of no
    ;; predicate it has not already reached. `listing' asking what there is
    ;; would answer "nothing", which is true of the store and false of the
    ;; knowledge base. It interns names only: what the clauses ARE is still
    ;; nobody's business until somebody calls one.
    (member func warm ((coco_store * st) (void * ctx)) (out int))

    ;; Set when a predicate is declared -- `:- dynamic' and, when there is one,
    ;; whatever else a directive can say about a predicate. It takes the
    ;; predicate rather than the property, because the store's `coco_pred' is
    ;; where the properties are and the backend can read them off it.
    ;;
    ;; A DECLARATION HAS TO OUTLIVE THE PROCESS THAT MADE IT. In a knowledge
    ;; base kept in the interpreter's own memory `:- dynamic' could be a flag on
    ;; a struct, because the program that declared it is the program that runs.
    ;; Here the clauses are shared and the declaration is about them, so an
    ;; interpreter opening the same kb tomorrow has to be told the same thing.
    (member func on_dynamic ((coco_store * st) (void * ctx) (size_t pi)) (out int))

    ;; Asks the backend to reclaim what its deleted rows still hold -- the
    ;; TRUNCATE pass README documents. Null means the arrangement cannot
    ;; vacuum: a purely local store has nothing dead to reclaim, a read-only
    ;; backend may not, and a backed store whose operator did not opt in
    ;; (`--vacuum') keeps the hook cleared -- reclaiming spends the store's
    ;; point-in-time reads, so `vacuum_kb/0' finding null raises
    ;; permission_error rather than quietly doing it. LIVE, when the hook
    ;; answers, is the count of live rows left behind: run it twice and the
    ;; second answer being the same is what says there was nothing left.
    (member func vacuum ((coco_store * st) (void * ctx) (i64 * live)) (out int))

    ;; Tensors: model parameters as rows of one vector field, in the
    ;; cocolog::tensors table -- doubles, not text. Three optional hooks the
    ;; torch module consults through the module API; all three null means
    ;; the arrangement keeps parameters in clause chunks instead, which is
    ;; what --local does by nature and the embedded store does until the
    ;; Cicili MVCCS engine grows a vector column.
    ;;   put:    one piece of the tensor NAME, seq-th of its pieces
    ;;   row:    the seq-th piece back, up to CAP doubles, *N says how many;
    ;;           answers 0 at the first seq that is not there
    ;;   forget: every piece of NAME, before a save writes new ones
    (member func tensor_put ((coco_store * st) (void * ctx) (const char * name)
                             (i64 seq) (const double * v) (u32 n)) (out int))
    (member func tensor_row ((coco_store * st) (void * ctx) (const char * name)
                             (i64 seq) (double * out) (u32 cap) (u32 * n)) (out int))
    (member func tensor_forget ((coco_store * st) (void * ctx)
                                (const char * name)) (out int))

    ;; The connection under the backend, when the backend IS a connection:
    ;; the zigurat client installs this and answers its zg_conn*, so
    ;; library(zigurat) can drive the wire the store already rides --
    ;; commit, rollback, isolation, a procedure call -- without a hook per
    ;; verb. Null under --local (there is no connection) and under the
    ;; Zeytun reader (one HTTP request is one transaction; nothing to
    ;; steer). Opaque here on purpose: the store knows nothing of what a
    ;; zg_conn is, exactly as ctx is opaque.
    (member func conn ((coco_store * st) (void * ctx)) (out void *))

    ;; WHAT A HALT DURING A LOAD FINISHES before the process ends: a halt in
    ;; a directive's goal or an initialization goal, or `initialization(G,
    ;; main)' done (`coco_halt_load'). The run's writes become durable at
    ;; the commit its host makes AFTER the goal it was given, and an exit
    ;; from inside the load never got there: measured under --embed, every
    ;; one of those halts kept nothing, with exit 0 and an empty stderr.
    ;; This commits them (KEEP) or rolls them back, closes what the store
    ;; rides on and answers the exit status -- CODE, or what a failed commit
    ;; makes it. Null where there is nothing to finish, or where finishing
    ;; is not this store's to do: --local, a thread's store, a machine's turn
    ;; (whose writes belong with its saved state). The composition root
    ;; installs it for the commands that end in one commit.
    (member func on_halt ((coco_store * st) (void * ctx) (int code) (int keep)) (out int))

    ;; How many MODULES have had their clauses consulted into this store. It
    ;; lives here rather than beside the registry because it is a fact about
    ;; this store and not about the build: `coco_store_reset' -- which is what
    ;; thawing a machine does -- takes the clauses with it, and the count going
    ;; back to zero is exactly the statement that they have to be put back.
    (member size_t    libs)

    ;; Non-zero while the store is being filled from something that is not the
    ;; knowledge base -- a module's clauses. See `coco_store_mute'.
    (member int       muted)
    ;; AND 1 WHILE THAT MODULE IS A FILE OF THE PROGRAM'S OWN, loaded by
    ;; its path (`-s', ensure_loaded/1, use_module/1 of a file), not a
    ;; library: its predicates are marked `own' (1.10.28).
    (member int       ownload)

    (member int       oom)
    ;; a growth given less than it asked (`coco_store_grow', 1.10.28)
    (member int       memreq)
    ;; THE MACHINES THAT SHARE THIS STORE (2.7.0): the host's and the green
    ;; threads' while a green world runs; the frame walks visit every one,
    ;; so the logical update view sees a suspended green thread's frames.
    (member void *    machines)
    ;; THE ROOT MACHINE whose name table names this store's predicates. A
    ;; `run_isolated' store is a fresh machine; the global declaration
    ;; cache (`coco_dynamic_known') needs a table to turn a predicate's
    ;; name id back into the string the cache holds. Set by
    ;; `coco_engine_init'; nil where no engine has run -- a bare consult.
    (member void *    name_m)
    ;; A STORE ONLY THIS ENGINE CAN SEE: findall's solutions and a caught
    ;; ball live here, so copying them is not a write to the one shared
    ;; store and does not stop the other workers. It holds terms only --
    ;; no predicates, hooks or globals -- and its growth needs no barrier.
    (member int       private)
    ;; THE FILES CONSULTED INTO THIS STORE (2.13.0) -- by consult/1,
    ;; load_files/2 and `[File]', by `run' and the toplevel -- each with its
    ;; time_file/2 when it was read: what `load_files(F, [if(changed)])'
    ;; compares, and what keeps ensure_loaded/1 from loading a file this
    ;; store already holds as a module beside it, every clause twice. A
    ;; reset takes them with the clauses (`coco_store_free').
    (member coco_loaded * loads)
    (member size_t    nloads)
    (member size_t    load_cap))

  (decl) (func coco_store_init ((coco_store * st)))
  (decl) (func coco_store_free ((coco_store * st)))

  ;;; The files consulted into ST (2.13.0, `loads'): whether the file at
  ;;; real path PATH was, and when it was written then (*T, when T is not
  ;;; null); and the note that it is being read now, its time_file/2 being
  ;;; T -- the time replaced for a file read before. The note answers 0
  ;;; when there was no memory for it.
  (decl) (func coco_store_loaded ((coco_store * st) (const char * path) (double * t)) (out int))
  (decl) (func coco_store_note_load ((coco_store * st) (const char * path) (double t)) (out int))

  ;; Stops the write-through hooks firing, and starts them again. A module's
  ;; clauses belong to the BUILD and not to the knowledge base: written
  ;; through, they would be saved into the shared database, come back on every
  ;; fetch, and be listed as the user's own -- and the next interpreter to open
  ;; the same knowledge base would then hold two copies of the library.
  ;;
  ;; It is a counter and not a flag, so that muting nests.
  (decl) (func coco_store_mute ((coco_store * st)))
  (decl) (func coco_store_unmute ((coco_store * st)))
  (decl) (func coco_store_is_muted ((coco_store * st)) (out int))

  ;; Empties a store of everything it holds and leaves its BACKEND in place.
  ;; What a store contains -- clauses, predicates, cells -- is reloadable; the
  ;; hooks that say where from are configuration, not contents. `coco_thaw' is
  ;; what wants the distinction: a resumed machine has to keep the connection
  ;; it is resuming against.
  (decl) (func coco_store_reset ((coco_store * st)))

  ;;; Moves a term from the machine's heap into the store, and back. Both
  ;;; rename variables consistently -- see coco_varmap in term.cicili.
  (decl) (func coco_store_put ((coco_store * st) (coco_machine * m) (size_t t)) (out size_t))
  (decl) (func coco_g_write_begin ((void * e)) (out int))
  (decl) (func coco_g_write_end () (out void))
  (decl) (func coco_g_write_end_cleanup ((int * began)) (out void))
  (decl) (func coco_store_get ((coco_machine * m) (coco_store * st) (size_t t)) (out size_t))
  ;;; WHAT A PROGRAM PUT, READ BACK (1.10.19): `coco_store_get', and -- once
  ;;; a cyclic term has been put as its factors (`cyc_puts' on the machine)
  ;;; -- those factors made cyclic again (`coco_unfactor'). The readers of
  ;;; a program's terms use it: findall/3's results, nb_getval/2, a thrown
  ;;; ball. A clause is read with `coco_store_get', assert refusing a
  ;;; cyclic one, and so is the compaction, which moves the factors as
  ;;; they are.
  (decl) (func coco_store_read ((coco_machine * m) (coco_store * st) (size_t t)) (out size_t))
  ;;; A TERM COPIED AS ITS BLOCK (1.12.1): T the root of a term the store
  ;;; put in one go, which took SIZE cells from T up (a global's value,
  ;;; `coco_b_global_term'). The put wrote its cells together with nothing
  ;;; else among them, every reference among them pointing at another of
  ;;; them, a variable a cell pointing at itself, and a float or a string
  ;;; indexing the machine's own tables -- so the copy is the block itself,
  ;;; moved: one memcpy, then every REF's payload by the distance. A
  ;;; variable stays one (a fresh one each copy), a DAG stays a DAG, and a
  ;;; cyclic term's factors are bound back as `coco_store_read' binds them.
  ;;; Through 1.12.0 every read walked the term a cell at a time
  ;;; (`coco_store_get_vm'), four times as long for a list of 3 000
  ;;; entries; refused the room, it still does.
  (decl) (func coco_store_read_block ((coco_machine * m) (coco_store * st) (size_t t)
                                      (size_t size)) (out size_t))
  ;;; The same copy, and with it SPAN, the cells the term takes IN THE
  ;;; STORE. The copy is shorter than that by one cell per distinct
  ;;; variable (a variable met first lives in its argument slot on the
  ;;; heap and has a cell of its own in the store), so a caller that
  ;;; counts a dying term dead by copying it asks here, and never reads the
  ;;; heap's length as the span.
  (decl) (func coco_store_get_span ((coco_machine * m) (coco_store * st) (size_t t)
                                    (size_t * span)) (out size_t))
  ;;; The same copy over a variable map the CALLER holds, so two walks can
  ;;; share one renaming: a head matched in place and a body copied after
  ;;; it (`coco_store_unify' below), and `coco_select_clause' in solve.cicili
  ;;; is the one that holds it.
  (decl) (func coco_store_get_vm ((coco_machine * m) (coco_store * st) (size_t t)
                                  (coco_varmap * vm)) (out size_t))
  ;;; UNIFIES A HEAP TERM WITH A STORE TERM WITHOUT COPYING THE STORE TERM.
  ;;; A clause used to arrive on the heap as a fresh copy, head and body,
  ;;; and the copy was thrown away when the head did not match: on naive
  ;;; reverse the copies were 57 % of the interpreter's instructions. This
  ;;; walks the two side by side instead -- a store variable met for the
  ;;; first time is MAPPED to the heap cell it meets (VM, no cell made),
  ;;; met again it is unified with what it was mapped to; a store atom or
  ;;; compound against an unbound heap variable is copied then, and only
  ;;; then, through the same map, so the body copy that follows a match
  ;;; (`coco_store_get_vm' with the same VM) renames consistently. Nothing
  ;;; in the store is ever bound. Answers 1 on success; on failure the
  ;;; bindings made are left for the caller's trail mark to undo, as
  ;;; `coco_unify' leaves them.
  (decl) (func coco_store_unify ((coco_machine * m) (coco_store * st) (size_t a) (size_t s)
                                 (coco_varmap * vm)) (out int))
  ;;; A clause's head and body AS STORE INDICES, without copying it: a
  ;;; `:-'/2 whose name is NECK (the interned `:-') splits, anything else
  ;;; is a fact and the body is 0.
  (decl) (func coco_store_clause_parts ((coco_store * st) (coco_machine * m) (size_t clause)
                                        (u64 neck) (size_t * head) (size_t * body)))

  ;;; ---- compiled clauses --------------------------------------------------
  ;;;
  ;;; A CLAUSE IS COMPILED THE FIRST TIME IT IS SELECTED, into two programs
  ;;; over a FRAME of its variables: the head's, which unifies the call's
  ;;; arguments with the head -- the WAM's get and unify instructions, with
  ;;; a nested structure flattened through a temporary -- and the body's,
  ;;; which builds the body goals on the heap through the frame, in the
  ;;; order the copy would have walked them, and lists their roots for the
  ;;; continuation. Where the matcher and the copy walked store cells --
  ;;; dereferencing each, testing its tag, probing the variable map for
  ;;; each variable met -- the programs are straight lines: a variable is
  ;;; a frame index, a constant is its cell, a structure its functor and
  ;;; arity.
  ;;;
  ;;; THE FRAME IS NOT A HEAP OBJECT. It lives for the one call that
  ;;; selects the clause: every body goal is built then and pushed on the
  ;;; continuation as before, so a frozen machine carries exactly what it
  ;;; carried -- the same `'$k'' cells, nothing new to thaw -- and a
  ;;; clause asserted or retracted while its body runs cannot move the
  ;;; body under it. This is the compile step's head half and build half;
  ;;; running a body from the store instead of building it would change
  ;;; the continuation's shape, and that is a design decision, not this.
  ;;;
  ;;; THE CODE IS KEYED BY THE CLAUSE'S CELL in a table on the store, and
  ;;; the table is cleared when the store compacts (every cell moves) and
  ;;; freed with the store. A retracted clause's code stays until then,
  ;;; unreachable: a store appends, so its cell is not reused before a
  ;;; compaction. A thawed machine's store is a fresh one, so it compiles
  ;;; afresh. Nothing in the code names a store position -- a constant is
  ;;; the cell itself, a functor its id -- so a compaction cannot stale it.
  ;;;
  ;;; ONE UNIT OF A BODY RUN FROM AN ENVIRONMENT (Stages 5 and 6), what one
  ;;; `'$k'' frame held through 1.9.2: KIND (`cc-eg') says how the step
  ;;; reaches it. A TERM -- a builtin, a construct left a term, a call the
  ;;; registers do not pay for -- was built at entry as it always was, and
  ;;; TSLOT is the environment's slot holding it. A CALL is written into the
  ;;; registers from the environment's variable slots (EBODY[RAT, RAT +
  ;;; RLEN), FID and ARITY its functor), or built from them as a term when
  ;;; its predicate turns out not to be a plain one (EBODY[TAT, TAT +
  ;;; TLEN)). A CUT cuts to its barrier, TRUE goes on and FAIL fails, FID
  ;;; the atom each was written as.
  ;;;
  ;;; THE BUILTINS IN PLACE (Stage 7). A GUARD -- `is/2', a comparison, a
  ;;; type test -- runs its guard program (EBODY[RAT, RAT + RLEN), Stage
  ;;; 4's words over the slots) and builds its term from the slots (TAT,
  ;;; TLEN) only when the program cannot decide; a GUARDX is a GUARD whose
  ;;; program is one fused word and its two operands (AG_ISX, AG_CMPX). A
  ;;; SIDES -- `=/2', `==/2', `\==/2', FORM 0 to 2 -- reads its two
  ;;; arguments out of the slots as a call's register form does (RAT, RLEN,
  ;;; RVARS) and unifies or compares them. A BUILTIN is a TERM whose
  ;;; builtin's row is FORM, called by it.
  ;;;
  ;;; THE CONSTRUCTS (Stage 6). An ITE -- `( C -> T ; E )', `( C -> T )',
  ;;; `\+ C' or `not(C)', `once(C)' and `ignore(C)', which FORM tells apart
  ;;; (0 to 4 in that order), FID and FID2 the functors they were written
  ;;; with -- pushes a choice whose alternative is E, writes the height it
  ;;; pushed it at into condition slot TSLOT, and goes on to C, whose goals
  ;;; cut to that height plus one; the CUTC after C cuts to the height, and
  ;;; T follows. A, B, C and D are the units C, T, E and the CUTC; the
  ;;; forms with no T or E written have a TRUE or FAIL unit for them, as
  ;;; `coco_ite' had `$true' and `$fail'. A DISJ pushes a choice whose
  ;;; alternative is B and goes on to A. A CONJ is a `,' written inside a
  ;;; construct, taken apart in one step into its items A, the next of each
  ;;; in SIB, ARITY of them -- up to 63 and the rest as one, as
  ;;; `coco_k_push_body' takes them. NEXT is the unit after this one, 0 the
  ;;; body's end; BSLOT is the barrier its goals cut to, 0 the
  ;;; environment's and S + 1 condition slot S's (its height, plus one).
  ;;;
  ;;; WHAT TAKING IT READS, as offsets from the environment's header, so a
  ;;; step adds one number where it would add four (`cc_env_offsets'):
  ;;; NOFF the continuation after it, the next unit's position or the
  ;;; parent's cell; BOFF the cell its barrier is read from and BADD what
  ;;; is added to it (the environment's barrier, or a condition's height
  ;;; plus one); SOFF a term's slot (a TERM's or a BUILTIN's), or an
  ;;; if-then-else's and its cut's condition slot; AOFF the position of a
  ;;; construct's first part and COFF of its alternative (an
  ;;; if-then-else's else, a disjunction's right arm). RVARS says a call's
  ;;; arguments are all variables (or a SIDES's two), every word of its
  ;;; register form an RARG_VAR, which a step copies itself.
  (struct coco_egoal
    (member u32 kind)
    (member u32 arity)
    (member u32 tslot)
    (member u32 tat)
    (member u32 tlen)
    (member u32 rat)
    (member u32 rlen)
    (member u64 fid)
    (member u64 fid2)
    (member u32 form)
    (member u32 next)
    (member u32 bslot)
    (member u32 a)
    (member u32 b)
    (member u32 c)
    (member u32 d)
    (member u32 sib)
    (member u32 noff)
    (member u32 boff)
    (member u32 badd)
    (member u32 soff)
    (member u32 aoff)
    (member u32 coff)
    (member u32 rvars))

  ;;; WHAT A CLAUSE ENTRY THAT MAKES AN ENVIRONMENT NEEDS TO KNOW (Stage 5):
  ;;; the continuation the body returns to and its goals' cut barrier, in;
  ;;; the continuation after the first goal, out -- the environment's first
  ;;; position.
  (struct coco_envreq
    (member size_t parent)
    (member size_t barrier)
    (member size_t next))

  (struct coco_code
    (member u64 *  head)
    (member size_t hlen)
    (member u64 *  body)
    (member size_t blen)
    (member u32    nvars)
    (member u32    ngoals)
    ;; THE FIRST GOAL AGAIN, FOR THE REGISTERS (Stage 3): its arguments
    ;; written into the engine's argument registers rather than into a goal
    ;; term -- a structure or a constant among them still built, in one
    ;; reservation, the goal's own header and slots not at all. RSTART is
    ;; where the second goal begins in BODY, RFID and RARITY the first
    ;; goal's functor; RBLEN 0 when the first goal cannot go there (an atom,
    ;; a variable, more arguments than the registers hold).
    (member u64 *  rbody)
    (member size_t rblen)
    (member size_t rstart)
    (member u64    rfid)
    (member u32    rarity)
    ;; THE GUARDS (Stage 4): the arithmetic and type tests the body starts
    ;; with, NGD of them, as one program over a stack of integers (GBODY),
    ;; run when the clause is entered instead of built and stepped through.
    ;; GSTART[I] is where goal I begins in BODY, for I up to NGD: the body
    ;; is built from GSTART[NGD] when every guard ran, and from where the
    ;; first one that could not decide begins otherwise. The register form
    ;; above is then the form of goal NGD, the first that is not a guard.
    (member u64 *  gbody)
    (member size_t gblen)
    (member u32    ngd)
    (member u32    gstart [9])
    ;; THE LATER GOALS, FROM AN ENVIRONMENT (Stages 5 and 6). A body with
    ;; a construct from goal NGD on (its first that is not a guard) runs,
    ;; once that goal is handed over and every guard ran, its ENTRY PROGRAM XBODY --
    ;; the later goals that are terms built as they always were, and the
    ;; variables a later call meets first made, each where the body would
    ;; have made it -- and then writes ONE environment instead of the later
    ;; goals' frames and the calls' terms: `'$e'(Code, Parent, Barrier,
    ;; V1 ... Vn, T1 ... Tm, P1 ... Pk)' (`coco-env-code'), EFID its
    ;; functor, the continuation becoming its first position. ENV says the
    ;; body makes one; V1 ... Vn (NES of them) are the variables the later
    ;; calls read, EINIT[S] the frame index slot S is written from, T1 ...
    ;; Tm (NTERM) the terms the entry program built, in goal order, and P1
    ;; ... Pk a position per later goal. EGOALS[I], for NGD < I < NGOALS,
    ;; is how goal I is reached (`coco_egoal'), the calls' programs in
    ;; EBODY.
    (member u32    env)
    (member u32    nes)
    (member u32    nterm)
    ;; THE UNITS (Stage 6): NUNIT of them in EGOALS[1 ... NUNIT], one
    ;; position each in the environment, and NSLOT condition slots; EU0 is
    ;; the unit the continuation starts at once the clause is entered, and
    ;; EHAND says the first goal is handed over before it, as a clause's
    ;; first goal always was -- 0 when the first goal is itself a unit
    (member u32    nunit)
    (member u32    nslot)
    (member u32    eu0)
    (member u32    ehand)
    (member u32 *  einit)
    (member u64    efid)
    (member coco_egoal * egoals)
    (member u64 *  ebody)
    (member size_t eblen)
    (member u64 *  xbody)
    (member size_t xblen)
    ;; THE TAIL EVERY ENTRY WRITES ALIKE (1.9.4): the NSLOT condition slots,
    ;; zero, then a position per unit -- a distance back to the header and
    ;; a unit number, the same in every environment of this code -- copied
    ;; as one block where the entry wrote them cell by cell
    (member u64 *  etmpl)
    ;; WHAT ENTERING THE CLAUSE TAKES beyond the plain executor: 0 nothing,
    ;; 1 its guards, 2 its environment, 3 both -- so `coco_try_clause' asks
    ;; a plain clause one question, the one it asked through 1.9.2
    (member u32    ex)
    ;; AN ENVIRONMENT HAS NAMED THIS CODE (`envd'), so a clause that dies
    ;; retires it instead of freeing it (`coco_code_drop'); GCMARK is the
    ;; heap collection that last found one naming it, RNEXT the next on the
    ;; store's retired list (a `coco_code *', which this struct cannot name
    ;; inside itself).
    (member u32    envd)
    (member u64    gcmark)
    (member void * rnext)
    ;; set while a compaction keys the table again: a live clause owns it
    (member u32    kept))

  ;;; The clause's code, compiled on the first ask; null when it could not
  ;;; be compiled (out of memory, a head that is not callable), and the
  ;;; caller then matches and copies the store cells as before.
  (decl) (func coco_clause_code ((coco_store * st) (coco_machine * m) (size_t clause))
               (out coco_code *))
  ;;; Runs the clause's code against CALL: the head program, then, when
  ;;; the head matched, the body program, whose goal roots are written to
  ;;; GOALS (at most 64; a longer body ends in one `,' goal the engine
  ;;; takes apart) with their count in NGOALS. Answers 1 on a match, 0
  ;;; when the head did not unify, and -1 when the program could not run
  ;;; (no memory for its frame or its goals) -- the bindings and cells made
  ;;; are left for the caller's marks to undo, as `coco_unify' leaves them.
  (decl) (func coco_clause_run ((coco_machine * m) (coco_store * st) (coco_code * cd)
                                (size_t call) (size_t * goals) (size_t * ngoals)) (out int))
  ;;; The same, two ways more: ARGS, when not nil, are the call's arguments
  ;;; in registers, and CALL is not read; REGS, when not nil and the code
  ;;; has a register form of its first goal (`rblen'), receives that goal's
  ;;; arguments instead of a goal term being built, and GOALS then holds
  ;;; the goals after it.
  (decl) (func coco_clause_run_r ((coco_machine * m) (coco_store * st) (coco_code * cd)
                                  (size_t call) (const size_t * args)
                                  (size_t * goals) (size_t * ngoals) (size_t * regs)) (out int))
  ;;; And for a code with guards (`ngd'): at most BUDGET of them are run,
  ;;; and GDONE says how many were -- each an inference the caller counts,
  ;;; the one that failed included; when fewer than all of them ran, REGS
  ;;; was not written and GOALS starts with the first guard that did not.
  (decl) (func coco_clause_run_g ((coco_machine * m) (coco_store * st) (coco_code * cd)
                                  (size_t call) (const size_t * args)
                                  (size_t * goals) (size_t * ngoals) (size_t * regs)
                                  (u32 budget) (u32 * gdone)) (out int))
  ;;; And for a code with no guards that makes an environment (`env',
  ;;; Stage 5): the head, the first goal -- into REGS or built -- the later
  ;;; goals' entry program, and the environment, as ER asks.
  (decl) (func coco_clause_run_e ((coco_machine * m) (coco_store * st) (coco_code * cd)
                                  (size_t call) (const size_t * args)
                                  (size_t * goals) (size_t * ngoals) (size_t * regs)
                                  (coco_envreq * er)) (out int))
  ;;; And for one whose body starts with guards and makes an environment
  ;;; after them (Stage 6): the guards as above, then the first goal after
  ;;; them and the environment -- or, when fewer than all of them ran, the
  ;;; body built from the one that did not and no environment (ER's next
  ;;; left 0).
  (decl) (func coco_clause_run_ge ((coco_machine * m) (coco_store * st) (coco_code * cd)
                                   (size_t call) (const size_t * args)
                                   (size_t * goals) (size_t * ngoals) (size_t * regs)
                                   (coco_envreq * er) (u32 budget) (u32 * gdone)) (out int))
  ;;; Which builtin a name and arity are, or -1 (lib/solve.cicili): the
  ;;; environment's compiler asks it of a later goal, which a builtin's
  ;;; name keeps a term.
  (decl) (func coco_builtin_index ((coco_machine * m) (u64 nid) (u32 arity)) (out int))
  ;;; The atoms it tells a construct by, from the machine's own vocabulary
  ;;; (lib/solve.cicili), and `'$cut'/1': 1, or 0 before there is one.
  (decl) (func coco_unit_names ((coco_machine * m) (u64 * names) (u64 * fcut)) (out int))
  ;;; GOAL I OF THE ENVIRONMENT AT ENV (whose code is CD), reached: its
  ;;; arguments into REGS (a call, `coco_env_regs'), or its term into OUT
  ;;; (`coco_env_term'). 1, or 0 when the heap would not grow.
  (decl) (func coco_env_regs ((coco_machine * m) (coco_code * cd) (size_t env) (u32 i)
                              (size_t * regs)) (out int))
  (decl) (func coco_env_term ((coco_machine * m) (coco_code * cd) (size_t env) (u32 i)
                              (size_t * out)) (out int))
  ;;; A GUARD OR A SIDES AT UNIT U, done where it stands (Stage 7): the
  ;;; guard's program over the slots -- 1 when it passed, 0 when it did not
  ;;; with FAILED set, or did not decide with FAILED clear -- and the two
  ;;; sides unified or compared -- 1 true, 0 false, -1 the heap would not
  ;;; grow. Static, each with one caller (`coco_env_place' in
  ;;; solve.cicili), and inline there. A GUARDX answers as a GUARD does.
  (static) (decl) (func coco_env_guard ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                                        (int * failed)) (out u32))
  (static) (decl) (func coco_env_guardx ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                                         (int * failed)) (out u32))
  (static) (decl) (func coco_env_sides ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u))
                        (out int))
  ;;; UNIT U OF THE ENVIRONMENT AT ENV as the term its frame held through
  ;;; 1.9.2 (Stage 6, `coco_unit_term'): 1, or 0 when the heap would not grow.
  (decl) (func coco_unit_term ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                               (size_t * out)) (out int))
  ;;; Frees every retired code no environment named in the heap collection
  ;;; EPOCH (`gcmark'), or every one (`coco_code_retired_free').
  (decl) (func coco_code_sweep ((coco_store * st) (u64 epoch)))
  (decl) (func coco_code_retired_free ((coco_store * st)))
  ;;; How many arguments the registers hold.
  (decl) (func coco_regs_max () (out u32))
  (decl) (func coco_code_table_clear ((coco_store * st)))
  ;;; Frees one clause's code, if it has any: called where a clause dies.
  (decl) (func coco_code_drop ((coco_store * st) (size_t clause)))
  ;;; Copies every live term into a fresh cell array and drops the old one;
  ;;; the second asks only when the store has grown enough to be worth it.
  (decl) (func coco_store_compact ((coco_store * st) (coco_machine * m)) (out int))
  (decl) (func coco_store_maybe_compact ((coco_store * st) (coco_machine * m)) (out int))
  ;;; A caller that keeps cell indices in an array of its own says so for as
  ;;; long as it does; a compaction in between rewrites them like any root.
  (decl) (func coco_store_root_push ((coco_store * st) (size_t ** cells) (size_t * len)) (out int))
  (decl) (func coco_store_root_pop ((coco_store * st)))
  ;;; Counts a term the store can no longer reach as dead, by measuring it.
  (decl) (func coco_store_orphan ((coco_store * st) (coco_machine * m) (size_t cell)))

  ;;; The predicate a callable term belongs to, made if it is not there yet.
  ;;; Answers the index, or the store's predicate count if the term is not
  ;;; callable at all.
  (decl) (func coco_pred_of ((coco_store * st) (coco_machine * m) (size_t goal)) (out size_t))
  (decl) (func coco_pred_find ((coco_store * st) (u64 name) (u32 arity)) (out size_t))
  ;; Find or make, by name and arity rather than by a goal term. `coco_thaw'
  ;; needs it: a choice point that was part way through a predicate remembers
  ;; which one by name, because the index depends on the order predicates were
  ;; first mentioned and a machine coming back elsewhere cannot rely on that.
  (decl) (func coco_pred_intern ((coco_store * st) (u64 name) (u32 arity)) (out size_t))

  ;;; Asserts a clause given as a heap term -- `Head' or `Head :- Body'. AT_END
  ;;; is assertz, otherwise asserta. Answers 1, or 0 if the term is not a
  ;;; clause.
  (decl) (func coco_assert ((coco_store * st) (coco_machine * m) (size_t clause) (int at_end)) (out int))

  ;;; A PREDICATE A RE-READ PLACES AS SWI'S RELOAD DOES (2.14.1): the
  ;;; clauses it held when the file's first clause of it came -- O, in
  ;;; order -- and how far the file's clauses have got through them. See
  ;;; `coco_reload_begin' in the implementation.
  (struct coco_reload
    (member size_t   n)              ; O's length
    (member size_t * cell)           ; each one's clause cell
    ;; 0 another's, there (a candidate never); 1 the file's own, taken out
    ;; at the first clause and a candidate; 2 asserted, there and a
    ;; candidate (a read that is not muted adopts one); 3 passed or gone
    (member u8 *     kind)
    (member u64 *    hash)           ; a candidate's shape (`coco_reload_hash')
    (member size_t * bnext)          ; the next candidate of its bucket, plus one
    (member size_t * bhead)          ; each bucket's first candidate not passed, plus one
    (member size_t   nb)             ; how many buckets, a power of two
    (member size_t   ptr)            ; swipl's pointer: O's first clause not passed
    (member size_t   anc)            ; O's first clause from PTR that is still there
    (member size_t   at)             ; where that one was found last
    (member size_t   ncomp))         ; the store's compactions when CELL was taken

  ;;; The predicates one consult has already reset, so each is reset ONCE
  ;;; per consult -- at its first clause -- however many clauses the file
  ;;; holds for it and however they are scattered. A frame of the consult,
  ;;; so a file consulted from inside another keeps its own.
  (struct coco_origin_seen
    (member size_t * pis)
    (member size_t   n)
    (member size_t   cap)
    ;; EACH ONE'S RELOAD (2.14.1), parallel to PIS: nil for a predicate
    ;; whose clauses are appended, as a first read's are; AGAIN, whether
    ;; the file is read into this store again; LAST, the index in PIS of
    ;; the predicate the last clause went to, plus one
    (member coco_reload ** rls)
    (member size_t   rcap)
    (member int      again)
    (member size_t   last))

  ;;; `coco_assert' with a PROVENANCE. ORIGIN is the interned real path of
  ;;; the file the clause was read from plus one, 0 for none. With SEEN given and an
  ;;; origin, the first clause of each predicate first drops every clause
  ;;; that predicate already holds from the same origin: the reconsult. And
  ;;; a re-read places each clause as swipl's reload does (2.14.1,
  ;;; `coco_reload_begin'), where a first read appends.
  (decl) (func coco_assert_from ((coco_store * st) (coco_machine * m) (size_t clause)
                               (int at_end) (u64 origin) (coco_origin_seen * seen)) (out int))

  ;;; A clause as a backend stores it: bare, or `'$from'(Path, Clause)'
  ;;; carrying the name of the file that consulted it. Either goes into the
  ;;; store; the wrapper becomes the clause's origin and is not kept.
  (decl) (func coco_assert_stored ((coco_store * st) (coco_machine * m) (size_t t)) (out int))

  ;;; Drops every clause of predicate PI that came from ORIGIN, telling the
  ;;; backend once if anything went. Answers how many went.
  (decl) (func coco_pred_forget_from ((coco_store * st) (coco_machine * m) (size_t pi) (u64 origin)) (out int))

  ;;; ---- first-argument indexing, the two the engine calls -----------------

  ;;; The index key of a callable term: its first argument's cell, or 0 for
  ;;; anything that cannot be discriminated on -- an unbound argument, a
  ;;; float, or no argument at all. See `coco_pred' for why the cell IS the
  ;;; key. The term is dereferenced here, so a caller may hand over a goal
  ;;; straight out of a choice frame.
  (decl) (func coco_arg_key ((coco_machine * m) (size_t t)) (out u64))

  ;;; The first clause at or after FROM whose head can match a goal of KEY,
  ;;; or `coco_no_clause' when there is none. A KEY of 0 constrains nothing
  ;;; and answers FROM.
  ;;;
  ;;; THIS IS WHERE THE DETERMINISM COMES FROM, as much as the speed: asking
  ;;; it a second time from the next position is how the engine learns that
  ;;; the clause it just took was the last candidate, and a predicate with no
  ;;; second candidate leaves no choice point behind at all.
  (decl) (func coco_pred_next_clause ((coco_store * st) (coco_pred * p)
                                    (u64 key) (size_t from)) (out size_t))
  ;; the first candidate and whether a second exists: 0 none, 1 one, 2 more
  ;; -- of the LIVE clauses, a new call's (`coco_pred_dead')
  (decl) (func coco_pred_probe ((coco_store * st) (coco_pred * p)
                              (u64 key) (size_t * ix) (coco_machine * m)) (out int))

  ;;; ---- the logical update view ------------------------------------------
  ;;;
  ;;; THE FRAMES OPEN ON PREDICATE PI of ST, on every engine of M's chain
  ;;; that runs over ST (`m->eng', each engine's `outer' -- every engine a
  ;;; program can still fail back into, as no builtin leaves a choice point
  ;;; behind): with ACT 0 whether there is one (1 or 0, the walk stopping
  ;;; at the first); with ACT 1 how many, each given death ERA as the first
  ;;; it lives through when it has none (`fera'); with ACT 2 how many, each
  ;;; at or past position AT moved one clause on, as a clause put in at AT
  ;;; just moved every clause from there -- AT 0 for an asserta, which moved
  ;;; them all (`clause_ix', `cend'); with ACT 3 how many would see a clause
  ;;; put in at AT, having a clause before it still to try and one after it
  ;;; inside their end (2.14.1, a re-read's place for a clause). No walk at
  ;;; all for a predicate no frame was pushed on since the last walk found
  ;;; none (`framed'). Defined in lib/solve.cicili, which knows what a frame
  ;;; is.
  (decl) (func coco_frames_on ((coco_machine * m) (coco_store * st) (size_t pi)
                               (int act) (u32 era) (size_t at)) (out size_t))
  ;;; How many of P's clauses before position IX are live: IX itself when
  ;;; none is dead -- the ordinal a frame's next clause has in a list that
  ;;; holds no dead (a frozen machine's, `coco_freeze').
  (decl) (func coco_pred_live_before ((coco_pred * p) (size_t ix)) (out size_t))
  ;;; The position of P's Nth live clause (from 0), `coco_no_clause' past
  ;;; the last: N itself when none is dead (`clause/2''s `'$clause'/3').
  (decl) (func coco_pred_live_at ((coco_pred * p) (size_t n)) (out size_t))
  ;;; The dead of predicate PI taken out if no frame is open on it: 1 when
  ;;; they went (or there were none), 0 when a frame may still try one.
  (decl) (func coco_tomb_try_sweep ((coco_store * st) (coco_machine * m) (size_t pi)) (out int))
  ;;; Whether clause I of P is dead: retracted while a call on P was open
  ;;; and kept for the calls open then.
  (decl) (func coco_pred_dead ((coco_pred * p) (size_t i)) (out int))
  ;;; How many of P's clauses are live.
  (decl) (func coco_pred_live ((coco_pred * p)) (out size_t))
  ;;; The dead clauses of PI taken out, as a retract with no call open
  ;;; would have taken them: the caller has made sure no frame is open on
  ;;; it. And the same for every predicate on the store's list, by a
  ;;; caller that knows no frame is open anywhere (a query starting with
  ;;; nothing running).
  (decl) (func coco_pred_sweep ((coco_store * st) (coco_machine * m) (size_t pi)))
  (decl) (func coco_tomb_sweep_all ((coco_store * st) (coco_machine * m)))

  ;;; THE ARGUMENT A CALL IS INDEXED ON, and its key. The first, as it
  ;;; always was, when its key leaves few candidates; else the bound one,
  ;;; of the first eight, whose index leaves the fewest -- built the first
  ;;; time it is wanted. POS is the argument, 0 for the first, and the
  ;;; pair comes back by value, so a caller's locals stay in registers.
  ;;; Every choice is sound: a clause any index skips has a head that
  ;;; cannot unify with the call, so the choice moves only how many
  ;;; hopeless heads are tried and whether a call is known to be
  ;;; deterministic, never which solutions come, or in what order.
  (struct coco_ixsel
    (member u64 key)
    (member u32 pos))
  (decl) (func coco_pred_select ((coco_store * st) (coco_machine * m) (coco_pred * p)
                                 (size_t call)) (out coco_ixsel))
  ;;; The key of argument POS of a call, as `coco_arg_key' reads the first's.
  (decl) (func coco_call_arg_key ((coco_machine * m) (size_t call) (u32 pos)) (out u64))
  ;;; `coco_pred_next_clause' and `coco_pred_probe' on argument POS
  (decl) (func coco_pred_next_at ((coco_store * st) (coco_machine * m) (coco_pred * p)
                                  (u32 pos) (u64 key) (size_t from)) (out size_t))
  (decl) (func coco_pred_probe_at ((coco_store * st) (coco_machine * m) (coco_pred * p)
                                   (u32 pos) (u64 key) (size_t * ix)) (out int))

  ;;; What `coco_pred_next_clause' answers when the clauses have run out. Not
  ;;; a position anything can hold, because the clause array would have to
  ;;; fill memory to reach it.
  (decl) (func coco_no_clause () (out size_t))

  ;;; Reads a whole program text and asserts every clause in it. Answers the
  ;;; number asserted, or -1 on a syntax error, leaving the message in ERR.
  ;;;
  ;;; ORIGIN NAMES THE FILE, for the messages a directive can now produce --
  ;;; `file.pl:12:' the way SWI writes it. Text with no file behind it passes
  ;;; nil, and the message says only what went wrong.
  ;;;
  ;;; A DIRECTIVE THAT FAILS OR THROWS NO LONGER STOPS THE LOAD. It is
  ;;; reported, in SWI's two-line shape, and the next clause is read -- which
  ;;; is what every other Prolog does, and what makes a file with one bad
  ;;; directive in it still a file you can work on. Only a SYNTAX error ends
  ;;; the consult, because after one the reader does not know where it is.
  (decl) (func coco_consult ((coco_store * st) (coco_machine * m) (const char * text)
                           (const char * origin)
                           (char * err) (size_t errlen)) (out int))

  ;;; THE SAME, WITH THE CLAUSES' OWNER NAMED (2.14.0): OWNER is the real
  ;;; path of the file the text is, and the clauses carry it even in a
  ;;; muted store -- which is how a module's clauses (`coco_module_load')
  ;;; are told from another module's, so that consulting the file again
  ;;; replaces them. Null owns nothing. REREAD 0 is a first read, which
  ;;; has nothing to replace and asks nothing; 1 replaces what OWNER put
  ;;; in this store before, as `coco_consult' does for the program's file.
  (decl) (func coco_consult_owner ((coco_store * st) (coco_machine * m) (const char * text)
                                 (const char * origin) (const char * owner) (int reread)
                                 (char * err) (size_t errlen)) (out int))

  ;;; `coco_consult', SAYING WHETHER THE FILE IS READ INTO THIS STORE AGAIN
  ;;; (2.14.1): the host knows, from the files it noted (`loads') before it
  ;;; noted this read. AGAIN places every clause as swipl's reload places
  ;;; it, beside what the program asserted and other files put there --
  ;;; and a predicate that holds the file's clauses from before is placed
  ;;; so whatever AGAIN says; anything else of a first read is appended.
  (decl) (func coco_consult_again ((coco_store * st) (coco_machine * m) (const char * text)
                                 (const char * origin) (int again)
                                 (char * err) (size_t errlen)) (out int))

  ;;; Splits a clause ON THE HEAP into head and body. A fact has no body and
  ;;; BODY is left 0; the engine reads that as `true' rather than building one.
  ;;;
  ;;; It takes a heap term and not a stored one because a clause is always
  ;;; copied out of the store before it is used -- `coco_store_get' first, this
  ;;; second. A version reading the store's own cells would have to duplicate
  ;;; `coco_arity' and `coco_name_of' against a different array, and the one time
  ;;; that existed it was called with a heap index and read whatever the
  ;;; store's array happened to hold at that offset.
  (decl) (func coco_clause_parts ((coco_machine * m) (size_t clause)
                                (size_t * head) (size_t * body)))

  ;;; Makes sure a predicate's clauses are present, asking the backend once.
  ;;; 0 when the read failed (2.11.1): nothing of it is kept, the reason is on
  ;;; the store (`fetch_err'), and the caller refuses -- raising through
  ;;; `coco_fetch_error' (lib/solve.cicili) -- rather than read on.
  (decl) (func coco_pred_ensure ((coco_store * st) (size_t pi)) (out int))

  ;;; The same, answering the clauses the predicate has -- 0 when the read
  ;;; failed, which `loaded' left 0 tells from a predicate with none: the
  ;;; step's form of the question (2.11.1).
  (decl) (func coco_pred_ready ((coco_store * st) (size_t pi)) (out size_t))

  ;;; Brings every predicate the backend holds into the store, by name only.
  ;;; Answers 1 whether or not there was a backend to ask.
  (decl) (func coco_store_warm ((coco_store * st)) (out int))

  ;;; Declares NAME/ARITY dynamic: brings the predicate into being with no
  ;;; clauses, and marks it.
  ;;;
  ;;; WHAT IT IS FOR HERE, given that cocolog lets you assert into anything and
  ;;; calling something undefined already fails rather than raising. Two things.
  ;;; It makes a predicate that has no clauses YET exist, so `listing' can show
  ;;; it and a reader of the program can see it was meant; and it says out loud
  ;;; which predicates a program intends to change at run time, which is the
  ;;; only documentation of that a Prolog file has.
  ;;;
  ;;; It does NOT mark the predicate loaded. A dynamic predicate may perfectly
  ;;; well have clauses waiting in a shared knowledge base, put there by another
  ;;; interpreter, and declaring it here must not stop the backend being asked.
  (decl) (func coco_pred_dynamic ((coco_store * st) (u64 name) (u32 arity)) (out int))

  ;;; Removes the first clause whose head and body unify with the given term:
  ;;; 1 when one went, 0 when none matched, -1 when the predicate could not be
  ;;; read from the backend (the reason in `fetch_err', 2.11.1).
  (decl) (func coco_retract ((coco_store * st) (coco_machine * m) (size_t clause)) (out int))

  ;;; Declares every predicate a `dynamic' spec names. SPEC is a predicate
  ;;; indicator `Name/Arity', a comma conjunction of them, or a list of them --
  ;;; all three of which real Prolog files use, often in the same file:
  ;;;
  ;;;   :- dynamic counter/1.
  ;;;   :- dynamic seen/2, queued/1.
  ;;;   :- dynamic [a/0, b/1].
  ;;;
  ;;; Answers 1, or 0 with ERR saying which part of the spec was not one.
  (decl) (func coco_dynamic_spec ((coco_store * st) (coco_machine * m) (size_t spec)
                                (char * err) (size_t errlen)) (out int))

  ;;; True when T is the compound NAME of arity two -- `a/1', `a, b', `[a|b]'.
  ;;; Out here rather than kept to itself because `listing/1' asks the same
  ;;; question of its argument that `dynamic/1' does.
  (decl) (func coco_is_compound2 ((coco_machine * m) (size_t t) (const char * name))
               (out int))

  ;;; The goals a file's `:- initialization(G)' directives put off until the
  ;;; whole file is read, in the order the file writes them. Cells, not heap
  ;;; terms: the heap is wound back after every clause, and a goal recorded
  ;;; on it would be pointing at reused ground by the time the file ended.
  ;;;
  ;;; MODE is `when' from SWI's `initialization/2': 0 after_load, 1 main.
  ;;; (`now' is not here, having already run.) LINE is where the directive
  ;;; was written, so the message a failing one produces can say.
  (struct coco_initgoals
    (member size_t * cells)
    (member int    * modes)
    (member int    * lines)
    (member size_t   len)
    (member size_t   cap))

  ;;; Applies one directive -- the G of a `:- G' read by `coco_consult'.
  ;;;
  ;;; IT RUNS G, through the seam below, when G is not one of the handful
  ;;; this file answers itself. Those it answers are the ones that are about
  ;;; the READER or the STORE and must take effect while the file is still
  ;;; being read -- `op/3' changes how the rest of the file parses,
  ;;; `set_prolog_flag(double_quotes, V)' changes what a "..." in it builds,
  ;;; `dynamic/1' makes a predicate exist before its first clause does.
  ;;; Everything else is a goal, as it is in SWI, and goes to the engine
  ;;; through `coco_goal_install' -- in file order, where a directive that
  ;;; asserts what the next one reads still works.
  ;;;
  ;;; INITS COLLECTS `initialization(G)'. Answers 1 (done), 2 (the goal
  ;;; FAILED -- a Warning, in SWI's reckoning, and ERR says which goal), 0
  ;;; (an error, ERR carrying it in SWI's words) or 3 (both: a load directive
  ;;; that loaded nothing, which SWI reports as the ERROR saying why and then
  ;;; the Warning that the directive failed). The caller REPORTS the last
  ;;; three and carries on, because a bad directive is one bad line and not a
  ;;; bad file.
  (decl) (func coco_directive ((coco_store * st) (coco_machine * m) (size_t g)
                             (coco_initgoals * inits) (int line)
                             (char * err) (size_t errlen)) (out int))

  ;;; The seam `:- use_module(...)' loads through. This file is compiled
  ;;; below the module layer and cannot call it, so the library loader
  ;;; installs itself here the way the module layer installs itself into
  ;;; solve.cicili: one function pointer, null until somebody fills it in.
  ;;; While it is null the directive stays what it always was -- accepted
  ;;; and ignored, so a borrowed file still reads unedited. The hook answers
  ;;; 1 (loaded, or carried here under another name), 0 (found and would not
  ;;; load, ERR saying why) or -1 (not there at all).
  (decl) (func coco_use_module_install
               ((func h ((coco_store * st) (coco_machine * m) (size_t spec)
                         (char * err) (size_t errlen))
                     (out int))))

  ;;; The seam a DIRECTIVE runs through, installed by the same layer and for
  ;;; the same reason: an engine lives above this file, and a goal needs one.
  ;;; The hook answers 1 (proved), 0 (failed) or -1 (threw, with the message
  ;;; already in SWI's words in ERR) -- the three outcomes a load-time
  ;;; message has to tell apart.
  ;;;
  ;;; WHILE IT IS NULL a directive that is a goal is what it was before there
  ;;; was a seam: refused by name. That is not a fallback anybody should
  ;;; meet, but a store opened without an engine over it -- the schema
  ;;; compiler does exactly that -- must not crash on a file that has one.
  (decl) (func coco_goal_install
               ((func h ((coco_store * st) (coco_machine * m) (size_t goal)
                         (char * err) (size_t errlen))
                     (out int))))

  ;;; Ends the process from inside a load with CODE -- SWI's halt, which
  ;;; stops the load where it stands -- after the store's `on_halt', when it
  ;;; has one, has finished the run: KEEP commits what it wrote, as a halt
  ;;; after the CLI's goal is committed, and 0 rolls it back, as a goal
  ;;; that threw is. Never returns.
  (decl) (func coco_halt_load ((coco_store * st) (int code) (int keep)))

  ;;; THE BACKTRACE OF THE ERROR JUST REPORTED (1.10.17): the machine's
  ;;; `bt', put on stderr after the message when SAY -- the run the message
  ;;; is about ended with a ball, whose throw wrote it -- and freed either
  ;;; way, so a later report never prints lines that were not its own.
  (decl) (func coco_bt_say ((coco_machine * m) (int say)))

  ) ; decl-kb


(generic impl-kb
  ()

  ;; the use_module seam: null until the library loader installs itself.
  ;; No initialiser -- `. nil' cannot be written inside a generic in this
  ;; package, and a static is null anyway.
  (static) (var func coco_use_module_hook ((coco_store * st) (coco_machine * m)
                                           (size_t spec) (char * err) (size_t errlen))
                (out int))

  (func coco_use_module_install
        ((func h ((coco_store * st) (coco_machine * m) (size_t spec)
                  (char * err) (size_t errlen)) (out int)))
        (set coco_use_module_hook h))

  ;; and the seam a directive runs through, filled in by the same layer
  (static) (var func coco_goal_hook ((coco_store * st) (coco_machine * m)
                                     (size_t goal) (char * err) (size_t errlen))
                 (out int))

  (func coco_goal_install
        ((func h ((coco_store * st) (coco_machine * m) (size_t goal)
                  (char * err) (size_t errlen)) (out int)))
        (set coco_goal_hook h))

  (func coco_halt_load ((coco_store * st) (int code) (int keep))
        ;; the program's output first: a failed commit says so on stderr
        (fflush nil)
        (if (!= (-> st on_halt) nil)
            (set code ((-> st on_halt) st (-> st ctx) code keep)))
        (fflush nil)
        (exit code))

  ;;; ---- the messages a load can produce ----------------------------------
  ;;;
  ;;; SWI'S TWO-LINE SHAPE, kept because a person who has seen one of these
  ;;; before should not have to learn a second dialect of it:
  ;;;
  ;;;     ERROR: /path/p.pl:12:
  ;;;     ERROR:    Unknown procedure: table/1
  ;;;
  ;;; The first line locates it and the second says what it was, indented
  ;;; under its own tag so a grep for `ERROR:' finds both halves. WHERE is
  ;;; nil for text with no file behind it -- a clause out of the database,
  ;;; the REPL -- and then the location line is left out rather than made up.
  ;;;
  ;;; ON A LINE OF ITS OWN (2.16.0): a report begins with a newline when the
  ;;; console's line is open -- the program wrote `abc' and no newline --
  ;;; as swipl's do, being print_message/2's (`~N', lib/term.cicili's
  ;;; `coco_out_fresh'). Through 2.15.1 `abc' and a report's tag shared a
  ;;; line on a terminal.
  (static)
  (func coco_load_message ((const char * tag) (const char * origin) (int line)
                           (const char * what))
        (fflush nil)
        (coco_out_fresh stderr)
        (if (!= origin nil)
            (fprintf stderr "%s: %s:%d:\n" tag origin line))
        (fprintf stderr "%s:    %s\n" tag what)
        (coco_out_note stderr "\n" 1))

  ;;; The one-line form, which is the one SWI uses for an initialization goal
  ;;; -- `Warning: p.pl:1: Initialization goal failed'. Measured against
  ;;; swipl rather than remembered: the two shapes are not interchangeable
  ;;; there and a reader who greps for one should find it.
  (static)
  (func coco_load_note ((const char * tag) (const char * origin) (int line)
                        (const char * what))
        (fflush nil)
        (coco_out_fresh stderr)
        (if (!= origin nil)
            (fprintf stderr "%s: %s:%d: %s\n" tag origin line what)
          (fprintf stderr "%s: %s\n" tag what))
        (coco_out_note stderr "\n" 1))

  (func coco_bt_say ((coco_machine * m) (int say))
        (if (== (-> m bt) nil) (return))
        (if say (coco_out_puts stderr (-> m bt)))
        (free (-> m bt))
        (set (-> m bt) nil))

  ;;; ---- the goals a file puts off ----------------------------------------

  (static)
  (func coco_inits_add ((coco_initgoals * gs) (size_t cell) (int mode) (int line))
        (out int)
        (if (>= (-> gs len) (-> gs cap))
            (let ((size_t ncap . #'(? (== (-> gs cap) 0) 8 (* (-> gs cap) 2)))
                  (void * nc) (void * nm) (void * nl))
              (set nc (realloc (cast (void *) (-> gs cells)) (* ncap (sizeof size_t))))
              (if (== nc nil) (return 0))
              (set (-> gs cells) (cast (size_t *) nc))
              (set nm (realloc (cast (void *) (-> gs modes)) (* ncap (sizeof int))))
              (if (== nm nil) (return 0))
              (set (-> gs modes) (cast (int *) nm))
              (set nl (realloc (cast (void *) (-> gs lines)) (* ncap (sizeof int))))
              (if (== nl nil) (return 0))
              (set (-> gs lines) (cast (int *) nl))
              (set (-> gs cap) ncap)))
        (set (nth (-> gs len) (-> gs cells)) cell)
        (set (nth (-> gs len) (-> gs modes)) mode)
        (set (nth (-> gs len) (-> gs lines)) line)
        (set (-> gs len) (+ (-> gs len) 1))
        (return 1))

  (static)
  (func coco_inits_free ((coco_initgoals * gs))
        (if (!= (-> gs cells) nil) (free (cast (void *) (-> gs cells))))
        (if (!= (-> gs modes) nil) (free (cast (void *) (-> gs modes))))
        (if (!= (-> gs lines) nil) (free (cast (void *) (-> gs lines))))
        (memset gs 0 (sizeof coco_initgoals)))

  ;;; A doubling refused is tried again with what is needed and a
  ;;; sixteenth, and given, sets `memreq': the next `coco_store_put', which
  ;;; knows the machine, stops the running engine with it, and its next
  ;;; step raises resource_error(memory) (1.10.28, as `coco_grow_short'
  ;;; does for the machine's arrays). Refused too, `oom', as before -- and a
  ;;; push that answers 0 writes over cell 0, which this makes rare.
  (static)
  (func coco_store_grow ((coco_store * st) (void ** buf) (size_t * cap) (size_t need) (size_t esize))
        (out int)
        (if (<= need (cof cap)) (return 1))
        (let ((size_t ncap . #'(? (== (cof cap) 0) 64 (cof cap)))
              (void * nbuf))
          (while (< ncap need) (set ncap (* ncap 2)))
          (set nbuf (realloc (cof buf) (* ncap esize)))
          (if (== nbuf nil)
              (block
                (set ncap (+ need (+ (/ need 16) 64)))
                (set nbuf (realloc (cof buf) (* ncap esize)))
                (if (== nbuf nil) (block (set (-> st oom) 1) (return 0)))
                (set (-> st memreq) 1)))
          (set (cof buf) nbuf)
          (set (cof cap) ncap)
          (return 1)))

  ;;; `memreq' handed to the engine the machine is running (`haltp')
  (func coco_store_memreq ((coco_store * st) (coco_machine * m))
        (set (-> st memreq) 0)
        (if (!= (-> m haltp) nil)
            (if (== (cof (-> m haltp)) 0) (set (cof (-> m haltp)) 2))))

  ;;; Each store made gets the next serial; a thread making one while
  ;;; another does may draw the same number, and the cache that reads it
  ;;; (`pserial' on a functor) keys by the store's address too, so a
  ;;; duplicate matters only for a store freed and made again at the same
  ;;; address in the same thread -- which the counter moving past it rules
  ;;; out.
  (static) (var u64 coco_store_serials . 0)

  ;;; How many arguments past the first can have an index of their own
  ;;; (`coco_argix'): the second to the eighth.
  (static) (func coco_aix_count () (out u32) (return 7))

  (func coco_store_init ((coco_store * st))
        (memset st 0 (sizeof coco_store))
        (set coco_store_serials (+ coco_store_serials 1))
        (set (-> st serial) coco_store_serials))

  (func coco_store_free ((coco_store * st))
        (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
          (free ($ (nth i (-> st preds)) clauses))
          (free ($ (nth i (-> st preds)) origins))
          (free ($ (nth i (-> st preds)) muted))
          (free (cast (void *) ($ (nth i (-> st preds)) codes)))
          (free (cast (void *) ($ (nth i (-> st preds)) tomb)))
          ;; the index's three arrays go with the clause list they describe,
          ;; and so do the other arguments' tables
          (free ($ (nth i (-> st preds)) keys))
          (free ($ (nth i (-> st preds)) chain))
          (free (cast (void *) ($ (nth i (-> st preds)) slots)))
          (let ((coco_argix * x . #'($ (nth i (-> st preds)) aix)))
            (if (!= x nil)
                (block
                 (for ((u32 j . 0)) (< j (coco_aix_count)) ((++ j))
                   (free ($ (nth j x) keys))
                   (free ($ (nth j x) chain))
                   (free (cast (void *) ($ (nth j x) slots))))
                 (free (cast (void *) x))))))
        (free (-> st preds))
        (free (-> st tpreds))
        (free (-> st pred_buckets))
        (coco_code_table_clear st)
        (coco_code_retired_free st)
        (free (-> st code_keys))
        (free (-> st code_vals))
        (free (-> st cells))
        (free (-> st roots))
        ;; the globals go with the cells they index -- nothing outside this
        ;; store could read them once `cells' is gone -- and so does the
        ;; hash that finds them
        (free (-> st globals))
        (free (-> st gbuckets))
        ;; and the files read into it, whose clauses are gone with it
        (for ((size_t i . 0)) (< i (-> st nloads)) ((++ i))
          (free ($ (nth i (-> st loads)) path)))
        (free (cast (void *) (-> st loads)))
        (memset st 0 (sizeof coco_store)))

  (func coco_store_loaded ((coco_store * st) (const char * path) (double * t)) (out int)
        (for ((size_t i . 0)) (< i (-> st nloads)) ((++ i))
          (if (== 0 (strcmp ($ (nth i (-> st loads)) path) path))
              (block (if (!= t nil) (set (cof t) ($ (nth i (-> st loads)) time)))
                     (return 1))))
        (return 0))

  ;;; A WRITE TO THE ONE STORE, so it takes the green barrier (2.9.0): two
  ;;; tasks consulting at once would otherwise grow the array under each
  ;;; other.
  (func coco_store_note_load ((coco_store * st) (const char * path) (double t)) (out int)
        (with-green-write nil
          (for ((size_t i . 0)) (< i (-> st nloads)) ((++ i))
            (if (== 0 (strcmp ($ (nth i (-> st loads)) path) path))
                (block (set ($ (nth i (-> st loads)) time) t) (return 1))))
          (let ((char * copy . #'(strdup path)))
            (if (== copy nil) (return 0))
            (if (not (coco_store_grow st (cast (void **) (aof (-> st loads)))
                                    (aof (-> st load_cap)) (+ (-> st nloads) 1)
                                    (sizeof coco_loaded)))
                (block (free copy) (return 0)))
            (set ($ (nth (-> st nloads) (-> st loads)) path) copy)
            (set ($ (nth (-> st nloads) (-> st loads)) time) t)
            (set (-> st nloads) (+ (-> st nloads) 1))
            (return 1))))

  ;;; A PRIVATE ENGINE STORE'S HIGH-WATER MARK. `pst'/`bst' are reused
  ;;; between calls, so their length is enough for correctness -- but a
  ;;; findall that once held three million solutions would otherwise keep
  ;;; that array until the engine dies. Past a small threshold, an empty
  ;;; store gives its cell array back; the next put allocates a fresh one.
  (func coco_store_shrink_empty ((coco_store * st))
        (if (and (== (-> st len) 0) (> (-> st cap) 65536))
            (block
             (free (-> st cells))
             (set (-> st cells) nil)
             (set (-> st cap) 0)
             (set (-> st mark) 0)
             (set (-> st dead) 0))))

  (func coco_store_mute ((coco_store * st))   (set (-> st muted) (+ (-> st muted) 1)))
  (func coco_store_unmute ((coco_store * st)) (if (> (-> st muted) 0)
                                              (set (-> st muted) (- (-> st muted) 1))))
  (func coco_store_is_muted ((coco_store * st)) (out int) (return (? (> (-> st muted) 0) 1 0)))

  (func coco_store_reset ((coco_store * st))
        (let ((void * ctx . #'(-> st ctx)))
          ;; The hooks are copied out and back through locals of their own
          ;; declared type -- a `func' clause in type position is a function
          ;; pointer, which is how a variable holds one.
          (let ((func keep_fetch ((coco_store * s) (void * c) (u64 n) (u32 a)) (out int)
                      . #'(-> st fetch))
                (func keep_assert ((coco_store * s) (void * c) (size_t cl)) (out int)
                      . #'(-> st on_assert))
                (func keep_retract ((coco_store * s) (void * c) (size_t pi)) (out int)
                      . #'(-> st on_retract))
                (func keep_warm ((coco_store * s) (void * c)) (out int)
                      . #'(-> st warm))
                (func keep_dynamic ((coco_store * s) (void * c) (size_t pi)) (out int)
                      . #'(-> st on_dynamic))
                (func keep_tput ((coco_store * s) (void * c) (const char * nm)
                                 (i64 sq) (const double * v) (u32 n)) (out int)
                      . #'(-> st tensor_put))
                (func keep_trow ((coco_store * s) (void * c) (const char * nm)
                                 (i64 sq) (double * o) (u32 cap) (u32 * n)) (out int)
                      . #'(-> st tensor_row))
                (func keep_tforget ((coco_store * s) (void * c) (const char * nm)) (out int)
                      . #'(-> st tensor_forget))
                (func keep_halt ((coco_store * s) (void * c) (int cd) (int kp)) (out int)
                      . #'(-> st on_halt)))
            (coco_store_free st)
            (coco_store_init st)
            (set (-> st ctx) ctx)
            (set (-> st fetch) keep_fetch)
            (set (-> st on_assert) keep_assert)
            (set (-> st on_retract) keep_retract)
            (set (-> st warm) keep_warm)
            (set (-> st on_dynamic) keep_dynamic)
            (set (-> st tensor_put) keep_tput)
            (set (-> st tensor_row) keep_trow)
            (set (-> st tensor_forget) keep_tforget)
            (set (-> st on_halt) keep_halt))))

  (static)
  (func coco_store_push ((coco_store * st) (u64 c)) (out size_t)
        (if (not (coco_store_grow st (cast (void **) (aof (-> st cells)))
                                (aof (-> st cap)) (+ (-> st len) 1) (sizeof u64)))
            (return 0))
        (set (nth (-> st len) (-> st cells)) c)
        (set (-> st len) (+ (-> st len) 1))
        (return (- (-> st len) 1)))

  (static)
  (func coco_store_new_var ((coco_store * st)) (out size_t)
        (let ((size_t i . #'(coco_store_push st 0)))
          (set (nth i (-> st cells)) (coco-cell REF i))
          (return i)))

  ;;; ---- moving terms between the heap and the store --------------------
  ;;; Both directions are the reserve-then-fill walk `coco_copy' uses, for the
  ;;; same reason: an argument cannot be written where it will end up, because
  ;;; building it pushes.

  ;;; BOTH WALKS ARE ITERATIVE, like `coco_copy''s -- see the frame struct in
  ;;; term.cicili for the story: a recursion here is one C frame per argument,
  ;;; so one per cons cell, and `assert' or `findall' of a 100000-element list
  ;;; overflowed the C stack and segfaulted. The driver drops a frame as its
  ;;; last argument is issued, so a list runs in a handful of frames.

  (static)
  (func coco_store_put_node ((coco_store * st) (coco_machine * m) (size_t t)
                             (coco_varmap * vm) (coco_copyframe ** fs)
                             (size_t * flen) (size_t * fcap))
        (out size_t)
        (set t (coco_deref m t))
        (let ((u64 c . #'(nth t (-> m heap))))
          (cond
            ((coco-tag-is REF c)
             (let ((size_t to . 0))
               (if (coco_varmap_get vm t (aof to)) (return to))
               (set to (coco_store_new_var st))
               (set (-> st put_vars) 1)
               (coco_varmap_put vm t to)
               (return to)))
            ((coco-tag-is FUN c)
             (let ((u32 n . #'(coco_arity m t))
                   (size_t h . #'(coco_store_push st c)))
               ;; PAST THE CEILING (1.10.19): the walk stops, no frame left,
               ;; and `coco_store_put' asks why. Asked before the slots, so
               ;; nothing it reads lives across their loop
               (if (> h (-> m wceil))
                   (block (set (-> m wceil) 0) (set (cof flen) 0) (return h)))
               (for ((u32 i . 0)) (< i n) ((++ i)) (coco_store_new_var st))
               (if (> n 0)
                   (if (not (coco_frames_push fs flen fcap t (+ h 1) n))
                       (set (-> st oom) 1)))
               (return h)))
            ;; A float's payload indexes the machine's float table, which the
            ;; store shares rather than copies -- the heap collector reclaims
            ;; an entry only when no cell anywhere names it, the store's
            ;; included (`coco_tables_reclaim', 1.9.6), so the index stays good
            ;; for as long as the cell does.
            (#t (return (coco_store_push st c))))))

  (static)
  (func coco_store_put_walk ((coco_store * st) (coco_machine * m) (size_t t)) (out size_t)
        (let ((coco_varmap vm . '{ nil nil 0 0 0 })
              (coco_copyframe * fs . nil) (size_t flen . 0) (size_t fcap . 0)
              (size_t r . 0))
          (coco_varmap_take m (aof vm))
          (set fs (cast (coco_copyframe *) (coco_wframes_take m (aof fcap))))
          (set r (coco_store_put_node st m t (aof vm) (aof fs) (aof flen) (aof fcap)))
          (while (> flen 0)
            (let ((size_t fi . #'(- flen 1)))
              (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n))
                  (block (set flen fi) continue))
              (let ((size_t src . #'(coco_arg m ($ (nth fi fs) src)
                                             ($ (nth fi fs) i)))
                    (size_t slot . #'(+ ($ (nth fi fs) dst)
                                        (cast size_t ($ (nth fi fs) i)))))
                (set ($ (nth fi fs) i) (+ ($ (nth fi fs) i) 1))
                (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n)) (set flen fi))
                (let ((size_t a . #'(coco_store_put_node st m src (aof vm)
                                                         (aof fs) (aof flen) (aof fcap))))
                  (set (nth slot (-> st cells)) (coco-cell REF a))))))
          (coco_wframes_give m (cast (void *) fs) fcap)
          (coco_varmap_give m (aof vm))
          (return r)))

  ;;; THE PUT, UNDER A CEILING (1.10.19). A tree on the heap takes at most
  ;;; twice its cells in the store (a variable, or an atom in an argument,
  ;;; is a slot and a cell of its own), so a put gone past twice the heap's
  ;;; length is of a cycle -- which it would follow for ever, as findall/3,
  ;;; nb_setval/2 and assert did through 1.10.18 -- or of a DAG, which it
  ;;; copies whole as it always has. The ceiling is one compare a compound;
  ;;; past it the store is wound back to where the put began and
  ;;; `coco_acyclic' says which. A cycle goes in as its factors,
  ;;; `'$cyclic'(Template, [V1=T1, ...])' (`coco_factorize', built on the
  ;;; heap and the heap wound back after), `cyc_puts' counts it, and
  ;;; `coco_store_read' makes it cyclic again; `coco_assert_from' refuses
  ;;; it. A cycle the heap cannot hold the factors of goes in as the atom
  ;;; `$cyclic', which is no hang. The slow path is a function of its own,
  ;;; NOT STATIC, so it stays out of the put: it holds two more copies of
  ;;; the walk.
  (func coco_store_put_over ((coco_store * st) (coco_machine * m) (size_t t)
                             (size_t base)) (out size_t)
        (set (-> st len) base)
        (set (-> m wceil) (cast size_t -1))
        (if (== 1 (coco_acyclic m t)) (return (coco_store_put_walk st m t)))
        (let ((size_t mark . #'(-> m heap_len))
              (size_t * vars . nil) (size_t nv . 0)
              (size_t f . #'(coco_factorize m t "$cyclic" (aof vars) (aof nv)))
              (size_t r . 0))
          (free vars)
          (if (== f 0) (set f (coco_new_atom m "$cyclic")))
          (set r (coco_store_put_walk st m f))
          (set (-> m heap_len) mark)
          (set (-> m cyc_puts) (+ (-> m cyc_puts) 1))
          (return r)))

  (func coco_store_put ((coco_store * st) (coco_machine * m) (size_t t)) (out size_t)
        (let ((defer () coco_g_write_end_cleanup)
              (int began . 0))
          ;; A PRIVATE STORE IS ONE ENGINE'S OWN: its cells are read by that
          ;; engine and no other, so a put is not a stop-the-world write.
          ;; The shared store keeps the barrier it has always had.
          (if (== (-> st private) 0)
              (set began (coco_g_write_begin nil)))
          (let ((size_t base . #'(-> st len))
                (size_t r . 0))
            (set (-> st put_vars) 0)
            (set (-> m wceil) (+ base (+ (* (-> m heap_len) 2) 64)))
            (set r (coco_store_put_walk st m t))
            (if (== (-> m wceil) 0) (set r (coco_store_put_over st m t base)))
            (if (-> st memreq) (coco_store_memreq st m))
            (return r))))

  ;;; The store's own dereference: a reserved argument slot is a REF to
  ;;; where the argument was put, and an unbound store variable points at
  ;;; itself. Nothing else in the store is ever a chain.
  (static)
  (func coco_store_deref ((coco_store * st) (size_t s)) (out size_t)
        (while (coco-tag-is REF (nth s (-> st cells)))
          (let ((size_t next . #'(cast size_t (coco-payload (nth s (-> st cells))))))
            (if (== next s) (return s))
            (set s next)))
        (return s))

  ;;; THE STORE-TO-HEAP COPY, in one loop. The root is pushed, and every
  ;;; compound met puts a frame on the walk stack -- its store index, its
  ;;; first heap slot, its arity, how many slots are done -- and the loop
  ;;; takes the frames' arguments one at a time, so a list's depth is never
  ;;; the C stack's. Two things make it cheap per cell:
  ;;;
  ;;; A VARIABLE MET FIRST LIVES IN ITS SLOT. The slot `coco_push_struct'
  ;;; reserved is already an unbound variable (a REF to itself), so the
  ;;; copy maps the store variable to the SLOT and pushes nothing; met
  ;;; again, the slot is pointed at that. The copy of `f(X, X)' is three
  ;;; cells, as `coco_make' would build it. Binding such a variable writes
  ;;; the slot, which is what binding any argument variable does.
  ;;;
  ;;; THE MAP IS PROBED ONCE per occurrence (`coco_varmap_intern'): found,
  ;;; or entered, in the one walk down the chain.
  (func coco_store_get_vm ((coco_machine * m) (coco_store * st) (size_t t)
                           (coco_varmap * vm)) (out size_t)
        (let ((coco_copyframe * fs . nil) (size_t flen . 0) (size_t fcap . 0)
              (size_t r . 0) (u64 c . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          ;; the root: a variable, an atom or number, or a compound
          (if (coco-tag-is REF c)
              (let ((size_t to . 0) (size_t v . #'(coco_new_var m)))
                (if (== 1 (coco_varmap_intern vm t v (aof to)))
                    (block (set ($ (cof m) heap_len) v) (return to)))
                (return v)))
          (if (not (coco-tag-is FUN c)) (return (coco_push m c)))
          (set fs (cast (coco_copyframe *) (coco_wframes_take m (aof fcap))))
          (let ((u32 n . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity)))
            (set r (coco_push_struct m c n))
            (if (> n 0)
                (if (not (coco_frames_push (aof fs) (aof flen) (aof fcap) t (+ r 1) n))
                    (set (-> m oom) 1))))
          (while (> flen 0)
            (let ((size_t fi . #'(- flen 1)))
              (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n))
                  (block (set flen fi) continue))
              (let ((size_t src . #'(coco_store_deref st (+ ($ (nth fi fs) src)
                                                           (+ (cast size_t ($ (nth fi fs) i)) 1))))
                    (size_t slot . #'(+ ($ (nth fi fs) dst)
                                        (cast size_t ($ (nth fi fs) i))))
                    (u64 cs . 0))
                (set ($ (nth fi fs) i) (+ ($ (nth fi fs) i) 1))
                (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n)) (set flen fi))
                (set cs (nth src (-> st cells)))
                (cond
                  ((coco-tag-is REF cs)
                   ;; first met: the slot IS the variable; met again: point
                   ;; the slot at the one it became
                   (let ((size_t to . 0))
                     (if (== 1 (coco_varmap_intern vm src slot (aof to)))
                         (coco_set_arg m slot to))))
                  ((coco-tag-is FUN cs)
                   (let ((u32 nn . #'($ (nth (cast size_t (coco-payload cs)) (-> m functors)) arity))
                         (size_t hh . #'(coco_push_struct m cs nn)))
                     (coco_set_arg m slot hh)
                     (if (> nn 0)
                         (if (not (coco_frames_push (aof fs) (aof flen) (aof fcap) src (+ hh 1) nn))
                             (set (-> m oom) 1)))))
                  (#t (coco_set_arg m slot (coco_push m cs)))))))
          (coco_wframes_give m (cast (void *) fs) fcap)
          (return r)))

  (func coco_store_get ((coco_machine * m) (coco_store * st) (size_t t)) (out size_t)
        (let ((coco_varmap vm . '{ nil nil 0 0 0 })
              (size_t r . 0))
          (coco_varmap_take m (aof vm))
          (set r (coco_store_get_vm m st t (aof vm)))
          (coco_varmap_give m (aof vm))
          (return r)))

  (func coco_store_read ((coco_machine * m) (coco_store * st) (size_t t)) (out size_t)
        (let ((size_t r . #'(coco_store_get m st t)))
          (if (== (-> m cyc_puts) 0) (return r))
          (return (coco_unfactor m r))))

  (func coco_store_read_block ((coco_machine * m) (coco_store * st) (size_t t) (size_t size))
        (out size_t)
        (let ((size_t h . #'(-> m heap_len)))
          (if (or (== size 0)
                  (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                  (aof (-> m heap_cap)) (+ h size) (sizeof u64))))
              (return (coco_store_read m st t)))
          (memcpy (cast (void *) (aof (nth h (-> m heap))))
                  (cast (const void *) (aof (nth t (-> st cells))))
                  (* size (sizeof u64)))
          (for ((size_t i . h)) (< i (+ h size)) ((++ i))
            (let ((u64 c . #'(nth i (-> m heap))))
              (if (coco-tag-is REF c)
                  (set (nth i (-> m heap))
                       (coco-cell REF (+ (- (cast size_t (coco-payload c)) t) h))))))
          (set (-> m heap_len) (+ h size))
          (if (== (-> m cyc_puts) 0) (return h))
          (return (coco_unfactor m h))))

  ;;; THE STORE'S SPAN IS THE COPY'S LENGTH PLUS ONE CELL PER DISTINCT
  ;;; VARIABLE, which the map counted as it entered them: the put gave each
  ;;; one a cell besides its argument slot, and the copy gives it the slot
  ;;; alone. Every other cell has its twin -- a header, a slot, an atom or
  ;;; a number -- and a repeated variable has none on either side. A ROOT
  ;;; that is a variable is the one cell on both sides, so it is not
  ;;; counted twice. Until 1.8.48 the dead were counted at the copy's
  ;;; length, which was the span before the copy put a variable in its slot
  ;;; (1.8.43), and a store compacted later than it said.
  (func coco_store_get_span ((coco_machine * m) (coco_store * st) (size_t t)
                             (size_t * span)) (out size_t)
        (let ((coco_varmap vm . '{ nil nil 0 0 0 })
              (size_t mark . #'(-> m heap_len))
              (size_t r . 0))
          (coco_varmap_take m (aof vm))
          (set r (coco_store_get_vm m st t (aof vm)))
          (set (cof span) (+ (- (-> m heap_len) mark) ($ vm len)))
          (if (coco-tag-is REF (nth (coco_store_deref st t) (-> st cells)))
              (set (cof span) (- (cof span) 1)))
          (coco_varmap_give m (aof vm))
          (return r)))

  ;;; Three words per pending pair: the heap side, the other side, and
  ;;; which kind the other side is -- 0 a store index, 1 a heap index (a
  ;;; store variable met again brings the heap term it was mapped to).
  (static)
  (func coco_su_push ((coco_machine * m) (size_t ** wl) (size_t * wlen) (size_t * wcap)
                      (size_t a) (size_t b) (size_t kind)) (out int)
        (if (< (cof wcap) (+ (cof wlen) 3))
            (let ((size_t ncap . #'(? (== (cof wcap) 0) 96 (* (cof wcap) 2)))
                  (void * nb))
              (set nb (realloc (cast (void *) (cof wl)) (* ncap (sizeof size_t))))
              (if (== nb nil) (block (set (-> m oom) 1) (return 0)))
              (set (cof wl) (cast (size_t *) nb))
              (set (cof wcap) ncap)))
        (set (nth (cof wlen) (cof wl)) a)
        (set (nth (+ (cof wlen) 1) (cof wl)) b)
        (set (nth (+ (cof wlen) 2) (cof wl)) kind)
        (set (cof wlen) (+ (cof wlen) 3))
        (return 1))

  ;;; ITERATIVE, as `coco_unify' is, and for the same reason: a list's depth
  ;;; is its length. The pairs wait in the machine's pair stack, pushed
  ;;; right to left so the walk stays left to right. The heap-heap case is
  ;;; `coco_unify''s own, written out here so a repeated variable does not
  ;;; start a second walk with a worklist of its own.
  (func coco_store_unify ((coco_machine * m) (coco_store * st) (size_t a) (size_t s)
                          (coco_varmap * vm)) (out int)
        (let ((size_t * wl . nil) (size_t wlen . 0) (size_t wcap . 0)
              (size_t kind . 0) (int ok . 1) (int running . 1)
              ;; the pairs of heap compounds before a pair is `coco_unify''s,
              ;; whose walk links them (1.10.19): two cyclic terms a store
              ;; variable meets went round for ever. The store's side is a
              ;; tree, and ends
              (size_t budget . #'(-> m heap_len)))
          (set wl (coco_wpairs_take m (aof wcap)))
          (while (== running 1)
            (set a (coco_deref m a))
            (if (== kind 1)
                ;; ---- both on the heap: coco_unify's cases ----
                (block
                 (set s (coco_deref m s))
                 (if (!= a s)
                     (let ((u64 ca . #'(nth a (-> m heap)))
                           (u64 cb . #'(nth s (-> m heap))))
                       (cond
                         ((coco-tag-is REF ca)
                          (if (coco-tag-is REF cb)
                              (if (> a s) (coco_bind m a s) (coco_bind m s a))
                              (coco_bind m a s)))
                         ((coco-tag-is REF cb) (coco_bind m s a))
                         ((!= (coco-tag ca) (coco-tag cb)) (set ok 0))
                         ((coco-tag-is ATOM ca) (if (!= ca cb) (set ok 0)))
                         ((coco-tag-is INT ca)  (if (!= ca cb) (set ok 0)))
                         ((coco-tag-is FLT ca)
                          (if (not (coco_flt_eq m ca cb)) (set ok 0)))
                         ;; a rational is its reduced pair (2.5.0)
                         ((coco-tag-is RAT ca)
                          (if (not (and (coco-tag-is RAT cb) (coco_rat_eq m ca cb)))
                              (set ok 0)))
                         ;; a boxed integer by its value (2.0.0)
                         ((coco-tag-is BIG ca)
                          (if (not (coco-big-p cb))
                              (set ok 0)
                            (if (!= (nth (cast size_t (coco-payload ca)) (-> m bigs))
                                    (nth (cast size_t (coco-payload cb)) (-> m bigs)))
                                (set ok 0))))
                         ((coco-tag-is STR ca)
                          (if (not (coco_str_eq m ca cb)) (set ok 0)))
                         ((coco-tag-is FUN ca)
                          (cond
                            ((!= (coco-payload ca) (coco-payload cb)) (set ok 0))
                            ((== budget 0) (if (not (coco_unify m a s)) (set ok 0)))
                            (#t
                             (set budget (- budget 1))
                             (let ((u32 n . #'(coco_arity m a)))
                               (for ((u32 i . n)) (> i 0) ((set i (- i 1)))
                                    (let ((u32 j . #'(- i 1)))
                                      (if (not (coco_su_push m (aof wl) (aof wlen) (aof wcap)
                                                             (coco_arg m a j) (coco_arg m s j) 1))
                                          (set ok 0))))))))
                         (#t (set ok 0))))))
                ;; ---- heap against store ----
                (block
                 (set s (coco_store_deref st s))
                 (let ((u64 ca . #'(nth a (-> m heap)))
                       (u64 cs . #'(nth s (-> st cells))))
                   (cond
                     ;; a store variable: mapped to what it meets the first
                     ;; time, unified with that the next
                     ((coco-tag-is REF cs)
                      (let ((size_t to . 0))
                        (if (coco_varmap_get vm s (aof to))
                            (if (not (coco_su_push m (aof wl) (aof wlen) (aof wcap) a to 1))
                                (set ok 0))
                          (if (not (coco_varmap_put vm s a)) (set ok 0)))))
                     ;; an unbound heap variable against something: the
                     ;; something is copied now, through the shared map, and
                     ;; the variable bound to the copy
                     ((coco-tag-is REF ca)
                      (if (coco-tag-is FUN cs)
                          (coco_bind m a (coco_store_get_vm m st s vm))
                          (coco_bind m a (coco_push m cs))))
                     ((!= (coco-tag ca) (coco-tag cs)) (set ok 0))
                     ((coco-tag-is ATOM ca) (if (!= ca cs) (set ok 0)))
                     ((coco-tag-is INT ca)  (if (!= ca cs) (set ok 0)))
                     ((coco-tag-is FLT ca)
                      ;; the store shares the machine's float table by
                      ;; index; two floats are one by their bits (2.1.1)
                      (if (not (coco_flt_eq m ca cs)) (set ok 0)))
                     ;; a rational is its reduced pair (2.5.0)
                     ((coco-tag-is RAT ca)
                      (if (not (and (coco-tag-is RAT cs) (coco_rat_eq m ca cs)))
                          (set ok 0)))
                     ;; and its integer table (2.0.0)
                     ((coco-tag-is BIG ca)
                      (if (not (coco-big-p cs))
                          (set ok 0)
                        (if (!= (nth (cast size_t (coco-payload ca)) (-> m bigs))
                                (nth (cast size_t (coco-payload cs)) (-> m bigs)))
                            (set ok 0))))
                     ((coco-tag-is STR ca)
                      (if (not (coco_str_eq m ca cs)) (set ok 0)))
                     ((coco-tag-is FUN ca)
                      (if (!= (coco-payload ca) (coco-payload cs))
                          (set ok 0)
                          (let ((u32 n . #'(coco_arity m a)))
                            (for ((u32 i . n)) (> i 0) ((set i (- i 1)))
                                 (let ((u32 j . #'(- i 1)))
                                   ;; the store lays a compound out as the
                                   ;; heap does: the header, then its slots
                                   (if (not (coco_su_push m (aof wl) (aof wlen) (aof wcap)
                                                          (coco_arg m a j) (+ s (+ (cast size_t j) 1)) 0))
                                       (set ok 0)))))))
                     (#t (set ok 0))))))
            (if (or (== ok 0) (== wlen 0))
                (set running 0)
                (block
                  (set kind (nth (- wlen 1) wl))
                  (set s (nth (- wlen 2) wl))
                  (set a (nth (- wlen 3) wl))
                  (set wlen (- wlen 3)))))
          (coco_wpairs_give m wl wcap)
          (return ok)))

  (func coco_store_clause_parts ((coco_store * st) (coco_machine * m) (size_t clause)
                                 (u64 neck) (size_t * head) (size_t * body))
        (set clause (coco_store_deref st clause))
        (set (cof head) clause)
        (set (cof body) 0)
        (let ((u64 c . #'(nth clause (-> st cells))))
          (if (not (coco-tag-is FUN c)) (return))
          (let ((coco_functor * f . #'(aof (nth (cast size_t (coco-payload c)) (-> m functors)))))
            (if (or (!= (-> f arity) 2) (!= (-> f name) neck)) (return)))
          (set (cof head) (+ clause 1))
          (set (cof body) (+ clause 2))))

  ;;; ---- compiled clauses --------------------------------------------------
  ;;;
  ;;; ONE WORD AN INSTRUCTION: the operation in the low eight bits, a frame
  ;;; index K in the next twenty-four, an argument index or an arity N in
  ;;; the high thirty-two; a constant or a functor follows in the word
  ;;; after. EACH NUMBER HAS A FIELD OF ITS OWN: GET_STRUCT once packed its
  ;;; argument index and its arity into sixteen bits each, and a head
  ;;; holding a structure of 65 536 arguments read back with every one of
  ;;; them wrong (1.8.45). A clause whose frame needs more than K can hold
  ;;; is not compiled (`coco_clause_code'). The head's instructions:
  ;;;
  ;;;   GET_VAR    k i     frame[k] is the call's argument i, dereferenced
  ;;;   GET_VAL    k i     unify frame[k] with argument i
  ;;;   GET_CONST  i  C    argument i is the constant C, or is bound to it
  ;;;   GET_STRUCT i n F   argument i (in K) is F/n: read its arguments, or
  ;;;                      build it and bind the argument to it -- READ or
  ;;;                      WRITE
  ;;;   GET_STRUCT_T k n F the same on frame[k]: a nested structure the
  ;;;                      parent left in a temporary
  ;;;   UNIFY_VAR   k      the next argument of the structure in hand is a
  ;;;                      variable met first: frame[k] is its slot
  ;;;   UNIFY_VAL   k      ... a variable met before: unify, or write it
  ;;;   UNIFY_CONST C      ... the constant C
  ;;;
  ;;; and the body's, which build a goal top down over ONE reservation:
  ;;; the goal's root word carries every cell the goal takes, and each
  ;;; argument word the offset from the goal's base of the slot it fills
  ;;; (in K) and, for a constant or a structure, of the cell it puts
  ;;; there (in N) -- settled here, so the executor keeps no stack of
  ;;; open structures and checks nothing (1.8.46; through 1.8.45 the
  ;;; words said "the next slot" and the executor found it on a frame
  ;;; stack, growing the heap once per structure, as the copy does):
  ;;;
  ;;;   GOAL_STRUCT t F    a goal F/_ starts: t cells, the header first
  ;;;   GOAL_ATOM   C      a goal that is an atom
  ;;;   GOAL_VAR    k      a goal that is a variable (call/1's business)
  ;;;   GOAL_VAR_1  k      ... met first here
  ;;;   ARG_CONST   o a C  slot o: the constant C, in cell a
  ;;;   ARG_VAR     k o    slot o: frame[k]
  ;;;   ARG_VAR_1   k o    slot o IS the variable, met first here
  ;;;   ARG_STRUCT  o a F  slot o: the structure whose header F is cell a,
  ;;;                      and whose own slots the words that follow fill
  ;;;
  ;;; and the first goal's REGISTER FORM (`rbody', Stage 3), which writes
  ;;; its arguments into the engine's registers and builds no header and
  ;;; no slots; what it nests takes the body's ARG words, offset from its
  ;;; one reservation (`cc_reg_form'):
  ;;;
  ;;;   RGOAL       n t    t cells for what the goal nests (left out when
  ;;;                      there are none); n its arity
  ;;;   RARG_CONST  r a C  register r: the constant C, in cell a
  ;;;   RARG_VAR    k r    register r: frame[k]
  ;;;   RARG_VAR_1  k r a  register r: a fresh variable in cell a, frame[k]
  ;;;   RARG_STRUCT r a F  register r: the structure whose header F is cell a
  ;;;
  ;;; A program ends where its length says (there was an END word through
  ;;; 1.8.45, one dispatch a clause for nothing).
  ;;;
  ;;; The executor names them too (`coco_clause_run'), never their numbers:
  ;;; ONE TABLE, read two ways -- the `cc_NAME' functions below, which the
  ;;; compiler calls, and `(cc-op "NAME")', a number at expansion time, for
  ;;; a `case' label in the executor's switch, which must be a constant.
  ;;; Nothing else may spell an opcode's number.
  (static) (func cc_GET_VAR () (out u64) (return (cc-op "GET_VAR")))
  (static) (func cc_GET_VAL () (out u64) (return (cc-op "GET_VAL")))
  (static) (func cc_GET_CONST () (out u64) (return (cc-op "GET_CONST")))
  (static) (func cc_GET_STRUCT () (out u64) (return (cc-op "GET_STRUCT")))
  (static) (func cc_GET_STRUCT_T () (out u64) (return (cc-op "GET_STRUCT_T")))
  (static) (func cc_UNIFY_VAR () (out u64) (return (cc-op "UNIFY_VAR")))
  (static) (func cc_UNIFY_VAL () (out u64) (return (cc-op "UNIFY_VAL")))
  (static) (func cc_UNIFY_CONST () (out u64) (return (cc-op "UNIFY_CONST")))
  (static) (func cc_GOAL_STRUCT () (out u64) (return (cc-op "GOAL_STRUCT")))
  (static) (func cc_GOAL_ATOM () (out u64) (return (cc-op "GOAL_ATOM")))
  (static) (func cc_GOAL_VAR () (out u64) (return (cc-op "GOAL_VAR")))
  (static) (func cc_GOAL_VAR_1 () (out u64) (return (cc-op "GOAL_VAR_1")))
  (static) (func cc_ARG_CONST () (out u64) (return (cc-op "ARG_CONST")))
  (static) (func cc_ARG_VAR () (out u64) (return (cc-op "ARG_VAR")))
  (static) (func cc_ARG_VAR_1 () (out u64) (return (cc-op "ARG_VAR_1")))
  (static) (func cc_ARG_STRUCT () (out u64) (return (cc-op "ARG_STRUCT")))
  (static) (func cc_RGOAL () (out u64) (return (cc-op "RGOAL")))
  (static) (func cc_RARG_CONST () (out u64) (return (cc-op "RARG_CONST")))
  (static) (func cc_RARG_VAR () (out u64) (return (cc-op "RARG_VAR")))
  (static) (func cc_RARG_VAR_1 () (out u64) (return (cc-op "RARG_VAR_1")))
  (static) (func cc_RARG_STRUCT () (out u64) (return (cc-op "RARG_STRUCT")))
  (static) (func cc_AG_LOAD () (out u64) (return (cc-op "AG_LOAD")))
  (static) (func cc_AG_PUSH () (out u64) (return (cc-op "AG_PUSH")))
  (static) (func cc_AG_BIN () (out u64) (return (cc-op "AG_BIN")))
  (static) (func cc_AG_UN () (out u64) (return (cc-op "AG_UN")))
  (static) (func cc_AG_CMP () (out u64) (return (cc-op "AG_CMP")))
  (static) (func cc_AG_ISF () (out u64) (return (cc-op "AG_ISF")))
  (static) (func cc_AG_ISV () (out u64) (return (cc-op "AG_ISV")))
  (static) (func cc_AG_ISC () (out u64) (return (cc-op "AG_ISC")))
  (static) (func cc_AG_TYPE () (out u64) (return (cc-op "AG_TYPE")))
  (static) (func cc_FRESH () (out u64) (return (cc-op "FRESH")))
  (static) (func cc_AG_ISX () (out u64) (return (cc-op "AG_ISX")))
  (static) (func cc_AG_CMPX () (out u64) (return (cc-op "AG_CMPX")))

  (func coco_regs_max () (out u32) (return 8))

  (static)
  (func cc_word ((u64 op) (u64 k) (u64 n)) (out u64)
        (return (bitor op (bitor (<< (bitand k 16777215) 8) (<< n 32)))))
  (static) (func cc_op ((u64 w)) (out u64) (return (bitand w 255)))
  (static) (func cc_k ((u64 w)) (out size_t) (return (cast size_t (bitand (>> w 8) 16777215))))
  (static) (func cc_n ((u64 w)) (out u64) (return (>> w 32)))

  ;;; A growing word buffer, for the two programs as they are emitted.
  (struct coco_cbuf
    (member u64 *  w)
    (member size_t len)
    (member size_t cap))

  (static)
  (func cc_emit ((coco_cbuf * b) (u64 w)) (out int)
        (if (>= (-> b len) (-> b cap))
            (let ((size_t ncap . #'(? (== (-> b cap) 0) 16 (* (-> b cap) 2)))
                  (void * nb . #'(realloc (cast (void *) (-> b w)) (* ncap (sizeof u64)))))
              (if (== nb nil) (return 0))
              (set (-> b w) (cast (u64 *) nb))
              (set (-> b cap) ncap)))
        (set (nth (-> b len) (-> b w)) w)
        (set (-> b len) (+ (-> b len) 1))
        (return 1))

  ;;; One pending compound of a compilation: the structure's store index,
  ;;; how many of its arguments are emitted, and for the head the frame
  ;;; index its temporary was left in.
  (struct coco_cframe
    (member size_t src)
    (member size_t k)
    (member u32    n)
    (member u32    i))

  (static)
  (func cc_frames_push ((coco_cframe ** fs) (size_t * len) (size_t * cap)
                        (size_t src) (size_t k) (u32 n)) (out int)
        (if (>= (cof len) (cof cap))
            (let ((size_t ncap . #'(? (== (cof cap) 0) 32 (* (cof cap) 2)))
                  (void * nb . #'(realloc (cast (void *) (cof fs)) (* ncap (sizeof coco_cframe)))))
              (if (== nb nil) (return 0))
              (set (cof fs) (cast (coco_cframe *) nb))
              (set (cof cap) ncap)))
        (set ($ (nth (cof len) (cof fs)) src) src)
        (set ($ (nth (cof len) (cof fs)) k) k)
        (set ($ (nth (cof len) (cof fs)) n) n)
        (set ($ (nth (cof len) (cof fs)) i) 0)
        (set (cof len) (+ (cof len) 1))
        (return 1))

  ;;; The frame index of the store variable at S, numbering it if this is
  ;;; its first occurrence; FIRST says which it was.
  (static)
  (func cc_var ((coco_varmap * vm) (size_t s) (u32 * nvars) (int * first)) (out size_t)
        (let ((size_t k . 0))
          (if (== 1 (coco_varmap_intern vm s (cast size_t (cof nvars)) (aof k)))
              (block (set (cof first) 0) (return k)))
          (set (cof first) 1)
          (set k (cast size_t (cof nvars)))
          (set (cof nvars) (+ (cof nvars) 1))
          (return k)))

  ;;; The arguments of one head structure, as UNIFY instructions: a
  ;;; variable by its frame index, a constant by its cell, and a nested
  ;;; structure through a temporary -- the WAM's flattening -- with the
  ;;; structure itself queued to be emitted after, breadth first, so it is
  ;;; always read or written after its parent put its slot in hand.
  (static)
  (func cc_head_args ((coco_store * st) (coco_machine * m) (size_t src) (u32 an)
                      (coco_varmap * vm) (u32 * nvars) (coco_cbuf * b)
                      (coco_cframe ** q) (size_t * qlen) (size_t * qcap)) (out int)
        (let ((int ok . 1))
          (for ((u32 j . 0)) (< j an) ((++ j))
            (let ((size_t sa . #'(coco_store_deref st (+ src (+ (cast size_t j) 1))))
                  (u64 cs . 0) (int sfirst . 0))
              (set cs (nth sa (-> st cells)))
              (cond
                ((coco-tag-is REF cs)
                 (let ((size_t k . #'(cc_var vm sa nvars (aof sfirst))))
                   (if (not (cc_emit b (cc_word (? sfirst (cc_UNIFY_VAR) (cc_UNIFY_VAL)) k 0)))
                       (set ok 0))))
                ((coco-tag-is FUN cs)
                 (let ((size_t t . #'(cast size_t (cof nvars)))
                       (u32 sn . #'($ (nth (cast size_t (coco-payload cs)) (-> m functors)) arity)))
                   (set (cof nvars) (+ (cof nvars) 1))
                   (if (not (cc_emit b (cc_word (cc_UNIFY_VAR) t 0))) (set ok 0))
                   (if (not (cc_frames_push q qlen qcap sa t sn)) (set ok 0))))
                (#t
                 (if (not (cc_emit b (cc_word (cc_UNIFY_CONST) 0 0))) (set ok 0))
                 (if (not (cc_emit b cs)) (set ok 0))))))
          (return ok)))

  ;;; THE HEAD. Each top-level argument gets its GET instruction and, for a
  ;;; structure, its arguments' UNIFY instructions right after; the nested
  ;;; structures those queued are worked off in order.
  (static)
  (func cc_compile_head ((coco_store * st) (coco_machine * m) (size_t head)
                         (coco_varmap * vm) (u32 * nvars) (coco_cbuf * b)) (out int)
        (let ((coco_cframe * q . nil) (size_t qlen . 0) (size_t qcap . 0) (size_t qi . 0)
              (u64 c . #'(nth head (-> st cells))) (int ok . 1))
          (if (not (coco-tag-is FUN c)) (return 1))
          (let ((u32 n . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity)))
            (for ((u32 i . 0)) (< i n) ((++ i))
              (let ((size_t a . #'(coco_store_deref st (+ head (+ (cast size_t i) 1))))
                    (u64 ca . 0) (int first . 0))
                (set ca (nth a (-> st cells)))
                (cond
                  ((coco-tag-is REF ca)
                   (let ((size_t k . #'(cc_var vm a nvars (aof first))))
                     (if (not (cc_emit b (cc_word (? first (cc_GET_VAR) (cc_GET_VAL)) k i)))
                         (set ok 0))))
                  ((coco-tag-is FUN ca)
                   (let ((u32 an . #'($ (nth (cast size_t (coco-payload ca)) (-> m functors)) arity)))
                     ;; the argument index in K, which has twenty-four bits
                     (if (> i 16777215) (set ok 0))
                     (if (not (cc_emit b (cc_word (cc_GET_STRUCT) (cast u64 i) (cast u64 an))))
                         (set ok 0))
                     (if (not (cc_emit b (coco-payload ca))) (set ok 0))
                     (if (not (cc_head_args st m a an vm nvars b (aof q) (aof qlen) (aof qcap)))
                         (set ok 0))))
                  (#t
                   (if (not (cc_emit b (cc_word (cc_GET_CONST) 0 i))) (set ok 0))
                   (if (not (cc_emit b ca)) (set ok 0)))))))
          (while (and ok (< qi qlen))
            (let ((size_t src . #'($ (nth qi q) src)) (size_t t . #'($ (nth qi q) k))
                  (u32 an . #'($ (nth qi q) n))
                  (u64 cs0 . #'(nth ($ (nth qi q) src) (-> st cells))))
              (if (not (cc_emit b (cc_word (cc_GET_STRUCT_T) t (cast u64 an)))) (set ok 0))
              (if (not (cc_emit b (coco-payload cs0))) (set ok 0))
              (if (not (cc_head_args st m src an vm nvars b (aof q) (aof qlen) (aof qcap)))
                  (set ok 0))
              (set qi (+ qi 1))))
          (free q)
          (return ok)))

  ;;; THE CELLS A GOAL TAKES ON THE HEAP, built as the executor builds it:
  ;;; a structure's header and its slots, a constant argument's own cell,
  ;;; nothing for a variable (its slot is the variable, or points at one
  ;;; that exists). 0 when the walk's stack could not grow, which the
  ;;; compile reads as "not compiled".
  (static)
  (func cc_goal_cells ((coco_store * st) (coco_machine * m) (size_t t)) (out size_t)
        (let ((coco_cframe * fs . nil) (size_t flen . 0) (size_t fcap . 0)
              (size_t total . 0) (int ok . 1) (u64 c . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (if (not (coco-tag-is FUN c)) (return 1))
          (let ((u32 n . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity)))
            (set total (+ (cast size_t n) 1))
            (if (> n 0)
                (if (not (cc_frames_push (aof fs) (aof flen) (aof fcap) t 0 n)) (set ok 0))))
          (while (and ok (> flen 0))
            (let ((size_t fi . #'(- flen 1)))
              (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n))
                  (block (set flen fi) continue))
              (let ((size_t sa . #'(coco_store_deref st (+ ($ (nth fi fs) src)
                                                          (+ (cast size_t ($ (nth fi fs) i)) 1))))
                    (u64 cs . 0))
                (set ($ (nth fi fs) i) (+ ($ (nth fi fs) i) 1))
                (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n)) (set flen fi))
                (set cs (nth sa (-> st cells)))
                (cond
                  ((coco-tag-is REF cs) (block))
                  ((coco-tag-is FUN cs)
                   (let ((u32 sn . #'($ (nth (cast size_t (coco-payload cs)) (-> m functors)) arity)))
                     (set total (+ total (+ (cast size_t sn) 1)))
                     (if (> sn 0)
                         (if (not (cc_frames_push (aof fs) (aof flen) (aof fcap) sa 0 sn)) (set ok 0)))))
                  (#t (set total (+ total 1)))))))
          (free fs)
          (return (? ok total 0))))

  ;;; ONE GOAL OF THE BODY, top down: the root's instruction, then its
  ;;; arguments depth first, each structure's arguments right after its
  ;;; own word -- the order the copy walks, and the order the executor
  ;;; fills slots in. THE LAYOUT IS SETTLED HERE: the root's cells come
  ;;; first, then each nested structure's and each constant's in emission
  ;;; order, so every slot and every cell has an offset from the goal's
  ;;; base known at compile time -- the slot's in a word's K, the cell's
  ;;; in its N -- and the root's word carries the goal's total, for the
  ;;; executor to reserve in one go (1.8.46). A frame's `k' is its
  ;;; structure's offset, so its i'th slot is at k + 1 + i.
  (static)
  (func cc_compile_goal ((coco_store * st) (coco_machine * m) (size_t t)
                         (coco_varmap * vm) (u32 * nvars) (coco_cbuf * b)) (out int)
        (let ((coco_cframe * fs . nil) (size_t flen . 0) (size_t fcap . 0)
              (u64 c . 0) (int ok . 1) (int first . 0) (size_t top . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (cond
            ((coco-tag-is REF c)
             (let ((size_t k . #'(cc_var vm t nvars (aof first))))
               (if (not (cc_emit b (cc_word (? first (cc_GOAL_VAR_1) (cc_GOAL_VAR)) k 0)))
                   (set ok 0))
               (return ok)))
            ((coco-tag-is FUN c)
             (let ((u32 n . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity))
                   (size_t total . #'(cc_goal_cells st m t)))
               (if (== total 0) (return 0))
               (if (not (cc_emit b (cc_word (cc_GOAL_STRUCT) 0 (cast u64 total)))) (set ok 0))
               (if (not (cc_emit b (coco-payload c))) (set ok 0))
               (set top (+ (cast size_t n) 1))
               (if (> n 0)
                   (if (not (cc_frames_push (aof fs) (aof flen) (aof fcap) t 0 n)) (set ok 0)))))
            (#t
             (if (not (cc_emit b (cc_word (cc_GOAL_ATOM) 0 0))) (set ok 0))
             (if (not (cc_emit b c)) (set ok 0))
             (return ok)))
          (while (and ok (> flen 0))
            (let ((size_t fi . #'(- flen 1)))
              (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n))
                  (block (set flen fi) continue))
              (let ((size_t sa . #'(coco_store_deref st (+ ($ (nth fi fs) src)
                                                          (+ (cast size_t ($ (nth fi fs) i)) 1))))
                    (size_t off . #'(+ ($ (nth fi fs) k) (+ (cast size_t ($ (nth fi fs) i)) 1)))
                    (u64 cs . 0))
                (set ($ (nth fi fs) i) (+ ($ (nth fi fs) i) 1))
                (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n)) (set flen fi))
                (set cs (nth sa (-> st cells)))
                ;; a slot offset is K's twenty-four bits; a goal is a
                ;; clause's and a clause fits a page, so this cannot be
                ;; reached, and is refused rather than wrapped
                (if (> off 16777215) (set ok 0))
                (cond
                  ((coco-tag-is REF cs)
                   (let ((size_t k . #'(cc_var vm sa nvars (aof first))))
                     (if (not (cc_emit b (cc_word (? first (cc_ARG_VAR_1) (cc_ARG_VAR)) k (cast u64 off))))
                         (set ok 0))))
                  ((coco-tag-is FUN cs)
                   (let ((u32 sn . #'($ (nth (cast size_t (coco-payload cs)) (-> m functors)) arity))
                         (size_t at . top))
                     (set top (+ top (+ (cast size_t sn) 1)))
                     (if (not (cc_emit b (cc_word (cc_ARG_STRUCT) (cast u64 off) (cast u64 at)))) (set ok 0))
                     (if (not (cc_emit b (coco-payload cs))) (set ok 0))
                     (if (> sn 0)
                         (if (not (cc_frames_push (aof fs) (aof flen) (aof fcap) sa at sn)) (set ok 0)))))
                  (#t
                   (let ((size_t at . top))
                     (set top (+ top 1))
                     (if (not (cc_emit b (cc_word (cc_ARG_CONST) (cast u64 off) (cast u64 at)))) (set ok 0))
                     (if (not (cc_emit b cs)) (set ok 0))))))))
          (free fs)
          (return ok)))

  ;;; THE BODY: its right spine of `,' is one goal per term, up to 63; what
  ;;; is left past that is one `,' goal, which the engine takes apart as it
  ;;; always did. For each goal, STARTS answers where its words begin and
  ;;; NVAFTER how many variables were numbered once it was compiled -- so a
  ;;; variable whose number is at least the count before goal I is met
  ;;; first in goal I, which is what the guards need to know
  ;;; (`cc_compile_guards') and the environment (`cc_compile_env').
  (static)
  (func cc_compile_body ((coco_store * st) (coco_machine * m) (size_t body)
                         (coco_varmap * vm) (u32 * nvars) (coco_cbuf * b) (u32 * ngoals)
                         (u32 * starts) (u32 * nvafter)) (out int)
        (let ((size_t g . #'(coco_store_deref st body)) (int ok . 1) (u32 count . 0)
              (u64 comma . #'(coco_intern m ",")))
          (while (and ok (< count 63))
            (let ((u64 c . #'(nth g (-> st cells))))
              (if (and (coco-tag-is FUN c)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) comma))
                  (block
                   (set (nth count starts) (cast u32 (-> b len)))
                   (if (not (cc_compile_goal st m (+ g 1) vm nvars b)) (set ok 0))
                   (set (nth count nvafter) (cof nvars))
                   (set count (+ count 1))
                   (set g (coco_store_deref st (+ g 2))))
                  break)))
          ;; the last goal, or everything that is left
          (if ok
              (block
               (set (nth count starts) (cast u32 (-> b len)))
               (if (not (cc_compile_goal st m g vm nvars b)) (set ok 0))
               (set (nth count nvafter) (cof nvars))
               (set count (+ count 1))))
          (set (cof ngoals) count)
          (return ok)))

  ;;; ---- the guards (Stage 4 of compiled control) --------------------------
  ;;;
  ;;; ARITHMETIC WAS MOST OF WHAT THE BENCH TASKS DO, AND ALL OF IT WAS
  ;;; INTERPRETED TWICE: `A1 is A0 + K' was built on the heap as a term when
  ;;; its clause was entered, put on the continuation in a frame, taken out
  ;;; by the next step, dispatched to `is/2', and its expression walked by
  ;;; `coco_arith' -- per goal, about as much again as a call costs. Counted
  ;;; on 1.9.0, `is/2' and the six comparisons were 67 % of the inferences
  ;;; of the counting loop, 62 % of queens', 67 % of the sort task's and
  ;;; 43 % of the lookup's, and most of them stand at the START of a body:
  ;;; a counter, an accumulator, a guard.
  ;;;
  ;;; So the goals a body starts with are compiled, when they are `X is E',
  ;;; a comparison of two expressions, or a type test of a variable, into a
  ;;; program over a stack of integers that reads the clause's own frame
  ;;; (`gbody'), and they are run as the clause is entered, right after the
  ;;; head: no term, no frame, no step. The proposal's Stage 4 made the
  ;;; whole body lazy to get here; that changes the continuation's shape
  ;;; and a frozen machine's format, and counted on the translator its
  ;;; bodies average 1.9 goals -- the lazy body had little else to save.
  ;;; The leading goals need none of it: nothing runs between a clause's
  ;;; entry and its first goal, so running them there is running them when
  ;;; the step would have, and the continuation never holds anything new.
  ;;;
  ;;; A GUARD ONLY EVER TAKES THE ROAD THE STEP WOULD HAVE TAKEN. Integers
  ;;; only, computed as `coco_arith' computes them (the same C, so the same
  ;;; wrap past 2^63); a variable that is not bound to an integer, a zero
  ;;; divisor, a float anywhere, an operator not in `*cc-gops*' -- anything
  ;;; the step would raise for, or answer a float to -- stops the guards
  ;;; before that goal does anything, and the goal and the rest of the body
  ;;; are built and stepped as they always were (`gstart'). Each guard that
  ;;; runs is still an inference (`statistics(inferences)' and the
  ;;; inference limit count it, and a guard that fails counts as the step
  ;;; that failed); under trace none runs, the ports being printed from
  ;;; goals.

  ;;; The names a Cicili string cannot carry, by their codes: `/\', `\/',
  ;;; `\' and `=\=', and `\==' for Stage 7.
  (static) (var char CC_GN_AND [] . '{ 47 92 0 })
  (static) (var char CC_GN_OR  [] . '{ 92 47 0 })
  (static) (var char CC_GN_NOT [] . '{ 92 0 })
  (static) (var char CC_GN_NEQ [] . '{ 61 92 61 0 })
  (static) (var char CC_GN_NEQEQ [] . '{ 92 61 61 0 })

  ;;; The guard code of an operator S of arity N: KIND 0 an arithmetic one,
  ;;; KIND 1 a comparison, KIND 2 a type test; 0 for none.
  (static)
  (func cc_guard_code ((const char * s) (u32 n) (int kind)) (out u64)
        (if (and (== kind 0) (== n 2))
            (block
             (if (== 0 (strcmp s "+")) (return (cc-gop "+")))
             (if (== 0 (strcmp s "-")) (return (cc-gop "-")))
             (if (== 0 (strcmp s "*")) (return (cc-gop "*")))
             (if (== 0 (strcmp s "//")) (return (cc-gop "//")))
             (if (== 0 (strcmp s "div")) (return (cc-gop "div")))
             (if (== 0 (strcmp s "mod")) (return (cc-gop "mod")))
             (if (== 0 (strcmp s "rem")) (return (cc-gop "rem")))
             (if (== 0 (strcmp s "min")) (return (cc-gop "min")))
             (if (== 0 (strcmp s "max")) (return (cc-gop "max")))
             (if (== 0 (strcmp s ">>")) (return (cc-gop ">>")))
             (if (== 0 (strcmp s "<<")) (return (cc-gop "<<")))
             (if (== 0 (strcmp s CC_GN_AND)) (return (cc-gop "bitand")))
             (if (== 0 (strcmp s CC_GN_OR)) (return (cc-gop "bitor")))
             (if (== 0 (strcmp s "xor")) (return (cc-gop "xor")))
             (return 0)))
        (if (and (== kind 0) (== n 1))
            (block
             (if (== 0 (strcmp s "-")) (return (cc-gop "neg")))
             (if (== 0 (strcmp s "+")) (return (cc-gop "pos")))
             (if (== 0 (strcmp s CC_GN_NOT)) (return (cc-gop "bitnot")))
             (if (== 0 (strcmp s "abs")) (return (cc-gop "abs")))
             (if (== 0 (strcmp s "sign")) (return (cc-gop "sign")))
             (return 0)))
        (if (and (== kind 1) (== n 2))
            (block
             (if (== 0 (strcmp s "<")) (return (cc-gop "<")))
             (if (== 0 (strcmp s ">")) (return (cc-gop ">")))
             (if (== 0 (strcmp s "=<")) (return (cc-gop "=<")))
             (if (== 0 (strcmp s ">=")) (return (cc-gop ">=")))
             (if (== 0 (strcmp s "=:=")) (return (cc-gop "=:=")))
             (if (== 0 (strcmp s CC_GN_NEQ)) (return (cc-gop "numneq")))
             (return 0)))
        (if (and (== kind 2) (== n 1))
            (block
             (if (== 0 (strcmp s "var")) (return (cc-gop "var")))
             (if (== 0 (strcmp s "nonvar")) (return (cc-gop "nonvar")))
             (if (== 0 (strcmp s "atom")) (return (cc-gop "atom")))
             (if (== 0 (strcmp s "integer")) (return (cc-gop "integer")))
             (if (== 0 (strcmp s "number")) (return (cc-gop "number")))
             (if (== 0 (strcmp s "atomic")) (return (cc-gop "atomic")))
             (if (== 0 (strcmp s "compound")) (return (cc-gop "compound")))
             (return 0)))
        (return 0))

  ;;; One more value on the guard's stack, of the sixteen it has.
  (static)
  (func cc_guard_push ((u32 * sp)) (out int)
        (set (cof sp) (+ (cof sp) 1))
        (return (? (<= (cof sp) 16) 1 0)))

  ;;; AN EXPRESSION AS STACK CODE: a variable met before this goal (a frame
  ;;; index under LIMIT), an integer, or an operator of `cc_guard_code' over
  ;;; expressions. 0 for anything else -- a float, an atom, a variable met
  ;;; first here (an instantiation error the goal will raise), an operator
  ;;; the guards do not evaluate -- and the goal is left to the step. DEPTH
  ;;; bounds the recursion, which is the expression's as the program wrote
  ;;; it.
  (static)
  (func cc_guard_expr ((coco_store * st) (coco_machine * m) (size_t t) (coco_varmap * vm)
                       (u32 limit) (coco_cbuf * b) (u32 depth) (u32 * sp)) (out int)
        (set t (coco_store_deref st t))
        (if (> depth 24) (return 0))
        (let ((u64 c . #'(nth t (-> st cells))))
          (cond
            ((coco-tag-is REF c)
             (let ((size_t k . 0))
               (if (!= 1 (coco_varmap_get vm t (aof k))) (return 0))
               (if (>= k (cast size_t limit)) (return 0))
               (if (not (cc_emit b (cc_word (cc_AG_LOAD) (cast u64 k) 0))) (return 0))
               (return (cc_guard_push sp))))
            ((coco-tag-is INT c)
             (if (not (cc_emit b (cc_word (cc_AG_PUSH) 0 0))) (return 0))
             (if (not (cc_emit b c)) (return 0))
             (return (cc_guard_push sp)))
            ((coco-tag-is FUN c)
             (let ((coco_functor * f . #'(aof (nth (cast size_t (coco-payload c)) (-> m functors))))
                   (u64 op . 0))
               (set op (cc_guard_code (coco_atom_name m (-> f name)) (-> f arity) 0))
               (if (== op 0) (return 0))
               (for ((u32 i . 0)) (< i (-> f arity)) ((++ i))
                 (if (not (cc_guard_expr st m (+ t (+ (cast size_t i) 1)) vm limit b (+ depth 1) sp))
                     (return 0)))
               (if (== (-> f arity) 2)
                   (block (if (not (cc_emit b (cc_word (cc_AG_BIN) op 0))) (return 0))
                          (set (cof sp) (- (cof sp) 1)))
                   (if (not (cc_emit b (cc_word (cc_AG_UN) op 0))) (return 0)))
               (return 1)))
            (#t (return 0)))))

  ;;; ONE GOAL AS A GUARD, if it is one: `X is E', a comparison of two
  ;;; expressions, or a type test of a variable met before it. LIMIT is how
  ;;; many variables were met before this goal (the head's and the earlier
  ;;; goals'): only the left of an `is' may be one met first here, and that
  ;;; one is written into the frame (AG_ISF) where the body would have made
  ;;; it a fresh variable -- its later goals read it there either way. 0,
  ;;; with nothing emitted, when the goal is not a guard.
  (static)
  (func cc_guard_goal ((coco_store * st) (coco_machine * m) (size_t t) (coco_varmap * vm)
                       (u32 limit) (coco_cbuf * b)) (out int)
        (let ((u64 c . 0) (u32 sp . 0) (size_t mark . #'(-> b len)) (int ok . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (if (not (coco-tag-is FUN c)) (return 0))
          (let ((coco_functor * f . #'(aof (nth (cast size_t (coco-payload c)) (-> m functors))))
                (const char * s . nil) (u64 cmp . 0) (u64 typ . 0))
            (set s (coco_atom_name m (-> f name)))
            (set cmp (cc_guard_code s (-> f arity) 1))
            (set typ (cc_guard_code s (-> f arity) 2))
            (cond
              ;; X is E: E, then the left -- a variable met before (bound,
              ;; or compared when it is bound), one met first here (made),
              ;; or an integer (compared)
              ((and (== (-> f arity) 2) (== 0 (strcmp s "is")))
               (if (cc_guard_expr st m (+ t 2) vm limit b 0 (aof sp))
                   (let ((size_t l . #'(coco_store_deref st (+ t 1)))
                         (u64 lc . 0) (size_t k . 0))
                     (set lc (nth l (-> st cells)))
                     (cond
                       ((coco-tag-is REF lc)
                        (if (== 1 (coco_varmap_get vm l (aof k)))
                            (set ok (cc_emit b (cc_word (? (>= k (cast size_t limit)) (cc_AG_ISF) (cc_AG_ISV))
                                                        (cast u64 k) 0)))))
                       ((coco-tag-is INT lc)
                        (set ok (and (cc_emit b (cc_word (cc_AG_ISC) 0 0)) (cc_emit b lc))))
                       (#t (block))))))
              ;; a comparison: both sides, then the test
              ((!= cmp 0)
               (if (and (cc_guard_expr st m (+ t 1) vm limit b 0 (aof sp))
                        (cc_guard_expr st m (+ t 2) vm limit b 0 (aof sp)))
                   (set ok (cc_emit b (cc_word (cc_AG_CMP) cmp 0)))))
              ;; a type test of a variable met before this goal
              ((!= typ 0)
               (let ((size_t v . #'(coco_store_deref st (+ t 1))) (size_t k . 0))
                 (if (and (coco-tag-is REF (nth v (-> st cells)))
                          (== 1 (coco_varmap_get vm v (aof k)))
                          (< k (cast size_t limit)))
                     (set ok (cc_emit b (cc_word (cc_AG_TYPE) (cast u64 k) typ))))))
              (#t (block))))
          (if (not ok) (set (-> b len) mark))
          (return ok)))

  ;;; THE GUARDS OF A BODY: its leading goals, while each is one and eight
  ;;; at most, compiled into one program (B). NVHEAD is how many variables
  ;;; the head numbered and NVAFTER the counts `cc_compile_body' kept, so
  ;;; goal I's limit is NVAFTER[I - 1], the head's for goal 0. Answers how
  ;;; many goals it took.
  (static)
  (func cc_compile_guards ((coco_store * st) (coco_machine * m) (size_t body) (coco_varmap * vm)
                           (u32 nvhead) (const u32 * nvafter) (u32 ngoals) (coco_cbuf * b)) (out u32)
        (let ((size_t g . #'(coco_store_deref st body)) (u32 count . 0)
              (u64 comma . #'(coco_intern m ",")))
          (while (and (< count 8) (< count ngoals))
            (let ((u64 c . #'(nth g (-> st cells))) (size_t goal . g) (int more . 0))
              (if (and (coco-tag-is FUN c)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) comma))
                  (block (set goal (+ g 1)) (set more 1)))
              (if (not (cc_guard_goal st m goal vm (? (== count 0) nvhead (nth (- count 1) nvafter)) b))
                  break)
              (set count (+ count 1))
              (if (not more) break)
              (set g (coco_store_deref st (+ g 2)))))
          (return count)))

  ;;; THE FIRST GOAL'S WORDS, TURNED FOR THE REGISTERS. W[FROM..TO) is the
  ;;; goal as `cc_compile_goal' emitted it; RB receives the same goal with
  ;;; its own slots turned into registers and every other offset taken from
  ;;; the start of ONE reservation for what is left: the nested structures
  ;;; and the constants where the term had them, less the header and the
  ;;; slots, then a cell for each variable first met as an argument of the
  ;;; goal itself -- in the term, the slot was that variable. 0, and RB
  ;;; empty, when the goal is not a structure or has more arguments than
  ;;; the registers hold.
  (static)
  (func cc_reg_form ((coco_machine * m) (const u64 * w) (size_t from) (size_t to)
                     (coco_cbuf * rb) (u64 * rfid) (u32 * rarity)) (out int)
        (let ((u64 w0 . 0) (u64 fid . 0) (u32 n . 0) (size_t top . 0) (size_t rest . 0)
              (size_t fresh . 0) (size_t pc . 0) (int ok . 1))
          (if (>= from to) (return 0))
          (set w0 (nth from w))
          (if (!= (cc_op w0) (cc_GOAL_STRUCT)) (return 0))
          (set fid (nth (+ from 1) w))
          (set n ($ (nth (cast size_t fid) (-> m functors)) arity))
          (if (or (== n 0) (> n (coco_regs_max))) (return 0))
          (set top (+ (cast size_t n) 1))
          (set rest (- (cast size_t (cc_n w0)) top))
          ;; the goal's own variables met first here, each a cell of its own
          (set pc (+ from 2))
          (while (< pc to)
            (let ((u64 x . #'(nth pc w)) (u64 op . 0))
              (set op (cc_op x))
              (set pc (+ pc 1))
              (cond
                ((or (== op (cc_ARG_CONST)) (== op (cc_ARG_STRUCT))) (set pc (+ pc 1)))
                ((== op (cc_ARG_VAR_1))
                 (if (< (cast size_t (cc_n x)) top) (set fresh (+ fresh 1)))))))
          ;; the reservation, when there is anything to reserve: a goal whose
          ;; arguments are all variables met before -- `app(T, L, R)' --
          ;; is its RARG_VAR words and nothing else
          (if (> (+ rest fresh) 0)
              (if (not (cc_emit rb (cc_word (cc_RGOAL) (cast u64 n) (cast u64 (+ rest fresh))))) (set ok 0)))
          (set fresh 0)
          (set pc (+ from 2))
          (while (and ok (< pc to))
            (let ((u64 x . #'(nth pc w)) (u64 op . 0) (size_t k . 0) (size_t nn . 0))
              (set op (cc_op x))
              (set k (cc_k x))
              (set nn (cast size_t (cc_n x)))
              (set pc (+ pc 1))
              (cond
                ;; ARG_CONST and ARG_STRUCT: K the slot, N the cell
                ((or (== op (cc_ARG_CONST)) (== op (cc_ARG_STRUCT)))
                 (if (< k top)
                     (set ok (cc_emit rb (cc_word (? (== op (cc_ARG_CONST)) (cc_RARG_CONST) (cc_RARG_STRUCT))
                                                  (cast u64 (- k 1)) (cast u64 (- nn top)))))
                     (set ok (cc_emit rb (cc_word op (cast u64 (- k top)) (cast u64 (- nn top))))))
                 (if ok (set ok (cc_emit rb (nth pc w))))
                 (set pc (+ pc 1)))
                ;; ARG_VAR: K the frame index, N the slot
                ((== op (cc_ARG_VAR))
                 (if (< nn top)
                     (set ok (cc_emit rb (cc_word (cc_RARG_VAR) (cast u64 k) (cast u64 (- nn 1)))))
                     (set ok (cc_emit rb (cc_word op (cast u64 k) (cast u64 (- nn top)))))))
                ((== op (cc_ARG_VAR_1))
                 (if (< nn top)
                     (block
                      (set ok (cc_emit rb (cc_word (cc_RARG_VAR_1) (cast u64 k) (cast u64 (- nn 1)))))
                      (if ok (set ok (cc_emit rb (cast u64 (+ rest fresh)))))
                      (set fresh (+ fresh 1)))
                     (set ok (cc_emit rb (cc_word op (cast u64 k) (cast u64 (- nn top)))))))
                (#t (set ok 0)))))
          (if (not ok) (block (set (-> rb len) 0) (return 0)))
          (set (cof rfid) fid)
          (set (cof rarity) n)
          (return 1)))

  ;;; WHETHER THE REGISTERS PAY FOR A GOAL OF FUNCTOR FID: they do for a
  ;;; call the step can try from them, one with a single candidate, and
  ;;; cost a goal term built from them for any other. A predicate with two
  ;;; clauses or more whose first argument is a variable leaves two
  ;;; candidates for EVERY call, so its goal is built as the term it always
  ;;; was: queens' select/3 and safe/3 were 1.4 % dearer an inference with
  ;;; their calls in registers. Asked once, when the clause is compiled; a
  ;;; predicate the store does not have yet, or has not fetched, is given
  ;;; the benefit of the doubt, and one that changes after is only a
  ;;; little slower, never wrong.
  (static)
  (func cc_regs_worth ((coco_store * st) (coco_machine * m) (u64 fid)) (out int)
        (let ((coco_functor * f . #'(aof (nth (cast size_t fid) (-> m functors))))
              (size_t pi . #'(coco_pred_find st (-> f name) (-> f arity)))
              (size_t nv . 0))
          (if (>= pi (-> st npreds)) (return 1))
          (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
            (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
              (if (== (nth i (-> p keys)) 0)
                  (block (set nv (+ nv 1))
                         (if (>= nv 2) (return 0))))))
          (return 1)))

  ;;; ---- environments (Stage 5 of compiled control) --------------------------
  ;;;
  ;;; A BODY'S LATER GOALS WERE BUILT WHEN ITS CLAUSE WAS ENTERED: every goal
  ;;; after the first a term on the heap with a four-cell `'$k'' frame of its
  ;;; own, each taken apart again by a step of its own -- dereferenced, its
  ;;; name and its stamp asked, then called. A call among them is a term
  ;;; built only to be read back into arguments. Now a body with a call or a
  ;;; cut among its later goals writes ONE environment when it is entered:
  ;;; its code, the continuation it returns to, its goals' cut barrier, a
  ;;; slot for each variable a later call reads and one for each later goal
  ;;; that is still a term -- a builtin, a construct -- built at entry as it
  ;;; always was -- and a position cell per later goal. The continuation
  ;;; becomes the first position, and the step goes on from there
  ;;; (`coco_env_take' in solve.cicili): a call is written into the
  ;;; registers from the slots and tried as a first goal is, a cut cuts to
  ;;; the barrier, and a term is taken from its slot and dispatched as a
  ;;; frame's goal was. A continuation is still ONE cell wherever it is
  ;;; kept, and a step that pops a frame tests one tag, as before. The
  ;;; environment is an ordinary compound on the heap, so backtracking
  ;;; takes it with the rest and the collector moves it like any other --
  ;;; and keeps the whole of it from any of its positions (`coco_gc_mark');
  ;;; its code is an integer the collector does not follow. A frozen
  ;;; machine carries none: a freeze builds the goals the positions stand
  ;;; for (`coco_engine_materialize').

  ;;; ENVIRONMENTS ARE ON unless `COCOLOG_ENV' says 0 -- the stage's arm,
  ;;; and the switch the engine's cases run under to hold both forms of a
  ;;; body to one answer. Read at the first compile, so it costs a clause
  ;;; entry nothing.
  (static) (var int cc_env_state . 0)

  (static)
  (func cc_env_enabled () (out int)
        (if (== cc_env_state 0)
            (let ((const char * s . #'(getenv "COCOLOG_ENV")))
              (set cc_env_state (? (and (!= s nil) (== 0 (strcmp s "0"))) 2 1))))
        (return (? (== cc_env_state 1) 1 0)))

  ;;; THE BUILTINS IN PLACE (Stage 7) are on unless `COCOLOG_INPLACE' says
  ;;; 0, the stage's arm, read at the first compile as the one above is.
  (static) (var int cc_inplace_state . 0)

  (static)
  (func cc_inplace_enabled () (out int)
        (if (== cc_inplace_state 0)
            (let ((const char * s . #'(getenv "COCOLOG_INPLACE")))
              (set cc_inplace_state (? (and (!= s nil) (== 0 (strcmp s "0"))) 2 1))))
        (return (? (== cc_inplace_state 1) 1 0)))

  ;;; THE FUSED GUARD WORDS (AG_ISX, AG_CMPX) are on unless `COCOLOG_FUSE'
  ;;; says 0, their arm, read at the first compile as the two above are.
  (static) (var int cc_fuse_state . 0)

  (static)
  (func cc_fuse_enabled () (out int)
        (if (== cc_fuse_state 0)
            (let ((const char * s . #'(getenv "COCOLOG_FUSE")))
              (set cc_fuse_state (? (and (!= s nil) (== 0 (strcmp s "0"))) 2 1))))
        (return (? (== cc_fuse_state 1) 1 0)))

  ;;; WHETHER A LATER GOAL OF FUNCTOR FID IS REACHED AS A CALL: a predicate
  ;;; of the program's own -- not a construct's name, not a core builtin's
  ;;; -- of one to eight arguments, whose call the registers pay for
  ;;; (`cc_regs_worth'). Anything else is built at entry as it always was.
  ;;; A module's predicate cannot be told from here, and is built from the
  ;;; environment when it is reached (`coco_env_take').
  (static)
  (func cc_env_callable ((coco_store * st) (coco_machine * m) (u64 fid)) (out int)
        (let ((u64 name . #'($ (nth (cast size_t fid) (-> m functors)) name))
              (u32 arity . #'($ (nth (cast size_t fid) (-> m functors)) arity)))
          (if (or (== arity 0) (> arity (coco_regs_max))) (return 0))
          (if (not (-> m ids_ready)) (return 0))
          (if (coco_is_construct m name) (return 0))
          (if (>= (coco_builtin_index m name arity) 0) (return 0))
          (return (cc_regs_worth st m fid))))

  ;;; THE UNITS OF A BODY (Stages 5 and 6), compiled from the clause's own
  ;;; term in a second pass with a variable map of its own: the head again,
  ;;; then the body's goals in the order `cc_compile_body' took them, each
  ;;; goal depth first as `cc_compile_goal' walks one -- so every variable
  ;;; gets the frame index it got there, which the end of the pass checks.
  ;;; A unit is what one `'$k'' frame held through 1.9.2 (`coco_egoal'): a
  ;;; goal of the body after its first, or a construct's condition, branch,
  ;;; item or own `$cut', `$true' and `$fail'. A goal that is a term is
  ;;; built at entry by the entry program XBODY, in that order, its root
  ;;; kept in the environment's next term slot; a call's first-met
  ;;; variables are made there as FRESH words, and every variable it reads
  ;;; gets a slot. So every variable is made in the order the body made it,
  ;;; and nothing a construct writes around its goals -- the `;', the `->',
  ;;; the `,' -- is built at all. US holds the units from 1; XB, EB, GB, TB
  ;;; and RB the entry program, the calls' programs, one goal's words, one
  ;;; call's words over the slots and its register form, and QB a guard's
  ;;; program (Stage 7); EMAP and EINIT the variable slots (NEMAP the
  ;;; frame's size); the atoms the constructs are told by, and the
  ;;; functors a freeze builds two of them back with.
  (struct coco_ucomp
    (member coco_store * st)
    (member coco_machine * m)
    (member coco_varmap * vm)
    (member u32 nvars)
    (member coco_egoal * us)
    (member u32 nu)
    (member u32 ucap)
    (member coco_cbuf xb)
    (member coco_cbuf eb)
    (member coco_cbuf gb)
    (member coco_cbuf tb)
    (member coco_cbuf rb)
    (member coco_cbuf qb)
    (member u32 * emap)
    (member u32 * einit)
    (member u32 nemap)
    (member u32 nes)
    (member u32 nterm)
    (member u32 nslot)
    (member u32 ncons)
    (member u32 depth)
    (member int ok)
    (member u64 n_semi)
    (member u64 n_arrow)
    (member u64 n_soft)
    (member u64 n_neg)
    (member u64 n_not)
    (member u64 n_once)
    (member u64 n_ignore)
    (member u64 n_comma)
    (member u64 n_true)
    (member u64 n_fail)
    (member u64 n_false)
    (member u64 n_cut)
    (member u64 n_dtrue)
    (member u64 n_dfail)
    (member u64 f_cut))

  ;;; A new unit of KIND, all else 0; 0 when the table would not grow.
  (static)
  (func cc_unew ((coco_ucomp * uc) (u32 kind)) (out u32)
        (if (>= (+ (-> uc nu) 1) (-> uc ucap))
            (let ((u32 ncap . #'(? (== (-> uc ucap) 0) 16 (* (-> uc ucap) 2)))
                  (void * nb . #'(realloc (cast (void *) (-> uc us)) (* (cast size_t ncap) (sizeof coco_egoal)))))
              (if (== nb nil) (block (set (-> uc ok) 0) (return 0)))
              (set (-> uc us) (cast (coco_egoal *) nb))
              (set (-> uc ucap) ncap)))
        (set (-> uc nu) (+ (-> uc nu) 1))
        (memset (cast (void *) (aof (nth (-> uc nu) (-> uc us)))) 0 (sizeof coco_egoal))
        (set ($ (nth (-> uc nu) (-> uc us)) kind) kind)
        (return (-> uc nu)))

  ;;; A construct's own `$true' or `$fail', which nothing wrote: ATOM is
  ;;; the one its frame held.
  (static)
  (func cc_usyn ((coco_ucomp * uc) (u32 kind) (u64 atom)) (out u32)
        (let ((u32 u . #'(cc_unew uc kind)))
          (if (!= u 0) (set ($ (nth u (-> uc us)) fid) atom))
          (return u)))

  ;;; A GOAL'S WORDS OVER THE ENVIRONMENT'S SLOTS (Stages 5 and 7): W[0,
  ;;; LEN), as `cc_compile_goal' emitted them, into TB with each variable an
  ;;; ARG_VAR of its slot -- every variable the goal has gets one -- and
  ;;; each it meets first made at entry, a FRESH word in the entry program.
  ;;; A call's are made in the order its words name them (Stage 5); BYCELL
  ;;; makes them in the order of the cells its term gave them (Stage 7), so
  ;;; that a builtin's variables stand where its term made them, in the
  ;;; order `compare/3' sees unbound variables in -- 64 of them at most: 0
  ;;; past that, with none made and OK still set.
  (static)
  (func cc_uslots ((coco_ucomp * uc) (const u64 * w) (size_t len) (int bycell)) (out int)
        (let ((size_t pc . 0) (u32 fk [64]) (u32 fn [64]) (u32 nf . 0))
          (set ($ (-> uc tb) len) 0)
          (while (and (-> uc ok) (< pc len))
            (let ((u64 x . #'(nth pc w)) (u64 op . 0))
              (set op (cc_op x))
              (set pc (+ pc 1))
              (if (or (== op (cc_ARG_VAR)) (== op (cc_ARG_VAR_1)))
                  (let ((size_t k . #'(cc_k x)))
                    (if (>= k (cast size_t (-> uc nemap)))
                        (block (set (-> uc ok) 0) (return 0)))
                    (if (== op (cc_ARG_VAR_1))
                        (if bycell
                            (block (if (>= nf 64) (return 0))
                                   (set (nth nf fk) (cast u32 k))
                                   (set (nth nf fn) (cast u32 (cc_n x)))
                                   (set nf (+ nf 1)))
                            (if (not (cc_emit (aof (-> uc xb)) (cc_word (cc_FRESH) (cast u64 k) 0)))
                                (set (-> uc ok) 0))))
                    (if (== (nth k (-> uc emap)) 0)
                        (block (set (nth (-> uc nes) (-> uc einit)) (cast u32 k))
                               (set (-> uc nes) (+ (-> uc nes) 1))
                               (set (nth k (-> uc emap)) (-> uc nes))))
                    (if (not (cc_emit (aof (-> uc tb)) (cc_word (cc_ARG_VAR)
                                                                (cast u64 (- (nth k (-> uc emap)) 1))
                                                                (cc_n x))))
                        (set (-> uc ok) 0)))
                  (block
                   (if (not (cc_emit (aof (-> uc tb)) x)) (set (-> uc ok) 0))
                   ;; and the functor or the constant after it
                   (if (or (== op (cc_GOAL_STRUCT)) (== op (cc_ARG_CONST)) (== op (cc_ARG_STRUCT)))
                       (block (if (not (cc_emit (aof (-> uc tb)) (nth pc w))) (set (-> uc ok) 0))
                              (set pc (+ pc 1))))))))
          ;; the ones met first, made in the order of their cells
          (while (and (-> uc ok) (> nf 0))
            (let ((u32 best . 0))
              (for ((u32 j . 1)) (< j nf) ((++ j))
                (if (< (nth j fn) (nth best fn)) (set best j)))
              (if (not (cc_emit (aof (-> uc xb)) (cc_word (cc_FRESH) (cast u64 (nth best fk)) 0)))
                  (set (-> uc ok) 0))
              (set nf (- nf 1))
              (set (nth best fk) (nth nf fk))
              (set (nth best fn) (nth nf fn))))
          (return (-> uc ok))))

  ;;; WHETHER A GOAL OF FUNCTOR FID IS A BUILTIN DONE IN PLACE (Stage 7),
  ;;; its words compiled with LIMIT variables met before it: a GUARD when
  ;;; `cc_guard_goal' takes it, its program left in QB over the frame's
  ;;; numbering; a SIDES for `=/2', `==/2' and `\==/2', FORM 0, 1 and 2; a
  ;;; BUILTIN for any other core builtin with arguments, FORM its row; and
  ;;; a TERM for anything else.
  (static)
  (func cc_uplace ((coco_ucomp * uc) (size_t t) (u64 fid) (u32 limit) (u32 * form)) (out u32)
        (let ((coco_machine * m . #'(-> uc m))
              (u64 name . #'($ (nth (cast size_t fid) (-> m functors)) name))
              (u32 arity . #'($ (nth (cast size_t fid) (-> m functors)) arity))
              (const char * s . nil) (int row . -1))
          (set ($ (-> uc qb) len) 0)
          (if (cc_guard_goal (-> uc st) m t (-> uc vm) limit (aof (-> uc qb)))
              (return (cc-eg "GUARD")))
          (set ($ (-> uc qb) len) 0)
          (if (or (== arity 0) (not (-> m ids_ready)) (coco_is_construct m name))
              (return (cc-eg "TERM")))
          (if (== arity 2)
              (block
               (set s (coco_atom_name m name))
               (if (== 0 (strcmp s "=")) (block (set (cof form) 0) (return (cc-eg "SIDES"))))
               (if (== 0 (strcmp s "==")) (block (set (cof form) 1) (return (cc-eg "SIDES"))))
               (if (== 0 (strcmp s CC_GN_NEQEQ)) (block (set (cof form) 2) (return (cc-eg "SIDES"))))))
          (set row (coco_builtin_index m name arity))
          (if (< row 0) (return (cc-eg "TERM")))
          (set (cof form) (cast u32 row))
          (return (cc-eg "BUILTIN"))))

  ;;; ONE WORD FOR A GUARD OF TWO OPERANDS: QB as `X is A op B' over `+',
  ;;; `-' or `*' with X a variable -- [LOAD a | PUSH c] twice, [BIN op],
  ;;; [ISV x | ISF x] -- or as a comparison of two -- the two, [CMP c] -- is
  ;;; written into EB as AG_ISX or AG_CMPX, its K the slot of X, its N the
  ;;; operator's code with 256 for an A that is an integer and 512 for a B,
  ;;; then A and B: each its slot, or its cell. 1 when it took QB (with OK
  ;;; clear when a variable has no slot, as `cc_uguard' refuses it), 0 when
  ;;; QB is any other shape, nothing written. What the stack program
  ;;; dispatched as four words is then one, and its unit a GUARDX
  ;;; (`cc_uleaf', `coco_env_guardx').
  (static)
  (func cc_ufuse ((coco_ucomp * uc)) (out int)
        (let ((u64 * q . #'($ (-> uc qb) w)) (size_t qn . #'($ (-> uc qb) len)) (size_t pc . 0)
              (u64 opd [2]) (u64 fl . 0) (u64 op . 0) (u64 code . 0) (u64 xs . 0))
          (for ((u32 i . 0)) (< i 2) ((++ i))
            (if (>= pc qn) (return 0))
            (cond
              ((== (cc_op (nth pc q)) (cc_AG_LOAD))
               (set (nth i opd) (cast u64 (cc_k (nth pc q))))
               (set pc (+ pc 1)))
              ((and (== (cc_op (nth pc q)) (cc_AG_PUSH)) (< (+ pc 1) qn))
               (set (nth i opd) (nth (+ pc 1) q))
               (set fl (bitor fl (<< (cast u64 256) i)))
               (set pc (+ pc 2)))
              (#t (return 0))))
          (if (>= pc qn) (return 0))
          (set code (cast u64 (cc_k (nth pc q))))
          (cond
            ((and (== (cc_op (nth pc q)) (cc_AG_BIN))
                  (or (== code (cc-gop "+")) (== code (cc-gop "-")) (== code (cc-gop "*")))
                  (== (+ pc 2) qn)
                  (or (== (cc_op (nth (+ pc 1) q)) (cc_AG_ISV)) (== (cc_op (nth (+ pc 1) q)) (cc_AG_ISF))))
             (let ((size_t k . #'(cc_k (nth (+ pc 1) q))))
               (if (or (>= k (cast size_t (-> uc nemap))) (== (nth k (-> uc emap)) 0))
                   (block (set (-> uc ok) 0) (return 1)))
               (set xs (cast u64 (- (nth k (-> uc emap)) 1)))
               (set op (cc_AG_ISX))))
            ((and (== (cc_op (nth pc q)) (cc_AG_CMP)) (== (+ pc 1) qn))
             (set op (cc_AG_CMPX)))
            (#t (return 0)))
          ;; each variable its slot
          (for ((u32 i . 0)) (< i 2) ((++ i))
            (if (not (bitand fl (<< (cast u64 256) i)))
                (let ((size_t k . #'(cast size_t (nth i opd))))
                  (if (or (>= k (cast size_t (-> uc nemap))) (== (nth k (-> uc emap)) 0))
                      (block (set (-> uc ok) 0) (return 1)))
                  (set (nth i opd) (cast u64 (- (nth k (-> uc emap)) 1))))))
          (if (not (cc_emit (aof (-> uc eb)) (cc_word op xs (bitor code fl)))) (set (-> uc ok) 0))
          (if (not (cc_emit (aof (-> uc eb)) (nth 0 opd))) (set (-> uc ok) 0))
          (if (not (cc_emit (aof (-> uc eb)) (nth 1 opd))) (set (-> uc ok) 0))
          (return 1)))

  ;;; A GUARD'S PROGRAM OVER THE SLOTS (Stage 7): QB's words, numbered by
  ;;; the frame, into EB with each variable its slot -- every variable of
  ;;; the goal has one by now (`cc_uslots') -- and the left of an `is' met
  ;;; first here bound where the environment made it: AG_ISV, not AG_ISF.
  ;;; One word when it can be (`cc_ufuse'), under `COCOLOG_FUSE'.
  (static)
  (func cc_uguard ((coco_ucomp * uc)) (out int)
        (if (and (cc_fuse_enabled) (cc_ufuse uc)) (return (-> uc ok)))
        (let ((u64 * q . #'($ (-> uc qb) w)) (size_t qn . #'($ (-> uc qb) len)) (size_t pc . 0))
          (while (and (-> uc ok) (< pc qn))
            (let ((u64 x . #'(nth pc q)) (u64 op . 0))
              (set op (cc_op x))
              (set pc (+ pc 1))
              (cond
                ((or (== op (cc_AG_LOAD)) (== op (cc_AG_TYPE)) (== op (cc_AG_ISV)) (== op (cc_AG_ISF)))
                 (let ((size_t k . #'(cc_k x)))
                   (if (or (>= k (cast size_t (-> uc nemap))) (== (nth k (-> uc emap)) 0))
                       (block (set (-> uc ok) 0) (return 0)))
                   (if (not (cc_emit (aof (-> uc eb))
                                     (cc_word (? (== op (cc_AG_ISF)) (cc_AG_ISV) op)
                                              (cast u64 (- (nth k (-> uc emap)) 1)) (cc_n x))))
                       (set (-> uc ok) 0))))
                ((or (== op (cc_AG_PUSH)) (== op (cc_AG_ISC)))
                 (if (not (cc_emit (aof (-> uc eb)) x)) (set (-> uc ok) 0))
                 (if (not (cc_emit (aof (-> uc eb)) (nth pc q))) (set (-> uc ok) 0))
                 (set pc (+ pc 1)))
                (#t (if (not (cc_emit (aof (-> uc eb)) x)) (set (-> uc ok) 0))))))
          (return (-> uc ok))))

  ;;; A GOAL THAT IS NO CONSTRUCT: a CALL when its predicate is the
  ;;; program's own and the registers pay (`cc_env_callable'); a builtin
  ;;; done in place (Stage 7, `cc_uplace'): a GUARD or a SIDES over the
  ;;; slots, or a BUILTIN, a TERM its step calls by its row; a TERM built
  ;;; at entry otherwise.
  (static)
  (func cc_uleaf ((coco_ucomp * uc) (size_t t)) (out u32)
        (let ((coco_store * st . #'(-> uc st)) (coco_machine * m . #'(-> uc m))
              (u64 * w . nil) (size_t len . 0) (u32 u . 0)
              (u32 limit . #'(-> uc nvars)) (u32 kind . 0) (u32 form . 0))
          (set ($ (-> uc gb) len) 0)
          (if (not (cc_compile_goal st m t (-> uc vm) (aof (-> uc nvars)) (aof (-> uc gb))))
              (block (set (-> uc ok) 0) (return 0)))
          (set w ($ (-> uc gb) w))
          (set len ($ (-> uc gb) len))
          (set kind (cc-eg "TERM"))
          (if (== (cc_op (nth 0 w)) (cc_GOAL_STRUCT))
              (cond
                ((cc_env_callable st m (nth 1 w)) (set kind (cc-eg "CALL")))
                ((cc_inplace_enabled) (set kind (cc_uplace uc t (nth 1 w) limit (aof form))))))
          ;; a call, two sides or a guard: its words over the slots, its
          ;; first-met variables made at entry in its place -- in the order
          ;; its term made them, for the builtins; one with more of those
          ;; than that keeps track of is a term
          (if (and (or (== kind (cc-eg "CALL")) (== kind (cc-eg "SIDES")) (== kind (cc-eg "GUARD")))
                   (not (cc_uslots uc w len (!= kind (cc-eg "CALL")))))
              (block (if (not (-> uc ok)) (return 0))
                     (set kind (cc-eg "TERM"))))
          (if (or (== kind (cc-eg "CALL")) (== kind (cc-eg "SIDES")))
              (let ((u64 fid . 0) (u32 arity . 0))
                ;; and its register form, which `cc_env_callable' or the
                ;; arity has said there is: only memory makes this fail
                (set ($ (-> uc rb) len) 0)
                (if (not (and (-> uc ok)
                              (cc_reg_form m ($ (-> uc tb) w) 0 ($ (-> uc tb) len) (aof (-> uc rb))
                                           (aof fid) (aof arity))))
                    (block (set (-> uc ok) 0) (return 0)))
                (set u (cc_unew uc kind))
                (if (== u 0) (return 0))
                (set ($ (nth u (-> uc us)) fid) fid)
                (set ($ (nth u (-> uc us)) arity) arity)
                (set ($ (nth u (-> uc us)) form) form)
                (set ($ (nth u (-> uc us)) tat) (cast u32 ($ (-> uc eb) len)))
                (set ($ (nth u (-> uc us)) tlen) (cast u32 ($ (-> uc tb) len)))
                (for ((size_t j . 0)) (and (-> uc ok) (< j ($ (-> uc tb) len))) ((++ j))
                  (if (not (cc_emit (aof (-> uc eb)) (nth j ($ (-> uc tb) w)))) (set (-> uc ok) 0)))
                (set ($ (nth u (-> uc us)) rat) (cast u32 ($ (-> uc eb) len)))
                (set ($ (nth u (-> uc us)) rlen) (cast u32 ($ (-> uc rb) len)))
                (for ((size_t j . 0)) (and (-> uc ok) (< j ($ (-> uc rb) len))) ((++ j))
                  (if (not (cc_emit (aof (-> uc eb)) (nth j ($ (-> uc rb) w)))) (set (-> uc ok) 0)))
                (return u)))
          (if (== kind (cc-eg "GUARD"))
              (block
               (set u (cc_unew uc kind))
               (if (== u 0) (return 0))
               (set ($ (nth u (-> uc us)) fid) (nth 1 w))
               (set ($ (nth u (-> uc us)) arity) ($ (nth (cast size_t (nth 1 w)) (-> m functors)) arity))
               ;; its term over the slots, for when the program cannot decide
               (set ($ (nth u (-> uc us)) tat) (cast u32 ($ (-> uc eb) len)))
               (set ($ (nth u (-> uc us)) tlen) (cast u32 ($ (-> uc tb) len)))
               (for ((size_t j . 0)) (and (-> uc ok) (< j ($ (-> uc tb) len))) ((++ j))
                 (if (not (cc_emit (aof (-> uc eb)) (nth j ($ (-> uc tb) w)))) (set (-> uc ok) 0)))
               ;; and its program over them, a GUARDX when that is one
               ;; fused word
               (set ($ (nth u (-> uc us)) rat) (cast u32 ($ (-> uc eb) len)))
               (if (not (cc_uguard uc)) (return 0))
               (set ($ (nth u (-> uc us)) rlen) (- (cast u32 ($ (-> uc eb) len)) ($ (nth u (-> uc us)) rat)))
               (if (> ($ (nth u (-> uc us)) rlen) 0)
                   (let ((u64 x . #'(nth ($ (nth u (-> uc us)) rat) ($ (-> uc eb) w))))
                     (if (or (== (cc_op x) (cc_AG_ISX)) (== (cc_op x) (cc_AG_CMPX)))
                         (set ($ (nth u (-> uc us)) kind) (cc-eg "GUARDX")))))
               (return u)))
          ;; a term: built at entry over the frame, as before -- a BUILTIN
          ;; is one, called by its row
          (set u (cc_unew uc kind))
          (if (== u 0) (return 0))
          (set ($ (nth u (-> uc us)) form) form)
          (set ($ (nth u (-> uc us)) tslot) (-> uc nterm))
          (set (-> uc nterm) (+ (-> uc nterm) 1))
          (for ((size_t j . 0)) (and (-> uc ok) (< j len)) ((++ j))
            (if (not (cc_emit (aof (-> uc xb)) (nth j w))) (set (-> uc ok) 0)))
          (return u)))

  (static) (decl) (func cc_ubranch ((coco_ucomp * uc) (size_t t)) (out u32))

  ;;; WHICH CONSTRUCT A GOAL IS, as a unit compiles it (Stage 6): 0 to 4
  ;;; the five forms of an if-then-else (`coco_egoal'), 9 a disjunction, -1
  ;;; none -- an `( C *-> T ; E )' among them, which stays a term. CT, TT and
  ;;; ET are where its condition, then and else are, F2 the `->'.
  (static)
  (func cc_uform ((coco_ucomp * uc) (size_t t) (size_t * ct) (size_t * tt) (size_t * et)
                  (u64 * f2)) (out int)
        (let ((coco_store * st . #'(-> uc st)) (coco_machine * m . #'(-> uc m))
              (u64 c . #'(nth t (-> st cells))) (u64 nm . 0) (u32 ar . 0))
          (if (not (coco-tag-is FUN c)) (return -1))
          (set nm ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name))
          (set ar ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity))
          (if (and (== ar 2) (== nm (-> uc n_semi)))
              (let ((size_t l . #'(coco_store_deref st (+ t 1))) (u64 lc . 0))
                (set lc (nth l (-> st cells)))
                (if (and (coco-tag-is FUN lc)
                         (== ($ (nth (cast size_t (coco-payload lc)) (-> m functors)) arity) 2))
                    (let ((u64 ln . #'($ (nth (cast size_t (coco-payload lc)) (-> m functors)) name)))
                      (if (== ln (-> uc n_arrow))
                          (block (set (cof ct) (+ l 1)) (set (cof tt) (+ l 2)) (set (cof et) (+ t 2))
                                 (set (cof f2) (coco-payload lc))
                                 (return 0)))
                      (if (== ln (-> uc n_soft)) (return -1))))
                (set (cof ct) (+ t 1)) (set (cof tt) (+ t 2))
                (return 9)))
          (if (and (== ar 2) (== nm (-> uc n_arrow)))
              (block (set (cof ct) (+ t 1)) (set (cof tt) (+ t 2)) (return 1)))
          (if (and (== ar 1) (or (== nm (-> uc n_neg)) (== nm (-> uc n_not))))
              (block (set (cof ct) (+ t 1)) (return 2)))
          (if (and (== ar 1) (== nm (-> uc n_once)))
              (block (set (cof ct) (+ t 1)) (return 3)))
          (if (and (== ar 1) (== nm (-> uc n_ignore)))
              (block (set (cof ct) (+ t 1)) (return 4)))
          (return -1)))

  ;;; ONE UNIT: a cut, `true' or `fail'; a construct, its parts compiled in
  ;;; the order they were written; or a goal that is neither
  ;;; (`cc_uleaf'). Constructs nested past 64 stay terms.
  (static)
  (func cc_unit ((coco_ucomp * uc) (size_t t)) (out u32)
        (let ((coco_store * st . #'(-> uc st))
              (u64 c . 0) (u32 u . 0) (int form . -1)
              (size_t ct . 0) (size_t tt . 0) (size_t et . 0) (u64 f2 . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (if (coco-tag-is ATOM c)
              (let ((u64 a . #'(coco-payload c)) (u32 kind . 99))
                (cond ((== a (-> uc n_true)) (set kind (cc-eg "TRUE")))
                      ((or (== a (-> uc n_fail)) (== a (-> uc n_false))) (set kind (cc-eg "FAIL")))
                      ((== a (-> uc n_cut)) (set kind (cc-eg "CUT"))))
                (if (!= kind 99)
                    (block (set u (cc_usyn uc kind a))
                           (return u)))))
          (if (< (-> uc depth) 64) (set form (cc_uform uc t (aof ct) (aof tt) (aof et) (aof f2))))
          (if (== form 9)
              ;; ( C ; D )
              (block
               (set u (cc_unew uc (cc-eg "DISJ")))
               (if (== u 0) (return 0))
               (set ($ (nth u (-> uc us)) fid) (coco-payload c))
               (set (-> uc depth) (+ (-> uc depth) 1))
               (let ((u32 x . #'(cc_ubranch uc ct))) (set ($ (nth u (-> uc us)) a) x))
               (let ((u32 y . #'(cc_ubranch uc tt))) (set ($ (nth u (-> uc us)) b) y))
               (set (-> uc depth) (- (-> uc depth) 1))
               (set (-> uc ncons) (+ (-> uc ncons) 1))
               (return u)))
          (if (>= form 0)
              ;; an if-then-else, written one of five ways: its condition,
              ;; then its then and else -- written, or the `$true' and
              ;; `$fail' `coco_ite' gave the forms that write neither -- and
              ;; the cut after the condition
              (block
               (set u (cc_unew uc (cc-eg "ITE")))
               (if (== u 0) (return 0))
               (set ($ (nth u (-> uc us)) fid) (coco-payload c))
               (set ($ (nth u (-> uc us)) fid2) f2)
               (set ($ (nth u (-> uc us)) form) (cast u32 form))
               (set ($ (nth u (-> uc us)) tslot) (-> uc nslot))
               (set (-> uc nslot) (+ (-> uc nslot) 1))
               (set (-> uc depth) (+ (-> uc depth) 1))
               (let ((u32 x . #'(cc_ubranch uc ct))) (set ($ (nth u (-> uc us)) a) x))
               (if (<= form 1)
                   (let ((u32 y . #'(cc_ubranch uc tt))) (set ($ (nth u (-> uc us)) b) y))
                   (let ((u32 y . #'(cc_usyn uc (? (== form 2) (cc-eg "FAIL") (cc-eg "TRUE"))
                                               (? (== form 2) (-> uc n_dfail) (-> uc n_dtrue)))))
                     (set ($ (nth u (-> uc us)) b) y)))
               (if (== form 0)
                   (let ((u32 z . #'(cc_ubranch uc et))) (set ($ (nth u (-> uc us)) c) z))
                   (let ((int yes . #'(or (== form 2) (== form 4))))
                     (let ((u32 z . #'(cc_usyn uc (? yes (cc-eg "TRUE") (cc-eg "FAIL"))
                                               (? yes (-> uc n_dtrue) (-> uc n_dfail)))))
                       (set ($ (nth u (-> uc us)) c) z))))
               (let ((u32 d . #'(cc_usyn uc (cc-eg "CUTC") (-> uc f_cut))))
                 (if (!= d 0)
                     (block (set ($ (nth d (-> uc us)) tslot) ($ (nth u (-> uc us)) tslot))
                            (set ($ (nth u (-> uc us)) d) d))))
               (set (-> uc depth) (- (-> uc depth) 1))
               (set (-> uc ncons) (+ (-> uc ncons) 1))
               (return u)))
          (return (cc_uleaf uc t))))

  ;;; ONE FRAME'S WORTH: a `,' -- one step takes it apart into its items,
  ;;; up to 63 and the rest as one, as `coco_k_push_body' does -- or one
  ;;; unit.
  (static)
  (func cc_ubranch ((coco_ucomp * uc) (size_t t)) (out u32)
        (let ((coco_store * st . #'(-> uc st)) (coco_machine * m . #'(-> uc m))
              (u64 c . 0) (u32 u . 0) (u32 last . 0) (u32 n . 0) (size_t g . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (if (not (and (coco-tag-is FUN c) (< (-> uc depth) 64)
                        (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                        (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) (-> uc n_comma))))
              (return (cc_unit uc t)))
          (set u (cc_unew uc (cc-eg "CONJ")))
          (if (== u 0) (return 0))
          (set ($ (nth u (-> uc us)) fid) (coco-payload c))
          (set (-> uc depth) (+ (-> uc depth) 1))
          (set g t)
          (while (and (-> uc ok) (< n 63)
                      (coco-tag-is FUN (nth g (-> st cells)))
                      (== ($ (nth (cast size_t (coco-payload (nth g (-> st cells)))) (-> m functors)) arity) 2)
                      (== ($ (nth (cast size_t (coco-payload (nth g (-> st cells)))) (-> m functors)) name)
                          (-> uc n_comma)))
            (let ((u32 x . #'(cc_ubranch uc (+ g 1))))
              (if (== last 0) (set ($ (nth u (-> uc us)) a) x) (set ($ (nth last (-> uc us)) sib) x))
              (set last x)
              (set n (+ n 1))
              (set g (coco_store_deref st (+ g 2)))))
          ;; the last item, or everything that is left
          (let ((u32 x . #'(cc_ubranch uc g)))
            (if (== last 0) (set ($ (nth u (-> uc us)) a) x) (set ($ (nth last (-> uc us)) sib) x))
            (set n (+ n 1)))
          (set ($ (nth u (-> uc us)) arity) n)
          (set (-> uc depth) (- (-> uc depth) 1))
          (set (-> uc ncons) (+ (-> uc ncons) 1))
          (return u)))

  ;;; WHERE EACH UNIT GOES NEXT, AND WHICH BARRIER ITS GOALS CUT TO: AFTER
  ;;; and BCTX for U, and inside it what `coco_ite', a disjunction and
  ;;; `coco_k_push_body' gave each part -- a condition its own barrier (its
  ;;; slot's height, plus one) and the cut after it next; the then and the
  ;;; else, a disjunction's arms and a conjunction's items the barrier of
  ;;; the construct; each item the next item.
  (static)
  (func cc_ulink ((coco_ucomp * uc) (u32 u) (u32 after) (u32 bctx))
        (let ((u32 kind . #'($ (nth u (-> uc us)) kind)))
          (set ($ (nth u (-> uc us)) next) after)
          (set ($ (nth u (-> uc us)) bslot) bctx)
          (cond
            ((== kind (cc-eg "CONJ"))
             (let ((u32 v . #'($ (nth u (-> uc us)) a)))
               (while (!= v 0)
                 (let ((u32 nx . #'($ (nth v (-> uc us)) sib)))
                   (cc_ulink uc v (? (!= nx 0) nx after) bctx)
                   (set v nx)))))
            ((== kind (cc-eg "ITE"))
             (let ((u32 cu . #'($ (nth u (-> uc us)) a)) (u32 tu . #'($ (nth u (-> uc us)) b))
                   (u32 eu . #'($ (nth u (-> uc us)) c)) (u32 du . #'($ (nth u (-> uc us)) d))
                   (u32 sl . #'($ (nth u (-> uc us)) tslot)))
               (cc_ulink uc cu du (+ sl 1))
               (cc_ulink uc du tu bctx)
               (cc_ulink uc tu after bctx)
               (cc_ulink uc eu after bctx)))
            ((== kind (cc-eg "DISJ"))
             (cc_ulink uc ($ (nth u (-> uc us)) a) after bctx)
             (cc_ulink uc ($ (nth u (-> uc us)) b) after bctx)))))

  ;;; Whether a body's FIRST goal is a unit: a construct a unit compiles, or
  ;;; a `,'. Any other first goal is handed over as it always was.
  (static)
  (func cc_ufirst ((coco_ucomp * uc) (size_t t)) (out int)
        (let ((coco_store * st . #'(-> uc st)) (coco_machine * m . #'(-> uc m))
              (size_t ct . 0) (size_t tt . 0) (size_t et . 0) (u64 f2 . 0) (u64 c . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (if (and (coco-tag-is FUN c)
                   (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                   (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) (-> uc n_comma)))
              (return 1))
          (return (? (>= (cc_uform uc t (aof ct) (aof tt) (aof et) (aof f2)) 0) 1 0))))

  ;;; WHETHER A BODY HAS A CONSTRUCT A UNIT COMPILES from goal NGD on -- an
  ;;; if-then-else in any of its forms, a disjunction, a `,' left over
  ;;; past 63 goals -- by name and arity alone, over the goals as
  ;;; `cc_compile_body' takes them. Asked before anything else, so a body
  ;;; without one compiles as it did through 1.9.2: the second pass for
  ;;; every body cost each clause compiled 9 000 instructions, and a
  ;;; program of fresh clauses each called once 60 % more. A yes is not
  ;;; the last word (an `*->' among the forms makes no environment).
  (static)
  (func cc_body_has_unit ((coco_ucomp * uc) (size_t body) (u32 ngd)) (out int)
        (let ((coco_store * st . #'(-> uc st)) (coco_machine * m . #'(-> uc m))
              (size_t g . #'(coco_store_deref st body)) (u32 count . 0) (int more . 1))
          (while more
            (let ((u64 c . #'(nth g (-> st cells))) (size_t goal . 0))
              (if (and (< count 63) (coco-tag-is FUN c)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) (-> uc n_comma)))
                  (block (set goal (+ g 1)) (set g (coco_store_deref st (+ g 2))))
                  (block (set goal g) (set more 0)))
              (if (>= count ngd)
                  (let ((u64 gc . #'(nth (coco_store_deref st goal) (-> st cells))))
                    (if (coco-tag-is FUN gc)
                        (let ((u64 nm . #'($ (nth (cast size_t (coco-payload gc)) (-> m functors)) name))
                              (u32 ar . #'($ (nth (cast size_t (coco-payload gc)) (-> m functors)) arity)))
                          (if (and (== ar 2) (or (== nm (-> uc n_semi)) (== nm (-> uc n_arrow))
                                                 (== nm (-> uc n_comma))))
                              (return 1))
                          (if (and (== ar 1) (or (== nm (-> uc n_neg)) (== nm (-> uc n_not))
                                                 (== nm (-> uc n_once)) (== nm (-> uc n_ignore))))
                              (return 1))))))
              (set count (+ count 1))))
          (return 0)))

  ;;; THE ENVIRONMENT OF A BODY, its units compiled as above. A body makes
  ;;; one when it has a construct -- an if-then-else, a disjunction, a `,'
  ;;; inside either -- whose term, frames and taking apart the units save.
  ;;; One without makes none: its later goals reached from an environment
  ;;; cost what their terms and frames did (Stage 5 alone, measured on the
  ;;; linter at -0.19 % to +0.09 %, and 1.2 % more on queens, whose calls
  ;;; leave choices). HEAD and BODY are the clause's. The units start at
  ;;; the body's first goal that is not a guard (`ngd', which CD has by
  ;;; now): the guards before it, and that goal when it is handed over, are
  ;;; numbered and nothing more.
  ;;; Answers 0 when memory ran short, with CD unchanged -- and 1, with CD
  ;;; unchanged too, when the body makes none, when it holds more terms
  ;;; than an entry keeps roots for, or when the numbering came out other
  ;;; than the body's own, which would be a bug and builds no environment.
  (static)
  (func cc_compile_env ((coco_store * st) (coco_machine * m) (coco_code * cd)
                        (size_t head) (size_t body)) (out int)
        (let ((coco_varmap vm . '{ nil nil 0 0 0 })
              (coco_ucomp uc)
              (coco_cbuf hb . '{ nil 0 0 })
              (u32 bus [64]) (u32 nb . 0) (u32 ehand . 1) (u32 count . 0) (int more . 1)
              (u32 ngd . #'(-> cd ngd)) (size_t g . 0) (u64 comma . 0))
          (memset (cast (void *) (aof uc)) 0 (sizeof coco_ucomp))
          (set ($ uc st) st)
          (set ($ uc m) m)
          (set ($ uc vm) (aof vm))
          (set ($ uc ok) 1)
          ;; the names a construct is told by: the machine's own, or
          ;; interned here when it has none yet
          (let ((u64 nm [14]) (u64 fc . 0))
            (if (not (coco_unit_names m nm (aof fc)))
                (block (set (nth 0 nm) (coco_intern m ";"))
                       (set (nth 1 nm) (coco_intern m "->"))
                       (set (nth 2 nm) (coco_intern m "*->"))
                       (set (nth 3 nm) (coco_intern m "\\+"))
                       (set (nth 4 nm) (coco_intern m "not"))
                       (set (nth 5 nm) (coco_intern m "once"))
                       (set (nth 6 nm) (coco_intern m "ignore"))
                       (set (nth 7 nm) (coco_intern m ","))
                       (set (nth 8 nm) (coco_intern m "true"))
                       (set (nth 9 nm) (coco_intern m "fail"))
                       (set (nth 10 nm) (coco_intern m "false"))
                       (set (nth 11 nm) (coco_intern m "!"))
                       (set (nth 12 nm) (coco_intern m "$true"))
                       (set (nth 13 nm) (coco_intern m "$fail"))
                       (set fc (coco_functor_id m (coco_intern m "$cut") 1))))
            (set ($ uc n_semi) (nth 0 nm))
            (set ($ uc n_arrow) (nth 1 nm))
            (set ($ uc n_soft) (nth 2 nm))
            (set ($ uc n_neg) (nth 3 nm))
            (set ($ uc n_not) (nth 4 nm))
            (set ($ uc n_once) (nth 5 nm))
            (set ($ uc n_ignore) (nth 6 nm))
            (set ($ uc n_comma) (nth 7 nm))
            (set ($ uc n_true) (nth 8 nm))
            (set ($ uc n_fail) (nth 9 nm))
            (set ($ uc n_false) (nth 10 nm))
            (set ($ uc n_cut) (nth 11 nm))
            (set ($ uc n_dtrue) (nth 12 nm))
            (set ($ uc n_dfail) (nth 13 nm))
            (set ($ uc f_cut) fc))
          (set comma ($ uc n_comma))
          ;; a body with no construct after its guards makes none, and is
          ;; not compiled again to find that out (`cc_body_has_unit')
          (if (not (cc_body_has_unit (aof uc) body ngd)) (return 1))
          (set ($ uc nemap) (+ (-> cd nvars) 1))
          (set ($ uc emap) (cast (u32 *) (calloc (cast size_t ($ uc nemap)) (sizeof u32))))
          (set ($ uc einit) (cast (u32 *) (calloc (cast size_t ($ uc nemap)) (sizeof u32))))
          (if (or (== ($ uc emap) nil) (== ($ uc einit) nil) (-> m oom)) (set ($ uc ok) 0))
          (coco_varmap_take m (aof vm))
          ;; the head again, for its numbering
          (if (and ($ uc ok) (not (cc_compile_head st m head (aof vm) (aof ($ uc nvars)) (aof hb))))
              (set ($ uc ok) 0))
          (free ($ hb w))
          ;; the body's goals as `cc_compile_body' takes them: up to 63, and
          ;; what is left as one
          (set g (coco_store_deref st body))
          (while (and ($ uc ok) more)
            (let ((u64 c . #'(nth g (-> st cells))) (size_t goal . 0))
              (if (and (< count 63) (coco-tag-is FUN c)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) comma))
                  (block (set goal (+ g 1)) (set g (coco_store_deref st (+ g 2))))
                  (block (set goal g) (set more 0)))
              (if (or (< count ngd) (and (== count ngd) (not (cc_ufirst (aof uc) goal))))
                  ;; a guard, or the first goal after the guards when it is
                  ;; handed over: its numbering only
                  (block (set ($ ($ uc gb) len) 0)
                         (if (not (cc_compile_goal st m goal (aof vm) (aof ($ uc nvars)) (aof ($ uc gb))))
                             (set ($ uc ok) 0)))
                  (block (if (== count ngd) (set ehand 0))
                         (set (nth nb bus) (cc_ubranch (aof uc) goal))
                         (set nb (+ nb 1))))
              (set count (+ count 1))))
          (coco_varmap_give m (aof vm))
          ;; where each body-level unit goes next: the one after it, and
          ;; the body's end; each cuts to the environment's barrier
          (if ($ uc ok)
              (for ((u32 i . 0)) (< i nb) ((++ i))
                (cc_ulink (aof uc) (nth i bus) (? (< (+ i 1) nb) (nth (+ i 1) bus) 0) 0)))
          (free ($ ($ uc gb) w)) (free ($ ($ uc tb) w)) (free ($ ($ uc rb) w)) (free ($ ($ uc qb) w))
          (free ($ uc emap))
          (if (or (not ($ uc ok)) (== ($ uc ncons) 0) (== nb 0) (> ($ uc nterm) 64)
                  (!= ($ uc nvars) (-> cd nvars)))
              (let ((int oom . #'(not ($ uc ok))))
                (free ($ uc einit)) (free (cast (void *) ($ uc us)))
                (free ($ ($ uc eb) w)) (free ($ ($ uc xb) w))
                (return (? oom 0 1))))
          ;; what taking each unit reads, as offsets from the header
          ;; (`coco_egoal'): position U is PB + U, condition slot S is SB + S
          (let ((u32 pb . #'(+ (+ (+ ($ uc nes) ($ uc nterm)) ($ uc nslot)) 3))
                (u32 sb . #'(+ (+ ($ uc nes) ($ uc nterm)) 4)))
            (for ((u32 i . 1)) (<= i ($ uc nu)) ((++ i))
              (let ((coco_egoal * x . #'(aof (nth i ($ uc us)))))
                (set (-> x noff) (? (== (-> x next) 0) 2 (+ pb (-> x next))))
                (set (-> x boff) (? (== (-> x bslot) 0) 3 (+ sb (- (-> x bslot) 1))))
                (set (-> x badd) (? (== (-> x bslot) 0) 0 1))
                (cond
                  ((or (== (-> x kind) (cc-eg "TERM")) (== (-> x kind) (cc-eg "BUILTIN")))
                   (set (-> x soff) (+ (+ ($ uc nes) (-> x tslot)) 4)))
                  ((or (== (-> x kind) (cc-eg "ITE")) (== (-> x kind) (cc-eg "CUTC")))
                   (set (-> x soff) (+ sb (-> x tslot)))))
                (if (!= (-> x a) 0) (set (-> x aoff) (+ pb (-> x a))))
                (cond
                  ((== (-> x kind) (cc-eg "ITE")) (set (-> x coff) (+ pb (-> x c))))
                  ((== (-> x kind) (cc-eg "DISJ")) (set (-> x coff) (+ pb (-> x b)))))
                (if (or (== (-> x kind) (cc-eg "CALL")) (== (-> x kind) (cc-eg "SIDES")))
                    (let ((u32 all . 1))
                      (for ((u32 j . 0)) (< j (-> x rlen)) ((++ j))
                        (if (!= (cc_op (nth (+ (-> x rat) j) ($ ($ uc eb) w))) (cc_RARG_VAR))
                            (set all 0)))
                      (set (-> x rvars) all))))))
          ;; the entry's alike tail (`etmpl'): the condition slots and the
          ;; positions, which begin at PB + 1
          (let ((size_t nsl . #'(cast size_t ($ uc nslot)))
                (size_t nu . #'(cast size_t ($ uc nu)))
                (size_t ps . #'(cast size_t (+ (+ (+ ($ uc nes) ($ uc nterm)) ($ uc nslot)) 4)))
                (u64 * t . nil))
            (set t (cast (u64 *) (malloc (* (+ nsl nu) (sizeof u64)))))
            (if (== t nil)
                (block (free ($ uc einit)) (free (cast (void *) ($ uc us)))
                       (free ($ ($ uc eb) w)) (free ($ ($ uc xb) w))
                       (return 0)))
            (for ((size_t s . 0)) (< s nsl) ((++ s))
              (set (nth s t) (coco-int-cell 0)))
            (for ((size_t s . 0)) (< s nu) ((++ s))
              (set (nth (+ nsl s) t) (coco-cell POS (bitor (<< (+ ps s) 16) (+ s 1)))))
            (set (-> cd etmpl) t))
          (set (-> cd nes) ($ uc nes))
          (set (-> cd nterm) ($ uc nterm))
          (set (-> cd nslot) ($ uc nslot))
          (set (-> cd nunit) ($ uc nu))
          (set (-> cd eu0) (nth 0 bus))
          (set (-> cd ehand) ehand)
          (set (-> cd einit) ($ uc einit))
          (set (-> cd egoals) ($ uc us))
          (set (-> cd ebody) ($ ($ uc eb) w))
          (set (-> cd eblen) ($ ($ uc eb) len))
          (set (-> cd xbody) ($ ($ uc xb) w))
          (set (-> cd xblen) ($ ($ uc xb) len))
          ;; code, parent, barrier, the slots, and a position per unit
          (set (-> cd efid) (coco_functor_id m (coco_intern m "$e")
                                             (+ (+ (+ (+ ($ uc nes) ($ uc nterm)) ($ uc nslot)) ($ uc nu)) 3)))
          (set (-> cd env) 1)
          (return 1)))

  (static)
  (func coco_code_free ((coco_code * cd))
        (if (== cd nil) (return))
        (free (-> cd head))
        (free (-> cd body))
        (free (-> cd rbody))
        (free (-> cd gbody))
        (free (-> cd einit))
        (free (cast (void *) (-> cd egoals)))
        (free (-> cd ebody))
        (free (-> cd xbody))
        (free (-> cd etmpl))
        (free cd))

  (func coco_code_table_clear ((coco_store * st))
        (for ((size_t i . 0)) (< i (-> st code_cap)) ((++ i))
          (if (!= (nth i (-> st code_keys)) 0)
              (block (coco_code_free (cast (coco_code *) (nth i (-> st code_vals))))
                     (set (nth i (-> st code_keys)) 0)
                     (set (nth i (-> st code_vals)) nil))))
        (set (-> st code_len) 0))

  (static)
  (func coco_code_slot ((size_t cap) (size_t key)) (out size_t)
        (let ((u64 h . #'(* (cast u64 key) (cast u64 0x9E3779B97F4A7C15))))
          (set h (xor h (>> h 32)))
          (set h (xor h (>> h 16)))
          (return (cast size_t (bitand h (cast u64 (- cap 1)))))))

  (static)
  (func coco_code_find ((coco_store * st) (size_t clause)) (out coco_code *)
        (if (== (-> st code_cap) 0) (return nil))
        (let ((size_t mask . #'(- (-> st code_cap) 1))
              (size_t i . #'(coco_code_slot (-> st code_cap) (+ clause 1))))
          (while (!= (nth i (-> st code_keys)) 0)
            (if (== (nth i (-> st code_keys)) (+ clause 1))
                (return (cast (coco_code *) (nth i (-> st code_vals)))))
            (set i (bitand (+ i 1) mask)))
          (return nil)))

  (static)
  (func coco_code_put ((coco_store * st) (size_t clause) (coco_code * cd)) (out int)
        ;; under half full before the probe that places it
        (if (> (* (+ (-> st code_len) 1) 2) (-> st code_cap))
            (let ((size_t ncap . #'(? (== (-> st code_cap) 0) 256 (* (-> st code_cap) 2)))
                  (size_t * nk . #'(cast (size_t *) (calloc ncap (sizeof size_t))))
                  (void ** nv . #'(cast (void **) (calloc ncap (sizeof size_t)))))
              (if (or (== nk nil) (== nv nil)) (block (free nk) (free nv) (return 0)))
              (for ((size_t i . 0)) (< i (-> st code_cap)) ((++ i))
                (let ((size_t key . #'(nth i (-> st code_keys))))
                  (if (!= key 0)
                      (let ((size_t j . #'(coco_code_slot ncap key)))
                        (while (!= (nth j nk) 0) (set j (bitand (+ j 1) (- ncap 1))))
                        (set (nth j nk) key)
                        (set (nth j nv) (nth i (-> st code_vals)))))))
              (free (-> st code_keys)) (free (-> st code_vals))
              (set (-> st code_keys) nk) (set (-> st code_vals) nv) (set (-> st code_cap) ncap)))
        (let ((size_t mask . #'(- (-> st code_cap) 1))
              (size_t i . #'(coco_code_slot (-> st code_cap) (+ clause 1))))
          (while (!= (nth i (-> st code_keys)) 0) (set i (bitand (+ i 1) mask)))
          (set (nth i (-> st code_keys)) (+ clause 1))
          (set (nth i (-> st code_vals)) (cast (void *) cd))
          (set (-> st code_len) (+ (-> st code_len) 1))
          (return 1)))

  ;;; A DEAD CLAUSE'S CODE THAT AN ENVIRONMENT HAS NAMED IS RETIRED, NOT
  ;;; FREED (Stage 5): an environment on the heap may be part way through
  ;;; that very body -- a clause retracted while it runs keeps running the
  ;;; code it was entered with, which is the logical update view the copy
  ;;; of the body gave before -- and reads its code at every goal. Kept on
  ;;; the store's retired list until a heap collection finds no environment
  ;;; naming it (`coco_code_sweep'), a query starts with nothing running
  ;;; (`coco_code_retired_free'), or the store is freed. A code no
  ;;; environment ever named -- a fact, a body of one goal, a clause never
  ;;; entered since it was compiled -- is freed at once as before.
  (static)
  (func coco_code_retire ((coco_store * st) (coco_code * cd))
        (if (== cd nil) (return))
        (if (not (-> cd envd)) (block (coco_code_free cd) (return)))
        (set (-> cd rnext) (-> st retired))
        (set (-> st retired) (cast (void *) cd))
        (set (-> st nretired) (+ (-> st nretired) 1)))

  (func coco_code_sweep ((coco_store * st) (u64 epoch))
        (let ((coco_code * cd . #'(cast (coco_code *) (-> st retired)))
              (coco_code * keep . nil) (size_t n . 0))
          (while (!= cd nil)
            (let ((coco_code * next . #'(cast (coco_code *) (-> cd rnext))))
              (if (== (-> cd gcmark) epoch)
                  (block (set (-> cd rnext) (cast (void *) keep))
                         (set keep cd)
                         (set n (+ n 1)))
                  (coco_code_free cd))
              (set cd next)))
          (set (-> st retired) (cast (void *) keep))
          (set (-> st nretired) n)))

  (func coco_code_retired_free ((coco_store * st))
        (let ((coco_code * cd . #'(cast (coco_code *) (-> st retired))))
          (while (!= cd nil)
            (let ((coco_code * next . #'(cast (coco_code *) (-> cd rnext))))
              (coco_code_free cd)
              (set cd next)))
          (set (-> st retired) nil)
          (set (-> st nretired) 0)))

  ;;; A CLAUSE THAT DIES TAKES ITS PROGRAM WITH IT -- a retract, a reconsult
  ;;; -- or the table keeps every dead clause's code until the next
  ;;; compaction, which counts store cells and not this: a million
  ;;; retract-and-assert cycles held 298 MB where 1.8.41 held 70 (1.8.45).
  ;;; A hole in a linear-probed table is filled by shifting back each later
  ;;; entry of its run whose home slot does not lie between the two. A code
  ;;; an environment named goes to the retired list instead
  ;;; (`coco_code_retire').
  (func coco_code_drop ((coco_store * st) (size_t clause))
        (if (== (-> st code_len) 0) (return))
        (let ((size_t mask . #'(- (-> st code_cap) 1))
              (size_t i . #'(coco_code_slot (-> st code_cap) (+ clause 1)))
              (size_t j . 0) (size_t h . 0))
          (while (!= (nth i (-> st code_keys)) (+ clause 1))
            (if (== (nth i (-> st code_keys)) 0) (return))
            (set i (bitand (+ i 1) mask)))
          (coco_code_retire st (cast (coco_code *) (nth i (-> st code_vals))))
          (set (-> st code_len) (- (-> st code_len) 1))
          (set j i)
          (while 1
            (set j (bitand (+ j 1) mask))
            (if (== (nth j (-> st code_keys)) 0) break)
            (set h (coco_code_slot (-> st code_cap) (nth j (-> st code_keys))))
            ;; home h cyclically in (i, j]: the entry is where it belongs
            (if (? (<= i j) (and (< i h) (<= h j)) (or (< i h) (<= h j)))
                continue)
            (set (nth i (-> st code_keys)) (nth j (-> st code_keys)))
            (set (nth i (-> st code_vals)) (nth j (-> st code_vals)))
            (set i j))
          (set (nth i (-> st code_keys)) 0)
          (set (nth i (-> st code_vals)) nil)))

  (func coco_clause_code ((coco_store * st) (coco_machine * m) (size_t clause)) (out coco_code *)
        (let ((coco_code * cd . #'(coco_code_find st clause)))
          (if (!= cd nil) (return cd))
          ;; THE FIRST COMPILE (2.9.0) changes the one store's code table.
          (with-green-write nil
          ;; THE FIND AGAIN UNDER THE BARRIER: the find above is lock-free,
          ;; and a task on another worker may have compiled this clause
          ;; between it and this barrier. Its program is the one the
          ;; predicate already holds; compile nothing and use it.
          (let ((coco_code * cd2 . #'(coco_code_find st clause)))
            (if (!= cd2 nil) (return cd2)))
          (let ((coco_varmap vm . '{ nil nil 0 0 0 })
                (coco_cbuf hb . '{ nil 0 0 }) (coco_cbuf bb . '{ nil 0 0 })
                (coco_cbuf rb . '{ nil 0 0 }) (coco_cbuf gb . '{ nil 0 0 })
                (size_t head . 0) (size_t body . 0) (u32 nvars . 0) (u32 ngoals . 0)
                (u32 nvhead . 0) (u32 starts [64]) (u32 nvafter [64]) (u32 ngd . 0)
                (size_t rstart . 0) (u64 rfid . 0) (u32 rarity . 0)
                (int ok . 1))
            (coco_store_clause_parts st m clause (coco_intern m ":-") (aof head) (aof body))
            (set head (coco_store_deref st head))
            ;; a head is an atom or a compound; anything else is not compiled
            (if (not (or (coco-tag-is ATOM (nth head (-> st cells)))
                         (coco-tag-is FUN (nth head (-> st cells)))))
                (return nil))
            (coco_varmap_take m (aof vm))
            (if (not (cc_compile_head st m head (aof vm) (aof nvars) (aof hb))) (set ok 0))
            (set nvhead nvars)
            (if (and ok (!= body 0))
                (if (not (cc_compile_body st m body (aof vm) (aof nvars) (aof bb) (aof ngoals)
                                          starts nvafter))
                    (set ok 0)))
            ;; the guards the body starts with (Stage 4), over the numbering
            ;; the body made: a goal is one only when everything it reads was
            ;; met before it
            (if (and ok (!= body 0))
                (set ngd (cc_compile_guards st m body (aof vm) nvhead nvafter ngoals (aof gb))))
            ;; the first goal that is not a guard, for the registers, when it
            ;; can go there and it pays (`cc_regs_worth'); a goal that cannot
            ;; keeps only its term form, which is no loss
            (if (and ok (!= body 0) (< ngd ngoals))
                (block
                 (set rstart (? (< (+ ngd 1) ngoals) (cast size_t (nth (+ ngd 1) starts)) ($ bb len)))
                 (if (not (and (cc_reg_form m ($ bb w) (cast size_t (nth ngd starts)) rstart
                                            (aof rb) (aof rfid) (aof rarity))
                               (cc_regs_worth st m rfid)))
                     (block (free ($ rb w)) (set ($ rb w) nil) (set ($ rb len) 0)))))
            ;; a frame index is K's twenty-four bits; a clause with more
            ;; variables and temporaries than that is matched and copied
            (if (> nvars 16777215) (set ok 0))
            (coco_varmap_give m (aof vm))
            (if (not ok)
                (block (free ($ hb w)) (free ($ bb w)) (free ($ rb w)) (free ($ gb w)) (return nil)))
            (set cd (cast (coco_code *) (calloc 1 (sizeof coco_code))))
            (if (== cd nil)
                (block (free ($ hb w)) (free ($ bb w)) (free ($ rb w)) (free ($ gb w)) (return nil)))
            (set (-> cd head) ($ hb w)) (set (-> cd hlen) ($ hb len))
            (set (-> cd body) ($ bb w)) (set (-> cd blen) ($ bb len))
            (set (-> cd nvars) nvars)
            (set (-> cd ngoals) ngoals)
            (set (-> cd rbody) ($ rb w)) (set (-> cd rblen) ($ rb len))
            (set (-> cd rstart) rstart)
            (set (-> cd rfid) rfid)
            (set (-> cd rarity) rarity)
            (set (-> cd gbody) ($ gb w)) (set (-> cd gblen) ($ gb len))
            (set (-> cd ngd) ngd)
            ;; where the body is built from after I guards: goal I's words,
            ;; or the end when every goal was a guard
            (for ((u32 i . 0)) (<= i ngd) ((++ i))
              (set (nth i (-> cd gstart)) (? (< i ngoals) (nth i starts) (cast u32 ($ bb len)))))
            ;; THE ENVIRONMENT (Stages 5 and 6), for a body with a construct
            ;; after its guards (`cc_compile_env' decides). A body with
            ;; guards and an environment has an executor of its own, with a
            ;; runner of its own for them (`coco_clause_run_ge'): asking the
            ;; guards' executor for an environment too cost the counting
            ;; loop 8 instructions a turn. A body an environment could not
            ;; be had for -- memory -- keeps the form it had, which is no loss
            (if (and (cc_env_enabled) (!= body 0))
                (cc_compile_env st m cd head body))
            ;; and whether entering it takes more than the plain executor
            (set (-> cd ex) (+ (? (> ngd 0) 1 0) (? (!= (-> cd env) 0) 2 0)))
            (if (not (coco_code_put st clause cd))
                (block (coco_code_free cd) (return nil)))
            (return cd)))))

  ;;; A constant against a dereferenced heap cell: bound to a copy when the
  ;;; cell is unbound, else the same comparison `coco_unify' makes.
  (static)
  (func cc_match_const ((coco_machine * m) (size_t a) (u64 c)) (out int)
        (let ((u64 ca . #'(nth a (-> m heap))))
          (if (coco-tag-is REF ca)
              (block (coco_bind m a (coco_push m c)) (return 1)))
          ;; the same word is the same constant, whatever its tag: the
          ;; common match decided before the tables are asked (2.0.0)
          (if (== ca c) (return 1))
          (if (!= (coco-tag ca) (coco-tag c)) (return 0))
          (cond
            ((coco-tag-is FLT ca) (return (coco_flt_eq m ca c)))
            ((coco-tag-is STR ca) (return (coco_str_eq m ca c)))
            ;; a rational is its reduced pair (2.5.0)
            ((coco-tag-is RAT ca)
             (return (? (and (coco-tag-is RAT c) (coco_rat_eq m ca c)) 1 0)))
            ;; a boxed integer by its value, as a float is (2.0.0)
            ((coco-tag-is BIG ca)
             (block
              (if (not (coco-big-p c)) (return 0))
              (return (? (== (nth (cast size_t (coco-payload ca)) (-> m bigs))
                             (nth (cast size_t (coco-payload c)) (-> m bigs))) 1 0))))
            (#t (return 0)))))

  ;;; Answers 1 when the head matched (the goals are built), 0 when it did
  ;;; not, and -1 when it could not run at all -- no frame to be had -- which
  ;;; the caller answers by matching the clause in the store instead: a
  ;;; clause skipped because memory was short would be a wrong answer.
  ;;;
  ;;; A SWITCH, NOT A CHAIN: the opcode is a jump, where a chain of
  ;;; comparisons cost each instruction its position in the chain. And THE
  ;;; SLOTS ARE RESERVED, NOT WRITTEN (`coco_push_struct_raw'): every slot
  ;;; of every structure built here is written by exactly one instruction
  ;;; before anything can read it -- the two that leave a slot as the
  ;;; variable it is (UNIFY_VAR in write mode, ARG_VAR_1) write the
  ;;; variable themselves -- so the walk that cleared them to variables was
  ;;; a store per slot for nothing. Nothing reads a half-built structure: a
  ;;; structure's instructions follow its GET or ARG at once, and a nested
  ;;; one is reached only through the slot its parent wrote.
  (func coco_clause_run ((coco_machine * m) (coco_store * st) (coco_code * cd)
                         (size_t call) (size_t * goals) (size_t * ngoals)) (out int)
        (let ((size_t frame_small [128])
              (size_t * frame . nil) (size_t frcap . 0)
              (size_t pc . 0)
              (size_t S . 0) (int write . 0) (int ok . 1))
          (set (cof ngoals) 0)
          ;; THE FRAME: 128 slots on the C stack, or the machine's kept array
          ;; -- never a malloc and a free per call, which is what the walk
          ;; stacks stopped doing (1.8.38)
          (if (<= (-> cd nvars) 128)
              (set frame frame_small)
              (set frame (coco_cslots_take m (cast size_t (-> cd nvars)) (aof frcap))))
          (if (== frame nil) (return -1))
          ;; ---- the head ----
          (while (and ok (< pc (-> cd hlen)))
            (let ((u64 w . #'(nth pc (-> cd head))))
              (set pc (+ pc 1))
              (switch (cast int (cc_op w))
                (case (cc-op "GET_VAR")
                  (set (nth (cc_k w) frame) (coco_deref m (+ call (+ (cast size_t (cc_n w)) 1))))
                  break)
                (case (cc-op "GET_VAL")
                  (if (not (coco_unify m (nth (cc_k w) frame) (+ call (+ (cast size_t (cc_n w)) 1))))
                      (set ok 0))
                  break)
                (case (cc-op "GET_CONST")
                  (let ((u64 c . #'(nth pc (-> cd head))))
                    (set pc (+ pc 1))
                    (if (not (cc_match_const m (coco_deref m (+ call (+ (cast size_t (cc_n w)) 1))) c))
                        (set ok 0)))
                  break)
                (case (cc-op "GET_STRUCT")
                  ;; the argument index is in K, the arity in N
                  (let ((u64 fid . #'(nth pc (-> cd head)))
                        (u32 n . #'(cast u32 (cc_n w)))
                        (size_t a . #'(coco_deref m (+ call (+ (cc_k w) 1)))))
                    (set pc (+ pc 1))
                    (let ((u64 ca . #'(nth a (-> m heap))))
                      (cond
                        ((coco-tag-is REF ca)
                         ;; WRITE: the structure is built and the variable bound to it
                         (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN fid) n)))
                           (coco_bind m a h)
                           (set S (+ h 1))
                           (set write 1)))
                        ((and (coco-tag-is FUN ca) (== (coco-payload ca) fid))
                         (set S (+ a 1))
                         (set write 0))
                        (#t (set ok 0)))))
                  break)
                (case (cc-op "GET_STRUCT_T")
                  ;; the temporary is in K, the arity in N
                  (let ((u64 fid . #'(nth pc (-> cd head)))
                        (u32 n . #'(cast u32 (cc_n w)))
                        (size_t a . #'(coco_deref m (nth (cc_k w) frame))))
                    (set pc (+ pc 1))
                    (let ((u64 ca . #'(nth a (-> m heap))))
                      (cond
                        ((coco-tag-is REF ca)
                         (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN fid) n)))
                           (coco_bind m a h)
                           (set S (+ h 1))
                           (set write 1)))
                        ((and (coco-tag-is FUN ca) (== (coco-payload ca) fid))
                         (set S (+ a 1))
                         (set write 0))
                        (#t (set ok 0)))))
                  break)
                (case (cc-op "UNIFY_VAR")
                  ;; write: the slot IS the variable, and is written as one
                  (if write
                      (block (set (nth S (-> m heap)) (coco-cell REF S))
                             (set (nth (cc_k w) frame) S))
                      (set (nth (cc_k w) frame) (coco_deref m S)))
                  (set S (+ S 1))
                  break)
                (case (cc-op "UNIFY_VAL")
                  (if write
                      (coco_set_arg m S (coco_deref m (nth (cc_k w) frame)))
                      (if (not (coco_unify m (nth (cc_k w) frame) S)) (set ok 0)))
                  (set S (+ S 1))
                  break)
                (case (cc-op "UNIFY_CONST")
                  (let ((u64 c . #'(nth pc (-> cd head))))
                    (set pc (+ pc 1))
                    (if write
                        (coco_set_arg m S (coco_push m c))
                        (if (not (cc_match_const m (coco_deref m S) c)) (set ok 0)))
                    (set S (+ S 1)))
                  break)
                (default (set ok 0)))))
          (if (not ok)
              (block (if (!= frame frame_small) (coco_cslots_give m frame frcap)) (return 0)))
          ;; ---- the body ----
          ;; EVERY GOAL IS ONE RESERVATION: its GOAL_STRUCT carries the
          ;; cells the whole goal takes -- header, slots, every nested
          ;; structure's and every constant's -- and reserves them in one
          ;; growth check; the ARG words that follow carry the OFFSET from
          ;; the goal's base of the slot they fill and of the cell they
          ;; put there, settled when the clause was compiled, so each is a
          ;; store or two with nothing to check and no stack of pending
          ;; structures to keep (1.8.46; through 1.8.45 the executor
          ;; walked a frame stack to find the next slot and grew the heap
          ;; per structure, as the copy does).
          (if (> (-> cd blen) 0)
              (let ((size_t ng . 0) (size_t h . 0))
                (set pc 0)
                ;; the program's length is its end: no END word to dispatch
                (while (and ok (< pc (-> cd blen)))
                  (let ((u64 w . #'(nth pc (-> cd body))))
                    (set pc (+ pc 1))
                    (switch (cast int (cc_op w))
                      (case (cc-op "GOAL_STRUCT")
                        (let ((u64 fid . #'(nth pc (-> cd body)))
                              (size_t total . #'(cast size_t (cc_n w))))
                          (set pc (+ pc 1))
                          (set h (-> m heap_len))
                          (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                            (aof (-> m heap_cap)) (+ h total) (sizeof u64)))
                              (block (set ok 0) break))
                          (set (-> m heap_len) (+ h total))
                          (set (nth h (-> m heap)) (coco-cell FUN fid))
                          (if (< ng 64) (block (set (nth ng goals) h) (set ng (+ ng 1)))))
                        break)
                      (case (cc-op "GOAL_ATOM")
                        (let ((u64 c . #'(nth pc (-> cd body))))
                          (set pc (+ pc 1))
                          (if (< ng 64) (block (set (nth ng goals) (coco_push m c)) (set ng (+ ng 1)))))
                        break)
                      (case (cc-op "GOAL_VAR")
                        (if (< ng 64) (block (set (nth ng goals) (coco_deref m (nth (cc_k w) frame)))
                                             (set ng (+ ng 1))))
                        break)
                      (case (cc-op "GOAL_VAR_1")
                        (let ((size_t v . #'(coco_new_var m)))
                          (set (nth (cc_k w) frame) v)
                          (if (< ng 64) (block (set (nth ng goals) v) (set ng (+ ng 1)))))
                        break)
                      (case (cc-op "ARG_CONST")
                        ;; the constant in its own cell, the slot pointing at it
                        (let ((u64 c . #'(nth pc (-> cd body)))
                              (size_t at . #'(+ h (cast size_t (cc_n w)))))
                          (set pc (+ pc 1))
                          (set (nth at (-> m heap)) c)
                          (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                        break)
                      (case (cc-op "ARG_VAR")
                        (set (nth (+ h (cast size_t (cc_n w))) (-> m heap))
                             (coco-cell REF (coco_deref m (nth (cc_k w) frame))))
                        break)
                      (case (cc-op "ARG_VAR_1")
                        ;; the slot IS the variable, and is written as one
                        (let ((size_t slot . #'(+ h (cast size_t (cc_n w)))))
                          (set (nth slot (-> m heap)) (coco-cell REF slot))
                          (set (nth (cc_k w) frame) slot))
                        break)
                      (case (cc-op "ARG_STRUCT")
                        ;; the header where the compiler placed it; its own
                        ;; slots are filled by the words that follow
                        (let ((u64 fid . #'(nth pc (-> cd body)))
                              (size_t at . #'(+ h (cast size_t (cc_n w)))))
                          (set pc (+ pc 1))
                          (set (nth at (-> m heap)) (coco-cell FUN fid))
                          (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                        break)
                      (default (set ok 0)))))
                (set (cof ngoals) ng)))
          (if (!= frame frame_small) (coco_cslots_give m frame frcap))
          ;; the head matched; a body that could not be built is not a
          ;; head that failed to match, and must not be reported as one
          (return (? ok 1 -1))))

  ;;; Floored division's correction, as `coco_floor_adjusts' makes it for
  ;;; `div' and `mod': a copy, that one being the engine's and this file
  ;;; read before it.
  (static)
  (func cc_floor_adjusts ((i64 a) (i64 b)) (out int)
        (let ((i64 r . #'(% a b)))
          (return (? (and (!= r 0) (!= (< r 0) (< b 0))) 1 0))))

  ;;; THE GUARDS' RUNNER (`cc-guards-body'), for the guards' own executor,
  ;;; and its copy for the executor that makes an environment after them.
  (static)
  (func cc_guards_run ((coco_machine * m) (coco_code * cd) (size_t * frame) (u32 budget)
                       (int * failed)) (out u32)
        (cc-guards-body (-> cd gbody) (-> cd gblen) cc-frame-var 0))
  (static)
  (func cc_guards_run_e ((coco_machine * m) (coco_code * cd) (size_t * frame) (u32 budget)
                         (int * failed)) (out u32)
        (cc-guards-body (-> cd gbody) (-> cd gblen) cc-frame-var 0))

  ;;; THE SAME, TWO WAYS MORE (Stage 3): a call whose arguments are in
  ;;; registers (ARGS, CALL not read), and a first goal written into the
  ;;; engine's registers (REGS, when the code has the form for it) rather
  ;;; than built. A function of its own, so a clause that uses neither --
  ;;; every body that starts with a builtin -- runs the one above, exactly
  ;;; as it ran before there were registers.
  (func coco_clause_run_r ((coco_machine * m) (coco_store * st) (coco_code * cd)
                         (size_t call) (const size_t * args)
                         (size_t * goals) (size_t * ngoals) (size_t * regs)) (out int)
        (let ((size_t frame_small [128])
              (size_t * frame . nil) (size_t frcap . 0)
              (size_t pc . 0)
              (size_t S . 0) (int write . 0) (int ok . 1))
          (set (cof ngoals) 0)
          ;; THE FRAME: 128 slots on the C stack, or the machine's kept array
          ;; -- never a malloc and a free per call, which is what the walk
          ;; stacks stopped doing (1.8.38)
          (if (<= (-> cd nvars) 128)
              (set frame frame_small)
              (set frame (coco_cslots_take m (cast size_t (-> cd nvars)) (aof frcap))))
          (if (== frame nil) (return -1))
          ;; ---- the head, over the call as a term or in registers ----
          (if (== args nil)
              (cc-head-program cc-arg-term)
              (cc-head-program cc-arg-reg))
          (if (not ok)
              (block (if (!= frame frame_small) (coco_cslots_give m frame frcap)) (return 0)))
          ;; ---- the body, its first goal into the registers when it can ----
          (cc-body-program (-> cd body) 0 (-> cd blen) (and (!= regs nil) (> (-> cd rblen) 0)))
          (if (!= frame frame_small) (coco_cslots_give m frame frcap))
          ;; the head matched; a body that could not be built is not a
          ;; head that failed to match, and must not be reported as one
          (return (? ok 1 -1))))

  ;;; AND ONCE MORE, FOR A BODY THAT STARTS WITH GUARDS (Stage 4): the
  ;;; same, with the guards run between the head and the body -- at most
  ;;; BUDGET of them, their count in GDONE, the one that failed counted
  ;;; too, as the step that failed would have been. A function of its own
  ;;; again, so that a clause without guards pays nothing for them: in the
  ;;; one above they cost naive reverse 33 instructions a call, in an
  ;;; out-parameter and the registers it took. ITS GUARDS' RUNNER IS ITS
  ;;; OWN (`cc_guards_run', one caller), so that the compiler keeps it in
  ;;; this function: called from a second executor too (Stage 5's first
  ;;; form), it became a call of its own and cost the counting loop 6
  ;;; instructions a turn.
  (func coco_clause_run_g ((coco_machine * m) (coco_store * st) (coco_code * cd)
                         (size_t call) (const size_t * args)
                         (size_t * goals) (size_t * ngoals) (size_t * regs)
                         (u32 budget) (u32 * gdone)) (out int)
        (let ((size_t frame_small [128])
              (size_t * frame . nil) (size_t frcap . 0)
              (size_t pc . 0)
              (size_t S . 0) (int write . 0) (int ok . 1)
              (u32 gi . 0) (int gfail . 0))
          (set (cof ngoals) 0)
          (set (cof gdone) 0)
          (if (<= (-> cd nvars) 128)
              (set frame frame_small)
              (set frame (coco_cslots_take m (cast size_t (-> cd nvars)) (aof frcap))))
          (if (== frame nil) (return -1))
          ;; ---- the head ----
          (if (== args nil)
              (cc-head-program cc-arg-term)
              (cc-head-program cc-arg-reg))
          (if (not ok)
              (block (if (!= frame frame_small) (coco_cslots_give m frame frcap)) (return 0)))
          ;; ---- the guards, where the step would have run them: next ----
          (set gi (cc_guards_run m cd frame budget (aof gfail)))
          (if gfail
              (block (set (cof gdone) (+ gi 1))
                     (if (!= frame frame_small) (coco_cslots_give m frame frcap))
                     (return 0)))
          (set (cof gdone) gi)
          ;; ---- the body, from the first goal that was not run here; into
          ;; the registers only when every guard ran ----
          (cc-body-program (-> cd body) (cast size_t (nth gi (-> cd gstart))) (-> cd blen)
                           (and (== gi (-> cd ngd)) (!= regs nil) (> (-> cd rblen) 0)))
          (if (!= frame frame_small) (coco_cslots_give m frame frcap))
          (return (? ok 1 -1))))

  ;;; AND FOR A BODY WITH NO GUARDS THAT MAKES AN ENVIRONMENT (Stage 5): the
  ;;; head, then only the first goal -- into the registers when they can
  ;;; take it, built otherwise, `rstart' being where the goal after it
  ;;; begins -- and then the later goals' entry program and the environment
  ;;; (`cc-env-entry'), as ER asks.
  (func coco_clause_run_e ((coco_machine * m) (coco_store * st) (coco_code * cd)
                         (size_t call) (const size_t * args)
                         (size_t * goals) (size_t * ngoals) (size_t * regs)
                         (coco_envreq * er)) (out int)
        (let ((size_t frame_small [128])
              (size_t * frame . nil) (size_t frcap . 0)
              (size_t pc . 0)
              (size_t S . 0) (int write . 0) (int ok . 1))
          (set (cof ngoals) 0)
          (if (<= (-> cd nvars) 128)
              (set frame frame_small)
              (set frame (coco_cslots_take m (cast size_t (-> cd nvars)) (aof frcap))))
          (if (== frame nil) (return -1))
          ;; ---- the head ----
          (if (== args nil)
              (cc-head-program cc-arg-term)
              (cc-head-program cc-arg-reg))
          (if (not ok)
              (block (if (!= frame frame_small) (coco_cslots_give m frame frcap)) (return 0)))
          ;; ---- the first goal, alone, when it is handed over -- a first
          ;; goal that is a construct is a unit, and built by the entry
          ;; program -- and the environment ----
          (if (-> cd ehand)
              (cc-body-program (-> cd body) 0 (-> cd rstart) (and (!= regs nil) (> (-> cd rblen) 0))))
          (if ok (cc-env-entry))
          (if (!= frame frame_small) (coco_cslots_give m frame frcap))
          (return (? ok 1 -1))))

  ;;; AND FOR A BODY THAT STARTS WITH GUARDS AND MAKES AN ENVIRONMENT AFTER
  ;;; THEM (Stage 6): the head, the guards as `coco_clause_run_g' runs them
  ;;; (BUDGET, GDONE), and then, when every guard ran, the first goal after
  ;;; them -- into the registers or built, `rstart' being where the goal
  ;;; after it begins -- and the environment, as ER asks. Guards that
  ;;; stopped before the last build the body from the one they stopped at,
  ;;; as `coco_clause_run_g' does, and make no environment: ER's next stays
  ;;; 0, and REGS is not written.
  (func coco_clause_run_ge ((coco_machine * m) (coco_store * st) (coco_code * cd)
                          (size_t call) (const size_t * args)
                          (size_t * goals) (size_t * ngoals) (size_t * regs)
                          (coco_envreq * er) (u32 budget) (u32 * gdone)) (out int)
        (let ((size_t frame_small [128])
              (size_t * frame . nil) (size_t frcap . 0)
              (size_t pc . 0)
              (size_t S . 0) (int write . 0) (int ok . 1)
              (u32 gi . 0) (int gfail . 0))
          (set (cof ngoals) 0)
          (set (cof gdone) 0)
          (if (<= (-> cd nvars) 128)
              (set frame frame_small)
              (set frame (coco_cslots_take m (cast size_t (-> cd nvars)) (aof frcap))))
          (if (== frame nil) (return -1))
          ;; ---- the head ----
          (if (== args nil)
              (cc-head-program cc-arg-term)
              (cc-head-program cc-arg-reg))
          (if (not ok)
              (block (if (!= frame frame_small) (coco_cslots_give m frame frcap)) (return 0)))
          ;; ---- the guards ----
          (set gi (cc_guards_run_e m cd frame budget (aof gfail)))
          (if gfail
              (block (set (cof gdone) (+ gi 1))
                     (if (!= frame frame_small) (coco_cslots_give m frame frcap))
                     (return 0)))
          (set (cof gdone) gi)
          (if (< gi (-> cd ngd))
              ;; ---- stopped short: the body from that guard, as it was ----
              (cc-body-program (-> cd body) (cast size_t (nth gi (-> cd gstart))) (-> cd blen) 0)
              ;; ---- the first goal after the guards, when it is handed
              ;; over, and the environment ----
              (block
               (if (-> cd ehand)
                   (cc-body-program (-> cd body) (cast size_t (nth gi (-> cd gstart))) (-> cd rstart)
                                    (and (!= regs nil) (> (-> cd rblen) 0))))
               (if ok (cc-env-entry))))
          (if (!= frame frame_small) (coco_cslots_give m frame frcap))
          (return (? ok 1 -1))))

  ;;; GOAL I OF AN ENVIRONMENT, REACHED (`coco_env_take' in solve.cicili,
  ;;; and a freeze): the words the body would have run for it when the
  ;;; clause was entered, a variable read from the environment's slot where
  ;;; the body read the frame -- into the registers for a call, one
  ;;; reservation holding whatever it nests, as the first goal's register
  ;;; form is run; or built as its term, one reservation for the whole
  ;;; goal, the very term entering the clause would have built
  ;;; (`cc-env-slot1'). No variable is made here: every one a later goal
  ;;; meets first was made with the environment. ENV is the header.
  (func coco_env_regs ((coco_machine * m) (coco_code * cd) (size_t env) (u32 i)
                       (size_t * regs)) (out int)
        (let ((coco_egoal * g . #'(aof (nth i (-> cd egoals))))
              (u64 * rp . #'(+ (-> cd ebody) (-> g rat)))
              (size_t rn . #'(cast size_t (-> g rlen)))
              (size_t eb . #'(+ env 4))
              (size_t h . 0) (size_t rpc . 0))
          (while (< rpc rn)
            (let ((u64 w . #'(nth rpc rp)))
              (set rpc (+ rpc 1))
              (switch (cast int (cc_op w))
                (case (cc-op "RARG_VAR")
                  (set (nth (cast size_t (cc_n w)) regs) (cc-env-slot (cc_k w)))
                  break)
                (case (cc-op "RGOAL")
                  (let ((size_t total . #'(cast size_t (cc_n w))))
                    (set h (-> m heap_len))
                    (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                      (aof (-> m heap_cap)) (+ h total) (sizeof u64)))
                        (return 0))
                    (set (-> m heap_len) (+ h total)))
                  break)
                (case (cc-op "RARG_CONST")
                  (let ((u64 c . #'(nth rpc rp))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set rpc (+ rpc 1))
                    (set (nth at (-> m heap)) c)
                    (set (nth (cc_k w) regs) at))
                  break)
                (case (cc-op "RARG_STRUCT")
                  (let ((u64 fid . #'(nth rpc rp))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set rpc (+ rpc 1))
                    (set (nth at (-> m heap)) (coco-cell FUN fid))
                    (set (nth (cc_k w) regs) at))
                  break)
                (case (cc-op "ARG_CONST")
                  (let ((u64 c . #'(nth rpc rp))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set rpc (+ rpc 1))
                    (set (nth at (-> m heap)) c)
                    (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                  break)
                (case (cc-op "ARG_VAR")
                  (set (nth (+ h (cast size_t (cc_n w))) (-> m heap))
                       (coco-cell REF (cc-env-slot (cc_k w))))
                  break)
                (case (cc-op "ARG_STRUCT")
                  (let ((u64 fid . #'(nth rpc rp))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set rpc (+ rpc 1))
                    (set (nth at (-> m heap)) (coco-cell FUN fid))
                    (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                  break)
                (default (return 0)))))
          (return 1)))

  (func coco_env_term ((coco_machine * m) (coco_code * cd) (size_t env) (u32 i)
                       (size_t * out)) (out int)
        (let ((coco_egoal * g . #'(aof (nth i (-> cd egoals))))
              (u64 * prog . #'(+ (-> cd ebody) (-> g tat)))
              (size_t len . #'(cast size_t (-> g tlen)))
              (size_t eb . #'(+ env 4))
              (size_t h . 0) (size_t pc . 0))
          (while (< pc len)
            (let ((u64 w . #'(nth pc prog)))
              (set pc (+ pc 1))
              (switch (cast int (cc_op w))
                (case (cc-op "GOAL_STRUCT")
                  (let ((u64 fid . #'(nth pc prog))
                        (size_t total . #'(cast size_t (cc_n w))))
                    (set pc (+ pc 1))
                    (set h (-> m heap_len))
                    (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                      (aof (-> m heap_cap)) (+ h total) (sizeof u64)))
                        (return 0))
                    (set (-> m heap_len) (+ h total))
                    (set (nth h (-> m heap)) (coco-cell FUN fid))
                    (set (cof out) h))
                  break)
                (case (cc-op "GOAL_ATOM")
                  (let ((u64 c . #'(nth pc prog)) (size_t at . 0))
                    (set pc (+ pc 1))
                    ;; 0 is no room: the environment below is cell 1 or on
                    (set at (coco_push m c))
                    (if (== at 0) (return 0))
                    (set (cof out) at))
                  break)
                (case (cc-op "GOAL_VAR")
                  (set (cof out) (cc-env-slot1 (cc_k w)))
                  break)
                (case (cc-op "ARG_CONST")
                  (let ((u64 c . #'(nth pc prog))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set pc (+ pc 1))
                    (set (nth at (-> m heap)) c)
                    (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                  break)
                (case (cc-op "ARG_VAR")
                  ;; the variable as the clause's entry left it: one link
                  (set (nth (+ h (cast size_t (cc_n w))) (-> m heap))
                       (coco-cell REF (cc-env-slot1 (cc_k w))))
                  break)
                (case (cc-op "ARG_STRUCT")
                  (let ((u64 fid . #'(nth pc prog))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set pc (+ pc 1))
                    (set (nth at (-> m heap)) (coco-cell FUN fid))
                    (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                  break)
                (default (return 0)))))
          (return 1)))

  ;;; A GUARD, DONE IN PLACE (Stage 7): unit U's program over the
  ;;; environment's slots, one goal -- 1 when it passed, 0 with FAILED set
  ;;; when it failed, 0 with FAILED clear when it could not decide and did
  ;;; nothing, for the step to build its term and take it as it always did.
  (static)
  (func coco_env_guard ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                        (int * failed)) (out u32)
        (let ((coco_egoal * g . #'(aof (nth u (-> cd egoals))))
              (size_t eb . #'(+ env 4)) (u32 budget . 1))
          (cc-guards-body (+ (-> cd ebody) (-> g rat)) (cast size_t (-> g rlen)) cc-env-slot 1)))

  ;;; A GUARDX, DONE IN PLACE: unit U's one fused word (`cc_ufuse') reads
  ;;; its two operands, each a slot or a cell, and does nothing unless both
  ;;; are integers; the rest is the stack program's, the same C on the same
  ;;; values. Answers as `coco_env_guard' does.
  (static)
  (func coco_env_guardx ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                         (int * failed)) (out u32)
        (let ((coco_egoal * g . #'(aof (nth u (-> cd egoals))))
              (size_t eb . #'(+ env 4))
              (u64 * fp . #'(+ (-> cd ebody) (-> g rat)))
              (u64 w . #'(nth 0 fp)) (u64 f . #'(cc_n w))
              (u64 ca . #'(nth 1 fp)) (u64 cb . #'(nth 2 fp)) (int pass . 1))
          (set (cof failed) 0)
          (if (not (bitand f 256)) (set ca (nth (cc-env-slot ca) (-> m heap))))
          (if (not (bitand f 512)) (set cb (nth (cc-env-slot cb) (-> m heap))))
          (if (not (and (coco-tag-is INT ca) (coco-tag-is INT cb))) (return 0))
          ;; ON THE CELLS THEMSELVES (2.0.0): an INT is its value times
          ;; sixteen over the tag 2 (four tag bits, 2.5.0), so A + B is the
          ;; cell CA - 2 + CB, A - B the cell CA - CB + 2 and A * B the cell
          ;; (CA - 2) * B + 2 -- and a result past the 60 bits a cell keeps
          ;; is exactly a 64-bit overflow of that sum, which the step boxes.
          ;; Two cells compare as their values do. Through 1.15.0 the values
          ;; were taken out of their cells and the result put back in one,
          ;; wrapping at 61 bits.
          (let ((i64 a . #'(cast i64 ca)) (i64 b . #'(cast i64 cb)))
            (if (== (cc_op w) (cc-op "AG_ISX"))
                (let ((i64 r . 0) (size_t v . 0) (u64 c . 0))
                  (switch (cast int (bitand f 255))
                    (case (cc-gop "+") (if (coco_add_ovf (- a 2) b (aof r)) (return 0)) break)
                    (case (cc-gop "-")
                      (if (coco_sub_ovf a b (aof r)) (return 0))
                      (set r (+ r 2)) break)
                    (case (cc-gop "*")
                      (if (coco_mul_ovf (- a 2) (coco-signed-payload cb) (aof r)) (return 0))
                      (set r (+ r 2)) break)
                    (default (return 0)))
                  ;; the left: bound to the result, or compared with it
                  (set v (cc-env-slot (cc_k w)))
                  (set c (nth v (-> m heap)))
                  (if (coco-tag-is REF c)
                      (coco_bind m v (coco_push m (cast u64 r)))
                      (set pass (== c (cast u64 r)))))
                (switch (cast int (bitand f 255))
                  (case (cc-gop "<") (set pass (< a b)) break)
                  (case (cc-gop ">") (set pass (> a b)) break)
                  (case (cc-gop "=<") (set pass (<= a b)) break)
                  (case (cc-gop ">=") (set pass (>= a b)) break)
                  (case (cc-gop "=:=") (set pass (== a b)) break)
                  (case (cc-gop "numneq") (set pass (!= a b)) break)
                  (default (return 0)))))
          (if pass (return 1))
          (set (cof failed) 1)
          (return 0)))

  ;;; TWO SIDES, DONE IN PLACE (Stage 7): unit U's two arguments read out of
  ;;; the slots as a call's are -- copied when both are variables
  ;;; (`rvars'), anything they nest made in one reservation otherwise
  ;;; (`coco_env_regs') -- and unified (`=/2') or compared (`==/2',
  ;;; `\==/2'), as the builtins unify and compare their two arguments. 1
  ;;; true, 0 false, -1 when the heap would not grow.
  (static)
  (func coco_env_sides ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)) (out int)
        (let ((coco_egoal * g . #'(aof (nth u (-> cd egoals))))
              (size_t rg [8]) (size_t eb . #'(+ env 4)))
          (if (-> g rvars)
              (let ((u64 * rp . #'(+ (-> cd ebody) (-> g rat))))
                (for ((u32 j . 0)) (< j (-> g rlen)) ((++ j))
                  (let ((u64 w . #'(nth j rp)))
                    (set (nth (cast size_t (cc_n w)) rg) (coco_deref m (+ eb (cc_k w)))))))
              (if (not (coco_env_regs m cd env u rg)) (return -1)))
          (switch (cast int (-> g form))
            (case 0 (return (? (coco_unify m (nth 0 rg) (nth 1 rg)) 1 0)))
            (case 1 (return (? (== 0 (coco_compare m (nth 0 rg) (nth 1 rg))) 1 0)))
            (default (return (? (!= 0 (coco_compare m (nth 0 rg) (nth 1 rg))) 1 0))))))

  ;;; A compound of functor FID over X (and Y, for N 2) as they are: the
  ;;; body program's way, never dereferenced.
  (static)
  (func cc_make_raw ((coco_machine * m) (u64 fid) (u32 n) (size_t x) (size_t y) (size_t * out)) (out int)
        (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN fid) n)))
          (if (== h 0) (return 0))
          (set (nth (+ h 1) (-> m heap)) (coco-cell REF x))
          (if (== n 2) (set (nth (+ h 2) (-> m heap)) (coco-cell REF y)))
          (set (cof out) h)
          (return 1)))

  ;;; UNIT U OF THE ENVIRONMENT AT ENV, AS THE TERM ITS FRAME HELD THROUGH
  ;;; 1.9.2 (Stage 6), into OUT -- for a freeze, which writes no
  ;;; environment, and for the tracer, which prints its ports from terms. A
  ;;; goal that is a term is the one entering the clause built, one link
  ;;; from its slot (a BUILTIN's too); a call, a guard and two sides are
  ;;; built from the variable slots (`coco_env_term'); a construct is built
  ;;; back from its parts as it was written, with the functors it was
  ;;; written with; a cut after a condition is `'$cut'(H)' for the height
  ;;; its slot holds. 1, or 0 when the heap would not grow. Recursive over
  ;;; the constructs' nesting, which the compiler keeps under 64.
  (func coco_unit_term ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                        (size_t * out)) (out int)
        (let ((coco_egoal * g . #'(aof (nth u (-> cd egoals))))
              (u32 kind . 0) (size_t x . 0) (size_t y . 0) (size_t z . 0))
          (set kind (-> g kind))
          (if (or (== kind (cc-eg "TERM")) (== kind (cc-eg "BUILTIN")))
              (block
               (set (cof out) (cast size_t (coco-payload (nth (+ env (+ (+ (cast size_t (-> cd nes))
                                                                          (cast size_t (-> g tslot))) 4))
                                                              (-> m heap)))))
               (return 1)))
          (if (or (== kind (cc-eg "CALL")) (== kind (cc-eg "GUARD")) (== kind (cc-eg "GUARDX"))
                  (== kind (cc-eg "SIDES")))
              (return (coco_env_term m cd env u out)))
          (if (or (== kind (cc-eg "CUT")) (== kind (cc-eg "TRUE")) (== kind (cc-eg "FAIL")))
              (block (set x (coco_push m (coco-cell ATOM (-> g fid))))
                     (if (== x 0) (return 0))
                     (set (cof out) x)
                     (return 1)))
          (if (== kind (cc-eg "CUTC"))
              (block (set x (coco_new_int m (coco-signed-payload
                                             (nth (coco-env-slot-at env cd (-> g tslot)) (-> m heap)))))
                     (if (== x 0) (return 0))
                     (return (cc_make_raw m (-> g fid) 1 x 0 out))))
          (if (== kind (cc-eg "CONJ"))
              (let ((size_t items [64]) (u32 n . 0) (u32 v . #'(-> g a)))
                (while (and (!= v 0) (< n 64))
                  (if (not (coco_unit_term m cd env v (aof (nth n items)))) (return 0))
                  (set n (+ n 1))
                  (set v ($ (nth v (-> cd egoals)) sib)))
                (if (== n 0) (return 0))
                ;; right-nested, as it was written
                (set x (nth (- n 1) items))
                (while (> n 1)
                  (set n (- n 1))
                  (if (not (cc_make_raw m (-> g fid) 2 (nth (- n 1) items) x (aof x))) (return 0)))
                (set (cof out) x)
                (return 1)))
          (if (== kind (cc-eg "DISJ"))
              (block (if (not (coco_unit_term m cd env (-> g a) (aof x))) (return 0))
                     (if (not (coco_unit_term m cd env (-> g b) (aof y))) (return 0))
                     (return (cc_make_raw m (-> g fid) 2 x y out))))
          (if (== kind (cc-eg "ITE"))
              (block
               (if (not (coco_unit_term m cd env (-> g a) (aof x))) (return 0))
               (if (== (-> g form) 0)
                   (block (if (not (coco_unit_term m cd env (-> g b) (aof y))) (return 0))
                          (if (not (cc_make_raw m (-> g fid2) 2 x y (aof z))) (return 0))
                          (if (not (coco_unit_term m cd env (-> g c) (aof y))) (return 0))
                          (return (cc_make_raw m (-> g fid) 2 z y out))))
               (if (== (-> g form) 1)
                   (block (if (not (coco_unit_term m cd env (-> g b) (aof y))) (return 0))
                          (return (cc_make_raw m (-> g fid) 2 x y out))))
               (return (cc_make_raw m (-> g fid) 1 x 0 out))))
          (return 0)))

  ;;; ---- reclaiming the store ---------------------------------------------
  ;;;
  ;;; THE STORE NEVER SHRANK, and `nb_setval/2' was the bill. Every write
  ;;; copies a whole term into `cells' -- a clause, a global's new value, a
  ;;; ball, each solution a `findall/3' keeps -- and nothing ever took one
  ;;; out: a retract dropped the clause from its predicate and orphaned the
  ;;; cells, and a global written again simply pointed elsewhere. Measured
  ;;; on cicili-lang's driver, which keeps its symbol tables in globals and
  ;;; writes them back after every step: 105 049 `nb_setval' calls, 103 192
  ;;; of them overwrites, put 1 073 MB into a store whose LIVE contents --
  ;;; every clause of every predicate and the current value of every global
  ;;; -- came to 20 MB. Ninety-eight per cent garbage, and it was the
  ;;; larger half of a process that needed 3.4 GB to compile 12 lines of
  ;;; C++.
  ;;;
  ;;; COMPACTION COPIES WHAT IS REACHABLE AND DROPS THE ARRAY. Everything
  ;;; the store can still reach is a root the store itself holds -- a
  ;;; `clauses[]' entry of some predicate, or a global's `cell' -- and a
  ;;; term is copied out to the heap and back into a fresh array by the two
  ;;; walkers that put it there, so a compacted term is exactly what an
  ;;; `assertz' of its copy would have stored. The heap is wound back after
  ;;; every term. Nothing else moves: `keys' hold cell VALUES, `chain' and
  ;;; `slots' hold positions, `origins' hold atoms, so the first-argument
  ;;; index stays valid across a compaction and `clause_ix' goes on meaning
  ;;; what it meant.
  ;;;
  ;;; WHEN: at a SAFE POINT, once at least four million cells (32 MB) are
  ;;; known dead and they outnumber the live ones -- or, as the net under
  ;;; that, once the store has grown by as much again as it held at the
  ;;; last compaction and by those 32 MB. The dead are counted where a
  ;;; death is cheap to see: a global's old value (its size is kept beside
  ;;; its cell), a retracted or reconsulted clause and an initialization
  ;;; goal that has run (each was just copied to the heap, and the span is
  ;;; the copy's length and a cell for each of its variables --
  ;;; `coco_store_get_span'), a findall's solutions (their puts are its own),
  ;;; a ball once caught. The growth net is for whatever a site forgets to
  ;;; count, because the one it forgets is the one that grows without
  ;;; bound; its price is a compaction of a store that is all live once per
  ;;; doubling, the amortised cost of the `realloc' it already pays. The
  ;;; first draft counted growth alone, and 3 000 `asserta' calls followed
  ;;; by 2 999 retracts kept 192 MB for 16 KB of clauses: the mark had been
  ;;; set while everything was live, and a retract never lowered it.
  ;;; `garbage_collect/0' forces one.
  ;;;
  ;;; A SAFE POINT IS ONE WHERE EVERY CELL INDEX ANYBODY HOLDS IS ONE THE
  ;;; STORE KNOWS ABOUT. Two callers keep indices of their own for a
  ;;; while: `coco_engine_findall' keeps each solution's root in an array
  ;;; until the search is over, and a consult keeps its `initialization/1'
  ;;; goals until they have run. Both REGISTER the array (`coco_store_root_push',
  ;;; a stack, popped on the way out) and a compaction rewrites its entries
  ;;; like any other root. Registered rather than declined, because a
  ;;; `forall/2' IS a findall and a script's whole life runs inside its
  ;;; `initialization(main)' -- a compaction declined under either would
  ;;; never have happened at all. A ball is put and read back by the frame
  ;;; that catches it with no goal run between; a clause is registered
  ;;; before its assert returns. Everything else that reads a cell reads
  ;;; it at once.
  ;;;
  ;;; THE CHECK SITES: `nb_setval/2', the assert and retract builtins,
  ;;; `abolish/1', the end of a `findall/3', a caught throw, and the end of
  ;;; a consult. Each one asks; the policy lives here.

  (func coco_store_compact ((coco_store * st) (coco_machine * m)) (out int)
        ;; A GREEN WORLD HOLDS OTHER MACHINES' FRAMES (2.7.0): the compaction
        ;; moves cells those machines' engines name, and its roots are the
        ;; writing machine's. Leave the store grown until the world ends.
        (if (!= (-> st machines) nil) (return 0))
        (let ((coco_store tmp)
              (size_t nroots . 0) (size_t * roots . nil) (size_t k . 0)
              (size_t hmark . #'(-> m heap_len)))
          (memset (aof tmp) 0 (sizeof coco_store))
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (set nroots (+ nroots ($ (nth i (-> st preds)) nclauses))))
          (set nroots (+ nroots (-> st nglobals)))
          (for ((size_t i . 0)) (< i (-> st nroots)) ((++ i))
            (set nroots (+ nroots (cof ($ (nth i (-> st roots)) len)))))
          (set roots (cast (size_t *) (malloc (* (+ nroots 1) (sizeof size_t)))))
          (if (== roots nil) (return 0))
          ;; ONE ALLOCATION, EXACTLY SIZED, AND THE REASON IS A FROZEN MACHINE.
          ;; The new array used to be grown by `coco_store_grow' as the copy
          ;; filled it -- doubling from 64 cells, which for a large store is a
          ;; LADDER of large reallocs (16, 32, 64, 128, 256 MB), each one a
          ;; fresh region while the old store is still held, and the last rung
          ;; overshooting past what was needed. Reported from CivV as a window
          ;; that took a 16 GB machine down with 122 MALLOC_REALLOC regions of
          ;; 128 MB while `store_used' read 28 MB: the peak is not the store,
          ;; it is what compacting the store transiently costs. Measured here,
          ;; 64 MB live: 86 large blocks and a 580 MB peak.
          ;;
          ;; What is live cannot exceed what is there, so `len' is an upper
          ;; bound known before the walk starts: size the array to exactly
          ;; that and `coco_store_grow' never fires, because the cap is
          ;; already enough.
          ;;
          ;; A SEMISPACE WAS TRIED HERE AND REVERTED, because the thing it
          ;; bought was already free. Keeping the old array to copy into next
          ;; time removes a large malloc and a large free per compaction --
          ;; and those cost nothing on Darwin: 100 alloc/free cycles of 128 MB
          ;; leave `phys_footprint' at ZERO, measured, so a freed large region
          ;; goes back at once rather than sitting dirty in the allocator's
          ;; cache. The spare's footprint was real and its benefit was not.
          ;; (Which also says what CivV's 122 live MALLOC_REALLOC regions of
          ;; 128 MB were NOT: not allocator debris, so something held them.)
          (let ((size_t want . #'(? (> (-> st len) 0) (-> st len) 1)))
            (set ($ tmp cells) (cast (u64 *) (malloc (* want (sizeof u64)))))
            (if (== ($ tmp cells) nil) (block (free roots) (return 0)))
            (set ($ tmp cap) want))
          ;; pass one: every live term through the heap into the fresh array,
          ;; in a fixed order -- the predicates' clauses, then the globals
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (let ((coco_pred * p . #'(aof (nth i (-> st preds)))))
              (for ((size_t j . 0)) (< j (-> p nclauses)) ((++ j))
                (let ((size_t h . #'(coco_store_get m st (nth j (-> p clauses)))))
                  (set (nth k roots) (coco_store_put (aof tmp) m h))
                  (set k (+ k 1))
                  (set (-> m heap_len) hmark)))))
          (for ((size_t i . 0)) (< i (-> st nglobals)) ((++ i))
            (let ((size_t h . #'(coco_store_get m st ($ (nth i (-> st globals)) cell))))
              (set (nth k roots) (coco_store_put (aof tmp) m h))
              (set ($ (nth i (-> st globals)) size) (- ($ tmp len) (nth k roots)))
              (set k (+ k 1))
              (set (-> m heap_len) hmark)))
          (for ((size_t i . 0)) (< i (-> st nroots)) ((++ i))
            (let ((coco_rootset * rs . #'(aof (nth i (-> st roots)))))
              (for ((size_t j . 0)) (< j (cof (-> rs len))) ((++ j))
                (let ((size_t h . #'(coco_store_get m st (nth j (cof (-> rs cells))))))
                  (set (nth k roots) (coco_store_put (aof tmp) m h))
                  (set k (+ k 1))
                  (set (-> m heap_len) hmark)))))
          ;; an allocation that failed leaves the old store exactly as it was
          ;; an allocation that failed leaves the old store exactly as it was
          (if (or ($ tmp oom) (-> m oom))
              (block (free ($ tmp cells)) (free roots) (return 0)))
          ;; pass two: the roots move, and nothing else does. Each clause's
          ;; compiled program stays its own, found by the old cell while the
          ;; table still knows it, and is keyed by the new one below
          (set k 0)
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (let ((coco_pred * p . #'(aof (nth i (-> st preds)))))
              (for ((size_t j . 0)) (< j (-> p nclauses)) ((++ j))
                (let ((coco_code * cd . #'(cast (coco_code *) (nth j (-> p codes)))))
                  (if (== cd nil) (set cd (coco_code_find st (nth j (-> p clauses)))))
                  (if (!= cd nil) (set (-> cd kept) 1))
                  (set (nth j (-> p codes)) (cast (void *) cd)))
                (set (nth j (-> p clauses)) (nth k roots))
                (set k (+ k 1)))))
          (for ((size_t i . 0)) (< i (-> st nglobals)) ((++ i))
            (set ($ (nth i (-> st globals)) cell) (nth k roots))
            (set k (+ k 1)))
          (for ((size_t i . 0)) (< i (-> st nroots)) ((++ i))
            (let ((coco_rootset * rs . #'(aof (nth i (-> st roots)))))
              (for ((size_t j . 0)) (< j (cof (-> rs len))) ((++ j))
                (set (nth j (cof (-> rs cells))) (nth k roots))
                (set k (+ k 1)))))
          ;; and the slack the upper bound left over goes back: a SHRINKING
          ;; realloc trims the tail rather than copying, so the store really
          ;; does come down to what it holds, which is what the number
          ;; `garbage_collect/0' moves ought to mean.
          (if (< ($ tmp len) ($ tmp cap))
              (let ((size_t keep . #'(? (> ($ tmp len) 0) ($ tmp len) 1))
                    (void * trimmed))
                (set trimmed (realloc (cast (void *) ($ tmp cells)) (* keep (sizeof u64))))
                (if (!= trimmed nil)
                    (block (set ($ tmp cells) (cast (u64 *) trimmed))
                           (set ($ tmp cap) keep)))))
          (free (-> st cells))
          (set (-> st cells) ($ tmp cells))
          (set (-> st len) ($ tmp len))
          (set (-> st cap) ($ tmp cap))
          (set (-> st mark) ($ tmp len))
          (set (-> st dead) 0)
          (set (-> st ncompacts) (+ (-> st ncompacts) 1))
          ;; EVERY CLAUSE CELL MOVED, so every compiled clause is keyed by a
          ;; cell that no longer means it -- and was compiled again on the
          ;; next ask through 1.9.2. It is KEYED AGAIN instead (Stage 5): a
          ;; code holds constants and functor ids, never a store cell, so
          ;; it is as good as it was, and an environment on the heap may be
          ;; part way through it, so it may not be freed under a running
          ;; body -- and a compaction runs at a safe point INSIDE a query
          ;; (a throw, a findall). What no live clause owns any more goes
          ;; the way a dead clause's code goes (`coco_code_retire').
          (for ((size_t i . 0)) (< i (-> st code_cap)) ((++ i))
            (if (!= (nth i (-> st code_keys)) 0)
                (let ((coco_code * cd . #'(cast (coco_code *) (nth i (-> st code_vals)))))
                  (if (not (-> cd kept)) (coco_code_retire st cd))
                  (set (nth i (-> st code_keys)) 0)
                  (set (nth i (-> st code_vals)) nil))))
          (set (-> st code_len) 0)
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (let ((coco_pred * p . #'(aof (nth i (-> st preds)))))
              (for ((size_t j . 0)) (< j (-> p nclauses)) ((++ j))
                (let ((coco_code * cd . #'(cast (coco_code *) (nth j (-> p codes)))))
                  (if (and (!= cd nil) (-> cd kept))
                      (block (set (-> cd kept) 0)
                             ;; a table that would not grow loses the key,
                             ;; not the code: the predicate's slot keeps it
                             (coco_code_put st (nth j (-> p clauses)) cd)))))))
          (free roots)
          (return 1)))

  (func coco_store_maybe_compact ((coco_store * st) (coco_machine * m)) (out int)
        (if (!= (-> st machines) nil) (return 0))
        (if (!= (-> st private) 0) (return 0))
        (let ((size_t growth . #'(- (-> st len) (-> st mark)))
              (size_t dead . #'(-> st dead))
              (size_t live . #'(? (> (-> st len) (-> st dead)) (- (-> st len) (-> st dead)) 0)))
          ;; enough known dead, and more of them than live
          (if (and (>= dead 4194304) (>= dead live)) (return (coco_store_compact st m)))
          ;; or, whatever was counted, grown by as much again as was live
          (if (and (>= growth 4194304) (>= growth (-> st mark))) (return (coco_store_compact st m)))
          (return 0)))

  (func coco_store_root_push ((coco_store * st) (size_t ** cells) (size_t * len)) (out int)
        (if (not (coco_store_grow st (cast (void **) (aof (-> st roots)))
                                (aof (-> st root_cap)) (+ (-> st nroots) 1)
                                (sizeof coco_rootset)))
            (return 0))
        (set ($ (nth (-> st nroots) (-> st roots)) cells) cells)
        (set ($ (nth (-> st nroots) (-> st roots)) len) len)
        (set (-> st nroots) (+ (-> st nroots) 1))
        (return 1))

  (func coco_store_root_pop ((coco_store * st))
        (if (> (-> st nroots) 0) (set (-> st nroots) (- (-> st nroots) 1))))

  ;;; The term is copied to the heap, measured there (`coco_store_get_span':
  ;;; the copy's length is not the span) and wound back.
  (func coco_store_orphan ((coco_store * st) (coco_machine * m) (size_t cell))
        ;; a clause's compiled program dies with it
        (coco_code_drop st cell)
        (let ((size_t mark . #'(-> m heap_len))
              (size_t span . 0))
          (coco_store_get_span m st cell (aof span))
          (set (-> st dead) (+ (-> st dead) span))
          (set (-> m heap_len) mark)))

  ;;; ---- predicates -------------------------------------------------------

  ;;; The predicate table at twice the size, or at 256 the first time, every
  ;;; entry put back from `preds' itself.
  (static)
  (func coco_preds_rehash ((coco_store * st)) (out int)
        (let ((size_t ncap . #'(? (== (-> st pred_bucket_cap) 0) 256
                                  (* (-> st pred_bucket_cap) 2)))
              (size_t * nb . #'(cast (size_t *) (calloc ncap (sizeof size_t)))))
          (if (== nb nil) (block (set (-> st oom) 1) (return 0)))
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (let ((size_t j . #'(cast size_t
                                      (bitand (coco_name_arity_hash ($ (nth i (-> st preds)) name)
                                                                    ($ (nth i (-> st preds)) arity))
                                              (cast u64 (- ncap 1))))))
              (while (!= (nth j nb) 0)
                (set j (bitand (+ j 1) (- ncap 1))))
              (set (nth j nb) (+ i 1))))
          (free (-> st pred_buckets))
          (set (-> st pred_buckets) nb)
          (set (-> st pred_bucket_cap) ncap)
          (return 1)))

  ;;; The slot NAME/ARITY is in, or would go into: probing from its hash, the
  ;;; first slot that holds it or is empty. `coco_pred_make' keeps the table
  ;;; under half full, so the probe always ends.
  (static)
  (func coco_pred_slot ((coco_store * st) (u64 name) (u32 arity)) (out size_t)
        (let ((size_t mask . #'(- (-> st pred_bucket_cap) 1))
              (size_t j . 0))
          (set j (cast size_t (bitand (coco_name_arity_hash name arity) (cast u64 mask))))
          (while (!= (nth j (-> st pred_buckets)) 0)
            (let ((size_t i . #'(- (nth j (-> st pred_buckets)) 1)))
              (if (and (== ($ (nth i (-> st preds)) name) name)
                       (== ($ (nth i (-> st preds)) arity) arity))
                  (return j)))
            (set j (bitand (+ j 1) mask)))
          (return j)))

  ;;; HASHED, as the functor table is and for the same reason: a store that
  ;;; holds a library has hundreds of predicates, and this is asked on every
  ;;; call -- as a scan it was 15 % of the translator's instructions. It
  ;;; answers NPREDS for a predicate the store does not have, as it always
  ;;; did, and a store with no table yet has no predicate yet.
  (func coco_pred_find ((coco_store * st) (u64 name) (u32 arity)) (out size_t)
        (if (== (-> st pred_buckets) nil) (return (-> st npreds)))
        (let ((size_t j . #'(coco_pred_slot st name arity)))
          (if (== (nth j (-> st pred_buckets)) 0) (return (-> st npreds)))
          (return (- (nth j (-> st pred_buckets)) 1))))

  (static) (decl) (func coco_pred_make ((coco_store * st) (u64 name) (u32 arity)) (out size_t))

  (func coco_pred_intern ((coco_store * st) (u64 name) (u32 arity)) (out size_t)
        (return (coco_pred_make st name arity)))

  (static)
  (func coco_pred_make ((coco_store * st) (u64 name) (u32 arity)) (out size_t)
        (let ((size_t i . #'(coco_pred_find st name arity)))
          (if (< i (-> st npreds)) (return i))
          ;; THE FIRST CALL CREATES IT (2.9.0): the one store is changed
          ;; with every other worker stopped at its safe point.
          (with-green-write nil
          ;; THE FIND AGAIN, NOW THAT THE OTHER WORKERS ARE STOPPED. The
          ;; find above is lock-free and this is a double-checked lock: a
          ;; reader's call creates a predicate too (`coco_pred_of'), and
          ;; one may have made the entry between that find and this
          ;; barrier. Creating a SECOND entry for the same name overwrites
          ;; the bucket slot, and the clauses already attached to the
          ;; first become unreachable -- a concurrent stress lost each
          ;; writer's first one or two asserts that way. Under the barrier
          ;; the recheck sees the stable state, the world lock having
          ;; ordered the two creations.
          (let ((size_t j . #'(coco_pred_find st name arity)))
            (if (< j (-> st npreds)) (return j)))
          ;; under half full before the probe that places it
          (if (> (* (+ (-> st npreds) 1) 2) (-> st pred_bucket_cap))
              (if (not (coco_preds_rehash st)) (return (-> st npreds))))
          (if (not (coco_store_grow st (cast (void **) (aof (-> st preds)))
                                  (aof (-> st pred_cap)) (+ (-> st npreds) 1)
                                  (sizeof coco_pred)))
              (return (-> st npreds)))
          (memset (aof (nth (-> st npreds) (-> st preds))) 0 (sizeof coco_pred))
          (set ($ (nth (-> st npreds) (-> st preds)) name) name)
          (set ($ (nth (-> st npreds) (-> st preds)) arity) arity)
          (set (nth (coco_pred_slot st name arity) (-> st pred_buckets)) (+ (-> st npreds) 1))
          (set (-> st npreds) (+ (-> st npreds) 1))
          (return (- (-> st npreds) 1)))))

  (func coco_pred_of ((coco_store * st) (coco_machine * m) (size_t goal)) (out size_t)
        (set goal (coco_deref m goal))
        (if (not (coco_is_callable m goal)) (return (-> st npreds)))
        (return (coco_pred_make st (coco_name_of m goal) (coco_arity m goal))))

  ;;; THE DECLARATIONS A BACKEND HAS ALREADY SHOWN US, for the next store.
  ;;;
  ;;; A `run_isolated/2' half is a fresh store. A call to a predicate the
  ;;; backend DECLARED dynamic but never wrote to has no clauses to fetch,
  ;;; so the store does not know it is dynamic and the engine asks the
  ;;; backend for every declaration (`coco_store_warm'). The first half pays
  ;;; that scan once; every later half paid it again, because the knowledge
  ;;; -- "this name/arity is dynamic even with no rows" -- lived only in the
  ;;; store that had just died. Measured from CivV: three empty dynamics,
  ;;; one per computer half, 64, 62 and 66 ms; one seeded row cured each
  ;;; half because then the fetch had a clause.
  ;;;
  ;;; The declaration is program text, not a row: it cannot be withdrawn,
  ;;; and it is the same in every store of one backend. Remembering it here
  ;;; lets `coco_pred_ensure' mark a fresh store's empty predicate dynamic
  ;;; after its one per-predicate fetch, with no whole-store warm. Only a
  ;;; store WITH a backend consults it, so a local store keeps raising for
  ;;; a name nobody declared.
  (struct coco_dynamic_ent
    (member char * name)
    (member u32    arity))

  (static) (var coco_dynamic_ent * coco_dynamic_tab . nil)
  (static) (var size_t coco_dynamic_n . 0)
  (static) (var size_t coco_dynamic_cap . 0)
  ;; written by a `run_isolated' half and read by the next, possibly on
  ;; different OS threads; the declaration is monotonic, the table is not
  (static) (var pthread_mutex_t coco_dynamic_mx . PTHREAD_MUTEX_INITIALIZER)

  (static)
  (func coco_dynamic_has_locked ((const char * name) (u32 arity)) (out int)
        (for ((size_t i . 0)) (< i coco_dynamic_n) ((++ i))
          (if (and (== arity ($ (nth i coco_dynamic_tab) arity))
                   (== 0 (strcmp name ($ (nth i coco_dynamic_tab) name))))
              (return 1)))
        (return 0))

  (func coco_dynamic_known ((const char * name) (u32 arity)) (out int)
        (if (== name nil) (return 0))
        (pthread_mutex_lock (aof coco_dynamic_mx))
        (let ((int has . #'(coco_dynamic_has_locked name arity)))
          (pthread_mutex_unlock (aof coco_dynamic_mx))
          (return has)))

  (func coco_dynamic_remember ((const char * name) (u32 arity)) (out int)
        (if (== name nil) (return 0))
        (pthread_mutex_lock (aof coco_dynamic_mx))
        (let ((int answer . 0) (size_t len . 0) (char * copy . nil))
          (if (coco_dynamic_has_locked name arity)
              (block (pthread_mutex_unlock (aof coco_dynamic_mx)) (return 0)))
          (if (>= coco_dynamic_n coco_dynamic_cap)
              (let ((size_t ncap . #'(? (== coco_dynamic_cap 0) 64 (* coco_dynamic_cap 2)))
                    (void * nb))
                (set nb (realloc (cast (void *) coco_dynamic_tab)
                                 (* ncap (sizeof coco_dynamic_ent))))
                (if (== nb nil)
                    (block (pthread_mutex_unlock (aof coco_dynamic_mx)) (return 0)))
                (set coco_dynamic_tab (cast (coco_dynamic_ent *) nb))
                (set coco_dynamic_cap ncap)))
          (set len (+ (strlen name) 1))
          (set copy (cast (char *) (malloc len)))
          (if (!= copy nil)
              (block
               (memcpy (cast (void *) copy) (cast (const void *) name) len)
               (set ($ (nth coco_dynamic_n coco_dynamic_tab) name) copy)
               (set ($ (nth coco_dynamic_n coco_dynamic_tab) arity) arity)
               (set coco_dynamic_n (+ coco_dynamic_n 1))
               (set answer 1)))
          (pthread_mutex_unlock (aof coco_dynamic_mx))
          (return answer)))

  ;;; The backend is asked once per predicate and the answer is remembered
  ;;; whether or not it produced clauses -- otherwise a call to an undefined
  ;;; predicate inside a loop is a database round trip per iteration.
  ;;;
  ;;; A READ THAT FAILED IS NO ANSWER (2.11.1), and is not remembered as one.
  ;;; It answers 0 with the reason on the store (`fetch_err', `fetch_pi',
  ;;; `fetch_oom') and leaves nothing behind: the clauses the fetch had added
  ;;; before it failed are taken out again, the predicate is not marked
  ;;; loaded, so the next call asks the backend again, and `empty_fetch'
  ;;; stays unset, so the pre-warm never takes a failure for an absence.
  ;;; Through 2.11.0 the predicate was marked loaded before the fetch and
  ;;; kept whatever arrived, and every caller ignored the answer: one row
  ;;; this binary could not read and the predicate answered the others in
  ;;; silence -- and the next `assertz' rewrote it whole from that copy, and
  ;;; the database lost the row (an outside review's finding, reproduced on
  ;;; the server). Every caller now raises on the 0 (`coco_fetch_error' in
  ;;; lib/solve.cicili), and a write refuses before it touches the predicate.
  ;;;
  ;;; Out of range answers 1: there is nothing to ask about, and the caller's
  ;;; own test of the index is what refuses it.
  (static) (decl) (func coco_pred_cut_back ((coco_store * st) (size_t pi) (size_t keep)))

  (func coco_pred_ensure ((coco_store * st) (size_t pi)) (out int)
        (if (>= pi (-> st npreds)) (return 1))
        (if ($ (nth pi (-> st preds)) loaded) (return 1))
        (with-green-write nil
          (if ($ (nth pi (-> st preds)) loaded) (return 1))
          ;; loaded BEFORE the hook runs: the clauses it asserts find the
          ;; predicate loaded, and do not ask the backend again
          (set ($ (nth pi (-> st preds)) loaded) 1)
          (if (== (-> st fetch) nil) (return 1))
          (set (nth 0 (-> st fetch_err)) (cast char 0))
          (set (-> st fetch_oom) 0)
        ;; WHETHER THE BACKEND HAD ANYTHING, recorded where it can be seen:
        ;; the fetch is the only moment the difference shows, because a module's
        ;; predicate has its own clauses either way. `coco_store_prewarm' reads it.
        (let ((size_t before . #'($ (nth pi (-> st preds)) nclauses))
              (size_t len0 . #'(-> st len))
              (int rc . #'((-> st fetch) st (-> st ctx)
                                            ($ (nth pi (-> st preds)) name)
                                            ($ (nth pi (-> st preds)) arity))))
          (if (== rc 0)
              (block
                (coco_pred_cut_back st pi before)
                ;; the cells those clauses were put into belong to nothing
                ;; now; counted, the next compaction takes them
                (if (> (-> st len) len0)
                    (set (-> st dead) (+ (-> st dead) (- (-> st len) len0))))
                (set ($ (nth pi (-> st preds)) loaded) 0)
                (set (-> st fetch_pi) pi)
                (if (== (nth 0 (-> st fetch_err)) (cast char 0))
                    (snprintf (-> st fetch_err) 256 "%s" "the knowledge base did not answer"))
                (return 0)))
          (if (== ($ (nth pi (-> st preds)) nclauses) before)
              (set ($ (nth pi (-> st preds)) empty_fetch) 1))
          ;; A DECLARATION AN EARLIER STORE ALREADY FOUND: mark this empty
          ;; predicate dynamic and let the call fail here. The alternative
          ;; is the whole-store warm on the existence-error path below,
          ;; every fresh `run_isolated' half. A NAME the backend has rows
          ;; for never reaches this test, because the fetch added them.
          (if (and (!= (-> st warm) nil)
                   (== ($ (nth pi (-> st preds)) nclauses) before)
                   (not ($ (nth pi (-> st preds)) dynamic))
                   (!= (-> st name_m) nil)
                   (coco_dynamic_known
                    (coco_atom_name (cast (coco_machine *) (-> st name_m))
                                    ($ (nth pi (-> st preds)) name))
                    ($ (nth pi (-> st preds)) arity)))
              (set ($ (nth pi (-> st preds)) dynamic) 1))
          (return rc))))

  ;;; THE CLAUSES PI HAS, READ FROM THE BACKEND FIRST WHERE THEY WERE NOT
  ;;; (2.11.1): `coco_pred_ensure', answering the count the step tests next
  ;;; anyway, and 0 when the read failed. So a failed read takes the step's
  ;;; way for a predicate with no clauses, where `loaded' (0 only after a
  ;;; failed read) tells it from one and the step raises it, and the way for
  ;;; a predicate with clauses has no test it did not have through 2.11.0.
  ;;; (weak), never inlined: a test of the answer in the step loop itself
  ;;; gave the failure 3/8 of every call's path in clang's estimate, which put
  ;;; the loop's calls of `coco_push_choice' and `coco_arg_key' under its
  ;;; threshold for a cold call site, and left them out of line (queens
  ;;; +3.1 % of its work, tools/flow/zero.sh). A predicate read already is
  ;;; answered here, without the call of `coco_pred_ensure' (two calls a
  ;;; call cost naive reverse 2.6 % of its work). AND COLD (2.11.3): the
  ;;; step calls it only for a predicate not read yet (`coco_pred_count').
  (weak) (cold)
  (func coco_pred_ready ((coco_store * st) (size_t pi)) (out size_t)
        (if ($ (nth pi (-> st preds)) loaded)
            (return ($ (nth pi (-> st preds)) nclauses)))
        (if (not (coco_pred_ensure st pi)) (return 0))
        (return ($ (nth pi (-> st preds)) nclauses)))

  ;;; THE COUNT THE STEP TESTS (2.11.3): a predicate read already answers
  ;;; its clause count here, inline, and only one not read yet -- its first
  ;;; call, or the next one after a read that failed -- goes to
  ;;; `coco_pred_ready'. THE CALL WAS THE GREEN WORLD'S WHOLE COST TO THE
  ;;; UNTRACED ENGINE: through 2.8.1 clang inlined `coco_pred_ensure' into
  ;;; the step, whose price a call was its first two tests; 2.9.0's write
  ;;; barrier made its body too big to inline, and every call of a plain
  ;;; predicate paid a call of 19 instructions (nrev +2.53 % of its work,
  ;;; queens +1.39 %, lookup +1.13 %), which no release counted; 2.11.1's
  ;;; `coco_pred_ready' made it 12. Answered inline, the test costs the
  ;;; loop nothing that counts -- `coco_engine_run' ran a few instructions
  ;;; FEWER -- and against 2.11.2 nrev runs 1.87 % fewer instructions,
  ;;; queens 0.73 %, lookup 0.98 % (tools/flow/zero.sh) and the loop 1.52 %
  ;;; (STATUS.md, 2.11.3).
  (static) (inline)
  (func coco_pred_count ((coco_store * st) (size_t pi)) (out size_t)
        (if ($ (nth pi (-> st preds)) loaded)
            (return ($ (nth pi (-> st preds)) nclauses)))
        (return (coco_pred_ready st pi)))

  ;;; ------------------------------------------------------------------
  ;;; PRE-WARM: the predicates a MODULE owns that the knowledge base has no
  ;;; rows for, remembered once for the whole process.
  ;;;
  ;;; WHY IT EXISTS. `run_isolated/2' gives every httpd request a fresh store,
  ;;; and a fresh store asks the backend once per predicate -- `coco_pred_ensure'
  ;;; above. Measured on a page that reads one row over the binary protocol:
  ;;; 52 predicates asked A REQUEST, 6.06 ms of a 10.47 ms request spent inside
  ;;; the hook, 117 us a fetch, against 0.99 ms for the same page on a store
  ;;; that persists. FIFTY-ONE of the 52 are a module's own -- 27 of
  ;;; library(http), 18 of library(httpd), six of the tier-1 libraries -- and
  ;;; every one is a question whose answer cannot change while the process
  ;;; runs, because the module registry is fixed once the modules are loaded.
  ;;;
  ;;; ONLY THE ABSENCE IS REMEMBERED. A predicate joins this table when a real
  ;;; fetch was made for it and the backend added NOTHING, so a later store may
  ;;; mark it loaded without asking. If the backend DID have rows the predicate
  ;;; is not in the table and every store fetches it exactly as before. The
  ;;; program's own predicates are never in it, because only a MUTED assert
  ;;; sets `library' -- which is the same flag `listing' uses to tell the
  ;;; library from the program.
  ;;;
  ;;; THE STALENESS CONTRACT IS NARROW AND IS THE WHOLE COST. Another process
  ;;; asserting into a predicate a MODULE defines -- `member/2',
  ;;; `httpd_route/3' -- after the pre-warm will not be seen here. Nothing else
  ;;; changes: the program's own predicates are fetched on every request with
  ;;; the freshness they always had. It is the module registry's own contract,
  ;;; and it carries the module registry's own rule -- PRE-WARM BEFORE YOU
  ;;; SPAWN. The table is written once and then read by every worker thread
  ;;; with no lock, exactly as `use_module' is.
  (struct coco_prewarm_ent
    (member char * name)
    (member u32    arity))

  (static) (var coco_prewarm_ent * coco_prewarm_tab . nil)
  (static) (var size_t coco_prewarm_n . 0)
  (static) (var size_t coco_prewarm_cap . 0)

  (func coco_prewarm_has ((const char * name) (u32 arity)) (out int)
        (if (== coco_prewarm_tab nil) (return 0))
        (for ((size_t i . 0)) (< i coco_prewarm_n) ((++ i))
          (if (and (== arity ($ (nth i coco_prewarm_tab) arity))
                   (== 0 (strcmp name ($ (nth i coco_prewarm_tab) name))))
              (return 1)))
        (return 0))

  (static)
  (func coco_prewarm_add ((const char * name) (u32 arity)) (out int)
        (if (coco_prewarm_has name arity) (return 0))
        (if (>= coco_prewarm_n coco_prewarm_cap)
            (let ((size_t ncap . #'(? (== coco_prewarm_cap 0) 64 (* coco_prewarm_cap 2)))
                  (void * nb))
              (set nb (realloc (cast (void *) coco_prewarm_tab)
                               (* ncap (sizeof coco_prewarm_ent))))
              (if (== nb nil) (return 0))
              (set coco_prewarm_tab (cast (coco_prewarm_ent *) nb))
              (set coco_prewarm_cap ncap)))
        (let ((size_t len . #'(+ (strlen name) 1))
              (char * copy))
          (set copy (cast (char *) (malloc len)))
          (if (== copy nil) (return 0))
          (memcpy (cast (void *) copy) (cast (const void *) name) len)
          (set ($ (nth coco_prewarm_n coco_prewarm_tab) name) copy)
          (set ($ (nth coco_prewarm_n coco_prewarm_tab) arity) arity)
          (set coco_prewarm_n (+ coco_prewarm_n 1))
          (return 1)))

  ;;; Fetch every library predicate this store has not asked about yet, and
  ;;; remember the ones the backend had nothing for. The clause count before
  ;;; and after is what says so: a module's predicate already HAS clauses --
  ;;; its own -- so an empty predicate is not the test, an unchanged one is.
  ;;;
  ;;; `preds' is re-read through the store on every line rather than held in a
  ;;; pointer: a fetch may intern predicates of its own and grow the array,
  ;;; which is also why the loop re-reads `npreds'.
  (func coco_store_prewarm ((coco_store * st) (coco_machine * m)) (out size_t)
        (let ((size_t added . 0))
          (if (== (-> st fetch) nil) (return 0))
          ;; the names this pass interns are the root's; the declaration
          ;; cache in `coco_pred_ensure' resolves through the same table
          (if (== (-> st name_m) nil)
              (set (-> st name_m) (cast (void *) (coco_troot m))))
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (if ($ (nth i (-> st preds)) library)
                (block
                  ;; A LIBRARY PREDICATE THIS STORE HAS NOT ASKED ABOUT IS
                  ;; ASKED NOW; one already asked carries its own answer in
                  ;; `empty_fetch', so the pass does not depend on whether
                  ;; the program called something before it got here. It was
                  ;; ordering alone that left `httpd_option/3' out, because
                  ;; `httpd_serve/3' reads its own options before it starts
                  ;; the pool -- one fetch a request, for a predicate the
                  ;; pass was written to cover.
                  (if (not ($ (nth i (-> st preds)) loaded)) (coco_pred_ensure st i))
                  (if ($ (nth i (-> st preds)) empty_fetch)
                      (if (coco_prewarm_add (coco_atom_name m ($ (nth i (-> st preds)) name))
                                            ($ (nth i (-> st preds)) arity))
                          (set added (+ added 1)))))))
          (return added)))

  (func coco_store_warm ((coco_store * st)) (out int)
        (if (== (-> st warm) nil) (return 1))
        (let ((int ok . #'((-> st warm) st (-> st ctx))))
          ;; KEEP WHAT THE WARM TAUGHT THE NEXT STORE: the declarations it
          ;; loaded, name by name. `run_isolated' dies; this table does not.
          (if (and (!= ok 0) (!= (-> st name_m) nil))
              (let ((coco_machine * nm . #'(cast (coco_machine *) (-> st name_m))))
                (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
                  (if ($ (nth i (-> st preds)) dynamic)
                      (coco_dynamic_remember
                       (coco_atom_name nm ($ (nth i (-> st preds)) name))
                       ($ (nth i (-> st preds)) arity))))))
          (return ok)))

  ;;; `:- dynamic name/arity'. The predicate is INTERNED and not merely looked
  ;;; up: declaring one is how a program says it exists, and a dynamic
  ;;; predicate with no clauses yet is a predicate, not a typo.
  (func coco_pred_dynamic ((coco_store * st) (u64 name) (u32 arity)) (out int)
        (let ((size_t pi . #'(coco_pred_intern st name arity)))
          (if (>= pi (-> st npreds)) (return 0))
          ;; already declared: say so and do not tell the backend twice
          (if ($ (nth pi (-> st preds)) dynamic) (return 1))
          (set ($ (nth pi (-> st preds)) dynamic) 1)
          (if (coco_store_is_muted st) (return 1))
          (if (== (-> st on_dynamic) nil) (return 1))
          (return ((-> st on_dynamic) st (-> st ctx) pi))))

  ;;; True when T is the compound NAME of arity one -- `:- G' and nothing else,
  ;;; so far, but it reads better than the test written out.
  (static)
  (func coco_is_compound1 ((coco_machine * m) (size_t t) (const char * name)) (out int)
        (set t (coco_deref m t))
        (if (not (coco_is_callable m t)) (return 0))
        (if (!= (coco_arity m t) 1) (return 0))
        (return (? (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) name)) 1 0)))

  ;;; True when T is the compound NAME/2 -- the shape every spec is built from.
  (func coco_is_compound2 ((coco_machine * m) (size_t t) (const char * name)) (out int)
        (if (not (coco_is_callable m t)) (return 0))
        (if (!= (coco_arity m t) 2) (return 0))
        (return (? (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) name)) 1 0)))

  (func coco_dynamic_spec ((coco_store * st) (coco_machine * m) (size_t spec)
                         (char * err) (size_t errlen)) (out int)
        (set spec (coco_deref m spec))

        ;; `a/1, b/2' -- what the reader makes of a comma separated list of
        ;; them, and the form nearly every Prolog file uses.
        (if (coco_is_compound2 m spec ",")
            (block
             (if (not (coco_dynamic_spec st m (coco_arg m spec 0) err errlen)) (return 0))
             (return (coco_dynamic_spec st m (coco_arg m spec 1) err errlen))))

        ;; `[a/1, b/2]' -- a list of them, which some do.
        (if (coco_is_compound2 m spec ".")
            (block
             (if (not (coco_dynamic_spec st m (coco_arg m spec 0) err errlen)) (return 0))
             (return (coco_dynamic_spec st m (coco_arg m spec 1) err errlen))))

        ;; `system:goal_expansion/2' -- a module-qualified spec, from a file
        ;; written for a Prolog with modules. One namespace: the qualifier
        ;; peels off, the same rule a qualified clause head follows.
        (if (coco_is_compound2 m spec ":")
            (return (coco_dynamic_spec st m (coco_arg m spec 1) err errlen)))

        ;; the end of a list is not a spec and not an error either
        (if (coco-tag-is ATOM (nth spec (-> m heap)))
            (if (== 0 (strcmp (coco_atom_name m (coco_name_of m spec)) "[]")) (return 1)))

        (if (not (coco_is_compound2 m spec "/"))
            (block (snprintf err errlen "dynamic: expected Name/Arity") (return 0)))

        (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
              (size_t ar . #'(coco_deref m (coco_arg m spec 1))))
          (if (not (coco-tag-is ATOM (nth nm (-> m heap))))
              (block (snprintf err errlen "dynamic: the name must be an atom") (return 0)))
          (if (not (coco-is-int (nth ar (-> m heap))))
              (block (snprintf err errlen "dynamic: the arity must be an integer") (return 0)))
          (let ((i64 n . #'(coco_int_val m (nth ar (-> m heap)))))
            (if (or (< n 0) (> n 255))
                (block (snprintf err errlen "dynamic: arity out of range") (return 0)))
            (if (not (coco_pred_dynamic st (coco_name_of m nm) (cast u32 n)))
                (block (snprintf err errlen "dynamic: out of memory") (return 0)))
            ;; the declaration is program text, not a row: keep it for the
            ;; fresh stores `run_isolated/2' will make
            (coco_dynamic_remember (coco_atom_name m (coco_name_of m nm)) (cast u32 n))
            (return 1))))

  ;;; Is F one of the three flags a directive answers itself, the ones that
  ;;; act on what the rest of the file reads (2.2.2)? Every other
  ;;; `:- set_prolog_flag(F, V)' is a goal.
  (static)
  (func coco_reader_flag ((coco_machine * m) (size_t f)) (out int)
        (set f (coco_deref m f))
        (if (or (not (coco_is_callable m f)) (!= (coco_arity m f) 0)) (return 0))
        (let ((const char * fn . #'(coco_atom_name m (coco_name_of m f))))
          (return (? (or (== 0 (strcmp fn "generate_debug_info")) (== 0 (strcmp fn "text_units"))
                         (== 0 (strcmp fn "double_quotes")))
                     1 0))))

  (func coco_directive ((coco_store * st) (coco_machine * m) (size_t g)
                      (coco_initgoals * inits) (int line)
                      (char * err) (size_t errlen)) (out int)
        (set g (coco_deref m g))
        (if (not (coco_is_callable m g))
            (block (snprintf err errlen "a directive must be a callable term") (return 0)))

        (let ((const char * name . #'(coco_atom_name m (coco_name_of m g)))
              (u32 n . #'(coco_arity m g))
              ;; MAY THE GOAL COLLECT THE HEAP (1.9.6)? Only if the consult
              ;; said so (`dgc', lib/term.cicili), and only around a call of
              ;; the goal hook below that this frame has made safe: what it
              ;; reads of the term afterwards registered first.
              (int vouch . #'(-> m dgc)))
          (set (-> m dgc) 0)

          (if (and (== n 1) (== 0 (strcmp name "dynamic")))
              (return (coco_dynamic_spec st m (coco_arg m g 0) err errlen)))

          ;; Accepted and ignored on purpose. cocolog keeps a predicate's
          ;; clauses in one list however scattered they were in the file, so
          ;; there is nothing for it to do -- but a file that says it is
          ;; deliberate should not be refused for saying so.
          (if (and (== n 1) (== 0 (strcmp name "discontiguous"))) (return 1))
          (if (and (== n 1) (== 0 (strcmp name "multifile"))) (return 1))

          ;; `:- op(P, T, N)'. THIS ONE HAS TO BE HERE and not left to the
          ;; engine, because a declaration has to take effect for the REST OF
          ;; THE FILE being read -- the clauses after it are parsed with it in
          ;; force, and a directive handled after the whole file was read would
          ;; be too late to matter. It is also why this file, which is compiled
          ;; below the engine and cannot run a goal, reaches into syntax.cicili
          ;; instead: the operator table is the reader's, and the reader is
          ;; what a directive like this is about.
          (if (and (== n 3) (== 0 (strcmp name "op")))
              (return (coco_op_apply m g err errlen)))

          ;; ---- what the head of a library file says --------------------
          ;;
          ;; ACCEPTED AND IGNORED, so that a file written for a Prolog with
          ;; modules can be read here unedited. cocolog has ONE namespace: a
          ;; `:- module(m, [a/1])' does not hide anything, so every predicate
          ;; in such a file is callable whether the file exported it or not.
          ;; That is a real difference and not a shim -- it is recorded in
          ;; MODULES.md rather than pretended away. Refusing the directive
          ;; would only mean editing every borrowed file, which buys nothing
          ;; and loses the ability to diff a copy against its upstream.
          ;;
          ;; `use_module' and `ensure_loaded' name a library to load, and
          ;; since the loader grew a run-time seam they TRY: the hook below
          ;; resolves against the registered modules and the library path.
          ;; ONE THAT LOADS NOTHING SAYS SO, in SWI's words and with both of
          ;; SWI's lines -- the ERROR saying why (`source_sink ... does not
          ;; exist' for a library that is not there), then the Warning that
          ;; the directive failed -- and the load goes on. It used to stay
          ;; quiet about a library it could not find, so that a file borrowed
          ;; from SWI read unedited; then a program on a machine without
          ;; raylib loaded cleanly and failed at its first drawing call,
          ;; `Unknown procedure: ray_log_level/1', with nothing to say the
          ;; load had gone wrong first. The borrowed file is still quiet where
          ;; that is the truth: SWI's names for what this build carries under
          ;; another arrangement are answered as loaded (library.cicili's
          ;; `lb_carried').
          ;; `meta_predicate' exists to tell a module system which
          ;; arguments to qualify, and with no modules there is nothing to say.
          (if (and (== n 2) (== 0 (strcmp name "module"))) (return 1))
          (if (or (and (<= n 2) (>= n 1) (== 0 (strcmp name "use_module")))
                  (and (== n 1) (== 0 (strcmp name "ensure_loaded"))))
              (block
               (if (== coco_use_module_hook nil) (return 1))
               (set (nth 0 err) (cast char 0))
               (let ((int r . #'(coco_use_module_hook st m (coco_arg m g 0) err errlen)))
                 (if (== r 1) (return 1))
                 (let ((coco_strbuf b))
                   (coco_sb_init (aof b))
                   (coco_write_term m (aof b) (coco_deref m (coco_arg m g 0)) 1 0)
                   (if (== r -1)
                       (snprintf err errlen "source_sink `%s' does not exist"
                                 (? (== ($ b s) nil) "?" ($ b s)))
                     (if (== (nth 0 err) (cast char 0))
                         (snprintf err errlen "%s: could not be loaded"
                                   (? (== ($ b s) nil) "?" ($ b s)))))
                   (coco_sb_free (aof b))
                   (return 3)))))
          ;; `autoload/1,2' is use_module that loads lazily; same answer here
          (if (and (<= n 2) (== 0 (strcmp name "autoload"))) (return 1))
          (if (and (== n 1) (== 0 (strcmp name "meta_predicate"))) (return 1))

          ;; `:- set_prolog_flag(double_quotes, V)'. ACCEPTED, for all four of
          ;; SWI's values -- codes, chars, atom, string -- and it really
          ;; changes what the reader builds for the rest of the file. It used
          ;; to accept `codes' and refuse the rest BY NAME, on the argument
          ;; that nodding at a flag cocolog would not honour makes every
          ;; `"..."' in the file mean something other than it says. That
          ;; argument was right, and the answer to it was to honour the flag
          ;; rather than to keep refusing: there is a string type now, and an
          ;; atom was always makeable.
          ;;
          ;; THESE THREE ARE ANSWERED HERE, the flags that act on what the
          ;; rest of the file reads; every other flag, and a flag that is no
          ;; atom, is a GOAL (2.2.2), run below as any directive's goal is:
          ;; set_prolog_flag/2 (lib/library.cicili) sets the float flags and
          ;; refuses the rest in swipl's words -- an ERROR naming the ball,
          ;; where through 2.2.1 this said `cocolog has no flag'.
          (if (and (== n 2) (== 0 (strcmp name "set_prolog_flag"))
                   (coco_reader_flag m (coco_arg m g 0)))
              (let ((size_t f . #'(coco_deref m (coco_arg m g 0)))
                    (size_t v . #'(coco_deref m (coco_arg m g 1))))
                ;; `generate_debug_info' asks for debugging metadata cocolog
                ;; never generates, so any value is already honoured
                (if (== 0 (strcmp (coco_atom_name m (coco_name_of m f)) "generate_debug_info"))
                    (return 1))
                ;; `text_units' (1.13.0): what the text builtins count in,
                ;; bytes or characters, for this machine and every machine
                ;; made after it (lib/term.cicili, `coco_text_default')
                (if (== 0 (strcmp (coco_atom_name m (coco_name_of m f)) "text_units"))
                    (block
                     (if (and (coco_is_callable m v) (== (coco_arity m v) 0))
                         (let ((const char * val . #'(coco_atom_name m (coco_name_of m v))))
                           (if (== 0 (strcmp val "bytes"))
                               (block (set (-> m text_chars) 0) (coco_text_default_set 0) (return 1)))
                           (if (== 0 (strcmp val "characters"))
                               (block (set (-> m text_chars) 1) (coco_text_default_set 1) (return 1)))))
                     (snprintf err errlen "set_prolog_flag: text_units takes bytes or characters")
                     (return 0)))
                ;; `double_quotes', the one left. IT TAKES EFFECT FOR THE
                ;; REST OF THE CONSULT, not for the directive's own term --
                ;; the term is already read by the time this runs, which is
                ;; the same order SWI reads in.
                (if (and (coco_is_callable m v) (== (coco_arity m v) 0))
                    (let ((const char * val . #'(coco_atom_name m (coco_name_of m v))))
                      (if (== 0 (strcmp val "codes"))  (block (set (-> m double_quotes) 0) (return 1)))
                      (if (== 0 (strcmp val "chars"))  (block (set (-> m double_quotes) 1) (return 1)))
                      (if (== 0 (strcmp val "atom"))   (block (set (-> m double_quotes) 2) (return 1)))
                      (if (== 0 (strcmp val "string")) (block (set (-> m double_quotes) 3) (return 1)))))
                (snprintf err errlen
                          "set_prolog_flag: double_quotes takes codes, chars, atom or string")
                (return 0)))

          ;; ---- `:- initialization(G)', and `initialization(G, When)' ----
          ;;
          ;; PUT OFF UNTIL THE FILE IS READ, which is the whole point of the
          ;; directive: a goal written at the top of a file may call
          ;; predicates written at the bottom of it, and a directive that ran
          ;; where it stands could not. The goal goes into the STORE and its
          ;; cell into INITS, because the heap this term is on is wound back
          ;; as soon as the clause is done with.
          ;;
          ;; SWI'S FOUR WHENS, three of which mean something here. `now' runs
          ;; it where it stands -- the one case that is just a goal with a
          ;; longer name. `after_load' is the default and what `/1' means.
          ;; `main' is after_load and then HALT: SWI makes the goal the
          ;; program, and a program that has finished is a process that has
          ;; finished. `restore_state' and the rest belong to saved states,
          ;; which cocolog does not have, and are refused by name rather than
          ;; nodded at -- the same rule `set_prolog_flag' follows above.
          (if (and (>= n 1) (<= n 2) (== 0 (strcmp name "initialization")))
              (let ((int mode . 0))
                (if (== n 2)
                    (let ((size_t w . #'(coco_deref m (coco_arg m g 1))))
                      (if (or (not (coco_is_callable m w)) (!= (coco_arity m w) 0))
                          (block (snprintf err errlen
                                           "initialization: the second argument names when")
                                 (return 0)))
                      (let ((const char * wn . #'(coco_atom_name m (coco_name_of m w))))
                        (cond
                          ((== 0 (strcmp wn "after_load")) (set mode 0))
                          ((== 0 (strcmp wn "main"))       (set mode 1))
                          ((== 0 (strcmp wn "now"))        (set mode 2))
                          (#t (block (snprintf err errlen
                                        "initialization: `%s' is not a when cocolog has -- after_load, main or now"
                                        wn)
                                     (return 0)))))))
                (if (== mode 2)
                    (block
                     (if (== coco_goal_hook nil)
                         (block (snprintf err errlen
                                          "initialization(G, now): there is no engine over this store")
                                (return 0)))
                     ;; nothing of the term is read after it -- the message
                     ;; for a failure is fixed text -- so it may collect as
                     ;; it stands
                     (let ((int r . 0))
                       (set (-> m dgc) vouch)
                       (set r (coco_goal_hook st m (coco_arg m g 0) err errlen))
                       (set (-> m dgc) 0)
                       (if (== r 1) (return 1))
                       (if (== r 0)
                           (block (snprintf err errlen "Goal (initialization) failed")
                                  (return 2)))
                       (return 0))))
                (if (== inits nil)
                    (block (snprintf err errlen
                                     "initialization: nothing here can put a goal off")
                           (return 0)))
                ;; NO ZERO CHECK ON THE CELL: zero is the first cell of an
                ;; empty store and a perfectly good answer -- reading it as
                ;; failure reported an out of memory that had not happened for
                ;; every `initialization' in the first file of a session.
                (let ((size_t cell . #'(coco_store_put st m (coco_arg m g 0))))
                  (if (not (coco_inits_add inits cell mode line))
                      (block (snprintf err errlen "initialization: out of memory") (return 0)))
                  (return 1))))

          ;; ---- AND EVERYTHING ELSE IS A GOAL ----------------------------
          ;;
          ;; Which is what a directive IS in every other Prolog, and what
          ;; this file could not do for as long as it had no way to reach an
          ;; engine. `:- assert(seen(0)).', `:- ( ok -> true ; report ).',
          ;; `:- main.' all run, here, in the order the file writes them.
          ;;
          ;; A GOAL THAT FAILS IS NOT AN ERROR IN THE FILE, and the message
          ;; says so in SWI's words: a failure is a Warning naming the
          ;; directive, an exception is an ERROR naming the ball. Both leave
          ;; the load running.
          (if (== coco_goal_hook nil)
              (block (snprintf err errlen "unsupported directive: %s/%u" name (cast unsigned n))
                     (return 0)))
          ;;
          ;; THE GOAL IS REGISTERED AROUND IT (1.9.6), because a goal that
          ;; collects moves the cells under it and the message for a failure
          ;; writes it afterwards. Unregistered, it runs collecting nothing.
          (let ((int r . 0) (size_t * gp . nil) (size_t gl . 1) (int held . 0))
            (set gp (aof g))
            (set held (coco_heap_root_push m (aof gp) (aof gl)))
            (set (-> m dgc) (? held vouch 0))
            (set r (coco_goal_hook st m g err errlen))
            (set (-> m dgc) 0)
            (if held (coco_heap_root_pop m))
            (if (== r 1) (return 1))
            (if (== r 0)
                (let ((coco_strbuf b))
                  ;; NAMING THE GOAL, as SWI does -- `Goal (directive)
                  ;; failed: seen(0)'. A file with three directives in it and
                  ;; a message that named none of them would send the reader
                  ;; to count lines.
                  (coco_sb_init (aof b))
                  (coco_write_term m (aof b) g 1 0)
                  (snprintf err errlen "Goal (directive) failed: %s"
                            (? (== ($ b s) nil) "?" ($ b s)))
                  (coco_sb_free (aof b))
                  (return 2)))
            (return 0))))

  ;;; ---- asserting --------------------------------------------------------

  (func coco_clause_parts ((coco_machine * m) (size_t clause) (size_t * head) (size_t * body))
        (set clause (coco_deref m clause))
        (set (cof head) clause)
        (set (cof body) 0)
        (if (not (coco_is_callable m clause)) (return))
        (if (!= (coco_arity m clause) 2) (return))
        (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m clause)) ":-")) (return))
        (set (cof head) (coco_arg m clause 0))
        (set (cof body) (coco_arg m clause 1)))

  ;;; ---- first-argument indexing ------------------------------------------

  (func coco_no_clause () (out size_t) (return (cast size_t -1)))

  (func coco_arg_key ((coco_machine * m) (size_t t)) (out u64)
        (set t (coco_deref m t))
        (if (not (coco_is_callable m t)) (return 0))
        (if (== (coco_arity m t) 0) (return 0))
        (let ((u64 c . #'(nth (coco_deref m (coco_arg m t 0)) (-> m heap))))
          ;; an unbound argument constrains nothing, and a float, a string,
          ;; a boxed integer or a rational cannot be compared as a cell --
          ;; see the struct
          (if (coco-tag-is REF c) (return 0))
          (if (coco-tag-is FLT c) (return 0))
          (if (coco-tag-is STR c) (return 0))
          (if (coco-tag-is BIG c) (return 0))
          (if (coco-tag-is RAT c) (return 0))
          (return c)))

  ;;; A PREDICATE SMALLER THAN THIS IS NOT WORTH A TABLE. Below it the scan
  ;;; over `keys' is a handful of contiguous machine words and beats a hash
  ;;; lookup outright; above it the table is what stops the walk growing with
  ;;; the predicate. Almost every rule ever written is under it and pays
  ;;; nothing at all.
  (static) (func coco_index_floor () (out size_t) (return 8))

  ;;; The slot KEY lives in, probing linearly from its hash. Answers the slot
  ;;; whether or not it is occupied, so a caller that means to insert may
  ;;; write it -- and never fails, because the table is kept below half full.
  (static)
  (func coco_kslot_of ((coco_pred * p) (u64 key)) (out coco_kslot *)
        ;; the cell's low four bits are a tag and its payload is an index, so
        ;; the interesting bits are the high ones: a multiply spreads them
        ;; down before the mask takes the bottom of the word. The table is
        ;; kept below half full, so the probe always finds a slot.
        (let ((u64 h . #'(* key 1099511628211))
              (size_t i . 0) (size_t mask . #'(- (-> p nslots) 1)))
          (set i (cast size_t (bitand (>> h 7) (cast u64 mask))))
          (while 1
            (let ((coco_kslot * sl . #'(aof (nth i (-> p slots)))))
              (if (== (-> sl key) 0) (return sl))
              (if (== (-> sl key) key) (return sl)))
            (set i (bitand (+ i 1) mask)))
          (return nil)))

  (static)
  (func coco_chain_add ((coco_pred * p) (u64 key) (size_t at))
        (set (nth at (-> p chain)) (coco_no_clause))
        (if (== key 0)
            (block
             (if (== (-> p varhead) (coco_no_clause))
                 (set (-> p varhead) at)
               (set (nth (-> p vartail) (-> p chain)) at))
             (set (-> p vartail) at)
             (set (-> p nvar) (+ (-> p nvar) 1))
             (return)))
        (let ((coco_kslot * sl . #'(coco_kslot_of p key)))
          (if (== (-> sl key) 0)
              (block (set (-> sl key) key)
                     (set (-> sl head) at)
                     (set (-> sl tail) at)
                     (set (-> sl count) 1)
                     (if (== (-> p kmax) 0) (set (-> p kmax) 1))
                     (return)))
          (set (nth (-> sl tail) (-> p chain)) at)
          (set (-> sl tail) at)
          (set (-> sl count) (+ (-> sl count) 1))
          (if (> (-> sl count) (-> p kmax)) (set (-> p kmax) (-> sl count)))))

  ;;; Builds the table from the keys, in clause order, so every chain comes
  ;;; out ascending. O(n) and paid once per invalidation.
  (static)
  (func coco_pred_reindex ((coco_store * st) (coco_pred * p)) (out int)
        (let ((size_t want . 16))
          (while (< want (* (-> p nclauses) 2)) (set want (* want 2)))
          (if (!= (-> p nslots) want)
              (let ((void * ns . #'(realloc (cast (void *) (-> p slots))
                                            (* want (sizeof coco_kslot)))))
                (if (== ns nil) (block (set (-> st oom) 1) (return 0)))
                (set (-> p slots) (cast (coco_kslot *) ns))
                (set (-> p nslots) want)))
          (memset (cast (void *) (-> p slots)) 0 (* (-> p nslots) (sizeof coco_kslot))))
        (set (-> p varhead) (coco_no_clause))
        (set (-> p vartail) (coco_no_clause))
        (set (-> p nvar) 0)
        (set (-> p kmax) 0)
        (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
          (coco_chain_add p (nth i (-> p keys)) i))
        (set (-> p indexed) 1)
        (return 1))

  ;;; Walks one chain to its first entry at or after FROM. The chains are in
  ;;; ascending order, so this stops at the first candidate rather than
  ;;; scanning the whole of one.
  (static)
  (func coco_chain_from ((coco_pred * p) (size_t h) (size_t from)) (out size_t)
        (while (and (!= h (coco_no_clause)) (< h from))
          (set h (nth h (-> p chain))))
        (return h))

  (func coco_pred_next_clause ((coco_store * st) (coco_pred * p)
                             (u64 key) (size_t from)) (out size_t)
        (if (>= from (-> p nclauses)) (return (coco_no_clause)))
        ;; a call whose first argument is unbound (or a float, or absent) has
        ;; nothing to discriminate on, and every clause is a candidate
        (if (== key 0) (return from))

        ;; small, or waiting to be rebuilt and not worth rebuilding: the scan
        ;; over `keys' still skips the copy and the unification, which is the
        ;; part that costs
        (if (or (< (-> p nclauses) (coco_index_floor))
                (and (== (-> p indexed) 0) (not (coco_pred_reindex st p))))
            (block
             (for ((size_t i . from)) (< i (-> p nclauses)) ((++ i))
               (let ((u64 k . #'(nth i (-> p keys))))
                 (if (or (== k 0) (== k key)) (return i))))
             (return (coco_no_clause))))

        ;; two candidates: the first clause of this key at or after FROM, and
        ;; the first key-0 clause there -- whichever comes first is the one
        ;; the program would have reached by walking
        ;; A RETRY STARTS FROM THE CLAUSE JUST TRIED. FROM is one past it,
        ;; and that clause sits in the chain of its key -- this key's or
        ;; the key-0 chain -- so its link IS that chain's first entry at or
        ;; after FROM, and only the other chain is walked from its head.
        ;; Walking both from their heads made a retry through a chain of N
        ;; clauses cost N, and backtracking through one key's clauses N
        ;; squared: 2000 lookups in a table of one language took 4.3 s.
        (let ((coco_kslot * sl . #'(coco_kslot_of p key))
              (int back . #'(> from 0))
              (u64 kprev . 0)
              (size_t a . #'(coco_no_clause))
              (size_t b . #'(coco_no_clause)))
          (if back (set kprev (nth (- from 1) (-> p keys))))
          (set b (? (and back (== kprev 0)) (nth (- from 1) (-> p chain))
                    (coco_chain_from p (-> p varhead) from)))
          ;; an UNOCCUPIED slot is where this key WOULD go, and its zeroed
          ;; head is a real position -- so nothing of this key exists
          (if (!= (-> sl key) 0)
              (set a (? (and back (== kprev key)) (nth (- from 1) (-> p chain))
                        (coco_chain_from p (-> sl head) from))))
          (if (== a (coco_no_clause)) (return b))
          (if (== b (coco_no_clause)) (return a))
          (return (? (< a b) a b))))

  ;;; EVERY INDEX OF A PREDICATE, dropped: what renumbers the clauses --
  ;;; asserta, retract, a reconsult, a sweep of the dead -- leaves the chains
  ;;; naming the wrong positions, and the next call that wants a table
  ;;; rebuilds it.
  (static)
  (func coco_pred_unindex ((coco_pred * p))
        (set (-> p indexed) 0)
        (if (!= (-> p aix) nil)
            (for ((u32 j . 0)) (< j (coco_aix_count)) ((++ j))
              (set ($ (nth j (-> p aix)) indexed) 0))))

  ;;; ---- the logical update view ------------------------------------------

  ;;; P's `nprobe' from its counts, after every write of either.
  (static) (inline)
  (func coco_pred_nprobe ((coco_pred * p))
        (set (-> p nprobe) (? (and (== (-> p ntomb) 0) (<= (-> p nclauses) 4294967295))
                              (cast u32 (-> p nclauses)) 0)))

  ;;; THE CLAUSES OF PI PAST THE FIRST KEEP, TAKEN BACK (2.11.1): what a
  ;;; fetch had added when it failed (`coco_pred_ensure'). They are the last
  ;;; ones -- a fetch appends, and nothing else touches the predicate while
  ;;; it runs -- and no call has seen them, so they are simply dropped: their
  ;;; programs, if any were made, the count, and every index, which named
  ;;; their positions. Their cells the caller counts dead.
  (static)
  (func coco_pred_cut_back ((coco_store * st) (size_t pi) (size_t keep))
        (if (>= pi (-> st npreds)) (return))
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
          (if (<= (-> p nclauses) keep) (return))
          (for ((size_t i . keep)) (< i (-> p nclauses)) ((++ i))
            (coco_code_drop st (nth i (-> p clauses))))
          (set (-> p nclauses) keep)
          (set (-> p tver) (+ (-> p tver) 1))
          (coco_pred_nprobe p)
          (coco_pred_unindex p)))

  (func coco_pred_dead ((coco_pred * p) (size_t i)) (out int)
        (return (and (!= (-> p ntomb) 0) (!= (nth i (-> p tomb)) 0))))

  (func coco_pred_live ((coco_pred * p)) (out size_t)
        (return (- (-> p nclauses) (-> p ntomb))))

  (func coco_pred_live_before ((coco_pred * p) (size_t ix)) (out size_t)
        (if (== (-> p ntomb) 0) (return ix))
        (let ((size_t n . 0))
          (for ((size_t i . 0)) (and (< i ix) (< i (-> p nclauses))) ((++ i))
            (if (== (nth i (-> p tomb)) 0) (set n (+ n 1))))
          (return n)))

  (func coco_pred_live_at ((coco_pred * p) (size_t n)) (out size_t)
        (if (== (-> p ntomb) 0) (return (? (< n (-> p nclauses)) n (coco_no_clause))))
        (let ((size_t i . 0) (size_t k . 0))
          ;; on from the last answer, when nothing changed since and N is
          ;; not before it
          (if (and (== (-> p lver) (-> p tver)) (<= (-> p lord) n) (< (-> p lpos) (-> p nclauses)))
              (block (set i (-> p lpos)) (set k (-> p lord))))
          (while (< i (-> p nclauses))
            (if (== (nth i (-> p tomb)) 0)
                (block
                 (if (== k n)
                     (block (set (-> p lord) n) (set (-> p lpos) i)
                            (set (-> p lver) (-> p tver))
                            (return i)))
                 (set k (+ k 1))))
            (set i (+ i 1)))
          (return (coco_no_clause))))

  ;;; PI READY TO KEEP DEAD CLAUSES: its TOMB made the first time, as long
  ;;; as the clause list's capacity, and the predicate put on the store's
  ;;; list. Answers 0 with no memory for either, and the caller takes the
  ;;; clause out as a retract always did.
  (static)
  (func coco_tomb_ready ((coco_store * st) (size_t pi)) (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
          (if (== (-> p tomb) nil)
              (let ((size_t cap . #'(? (> (-> p clause_cap) 0) (-> p clause_cap) 1)))
                (set (-> p tomb) (cast (u32 *) (calloc cap (sizeof u32))))
                (if (== (-> p tomb) nil) (return 0))
                (set (-> p tomb_cap) cap)))
          (if (not (-> p tlisted))
              (block
               (if (not (coco_store_grow st (cast (void **) (aof (-> st tpreds)))
                                       (aof (-> st tpred_cap)) (+ (-> st ntpreds) 1)
                                       (sizeof size_t)))
                   (return 0))
               (set (nth (-> st ntpreds) (-> st tpreds)) pi)
               (set (-> st ntpreds) (+ (-> st ntpreds) 1))
               (set (-> p tlisted) 1)))
          (return 1)))

  ;;; Clause I of P dies as death ERA, P ready (`coco_tomb_ready').
  (static)
  (func coco_tomb_set ((coco_pred * p) (size_t i) (u32 era))
        (set (nth i (-> p tomb)) era)
        (set (-> p ntomb) (+ (-> p ntomb) 1))
        (coco_pred_nprobe p)
        (set (-> p tver) (+ (-> p tver) 1)))

  ;;; A DEATH ON PI UNDER AN OPEN CALL: the count it is given, one past the
  ;;; last, when a frame is open on PI -- each open one that has lived
  ;;; through no death given it as its first (`fera', `coco_frames_on') --
  ;;; and PI is ready to keep its dead (`coco_tomb_ready'); 0 when no frame
  ;;; is open, or there is no memory for the dead, and the caller takes the
  ;;; clause out as a retract always did. (A frame given a count no death
  ;;; then took sees the next death as its first, which it lives through.)
  (static)
  (func coco_tomb_open ((coco_store * st) (coco_machine * m) (size_t pi)) (out u32)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (u32 era . #'(+ (-> p tera) 1)))
          (if (== (coco_frames_on m st pi 1 era 0) 0) (return 0))
          (if (not (coco_tomb_ready st pi)) (return 0))
          (set (-> p tera) era)
          (return era)))

  (func coco_pred_sweep ((coco_store * st) (coco_machine * m) (size_t pi))
        (if (>= pi (-> st npreds)) (return))
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (size_t kept . 0))
          (if (== (-> p ntomb) 0) (return))
          (with-green-write nil
          (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
            (if (!= (nth i (-> p tomb)) 0)
                ;; the cells to the next compaction and the program now
                ;; (`coco_store_orphan'), as a retract would have done when
                ;; the clause died
                (coco_store_orphan st m (nth i (-> p clauses)))
              (block
                (if (!= kept i)
                    (block (set (nth kept (-> p clauses)) (nth i (-> p clauses)))
                           (set (nth kept (-> p keys)) (nth i (-> p keys)))
                           (set (nth kept (-> p origins)) (nth i (-> p origins)))
                           (set (nth kept (-> p muted)) (nth i (-> p muted)))
                           (set (nth kept (-> p codes)) (nth i (-> p codes)))))
                (set kept (+ kept 1)))))
          (set (-> p nclauses) kept)
          (set (-> p ntomb) 0)
          (coco_pred_nprobe p)
          (free (cast (void *) (-> p tomb)))
          (set (-> p tomb) nil)
          (set (-> p tomb_cap) 0)
          (set (-> p tprobe) 0)
          ;; no frame is open on it, so the count of deaths starts again
          (set (-> p tera) 0)
          ;; the positions after each dead one have moved
          (set (-> p tver) (+ (-> p tver) 1))
          (coco_pred_unindex p))))

  (func coco_tomb_sweep_all ((coco_store * st) (coco_machine * m))
        (with-green-write nil
          (for ((size_t i . 0)) (< i (-> st ntpreds)) ((++ i))
            (let ((size_t pi . #'(nth i (-> st tpreds))))
              (coco_pred_sweep st m pi)
              (if (< pi (-> st npreds)) (set ($ (nth pi (-> st preds)) tlisted) 0))))
          (set (-> st ntpreds) 0)))

  (func coco_tomb_try_sweep ((coco_store * st) (coco_machine * m) (size_t pi)) (out int)
        (if (== ($ (nth pi (-> st preds)) ntomb) 0) (return 1))
        ;; a sweep measures what it orphans on a machine's heap
        (if (== m nil) (return 0))
        (with-green-write nil
          (if (!= (coco_frames_on m st pi 0 0 0) 0) (return 0))
          (coco_pred_sweep st m pi)
          (return 1)))

  ;;; THE PROBE OF A PREDICATE WITH DEAD CLAUSES, out of line: the first
  ;;; LIVE candidate and whether there is a second, a new call seeing none
  ;;; of the dead. And now and then -- every 256th such call -- the dead
  ;;; are taken out first if no frame is open on the predicate any more,
  ;;; so that a predicate read and no longer changed after a death does
  ;;; not pay for its dead for ever. Weak, so never inlined into the probe
  ;;; every call makes.
  (weak)
  (func coco_pred_probe_dead ((coco_store * st) (coco_pred * p) (u64 key) (size_t * ix)
                              (coco_machine * m) (u32 pos)) (out int)
        (set (-> p tprobe) (+ (-> p tprobe) 1))
        (if (and (!= (-> p ntomb) 0) (== (bitand (-> p tprobe) 255) 0) (!= m nil))
            (let ((size_t pi . #'(cast size_t (- p (-> st preds)))))
              (if (coco_tomb_try_sweep st m pi)
                  (return (coco_pred_probe_at st m p pos key ix)))))
        (let ((size_t a . #'(coco_pred_next_at st m p pos key 0))
              (size_t b . 0))
          (while (and (!= a (coco_no_clause)) (coco_pred_dead p a))
            (set a (coco_pred_next_at st m p pos key (+ a 1))))
          (if (== a (coco_no_clause)) (return 0))
          (set (cof ix) a)
          (set b (coco_pred_next_at st m p pos key (+ a 1)))
          (while (and (!= b (coco_no_clause)) (coco_pred_dead p b))
            (set b (coco_pred_next_at st m p pos key (+ b 1))))
          (return (? (== b (coco_no_clause)) 1 2))))

  ;;; WHERE A PROBE GOES WHEN `nprobe' IS 0: no clause, or a dead one, or
  ;;; more clauses than 32 bits count -- each asked here, out of line, so
  ;;; the probe every call makes tests its count once.
  (weak)
  (func coco_pred_probe_cold ((coco_store * st) (coco_pred * p) (u64 key) (size_t * ix)
                              (coco_machine * m) (u32 pos)) (out int)
        (if (== (-> p nclauses) 0) (return 0))
        (return (coco_pred_probe_dead st p key ix m pos)))

  ;;; THE FIRST CANDIDATE AND WHETHER THERE IS A SECOND, in one ask: 0 for
  ;;; no clause that can match, 1 for exactly one (its position in IX), 2
  ;;; for more, with IX the first -- what a call needs to know to go
  ;;; without a choice frame (`coco_engine_run', 1.8.46). A small
  ;;; predicate's scan finds both in one pass over its keys where two asks
  ;;; of `coco_pred_next_clause' made two passes and two calls; an indexed
  ;;; one still asks twice. A predicate with dead clauses asks out of line.
  ;;;
  ;;; ITS COUNT IS `nprobe', and that one test is the dead clauses' too: a
  ;;; test of `ntomb' beside it was a load and a branch more a call, nrev
  ;;; +0.64 % of 2.2.5's work where this is +0.32 % (STATUS.md, the logical
  ;;; update view).
  (func coco_pred_probe ((coco_store * st) (coco_pred * p) (u64 key) (size_t * ix) (coco_machine * m)) (out int)
        (let ((size_t n . #'(cast size_t (-> p nprobe))))
          (if (== n 0) (return (coco_pred_probe_cold st p key ix m 0)))
          (if (== key 0)
              (block (set (cof ix) 0) (return (? (== n 1) 1 2))))
          (if (or (< n (coco_index_floor))
                  (and (== (-> p indexed) 0) (not (coco_pred_reindex st p))))
              (let ((size_t first . #'(coco_no_clause)))
                (for ((size_t i . 0)) (< i n) ((++ i))
                  (let ((u64 k . #'(nth i (-> p keys))))
                    (if (or (== k 0) (== k key))
                        (block
                         (if (!= first (coco_no_clause))
                             (block (set (cof ix) first) (return 2)))
                         (set first i)))))
                (if (== first (coco_no_clause)) (return 0))
                (set (cof ix) first)
                (return 1)))
          (let ((size_t a . #'(coco_pred_next_clause st p key 0)))
            (if (== a (coco_no_clause)) (return 0))
            (set (cof ix) a)
            (return (? (== (coco_pred_next_clause st p key (+ a 1)) (coco_no_clause)) 1 2)))))

  ;;; ---- the other arguments' indexes ---------------------------------------
  ;;;
  ;;; THE FIRST ARGUMENT IS NOT ALWAYS THE ONE THAT CHOOSES. A call whose
  ;;; first argument is unbound -- `mean(W, house)', a lookup read the
  ;;; other way -- walked the whole predicate head by head, and so did a
  ;;; call whose first argument most clauses share: a table of one language
  ;;; keyed on the language did exactly that to the translator, four
  ;;; minutes a sentence, until its facts were renamed per language
  ;;; (library/reasoning/translate.pl). The second to the eighth argument
  ;;; can each have an index of their own now, built the first time a call
  ;;; wants one and chosen by how few candidates it leaves.

  ;;; A first argument that leaves this many candidates or fewer is good
  ;;; enough, and the others are not asked.
  (static) (func coco_aix_enough () (out size_t) (return 4))

  ;;; THE FIRST ARGUMENT WILL DO, known without a look in any table: a
  ;;; predicate under the floor -- almost every rule -- or a bound key into
  ;;; a table where no key leaves more than a few candidates, a table of
  ;;; facts keyed on what they are looked up by. The engine asks this
  ;;; before `coco_pred_select_key', and a call it answers yes for is
  ;;; selected exactly as it was before the other arguments had tables.
  (static)
  (func coco_pred_first_enough ((coco_pred * p) (u64 key)) (out int)
        (return (or (< (-> p nclauses) (coco_index_floor))
                    (and (!= key 0) (-> p indexed)
                         (<= (+ (-> p kmax) (-> p nvar)) (coco_aix_enough))))))

  ;;; A heap cell's key, as `coco_arg_key' reads the first argument's.
  (static)
  (func coco_cell_key ((coco_machine * m) (size_t a)) (out u64)
        (let ((u64 c . #'(nth (coco_deref m a) (-> m heap))))
          (if (or (coco-tag-is REF c) (coco-tag-is FLT c) (coco-tag-is STR c)
                  (coco-tag-is BIG c) (coco-tag-is RAT c))
              (return 0))
          (return c)))

  ;;; Argument J's key in a clause's head, read from the store: what
  ;;; `coco_arg_key' gave the first argument of the term it came from.
  (static)
  (func coco_store_arg_key ((coco_store * st) (coco_machine * m) (size_t clause)
                            (u64 neck) (u32 j)) (out u64)
        (let ((size_t head . 0) (size_t body . 0) (u64 c . 0) (u64 a . 0))
          (coco_store_clause_parts st m clause neck (aof head) (aof body))
          (set head (coco_store_deref st head))
          (set c (nth head (-> st cells)))
          (if (not (coco-tag-is FUN c)) (return 0))
          (if (<= ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) j) (return 0))
          (set a (nth (coco_store_deref st (+ head (+ (cast size_t j) 1))) (-> st cells)))
          (if (or (coco-tag-is REF a) (coco-tag-is FLT a) (coco-tag-is STR a)
                  (coco-tag-is BIG a) (coco-tag-is RAT a))
              (return 0))
          (return a)))

  ;;; `coco_kslot_of', `coco_chain_add' and `coco_chain_from', on another
  ;;; argument's table
  (static)
  (func coco_aix_slot ((coco_argix * x) (u64 key)) (out coco_kslot *)
        (let ((u64 h . #'(* key 1099511628211))
              (size_t mask . #'(- (-> x nslots) 1))
              (size_t i . 0))
          (set i (cast size_t (bitand (>> h 7) (cast u64 mask))))
          (while 1
            (let ((coco_kslot * sl . #'(aof (nth i (-> x slots)))))
              (if (or (== (-> sl key) 0) (== (-> sl key) key)) (return sl)))
            (set i (bitand (+ i 1) mask)))
          (return nil)))

  (static)
  (func coco_aix_add ((coco_argix * x) (u64 key) (size_t at))
        (set (nth at (-> x chain)) (coco_no_clause))
        (if (== key 0)
            (block
             (if (== (-> x varhead) (coco_no_clause))
                 (set (-> x varhead) at)
               (set (nth (-> x vartail) (-> x chain)) at))
             (set (-> x vartail) at)
             (set (-> x nvar) (+ (-> x nvar) 1))
             (return)))
        (let ((coco_kslot * sl . #'(coco_aix_slot x key)))
          (if (== (-> sl key) 0)
              (block (set (-> sl key) key)
                     (set (-> sl head) at)
                     (set (-> sl tail) at)
                     (set (-> sl count) 1)
                     (return)))
          (set (nth (-> sl tail) (-> x chain)) at)
          (set (-> sl tail) at)
          (set (-> sl count) (+ (-> sl count) 1))))

  (static)
  (func coco_aix_from ((coco_argix * x) (size_t h) (size_t from)) (out size_t)
        (while (and (!= h (coco_no_clause)) (< h from))
          (set h (nth h (-> x chain))))
        (return h))

  ;;; ARGUMENT POS'S INDEX, built now if it is not: each clause's key read
  ;;; from its head, the table sized to stay under half full. nil when
  ;;; memory would not grow -- the call then stays on the first argument,
  ;;; which is slower and exactly as right.
  (static)
  (func coco_aix_get ((coco_store * st) (coco_machine * m) (coco_pred * p) (u32 pos)) (out coco_argix *)
        (let ((coco_argix * x . nil) (size_t n . #'(-> p nclauses)) (size_t want . 16)
              (u64 neck . 0))
          ;; THE FIRST CALL MAKES THE INDEX ARRAY (2.9.0); the barrier
          ;; stops the other workers while the one store changes.
          (if (== (-> p aix) nil)
              (block
               (with-green-write nil
                 (if (== (-> p aix) nil)
                     (block
                      (set (-> p aix) (cast (coco_argix *) (calloc (coco_aix_count) (sizeof coco_argix))))
                      (if (== (-> p aix) nil) (block (set (-> st oom) 1) (return nil))))))))
          (set x (aof (nth (- pos 1) (-> p aix))))
          (if (-> x indexed) (return x))
          ;; THE FIRST BUILD OF POS'S INDEX, under the barrier, with the
          ;; recheck inside: another worker's build may have finished while
          ;; this one waited.
          (with-green-write nil
            (if (-> x indexed) (return x))
            (if (not (coco_store_grow st (cast (void **) (aof (-> x keys))) (aof (-> x key_cap))
                                      (+ n 1) (sizeof u64)))
                (return nil))
            (if (not (coco_store_grow st (cast (void **) (aof (-> x chain))) (aof (-> x chain_cap))
                                      (+ n 1) (sizeof size_t)))
                (return nil))
            (while (< want (* (+ n 1) 2)) (set want (* want 2)))
            (if (!= (-> x nslots) want)
                (let ((void * ns . #'(realloc (cast (void *) (-> x slots)) (* want (sizeof coco_kslot)))))
                  (if (== ns nil) (block (set (-> st oom) 1) (return nil)))
                  (set (-> x slots) (cast (coco_kslot *) ns))
                  (set (-> x nslots) want)))
            (memset (cast (void *) (-> x slots)) 0 (* (-> x nslots) (sizeof coco_kslot)))
            (set (-> x varhead) (coco_no_clause))
            (set (-> x vartail) (coco_no_clause))
            (set (-> x nvar) 0)
            (set neck (coco_intern m ":-"))
            (for ((size_t i . 0)) (< i n) ((++ i))
              (set (nth i (-> x keys)) (coco_store_arg_key st m (nth i (-> p clauses)) neck pos))
              (coco_aix_add x (nth i (-> x keys)) i))
            (set (-> x indexed) 1)
            (return x))))

  ;;; THE ARGUMENT TO INDEX ON -- see the declaration. A predicate under the
  ;;; floor scans its first argument's keys as it always did, and pays a
  ;;; comparison for this; one whose first argument chooses well pays a
  ;;; probe of the table its next ask makes anyway.
  (func coco_pred_select ((coco_store * st) (coco_machine * m) (coco_pred * p)
                          (size_t call)) (out coco_ixsel)
        (let ((coco_ixsel r)
              (size_t best . 0) (u32 n . 0))
          (set ($ r key) (coco_arg_key m call))
          (set ($ r pos) 0)
          (if (or (< (-> p nclauses) (coco_index_floor)) (< (-> p arity) 2)) (return r))
          ;; how many candidates the first argument leaves
          (if (== ($ r key) 0)
              (set best (-> p nclauses))
              (block
               (if (and (== (-> p indexed) 0) (not (coco_pred_reindex st p))) (return r))
               (let ((coco_kslot * sl . #'(coco_kslot_of p ($ r key))))
                 (set best (+ (-> p nvar) (? (== (-> sl key) 0) 0 (-> sl count)))))
               (if (<= best (coco_aix_enough)) (return r))))
          ;; and how many each other bound one does, the fewest winning --
          ;; the earlier argument on a tie
          (set call (coco_deref m call))
          (set n (- (-> p arity) 1))
          (if (> n (coco_aix_count)) (set n (coco_aix_count)))
          (for ((u32 j . 1)) (<= j n) ((++ j))
            (let ((u64 kj . #'(coco_cell_key m (+ call (+ (cast size_t j) 1)))))
              (if (!= kj 0)
                  (let ((coco_argix * x . #'(coco_aix_get st m p j)))
                    (if (!= x nil)
                        (let ((coco_kslot * sl . #'(coco_aix_slot x kj))
                              (size_t c . 0))
                          (set c (+ (-> x nvar) (? (== (-> sl key) 0) 0 (-> sl count))))
                          (if (< c best)
                              (block (set best c) (set ($ r pos) j) (set ($ r key) kj)))))))))
          (return r)))

  (func coco_call_arg_key ((coco_machine * m) (size_t call) (u32 pos)) (out u64)
        (if (== pos 0) (return (coco_arg_key m call)))
        (return (coco_cell_key m (+ (coco_deref m call) (+ (cast size_t pos) 1)))))

  (func coco_pred_next_at ((coco_store * st) (coco_machine * m) (coco_pred * p)
                           (u32 pos) (u64 key) (size_t from)) (out size_t)
        (if (or (== pos 0) (== key 0)) (return (coco_pred_next_clause st p key from)))
        (if (>= from (-> p nclauses)) (return (coco_no_clause)))
        (let ((coco_argix * x . #'(coco_aix_get st m p pos)))
          ;; no table to be had: every clause from FROM is a candidate
          (if (== x nil) (return from))
          ;; from the clause just tried, as `coco_pred_next_clause' does
          (let ((coco_kslot * sl . #'(coco_aix_slot x key))
                (int back . #'(> from 0))
                (u64 kprev . 0)
                (size_t a . #'(coco_no_clause))
                (size_t b . #'(coco_no_clause)))
            (if back (set kprev (nth (- from 1) (-> x keys))))
            (set b (? (and back (== kprev 0)) (nth (- from 1) (-> x chain))
                      (coco_aix_from x (-> x varhead) from)))
            (if (!= (-> sl key) 0)
                (set a (? (and back (== kprev key)) (nth (- from 1) (-> x chain))
                          (coco_aix_from x (-> sl head) from))))
            (if (== a (coco_no_clause)) (return b))
            (if (== b (coco_no_clause)) (return a))
            (return (? (< a b) a b)))))

  (func coco_pred_probe_at ((coco_store * st) (coco_machine * m) (coco_pred * p)
                            (u32 pos) (u64 key) (size_t * ix)) (out int)
        (if (or (== pos 0) (== key 0)) (return (coco_pred_probe st p key ix m)))
        (if (== (-> p nprobe) 0) (return (coco_pred_probe_cold st p key ix m pos)))
        (let ((size_t a . #'(coco_pred_next_at st m p pos key 0)))
          (if (== a (coco_no_clause)) (return 0))
          (set (cof ix) a)
          (return (? (== (coco_pred_next_at st m p pos key (+ a 1)) (coco_no_clause)) 1 2))))

  ;;; ROOM FOR MORE CLAUSES in every array parallel to P's clause list: 0
  ;;; when one would not grow, and nothing is added
  (static)
  (func coco_pred_room ((coco_store * st) (coco_pred * p) (size_t more)) (out int)
        (let ((size_t need . #'(+ (-> p nclauses) more)))
          (if (not (coco_store_grow st (cast (void **) (aof (-> p origins)))
                                  (aof (-> p origin_cap)) need
                                  (sizeof u64)))
              (return 0))
          ;; and the dead's own list grows with the others while there is one
          (if (and (!= (-> p tomb) nil)
                   (not (coco_store_grow st (cast (void **) (aof (-> p tomb)))
                                         (aof (-> p tomb_cap)) need
                                         (sizeof u32))))
              (return 0))
          (if (not (coco_store_grow st (cast (void **) (aof (-> p clauses)))
                                  (aof (-> p clause_cap)) need
                                  (sizeof size_t)))
              (return 0))
          ;; the two parallel arrays grow with it, each with a cap of its own
          ;; -- three caps that always agree, rather than one the grower would
          ;; have to be taught to share
          (if (not (coco_store_grow st (cast (void **) (aof (-> p keys)))
                                  (aof (-> p key_cap)) need
                                  (sizeof u64)))
              (return 0))
          (if (not (coco_store_grow st (cast (void **) (aof (-> p chain)))
                                  (aof (-> p chain_cap)) need
                                  (sizeof size_t)))
              (return 0))
          (if (not (coco_store_grow st (cast (void **) (aof (-> p muted)))
                                  (aof (-> p muted_cap)) need
                                  (sizeof int)))
              (return 0))
          (if (not (coco_store_grow st (cast (void **) (aof (-> p codes)))
                                  (aof (-> p codes_cap)) need
                                  (sizeof size_t)))
              (return 0))
          (return 1)))

  (static)
  (func coco_pred_add_clause ((coco_store * st) (coco_machine * m) (size_t pi) (size_t clause)
                            (int at_end) (u64 key) (u64 origin) (int muted)) (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
          ;; the dead gone first if no frame is open to want them
          (if (!= (-> p ntomb) 0) (coco_tomb_try_sweep st m pi))
          (if (not (coco_pred_room st p 1)) (return 0))
          (if at_end
              (block (set (nth (-> p nclauses) (-> p clauses)) clause)
                     (set (nth (-> p nclauses) (-> p keys)) key)
                     (set (nth (-> p nclauses) (-> p origins)) origin)
                     (set (nth (-> p nclauses) (-> p muted)) muted)
                     (set (nth (-> p nclauses) (-> p codes)) nil)
                     (if (!= (-> p tomb) nil) (set (nth (-> p nclauses) (-> p tomb)) 0)))
            ;; asserta: shift the rest up by one and put this first. Every
            ;; clause after it is renumbered, and the chains hold POSITIONS,
            ;; so the index is dropped rather than patched.
            (block (let ((size_t i . #'(-> p nclauses)))
                     (while (> i 0)
                       (set (nth i (-> p clauses)) (nth (- i 1) (-> p clauses)))
                       (set (nth i (-> p keys)) (nth (- i 1) (-> p keys)))
                       (set (nth i (-> p origins)) (nth (- i 1) (-> p origins)))
                       (set (nth i (-> p muted)) (nth (- i 1) (-> p muted)))
                       (set (nth i (-> p codes)) (nth (- i 1) (-> p codes)))
                       (if (!= (-> p tomb) nil) (set (nth i (-> p tomb)) (nth (- i 1) (-> p tomb))))
                       (set i (- i 1))))
                   (set (nth 0 (-> p clauses)) clause)
                   (set (nth 0 (-> p keys)) key)
                   (set (nth 0 (-> p origins)) origin)
                   (set (nth 0 (-> p muted)) muted)
                   (set (nth 0 (-> p codes)) nil)
                   (if (!= (-> p tomb) nil) (set (nth 0 (-> p tomb)) 0))
                   (coco_pred_unindex p)))
          (set (-> p nclauses) (+ (-> p nclauses) 1))
          (coco_pred_nprobe p)
          (set (-> p tver) (+ (-> p tver) 1))
          ;; THE LOGICAL UPDATE VIEW: every frame open on the predicate is
          ;; moved on with the clauses it was going to try, and the one in
          ;; front is before where it stands -- a call open now never meets
          ;; it (`coco_frames_on')
          (if (not at_end) (coco_frames_on m st pi 2 0 0))
          ;; ASSERTZ KEEPS THE INDEX, and that is the case worth keeping: the
          ;; new clause is the highest position there is, so linking it onto
          ;; the tail of its chain leaves every chain ascending. Rebuilding
          ;; here instead would make a loop of asserts quadratic again, which
          ;; is the shape this whole change exists to remove.
          (if (and at_end (-> p indexed))
              (if (< (* (-> p nclauses) 2) (-> p nslots))
                  (coco_chain_add p key (- (-> p nclauses) 1))
                ;; the table would be over half full: let it be rebuilt, at a
                ;; bigger size, by whoever next wants it
                (set (-> p indexed) 0)))
          ;; AND EACH OTHER ARGUMENT'S TABLE THAT IS BUILT takes the clause
          ;; the same way, its key read from the head just stored -- a loop
          ;; of asserts and lookups by the second argument (a memo table)
          ;; would otherwise rebuild the table at every lookup
          (if (and at_end (!= (-> p aix) nil))
              (let ((u64 neck . #'(coco_intern m ":-"))
                    (size_t at . #'(- (-> p nclauses) 1)))
                (for ((u32 j . 0)) (< j (coco_aix_count)) ((++ j))
                  (let ((coco_argix * x . #'(aof (nth j (-> p aix)))))
                    (if (-> x indexed)
                        (if (and (< (* (-> p nclauses) 2) (-> x nslots))
                                 (coco_store_grow st (cast (void **) (aof (-> x keys))) (aof (-> x key_cap))
                                                  (-> p nclauses) (sizeof u64))
                                 (coco_store_grow st (cast (void **) (aof (-> x chain))) (aof (-> x chain_cap))
                                                  (-> p nclauses) (sizeof size_t)))
                            (block
                             (set (nth at (-> x keys)) (coco_store_arg_key st m clause neck (+ j 1)))
                             (coco_aix_add x (nth at (-> x keys)) at))
                          (set (-> x indexed) 0)))))))
          (return 1)))

  ;;; CLAUSE PUT IN AT POSITION K OF PI, the clauses from K moved up one:
  ;;; the clause list, every array beside it, and every call open at or
  ;;; past K (`coco_frames_on' act 2) -- its caller has asked that no call
  ;;; open before K would see it (act 3). The positions moved, so every
  ;;; index goes, as an asserta's does.
  (static)
  (func coco_pred_insert_at ((coco_store * st) (coco_machine * m) (size_t pi) (size_t k)
                             (size_t clause) (u64 key) (u64 origin) (int muted)) (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (size_t i . 0))
          (if (not (coco_pred_room st p 1)) (return 0))
          (set i (-> p nclauses))
          (while (> i k)
            (set (nth i (-> p clauses)) (nth (- i 1) (-> p clauses)))
            (set (nth i (-> p keys)) (nth (- i 1) (-> p keys)))
            (set (nth i (-> p origins)) (nth (- i 1) (-> p origins)))
            (set (nth i (-> p muted)) (nth (- i 1) (-> p muted)))
            (set (nth i (-> p codes)) (nth (- i 1) (-> p codes)))
            (if (!= (-> p tomb) nil) (set (nth i (-> p tomb)) (nth (- i 1) (-> p tomb))))
            (set i (- i 1)))
          (set (nth k (-> p clauses)) clause)
          (set (nth k (-> p keys)) key)
          (set (nth k (-> p origins)) origin)
          (set (nth k (-> p muted)) muted)
          (set (nth k (-> p codes)) nil)
          (if (!= (-> p tomb) nil) (set (nth k (-> p tomb)) 0))
          (set (-> p nclauses) (+ (-> p nclauses) 1))
          (coco_pred_nprobe p)
          (set (-> p tver) (+ (-> p tver) 1))
          (coco_pred_unindex p)
          (coco_frames_on m st pi 2 0 k)
          (return 1)))

  ;;; Whether PI holds a live clause ORIGIN put there, of the store's mute
  ;;; MUTE.
  (static)
  (func coco_pred_holds ((coco_store * st) (size_t pi) (u64 origin) (int mute)) (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
          (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
            (if (and (== (nth i (-> p origins)) origin) (== (nth i (-> p muted)) mute)
                     (not (coco_pred_dead p i)))
                (return 1)))
          (return 0)))

  ;;; ---- a re-read in swipl's order (2.14.1) --------------------------------
  ;;;
  ;;; SWI'S RELOAD KEEPS WHAT DID NOT CHANGE WHERE IT STOOD, and puts what
  ;;; is new beside it. Probed against swipl 9.0.4 (test/files/
  ;;; reload_order.pl): a pointer starts at the predicate's first clause,
  ;;; and each clause the file says now looks from it for one equal to it
  ;;; -- a variant, whatever its variables are called -- that the file put
  ;;; there before or that no file did (asserted). Found, that one stays
  ;;; where it stands (an asserted one becomes the file's) and the pointer
  ;;; moves past it; not found, the new clause goes in before the pointer.
  ;;; What the file put there and does not say again goes. Another file's
  ;;; clause is never a candidate, nor anything behind the pointer, and a
  ;;; file read for the first time appends. So `[asserted]' re-read with
  ;;; `[file2, file3]' is `[file2, file3, asserted]', where through 2.14.0
  ;;; the new clauses went after it.
  ;;;
  ;;; HERE THE FILE'S OLD CLAUSES STILL GO AT ITS FIRST CLAUSE, as through
  ;;; 2.14.0 (`coco_pred_forget_from', which keeps the logical update view):
  ;;; between the clauses of the read they are out of sight, as swipl's are,
  ;;; erased until a clause matches them. A match puts the new clause where
  ;;; the old one stood -- the same clause in the same place. A candidate is
  ;;; looked up by its shape (`coco_reload_hash') and told by a walk of it
  ;;; beside the new clause (`coco_reload_variant'). The pointer is
  ;;; an ordinal into the clauses the predicate held at the first clause
  ;;; (O, `coco_reload'), and "before the pointer" is before the first of
  ;;; them from it that is still there, found by its cell. A predicate that
  ;;; held nothing but the file's own clauses needs none of it: every clause
  ;;; goes after the last, which is that order, and it has no state.
  ;;;
  ;;; What differs, and is stated: a muted read (a module read again) adopts
  ;;; no asserted clause, whose rows the knowledge base keeps; a directive
  ;;; that asserts at the end of the predicate being read puts it before
  ;;; the read's next clauses where swipl puts it after them when the pointer
  ;;; still stands on a clause of the file's; and a compaction while the
  ;;; read runs (a directive's four million cells of garbage) moves every
  ;;; cell O holds, after which the read's clauses of the predicate go after
  ;;; its last clause.

  (static)
  (func coco_reload_free ((coco_reload * rl))
        (if (== rl nil) (return))
        (free (cast (void *) (-> rl cell)))
        (free (cast (void *) (-> rl kind)))
        (free (cast (void *) (-> rl hash)))
        (free (cast (void *) (-> rl bnext)))
        (free (cast (void *) (-> rl bhead)))
        (free (cast (void *) rl)))

  ;;; A TERM'S CELL, past its references, on the heap or -- IN -- in the
  ;;; store, which lays a compound out as the heap does and shares the
  ;;; machine's tables of floats, strings and numbers: T's index is
  ;;; answered and its cell put in C.
  (static) (inline)
  (func coco_reload_at ((coco_machine * m) (coco_store * st) (size_t t) (int in)
                        (u64 * c)) (out size_t)
        (if in
            (block (set t (coco_store_deref st t)) (set (cof c) (nth t (-> st cells))))
          (block (set t (coco_deref m t)) (set (cof c) (nth t (-> m heap)))))
        (return t))

  ;;; THE SHAPE A RELOAD LOOKS UP A CLAUSE BY: a hash of the term T, on the
  ;;; heap or IN the store, that two variants share -- each functor, atom
  ;;; and number, the bytes of each string, in the order a walk from the
  ;;; left meets them, and a variable as a variable, whichever it is. One
  ;;; term hashes alike in either place. Two clauses of one hash are told
  ;;; apart by `coco_reload_variant'. A walk, not the text the store
  ;;; writes, and of the clause where it lies: written out, a re-read beside
  ;;; the program's clauses cost three times the read (2.14.1's first cut).
  (static)
  (func coco_reload_hash ((coco_machine * m) (coco_store * st) (size_t t) (int in)) (out u64)
        (let ((u64 h . 1469598103934665603) (size_t * wl . nil) (size_t wlen . 0)
              (size_t wcap . 0) (int ok . 1) (int running . 1))
          (set wl (coco_wpairs_take m (aof wcap)))
          (while running
            (let ((u64 c . 0) (u64 v . 0) (size_t a . #'(coco_reload_at m st t in (aof c))))
              (set h (* (xor h (cast u64 (coco-tag c))) 1099511628211))
              (cond
                ((coco-tag-is REF c) (set v 0))
                ((coco-tag-is FLT c)
                 (let ((double x . #'(nth (cast size_t (coco-payload c)) (-> m floats))))
                   (memcpy (aof v) (aof x) (sizeof double))))
                ((coco-tag-is STR c)
                 (let ((size_t i . #'(cast size_t (coco-payload c))))
                   (set v (cast u64 ($ (nth i (-> m strings)) n)))
                   (for ((size_t j . 0)) (< j ($ (nth i (-> m strings)) n)) ((++ j))
                     (set h (* (xor h (cast u64 (bitand (cast int (nth j ($ (nth i (-> m strings)) p))) 255)))
                               1099511628211)))))
                ((coco-tag-is BIG c)
                 (set v (cast u64 (nth (cast size_t (coco-payload c)) (-> m bigs)))))
                ((coco-tag-is RAT c)
                 (let ((size_t i . #'(coco-rat-index c)))
                   (set v (xor (cast u64 ($ (nth i (-> m rats)) n))
                               (* (cast u64 ($ (nth i (-> m rats)) d)) 1099511628211)))))
                ;; an atom, an integer, a functor: the cell is the identity
                (#t (set v c)))
              (set h (* (xor h v) 1099511628211))
              ;; a compound's arguments are the cells after its header
              (if (coco-tag-is FUN c)
                  (let ((u32 n . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity)))
                    (for ((u32 i . n)) (> i 0) ((set i (- i 1)))
                      (if (and ok (not (coco_pairs_push m (aof wl) (aof wlen) (aof wcap)
                                                        (+ a (cast size_t i)) 0)))
                          (set ok 0))))))
            ;; no memory for the walk: the hash so far, which only costs a
            ;; variant its match
            (if (or (not ok) (== wlen 0))
                (set running 0)
              (block
               (set t (nth (- wlen 2) wl))
               (set wlen (- wlen 2)))))
          (coco_wpairs_give m wl wcap)
          (return h)))

  ;;; WHETHER THE HEAP TERM A AND THE STORE'S TERM S ARE VARIANTS: one
  ;;; shape, and each variable of one where one variable of the other
  ;;; stands. The map holds both ways, A's variable to S's and S's to A's,
  ;;; a store index keyed past every heap one (2^39 on). 0 too when there
  ;;; was no memory for the walk.
  (static)
  (func coco_reload_variant ((coco_machine * m) (coco_store * st) (size_t a) (size_t s))
        (out int)
        (let ((size_t * wl . nil) (size_t wlen . 0) (size_t wcap . 0)
              (int ok . 1) (int running . 1) (coco_varmap vm)
              (size_t far . #'(<< (cast size_t 1) 39)))
          (set wl (coco_wpairs_take m (aof wcap)))
          (coco_varmap_take m (aof vm))
          (while running
            (let ((u64 ca . 0) (u64 cs . 0))
              (set a (coco_reload_at m st a 0 (aof ca)))
              (set s (coco_reload_at m st s 1 (aof cs)))
              (cond
                ((coco-tag-is REF ca)
                 (if (not (coco-tag-is REF cs))
                     (set ok 0)
                   (let ((size_t x . 0))
                     (if (coco_varmap_get (aof vm) a (aof x))
                         (if (!= x s) (set ok 0))
                       (if (coco_varmap_get (aof vm) (+ s far) (aof x))
                           (set ok 0)
                         (if (not (and (coco_varmap_put (aof vm) a s)
                                       (coco_varmap_put (aof vm) (+ s far) a)))
                             (set ok 0)))))))
                ((coco-tag-is REF cs) (set ok 0))
                ((!= (coco-tag ca) (coco-tag cs)) (set ok 0))
                ((coco-tag-is FLT ca) (if (not (coco_flt_eq m ca cs)) (set ok 0)))
                ((coco-tag-is STR ca) (if (not (coco_str_eq m ca cs)) (set ok 0)))
                ((coco-tag-is RAT ca) (if (not (coco_rat_eq m ca cs)) (set ok 0)))
                ((coco-tag-is BIG ca)
                 (if (!= (nth (cast size_t (coco-payload ca)) (-> m bigs))
                         (nth (cast size_t (coco-payload cs)) (-> m bigs)))
                     (set ok 0)))
                ;; an atom, an integer, a functor: the cells, and a functor's
                ;; arguments after it, in both places
                ((!= ca cs) (set ok 0))
                ((coco-tag-is FUN ca)
                 (let ((u32 n . #'($ (nth (cast size_t (coco-payload ca)) (-> m functors)) arity)))
                   (for ((u32 i . n)) (> i 0) ((set i (- i 1)))
                     (if (and ok (not (coco_pairs_push m (aof wl) (aof wlen) (aof wcap)
                                                       (+ a (cast size_t i)) (+ s (cast size_t i)))))
                         (set ok 0)))))
                (#t (block))))
            (if (or (== ok 0) (== wlen 0))
                (set running 0)
              (block
               (set s (nth (- wlen 1) wl))
               (set a (nth (- wlen 2) wl))
               (set wlen (- wlen 2)))))
          (coco_varmap_give m (aof vm))
          (coco_wpairs_give m wl wcap)
          (return ok)))

  ;;; THE RELOAD OF PI, begun at the file's first clause of it: O, the
  ;;; clauses PI holds then, each one's kind -- the file's own (ORIGIN, of
  ;;; the store's mute MUTE), asserted (no file, no module: a candidate
  ;;; only in a read that is not muted, whose adoption the knowledge base
  ;;; can be told), or another's -- and the candidates in buckets by their
  ;;; shapes (`coco_reload_hash'). Taken BEFORE the file's old clauses go;
  ;;; their cells stay in the store, orphaned, until it compacts. Nil when
  ;;; O holds nothing but the file's own clauses, the new ones then going
  ;;; after the last in the order the file says them, or when there is no
  ;;; memory, which places them as a first read does.
  (static)
  (func coco_reload_begin ((coco_store * st) (coco_machine * m) (size_t pi)
                           (u64 origin) (int mute)) (out coco_reload *)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (size_t n . 0) (size_t present . 0) (size_t ncand . 0) (size_t k . 0)
              (coco_reload * rl . nil))
          (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
            (if (not (coco_pred_dead p i))
                (block
                 (set n (+ n 1))
                 (if (not (and (== (nth i (-> p origins)) origin) (== (nth i (-> p muted)) mute)))
                     (set present (+ present 1))))))
          (if (== present 0) (return nil))
          (set rl (cast (coco_reload *) (calloc 1 (sizeof coco_reload))))
          (if (== rl nil) (return nil))
          (set (-> rl n) n)
          (set (-> rl cell) (cast (size_t *) (calloc n (sizeof size_t))))
          (set (-> rl kind) (cast (u8 *) (calloc n 1)))
          (set (-> rl hash) (cast (u64 *) (calloc n (sizeof u64))))
          (set (-> rl bnext) (cast (size_t *) (calloc n (sizeof size_t))))
          (if (or (== (-> rl cell) nil) (== (-> rl kind) nil) (== (-> rl hash) nil)
                  (== (-> rl bnext) nil))
              (block (coco_reload_free rl) (return nil)))
          (set (-> rl ncomp) (-> st ncompacts))
          ;; O in order, each candidate's shape read where it lies in the store
          (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
            (if (not (coco_pred_dead p i))
                (let ((u64 o . #'(nth i (-> p origins))) (int mu . #'(nth i (-> p muted))))
                  (set (nth k (-> rl cell)) (nth i (-> p clauses)))
                  (cond
                    ((and (== o origin) (== mu mute)) (set (nth k (-> rl kind)) 1))
                    ((and (not mute) (== o 0) (== mu 0)) (set (nth k (-> rl kind)) 2))
                    (#t (set (nth k (-> rl kind)) 0)))
                  (if (!= (nth k (-> rl kind)) 0)
                      (block
                       (set (nth k (-> rl hash)) (coco_reload_hash m st (nth i (-> p clauses)) 1))
                       (set ncand (+ ncand 1))))
                  (set k (+ k 1)))))
          ;; the buckets, each one's chain in ascending order
          (set (-> rl nb) 8)
          (while (< (-> rl nb) (* ncand 2)) (set (-> rl nb) (* (-> rl nb) 2)))
          (set (-> rl bhead) (cast (size_t *) (calloc (-> rl nb) (sizeof size_t))))
          (if (== (-> rl bhead) nil) (block (coco_reload_free rl) (return nil)))
          (set k n)
          (while (> k 0)
            (set k (- k 1))
            (if (!= (nth k (-> rl kind)) 0)
                (let ((size_t b . #'(cast size_t (bitand (nth k (-> rl hash))
                                                         (cast u64 (- (-> rl nb) 1))))))
                  (set (nth k (-> rl bnext)) (nth b (-> rl bhead)))
                  (set (nth b (-> rl bhead)) (+ k 1)))))
          (return rl)))

  ;;; THE CANDIDATE FOR THE NEW CLAUSE CLAUSE, of shape H: O's first from
  ;;; the pointer that is the file's own or asserted and a variant of it
  ;;; (`coco_reload_variant', where it lies in the store), or O's length
  ;;; for none. A bucket's chain is ascending, and what the pointer
  ;;; has passed is dropped from its head for good.
  (static)
  (func coco_reload_find ((coco_store * st) (coco_machine * m) (coco_reload * rl)
                          (size_t clause) (u64 h)) (out size_t)
        (let ((size_t b . #'(cast size_t (bitand h (cast u64 (- (-> rl nb) 1)))))
              (size_t j . 0))
          (while (and (!= (nth b (-> rl bhead)) 0)
                      (< (- (nth b (-> rl bhead)) 1) (-> rl ptr)))
            (set (nth b (-> rl bhead)) (nth (- (nth b (-> rl bhead)) 1) (-> rl bnext))))
          (set j (nth b (-> rl bhead)))
          (while (!= j 0)
            (let ((size_t i . #'(- j 1)))
              (if (and (or (== (nth i (-> rl kind)) 1) (== (nth i (-> rl kind)) 2))
                       (== (nth i (-> rl hash)) h))
                  (if (coco_reload_variant m st clause (nth i (-> rl cell))) (return i)))
              (set j (nth i (-> rl bnext)))))
          (return (-> rl n))))

  ;;; WHERE O'S CLAUSE I IS NOW, one that was there: where it was found
  ;;; last, or after, or before -- live, by its cell -- or nowhere, and it
  ;;; is passed for good (retracted, or taken by another read).
  (static)
  (func coco_reload_locate ((coco_reload * rl) (coco_pred * p) (size_t i)) (out size_t)
        (let ((size_t c . #'(nth i (-> rl cell))) (size_t at . #'(-> rl at)))
          (for ((size_t k . at)) (< k (-> p nclauses)) ((++ k))
            (if (and (== (nth k (-> p clauses)) c) (not (coco_pred_dead p k)))
                (block (set (-> rl at) k) (return k))))
          (for ((size_t k . 0)) (and (< k at) (< k (-> p nclauses))) ((++ k))
            (if (and (== (nth k (-> p clauses)) c) (not (coco_pred_dead p k)))
                (block (set (-> rl at) k) (return k))))
          (set (nth i (-> rl kind)) 3)
          (return (coco_no_clause))))

  ;;; WHERE A CLAUSE GOES IN BEFORE THE POINTER: before O's first clause
  ;;; from it that is still there, or after P's last when none is.
  (static)
  (func coco_reload_pos ((coco_reload * rl) (coco_pred * p)) (out size_t)
        (if (< (-> rl anc) (-> rl ptr)) (set (-> rl anc) (-> rl ptr)))
        (while (< (-> rl anc) (-> rl n))
          (let ((u8 kd . #'(nth (-> rl anc) (-> rl kind))))
            (if (or (== kd 0) (== kd 2))
                (let ((size_t k . #'(coco_reload_locate rl p (-> rl anc))))
                  (if (!= k (coco_no_clause)) (return k)))))
          (set (-> rl anc) (+ (-> rl anc) 1)))
        (return (-> p nclauses)))

  ;;; THE CLAUSE THE FILE SAYS NOW, CLAUSE on the heap, looked for among O
  ;;; from the pointer (`coco_reload_find'). One the program asserted
  ;;; becomes the file's where it stands, the pointer past it -- 1, and the
  ;;; caller adds nothing; the file's own old one, gone at the first
  ;;; clause, moves the pointer past it, and the caller puts the new one
  ;;; where it stood (`coco_reload_insert', before the next that is still
  ;;; there); none leaves the pointer where it is, and the new one goes in
  ;;; before it. A compaction since the reload began has moved every cell
  ;;; O holds, the file's old clauses' among them: none is a candidate or
  ;;; a place any more, and the read's clauses of PI go after its last.
  (static)
  (func coco_reload_adopt ((coco_store * st) (coco_machine * m) (coco_reload * rl)
                           (size_t pi) (size_t clause) (u64 origin)) (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (u64 h . 0) (size_t q . 0))
          (if (!= (-> st ncompacts) (-> rl ncomp))
              (block
               (for ((size_t i . 0)) (< i (-> rl n)) ((++ i))
                 (set (nth i (-> rl kind)) 3))
               (set (-> rl ncomp) (-> st ncompacts))))
          (set h (coco_reload_hash m st clause 0))
          (while 1
            (set q (coco_reload_find st m rl clause h))
            (if (>= q (-> rl n)) break)
            (if (== (nth q (-> rl kind)) 1)
                ;; the file's own: the new clause stands where it stood
                (block (set (nth q (-> rl kind)) 3) (set (-> rl ptr) (+ q 1)) break))
            ;; asserted: the file's now, if it is still there
            (let ((size_t k . #'(coco_reload_locate rl p q)))
              (if (!= k (coco_no_clause))
                  (block
                   (set (nth q (-> rl kind)) 3)
                   (set (-> rl ptr) (+ q 1))
                   (with-green-write nil
                     (set (nth k (-> p origins)) origin))
                   ;; and the knowledge base writes it again, with its
                   ;; file's name (`coco_zg_sync_pred')
                   (if (and (not (coco_store_is_muted st)) (!= (-> st on_assert) nil))
                       ((-> st on_assert) st (-> st ctx) (nth k (-> p clauses))))
                   (return 1)))))
          (return 0)))

  ;;; EVERY LIVE CLAUSE OF PI FROM POSITION K DIES WHERE IT STANDS -- one
  ;;; death, which the calls open on PI live through and still see -- and
  ;;; comes again after CLAUSE, a copy each, in order: a call open sees what
  ;;; it saw when it began, and a new call the order the file says. O's
  ;;; clauses among them are their copies from now on. The copies and the
  ;;; room for them are made BEFORE anything dies, so that no memory for
  ;;; them changes nothing and puts CLAUSE after the last, as an assertz
  ;;; goes; 0 only when that would not grow either.
  (static)
  (func coco_reload_relocate ((coco_store * st) (coco_machine * m) (coco_reload * rl)
                              (size_t pi) (size_t k) (size_t clause) (u64 key)
                              (u64 origin) (int muted)) (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (size_t n0 . #'(-> p nclauses)) (size_t nl . 0) (size_t * ls . nil)
              (size_t * cps . nil) (u32 era . 0) (size_t j . #'(-> rl anc)) (int ok . 1))
          (for ((size_t i . k)) (< i n0) ((++ i))
            (if (not (coco_pred_dead p i)) (set nl (+ nl 1))))
          ;; the positions, and after them the copies
          (set ls (cast (size_t *) (malloc (* (+ (* nl 2) 1) (sizeof size_t)))))
          (if (== ls nil) (return (coco_pred_add_clause st m pi clause 1 key origin muted)))
          (set cps (+ ls nl))
          (set nl 0)
          (for ((size_t i . k)) (< i n0) ((++ i))
            (if (not (coco_pred_dead p i))
                (block (set (nth nl ls) i) (set nl (+ nl 1)))))
          (for ((size_t x . 0)) (and ok (< x nl)) ((++ x))
            (let ((size_t mark . #'(-> m heap_len))
                  (size_t h . #'(coco_store_get m st (nth (nth x ls) (-> p clauses)))))
              (if (-> m oom)
                  (set ok 0)
                (block
                 (set (nth x cps) (coco_store_put st m h))
                 (if (-> st oom) (set ok 0))))
              (set (-> m heap_len) mark)))
          (if ok (set ok (coco_pred_room st p (+ nl 1))))
          (if ok
              (block (set era (coco_tomb_open st m pi))
                     (if (== era 0) (set ok 0))))
          (if (not ok)
              (block (free (cast (void *) ls))
                     (return (coco_pred_add_clause st m pi clause 1 key origin muted))))
          (for ((size_t x . 0)) (< x nl) ((++ x))
            (coco_tomb_set p (nth x ls) era))
          (if (not (coco_pred_add_clause st m pi clause 1 key origin muted))
              (block (free (cast (void *) ls)) (return 0)))
          (for ((size_t x . 0)) (< x nl) ((++ x))
            (let ((size_t i . #'(nth x ls))
                  (size_t old . #'(nth i (-> p clauses))))
              (coco_pred_add_clause st m pi (nth x cps) 1 (nth i (-> p keys))
                                    (nth i (-> p origins)) (nth i (-> p muted)))
              ;; O's clause, if this is one, is the copy from now on
              (while (and (< j (-> rl n))
                          (not (or (== (nth j (-> rl kind)) 0) (== (nth j (-> rl kind)) 2))))
                (set j (+ j 1)))
              (if (and (< j (-> rl n)) (== (nth j (-> rl cell)) old))
                  (block (set (nth j (-> rl cell)) (nth x cps)) (set j (+ j 1))))))
          (free (cast (void *) ls))
          (set (-> rl at) (+ n0 1))
          (return 1)))

  ;;; THE NEW CLAUSE PUT IN BEFORE THE POINTER (`coco_reload_pos'), or
  ;;; after the last when nothing from the pointer is still there, which is
  ;;; where an assertz goes, the index kept. A call open on PI that has a
  ;;; clause before that place still to try and one after it would see the
  ;;; new one, which came after it began: then the clauses from the place
  ;;; come again after the new one (`coco_reload_relocate').
  (static)
  (func coco_reload_insert ((coco_store * st) (coco_machine * m) (coco_reload * rl)
                            (size_t pi) (size_t clause) (u64 key) (u64 origin) (int muted))
        (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (size_t k . 0))
          ;; the dead gone first if no frame is open to want them, so the
          ;; place found below is where the clause goes
          (if (!= (-> p ntomb) 0) (coco_tomb_try_sweep st m pi))
          (set k (coco_reload_pos rl p))
          (if (>= k (-> p nclauses))
              (return (coco_pred_add_clause st m pi clause 1 key origin muted)))
          (with-green-write nil
            (if (!= (coco_frames_on m st pi 3 0 k) 0)
                (return (coco_reload_relocate st m rl pi k clause key origin muted)))
            (if (not (coco_pred_insert_at st m pi k clause key origin muted)) (return 0))
            (set (-> rl at) (+ k 1))
            (return 1))))

  ;;; PI'S PLACE IN THE CONSULT'S SEEN SET S, and at the file's first clause
  ;;; of it the reconsult: the reload begun -- for a file read into this
  ;;; store again, or a predicate that holds the file's clauses from before
  ;;; -- and then what the file put there last time taken out. *RL is the
  ;;; predicate's reload, nil for clauses that are appended. 0 when the set
  ;;; would not grow.
  (static)
  (func coco_reload_for ((coco_store * st) (coco_machine * m) (coco_origin_seen * s)
                         (size_t pi) (u64 origin) (coco_reload ** rl)) (out int)
        (set (cof rl) nil)
        ;; a file's clauses of one predicate come together, mostly
        (if (and (!= (-> s last) 0) (== (nth (- (-> s last) 1) (-> s pis)) pi))
            (block (set (cof rl) (nth (- (-> s last) 1) (-> s rls))) (return 1)))
        (for ((size_t i . 0)) (< i (-> s n)) ((++ i))
          (if (== (nth i (-> s pis)) pi)
              (block (set (-> s last) (+ i 1))
                     (set (cof rl) (nth i (-> s rls)))
                     (return 1))))
        (if (not (coco_store_grow st (cast (void **) (aof (-> s pis)))
                                (aof (-> s cap)) (+ (-> s n) 1) (sizeof size_t)))
            (return 0))
        (if (not (coco_store_grow st (cast (void **) (aof (-> s rls)))
                                (aof (-> s rcap)) (+ (-> s n) 1) (sizeof size_t)))
            (return 0))
        (let ((coco_reload * r . nil) (int mute . #'(coco_store_is_muted st)))
          (if (or (-> s again) (coco_pred_holds st pi origin mute))
              (set r (coco_reload_begin st m pi origin mute)))
          (set (nth (-> s n) (-> s pis)) pi)
          (set (nth (-> s n) (-> s rls)) r)
          (set (-> s n) (+ (-> s n) 1))
          (set (-> s last) (-> s n))
          (coco_pred_forget_from st m pi origin)
          (set (cof rl) r)
          (return 1)))

  ;;; THE RECONSULT, as one predicate at a time: the clauses of PI that
  ;;; ORIGIN put there are taken out, in place, and the rest close up. The
  ;;; cells stay in the store, orphaned, as a retract leaves them; the
  ;;; positions have shifted, so the index is dropped; and the backend hears
  ;;; once, through the retract hook, which rewrites the predicate whole.
  ;;;
  ;;; ONLY THE CLAUSES OF THE STORE'S OWN MUTE (2.14.0): a muted forget --
  ;;; a module read again -- takes the module's clauses, which never reached
  ;;; the knowledge base, and tells the backend nothing; an unmuted one
  ;;; takes the program's, and tells it. A module's clauses carry their
  ;;; file's path too since 2.14.0, and a forget that took the other kind
  ;;; would leave the knowledge base and this store holding different
  ;;; things -- or, unmuted over a predicate never read, rewrite it from
  ;;; nothing.
  (func coco_pred_forget_from ((coco_store * st) (coco_machine * m) (size_t pi) (u64 origin)) (out int)
        (if (or (>= pi (-> st npreds)) (== origin 0)) (return 0))
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
              (int mute . #'(coco_store_is_muted st))
              (size_t kept . 0) (int gone . 0) (size_t swept . 0))
          ;; THE LOGICAL UPDATE VIEW: with a call open on the predicate, the
          ;; file's clauses die where they stand and stay for it, and what
          ;; the file says now comes after every one of them
          (let ((u32 era . #'(coco_tomb_open st m pi)))
            (if (!= era 0)
                (block
                  (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
                    (if (and (== (nth i (-> p origins)) origin) (== (nth i (-> p muted)) mute)
                             (== (nth i (-> p tomb)) 0))
                        (block (coco_tomb_set p i era) (set gone (+ gone 1)))))
                  (if (== gone 0) (return 0))
                  (if (and (not (coco_store_is_muted st)) (!= (-> st on_retract) nil))
                      ((-> st on_retract) st (-> st ctx) pi))
                  (return gone))))
          ;; no call open: taken out, and the dead of an earlier change with them
          (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
            (cond
              ((coco_pred_dead p i)
               (set swept (+ swept 1))
               (coco_store_orphan st m (nth i (-> p clauses))))
              ((and (== (nth i (-> p origins)) origin) (== (nth i (-> p muted)) mute))
               (set gone (+ gone 1))
               (coco_store_orphan st m (nth i (-> p clauses))))
              (#t
                (if (!= kept i)
                    (block (set (nth kept (-> p clauses)) (nth i (-> p clauses)))
                           (set (nth kept (-> p keys)) (nth i (-> p keys)))
                           (set (nth kept (-> p origins)) (nth i (-> p origins)))
                           (set (nth kept (-> p muted)) (nth i (-> p muted)))
                           (set (nth kept (-> p codes)) (nth i (-> p codes)))))
                (set kept (+ kept 1)))))
          (if (and (== gone 0) (== swept 0)) (return 0))
          (set (-> p nclauses) kept)
          (set (-> p tver) (+ (-> p tver) 1))
          (if (!= (-> p tomb) nil)
              (block (free (cast (void *) (-> p tomb)))
                     (set (-> p tomb) nil) (set (-> p tomb_cap) 0)
                     (set (-> p ntomb) 0) (set (-> p tprobe) 0) (set (-> p tera) 0)))
          (coco_pred_nprobe p)
          (coco_pred_unindex p)
          (if (== gone 0) (return 0))
          (if (and (not (coco_store_is_muted st)) (!= (-> st on_retract) nil))
              ((-> st on_retract) st (-> st ctx) pi))
          (return gone)))

  (func coco_assert ((coco_store * st) (coco_machine * m) (size_t clause) (int at_end)) (out int)
        (return (coco_assert_from st m clause at_end 0 nil)))

  ;;; THE HOOKS print_message/2 READS (2.16.0): `prolog:message//1' and
  ;;; `prolog:error_message//1', the two a program extends to give a term of
  ;;; its own its text. One namespace keeps them apart from a program's own
  ;;; message/3 by name: their clauses are '$prolog_message'/3 and
  ;;; '$prolog_error_message'/3, which library(print_message) calls. Any
  ;;; other qualified head loses its qualifier, as it always did.
  (static)
  (func coco_hook_head ((coco_machine * m) (size_t mod) (size_t h)) (out size_t)
        (set mod (coco_deref m mod))
        (set h (coco_deref m h))
        (if (not (coco-tag-is ATOM (nth mod (-> m heap)))) (return h))
        (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m mod)) "prolog")) (return h))
        (if (or (not (coco_is_callable m h)) (!= (coco_arity m h) 3)) (return h))
        (let ((const char * nm . #'(coco_atom_name m (coco_name_of m h))) (const char * to . nil)
              (size_t args [3]))
          (if (== 0 (strcmp nm "message")) (set to "$prolog_message"))
          (if (== 0 (strcmp nm "error_message")) (set to "$prolog_error_message"))
          (if (== to nil) (return h))
          (set (nth 0 args) (coco_arg m h 0))
          (set (nth 1 args) (coco_arg m h 1))
          (set (nth 2 args) (coco_arg m h 2))
          (return (coco_make m to 3 args))))

  (func coco_assert_stored ((coco_store * st) (coco_machine * m) (size_t t)) (out int)
        (set t (coco_deref m t))
        (if (and (coco_is_callable m t) (== (coco_arity m t) 2)
                 (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) "$from")))
            (let ((size_t from . #'(coco_deref m (coco_arg m t 0))))
              (if (coco-tag-is ATOM (nth from (-> m heap)))
                  (return (coco_assert_from st m (coco_arg m t 1) 1
                                            (+ (coco_name_of m from) 1) nil)))))
        (return (coco_assert_from st m t 1 0 nil)))

  (func coco_assert_from ((coco_store * st) (coco_machine * m) (size_t clause)
                          (int at_end) (u64 origin) (coco_origin_seen * seen)) (out int)
        (set clause (coco_deref m clause))
        (set (nth 0 (-> st assert_err)) (cast char 0))
        ;; and the last read's reason, so a refusal below is this one's
        (set (nth 0 (-> st fetch_err)) (cast char 0))

        ;; A GRAMMAR RULE IS REWRITTEN HERE AND NOWHERE ELSE. Everything that
        ;; puts a clause in the store comes through this function -- consulting
        ;; a file, `assertz' in a running program, a module's own clauses on
        ;; the way in -- so translating here is what makes `-->' mean the same
        ;; thing by all three routes. What gets stored is the ordinary clause;
        ;; nothing below this line has ever heard of a grammar.
        (if (coco_dcg_is_rule m clause)
            (let ((coco_dcg_err derr) (size_t rewritten))
              ;; ...AND A CYCLIC ONE IS REFUSED FIRST (1.10.19): the
              ;; translation walks the body, and went round a cyclic one for
              ;; ever. Asked of an assert's rule (no origin), a consulted one
              ;; having been read from text; the refusal is told as the put's
              ;; is, by the count of cycles moving
              (if (and (== origin 0) (!= 1 (coco_acyclic m clause)))
                  (block (set (-> m cyc_puts) (+ (-> m cyc_puts) 1)) (return 0)))
              (set ($ derr kind) COCO_DCG_OK)
              (set ($ derr culprit) 0)
              (set rewritten (coco_dcg_rule m clause (aof derr)))
              ;; a rule that will not translate is not silently stored as a
              ;; `-->'/2 fact, which is what returning 1 here would do
              (if (== rewritten 0) (return 0))
              (set clause rewritten)))

        ;; A SINGLE-SIDED RULE IS TRANSLATED HERE, the way a grammar rule
        ;; is: SWI >= 8.4 writes deterministic dispatch as `Head => Body',
        ;; and its own libraries (assoc.pl, ordsets.pl) now use it, so a
        ;; byte-identical vendor cannot be read without it. The translation
        ;; is `Head :- !, Body' -- first head that unifies commits, which is
        ;; what those libraries mean by it. It is an APPROXIMATION: real SSU
        ;; refuses a head that would bind the CALLER's variables, so a call
        ;; that under-instantiates the dispatch argument can bind it here
        ;; where SWI would raise. Every legitimate call is identical.
        (if (and (coco_is_callable m clause) (== (coco_arity m clause) 2)
                 (== 0 (strcmp (coco_atom_name m (coco_name_of m clause)) "=>")))
            (set clause
                 (coco_make2 m ":-" (coco_arg m clause 0)
                             (coco_make2 m "," (coco_new_atom m "!")
                                         (coco_arg m clause 1)))))

        ;; A MODULE-QUALIFIED HEAD IS STRIPPED HERE. cocolog has one
        ;; namespace, so `error:has_type(T, X) :- B' can only mean
        ;; `has_type(T, X) :- B' -- and a vendored SWI file is entitled to the
        ;; qualified spelling (assoc.pl extends error:has_type/2 that way).
        ;; The clause TERM is rebuilt rather than just the predicate choice,
        ;; because the stored head has to unify with unqualified calls.
        (let ((size_t qh) (size_t qb))
          (coco_clause_parts m clause (aof qh) (aof qb))
          (set qh (coco_deref m qh))
          (if (and (coco_is_callable m qh) (== (coco_arity m qh) 2)
                   (== 0 (strcmp (coco_atom_name m (coco_name_of m qh)) ":")))
              (let ((size_t inner . #'(coco_hook_head m (coco_arg m qh 0) (coco_arg m qh 1))))
                (set clause (? (== qb 0) inner (coco_make2 m ":-" inner qb))))))

        ;; the head decides which predicate this belongs to
        (let ((size_t head . clause))
          (if (and (coco_is_callable m clause) (== (coco_arity m clause) 2))
              (if (== 0 (strcmp (coco_atom_name m (coco_name_of m clause)) ":-"))
                  (set head (coco_deref m (coco_arg m clause 0)))))
          (if (not (coco_is_callable m head)) (return 0))

          ;; WILL IT FIT? Asked HERE -- before the predicate is touched at
          ;; all, and above the reconsult forget in particular, because the
          ;; backend only finds out at COMMIT and by then the whole
          ;; transaction is lost. See `clause_max' on the store: measured, a
          ;; clause of 8014 characters took every other clause the process
          ;; had written down with it.
          ;;
          ;; THE TERM MEASURED IS THE ONE THE BACKEND WILL WRITE, `'$from''
          ;; wrapper and all, so a long path counts against the clause here
          ;; exactly as it will on the way out.
          ;;
          ;; A LOCAL STORE PAYS NOTHING: `clause_max' is 0, and there is no
          ;; row for a clause to fit into. A module's clauses pay nothing
          ;; either -- muted means they never reach one.
          (if (and (!= (-> st clause_max) 0) (not (coco_store_is_muted st)))
              (let ((coco_strbuf b) (size_t len . 0)
                    (size_t mark . #'(-> m heap_len))
                    (size_t t . clause))
                (if (!= origin 0)
                    (set t (coco_make2 m "$from"
                                       (coco_new_atom m (coco_atom_name m (- origin 1)))
                                       t)))
                (coco_sb_init (aof b))
                (coco_write_storable m (aof b) t)
                (set len (? (== ($ b s) nil) 0 (strlen ($ b s))))
                (coco_sb_free (aof b))
                (set (-> m heap_len) mark)
                ;; THE PREDICATE'S NAME SHARES THE ROW, and this is the only
                ;; place that knows it -- `clause_max' is per-store and was
                ;; settled from the page and the knowledge base's name. It is
                ;; one byte per character, measured.
                (let ((const char * pname . #'(coco_atom_name m (coco_name_of m head))))
                  (let ((size_t room . #'(? (>= (strlen pname) (-> st clause_max))
                                            0
                                            (- (-> st clause_max) (strlen pname)))))
                    (if (> len room)
                        (block
                         (snprintf (-> st assert_err) 256
                                   "%s/%u: a clause of %lu characters, and a row holds %lu -- store it as several clauses"
                                   pname (coco_arity m head)
                                   (cast ulong len) (cast ulong room))
                         (return 0)))))))

          (let ((size_t pi . #'(coco_pred_make st (coco_name_of m head) (coco_arity m head)))
                (size_t stored) (coco_reload * rl . nil))
            (if (>= pi (-> st npreds)) (return 0))
            ;; THE PREDICATE IS FETCHED BEFORE THE CLAUSE IS ADDED, and that is
            ;; not an optimisation -- it is what makes `assertz' mean append
            ;; when the predicate lives in a shared store. Marking it loaded
            ;; instead (which is what this did) left the local store holding
            ;; ONLY the new clause, and a backend that writes a predicate back
            ;; wholesale then replaced the shared one with it. Five facts in
            ;; the database became one.
            ;;
            ;; It cannot recurse: coco_pred_ensure marks the predicate loaded
            ;; before it calls the hook, so the asserts the hook itself makes
            ;; find it already loaded.
            ;;
            ;; A MUTED ASSERT DOES NOT FETCH, and that is the same rule read
            ;; the other way: a module's clause never writes through, so there
            ;; is no shared predicate for it to be appended to, and nothing to
            ;; read first. Leaving `loaded' at zero also leaves the predicate
            ;; honest -- the first REAL call still fetches, exactly once, as it
            ;; would have without the module.
            ;;
            ;; MEASURED, on one `edge_fact(X)' through a Zeytun edge, because
            ;; the number is the whole argument. Before this guard: 440 HTTP
            ;; requests and 91.4 SECONDS -- and 168 of those requests were
            ;; there before the vendored libraries were, from the Coco halves
            ;; of the modules compiled in. After: ONE request, 447ms. The line
            ;; was asking the database about a predicate per library clause,
            ;; every start-up, in an arrangement where a predicate is a page
            ;; over the network.
            ;;
            ;; AND A PREDICATE THAT COULD NOT BE READ IS NOT WRITTEN (2.11.1).
            ;; The backend writes a predicate back whole (`coco_zg_sync_pred'),
            ;; so a clause added over a read that failed -- or over the part
            ;; of it that arrived -- took every unread row out of the
            ;; database. The clause is refused, the store's `fetch_err' says
            ;; why, `coco_assert_goal' raises it, and a consult reports it as
            ;; it reports a clause too long for a row and goes on.
            (if (not (coco_store_is_muted st))
                (if (not (coco_pred_ensure st pi))
                    (block
                      (snprintf (-> st assert_err) 256
                                "%s/%u: the knowledge base could not be read, so the clause was not added: %s"
                                (coco_atom_name m (coco_name_of m head)) (coco_arity m head)
                                (-> st fetch_err))
                      (return 0))))
            ;; THE RECONSULT: the first clause this consult adds to the
            ;; predicate first takes out what the same file put there last
            ;; time -- after the fetch, so the rows are here to be taken out,
            ;; and before the add, so this consult's own clauses stay. A
            ;; re-read places each clause as swipl's reload does (2.14.1,
            ;; `coco_reload_for'): where the clause it is a variant of stood,
            ;; or before swipl's pointer -- and one the program asserted that
            ;; it is a variant of becomes the file's, and nothing is added.
            (if (and (!= origin 0) (!= seen nil))
                (if (not (coco_reload_for st m seen pi origin (aof rl))) (return 0)))
            (if (and (!= rl nil) (coco_reload_adopt st m rl pi clause origin))
                (return 1))
            ;; A CYCLIC CLAUSE IS REFUSED (1.10.19), as SWI refuses one with
            ;; `representation_error(cyclic_term)' (`coco_assert_goal' says
            ;; so): the put stores a cycle as its factors, which no clause
            ;; may be, and counts it -- so the count moving means the cells
            ;; are taken back and nothing is added
            (let ((size_t cp . #'(-> m cyc_puts))
                  (size_t base . #'(-> st len)))
              (set stored (coco_store_put st m clause))
              (if (!= cp (-> m cyc_puts))
                  (block (set (-> st len) base) (return 0))))
            ;; THE KEY IS TAKEN FROM THE HEAP HEAD, before the clause is a
            ;; store term: the accessors here read the machine's heap, the
            ;; head has just been dereferenced, and what goes into the store
            ;; is a copy of exactly this term. Doing it on the way in is what
            ;; keeps the index free -- nothing ever walks the clauses to
            ;; work out what they are keyed on.
            (if (not (? (!= rl nil)
                        (coco_reload_insert st m rl pi stored (coco_arg_key m head) origin
                                            (? (coco_store_is_muted st) 1 0))
                        (coco_pred_add_clause st m pi stored at_end (coco_arg_key m head) origin
                                              (? (coco_store_is_muted st) 1 0))))
                (return 0))
            ;; muted means this is a module's clause, not the program's.
            ;; ON THE FIRST CLAUSE ONLY, because that is where the pre-warm
            ;; table is consulted and a table lookup per clause would be a
            ;; string compare per clause of every module in the process.
            (if (and (coco_store_is_muted st) (not ($ (nth pi (-> st preds)) library)))
                (block
                  (set ($ (nth pi (-> st preds)) library) 1)
                  (set ($ (nth pi (-> st preds)) own) (-> st ownload))
                  ;; AND THE PRE-WARM ANSWERS FOR IT. `loaded' stays 0 here
                  ;; otherwise -- the comment above says why -- but when the
                  ;; process has already asked the backend about this exact
                  ;; name and arity and been given nothing, asking again is a
                  ;; round trip for an answer that is in hand.
                  (if (coco_prewarm_has (coco_atom_name m ($ (nth pi (-> st preds)) name))
                                        ($ (nth pi (-> st preds)) arity))
                      (set ($ (nth pi (-> st preds)) loaded) 1))))
            (if (and (not (coco_store_is_muted st)) (!= (-> st on_assert) nil))
                ((-> st on_assert) st (-> st ctx) stored))
            (return 1))))

  ;;; What a `:- if(G)' may ask, read below the engine. A directive takes
  ;;; effect while the file is still being read, so the condition cannot be
  ;;; run as a goal -- the same bind that makes `op/3' a special case. What
  ;;; the vendored SWI libraries actually probe is whether some VM intrinsic
  ;;; exists (`current_predicate(\'$btree_find_node\'/5)' in assoc.pl), and
  ;;; THAT is answerable from the store: cocolog has no such predicate, by
  ;;; construction. So: `true', `fail'/`false', `\+'/1, and
  ;;; `current_predicate(Name/Arity)' against the store. Anything else is
  ;;; refused by name rather than guessed at.
  (static)
  (func coco_cond_eval ((coco_store * st) (coco_machine * m) (size_t g)
                        (int * truth) (char * err) (size_t errlen)) (out int)
        (set g (coco_deref m g))
        (if (not (coco_is_callable m g))
            (block (snprintf err errlen "if: the condition must be callable") (return 0)))
        (let ((const char * name . #'(coco_atom_name m (coco_name_of m g)))
              (u32 n . #'(coco_arity m g)))
          (if (and (== n 0) (== 0 (strcmp name "true")))
              (block (set (cof truth) 1) (return 1)))
          (if (and (== n 0) (or (== 0 (strcmp name "fail")) (== 0 (strcmp name "false"))))
              (block (set (cof truth) 0) (return 1)))
          (if (and (== n 1) (== 0 (strcmp name "\\+")))
              (block (if (not (coco_cond_eval st m (coco_arg m g 0) truth err errlen))
                         (return 0))
                     (set (cof truth) (? (== (cof truth) 0) 1 0))
                     (return 1)))
          (if (and (== n 1) (== 0 (strcmp name "current_predicate")))
              (let ((size_t spec . #'(coco_deref m (coco_arg m g 0))))
                (if (or (not (coco_is_callable m spec)) (!= (coco_arity m spec) 2)
                        (!= 0 (strcmp (coco_atom_name m (coco_name_of m spec)) "/")))
                    (block (snprintf err errlen "if: current_predicate wants Name/Arity")
                           (return 0)))
                (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
                      (size_t ar . #'(coco_deref m (coco_arg m spec 1))))
                  (if (or (not (coco_is_callable m nm)) (!= (coco_arity m nm) 0))
                      (block (snprintf err errlen "if: current_predicate wants an atom name")
                             (return 0)))
                  (let ((u64 c . #'(nth ar (-> m heap))))
                    (if (not (coco-is-int c))
                        (block (snprintf err errlen "if: current_predicate wants an integer arity")
                               (return 0)))
                    ;; an arity past 32 bits names no predicate (2.0.0)
                    (if (coco-tag-is BIG c) (block (set (cof truth) 0) (return 1)))
                    (let ((size_t pi . #'(coco_pred_find st (coco_name_of m nm)
                                                        (cast u32 (coco-signed-payload c)))))
                      (set (cof truth) (? (< pi (-> st npreds)) 1 0))
                      (return 1))))))
          (snprintf err errlen "if: cannot decide `%s/%u' while reading" name n)
          (return 0)))

  ;;; CONSULTING A FILE REPLACES THE CLAUSES IT PUT THERE LAST TIME. Every
  ;;; clause read here is owned by the file, under its REAL path -- so
  ;;; `tutorials/x.pl' and `./tutorials/x.pl' are one file and replace each
  ;;; other, while the name as given stays in the messages -- and the first
  ;;; clause of each predicate takes the file's old clauses of it out before
  ;;; going in. What a program asserted, and what another file put there,
  ;;; is untouched: the store used to APPEND, so the second of the three
  ;;; processes a tutorial runs against one store held two copies of every
  ;;; clause, and a generator without a cut answered once per copy. A
  ;;; caller naming no file owns nothing, and a module's text (muted) is
  ;;; owned only when its loader names the file (`coco_consult_owner',
  ;;; 2.14.0).
  (static) (decl) (func coco_consult_owned ((coco_store * st) (coco_machine * m)
                                           (const char * text) (const char * origin)
                                           (u64 oid) (coco_origin_seen * seen)
                                           (char * err) (size_t errlen)) (out int))
  (static) (decl) (func coco_consult_oid ((coco_store * st) (coco_machine * m)
                                         (const char * text) (const char * origin)
                                         (u64 oid) (int reread) (int again)
                                         (char * err) (size_t errlen)) (out int))

  (func coco_consult_again ((coco_store * st) (coco_machine * m) (const char * text)
                            (const char * origin) (int again)
                            (char * err) (size_t errlen)) (out int)
        (let ((u64 oid . 0))
          (if (and (!= origin nil) (not (coco_store_is_muted st)))
              (let ((char full [4096]))
                ;; `realpath' is in <stdlib.h> but not in the std POSIX
                ;; declarations; it is declared beside this one so the call
                ;; is checked like any other.
                (if (!= nil (realpath origin full))
                    (set oid (+ (coco_intern m full) 1))
                  (set oid (+ (coco_intern m origin) 1)))))
          (return (coco_consult_oid st m text origin oid 1 again err errlen))))

  (func coco_consult ((coco_store * st) (coco_machine * m) (const char * text)
                    (const char * origin)
                    (char * err) (size_t errlen)) (out int)
        (return (coco_consult_again st m text origin 0 err errlen)))

  ;;; a module's text read again is a file read again (`lb_reread'), and
  ;;; its first read places nothing
  (func coco_consult_owner ((coco_store * st) (coco_machine * m) (const char * text)
                          (const char * origin) (const char * owner) (int reread)
                          (char * err) (size_t errlen)) (out int)
        (return (coco_consult_oid st m text origin
                                  (? (== owner nil) 0 (+ (coco_intern m owner) 1))
                                  reread reread err errlen)))

  ;;; WHAT THE FILE NO LONGER SAYS GOES TOO (2.14.0), as SWI's reload takes
  ;;; out a predicate the new text does not define. The first clause of
  ;;; each predicate the consult reads replaced the file's old clauses of
  ;;; it (`coco_assert_from'); a predicate it did not read keeps them --
  ;;; through 2.13, every one of them, so a file edited to drop `q/1' went
  ;;; on answering `q/1' from its last read. Every predicate SEEN did not
  ;;; mark loses OID's clauses of the store's mute here, and one left with
  ;;; none is unknown, as in swipl. Asked only of a consult that read its
  ;;; text to the end: one a syntax error stopped did not read what came
  ;;; after the error, and what it did not read is not the file's absence.
  (static)
  (func coco_consult_forget_rest ((coco_store * st) (coco_machine * m) (u64 oid)
                                  (coco_origin_seen * seen))
        (let ((int mute . #'(coco_store_is_muted st)) (size_t np . #'(-> st npreds))
              (char * mark . nil))
          (if (== np 0) (return))
          (set mark (cast (char *) (calloc np 1)))
          (if (== mark nil) (return))
          (for ((size_t i . 0)) (< i (-> seen n)) ((++ i))
            (if (< (nth i (-> seen pis)) np) (set (nth (nth i (-> seen pis)) mark) 1)))
          (for ((size_t pi . 0)) (< pi np) ((++ pi))
            (if (and (== (nth pi mark) 0) (coco_pred_holds st pi oid mute))
                (coco_pred_forget_from st m pi oid)))
          (free mark)))

  (func coco_consult_oid ((coco_store * st) (coco_machine * m) (const char * text)
                          (const char * origin) (u64 oid) (int reread) (int again)
                          (char * err) (size_t errlen)) (out int)
        (let ((coco_origin_seen seen) (int n . 0))
          (memset (aof seen) 0 (sizeof coco_origin_seen))
          (set ($ seen again) again)
          ;; the loop registers its `initialization/1' goals as roots and
          ;; leaves on several paths, so the registration is dropped HERE,
          ;; whichever way it came out -- and so are the heap roots it holds
          ;; around a goal that may collect, and the word that let it (`dgc',
          ;; which the loop takes for itself and gives back to nobody).
          ;; A FIRST READ (a module's into a new store) has nothing of its
          ;; own to replace, and passes no SEEN: a module's clauses each
          ;; looked their predicate up in it, a walk per clause.
          (let ((size_t depth . #'(-> st nroots)) (size_t hdepth . #'(-> m nhroots))
                (int dgc . #'(-> m dgc)))
            (set n (coco_consult_owned st m text origin oid (? reread (aof seen) nil) err errlen))
            (set (-> st nroots) depth)
            (set (-> m nhroots) hdepth)
            (set (-> m dgc) dgc))
          (if (and reread (!= oid 0) (>= n 0))
              (coco_consult_forget_rest st m oid (aof seen)))
          (if (!= ($ seen rls) nil)
              (for ((size_t i . 0)) (< i ($ seen n)) ((++ i))
                (coco_reload_free (nth i ($ seen rls)))))
          (free (cast (void *) ($ seen rls)))
          (free (cast (void *) ($ seen pis)))
          ;; a reconsult has just orphaned the file's previous clauses
          (coco_store_maybe_compact st m)
          (return n)))

  ;;; A CONSULT THAT STOPS SAYS WHERE (1.11.9), as SWI places a load's
  ;;; messages: FILE:LINE: before the reason the stop left in ERR, so a
  ;;; caller prints it whole. A text that came from no file says its line.
  (static)
  (func coco_consult_where ((char * err) (size_t errlen) (const char * origin) (int at))
        (let ((char what [512]))
          (snprintf what 512 "%s" err)
          (if (!= origin nil)
              (snprintf err errlen "%s:%d: %s" origin at what)
            (snprintf err errlen "line %d: %s" at what))))

  (static)
  (func coco_consult_owned ((coco_store * st) (coco_machine * m) (const char * text)
                            (const char * origin) (u64 oid) (coco_origin_seen * seen)
                            (char * err) (size_t errlen)) (out int)
        (let ((coco_reader r) (size_t t) (int rc . 1) (int n . 0) (size_t mark)
              ;; `:- if/elif/else/endif' -- conditional reading, sixteen deep.
              ;; A frame remembers whether its current branch is being TAKEN
              ;; and whether any branch of the if has ALREADY run (so a later
              ;; `elif'/`else' in the same if stays off). Everything read
              ;; while any frame is not taking is dropped, directives too --
              ;; except these four, which keep the nesting straight.
              (int csp . 0) (int ctaking [16]) (int ctaken [16]) (int active . 1)
              ;; WHERE THE CLAUSE IN HAND BEGINS, counted forward and never
              ;; back: `scanned' is how far the newline count has read and
              ;; `line' the answer at that point, so the whole file is walked
              ;; once however many clauses it holds. The reader keeps one
              ;; token in hand, so this is the line the clause STARTS on --
              ;; which is the line SWI names too.
              (size_t scanned . 0) (int line . 1) (int at . 1)
              (coco_initgoals inits)
              ;; MAY A GOAL RUN FROM HERE COLLECT THE HEAP (1.9.6)? Only if
              ;; whoever called the consult said so (`dgc', lib/term.cicili),
              ;; and only around a call whose cells this frame has registered:
              ;; the clause in hand and the mark the heap is wound back to.
              ;; Taken here, so the reader and the store never run under it.
              (int vouch . #'(-> m dgc)))
          (set (-> m dgc) 0)
          ;; a backtrace no report took (a window's, whose ball it handed
          ;; back) is not this load's: only a goal run from here writes one
          ;; to report
          (coco_bt_say m 0)
          (memset (aof inits) 0 (sizeof coco_initgoals))
          ;; the goals put off to the end are cell indices; a compaction
          ;; before they run must move them too. `coco_consult' unregisters.
          (coco_store_root_push st (aof ($ inits cells)) (aof ($ inits len)))
          (coco_reader_init (aof r) m text)
          (while (== rc 1)
            ;; each clause is read on to the heap, copied into the store, and
            ;; the heap wound back -- so consulting a large file does not leave
            ;; a copy of it in the machine as well as in the store
            (set mark (-> m heap_len))
            (while (< scanned ($ r pos))
              (if (== (nth scanned text) (cast char 10)) (set line (+ line 1)))
              (set scanned (+ scanned 1)))
            (set at line)
            (set rc (coco_read_clause (aof r) (aof t)))
            (if (== rc 1)
                (block
                 (set active 1)
                 (let ((int ci . 0))
                   (while (< ci csp)
                     (if (== (nth ci ctaking) 0) (set active 0))
                     (set ci (+ ci 1))))
                 ;; `:- G' IS A DIRECTIVE AND NOT A CLAUSE. It used to go
                 ;; straight into coco_assert, which took it for a clause whose
                 ;; head was `:-' of arity one and filed it under a predicate of
                 ;; that name -- so `:- dynamic counter/1.' quietly became a
                 ;; fact nothing would ever call, and the file looked consulted.
                 (if (coco_is_compound1 m t ":-")
                     (let ((size_t d . #'(coco_deref m (coco_arg m t 0)))
                           (const char * dn . "") (u32 da . 0) (int handled . 0))
                       (if (coco_is_callable m d)
                           (block (set dn (coco_atom_name m (coco_name_of m d)))
                                  (set da (coco_arity m d))))
                       (if (and (== da 1) (== 0 (strcmp dn "if")))
                           (block
                            (set handled 1)
                            (if (>= csp 16)
                                (block (snprintf err errlen "if: nested too deep")
                                       (coco_consult_where err errlen origin at)
                                       (coco_reader_free (aof r)) (return -1)))
                            (let ((int truth . 0))
                              ;; inside a skipped region the condition is not
                              ;; even evaluated -- the frame only keeps count
                              (if active
                                  (if (not (coco_cond_eval st m (coco_arg m d 0)
                                                           (aof truth) err errlen))
                                      (block (coco_consult_where err errlen origin at)
                                             (coco_reader_free (aof r)) (return -1))))
                              (set (nth csp ctaking) (? (and active truth) 1 0))
                              (set (nth csp ctaken) (? (and active truth) 1 0))
                              (set csp (+ csp 1)))))
                       (if (and (== da 1) (== 0 (strcmp dn "elif")))
                           (block
                            (set handled 1)
                            (if (== csp 0)
                                (block (snprintf err errlen "elif: no `:- if' is open")
                                       (coco_consult_where err errlen origin at)
                                       (coco_reader_free (aof r)) (return -1)))
                            (let ((int truth . 0) (int outer . 1) (int ci . 0))
                              (while (< ci (- csp 1))
                                (if (== (nth ci ctaking) 0) (set outer 0))
                                (set ci (+ ci 1)))
                              (if (and outer (== (nth (- csp 1) ctaken) 0))
                                  (block
                                   (if (not (coco_cond_eval st m (coco_arg m d 0)
                                                            (aof truth) err errlen))
                                       (block (coco_consult_where err errlen origin at)
                                              (coco_reader_free (aof r)) (return -1)))
                                   (set (nth (- csp 1) ctaking) truth)
                                   (if truth (set (nth (- csp 1) ctaken) 1)))
                                (set (nth (- csp 1) ctaking) 0)))))
                       (if (and (== da 0) (== 0 (strcmp dn "else")))
                           (block
                            (set handled 1)
                            (if (== csp 0)
                                (block (snprintf err errlen "else: no `:- if' is open")
                                       (coco_consult_where err errlen origin at)
                                       (coco_reader_free (aof r)) (return -1)))
                            (let ((int outer . 1) (int ci . 0))
                              (while (< ci (- csp 1))
                                (if (== (nth ci ctaking) 0) (set outer 0))
                                (set ci (+ ci 1)))
                              (if (and outer (== (nth (- csp 1) ctaken) 0))
                                  (block (set (nth (- csp 1) ctaking) 1)
                                         (set (nth (- csp 1) ctaken) 1))
                                (set (nth (- csp 1) ctaking) 0)))))
                       (if (and (== da 0) (== 0 (strcmp dn "endif")))
                           (block
                            (set handled 1)
                            (if (== csp 0)
                                (block (snprintf err errlen "endif: no `:- if' is open")
                                       (coco_consult_where err errlen origin at)
                                       (coco_reader_free (aof r)) (return -1)))
                            (set csp (- csp 1))))
                       ;; REPORTED, AND THE LOAD GOES ON. A directive is a
                       ;; goal now, and a goal that fails or throws is news
                       ;; about that goal -- not a reason to throw away the
                       ;; clauses under it, which is what returning -1 here
                       ;; used to do: one `:- initialization(main).' at the
                       ;; top of a file and NOTHING in it was loaded.
                       ;;
                       ;; THE MARK IS REGISTERED around it (1.9.6), as a
                       ;; position: a goal that collects slides the cells
                       ;; below it down, and the wind-back below must land
                       ;; where they now end, not above it. The clause is not:
                       ;; coco_directive registers the goal it names in a
                       ;; failure's message, and the one read of the clause
                       ;; here -- the message for a `use_module' that loaded
                       ;; nothing -- follows a directive that runs no goal.
                       ;; Unregistered, the goal runs as it did, collecting
                       ;; nothing.
                       (if (and (== handled 0) active)
                           (let ((size_t * mp . nil) (size_t ml . 1) (int pushed . 0) (int dr . 0)
                                 (const char * sfile . #'(-> m sloc_file))
                                 (int sline . #'(-> m sloc_line)))
                             (set mp (aof mark))
                             (set pushed (coco_heap_pos_push m (aof mp) (aof ml)))
                             (set (-> m dgc) (? pushed vouch 0))
                             ;; source_location/2 answers the directive's file
                             ;; and line while its goal runs (2.16.0)
                             (set (-> m sloc_file) origin)
                             (set (-> m sloc_line) at)
                             (set dr (coco_directive st m (coco_arg m t 0) (aof inits) at err errlen))
                             (set (-> m sloc_file) sfile)
                             (set (-> m sloc_line) sline)
                             (set (-> m dgc) 0)
                             (if pushed (coco_heap_root_pop m))
                             (if (== dr 2) (coco_load_message "Warning" origin at err))
                             (if (== dr 0) (coco_load_message "ERROR" origin at err))
                             ;; and where it was raised, when its goal raised
                             ;; it (1.10.17): `lb_goal_hook' keeps the lines
                             ;; then and only then
                             (coco_bt_say m (== dr 0))
                             ;; BOTH, IN SWI'S ORDER: why nothing was loaded,
                             ;; then that the directive failed, named
                             (if (== dr 3)
                                 (let ((coco_strbuf b))
                                   (coco_load_message "ERROR" origin at err)
                                   (coco_sb_init (aof b))
                                   (coco_write_term m (aof b) (coco_deref m (coco_arg m t 0)) 1 0)
                                   (snprintf err errlen "Goal (directive) failed: %s"
                                             (? (== ($ b s) nil) "?" ($ b s)))
                                   (coco_sb_free (aof b))
                                   (coco_load_message "Warning" origin at err)))))
                      (set (-> m heap_len) mark))
                   (block
                    (if active
                        (block
                         ;; A CLAUSE THE STORE CAN EXPLAIN REFUSING IS
                         ;; REPORTED AND THE LOAD GOES ON, the way a directive
                         ;; that failed does -- a syntax error is still the
                         ;; only thing that ends a consult, because after one
                         ;; the reader does not know where the next clause
                         ;; begins, and this reader does. The rest of the file
                         ;; is not the refused clause's fault, and losing it
                         ;; is how ONE clause over the row limit came to empty
                         ;; a whole predicate.
                         (if (not (coco_assert_from st m t 1 oid seen))
                             (if (!= (nth 0 (-> st assert_err)) (cast char 0))
                                 (block (snprintf err errlen "%s" (-> st assert_err))
                                        (coco_load_message "ERROR" origin at err)
                                        (set (nth 0 err) (cast char 0)))
                               (block (snprintf err errlen "not a clause")
                                      (coco_consult_where err errlen origin at)
                                      (coco_reader_free (aof r))
                                      (return -1)))
                           (set n (+ n 1)))))
                    (set (-> m heap_len) mark))))))
          ;; A SYNTAX ERROR IS PLACED AS SWI PLACES IT (1.11.9): the file,
          ;; the line from 1 and the column from 0 (in bytes, as swipl's) of
          ;; the token the reader failed at, and the reason. Through 1.11.8 this said
          ;; `syntax error at offset N', N a byte offset into the file, and a
          ;; module's load said nothing at all of where or why.
          (if (== rc -1)
              (let ((int eline . 1) (int ecol . 0)
                    (const char * why . #'(? (== ($ r ewhat) nil) "unreadable" ($ r ewhat))))
                (coco_reader_place (aof r) (aof eline) (aof ecol))
                (if (!= origin nil)
                    (snprintf err errlen "%s:%d:%d: Syntax error: %s" origin eline ecol why)
                  (snprintf err errlen "line %d, column %d: Syntax error: %s" eline ecol why))
                (coco_inits_free (aof inits))
                (coco_reader_free (aof r))
                (return -1)))
          (coco_reader_free (aof r))

          ;; ---- and now the goals the file put off ------------------------
          ;;
          ;; IN THE ORDER THEY WERE WRITTEN, each one read back out of the
          ;; store on to a heap that is wound again after it: an
          ;; initialization goal is a goal, not a clause, and nothing it
          ;; leaves on the heap is wanted once it has answered.
          (let ((int halt_after . 0) (int halt_code . 0))
            (for ((size_t i . 0)) (< i ($ inits len)) ((++ i))
              (let ((size_t back . #'(-> m heap_len))
                    (int code . 0))
                (if (== coco_goal_hook nil)
                    (block (coco_load_note "ERROR" origin (nth i ($ inits lines))
                                           "initialization: there is no engine over this store")
                           (set code 2))
                  (let ((size_t span . 0)
                        (size_t goal . #'(coco_store_get_span m st (nth i ($ inits cells)) (aof span)))
                        (int gr . 0) (int main . #'(? (== (nth i ($ inits modes)) 1) 1 0)))
                    ;; fetched, the goal's cells are orphans
                    (set (-> st dead) (+ (-> st dead) span))
                    ;; THE `main' GOAL IS THE PROGRAM, NOT PART OF THE LOAD,
                    ;; so it writes through even when the file is a module
                    ;; -- and `-s FILE' makes it one, whose load is muted. It
                    ;; stands where `-s' would have called main, whose writes
                    ;; reach the knowledge base; muted, G's stayed in this
                    ;; process and ended with it.
                    ;; and it may collect, with the mark it is wound back to
                    ;; registered -- nothing else of the heap is read after
                    (let ((int was . #'(-> st muted)) (size_t * bp . nil) (size_t bl . 1)
                          (int pushed . 0))
                      (set bp (aof back))
                      (set pushed (coco_heap_pos_push m (aof bp) (aof bl)))
                      (if main (set (-> st muted) 0))
                      (set (-> m dgc) (? pushed vouch 0))
                      (set gr (coco_goal_hook st m goal err errlen))
                      (set (-> m dgc) 0)
                      (if pushed (coco_heap_root_pop m))
                      (set (-> st muted) was))
                    ;; SWI'S TWO VOICES, measured: an `after_load' goal that
                    ;; fails is a Warning and the program carries on, while a
                    ;; `main' one that fails is an ERROR and the exit status
                    ;; -- because there it IS the program.
                    (cond
                      ((== gr 1) (set code 0))
                      ((== gr 0)
                       (block (coco_load_note (? main "ERROR" "Warning")
                                              origin (nth i ($ inits lines))
                                              (? main "main: false"
                                                 "Initialization goal failed"))
                              (set code 1)))
                      ;; FLUSH, NOT INDENTED, on the second line. SWI's
                      ;; four-space indent belongs to the DIRECTIVE message
                      ;; -- `coco_load_message' keeps it because that is
                      ;; where swipl writes it -- but the slot after
                      ;; `ERROR:' in an initialization report is the one
                      ;; swipl fills with its thread tag and the context of
                      ;; the throw, and cocolog has neither. Indenting into
                      ;; an empty slot was the last thing between the two
                      ;; messages: they are word for word now.
                      (#t (block (coco_load_note "ERROR" origin (nth i ($ inits lines))
                                                 (? main "main: raised exception:"
                                                    "Initialization goal raised exception:"))
                                 (fprintf stderr "ERROR: %s\n" err)
                                 (set code 2))))
                    ;; where it was raised, as a directive's (1.10.17)
                    (coco_bt_say m (and (!= gr 1) (!= gr 0)))))
                (if (== (nth i ($ inits modes)) 1)
                    (block (set halt_after 1) (set halt_code code)))
                (set (-> m heap_len) back)))
            (coco_inits_free (aof inits))
            ;; `initialization(G, main)' MAKES G THE PROGRAM, and SWI halts
            ;; when it is done -- 0 proved, 1 failed, 2 threw, which are the
            ;; three answers `swipl -g' ends with as well. Anything the
            ;; process was going to do next, including the goal the CLI was
            ;; given, is not done: that is the point of the word `main'. What
            ;; the run wrote is finished as the CLI finishes its own goal's:
            ;; committed when G proved or failed, rolled back when it threw.
            (if halt_after
                (coco_halt_load st halt_code (? (== halt_code 2) 0 1))))
          (return n)))

  (func coco_retract ((coco_store * st) (coco_machine * m) (size_t clause)) (out int)
        (set clause (coco_deref m clause))
        (let ((size_t head . clause) (size_t body . 0) (int has_body . 0))
          (if (and (coco_is_callable m clause) (== (coco_arity m clause) 2))
              (if (== 0 (strcmp (coco_atom_name m (coco_name_of m clause)) ":-"))
                  (block (set head (coco_deref m (coco_arg m clause 0)))
                         (set body (coco_arg m clause 1))
                         (set has_body 1))))
          (if (not (coco_is_callable m head)) (return 0))
          ;; INTERNED, not merely found. `retract' is a builtin, so its argument
          ;; is never solved as a goal and nothing has put the predicate in the
          ;; store; with `coco_pred_find' a fresh interpreter's first `retract'
          ;; failed against a knowledge base that plainly had the clause.
          ;; Interning is what makes `coco_pred_ensure' below able to ask.
          (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m head)
                                               (coco_arity m head))))
            (if (>= pi (-> st npreds)) (return 0))
            ;; a predicate that could not be read is not written either
            ;; (`coco_assert_from' says why): -1, and nothing is taken
            (if (not (coco_pred_ensure st pi)) (return -1))
            (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
                  ;; the head's first-argument key, the same cell the index keeps
                  ;; per clause: two different non-zero keys cannot unify, so a
                  ;; candidate with the wrong one is skipped BEFORE it is copied
                  (u64 hkey . #'(coco_arg_key m head)))
              (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
                ;; WITHOUT THIS, RETRACT WAS QUADRATIC WITH A LARGE CONSTANT: every
                ;; candidate was copied whole on to the heap and then unified, so
                ;; 2 999 retracts by key over 3 000 clauses of 16 KB copied some
                ;; thirty-six billion cells -- 153 s, measured -- for work the
                ;; key decides in one comparison
                (if (and (!= hkey 0) (!= (nth i (-> p keys)) 0)
                         (!= hkey (nth i (-> p keys))))
                    continue)
                ;; a clause that died under an open call is retracted already
                (if (coco_pred_dead p i) continue)
                (let ((size_t mark . #'(-> m heap_len))
                      (size_t tmark . #'(-> m trail_len))
                      ;; SPAN is the clause's cells in the store, which the
                      ;; copy's length is not (`coco_store_get_span')
                      (size_t span . 0)
                      (size_t cand . #'(coco_store_get_span m st (nth i (-> p clauses)) (aof span)))
                      (size_t chead . 0) (size_t cbody . 0) (int ok . 0))
                  ;; the candidate arrives as a fresh copy, so unifying against
                  ;; it cannot bind anything in the store
                  (set chead cand)
                  (if (and (coco_is_callable m cand) (== (coco_arity m cand) 2))
                      (if (== 0 (strcmp (coco_atom_name m (coco_name_of m cand)) ":-"))
                          (block (set chead (coco_arg m cand 0))
                                 (set cbody (coco_arg m cand 1)))))
                  (set ok (coco_unify m head chead))
                  ;; THE BODY ALWAYS CONSTRAINS -- SWI's rule, and the bug a
                  ;; CivV capture paid to find: the shorthand `retract(F)' IS
                  ;; `retract((F :- true))', and a stored FACT's body IS the
                  ;; atom `true'. The old code skipped the body check entirely
                  ;; for the shorthand -- so it pulled a same-headed RULE out
                  ;; from over the facts -- and refused every fact in the
                  ;; explicit form, so `retract((f(x) :- true))' failed
                  ;; against a base that plainly held f(x). One `true' atom on
                  ;; the heap (clause/2's own trick, builtins.cicili) makes
                  ;; the two forms one rule: the asked body unifies against
                  ;; the candidate's, a missing side standing in as `true'.
                  ;; The atoms are re-made each round because a mismatch winds
                  ;; the heap back to the mark below.
                  (if ok
                      (block
                       (if (== cbody 0) (set cbody (coco_new_atom m "true")))
                       (if (== has_body 0) (set body (coco_new_atom m "true")))
                       (set ok (coco_unify m body cbody))))
                  (if ok
                      (block
                       ;; THE LOGICAL UPDATE VIEW: with a call open on the
                       ;; predicate the clause dies where it stands, for the
                       ;; calls open now to try still and no later call to
                       ;; see (`coco_tomb_set'); the database loses it now
                       (let ((u32 era . #'(coco_tomb_open st m pi)))
                         (if (!= era 0)
                             (block
                               (coco_tomb_set p i era)
                               (set (-> p dynamic) 1)
                               (if (and (not (coco_store_is_muted st))
                                        (!= (-> st on_retract) nil))
                                   ((-> st on_retract) st (-> st ctx) pi))
                               (return 1))))
                       ;; none open, and the dead of an earlier change go with it
                       (if (!= (-> p ntomb) 0)
                           (block
                            (coco_tomb_set p i 1)
                            (coco_pred_sweep st m pi)
                            (set (-> p dynamic) 1)
                            (if (and (not (coco_store_is_muted st))
                                     (!= (-> st on_retract) nil))
                                ((-> st on_retract) st (-> st ctx) pi))
                            (return 1)))
                       ;; drop it from the predicate; the cells are orphaned
                       ;; until the next compaction (`coco_store_compact'),
                       ;; and its compiled program goes now
                       (set (-> st dead) (+ (-> st dead) span))
                       (coco_code_drop st (nth i (-> p clauses)))
                       (set (nth i (-> p codes)) nil)
                       ;; The index keys shift with them, and the chains --
                       ;; which hold POSITIONS -- are dropped: everything
                       ;; after this clause has just been renumbered.
                       (for ((size_t j . i)) (< (+ j 1) (-> p nclauses)) ((++ j))
                         (set (nth j (-> p clauses)) (nth (+ j 1) (-> p clauses)))
                         (set (nth j (-> p keys)) (nth (+ j 1) (-> p keys)))
                         (set (nth j (-> p origins)) (nth (+ j 1) (-> p origins)))
                         (set (nth j (-> p muted)) (nth (+ j 1) (-> p muted)))
                         (set (nth j (-> p codes)) (nth (+ j 1) (-> p codes))))
                       (set (-> p nclauses) (- (-> p nclauses) 1))
                       (coco_pred_nprobe p)
                       (set (-> p tver) (+ (-> p tver) 1))
                       (coco_pred_unindex p)
                       ;; anything retractable is dynamic by definition, whether
                       ;; or not anybody said so
                       (set (-> p dynamic) 1)
                       ;; and the database is told. NOTHING IS WOUND BACK HERE:
                       ;; the whole point of `retract(counter(X))' is that X is
                       ;; left bound to what was retracted, and the term it is
                       ;; bound into is the copy this loop made on the heap. The
                       ;; hook keeps its own heap use to itself.
                       (if (and (not (coco_store_is_muted st))
                                (!= (-> st on_retract) nil))
                           ((-> st on_retract) st (-> st ctx) pi))
                       (return 1)))
                  (coco_undo_to m tmark)
                  (set (-> m heap_len) mark))))
            (return 0))))

  ) ; impl-kb

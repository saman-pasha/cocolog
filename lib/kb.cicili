;;;; cocolog -- the knowledge base
;;;
;;; A CLAUSE DOES NOT LIVE ON THE HEAP, and it cannot. The heap is truncated on
;;; every backtrack -- that is how a failed branch's terms are reclaimed -- so
;;; anything stored there would be reclaimed along with the branch that
;;; asserted it. Clauses live in a store of their own, which only ever grows,
;;; and are COPIED into the heap with fresh variables each time one is used.
;;; That copy is not an optimisation to be removed later: it is what lets the
;;; same clause be in use at two depths of the same proof at once.
;;;
;;; THE STORE IS THE SEAM THE DATABASE FITS INTO. A predicate that the store
;;; does not have is not immediately a failure -- the store first asks its
;;; `fetch' hook, which is null for a purely local machine and, for a machine
;;; backed by Zigurat, goes and reads the clauses out of a table. Everything
;;; above this file is written against the store and knows nothing about where
;;; clauses come from; everything below it is one function pointer.
;;;
;;; So the three arrangements the project needs are the same code with a
;;; different hook: a standalone interpreter (no hook), an interpreter sharing
;;; a knowledge base over the binary protocol, and one sharing it over Zeytun's
;;; HTTP pages.
;;;
;;; WHY CLAUSES GO INTO THE DATABASE AS TEXT. The obvious alternative is to
;;; store the cells, which would load faster. Text wins on three counts that
;;; matter more: a person can read the table, a Parsi procedure can search it
;;; with an ordinary LIKE, and it does not tie the schema to the cell encoding
;;; -- change a tag and every clause already in the database still loads. The
;;; MACHINE state is stored as cells, because nobody reads that by hand and it
;;; has to come back exactly.
;;;
;;; THIS FILE IS THE FIRST OF FOUR (2.16.1, when it had reached 8 080 lines):
;;; the compiler's tables and macros, every declaration, and the store's
;;; first part -- the messages a load can produce, the goals a file puts off,
;;; and moving terms between the heap and the store. The rest are one
;;; translation unit with it, emitted in this order by cocolog.cicili and by
;;; the test binaries that link the store: kb-compile.cicili (compiled
;;; clauses, the guards, the environments), kb-pred.cicili (reclaiming the
;;; store, predicates, asserting, the indexes, the logical update view) and
;;; kb-consult.cicili (a re-read in swipl's order, assert, consult, retract).
;;; A function calls only what an earlier piece defined or `decl-kb'
;;; declared, as when they were one file.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;; THE ONE SHAPE OF A STORE WRITE: begin the green barrier, let the body run,
;;; and release it on every exit, including a failed return. The `defer'
;;; attribute is what makes the second half true; spelling it at each call
;;; site was fifteen copies of the same three lines.
(DEFMACRO with-green-write (e &REST body)
  `(let ((defer () coco_g_write_end_cleanup)
         (int began . #'(coco_g_write_begin ,e)))
     ,@body))

;;; THE CLAUSE COMPILER'S OPCODES, one table read two ways -- the `cc_NAME'
;;; functions the compiler calls (emitted beside it), and `(cc-op "NAME")',
;;; a number at expansion time, for a `case' label in the executor's switch,
;;; which must be a constant. Nothing else may spell an opcode's number.
(DEFPARAMETER *cc-ops*
  '(("GET_VAR" 1)
    ("GET_VAL" 2)
    ("GET_CONST" 3)
    ("GET_STRUCT" 4)
    ("GET_STRUCT_T" 5)
    ("UNIFY_VAR" 6)
    ("UNIFY_VAL" 7)
    ("UNIFY_CONST" 8)
    ("GOAL_STRUCT" 20)
    ("GOAL_ATOM" 21)
    ("GOAL_VAR" 22)
    ("GOAL_VAR_1" 23)
    ("ARG_CONST" 24)
    ("ARG_VAR" 25)
    ("ARG_VAR_1" 26)
    ("ARG_STRUCT" 27)
    ;; the first goal of a body, written into the engine's argument
    ;; registers instead of built as a term (`coco_code', `rbody')
    ("RGOAL" 28)
    ("RARG_CONST" 29)
    ("RARG_VAR" 30)
    ("RARG_VAR_1" 31)
    ("RARG_STRUCT" 32)
    ;; the arithmetic and type tests a body starts with, evaluated when the
    ;; clause is entered (`coco_code', `gbody'): a stack of integers
    ("AG_LOAD" 33)
    ("AG_PUSH" 34)
    ("AG_BIN" 35)
    ("AG_UN" 36)
    ("AG_CMP" 37)
    ("AG_ISF" 38)
    ("AG_ISV" 39)
    ("AG_ISC" 40)
    ("AG_TYPE" 41)
    ;; a body's later goals at entry when it makes an environment (Stage 5,
    ;; `xbody'): a fresh variable for a call's first-met variable, which
    ;; the call builds no term to hold
    ("FRESH" 42)
    ;; a guard in place whose two operands are each a slot or a constant,
    ;; as one word and its two operands (`cc_ufuse', `coco_env_guardx'):
    ;; `X is A op B' over `+', `-' and `*', and the six comparisons
    ("AG_ISX" 43)
    ("AG_CMPX" 44)))

;;; A GUARD'S OPERATORS AND TESTS, by the code in an AG_BIN, AG_UN, AG_CMP or
;;; AG_TYPE word's K. One table read two ways again: the compiler matches a
;;; functor's name against the first column (`cc_guard_code'), and the
;;; executor's `case' labels are `(cc-gop "NAME")'. Three of the names end
;;; or are written with a backslash, which a Cicili string literal cannot
;;; carry, so they are named here by a word and matched by their codes
;;; (`cc_guard_code').
(DEFPARAMETER *cc-gops*
  '(;; binary, integers in and out, each as `coco_arith_binary' computes it
    ("+" 1) ("-" 2) ("*" 3) ("//" 4) ("div" 5) ("mod" 6) ("rem" 7)
    ("min" 8) ("max" 9) (">>" 10) ("<<" 11) ("bitand" 12) ("bitor" 13) ("xor" 14)
    ;; unary
    ("neg" 20) ("pos" 21) ("bitnot" 22) ("abs" 23) ("sign" 24)
    ;; the six comparisons
    ("<" 30) (">" 31) ("=<" 32) (">=" 33) ("=:=" 34) ("numneq" 35)
    ;; the type tests
    ("var" 40) ("nonvar" 41) ("atom" 42) ("integer" 43) ("number" 44)
    ("atomic" 45) ("compound" 46)))

(DEFUN cc-gop-number (name)
  (LET ((row (ASSOC name *cc-gops* :TEST #'STRING=)))
    (UNLESS row (ERROR "cocolog: no guard operator ~S" name))
    (SECOND row)))

(DEFMACRO cc-gop (name) (cc-gop-number name))

;;; HOW THE STEP REACHES ONE UNIT OF A BODY RUN FROM AN ENVIRONMENT (Stages
;;; 5 and 6, `coco_egoal'), by the number in its KIND. A unit is what one
;;; `'$k'' frame held through 1.9.2: a goal built at entry and dispatched
;;; (TERM), its arguments written into the registers and its predicate
;;; tried from them (CALL), a cut (CUT); and since Stage 6 a control
;;; construct as positions in the code -- an if-then-else and the four
;;; written as one (ITE), a disjunction (DISJ), the cut after a condition
;;; (CUTC), a conjunction taken apart (CONJ), and the construct's own
;;; `true' and `fail' (TRUE, FAIL) -- each one step, as each was one goal.
;;; Since Stage 7 a core builtin is done where it stands: arithmetic and a
;;; type test as a guard over the slots (GUARD), `=/2', `==/2' and `\==/2'
;;; from two sides read out of the slots (SIDES), and any other with
;;; arguments called by its row with the term built at entry (BUILTIN).
;;; A guard whose program is one fused word (`cc_ufuse') is its own kind
;;; (GUARDX), so that a guard of several words asks nothing more for it.
(DEFPARAMETER *cc-eg-kinds* '(("TERM" 0) ("CALL" 1) ("CUT" 2) ("ITE" 3) ("DISJ" 4)
                              ("CUTC" 5) ("CONJ" 6) ("TRUE" 7) ("FAIL" 8)
                              ("GUARD" 9) ("SIDES" 10) ("BUILTIN" 11) ("GUARDX" 12)))

(DEFUN cc-eg-number (name)
  (LET ((row (ASSOC name *cc-eg-kinds* :TEST #'STRING=)))
    (UNLESS row (ERROR "cocolog: no later-goal kind ~S" name))
    (SECOND row)))

(DEFMACRO cc-eg (name) (cc-eg-number name))

;;; THE FRAME A GOAL RUNS IN, IN ITS BARRIER (3.1.0). The barrier a goal
;;; carries -- each `'$k'' frame's INT slot, the handed-over goal's `nbar',
;;; a choice frame's -- is a choice height in its low 32 bits and, above
;;; them, its OWNER: the functor id plus one of the predicate whose clause
;;; the goal is in (`ptag' of the clause's code, `tag' of an environment's
;;; unit; 25 bits from bit 32), as swipl's goal runs in that clause's frame.
;;; Bit 58 (SYS) says the owner is a frame of swipl's own -- `once/1',
;;; `ignore/1', `not/1', `call/N', `catch/3' and `'<meta-call>'/1', the
;;; clause swipl compiles a control structure it calls into -- and bit 57
;;; (META) that the goal was meta-called from its owner's clause (call/N
;;; there, or a goal that was a variable of the clause), which swipl runs
;;; in that frame, no last call. The step takes the low bits as the
;;; barrier (`coco-bar-low'); what an error names reads the rest
;;; (`coco_owner_ctx'). The word is under 2^59, so a frame's INT cell
;;; holds it whole, and a frozen machine keeps it.
(DEFMACRO coco-bar-low (x) `(bitand ,x 4294967295))
(DEFMACRO coco-bar-pred (x) `(bitand (>> ,x 32) 33554431))
(DEFMACRO coco-bar-meta (x) `(bitand (>> ,x 57) 1))
(DEFMACRO coco-bar-sys (x) `(bitand (>> ,x 58) 1))
(DEFMACRO coco-bar-tag (x) `(bitand ,x 576460748008456192))
;;; the two bits, and the owner FID's tag
(DEFMACRO coco-bar-metabit () `144115188075855872)
(DEFMACRO coco-bar-sysbit () `288230376151711744)
(DEFMACRO coco-bar-of (fid) `(<< (+ ,fid 1) 32))


;;; THE HEAD PROGRAM, WRITTEN ONCE AND RUN TWO WAYS: over a call that is a
;;; term, whose argument I is the cell after its header (`cc-arg-term'),
;;; and over a call that never was one, its arguments in the engine's
;;; registers (`cc-arg-reg', Stage 3 of compiled control). A macro rather
;;; than a branch per instruction, so neither way pays for the other.
(DEFMACRO cc-arg-term (I) `(+ call (+ ,I 1)))
(DEFMACRO cc-arg-reg (I) `(nth ,I args))
(DEFMACRO cc-head-program (ARGAT)
  `(while (and ok (< pc (-> cd hlen)))
     (let ((u64 w . #'(nth pc (-> cd head))))
       (set pc (+ pc 1))
       (switch (cast int (cc_op w))
         (case (cc-op "GET_VAR")
           (set (nth (cc_k w) frame) (coco_deref m (,ARGAT (cast size_t (cc_n w)))))
           break)
         (case (cc-op "GET_VAL")
           (if (not (coco_unify m (nth (cc_k w) frame) (,ARGAT (cast size_t (cc_n w)))))
               (set ok 0))
           break)
         (case (cc-op "GET_CONST")
           (let ((u64 c . #'(nth pc (-> cd head))))
             (set pc (+ pc 1))
             (if (not (cc_match_const m (coco_deref m (,ARGAT (cast size_t (cc_n w)))) c))
                 (set ok 0)))
           break)
         (case (cc-op "GET_STRUCT")
           ;; the argument index is in K, the arity in N
           (let ((u64 fid . #'(nth pc (-> cd head)))
                 (u32 n . #'(cast u32 (cc_n w)))
                 (size_t a . #'(coco_deref m (,ARGAT (cc_k w)))))
             (set pc (+ pc 1))
             (let ((u64 ca . #'(nth a (-> m heap))))
               (cond
                 ((coco-tag-is REF ca)
                  ;; WRITE: the structure is built and the variable bound to it
                  (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN fid) n)))
                    (coco_bind m a h)
                    (set S (+ h 1))
                    (set write 1)))
                 ((and (coco-tag-is FUN ca) (== (coco-payload ca) fid))
                  (set S (+ a 1))
                  (set write 0))
                 (#t (set ok 0)))))
           break)
         (case (cc-op "GET_STRUCT_T")
           ;; the temporary is in K, the arity in N
           (let ((u64 fid . #'(nth pc (-> cd head)))
                 (u32 n . #'(cast u32 (cc_n w)))
                 (size_t a . #'(coco_deref m (nth (cc_k w) frame))))
             (set pc (+ pc 1))
             (let ((u64 ca . #'(nth a (-> m heap))))
               (cond
                 ((coco-tag-is REF ca)
                  (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN fid) n)))
                    (coco_bind m a h)
                    (set S (+ h 1))
                    (set write 1)))
                 ((and (coco-tag-is FUN ca) (== (coco-payload ca) fid))
                  (set S (+ a 1))
                  (set write 0))
                 (#t (set ok 0)))))
           break)
         (case (cc-op "UNIFY_VAR")
           ;; write: the slot IS the variable, and is written as one
           (if write
               (block (set (nth S (-> m heap)) (coco-cell REF S))
                      (set (nth (cc_k w) frame) S))
               (set (nth (cc_k w) frame) (coco_deref m S)))
           (set S (+ S 1))
           break)
         (case (cc-op "UNIFY_VAL")
           (if write
               (coco_set_arg m S (coco_deref m (nth (cc_k w) frame)))
               (if (not (coco_unify m (nth (cc_k w) frame) S)) (set ok 0)))
           (set S (+ S 1))
           break)
         (case (cc-op "UNIFY_CONST")
           (let ((u64 c . #'(nth pc (-> cd head))))
             (set pc (+ pc 1))
             (if write
                 (coco_set_arg m S (coco_push m c))
                 (if (not (cc_match_const m (coco_deref m S) c)) (set ok 0)))
             (set S (+ S 1)))
           break)
         (default (set ok 0))))))

;;; THE BODY PROGRAM, WRITTEN ONCE AND RUN BY THREE EXECUTORS: the one for a
;;; clause entered with registers (`coco_clause_run_r', Stage 3), the one
;;; for a clause whose body starts with guards (`coco_clause_run_g',
;;; Stage 4) and the one for a body that makes an environment
;;; (`coco_clause_run_e', Stage 5). PROG is the program -- the body, or
;;; an environment's entry program (`xbody') -- START is where the goals
;;; to build begin and END where they stop, and REGSOK whether the first
;;; of them goes into the registers instead. A macro, as the head program
;;; is, so that no executor pays for another.
;;;
;;; EVERY GOAL IS ONE RESERVATION: its GOAL_STRUCT carries the cells the
;;; whole goal takes -- header, slots, every nested structure's and every
;;; constant's -- and reserves them in one growth check; the ARG words that
;;; follow carry the OFFSET from the goal's base of the slot they fill and
;;; of the cell they put there, settled when the clause was compiled, so
;;; each is a store or two with nothing to check and no stack of pending
;;; structures to keep (1.8.46; through 1.8.45 the executor walked a frame
;;; stack to find the next slot and grew the heap per structure, as the
;;; copy does).
;;;
;;; THE FIRST GOAL INTO THE REGISTERS (`rbody'): its own header and slots
;;; are never built, its arguments go to REGS, and what it nests is one
;;; reservation of its own (RGOAL, left out when there is nothing to
;;; reserve) -- then the body goes on from the goal after it (`rstart'). A
;;; LOOP OF ITS OWN, ahead of the body's: one loop over both programs paid a
;;; test for the switch from one to the other at every instruction, and the
;;; register form of `app(T, L, R)' cost more than building the term had.
;;; The ARG words of the register form are the body's own, offset from that
;;; reservation.
(DEFMACRO cc-body-program (PROG START END REGSOK)
  `(if (> (-> cd blen) 0)
      (let ((size_t ng . 0) (size_t h . 0) (u64 * prog . #',PROG))
        (set pc ,START)
        (if ,REGSOK
            (let ((u64 * rp . #'(-> cd rbody)) (size_t rn . #'(-> cd rblen)) (size_t rpc . 0))
              (while (and ok (< rpc rn))
                (let ((u64 w . #'(nth rpc rp)))
                  (set rpc (+ rpc 1))
                  (switch (cast int (cc_op w))
                    (case (cc-op "RARG_VAR")
                      ;; register N: frame[K]
                      (set (nth (cast size_t (cc_n w)) regs) (coco_deref m (nth (cc_k w) frame)))
                      break)
                    (case (cc-op "RGOAL")
                      ;; the arity in K, the cells it nests in N: one
                      ;; reservation, and no header
                      (let ((size_t total . #'(cast size_t (cc_n w))))
                        (set h (-> m heap_len))
                        (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                          (aof (-> m heap_cap)) (+ h total) (sizeof u64)))
                            (block (set ok 0) break))
                        (set (-> m heap_len) (+ h total)))
                      break)
                    (case (cc-op "RARG_CONST")
                      ;; register K: the constant, in cell N of the reservation
                      (let ((u64 c . #'(nth rpc rp))
                            (size_t at . #'(+ h (cast size_t (cc_n w)))))
                        (set rpc (+ rpc 1))
                        (set (nth at (-> m heap)) c)
                        (set (nth (cc_k w) regs) at))
                      break)
                    (case (cc-op "RARG_VAR_1")
                      ;; register N: a fresh variable in the cell the
                      ;; next word names, and frame[K] is it
                      (let ((size_t slot . #'(+ h (cast size_t (nth rpc rp)))))
                        (set rpc (+ rpc 1))
                        (set (nth slot (-> m heap)) (coco-cell REF slot))
                        (set (nth (cc_k w) frame) slot)
                        (set (nth (cast size_t (cc_n w)) regs) slot))
                      break)
                    (case (cc-op "RARG_STRUCT")
                      ;; register K: the structure whose header is cell N
                      (let ((u64 fid . #'(nth rpc rp))
                            (size_t at . #'(+ h (cast size_t (cc_n w)))))
                        (set rpc (+ rpc 1))
                        (set (nth at (-> m heap)) (coco-cell FUN fid))
                        (set (nth (cc_k w) regs) at))
                      break)
                    ;; what the goal nests, as the body's own words
                    (case (cc-op "ARG_CONST")
                      (let ((u64 c . #'(nth rpc rp))
                            (size_t at . #'(+ h (cast size_t (cc_n w)))))
                        (set rpc (+ rpc 1))
                        (set (nth at (-> m heap)) c)
                        (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                      break)
                    (case (cc-op "ARG_VAR")
                      (set (nth (+ h (cast size_t (cc_n w))) (-> m heap))
                           (coco-cell REF (coco_deref m (nth (cc_k w) frame))))
                      break)
                    (case (cc-op "ARG_VAR_1")
                      (let ((size_t slot . #'(+ h (cast size_t (cc_n w)))))
                        (set (nth slot (-> m heap)) (coco-cell REF slot))
                        (set (nth (cc_k w) frame) slot))
                      break)
                    (case (cc-op "ARG_STRUCT")
                      (let ((u64 fid . #'(nth rpc rp))
                            (size_t at . #'(+ h (cast size_t (cc_n w)))))
                        (set rpc (+ rpc 1))
                        (set (nth at (-> m heap)) (coco-cell FUN fid))
                        (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                      break)
                    (default (set ok 0)))))
              (set pc (-> cd rstart))))
        ;; the program's length is its end: no END word to dispatch
        (while (and ok (< pc ,END))
          (let ((u64 w . #'(nth pc prog)))
            (set pc (+ pc 1))
            (switch (cast int (cc_op w))
              (case (cc-op "GOAL_STRUCT")
                (let ((u64 fid . #'(nth pc prog))
                      (size_t total . #'(cast size_t (cc_n w))))
                  (set pc (+ pc 1))
                  (set h (-> m heap_len))
                  (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                    (aof (-> m heap_cap)) (+ h total) (sizeof u64)))
                      (block (set ok 0) break))
                  (set (-> m heap_len) (+ h total))
                  (set (nth h (-> m heap)) (coco-cell FUN fid))
                  (if (< ng 64) (block (set (nth ng goals) h) (set ng (+ ng 1)))))
                break)
              (case (cc-op "GOAL_ATOM")
                (let ((u64 c . #'(nth pc prog)))
                  (set pc (+ pc 1))
                  (if (< ng 64) (block (set (nth ng goals) (coco_push m c)) (set ng (+ ng 1)))))
                break)
              (case (cc-op "GOAL_VAR")
                (if (< ng 64) (block (set (nth ng goals) (coco_deref m (nth (cc_k w) frame)))
                                     (set ng (+ ng 1))))
                break)
              (case (cc-op "GOAL_VAR_1")
                (let ((size_t v . #'(coco_new_var m)))
                  (set (nth (cc_k w) frame) v)
                  (if (< ng 64) (block (set (nth ng goals) v) (set ng (+ ng 1)))))
                break)
              (case (cc-op "ARG_CONST")
                ;; the constant in its own cell, the slot pointing at it
                (let ((u64 c . #'(nth pc prog))
                      (size_t at . #'(+ h (cast size_t (cc_n w)))))
                  (set pc (+ pc 1))
                  (set (nth at (-> m heap)) c)
                  (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                break)
              (case (cc-op "ARG_VAR")
                (set (nth (+ h (cast size_t (cc_n w))) (-> m heap))
                     (coco-cell REF (coco_deref m (nth (cc_k w) frame))))
                break)
              (case (cc-op "ARG_VAR_1")
                ;; the slot IS the variable, and is written as one
                (let ((size_t slot . #'(+ h (cast size_t (cc_n w)))))
                  (set (nth slot (-> m heap)) (coco-cell REF slot))
                  (set (nth (cc_k w) frame) slot))
                break)
              (case (cc-op "ARG_STRUCT")
                ;; the header where the compiler placed it; its own
                ;; slots are filled by the words that follow
                (let ((u64 fid . #'(nth pc prog))
                      (size_t at . #'(+ h (cast size_t (cc_n w)))))
                  (set pc (+ pc 1))
                  (set (nth at (-> m heap)) (coco-cell FUN fid))
                  (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                break)
              (case (cc-op "FRESH")
                ;; frame[K] a fresh variable, and no goal: only an
                ;; environment's entry program has these
                (set (nth (cc_k w) frame) (coco_new_var m))
                break)
              (default (set ok 0)))))
        (set (cof ngoals) ng)))
)

;;; AN ENVIRONMENT (Stage 5) is the compound `'$e'(Code, Parent, Barrier,
;;; V1 ... Vn, T1 ... Tm, S1 ... Sj, P1 ... Pk)' at ENV: its code an
;;; integer, the address, which the collector does not follow; the
;;; continuation its body returns to; the barrier its goals cut to; a slot
;;; per variable its later calls read and one per unit built at entry as a
;;; term; a condition slot per if-then-else (Stage 6), the height its
;;; choice went in at, written by its step; and a POS cell for each unit,
;;; the I'th, from 1, saying how far back the header is (over bit 16) and I
;;; (under it). A continuation that names a POS cell is that environment
;;; about to reach that unit, and needs no field of its own anywhere: a
;;; `'$k'' frame's rest, a choice frame, the engine's `goals', the parent
;;; of another environment each hold it in the one cell they always had.
(DEFMACRO coco-env-code (m env)
  `(cast (coco_code *) (cast size_t (coco-signed-payload (nth (+ ,env 1) (-> ,m heap))))))
(DEFMACRO coco-env-barrier (m env)
  `(cast size_t (coco-signed-payload (nth (+ ,env 3) (-> ,m heap)))))
;;; condition slot S's cell, and unit U's position, in the environment at
;;; ENV whose code is CD
(DEFMACRO coco-env-slot-at (env cd s)
  `(+ ,env (+ (+ (+ (cast size_t (-> ,cd nes)) (cast size_t (-> ,cd nterm))) 4) (cast size_t ,s))))
(DEFMACRO coco-env-pos (env cd u)
  `(+ ,env (+ (+ (+ (+ (cast size_t (-> ,cd nes)) (cast size_t (-> ,cd nterm)))
                    (cast size_t (-> ,cd nslot))) 3) (cast size_t ,u))))

;;; AN ENVIRONMENT'S SLOT K: the variable a later call reads where the body
;;; program read the frame. EB is the first slot's cell, four after the
;;; header. Dereferenced for the registers (`coco_env_regs'), as the body
;;; program writes them; ONE LINK for a term (`coco_env_term'), which is
;;; then the term entering the clause would have built -- its argument the
;;; variable as it stood at entry, not what it is bound to now, which is
;;; what a freeze needs of a goal a choice frame will come back to.
(DEFMACRO cc-env-slot (K) `(coco_deref m (+ eb (cast size_t ,K))))
(DEFMACRO cc-env-slot1 (K) `(cast size_t (coco-payload (nth (+ eb (cast size_t ,K)) (-> m heap)))))

;;; THE LATER GOALS AT ENTRY, AND THE ENVIRONMENT (Stage 5): the entry
;;; program over the frame -- each later goal that is a term built as it
;;; always was, its root kept, and each variable a later call meets first
;;; made, all in goal order -- then the environment in ONE reservation:
;;; its header, its code, the continuation the body returns to and its
;;; goals' barrier (ER), a slot per variable the calls read (each the
;;; frame's, `einit'), one per term, and the positions. ER answers the
;;; first position, the continuation after the first goal. The entry
;;; program runs the body program's own words, its roots collected in
;;; TROOTS where the body's go to GOALS.
(DEFMACRO cc-env-entry ()
  `(let ((size_t troots [64]) (size_t nt . 0))
     (let ((size_t * goals . troots) (size_t * ngoals . #'(aof nt)))
       (cc-body-program (-> cd xbody) 0 (-> cd xblen) 0))
     (if ok
         (let ((size_t nes . #'(cast size_t (-> cd nes)))
               (size_t ntm . #'(cast size_t (-> cd nterm)))
               (size_t nsl . #'(cast size_t (-> cd nslot)))
               (size_t npos . #'(cast size_t (-> cd nunit)))
               (size_t eh . #'(-> m heap_len))
               (size_t ps . 0))
           ;; the first position's distance from the header
           (set ps (+ (+ (+ nes ntm) nsl) 4))
           (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                               (aof (-> m heap_cap)) (+ eh (+ ps npos)) (sizeof u64)))
               (set ok 0)
               (block
                (set (-> m heap_len) (+ eh (+ ps npos)))
                (set (nth eh (-> m heap)) (coco-cell FUN (-> cd efid)))
                (set (nth (+ eh 1) (-> m heap)) (coco-int-cell (cast i64 (cast size_t cd))))
                (set (nth (+ eh 2) (-> m heap)) (coco-cell REF (coco_deref m (-> er parent))))
                (set (nth (+ eh 3) (-> m heap)) (coco-int-cell (cast i64 (-> er barrier))))
                (for ((size_t s . 0)) (< s nes) ((++ s))
                  (set (nth (+ eh (+ s 4)) (-> m heap))
                       (coco-cell REF (coco_deref m (nth (cast size_t (nth s (-> cd einit))) frame)))))
                (for ((size_t s . 0)) (< s ntm) ((++ s))
                  (set (nth (+ eh (+ nes (+ s 4))) (-> m heap))
                       (coco-cell REF (coco_deref m (nth s troots)))))
                ;; the condition slots and the positions, alike in every
                ;; environment of this code: one block (`etmpl')
                (memcpy (cast (void *) (aof (nth (+ eh (+ (+ nes ntm) 4)) (-> m heap))))
                        (cast (const void *) (-> cd etmpl)) (* (+ nsl npos) (sizeof u64)))
                (set (-> cd envd) 1)
                (set (-> er next) (+ eh (+ ps (- (cast size_t (-> cd eu0)) 1))))))))))

;;; THE GUARDS' RUNNER, WRITTEN ONCE AND EMITTED THREE TIMES (Stage 6): the
;;; body of `cc_guards_run', for the guards' own executor, and of
;;; `cc_guards_run_e', for the one that makes an environment after them,
;;; each a static function with one caller, which the compiler keeps
;;; inline there; and since Stage 7 of `coco_env_guard', for one goal of an
;;; environment. One function called from two executors became a call of
;;; its own, and cost the counting loop 6 instructions a turn (Stage 5's
;;; first form). The body and not the function, because an attribute
;;; written before a macro that makes a function does not reach it: the
;;; two came out with `(static)' lost, and called.
;;;
;;; RUNS THE GUARDS (PROG, LEN words of it), at most BUDGET goals of them,
;;; over the variables VARAT reaches by number: the frame the head filled
;;; (`cc-frame-var'), or an environment's slots (`cc-env-slot', ENV 1,
;;; whose programs have no AG_ISF: a variable a guard there meets first
;;; was made with the environment, and is bound by AG_ISV). Answers how
;;; many ran to the end; FAILED is set when the next one failed -- the
;;; clause fails, its bindings left for the caller's marks. A goal this
;;; cannot decide -- a variable not bound to an integer, a zero divisor,
;;; anything the step would raise for or answer a float to -- stops the
;;; run BEFORE it has done anything, and that goal and the rest are built
;;; and stepped as they always were.
;;; Every value is computed with the C `coco_arith' uses for it, and a
;;; result is compared with or bound to the left of an `is' as the cell
;;; `coco_new_int' makes of it, which is what `coco_unify' compares.
(DEFMACRO cc-frame-var (K) `(coco_deref m (nth ,K frame)))
(DEFMACRO cc-guards-body (PROG LEN VARAT ENV)
  `      (let ((i64 sk [16]) (u32 sp . 0) (u32 done . 0) (size_t pc . 0)
            (u64 * p . #',PROG) (size_t len . #',LEN))
        (set (cof failed) 0)
        (if (== budget 0) (return 0))
        (while (< pc len)
          (let ((u64 w . #'(nth pc p)) (int fin . 0) (int pass . 1))
            (set pc (+ pc 1))
            (switch (cast int (cc_op w))
              (case (cc-op "AG_LOAD")
                (let ((u64 c . #'(nth (,VARAT (cc_k w)) (-> m heap))))
                  (if (not (coco-tag-is INT c)) (return done))
                  (set (nth sp sk) (coco-signed-payload c))
                  (set sp (+ sp 1)))
                break)
              (case (cc-op "AG_PUSH")
                (set (nth sp sk) (coco-signed-payload (nth pc p)))
                (set pc (+ pc 1))
                (set sp (+ sp 1))
                break)
              (case (cc-op "AG_BIN")
                (let ((i64 a . #'(nth (- sp 2) sk)) (i64 b . #'(nth (- sp 1) sk)) (i64 r . 0)
                      (int ovf . 0))
                  (switch (cast int (cc_k w))
                    ;; in 64 bits, and a result past them is the step's to
                    ;; raise (2.0.0: evaluation_error(int_overflow))
                    (case (cc-gop "+") (if (coco_add_ovf a b (aof r)) (return done)) break)
                    (case (cc-gop "-") (if (coco_sub_ovf a b (aof r)) (return done)) break)
                    (case (cc-gop "*") (if (coco_mul_ovf a b (aof r)) (return done)) break)
                    ;; the least integer over -1 is past 64 bits, and in C
                    ;; traps (SIGFPE), as its remainder does: asked first
                    (case (cc-gop "//")
                      (if (== b 0) (return done))
                      (if (== b -1)
                          (block (if (== a (- -9223372036854775807 1)) (return done))
                                 (set r (- 0 a)) break))
                      (set r (/ a b)) break)
                    (case (cc-gop "div")
                      (if (== b 0) (return done))
                      (if (== b -1)
                          (block (if (== a (- -9223372036854775807 1)) (return done))
                                 (set r (- 0 a)) break))
                      (set r (- (/ a b) (cc_floor_adjusts a b))) break)
                    (case (cc-gop "mod")
                      (if (== b 0) (return done))
                      (if (== b -1) (block (set r 0) break))
                      (set r (+ (% a b) (? (cc_floor_adjusts a b) b 0))) break)
                    (case (cc-gop "rem")
                      (if (== b 0) (return done))
                      (if (== b -1) (block (set r 0) break))
                      (set r (% a b)) break)
                    (case (cc-gop "min") (set r (? (< a b) a b)) break)
                    (case (cc-gop "max") (set r (? (> a b) a b)) break)
                    ;; by any count, as `coco_arith' does (1.14.0): a C shift
                    ;; is undefined past 63 and for a negative count, and the
                    ;; hardware takes the count modulo 64; a bit lost to the
                    ;; left is the step's to raise (2.0.0)
                    (case (cc-gop ">>")
                      (set r (coco_shift_right a b (aof ovf)))
                      (if ovf (return done)) break)
                    (case (cc-gop "<<")
                      (set r (coco_shift_left a b (aof ovf)))
                      (if ovf (return done)) break)
                    (case (cc-gop "bitand") (set r (bitand a b)) break)
                    (case (cc-gop "bitor") (set r (bitor a b)) break)
                    (case (cc-gop "xor") (set r (xor a b)) break)
                    (default (return done)))
                  (set sp (- sp 1))
                  (set (nth (- sp 1) sk) r))
                break)
              (case (cc-op "AG_UN")
                (let ((i64 a . #'(nth (- sp 1) sk)) (i64 r . 0))
                  (switch (cast int (cc_k w))
                    ;; the least integer has no negation in 64 bits: the
                    ;; step raises (2.0.0)
                    (case (cc-gop "neg")
                      (if (== a (- -9223372036854775807 1)) (return done))
                      (set r (- 0 a)) break)
                    (case (cc-gop "pos") (set r a) break)
                    (case (cc-gop "bitnot") (set r (- -1 a)) break)
                    (case (cc-gop "abs")
                      (if (== a (- -9223372036854775807 1)) (return done))
                      (set r (? (< a 0) (- 0 a) a)) break)
                    (case (cc-gop "sign") (set r (? (> a 0) 1 (? (< a 0) -1 0))) break)
                    (default (return done)))
                  (set (nth (- sp 1) sk) r))
                break)
              (case (cc-op "AG_CMP")
                (let ((i64 a . #'(nth (- sp 2) sk)) (i64 b . #'(nth (- sp 1) sk)))
                  (set sp (- sp 2))
                  (switch (cast int (cc_k w))
                    (case (cc-gop "<") (set pass (< a b)) break)
                    (case (cc-gop ">") (set pass (> a b)) break)
                    (case (cc-gop "=<") (set pass (<= a b)) break)
                    (case (cc-gop ">=") (set pass (>= a b)) break)
                    (case (cc-gop "=:=") (set pass (== a b)) break)
                    (case (cc-gop "numneq") (set pass (!= a b)) break)
                    (default (return done))))
                (set fin 1)
                break)
              ;; A RESULT THE 60 BITS OF A CELL CANNOT HOLD IS THE STEP'S TO
              ;; BOX (2.0.0): the guard stops before it has bound or compared
              ;; anything, and makes no call that boxing would cost every
              ;; guard's registers
              (case (cc-op "AG_ISF")
                ;; met first here: the frame slot IS the result
                ,@(COPY-TREE
                   (IF (EQL ENV 1)
                       '((return done))
                       '((set sp (- sp 1))
                         (if (not (coco-fits-cell (nth sp sk))) (return done))
                         (set (nth (cc_k w) frame) (coco_push m (coco-int-cell (nth sp sk))))
                         (set fin 1)
                         break))))
              (case (cc-op "AG_ISV")
                ;; met before: bound to the result, or compared with it
                (let ((size_t v . #'(,VARAT (cc_k w))) (u64 c . 0))
                  (set sp (- sp 1))
                  (if (not (coco-fits-cell (nth sp sk))) (return done))
                  (set c (nth v (-> m heap)))
                  (cond
                    ((coco-tag-is REF c) (coco_bind m v (coco_push m (coco-int-cell (nth sp sk)))))
                    (#t (set pass (== c (coco-int-cell (nth sp sk)))))))
                (set fin 1)
                break)
              (case (cc-op "AG_ISC")
                ;; an integer on the left: compared
                (let ((u64 c . #'(nth pc p)))
                  (set pc (+ pc 1))
                  (set sp (- sp 1))
                  ;; a constant is a cell's: a result past one is not it
                  (set pass (== c (coco-int-cell (nth sp sk))))
                  (if (not (coco-fits-cell (nth sp sk))) (set pass 0)))
                (set fin 1)
                break)
              (case (cc-op "AG_TYPE")
                ;; as the type-test builtins read their argument
                (let ((u64 c . #'(nth (,VARAT (cc_k w)) (-> m heap))))
                  (switch (cast int (cc_n w))
                    (case (cc-gop "var") (set pass (coco-tag-is REF c)) break)
                    (case (cc-gop "nonvar") (set pass (not (coco-tag-is REF c))) break)
                    ;; the list's end is no atom (3.0.0)
                    (case (cc-gop "atom")
                      (set pass (and (coco-tag-is ATOM c)
                                     (!= c (coco-cell ATOM (coco_nil_id m))))) break)
                    (case (cc-gop "integer") (set pass (coco-is-int c)) break)
                    (case (cc-gop "number")
                      (set pass (or (coco-is-int c) (or (coco-tag-is FLT c) (coco-rat-p c)))) break)
                    (case (cc-gop "atomic")
                      (set pass (not (or (coco-tag-is REF c) (coco-tag-is FUN c)))) break)
                    (case (cc-gop "compound") (set pass (coco-tag-is FUN c)) break)
                    (default (return done))))
                (set fin 1)
                break)
              (default (return done)))
            ;; a goal ends here: failed, or done and the budget asked
            (if fin
                (block
                 (if (not pass) (block (set (cof failed) 1) (return done)))
                 (set done (+ done 1))
                 (if (>= done budget) (return done))))))
        (return done)))

(DEFUN cc-op-number (name)
  (LET ((row (ASSOC name *cc-ops* :TEST #'STRING=)))
    (UNLESS row (ERROR "cocolog: no clause opcode ~S" name))
    (SECOND row)))

(DEFMACRO cc-op (name) (cc-op-number name))

(generic decl-kb
  ()

  ;;; One key's clauses: where its chain starts and where it ends, so an
  ;;; `assertz' can be linked on in constant time. The table these live in is
  ;;; open-addressed and a slot with KEY 0 is an empty one -- which is why the
  ;;; clauses that match ANY key (0 is that key) are not kept in it but in the
  ;;; predicate's own `varhead'/`vartail' pair.
  (struct coco_kslot
    (member u64      key)
    (member size_t   head)
    (member size_t   tail)
    ;; how many clauses the chain holds: with the key-0 count beside it,
    ;; how many candidates a call of this key has -- which is how the
    ;; engine chooses the argument to index on (`coco_pred_select_key')
    (member size_t   count))

  ;;; ANOTHER ARGUMENT'S INDEX, for a call whose first argument cannot
  ;;; choose (`coco_pred_select_key'): the first argument's table again --
  ;;; a key per clause, chains in ascending position, the key-0 clauses
  ;;; apart -- built from the clauses' own heads the first time a call
  ;;; wants it, kept by `assertz', and dropped by whatever renumbers the
  ;;; clauses, as the first argument's is (`coco_pred_unindex').
  (struct coco_argix
    (member u64 *        keys)
    (member size_t       key_cap)
    (member size_t *     chain)
    (member size_t       chain_cap)
    (member coco_kslot * slots)
    (member size_t       nslots)
    (member size_t       varhead)
    (member size_t       vartail)
    (member size_t       nvar)
    (member int          indexed))

  ;;; One predicate: a name, an arity, and the clauses under it in the order
  ;;; they were asserted. `loaded' says the fetch hook has already been asked
  ;;; about this predicate, so a predicate that genuinely has no clauses is not
  ;;; re-fetched on every call.
  (struct coco_pred
    (member u64      name)
    (member u32      arity)
    ;; THE COUNT A PROBE READS: `nclauses' while no clause is dead, 0 while
    ;; one is (or past 32 bits), so the probe's one test of its count also
    ;; sends a predicate with dead clauses out of line (`coco_pred_probe').
    ;; Kept by `coco_pred_nprobe' after every write of `nclauses' or `ntomb'.
    ;; In the hole after ARITY: no other member moves.
    (member u32      nprobe)
    (member size_t * clauses)          ; indices into the store's cells
    (member size_t   nclauses)
    (member size_t   clause_cap)
    ;; WHERE EACH CLAUSE CAME FROM, parallel to CLAUSES: the interned real
    ;; path of the file that consulted it PLUS ONE -- atom 0 is a real
    ;; atom, and under `run' it is the file's own path, the first thing a
    ;; fresh machine interns -- or 0 for a clause a running program
    ;; asserted, a module's Coco half, or a row that never said. Consulting
    ;; a file again REPLACES the clauses that carry its name and touches
    ;; nothing else -- so a second `run' against the same store holds one
    ;; copy of the program, not two, and what the program asserted stays.
    (member u64 *    origins)
    (member size_t   origin_cap)
    ;; WHETHER A MODULE PUT THIS CLAUSE HERE, parallel to CLAUSES, and the
    ;; only thing that tells a library's clause from the program's once both
    ;; are in one predicate. `origins' cannot: a tier-2 library is consulted
    ;; from a real file and its clauses carry that file's path exactly as a
    ;; program's do, while a compiled-in module's carry 0 exactly as an
    ;; `assertz' does. What is common to every library clause and to no
    ;; program clause is that the store was MUTED when it arrived.
    ;;
    ;; The backend reads it. `coco_zg_sync_pred' rewrites a dirty predicate
    ;; WHOLESALE, and without this it wrote the module's own clauses into the
    ;; knowledge base beside the program's: one `assertz(member(foo,[a]))'
    ;; left THREE rows, and every later process fetched library(lists)'s two
    ;; on top of the copy it already had -- `member(X,[p,q])' answering
    ;; [p,q,q,p,q,q]. Muted clauses never write through, so they must never
    ;; be written back either.
    (member int *    muted)
    (member size_t   muted_cap)
    ;; EACH CLAUSE'S COMPILED PROGRAM, parallel to CLAUSES: the `coco_code'
    ;; the store's code table holds for that clause, or nil until the clause
    ;; is first tried (1.8.46). A call read the table by the clause's cell --
    ;; a hash, a probe and two calls -- on every inference; this is one load.
    ;; The table stays the owner: an entry here is a copy of its pointer,
    ;; moved with the clause when the list shifts (asserta, retract, a
    ;; reconsult), dropped when the clause is (its program is freed), and
    ;; cleared with the table when the store compacts (every cell moved).
    (member void **  codes)
    (member size_t   codes_cap)
    (member int      dynamic)
    (member int      loaded)
    ;; The backend was asked about this predicate and added NOTHING. Kept per
    ;; predicate rather than re-derived, because the only moment it can be seen
    ;; is the fetch itself -- afterwards a predicate with the module's own
    ;; clauses in it looks the same either way. `coco_store_prewarm' reads it.
    (member int      empty_fetch)
    ;; THE DECLARATIONS WERE ASKED FOR WHILE RESOLVING THIS PREDICATE, and the
    ;; answer is not asked for twice. `coco_store_warm' fetches the whole
    ;; knowledge base's `:- dynamic' rows, and the engine calls it on the path
    ;; that is about to raise `existence_error' -- so that a predicate another
    ;; process declared and never wrote to is found rather than refused. That
    ;; path was assumed never to run in a loop and it does: a caller that
    ;; CATCHES the error and asks again pays the whole warm every time.
    ;; Measured on a 400 MB embedded store, ten raises of one unknown
    ;; predicate: 2.57 s, against 0.000 s for a predicate declared dynamic.
    ;; Per predicate rather than per store, so a declaration another process
    ;; makes is still found for every name this one has not yet asked about.
    (member int      warmed)
    ;; Came from a MODULE's Coco half rather than from the program. `listing'
    ;; with no argument skips these -- a person listing what they wrote does
    ;; not want the library back -- while `listing(Name)' still shows them,
    ;; because asking for one by name is asking about it specifically.
    (member int      library)
    ;; ...UNLESS THE MODULE IS A FILE OF THE PROGRAM'S OWN (1.10.28): `-s
    ;; FILE', ensure_loaded/1 and use_module/1 of a path load the program
    ;; as a module, muted like a library's and `library' for the pre-warm,
    ;; and `listing/0', current_predicate/1 and predicate_property/2 count
    ;; it as the program's, as SWI does. Through 1.10.27 they did not
    ;; (reported from cicili-lang).
    (member int      own)

    ;; ---- first-argument indexing ------------------------------------
    ;;
    ;; WITHOUT IT A CALL WALKS THE PREDICATE, and the walk is not a cheap
    ;; one: each clause is COPIED onto the heap with fresh variables and
    ;; unified against the goal, and both are thrown away when the head did
    ;; not match. For a table of facts that is the entire cost -- a thousand
    ;; probes over 200 facts spent them on 199 copies apiece -- and it grows
    ;; with the table: measured against a hash at three sizes, 7x at 200
    ;; facts, 49x at 2000, 411x at 20000. A ratio that grows is the
    ;; signature of a linear scan rather than of a slow interpreter.
    ;;
    ;; KEYS is parallel to CLAUSES and holds each clause head's first
    ;; argument AS A CELL. The cell rather than a hash of it, because every
    ;; term that can be discriminated on already has a canonical machine
    ;; word: an ATOM cell is its interned id, an INT cell is its value, a
    ;; FUN cell is its interned functor. Two heads with the same cell have
    ;; the same principal functor, which is the only question an index of
    ;; this kind answers -- and two with different non-zero cells CANNOT
    ;; unify, which is what makes skipping them sound.
    ;;
    ;; ZERO IS "MATCHES ANYTHING", and five things take it: an unbound
    ;; first argument, a FLOAT (two equal floats may sit at two indices of
    ;; the float table, so a cell comparison would answer no to 1.0 against
    ;; 1.0), a STRING for the same reason -- its table is not interned
    ;; either, and until this was written `p("ab")' as a head could not be
    ;; found by `p("ab")' as a call -- an integer past 60 bits, boxed in a
    ;; table that is not interned either (2.0.0), and a predicate of arity
    ;; zero. No real
    ;; cell is zero: every tag but REF is non-zero in the low bits and a REF
    ;; is never stored here.
    ;;
    ;; CHAIN is parallel too and threads the clauses of one key together in
    ;; ascending position, so selection walks only the candidates and
    ;; `clause_ix' STAYS AN ORDINAL -- which is what a frozen machine's
    ;; choice frame holds (lib/state.cicili), and it must go on meaning what
    ;; it meant.
    ;;
    ;; INDEXED says the table agrees with the clause list. `assertz' keeps
    ;; it agreeing for nothing; `asserta' and `retract' renumber every
    ;; clause after them, so they clear it and the next call that wants the
    ;; index rebuilds it.
    (member u64 *    keys)
    (member size_t   key_cap)
    (member size_t * chain)
    (member size_t   chain_cap)
    (member coco_kslot * slots)
    (member size_t   nslots)           ; a power of two; 0 = no table yet
    (member size_t   varhead)          ; the key-0 clauses, tried whatever
    (member size_t   vartail)          ;   the call's own key is
    (member size_t   nvar)             ;   and how many there are
    (member size_t   kmax)             ; the most clauses one key's chain holds
    (member int      indexed)
    ;; THE OTHER ARGUMENTS' INDEXES, the second to the eighth, one
    ;; `coco_argix' each, made at the first call that wants one: a call
    ;; whose first argument is unbound, or keyed on a value most clauses
    ;; share, is indexed on the bound argument that leaves the fewest
    ;; candidates -- `edge(X, b)', or `word(es, casa, M)' in a table of
    ;; one language. nil until then.
    (member coco_argix * aix)

    ;; ---- the logical update view (ISO's, swipl's) ---------------------
    ;;
    ;; A CALL SEES THE CLAUSES THAT STOOD WHEN IT BEGAN. Its choice frame
    ;; keeps the clause count of that moment (`cend', lib/solve.cicili), so
    ;; an assertz made while it is open is beyond it, and an asserta moves
    ;; it on a clause (`coco_frames_on'). A RETRACT WHILE A CALL ON THIS
    ;; PREDICATE IS OPEN TAKES NOTHING OUT: the clause stays where it is,
    ;; DEAD, its slot in TOMB the death it was, counted in TERA -- and
    ;; each frame open then that had lived through none keeps it as the
    ;; first (`fera', `coco_frames_on'), so the dead a frame may still try
    ;; are the ones from its first on, and a new call tries none. Kept at
    ;; the death and not at the push: a push is every call that leaves a
    ;; choice, a death under an open call is rare. The dead go when no
    ;; frame on the predicate is left (`coco_pred_sweep'), which sets TERA
    ;; back to 0: at the next change of it, at a new call now and then, and
    ;; when a query starts with nothing running. Through 2.2.5 a retry read
    ;; the live list, and a retract under an open call moved the clauses it
    ;; had still to try. TOMB is parallel to CLAUSES when it is not nil,
    ;; and nil whenever NTOMB is 0. Everything that reads the clause list
    ;; as the predicate's clauses skips a slot `coco_pred_dead' names.
    (member u32 *    tomb)
    (member size_t   tomb_cap)
    (member size_t   ntomb)
    (member u32      tera)
    ;; new calls that met the dead, counted to ask now and then whether
    ;; they may go (`coco_pred_probe_dead'), and whether the predicate is
    ;; on the store's list of those with dead clauses (`tpreds')
    (member u32      tprobe)
    (member int      tlisted)
    ;; A CLAUSE FRAME MAY BE OPEN ON IT: set by every push of one, and
    ;; cleared by a walk of the frames that found none (`coco_frames_on'),
    ;; so a predicate no call left a choice on -- a counter, a flag --
    ;; walks no frames when it is changed
    (member int      framed)
    ;; WHERE THE LAST LIVE CLAUSE ASKED FOR BY ITS ORDINAL WAS (`clause/2'
    ;; reads them so, `coco_pred_live_at'): the LORDth live one at LPOS, as
    ;; long as LVER is TVER, which every change of the clause list or of a
    ;; clause's life moves on -- so an enumeration with dead clauses about
    ;; takes a step a clause and not a walk
    (member u32      tver)
    (member u32      lver)
    (member size_t   lord)
    (member size_t   lpos)
    ;; A PROGRAM FILE DEFINES IT, AND IT IS A BUILTIN'S NAME (3.1.0): a
    ;; file of the program's own (`coco_assert_from'; a library's muted
    ;; clause never) gave a clause to a name and arity the engine or a
    ;; compiled-in module implements, and which is not ISO. The step then
    ;; calls the predicate, as swipl calls a user file's definition of a
    ;; system predicate (`coco_bix_fill', `coco_m_taken').
    (member int      taken)
    ;; DECLARED BY discontiguous/1 (1) OR multifile/1 (2), the two bits
    ;; (3.1.0), a directive or a goal: the predicate is defined then, as
    ;; swipl's, so a call of it with no clauses FAILS where an unknown one
    ;; raises existence_error -- the step asks it on the path that has no
    ;; clause to try -- current_predicate/1 names it, predicate_property/2
    ;; says which, and listing/1 writes `:- multifile' as swipl's does.
    ;; Kept by the process only: no row says it.
    (member int      declared)
    ;; NAMED BY redefine_system_predicate/1 (3.1.0, `coco_bi_redefine_system'):
    ;; a program file's clause for it takes it over though it is ISO, as
    ;; swipl lets one then. Kept by the process only. Appended.
    (member int      redef)
    ;; DECLARED public/1 (1), volatile/1 (2), module_transparent/1 (4) OR
    ;; thread_local/1 (8, with 2 and dynamic) (3.2.0, swipl's): what
    ;; predicate_property/2 and listing/1 say of it. None of them defines
    ;; the predicate but thread_local/1, as swipl's -- a call of a public
    ;; one with no clauses raises existence_error. Kept by the process only.
    ;; Appended.
    (member int      pattrs))

  ;;; Forward-declared, because the two hooks below are members of the store
  ;;; and take a pointer to it -- the typedef has to exist before the struct
  ;;; that carries them is written out.
  (decl) (struct coco_store)

  ;;; ONE GLOBAL VARIABLE, as `nb_setval/2' keeps it: a name and the store
  ;;; CELL holding its value. It lives here rather than in the builtins
  ;;; because the table below belongs to the store -- see `globals'.
  (struct coco_global
    (member u64    name)
    (member size_t cell)
    (member size_t size)               ; cells the value occupies, for the count of the dead
    ;; WHICH SETTING THE VALUE IS (1.12.1), unique in this store (`gver'),
    ;; and whether it is ground: a machine keeps a ground value's copy and
    ;; hands it out shared until the global is set again
    (member u64    ver)
    (member int    ground))

  ;;; A ROOT ARRAY SOMEBODY ELSE OWNS, registered with the store for as long
  ;;; as it holds cell indices: where the array pointer lives, because its
  ;;; owner may grow it, and where its length lives. See `coco_store_compact'.
  (struct coco_rootset
    (member size_t ** cells)
    (member size_t *  len))

  ;;; ONE FILE CONSULTED INTO A STORE (2.13.0): its real path and its
  ;;; time_file/2 when it was read. See `loads'.
  (struct coco_loaded
    (member char *   path)
    (member double   time))

  ;;; The clause store. `cells' is a second flat term array with the same
  ;;; encoding as the heap -- it shares the machine's atom and functor tables,
  ;;; so an atom id means the same thing in both.
  (struct coco_store
    (member u64 *     cells)
    (member size_t    len)
    (member size_t    cap)
    ;; `len' at the last compaction, when every cell was live -- the
    ;; growth since is what `coco_store_maybe_compact' measures -- and
    ;; the root arrays other callers hold at the moment, a stack. See
    ;; `coco_store_compact'.
    (member size_t    mark)
    ;; how many compactions this store has run, for `statistics/2'
    (member size_t    ncompacts)
    ;; cells known to be orphans since then, counted where a death is cheap
    ;; to see; a heuristic, so it may overcount and never has to be exact
    (member size_t    dead)
    (member coco_rootset * roots)
    (member size_t    nroots)
    (member size_t    root_cap)

    ;; `nb_setval/2's GLOBALS, AND THEY LIVE HERE BECAUSE A CELL DOES. An
    ;; entry holds an index into `cells' above, which means nothing to any
    ;; other store -- so a table shared between stores hands one store's
    ;; index to another: garbage when it lands in range, SIGSEGV when it
    ;; does not. That was the bug, reported from a running game as an
    ;; intermittent crash with `coco_store_get_node' under `coco_b_getval'
    ;; on the faulting stack, and reproduced as a nested `run_isolated/2'
    ;; answering a clause term where an integer had been stored.
    ;;
    ;; PUTTING THE TABLE IN THE STORE IS WHAT FIXES IT, and three other
    ;; things fall out. It cannot be raced: every store belongs to one
    ;; thread, where a file-scope table is appended to by all of them at
    ;; once -- eight threads writing 800 globals each ABORTED the process
    ;; on an unguarded `realloc', measured. It cannot leak: the entries go
    ;; with `coco_store_free', where a shared table kept a row per store
    ;; that ever set a global, for ever. And the scan stays short: it walks
    ;; this store's names, not every name every store ever used.
    ;;
    ;; THE STORE AND NOT THE ENGINE, deliberately: a negation runs its goal
    ;; in a sub-engine that SHARES this store, so hanging them off the
    ;; engine would lose every `nb_setval/2' made inside a `forall/2'.
    (member coco_global * globals)
    (member size_t    nglobals)
    (member size_t    gcap)
    ;; AND THEY ARE FOUND BY NAME THROUGH A HASH (1.9.4): an open table of
    ;; an entry's index plus one, kept under half full -- see
    ;; `coco_global_find' in lib/builtins-db.cicili, its only reader
    (member size_t *  gbuckets)
    (member size_t    gbucket_cap)
    ;; the last version a setting of a global took (1.12.1)
    (member u64       gver)
    ;; whether the last put met a variable (1.12.1): a ground value is one
    ;; a machine may keep and hand out shared, and the put knows it free
    (member int       put_vars)

    (member coco_pred * preds)
    (member size_t    npreds)
    (member size_t    pred_cap)
    ;; THE PREDICATES WITH DEAD CLAUSES (`tomb' on the predicate), by index,
    ;; for the sweep a query makes when it starts with nothing running
    (member size_t *  tpreds)
    (member size_t    ntpreds)
    (member size_t    tpred_cap)
    ;; which store this is, for a cache keyed by store: a number no store
    ;; made in this process before it had, given at init (`coco_store_init')
    (member u64       serial)
    ;; compiled clauses by clause cell: open addressing, a key is the cell
    ;; plus one, 0 is empty -- see `coco_clause_code'
    (member size_t *  code_keys)
    (member void **   code_vals)
    (member size_t    code_cap)
    (member size_t    code_len)
    ;; RETIRED CODES (Stage 5): a dead clause's code that an environment on
    ;; the heap may still name, kept out of the table on a list through its
    ;; `rnext' until a heap collection finds no environment naming it
    ;; (`coco_code_sweep'), a query starts with nothing running, or the
    ;; store is freed. A `coco_code *', which this struct cannot name yet.
    (member void *    retired)
    (member size_t    nretired)
    ;; the table that finds a predicate by name and arity -- the functor
    ;; table's shape, see `coco_pred_find'
    (member size_t *  pred_buckets)       ; open addressing, index+1, 0 is empty
    (member size_t    pred_bucket_cap)

    ;; The backend. Called once per predicate, with the store to fill in;
    ;; answers 1 if it looked (whether or not it found anything) and 0 if it
    ;; could not, with the reason in `fetch_err' and `fetch_oom' set when the
    ;; reason was memory. A fetch that answers 0 is asked again by the next
    ;; call (`coco_pred_ensure'). A null hook is a purely local knowledge base.
    (member func fetch ((coco_store * st) (void * ctx) (u64 name) (u32 arity)) (out int))
    (member void *    ctx)

    ;; THE LONGEST CLAUSE THIS BACKEND CAN HOLD, as canonical text, or 0 for a
    ;; store with no such limit -- a purely local one, which keeps clauses in
    ;; memory and has no row to fit them into.
    ;;
    ;; A ROW MUST FIT IN A PAGE. Zigurat allocates a row inside one page
    ;; (65536 bytes by default since 1.10.0, 8192 before, and a store keeps
    ;; the one it was made on) and throws `allocation overflow' if it will
    ;; not fit, and the throw comes at COMMIT: measured on 8192, a clause of
    ;; 8013 characters stores and one of 8014 does not, and the refusal took
    ;; the WHOLE TRANSACTION with it --
    ;; every clause the process had asserted, the small ones before and after
    ;; the big one included, silently as far as the program could tell,
    ;; because its own `findall' had already answered with all of them in it.
    ;;
    ;; So the length is checked HERE, on the way in, where the clause can
    ;; still be refused one at a time and named. See `coco_assert_from'.
    (member size_t    clause_max)

    ;; Why the last assert was refused, as a sentence, or empty. It is a
    ;; buffer on the store because `coco_assert_from' runs BELOW the engine
    ;; and has no ball to throw: the two callers that do -- `assertz/1' and
    ;; the consult loop -- read it and say so in their own shapes.
    (member char      assert_err [256])

    ;; Why the last module load would not consult, as the consult said it
    ;; -- FILE:LINE:COL and the reason -- or empty (1.11.9). The load runs
    ;; under `use_module' and under the engine's ask, neither of which sees
    ;; the consult's own buffer; each reads this and says it.
    (member char      load_err [512])

    ;; WHY THE LAST READ OF A PREDICATE FROM THE BACKEND FAILED (2.11.1), as
    ;; a sentence, or empty; the predicate it was for; and whether memory
    ;; was what it lacked. `coco_pred_ensure' runs below the engine and has
    ;; no ball to throw, so it leaves the three here for the caller that
    ;; does -- `coco_fetch_error' (lib/solve.cicili) raises
    ;; error(resource_error(knowledge_base), context(Name/Arity, Why)) from
    ;; them, or resource_error(memory). The backend's fetch writes the
    ;; sentence; a fetch that fails without one gets a plain one.
    (member char      fetch_err [256])
    (member size_t    fetch_pi)
    (member int       fetch_oom)

    ;; Set when a clause is asserted, so a backend can write through. Null for
    ;; a store that is not backed by anything.
    (member func on_assert ((coco_store * st) (void * ctx) (size_t clause)) (out int))

    ;; And when one is retracted. It takes the PREDICATE rather than the clause,
    ;; because by the time it runs the clause is no longer in the predicate's
    ;; list and there is nothing left to hand over -- and because a backend that
    ;; stores clauses by ordinal has to rewrite the whole predicate anyway, which
    ;; is what `on_assert' already does.
    ;;
    ;; WITHOUT IT A RETRACT WAS LOCAL. It came out of the store in memory and the
    ;; database never heard: the clause was back the next time the predicate was
    ;; fetched, and no other interpreter ever saw it go. An interpreter that can
    ;; assert into a shared knowledge base and not retract from it is halfway to
    ;; being one.
    (member func on_retract ((coco_store * st) (void * ctx) (size_t pi)) (out int))

    ;; Asks the backend to name every predicate it holds, so that the store
    ;; knows they exist. Null for a store that is not backed by anything, which
    ;; already knows everything it has.
    ;;
    ;; WHAT IT IS FOR IS `listing'. Clauses are fetched a predicate at a time
    ;; and only when something calls one, which is what makes a shared knowledge
    ;; base affordable -- but it also means a fresh interpreter knows of no
    ;; predicate it has not already reached. `listing' asking what there is
    ;; would answer "nothing", which is true of the store and false of the
    ;; knowledge base. It interns names only: what the clauses ARE is still
    ;; nobody's business until somebody calls one.
    (member func warm ((coco_store * st) (void * ctx)) (out int))

    ;; Set when a predicate is declared -- `:- dynamic' and, when there is one,
    ;; whatever else a directive can say about a predicate. It takes the
    ;; predicate rather than the property, because the store's `coco_pred' is
    ;; where the properties are and the backend can read them off it.
    ;;
    ;; A DECLARATION HAS TO OUTLIVE THE PROCESS THAT MADE IT. In a knowledge
    ;; base kept in the interpreter's own memory `:- dynamic' could be a flag on
    ;; a struct, because the program that declared it is the program that runs.
    ;; Here the clauses are shared and the declaration is about them, so an
    ;; interpreter opening the same kb tomorrow has to be told the same thing.
    (member func on_dynamic ((coco_store * st) (void * ctx) (size_t pi)) (out int))

    ;; Asks the backend to reclaim what its deleted rows still hold -- the
    ;; TRUNCATE pass README documents. Null means the arrangement cannot
    ;; vacuum: a purely local store has nothing dead to reclaim, a read-only
    ;; backend may not, and a backed store whose operator did not opt in
    ;; (`--vacuum') keeps the hook cleared -- reclaiming spends the store's
    ;; point-in-time reads, so `vacuum_kb/0' finding null raises
    ;; permission_error rather than quietly doing it. LIVE, when the hook
    ;; answers, is the count of live rows left behind: run it twice and the
    ;; second answer being the same is what says there was nothing left.
    (member func vacuum ((coco_store * st) (void * ctx) (i64 * live)) (out int))

    ;; Tensors: model parameters as rows of one vector field, in the
    ;; cocolog::tensors table -- doubles, not text. Three optional hooks the
    ;; torch module consults through the module API; all three null means
    ;; the arrangement keeps parameters in clause chunks instead, which is
    ;; what --local does by nature and the embedded store does until the
    ;; Cicili MVCCS engine grows a vector column.
    ;;   put:    one piece of the tensor NAME, seq-th of its pieces
    ;;   row:    the seq-th piece back, up to CAP doubles, *N says how many;
    ;;           answers 0 at the first seq that is not there
    ;;   forget: every piece of NAME, before a save writes new ones
    (member func tensor_put ((coco_store * st) (void * ctx) (const char * name)
                             (i64 seq) (const double * v) (u32 n)) (out int))
    (member func tensor_row ((coco_store * st) (void * ctx) (const char * name)
                             (i64 seq) (double * out) (u32 cap) (u32 * n)) (out int))
    (member func tensor_forget ((coco_store * st) (void * ctx)
                                (const char * name)) (out int))

    ;; The connection under the backend, when the backend IS a connection:
    ;; the zigurat client installs this and answers its zg_conn*, so
    ;; library(zigurat) can drive the wire the store already rides --
    ;; commit, rollback, isolation, a procedure call -- without a hook per
    ;; verb. Null under --local (there is no connection) and under the
    ;; Zeytun reader (one HTTP request is one transaction; nothing to
    ;; steer). Opaque here on purpose: the store knows nothing of what a
    ;; zg_conn is, exactly as ctx is opaque.
    (member func conn ((coco_store * st) (void * ctx)) (out void *))

    ;; WHAT A HALT DURING A LOAD FINISHES before the process ends: a halt in
    ;; a directive's goal or an initialization goal, or `initialization(G,
    ;; main)' done (`coco_halt_load'). The run's writes become durable at
    ;; the commit its host makes AFTER the goal it was given, and an exit
    ;; from inside the load never got there: measured under --embed, every
    ;; one of those halts kept nothing, with exit 0 and an empty stderr.
    ;; This commits them (KEEP) or rolls them back, closes what the store
    ;; rides on and answers the exit status -- CODE, or what a failed commit
    ;; makes it. Null where there is nothing to finish, or where finishing
    ;; is not this store's to do: --local, a thread's store, a machine's turn
    ;; (whose writes belong with its saved state). The composition root
    ;; installs it for the commands that end in one commit.
    (member func on_halt ((coco_store * st) (void * ctx) (int code) (int keep)) (out int))

    ;; How many MODULES have had their clauses consulted into this store. It
    ;; lives here rather than beside the registry because it is a fact about
    ;; this store and not about the build: `coco_store_reset' -- which is what
    ;; thawing a machine does -- takes the clauses with it, and the count going
    ;; back to zero is exactly the statement that they have to be put back.
    (member size_t    libs)

    ;; Non-zero while the store is being filled from something that is not the
    ;; knowledge base -- a module's clauses. See `coco_store_mute'.
    (member int       muted)
    ;; AND 1 WHILE THAT MODULE IS A FILE OF THE PROGRAM'S OWN, loaded by
    ;; its path (`-s', ensure_loaded/1, use_module/1 of a file), not a
    ;; library: its predicates are marked `own' (1.10.28).
    (member int       ownload)

    (member int       oom)
    ;; a growth given less than it asked (`coco_store_grow', 1.10.28)
    (member int       memreq)
    ;; THE MACHINES THAT SHARE THIS STORE (2.7.0): the host's and the green
    ;; threads' while a green world runs; the frame walks visit every one,
    ;; so the logical update view sees a suspended green thread's frames.
    (member void *    machines)
    ;; THE ROOT MACHINE whose name table names this store's predicates. A
    ;; `run_isolated' store is a fresh machine; the global declaration
    ;; cache (`coco_dynamic_known') needs a table to turn a predicate's
    ;; name id back into the string the cache holds. Set by
    ;; `coco_engine_init'; nil where no engine has run -- a bare consult.
    (member void *    name_m)
    ;; A STORE ONLY THIS ENGINE CAN SEE: findall's solutions and a caught
    ;; ball live here, so copying them is not a write to the one shared
    ;; store and does not stop the other workers. It holds terms only --
    ;; no predicates, hooks or globals -- and its growth needs no barrier.
    (member int       private)
    ;; THE FILES CONSULTED INTO THIS STORE (2.13.0) -- by consult/1,
    ;; load_files/2 and `[File]', by `run' and the toplevel -- each with its
    ;; time_file/2 when it was read: what `load_files(F, [if(changed)])'
    ;; compares, and what keeps ensure_loaded/1 from loading a file this
    ;; store already holds as a module beside it, every clause twice. A
    ;; reset takes them with the clauses (`coco_store_free').
    (member coco_loaded * loads)
    (member size_t    nloads)
    (member size_t    load_cap)
    ;; WHY THE BACKEND LAST REFUSED A DECLARATION (3.0.3), as its own
    ;; sentence, or empty: `on_dynamic' leaves it before it answers 0, and
    ;; `coco_pred_dynamic' answers -1 for the caller that says it. Through
    ;; 3.0.2 the callers said `out of memory', which every later process
    ;; over a damaged store printed (cicilang 0.240).
    (member char      write_err [256])
    ;; HOW MANY OF ITS PREDICATES A PROGRAM FILE HAS TAKEN OVER (3.1.0,
    ;; `taken' on the predicate): 0 in nearly every store, which is all the
    ;; questions about a name ask first.
    (member size_t    ntaken))

  (decl) (func coco_store_init ((coco_store * st)))
  (decl) (func coco_store_free ((coco_store * st)))

  ;;; The files consulted into ST (2.13.0, `loads'): whether the file at
  ;;; real path PATH was, and when it was written then (*T, when T is not
  ;;; null); and the note that it is being read now, its time_file/2 being
  ;;; T -- the time replaced for a file read before. The note answers 0
  ;;; when there was no memory for it.
  (decl) (func coco_store_loaded ((coco_store * st) (const char * path) (double * t)) (out int))
  (decl) (func coco_store_note_load ((coco_store * st) (const char * path) (double t)) (out int))

  ;; Stops the write-through hooks firing, and starts them again. A module's
  ;; clauses belong to the BUILD and not to the knowledge base: written
  ;; through, they would be saved into the shared database, come back on every
  ;; fetch, and be listed as the user's own -- and the next interpreter to open
  ;; the same knowledge base would then hold two copies of the library.
  ;;
  ;; It is a counter and not a flag, so that muting nests.
  (decl) (func coco_store_mute ((coco_store * st)))
  (decl) (func coco_store_unmute ((coco_store * st)))
  (decl) (func coco_store_is_muted ((coco_store * st)) (out int))

  ;; Empties a store of everything it holds and leaves its BACKEND in place.
  ;; What a store contains -- clauses, predicates, cells -- is reloadable; the
  ;; hooks that say where from are configuration, not contents. `coco_thaw' is
  ;; what wants the distinction: a resumed machine has to keep the connection
  ;; it is resuming against.
  (decl) (func coco_store_reset ((coco_store * st)))

  ;;; Moves a term from the machine's heap into the store, and back. Both
  ;;; rename variables consistently -- see coco_varmap in term.cicili.
  (decl) (func coco_store_put ((coco_store * st) (coco_machine * m) (size_t t)) (out size_t))
  (decl) (func coco_g_write_begin ((void * e)) (out int))
  (decl) (func coco_g_write_end () (out void))
  (decl) (func coco_g_write_end_cleanup ((int * began)) (out void))
  (decl) (func coco_store_get ((coco_machine * m) (coco_store * st) (size_t t)) (out size_t))
  ;;; WHAT A PROGRAM PUT, READ BACK (1.10.19): `coco_store_get', and -- once
  ;;; a cyclic term has been put as its factors (`cyc_puts' on the machine)
  ;;; -- those factors made cyclic again (`coco_unfactor'). The readers of
  ;;; a program's terms use it: findall/3's results, nb_getval/2, a thrown
  ;;; ball. A clause is read with `coco_store_get', assert refusing a
  ;;; cyclic one, and so is the compaction, which moves the factors as
  ;;; they are.
  (decl) (func coco_store_read ((coco_machine * m) (coco_store * st) (size_t t)) (out size_t))
  ;;; A TERM COPIED AS ITS BLOCK (1.12.1): T the root of a term the store
  ;;; put in one go, which took SIZE cells from T up (a global's value,
  ;;; `coco_b_global_term'). The put wrote its cells together with nothing
  ;;; else among them, every reference among them pointing at another of
  ;;; them, a variable a cell pointing at itself, and a float or a string
  ;;; indexing the machine's own tables -- so the copy is the block itself,
  ;;; moved: one memcpy, then every REF's payload by the distance. A
  ;;; variable stays one (a fresh one each copy), a DAG stays a DAG, and a
  ;;; cyclic term's factors are bound back as `coco_store_read' binds them.
  ;;; Through 1.12.0 every read walked the term a cell at a time
  ;;; (`coco_store_get_vm'), four times as long for a list of 3 000
  ;;; entries; refused the room, it still does.
  (decl) (func coco_store_read_block ((coco_machine * m) (coco_store * st) (size_t t)
                                      (size_t size)) (out size_t))
  ;;; The same copy, and with it SPAN, the cells the term takes IN THE
  ;;; STORE. The copy is shorter than that by one cell per distinct
  ;;; variable (a variable met first lives in its argument slot on the
  ;;; heap and has a cell of its own in the store), so a caller that
  ;;; counts a dying term dead by copying it asks here, and never reads the
  ;;; heap's length as the span.
  (decl) (func coco_store_get_span ((coco_machine * m) (coco_store * st) (size_t t)
                                    (size_t * span)) (out size_t))
  ;;; The same copy over a variable map the CALLER holds, so two walks can
  ;;; share one renaming: a head matched in place and a body copied after
  ;;; it (`coco_store_unify' below), and `coco_select_clause' in solve.cicili
  ;;; is the one that holds it.
  (decl) (func coco_store_get_vm ((coco_machine * m) (coco_store * st) (size_t t)
                                  (coco_varmap * vm)) (out size_t))
  ;;; UNIFIES A HEAP TERM WITH A STORE TERM WITHOUT COPYING THE STORE TERM.
  ;;; A clause used to arrive on the heap as a fresh copy, head and body,
  ;;; and the copy was thrown away when the head did not match: on naive
  ;;; reverse the copies were 57 % of the interpreter's instructions. This
  ;;; walks the two side by side instead -- a store variable met for the
  ;;; first time is MAPPED to the heap cell it meets (VM, no cell made),
  ;;; met again it is unified with what it was mapped to; a store atom or
  ;;; compound against an unbound heap variable is copied then, and only
  ;;; then, through the same map, so the body copy that follows a match
  ;;; (`coco_store_get_vm' with the same VM) renames consistently. Nothing
  ;;; in the store is ever bound. Answers 1 on success; on failure the
  ;;; bindings made are left for the caller's trail mark to undo, as
  ;;; `coco_unify' leaves them.
  (decl) (func coco_store_unify ((coco_machine * m) (coco_store * st) (size_t a) (size_t s)
                                 (coco_varmap * vm)) (out int))
  ;;; A clause's head and body AS STORE INDICES, without copying it: a
  ;;; `:-'/2 whose name is NECK (the interned `:-') splits, anything else
  ;;; is a fact and the body is 0.
  (decl) (func coco_store_clause_parts ((coco_store * st) (coco_machine * m) (size_t clause)
                                        (u64 neck) (size_t * head) (size_t * body)))

  ;;; ---- compiled clauses --------------------------------------------------
  ;;;
  ;;; A CLAUSE IS COMPILED THE FIRST TIME IT IS SELECTED, into two programs
  ;;; over a FRAME of its variables: the head's, which unifies the call's
  ;;; arguments with the head -- the WAM's get and unify instructions, with
  ;;; a nested structure flattened through a temporary -- and the body's,
  ;;; which builds the body goals on the heap through the frame, in the
  ;;; order the copy would have walked them, and lists their roots for the
  ;;; continuation. Where the matcher and the copy walked store cells --
  ;;; dereferencing each, testing its tag, probing the variable map for
  ;;; each variable met -- the programs are straight lines: a variable is
  ;;; a frame index, a constant is its cell, a structure its functor and
  ;;; arity.
  ;;;
  ;;; THE FRAME IS NOT A HEAP OBJECT. It lives for the one call that
  ;;; selects the clause: every body goal is built then and pushed on the
  ;;; continuation as before, so a frozen machine carries exactly what it
  ;;; carried -- the same `'$k'' cells, nothing new to thaw -- and a
  ;;; clause asserted or retracted while its body runs cannot move the
  ;;; body under it. This is the compile step's head half and build half;
  ;;; running a body from the store instead of building it would change
  ;;; the continuation's shape, and that is a design decision, not this.
  ;;;
  ;;; THE CODE IS KEYED BY THE CLAUSE'S CELL in a table on the store, and
  ;;; the table is cleared when the store compacts (every cell moves) and
  ;;; freed with the store. A retracted clause's code stays until then,
  ;;; unreachable: a store appends, so its cell is not reused before a
  ;;; compaction. A thawed machine's store is a fresh one, so it compiles
  ;;; afresh. Nothing in the code names a store position -- a constant is
  ;;; the cell itself, a functor its id -- so a compaction cannot stale it.
  ;;;
  ;;; ONE UNIT OF A BODY RUN FROM AN ENVIRONMENT (Stages 5 and 6), what one
  ;;; `'$k'' frame held through 1.9.2: KIND (`cc-eg') says how the step
  ;;; reaches it. A TERM -- a builtin, a construct left a term, a call the
  ;;; registers do not pay for -- was built at entry as it always was, and
  ;;; TSLOT is the environment's slot holding it. A CALL is written into the
  ;;; registers from the environment's variable slots (EBODY[RAT, RAT +
  ;;; RLEN), FID and ARITY its functor), or built from them as a term when
  ;;; its predicate turns out not to be a plain one (EBODY[TAT, TAT +
  ;;; TLEN)). A CUT cuts to its barrier, TRUE goes on and FAIL fails, FID
  ;;; the atom each was written as.
  ;;;
  ;;; THE BUILTINS IN PLACE (Stage 7). A GUARD -- `is/2', a comparison, a
  ;;; type test -- runs its guard program (EBODY[RAT, RAT + RLEN), Stage
  ;;; 4's words over the slots) and builds its term from the slots (TAT,
  ;;; TLEN) only when the program cannot decide; a GUARDX is a GUARD whose
  ;;; program is one fused word and its two operands (AG_ISX, AG_CMPX). A
  ;;; SIDES -- `=/2', `==/2', `\==/2', FORM 0 to 2 -- reads its two
  ;;; arguments out of the slots as a call's register form does (RAT, RLEN,
  ;;; RVARS) and unifies or compares them. A BUILTIN is a TERM whose
  ;;; builtin's row is FORM, called by it.
  ;;;
  ;;; THE CONSTRUCTS (Stage 6). An ITE -- `( C -> T ; E )', `( C -> T )',
  ;;; `\+ C' or `not(C)', `once(C)' and `ignore(C)', which FORM tells apart
  ;;; (0 to 4 in that order), FID and FID2 the functors they were written
  ;;; with -- pushes a choice whose alternative is E, writes the height it
  ;;; pushed it at into condition slot TSLOT, and goes on to C, whose goals
  ;;; cut to that height plus one; the CUTC after C cuts to the height, and
  ;;; T follows. A, B, C and D are the units C, T, E and the CUTC; the
  ;;; forms with no T or E written have a TRUE or FAIL unit for them, as
  ;;; `coco_ite' had `$true' and `$fail'. A DISJ pushes a choice whose
  ;;; alternative is B and goes on to A. A CONJ is a `,' written inside a
  ;;; construct, taken apart in one step into its items A, the next of each
  ;;; in SIB, ARITY of them -- up to 63 and the rest as one, as
  ;;; `coco_k_push_body' takes them. NEXT is the unit after this one, 0 the
  ;;; body's end; BSLOT is the barrier its goals cut to, 0 the
  ;;; environment's and S + 1 condition slot S's (its height, plus one).
  ;;;
  ;;; WHAT TAKING IT READS, as offsets from the environment's header, so a
  ;;; step adds one number where it would add four (`cc_env_offsets'):
  ;;; NOFF the continuation after it, the next unit's position or the
  ;;; parent's cell; BOFF the cell its barrier is read from and BADD what
  ;;; is added to it (the environment's barrier, or a condition's height
  ;;; plus one); SOFF a term's slot (a TERM's or a BUILTIN's), or an
  ;;; if-then-else's and its cut's condition slot; AOFF the position of a
  ;;; construct's first part and COFF of its alternative (an
  ;;; if-then-else's else, a disjunction's right arm). RVARS says a call's
  ;;; arguments are all variables (or a SIDES's two), every word of its
  ;;; register form an RARG_VAR, which a step copies itself.
  (struct coco_egoal
    (member u32 kind)
    (member u32 arity)
    (member u32 tslot)
    (member u32 tat)
    (member u32 tlen)
    (member u32 rat)
    (member u32 rlen)
    (member u64 fid)
    (member u64 fid2)
    (member u32 form)
    (member u32 next)
    (member u32 bslot)
    (member u32 a)
    (member u32 b)
    (member u32 c)
    (member u32 d)
    (member u32 sib)
    (member u32 noff)
    (member u32 boff)
    (member u32 badd)
    (member u32 soff)
    (member u32 aoff)
    (member u32 coff)
    (member u32 rvars)
    ;; ITS OWNER (3.1.0, `coco-bar-pred'): the clause's predicate, or
    ;; swipl's `once/1' (`ignore/1', `not/1') for that construct's goal
    ;; and the cut after it, and `'<meta-call>'/1' for a unit inside a
    ;; structure one of those is called with -- ORed into the barrier its
    ;; goal is handed over with, and read by what an error names; META
    ;; for a goal that is a variable of the clause
    (member u64 tag))

  ;;; WHAT A CLAUSE ENTRY THAT MAKES AN ENVIRONMENT NEEDS TO KNOW (Stage 5):
  ;;; the continuation the body returns to and its goals' cut barrier, in;
  ;;; the continuation after the first goal, out -- the environment's first
  ;;; position.
  (struct coco_envreq
    (member size_t parent)
    (member size_t barrier)
    (member size_t next))

  (struct coco_code
    (member u64 *  head)
    (member size_t hlen)
    (member u64 *  body)
    (member size_t blen)
    (member u32    nvars)
    (member u32    ngoals)
    ;; THE FIRST GOAL AGAIN, FOR THE REGISTERS (Stage 3): its arguments
    ;; written into the engine's argument registers rather than into a goal
    ;; term -- a structure or a constant among them still built, in one
    ;; reservation, the goal's own header and slots not at all. RSTART is
    ;; where the second goal begins in BODY, RFID and RARITY the first
    ;; goal's functor; RBLEN 0 when the first goal cannot go there (an atom,
    ;; a variable, more arguments than the registers hold).
    (member u64 *  rbody)
    (member size_t rblen)
    (member size_t rstart)
    (member u64    rfid)
    (member u32    rarity)
    ;; THE GUARDS (Stage 4): the arithmetic and type tests the body starts
    ;; with, NGD of them, as one program over a stack of integers (GBODY),
    ;; run when the clause is entered instead of built and stepped through.
    ;; GSTART[I] is where goal I begins in BODY, for I up to NGD: the body
    ;; is built from GSTART[NGD] when every guard ran, and from where the
    ;; first one that could not decide begins otherwise. The register form
    ;; above is then the form of goal NGD, the first that is not a guard.
    (member u64 *  gbody)
    (member size_t gblen)
    (member u32    ngd)
    (member u32    gstart [9])
    ;; THE LATER GOALS, FROM AN ENVIRONMENT (Stages 5 and 6). A body with
    ;; a construct from goal NGD on (its first that is not a guard) runs,
    ;; once that goal is handed over and every guard ran, its ENTRY PROGRAM XBODY --
    ;; the later goals that are terms built as they always were, and the
    ;; variables a later call meets first made, each where the body would
    ;; have made it -- and then writes ONE environment instead of the later
    ;; goals' frames and the calls' terms: `'$e'(Code, Parent, Barrier,
    ;; V1 ... Vn, T1 ... Tm, P1 ... Pk)' (`coco-env-code'), EFID its
    ;; functor, the continuation becoming its first position. ENV says the
    ;; body makes one; V1 ... Vn (NES of them) are the variables the later
    ;; calls read, EINIT[S] the frame index slot S is written from, T1 ...
    ;; Tm (NTERM) the terms the entry program built, in goal order, and P1
    ;; ... Pk a position per later goal. EGOALS[I], for NGD < I < NGOALS,
    ;; is how goal I is reached (`coco_egoal'), the calls' programs in
    ;; EBODY.
    (member u32    env)
    (member u32    nes)
    (member u32    nterm)
    ;; THE UNITS (Stage 6): NUNIT of them in EGOALS[1 ... NUNIT], one
    ;; position each in the environment, and NSLOT condition slots; EU0 is
    ;; the unit the continuation starts at once the clause is entered, and
    ;; EHAND says the first goal is handed over before it, as a clause's
    ;; first goal always was -- 0 when the first goal is itself a unit
    (member u32    nunit)
    (member u32    nslot)
    (member u32    eu0)
    (member u32    ehand)
    (member u32 *  einit)
    (member u64    efid)
    (member coco_egoal * egoals)
    (member u64 *  ebody)
    (member size_t eblen)
    (member u64 *  xbody)
    (member size_t xblen)
    ;; THE TAIL EVERY ENTRY WRITES ALIKE (1.9.4): the NSLOT condition slots,
    ;; zero, then a position per unit -- a distance back to the header and
    ;; a unit number, the same in every environment of this code -- copied
    ;; as one block where the entry wrote them cell by cell
    (member u64 *  etmpl)
    ;; WHAT ENTERING THE CLAUSE TAKES beyond the plain executor: 0 nothing,
    ;; 1 its guards, 2 its environment, 3 both -- so `coco_try_clause' asks
    ;; a plain clause one question, the one it asked through 1.9.2
    (member u32    ex)
    ;; AN ENVIRONMENT HAS NAMED THIS CODE (`envd'), so a clause that dies
    ;; retires it instead of freeing it (`coco_code_drop'); GCMARK is the
    ;; heap collection that last found one naming it, RNEXT the next on the
    ;; store's retired list (a `coco_code *', which this struct cannot name
    ;; inside itself).
    (member u32    envd)
    (member u64    gcmark)
    (member void * rnext)
    ;; set while a compaction keys the table again: a live clause owns it
    (member u32    kept)
    ;; THE PREDICATE IT IS A CLAUSE OF (3.1.0), its functor id plus one at
    ;; bit 32 (`coco-bar-pred'), 0 for none: entering the clause ORs it into
    ;; the barrier its body leaves on the continuation, which is how an
    ;; error a body goal raises names the clause's predicate, as swipl's
    ;; frames do
    (member u64    ptag))

  ;;; The clause's code, compiled on the first ask; null when it could not
  ;;; be compiled (out of memory, a head that is not callable), and the
  ;;; caller then matches and copies the store cells as before.
  (decl) (func coco_clause_code ((coco_store * st) (coco_machine * m) (size_t clause))
               (out coco_code *))
  ;;; Runs the clause's code against CALL: the head program, then, when
  ;;; the head matched, the body program, whose goal roots are written to
  ;;; GOALS (at most 64; a longer body ends in one `,' goal the engine
  ;;; takes apart) with their count in NGOALS. Answers 1 on a match, 0
  ;;; when the head did not unify, and -1 when the program could not run
  ;;; (no memory for its frame or its goals) -- the bindings and cells made
  ;;; are left for the caller's marks to undo, as `coco_unify' leaves them.
  (decl) (func coco_clause_run ((coco_machine * m) (coco_store * st) (coco_code * cd)
                                (size_t call) (size_t * goals) (size_t * ngoals)) (out int))
  ;;; The same, two ways more: ARGS, when not nil, are the call's arguments
  ;;; in registers, and CALL is not read; REGS, when not nil and the code
  ;;; has a register form of its first goal (`rblen'), receives that goal's
  ;;; arguments instead of a goal term being built, and GOALS then holds
  ;;; the goals after it.
  (decl) (func coco_clause_run_r ((coco_machine * m) (coco_store * st) (coco_code * cd)
                                  (size_t call) (const size_t * args)
                                  (size_t * goals) (size_t * ngoals) (size_t * regs)) (out int))
  ;;; And for a code with guards (`ngd'): at most BUDGET of them are run,
  ;;; and GDONE says how many were -- each an inference the caller counts,
  ;;; the one that failed included; when fewer than all of them ran, REGS
  ;;; was not written and GOALS starts with the first guard that did not.
  (decl) (func coco_clause_run_g ((coco_machine * m) (coco_store * st) (coco_code * cd)
                                  (size_t call) (const size_t * args)
                                  (size_t * goals) (size_t * ngoals) (size_t * regs)
                                  (u32 budget) (u32 * gdone)) (out int))
  ;;; And for a code with no guards that makes an environment (`env',
  ;;; Stage 5): the head, the first goal -- into REGS or built -- the later
  ;;; goals' entry program, and the environment, as ER asks.
  (decl) (func coco_clause_run_e ((coco_machine * m) (coco_store * st) (coco_code * cd)
                                  (size_t call) (const size_t * args)
                                  (size_t * goals) (size_t * ngoals) (size_t * regs)
                                  (coco_envreq * er)) (out int))
  ;;; And for one whose body starts with guards and makes an environment
  ;;; after them (Stage 6): the guards as above, then the first goal after
  ;;; them and the environment -- or, when fewer than all of them ran, the
  ;;; body built from the one that did not and no environment (ER's next
  ;;; left 0).
  (decl) (func coco_clause_run_ge ((coco_machine * m) (coco_store * st) (coco_code * cd)
                                   (size_t call) (const size_t * args)
                                   (size_t * goals) (size_t * ngoals) (size_t * regs)
                                   (coco_envreq * er) (u32 budget) (u32 * gdone)) (out int))
  ;;; Which builtin a name and arity are, or -1 (lib/solve.cicili): the
  ;;; environment's compiler asks it of a later goal, which a builtin's
  ;;; name keeps a term.
  (decl) (func coco_builtin_index ((coco_machine * m) (u64 nid) (u32 arity)) (out int))
  ;;; THE NAME TAKEN OVER (3.1.0, lib/solve-db.cicili): whether NAME/ARITY
  ;;; is one of swipl's ISO predicates; the row a functor keeps for NID/N
  ;;; (`bix': K + 2, or 1 for none or one a program file took over); and
  ;;; what a program file's clause for one does to the predicate PI and to
  ;;; the functor of HEAD.
  (decl) (func coco_iso_predicate ((const char * name) (u32 arity)) (out int))
  (decl) (func coco_bix_fill ((coco_machine * m) (coco_store * st) (u64 nid) (u32 n)) (out u32))
  (decl) (func coco_pred_take_over ((coco_store * st) (coco_machine * m) (size_t pi) (size_t head)))
  ;;; The engine's names interned (lib/solve.cicili), which the question
  ;;; above wants before a fresh machine's first step.
  (decl) (func coco_ids_fill ((coco_machine * m)))
  ;;; The atoms it tells a construct by, from the machine's own vocabulary
  ;;; (lib/solve.cicili), and `'$cut'/1': 1, or 0 before there is one.
  (decl) (func coco_unit_names ((coco_machine * m) (u64 * names) (u64 * fcut)) (out int))
  ;;; GOAL I OF THE ENVIRONMENT AT ENV (whose code is CD), reached: its
  ;;; arguments into REGS (a call, `coco_env_regs'), or its term into OUT
  ;;; (`coco_env_term'). 1, or 0 when the heap would not grow.
  (decl) (func coco_env_regs ((coco_machine * m) (coco_code * cd) (size_t env) (u32 i)
                              (size_t * regs)) (out int))
  (decl) (func coco_env_term ((coco_machine * m) (coco_code * cd) (size_t env) (u32 i)
                              (size_t * out)) (out int))
  ;;; A GUARD OR A SIDES AT UNIT U, done where it stands (Stage 7): the
  ;;; guard's program over the slots -- 1 when it passed, 0 when it did not
  ;;; with FAILED set, or did not decide with FAILED clear -- and the two
  ;;; sides unified or compared -- 1 true, 0 false, -1 the heap would not
  ;;; grow. Static, each with one caller (`coco_env_place' in
  ;;; solve.cicili), and inline there. A GUARDX answers as a GUARD does.
  (static) (decl) (func coco_env_guard ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                                        (int * failed)) (out u32))
  (static) (decl) (func coco_env_guardx ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                                         (int * failed)) (out u32))
  (static) (decl) (func coco_env_sides ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u))
                        (out int))
  ;;; UNIT U OF THE ENVIRONMENT AT ENV as the term its frame held through
  ;;; 1.9.2 (Stage 6, `coco_unit_term'): 1, or 0 when the heap would not grow.
  (decl) (func coco_unit_term ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                               (size_t * out)) (out int))
  ;;; Frees every retired code no environment named in the heap collection
  ;;; EPOCH (`gcmark'), or every one (`coco_code_retired_free').
  (decl) (func coco_code_sweep ((coco_store * st) (u64 epoch)))
  (decl) (func coco_code_retired_free ((coco_store * st)))
  ;;; How many arguments the registers hold.
  (decl) (func coco_regs_max () (out u32))
  (decl) (func coco_code_table_clear ((coco_store * st)))
  ;;; Frees one clause's code, if it has any: called where a clause dies.
  (decl) (func coco_code_drop ((coco_store * st) (size_t clause)))
  ;; every clause's program, to be compiled again (3.1.0, `coco_pred_take_over')
  (decl) (func coco_code_forget_all ((coco_store * st)))
  ;;; Copies every live term into a fresh cell array and drops the old one;
  ;;; the second asks only when the store has grown enough to be worth it.
  (decl) (func coco_store_compact ((coco_store * st) (coco_machine * m)) (out int))
  (decl) (func coco_store_maybe_compact ((coco_store * st) (coco_machine * m)) (out int))
  ;;; A caller that keeps cell indices in an array of its own says so for as
  ;;; long as it does; a compaction in between rewrites them like any root.
  (decl) (func coco_store_root_push ((coco_store * st) (size_t ** cells) (size_t * len)) (out int))
  (decl) (func coco_store_root_pop ((coco_store * st)))
  ;;; Counts a term the store can no longer reach as dead, by measuring it.
  (decl) (func coco_store_orphan ((coco_store * st) (coco_machine * m) (size_t cell)))

  ;;; The predicate a callable term belongs to, made if it is not there yet.
  ;;; Answers the index, or the store's predicate count if the term is not
  ;;; callable at all.
  (decl) (func coco_pred_of ((coco_store * st) (coco_machine * m) (size_t goal)) (out size_t))
  (decl) (func coco_pred_find ((coco_store * st) (u64 name) (u32 arity)) (out size_t))
  ;; Find or make, by name and arity rather than by a goal term. `coco_thaw'
  ;; needs it: a choice point that was part way through a predicate remembers
  ;; which one by name, because the index depends on the order predicates were
  ;; first mentioned and a machine coming back elsewhere cannot rely on that.
  (decl) (func coco_pred_intern ((coco_store * st) (u64 name) (u32 arity)) (out size_t))

  ;;; Asserts a clause given as a heap term -- `Head' or `Head :- Body'. AT_END
  ;;; is assertz, otherwise asserta. Answers 1, or 0 if the term is not a
  ;;; clause.
  (decl) (func coco_assert ((coco_store * st) (coco_machine * m) (size_t clause) (int at_end)) (out int))

  ;;; A PREDICATE A RE-READ PLACES AS SWI'S RELOAD DOES (2.14.1): the
  ;;; clauses it held when the file's first clause of it came -- O, in
  ;;; order -- and how far the file's clauses have got through them. See
  ;;; `coco_reload_begin' in the implementation.
  (struct coco_reload
    (member size_t   n)              ; O's length
    (member size_t * cell)           ; each one's clause cell
    ;; 0 another's, there (a candidate never); 1 the file's own, taken out
    ;; at the first clause and a candidate; 2 asserted, there and a
    ;; candidate (a read that is not muted adopts one); 3 passed or gone
    (member u8 *     kind)
    (member u64 *    hash)           ; a candidate's shape (`coco_reload_hash')
    (member size_t * bnext)          ; the next candidate of its bucket, plus one
    (member size_t * bhead)          ; each bucket's first candidate not passed, plus one
    (member size_t   nb)             ; how many buckets, a power of two
    (member size_t   ptr)            ; swipl's pointer: O's first clause not passed
    (member size_t   anc)            ; O's first clause from PTR that is still there
    (member size_t   at)             ; where that one was found last
    (member size_t   ncomp))         ; the store's compactions when CELL was taken

  ;;; The predicates one consult has already reset, so each is reset ONCE
  ;;; per consult -- at its first clause -- however many clauses the file
  ;;; holds for it and however they are scattered. A frame of the consult,
  ;;; so a file consulted from inside another keeps its own.
  (struct coco_origin_seen
    (member size_t * pis)
    (member size_t   n)
    (member size_t   cap)
    ;; EACH ONE'S RELOAD (2.14.1), parallel to PIS: nil for a predicate
    ;; whose clauses are appended, as a first read's are; AGAIN, whether
    ;; the file is read into this store again; LAST, the index in PIS of
    ;; the predicate the last clause went to, plus one
    (member coco_reload ** rls)
    (member size_t   rcap)
    (member int      again)
    (member size_t   last))

  ;;; `coco_assert' with a PROVENANCE. ORIGIN is the interned real path of
  ;;; the file the clause was read from plus one, 0 for none. With SEEN given and an
  ;;; origin, the first clause of each predicate first drops every clause
  ;;; that predicate already holds from the same origin: the reconsult. And
  ;;; a re-read places each clause as swipl's reload does (2.14.1,
  ;;; `coco_reload_begin'), where a first read appends.
  (decl) (func coco_assert_from ((coco_store * st) (coco_machine * m) (size_t clause)
                               (int at_end) (u64 origin) (coco_origin_seen * seen)) (out int))

  ;;; A clause as a backend stores it: bare, or `'$from'(Path, Clause)'
  ;;; carrying the name of the file that consulted it. Either goes into the
  ;;; store; the wrapper becomes the clause's origin and is not kept.
  (decl) (func coco_assert_stored ((coco_store * st) (coco_machine * m) (size_t t)) (out int))

  ;;; Drops every clause of predicate PI that came from ORIGIN, telling the
  ;;; backend once if anything went. Answers how many went.
  (decl) (func coco_pred_forget_from ((coco_store * st) (coco_machine * m) (size_t pi) (u64 origin)) (out int))

  ;;; ---- first-argument indexing, the two the engine calls -----------------

  ;;; The index key of a callable term: its first argument's cell, or 0 for
  ;;; anything that cannot be discriminated on -- an unbound argument, a
  ;;; float, or no argument at all. See `coco_pred' for why the cell IS the
  ;;; key. The term is dereferenced here, so a caller may hand over a goal
  ;;; straight out of a choice frame.
  (decl) (func coco_arg_key ((coco_machine * m) (size_t t)) (out u64))

  ;;; The first clause at or after FROM whose head can match a goal of KEY,
  ;;; or `coco_no_clause' when there is none. A KEY of 0 constrains nothing
  ;;; and answers FROM.
  ;;;
  ;;; THIS IS WHERE THE DETERMINISM COMES FROM, as much as the speed: asking
  ;;; it a second time from the next position is how the engine learns that
  ;;; the clause it just took was the last candidate, and a predicate with no
  ;;; second candidate leaves no choice point behind at all.
  (decl) (func coco_pred_next_clause ((coco_store * st) (coco_pred * p)
                                    (u64 key) (size_t from)) (out size_t))
  ;; the first candidate and whether a second exists: 0 none, 1 one, 2 more
  ;; -- of the LIVE clauses, a new call's (`coco_pred_dead')
  (decl) (func coco_pred_probe ((coco_store * st) (coco_pred * p)
                              (u64 key) (size_t * ix) (coco_machine * m)) (out int))

  ;;; ---- the logical update view ------------------------------------------
  ;;;
  ;;; THE FRAMES OPEN ON PREDICATE PI of ST, on every engine of M's chain
  ;;; that runs over ST (`m->eng', each engine's `outer' -- every engine a
  ;;; program can still fail back into, as no builtin leaves a choice point
  ;;; behind): with ACT 0 whether there is one (1 or 0, the walk stopping
  ;;; at the first); with ACT 1 how many, each given death ERA as the first
  ;;; it lives through when it has none (`fera'); with ACT 2 how many, each
  ;;; at or past position AT moved one clause on, as a clause put in at AT
  ;;; just moved every clause from there -- AT 0 for an asserta, which moved
  ;;; them all (`clause_ix', `cend'); with ACT 3 how many would see a clause
  ;;; put in at AT, having a clause before it still to try and one after it
  ;;; inside their end (2.14.1, a re-read's place for a clause). No walk at
  ;;; all for a predicate no frame was pushed on since the last walk found
  ;;; none (`framed'). Defined in lib/solve.cicili, which knows what a frame
  ;;; is.
  (decl) (func coco_frames_on ((coco_machine * m) (coco_store * st) (size_t pi)
                               (int act) (u32 era) (size_t at)) (out size_t))
  ;;; How many of P's clauses before position IX are live: IX itself when
  ;;; none is dead -- the ordinal a frame's next clause has in a list that
  ;;; holds no dead (a frozen machine's, `coco_freeze').
  (decl) (func coco_pred_live_before ((coco_pred * p) (size_t ix)) (out size_t))
  ;;; The position of P's Nth live clause (from 0), `coco_no_clause' past
  ;;; the last: N itself when none is dead (`clause/2''s `'$clause'/3').
  (decl) (func coco_pred_live_at ((coco_pred * p) (size_t n)) (out size_t))
  ;;; The dead of predicate PI taken out if no frame is open on it: 1 when
  ;;; they went (or there were none), 0 when a frame may still try one.
  (decl) (func coco_tomb_try_sweep ((coco_store * st) (coco_machine * m) (size_t pi)) (out int))
  ;;; Whether clause I of P is dead: retracted while a call on P was open
  ;;; and kept for the calls open then.
  (decl) (func coco_pred_dead ((coco_pred * p) (size_t i)) (out int))
  ;;; How many of P's clauses are live.
  (decl) (func coco_pred_live ((coco_pred * p)) (out size_t))
  ;;; The dead clauses of PI taken out, as a retract with no call open
  ;;; would have taken them: the caller has made sure no frame is open on
  ;;; it. And the same for every predicate on the store's list, by a
  ;;; caller that knows no frame is open anywhere (a query starting with
  ;;; nothing running).
  (decl) (func coco_pred_sweep ((coco_store * st) (coco_machine * m) (size_t pi)))
  (decl) (func coco_tomb_sweep_all ((coco_store * st) (coco_machine * m)))

  ;;; THE ARGUMENT A CALL IS INDEXED ON, and its key. The first, as it
  ;;; always was, when its key leaves few candidates; else the bound one,
  ;;; of the first eight, whose index leaves the fewest -- built the first
  ;;; time it is wanted. POS is the argument, 0 for the first, and the
  ;;; pair comes back by value, so a caller's locals stay in registers.
  ;;; Every choice is sound: a clause any index skips has a head that
  ;;; cannot unify with the call, so the choice moves only how many
  ;;; hopeless heads are tried and whether a call is known to be
  ;;; deterministic, never which solutions come, or in what order.
  (struct coco_ixsel
    (member u64 key)
    (member u32 pos))
  (decl) (func coco_pred_select ((coco_store * st) (coco_machine * m) (coco_pred * p)
                                 (size_t call)) (out coco_ixsel))
  ;;; The key of argument POS of a call, as `coco_arg_key' reads the first's.
  (decl) (func coco_call_arg_key ((coco_machine * m) (size_t call) (u32 pos)) (out u64))
  ;;; `coco_pred_next_clause' and `coco_pred_probe' on argument POS
  (decl) (func coco_pred_next_at ((coco_store * st) (coco_machine * m) (coco_pred * p)
                                  (u32 pos) (u64 key) (size_t from)) (out size_t))
  (decl) (func coco_pred_probe_at ((coco_store * st) (coco_machine * m) (coco_pred * p)
                                   (u32 pos) (u64 key) (size_t * ix)) (out int))

  ;;; What `coco_pred_next_clause' answers when the clauses have run out. Not
  ;;; a position anything can hold, because the clause array would have to
  ;;; fill memory to reach it.
  (decl) (func coco_no_clause () (out size_t))

  ;;; Reads a whole program text and asserts every clause in it. Answers the
  ;;; number asserted, or -1 on a syntax error, leaving the message in ERR.
  ;;;
  ;;; ORIGIN NAMES THE FILE, for the messages a directive can now produce --
  ;;; `file.pl:12:' the way SWI writes it. Text with no file behind it passes
  ;;; nil, and the message says only what went wrong.
  ;;;
  ;;; A DIRECTIVE THAT FAILS OR THROWS NO LONGER STOPS THE LOAD. It is
  ;;; reported, in SWI's two-line shape, and the next clause is read -- which
  ;;; is what every other Prolog does, and what makes a file with one bad
  ;;; directive in it still a file you can work on. Only a SYNTAX error ends
  ;;; the consult, because after one the reader does not know where it is.
  (decl) (func coco_consult ((coco_store * st) (coco_machine * m) (const char * text)
                           (const char * origin)
                           (char * err) (size_t errlen)) (out int))

  ;;; THE SAME, WITH THE CLAUSES' OWNER NAMED (2.14.0): OWNER is the real
  ;;; path of the file the text is, and the clauses carry it even in a
  ;;; muted store -- which is how a module's clauses (`coco_module_load')
  ;;; are told from another module's, so that consulting the file again
  ;;; replaces them. Null owns nothing. REREAD 0 is a first read, which
  ;;; has nothing to replace and asks nothing; 1 replaces what OWNER put
  ;;; in this store before, as `coco_consult' does for the program's file.
  (decl) (func coco_consult_owner ((coco_store * st) (coco_machine * m) (const char * text)
                                 (const char * origin) (const char * owner) (int reread)
                                 (char * err) (size_t errlen)) (out int))

  ;;; `coco_consult', SAYING WHETHER THE FILE IS READ INTO THIS STORE AGAIN
  ;;; (2.14.1): the host knows, from the files it noted (`loads') before it
  ;;; noted this read. AGAIN places every clause as swipl's reload places
  ;;; it, beside what the program asserted and other files put there --
  ;;; and a predicate that holds the file's clauses from before is placed
  ;;; so whatever AGAIN says; anything else of a first read is appended.
  (decl) (func coco_consult_again ((coco_store * st) (coco_machine * m) (const char * text)
                                 (const char * origin) (int again)
                                 (char * err) (size_t errlen)) (out int))

  ;;; Splits a clause ON THE HEAP into head and body. A fact has no body and
  ;;; BODY is left 0; the engine reads that as `true' rather than building one.
  ;;;
  ;;; It takes a heap term and not a stored one because a clause is always
  ;;; copied out of the store before it is used -- `coco_store_get' first, this
  ;;; second. A version reading the store's own cells would have to duplicate
  ;;; `coco_arity' and `coco_name_of' against a different array, and the one time
  ;;; that existed it was called with a heap index and read whatever the
  ;;; store's array happened to hold at that offset.
  (decl) (func coco_clause_parts ((coco_machine * m) (size_t clause)
                                (size_t * head) (size_t * body)))

  ;;; Makes sure a predicate's clauses are present, asking the backend once.
  ;;; 0 when the read failed (2.11.1): nothing of it is kept, the reason is on
  ;;; the store (`fetch_err'), and the caller refuses -- raising through
  ;;; `coco_fetch_error' (lib/solve.cicili) -- rather than read on.
  (decl) (func coco_pred_ensure ((coco_store * st) (size_t pi)) (out int))

  ;;; The same, answering the clauses the predicate has -- 0 when the read
  ;;; failed, which `loaded' left 0 tells from a predicate with none: the
  ;;; step's form of the question (2.11.1).
  (decl) (func coco_pred_ready ((coco_store * st) (size_t pi)) (out size_t))

  ;;; Brings every predicate the backend holds into the store, by name only.
  ;;; Answers 1 whether or not there was a backend to ask.
  (decl) (func coco_store_warm ((coco_store * st)) (out int))

  ;;; Declares NAME/ARITY dynamic: brings the predicate into being with no
  ;;; clauses, and marks it.
  ;;;
  ;;; WHAT IT IS FOR HERE, given that cocolog lets you assert into anything and
  ;;; calling something undefined already fails rather than raising. Two things.
  ;;; It makes a predicate that has no clauses YET exist, so `listing' can show
  ;;; it and a reader of the program can see it was meant; and it says out loud
  ;;; which predicates a program intends to change at run time, which is the
  ;;; only documentation of that a Prolog file has.
  ;;;
  ;;; It does NOT mark the predicate loaded. A dynamic predicate may perfectly
  ;;; well have clauses waiting in a shared knowledge base, put there by another
  ;;; interpreter, and declaring it here must not stop the backend being asked.
  ;;;
  ;;; Answers 1 declared, 0 out of memory, and -1 when the backend refused the
  ;;; declaration (3.0.3): then it was not made, and `write_err' says why.
  (decl) (func coco_pred_dynamic ((coco_store * st) (u64 name) (u32 arity)) (out int))

  ;;; Removes the first clause whose head and body unify with the given term:
  ;;; 1 when one went, 0 when none matched, -1 when the predicate could not be
  ;;; read from the backend (the reason in `fetch_err', 2.11.1).
  (decl) (func coco_retract ((coco_store * st) (coco_machine * m) (size_t clause)) (out int))

  ;;; Declares every predicate a declaration's spec names, as KIND says: 0
  ;;; dynamic/1, 1 discontiguous/1, 2 multifile/1 (3.1.0). SPEC is a
  ;;; predicate indicator `Name/Arity', a comma conjunction of them, or a
  ;;; list of them -- all three of which real Prolog files use, often in the
  ;;; same file:
  ;;;
  ;;;   :- dynamic counter/1.
  ;;;   :- dynamic seen/2, queued/1.
  ;;;   :- dynamic [a/0, b/1].
  ;;;
  ;;; Answers 1, or 0 with ERR saying which part of the spec was not one. A
  ;;; directive asks it only of a spec `coco_decl_plain' passed, so a 0 is
  ;;; memory or a refusing backend; the rest go the goal's way.
  (decl) (func coco_dynamic_spec ((coco_store * st) (coco_machine * m) (size_t spec)
                                (int kind) (char * err) (size_t errlen)) (out int))
  ;;; A DECLARATION'S NAME, by KIND; ONE INDICATOR NID/N DECLARED (1, 0
  ;;; out of memory, -1 refused by the backend, `write_err'); and whether
  ;;; a spec is plain enough to declare at once (lib/kb-pred.cicili)
  (decl) (func coco_decl_kind ((int kind)) (out const char *))
  (decl) (func coco_decl_pi ((coco_store * st) (coco_machine * m) (u64 nid) (u32 n) (int kind))
               (out int))
  (decl) (func coco_decl_plain ((coco_machine * m) (size_t spec)) (out int))

  ;;; True when T is the compound NAME of arity two -- `a/1', `a, b', `[a|b]'.
  ;;; Out here rather than kept to itself because `listing/1' asks the same
  ;;; question of its argument that `dynamic/1' does.
  (decl) (func coco_is_compound2 ((coco_machine * m) (size_t t) (const char * name))
               (out int))

  ;;; The goals a file's `:- initialization(G)' directives put off until the
  ;;; whole file is read, in the order the file writes them. Cells, not heap
  ;;; terms: the heap is wound back after every clause, and a goal recorded
  ;;; on it would be pointing at reused ground by the time the file ended.
  ;;;
  ;;; MODE is `when' from SWI's `initialization/2': 0 after_load, 1 main.
  ;;; (`now' is not here, having already run.) LINE is where the directive
  ;;; was written, so the message a failing one produces can say.
  (struct coco_initgoals
    (member size_t * cells)
    (member int    * modes)
    (member int    * lines)
    (member size_t   len)
    (member size_t   cap))

  ;;; Applies one directive -- the G of a `:- G' read by `coco_consult'.
  ;;;
  ;;; IT RUNS G, through the seam below, when G is not one of the handful
  ;;; this file answers itself. Those it answers are the ones that are about
  ;;; the READER or the STORE and must take effect while the file is still
  ;;; being read -- `op/3' changes how the rest of the file parses,
  ;;; `set_prolog_flag(double_quotes, V)' changes what a "..." in it builds,
  ;;; `dynamic/1' makes a predicate exist before its first clause does.
  ;;; Everything else is a goal, as it is in SWI, and goes to the engine
  ;;; through `coco_goal_install' -- in file order, where a directive that
  ;;; asserts what the next one reads still works.
  ;;;
  ;;; INITS COLLECTS `initialization(G)'. Answers 1 (done), 2 (the goal
  ;;; FAILED -- a Warning, in SWI's reckoning, and ERR says which goal), 0
  ;;; (an error, ERR carrying it in SWI's words) or 3 (both: a load directive
  ;;; that loaded nothing, which SWI reports as the ERROR saying why and then
  ;;; the Warning that the directive failed). The caller REPORTS the last
  ;;; three and carries on, because a bad directive is one bad line and not a
  ;;; bad file.
  (decl) (func coco_directive ((coco_store * st) (coco_machine * m) (size_t g)
                             (coco_initgoals * inits) (int line)
                             (char * err) (size_t errlen)) (out int))
  ;;; ERR is `Goal (directive) failed: user:G', swipl's Warning (3.1.0)
  (decl) (func coco_directive_failed ((coco_machine * m) (size_t g)
                                      (char * err) (size_t errlen)))
  ;;; The ball a directive threw that ended a load (3.1.0, `lball'): taken
  ;;; on to the heap into OUT by whoever throws it (1, or 0 for none), or
  ;;; dropped by a host that reports the load's end itself.
  (decl) (func coco_load_ball_take ((coco_store * st) (coco_machine * m) (size_t * out)) (out int))
  (decl) (func coco_load_ball_drop ((coco_store * st) (coco_machine * m)))

  ;;; The seam `:- use_module(...)' loads through. This file is compiled
  ;;; below the module layer and cannot call it, so the library loader
  ;;; installs itself here the way the module layer installs itself into
  ;;; solve.cicili: one function pointer, null until somebody fills it in.
  ;;; While it is null the directive stays what it always was -- accepted
  ;;; and ignored, so a borrowed file still reads unedited. The hook answers
  ;;; 1 (loaded, or carried here under another name), 0 (found and would not
  ;;; load, ERR saying why) or -1 (not there at all).
  (decl) (func coco_use_module_install
               ((func h ((coco_store * st) (coco_machine * m) (size_t spec)
                         (char * err) (size_t errlen))
                     (out int))))

  ;;; The seam a DIRECTIVE runs through, installed by the same layer and for
  ;;; the same reason: an engine lives above this file, and a goal needs one.
  ;;; The hook answers 1 (proved), 0 (failed) or -1 (threw, with the message
  ;;; already in SWI's words in ERR) -- the three outcomes a load-time
  ;;; message has to tell apart -- and -2 for a DIRECTIVE's ball that is no
  ;;; error(_, _), which ends the load (3.1.0, the machine's `lball').
  ;;; KIND is what the goal is, as swipl runs each (3.1.0): 0 a directive's
  ;;; (under catch/3, which takes only an error(_, _)), 1 an
  ;;; initialization/1's or initialization(G, now)'s (under
  ;;; '$run_init_goal'/1, which takes every ball), 2 initialization(G,
  ;;; main)'s (under catch/3, and every ball).
  ;;;
  ;;; WHILE IT IS NULL a directive that is a goal is what it was before there
  ;;; was a seam: refused by name. That is not a fallback anybody should
  ;;; meet, but a store opened without an engine over it -- the schema
  ;;; compiler does exactly that -- must not crash on a file that has one.
  (decl) (func coco_goal_install
               ((func h ((coco_store * st) (coco_machine * m) (size_t goal) (int kind)
                         (char * err) (size_t errlen))
                     (out int))))

  ;;; WHETHER A COMPILED-IN MODULE OR A CONSTRUCT CLAIMS NAME/ARITY (3.1.0),
  ;;; installed by the builtins module (its `coco_b_claims'): a load asks it
  ;;; of a program file's clause, as it asks the engine's own table
  ;;; (`coco_builtin_index'). While it is null only the engine's table is
  ;;; asked -- a store with no builtins module over it, as the test
  ;;; binaries make.
  (decl) (func coco_claims_install
               ((func h ((const char * name) (u32 arity)) (out int))))

  ;;; Whether the store's NAME/ARITY is one a program file took over
  ;;; (`taken', 3.1.0): 0 at once while none is.
  (decl) (func coco_pred_taken ((coco_store * st) (u64 name) (u32 arity)) (out int))

  ;;; Ends the process from inside a load with CODE -- SWI's halt, which
  ;;; stops the load where it stands -- after the store's `on_halt', when it
  ;;; has one, has finished the run: KEEP commits what it wrote, as a halt
  ;;; after the CLI's goal is committed, and 0 rolls it back, as a goal
  ;;; that threw is. Never returns.
  (decl) (func coco_halt_load ((coco_store * st) (int code) (int keep)))

  ;;; THE BACKTRACE OF THE ERROR JUST REPORTED (1.10.17): the machine's
  ;;; `bt', put on stderr after the message when SAY -- the run the message
  ;;; is about ended with a ball, whose throw wrote it -- and freed either
  ;;; way, so a later report never prints lines that were not its own.
  (decl) (func coco_bt_say ((coco_machine * m) (int say)))

  ) ; decl-kb


(generic impl-kb
  ()

  ;; the use_module seam: null until the library loader installs itself.
  ;; No initialiser -- `. nil' cannot be written inside a generic in this
  ;; package, and a static is null anyway.
  (static) (var func coco_use_module_hook ((coco_store * st) (coco_machine * m)
                                           (size_t spec) (char * err) (size_t errlen))
                (out int))

  (func coco_use_module_install
        ((func h ((coco_store * st) (coco_machine * m) (size_t spec)
                  (char * err) (size_t errlen)) (out int)))
        (set coco_use_module_hook h))

  ;; and the seam a directive runs through, filled in by the same layer
  (static) (var func coco_goal_hook ((coco_store * st) (coco_machine * m)
                                     (size_t goal) (int kind) (char * err) (size_t errlen))
                 (out int))

  (func coco_goal_install
        ((func h ((coco_store * st) (coco_machine * m) (size_t goal) (int kind)
                  (char * err) (size_t errlen)) (out int)))
        (set coco_goal_hook h))

  ;; and the compiled-in modules' claims, filled in by the builtins module
  (static) (var func coco_claims_hook ((const char * name) (u32 arity)) (out int))

  (func coco_claims_install ((func h ((const char * name) (u32 arity)) (out int)))
        (set coco_claims_hook h))

  (func coco_pred_taken ((coco_store * st) (u64 name) (u32 arity)) (out int)
        (if (== (-> st ntaken) 0) (return 0))
        (let ((size_t pi . #'(coco_pred_find st name arity)))
          (if (>= pi (-> st npreds)) (return 0))
          (return ($ (nth pi (-> st preds)) taken))))

  ;;; WHAT A PROGRAM FILE'S CLAUSE FOR A BUILTIN'S NAME DOES (3.1.0), asked
  ;;; by `coco_assert_from' of a clause a file of the program's own gives
  ;;; NID/N: 0 for a name nothing claims, 1 for one the engine or a
  ;;; compiled-in module implements and swipl lets a user file define (the
  ;;; clause takes it over), 2 for an ISO one, which swipl refuses ("No
  ;;; permission to modify static procedure"). A construct's name is 2 where
  ;;; it is ISO and 0 where it is not and swipl compiles it in place (`*->',
  ;;; call/9): the step runs a construct before it asks anything of a
  ;;; predicate -- but not/1 and ignore/1, which swipl calls as the
  ;;; predicates they are there, are 1 (`coco_construct' passes a taken one
  ;;; by).
  (func coco_claim_kind ((coco_machine * m) (u64 nid) (u32 n)) (out int)
        ;; a fresh machine's first consult comes before its first step,
        ;; which is where the engine's names are interned otherwise
        (if (not (-> m ids_ready)) (coco_ids_fill m))
        (let ((const char * name . #'(coco_atom_name m nid))
              (int row . #'(coco_builtin_index m nid n))
              (int other . 0))
          (if (and (== n 1) (or (== 0 (strcmp name "not")) (== 0 (strcmp name "ignore"))))
              (return 1))
          (if (and (< row 0) (!= coco_claims_hook nil))
              (set other (coco_claims_hook name n)))
          (if (and (< row 0) (not other)) (return 0))
          (if (coco_iso_predicate name n) (return 2))
          ;; a construct a program cannot take over: 0, as before
          (if (and (< row 0) (coco_is_construct m nid)) (return 0))
          (return 1)))

  (func coco_halt_load ((coco_store * st) (int code) (int keep))
        ;; the program's output first: a failed commit says so on stderr
        (fflush nil)
        (if (!= (-> st on_halt) nil)
            (set code ((-> st on_halt) st (-> st ctx) code keep)))
        (fflush nil)
        (exit code))

  ;;; ---- the messages a load can produce ----------------------------------
  ;;;
  ;;; SWI'S TWO-LINE SHAPE, kept because a person who has seen one of these
  ;;; before should not have to learn a second dialect of it:
  ;;;
  ;;;     ERROR: /path/p.pl:12:
  ;;;     ERROR:    Unknown procedure: table/1
  ;;;
  ;;; The first line locates it and the second says what it was, indented
  ;;; under its own tag so a grep for `ERROR:' finds both halves. WHERE is
  ;;; nil for text with no file behind it -- a clause out of the database,
  ;;; the REPL -- and then the location line is left out rather than made up.
  ;;;
  ;;; ON A LINE OF ITS OWN (2.16.0): a report begins with a newline when the
  ;;; console's line is open -- the program wrote `abc' and no newline --
  ;;; as swipl's do, being print_message/2's (`~N', lib/term.cicili's
  ;;; `coco_out_fresh'). Through 2.15.1 `abc' and a report's tag shared a
  ;;; line on a terminal.
  ;;;
  ;;; EVERY LINE OF WHAT IS INDENTED UNDER THE TAG (3.1.0), as swipl's are:
  ;;; an initialization(G, now) goal that raised says where again and then
  ;;; why, two lines.
  (static)
  (func coco_load_message ((const char * tag) (const char * origin) (int line)
                           (const char * what))
        (fflush nil)
        (coco_out_fresh stderr)
        (if (!= origin nil)
            (fprintf stderr "%s: %s:%d:\n" tag origin line))
        (let ((const char * p . what))
          (while 1
            (let ((const char * nl . #'(strchr p 10)))
              (if (== nl nil)
                  (block (fprintf stderr "%s:    %s\n" tag p) break))
              (fprintf stderr "%s:    %.*s\n" tag (cast int (- nl p)) p)
              (set p (+ nl 1)))))
        (coco_out_note stderr "\n" 1))

  ;;; The one-line form, which is the one SWI uses for an initialization goal
  ;;; -- `Warning: p.pl:1: Initialization goal failed'. Measured against
  ;;; swipl rather than remembered: the two shapes are not interchangeable
  ;;; there and a reader who greps for one should find it.
  (static)
  (func coco_load_note ((const char * tag) (const char * origin) (int line)
                        (const char * what))
        (fflush nil)
        (coco_out_fresh stderr)
        (if (!= origin nil)
            (fprintf stderr "%s: %s:%d: %s\n" tag origin line what)
          (fprintf stderr "%s: %s\n" tag what))
        (coco_out_note stderr "\n" 1))

  (func coco_bt_say ((coco_machine * m) (int say))
        (if (== (-> m bt) nil) (return))
        (if say (coco_out_puts stderr (-> m bt)))
        (free (-> m bt))
        (set (-> m bt) nil))

  ;;; ---- the goals a file puts off ----------------------------------------

  (static)
  (func coco_inits_add ((coco_initgoals * gs) (size_t cell) (int mode) (int line))
        (out int)
        (if (>= (-> gs len) (-> gs cap))
            (let ((size_t ncap . #'(? (== (-> gs cap) 0) 8 (* (-> gs cap) 2)))
                  (void * nc) (void * nm) (void * nl))
              (set nc (realloc (cast (void *) (-> gs cells)) (* ncap (sizeof size_t))))
              (if (== nc nil) (return 0))
              (set (-> gs cells) (cast (size_t *) nc))
              (set nm (realloc (cast (void *) (-> gs modes)) (* ncap (sizeof int))))
              (if (== nm nil) (return 0))
              (set (-> gs modes) (cast (int *) nm))
              (set nl (realloc (cast (void *) (-> gs lines)) (* ncap (sizeof int))))
              (if (== nl nil) (return 0))
              (set (-> gs lines) (cast (int *) nl))
              (set (-> gs cap) ncap)))
        (set (nth (-> gs len) (-> gs cells)) cell)
        (set (nth (-> gs len) (-> gs modes)) mode)
        (set (nth (-> gs len) (-> gs lines)) line)
        (set (-> gs len) (+ (-> gs len) 1))
        (return 1))

  (static)
  (func coco_inits_free ((coco_initgoals * gs))
        (if (!= (-> gs cells) nil) (free (cast (void *) (-> gs cells))))
        (if (!= (-> gs modes) nil) (free (cast (void *) (-> gs modes))))
        (if (!= (-> gs lines) nil) (free (cast (void *) (-> gs lines))))
        (memset gs 0 (sizeof coco_initgoals)))

  ;;; A doubling refused is tried again with what is needed and a
  ;;; sixteenth, and given, sets `memreq': the next `coco_store_put', which
  ;;; knows the machine, stops the running engine with it, and its next
  ;;; step raises resource_error(memory) (1.10.28, as `coco_grow_short'
  ;;; does for the machine's arrays). Refused too, `oom', as before -- and a
  ;;; push that answers 0 writes over cell 0, which this makes rare.
  (static)
  (func coco_store_grow ((coco_store * st) (void ** buf) (size_t * cap) (size_t need) (size_t esize))
        (out int)
        (if (<= need (cof cap)) (return 1))
        (let ((size_t ncap . #'(? (== (cof cap) 0) 64 (cof cap)))
              (void * nbuf))
          (while (< ncap need) (set ncap (* ncap 2)))
          (set nbuf (realloc (cof buf) (* ncap esize)))
          (if (== nbuf nil)
              (block
                (set ncap (+ need (+ (/ need 16) 64)))
                (set nbuf (realloc (cof buf) (* ncap esize)))
                (if (== nbuf nil) (block (set (-> st oom) 1) (return 0)))
                (set (-> st memreq) 1)))
          (set (cof buf) nbuf)
          (set (cof cap) ncap)
          (return 1)))

  ;;; `memreq' handed to the engine the machine is running (`haltp')
  (func coco_store_memreq ((coco_store * st) (coco_machine * m))
        (set (-> st memreq) 0)
        (if (!= (-> m haltp) nil)
            (if (== (cof (-> m haltp)) 0) (set (cof (-> m haltp)) 2))))

  ;;; Each store made gets the next serial; a thread making one while
  ;;; another does may draw the same number, and the cache that reads it
  ;;; (`pserial' on a functor) keys by the store's address too, so a
  ;;; duplicate matters only for a store freed and made again at the same
  ;;; address in the same thread -- which the counter moving past it rules
  ;;; out.
  (static) (var u64 coco_store_serials . 0)

  ;;; How many arguments past the first can have an index of their own
  ;;; (`coco_argix'): the second to the eighth.
  (static) (func coco_aix_count () (out u32) (return 7))

  (func coco_store_init ((coco_store * st))
        (memset st 0 (sizeof coco_store))
        (set coco_store_serials (+ coco_store_serials 1))
        (set (-> st serial) coco_store_serials))

  (func coco_store_free ((coco_store * st))
        (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
          (free ($ (nth i (-> st preds)) clauses))
          (free ($ (nth i (-> st preds)) origins))
          (free ($ (nth i (-> st preds)) muted))
          (free (cast (void *) ($ (nth i (-> st preds)) codes)))
          (free (cast (void *) ($ (nth i (-> st preds)) tomb)))
          ;; the index's three arrays go with the clause list they describe,
          ;; and so do the other arguments' tables
          (free ($ (nth i (-> st preds)) keys))
          (free ($ (nth i (-> st preds)) chain))
          (free (cast (void *) ($ (nth i (-> st preds)) slots)))
          (let ((coco_argix * x . #'($ (nth i (-> st preds)) aix)))
            (if (!= x nil)
                (block
                 (for ((u32 j . 0)) (< j (coco_aix_count)) ((++ j))
                   (free ($ (nth j x) keys))
                   (free ($ (nth j x) chain))
                   (free (cast (void *) ($ (nth j x) slots))))
                 (free (cast (void *) x))))))
        (free (-> st preds))
        (free (-> st tpreds))
        (free (-> st pred_buckets))
        (coco_code_table_clear st)
        (coco_code_retired_free st)
        (free (-> st code_keys))
        (free (-> st code_vals))
        (free (-> st cells))
        (free (-> st roots))
        ;; the globals go with the cells they index -- nothing outside this
        ;; store could read them once `cells' is gone -- and so does the
        ;; hash that finds them
        (free (-> st globals))
        (free (-> st gbuckets))
        ;; and the files read into it, whose clauses are gone with it
        (for ((size_t i . 0)) (< i (-> st nloads)) ((++ i))
          (free ($ (nth i (-> st loads)) path)))
        (free (cast (void *) (-> st loads)))
        (memset st 0 (sizeof coco_store)))

  (func coco_store_loaded ((coco_store * st) (const char * path) (double * t)) (out int)
        (for ((size_t i . 0)) (< i (-> st nloads)) ((++ i))
          (if (== 0 (strcmp ($ (nth i (-> st loads)) path) path))
              (block (if (!= t nil) (set (cof t) ($ (nth i (-> st loads)) time)))
                     (return 1))))
        (return 0))

  ;;; A WRITE TO THE ONE STORE, so it takes the green barrier (2.9.0): two
  ;;; tasks consulting at once would otherwise grow the array under each
  ;;; other.
  (func coco_store_note_load ((coco_store * st) (const char * path) (double t)) (out int)
        (with-green-write nil
          (for ((size_t i . 0)) (< i (-> st nloads)) ((++ i))
            (if (== 0 (strcmp ($ (nth i (-> st loads)) path) path))
                (block (set ($ (nth i (-> st loads)) time) t) (return 1))))
          (let ((char * copy . #'(strdup path)))
            (if (== copy nil) (return 0))
            (if (not (coco_store_grow st (cast (void **) (aof (-> st loads)))
                                    (aof (-> st load_cap)) (+ (-> st nloads) 1)
                                    (sizeof coco_loaded)))
                (block (free copy) (return 0)))
            (set ($ (nth (-> st nloads) (-> st loads)) path) copy)
            (set ($ (nth (-> st nloads) (-> st loads)) time) t)
            (set (-> st nloads) (+ (-> st nloads) 1))
            (return 1))))

  ;;; A PRIVATE ENGINE STORE'S HIGH-WATER MARK. `pst'/`bst' are reused
  ;;; between calls, so their length is enough for correctness -- but a
  ;;; findall that once held three million solutions would otherwise keep
  ;;; that array until the engine dies. Past a small threshold, an empty
  ;;; store gives its cell array back; the next put allocates a fresh one.
  (func coco_store_shrink_empty ((coco_store * st))
        (if (and (== (-> st len) 0) (> (-> st cap) 65536))
            (block
             (free (-> st cells))
             (set (-> st cells) nil)
             (set (-> st cap) 0)
             (set (-> st mark) 0)
             (set (-> st dead) 0))))

  (func coco_store_mute ((coco_store * st))   (set (-> st muted) (+ (-> st muted) 1)))
  (func coco_store_unmute ((coco_store * st)) (if (> (-> st muted) 0)
                                              (set (-> st muted) (- (-> st muted) 1))))
  (func coco_store_is_muted ((coco_store * st)) (out int) (return (? (> (-> st muted) 0) 1 0)))

  (func coco_store_reset ((coco_store * st))
        (let ((void * ctx . #'(-> st ctx)))
          ;; The hooks are copied out and back through locals of their own
          ;; declared type -- a `func' clause in type position is a function
          ;; pointer, which is how a variable holds one.
          (let ((func keep_fetch ((coco_store * s) (void * c) (u64 n) (u32 a)) (out int)
                      . #'(-> st fetch))
                (func keep_assert ((coco_store * s) (void * c) (size_t cl)) (out int)
                      . #'(-> st on_assert))
                (func keep_retract ((coco_store * s) (void * c) (size_t pi)) (out int)
                      . #'(-> st on_retract))
                (func keep_warm ((coco_store * s) (void * c)) (out int)
                      . #'(-> st warm))
                (func keep_dynamic ((coco_store * s) (void * c) (size_t pi)) (out int)
                      . #'(-> st on_dynamic))
                (func keep_tput ((coco_store * s) (void * c) (const char * nm)
                                 (i64 sq) (const double * v) (u32 n)) (out int)
                      . #'(-> st tensor_put))
                (func keep_trow ((coco_store * s) (void * c) (const char * nm)
                                 (i64 sq) (double * o) (u32 cap) (u32 * n)) (out int)
                      . #'(-> st tensor_row))
                (func keep_tforget ((coco_store * s) (void * c) (const char * nm)) (out int)
                      . #'(-> st tensor_forget))
                (func keep_halt ((coco_store * s) (void * c) (int cd) (int kp)) (out int)
                      . #'(-> st on_halt)))
            (coco_store_free st)
            (coco_store_init st)
            (set (-> st ctx) ctx)
            (set (-> st fetch) keep_fetch)
            (set (-> st on_assert) keep_assert)
            (set (-> st on_retract) keep_retract)
            (set (-> st warm) keep_warm)
            (set (-> st on_dynamic) keep_dynamic)
            (set (-> st tensor_put) keep_tput)
            (set (-> st tensor_row) keep_trow)
            (set (-> st tensor_forget) keep_tforget)
            (set (-> st on_halt) keep_halt))))

  (static)
  (func coco_store_push ((coco_store * st) (u64 c)) (out size_t)
        (if (not (coco_store_grow st (cast (void **) (aof (-> st cells)))
                                (aof (-> st cap)) (+ (-> st len) 1) (sizeof u64)))
            (return 0))
        (set (nth (-> st len) (-> st cells)) c)
        (set (-> st len) (+ (-> st len) 1))
        (return (- (-> st len) 1)))

  (static)
  (func coco_store_new_var ((coco_store * st)) (out size_t)
        (let ((size_t i . #'(coco_store_push st 0)))
          (set (nth i (-> st cells)) (coco-cell REF i))
          (return i)))

  ;;; ---- moving terms between the heap and the store --------------------
  ;;; Both directions are the reserve-then-fill walk `coco_copy' uses, for the
  ;;; same reason: an argument cannot be written where it will end up, because
  ;;; building it pushes.

  ;;; BOTH WALKS ARE ITERATIVE, like `coco_copy''s -- see the frame struct in
  ;;; term.cicili for the story: a recursion here is one C frame per argument,
  ;;; so one per cons cell, and `assert' or `findall' of a 100000-element list
  ;;; overflowed the C stack and segfaulted. The driver drops a frame as its
  ;;; last argument is issued, so a list runs in a handful of frames.

  (static)
  (func coco_store_put_node ((coco_store * st) (coco_machine * m) (size_t t)
                             (coco_varmap * vm) (coco_copyframe ** fs)
                             (size_t * flen) (size_t * fcap))
        (out size_t)
        (set t (coco_deref m t))
        (let ((u64 c . #'(nth t (-> m heap))))
          (cond
            ((coco-tag-is REF c)
             (let ((size_t to . 0))
               (if (coco_varmap_get vm t (aof to)) (return to))
               (set to (coco_store_new_var st))
               (set (-> st put_vars) 1)
               (coco_varmap_put vm t to)
               (return to)))
            ((coco-tag-is FUN c)
             (let ((u32 n . #'(coco_arity m t))
                   (size_t h . #'(coco_store_push st c)))
               ;; PAST THE CEILING (1.10.19): the walk stops, no frame left,
               ;; and `coco_store_put' asks why. Asked before the slots, so
               ;; nothing it reads lives across their loop
               (if (> h (-> m wceil))
                   (block (set (-> m wceil) 0) (set (cof flen) 0) (return h)))
               (for ((u32 i . 0)) (< i n) ((++ i)) (coco_store_new_var st))
               (if (> n 0)
                   (if (not (coco_frames_push fs flen fcap t (+ h 1) n))
                       (set (-> st oom) 1)))
               (return h)))
            ;; A float's payload indexes the machine's float table, which the
            ;; store shares rather than copies -- the heap collector reclaims
            ;; an entry only when no cell anywhere names it, the store's
            ;; included (`coco_tables_reclaim', 1.9.6), so the index stays good
            ;; for as long as the cell does.
            (#t (return (coco_store_push st c))))))

  (static)
  (func coco_store_put_walk ((coco_store * st) (coco_machine * m) (size_t t)) (out size_t)
        (let ((coco_varmap vm . '{ nil nil 0 0 0 })
              (coco_copyframe * fs . nil) (size_t flen . 0) (size_t fcap . 0)
              (size_t r . 0))
          (coco_varmap_take m (aof vm))
          (set fs (cast (coco_copyframe *) (coco_wframes_take m (aof fcap))))
          (set r (coco_store_put_node st m t (aof vm) (aof fs) (aof flen) (aof fcap)))
          (while (> flen 0)
            (let ((size_t fi . #'(- flen 1)))
              (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n))
                  (block (set flen fi) continue))
              (let ((size_t src . #'(coco_arg m ($ (nth fi fs) src)
                                             ($ (nth fi fs) i)))
                    (size_t slot . #'(+ ($ (nth fi fs) dst)
                                        (cast size_t ($ (nth fi fs) i)))))
                (set ($ (nth fi fs) i) (+ ($ (nth fi fs) i) 1))
                (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n)) (set flen fi))
                (let ((size_t a . #'(coco_store_put_node st m src (aof vm)
                                                         (aof fs) (aof flen) (aof fcap))))
                  (set (nth slot (-> st cells)) (coco-cell REF a))))))
          (coco_wframes_give m (cast (void *) fs) fcap)
          (coco_varmap_give m (aof vm))
          (return r)))

  ;;; THE PUT, UNDER A CEILING (1.10.19). A tree on the heap takes at most
  ;;; twice its cells in the store (a variable, or an atom in an argument,
  ;;; is a slot and a cell of its own), so a put gone past twice the heap's
  ;;; length is of a cycle -- which it would follow for ever, as findall/3,
  ;;; nb_setval/2 and assert did through 1.10.18 -- or of a DAG, which it
  ;;; copies whole as it always has. The ceiling is one compare a compound;
  ;;; past it the store is wound back to where the put began and
  ;;; `coco_acyclic' says which. A cycle goes in as its factors,
  ;;; `'$cyclic'(Template, [V1=T1, ...])' (`coco_factorize', built on the
  ;;; heap and the heap wound back after), `cyc_puts' counts it, and
  ;;; `coco_store_read' makes it cyclic again; `coco_assert_from' refuses
  ;;; it. A cycle the heap cannot hold the factors of goes in as the atom
  ;;; `$cyclic', which is no hang. The slow path is a function of its own,
  ;;; NOT STATIC, so it stays out of the put: it holds two more copies of
  ;;; the walk.
  (func coco_store_put_over ((coco_store * st) (coco_machine * m) (size_t t)
                             (size_t base)) (out size_t)
        (set (-> st len) base)
        (set (-> m wceil) (cast size_t -1))
        (if (== 1 (coco_acyclic m t)) (return (coco_store_put_walk st m t)))
        (let ((size_t mark . #'(-> m heap_len))
              (size_t * vars . nil) (size_t nv . 0)
              (size_t f . #'(coco_factorize m t "$cyclic" (aof vars) (aof nv)))
              (size_t r . 0))
          (free vars)
          (if (== f 0) (set f (coco_new_atom m "$cyclic")))
          (set r (coco_store_put_walk st m f))
          (set (-> m heap_len) mark)
          (set (-> m cyc_puts) (+ (-> m cyc_puts) 1))
          (return r)))

  (func coco_store_put ((coco_store * st) (coco_machine * m) (size_t t)) (out size_t)
        (let ((defer () coco_g_write_end_cleanup)
              (int began . 0))
          ;; A PRIVATE STORE IS ONE ENGINE'S OWN: its cells are read by that
          ;; engine and no other, so a put is not a stop-the-world write.
          ;; The shared store keeps the barrier it has always had.
          (if (== (-> st private) 0)
              (set began (coco_g_write_begin nil)))
          (let ((size_t base . #'(-> st len))
                (size_t r . 0))
            (set (-> st put_vars) 0)
            (set (-> m wceil) (+ base (+ (* (-> m heap_len) 2) 64)))
            (set r (coco_store_put_walk st m t))
            (if (== (-> m wceil) 0) (set r (coco_store_put_over st m t base)))
            (if (-> st memreq) (coco_store_memreq st m))
            (return r))))

  ;;; The store's own dereference: a reserved argument slot is a REF to
  ;;; where the argument was put, and an unbound store variable points at
  ;;; itself. Nothing else in the store is ever a chain.
  (static)
  (func coco_store_deref ((coco_store * st) (size_t s)) (out size_t)
        (while (coco-tag-is REF (nth s (-> st cells)))
          (let ((size_t next . #'(cast size_t (coco-payload (nth s (-> st cells))))))
            (if (== next s) (return s))
            (set s next)))
        (return s))

  ;;; THE STORE-TO-HEAP COPY, in one loop. The root is pushed, and every
  ;;; compound met puts a frame on the walk stack -- its store index, its
  ;;; first heap slot, its arity, how many slots are done -- and the loop
  ;;; takes the frames' arguments one at a time, so a list's depth is never
  ;;; the C stack's. Two things make it cheap per cell:
  ;;;
  ;;; A VARIABLE MET FIRST LIVES IN ITS SLOT. The slot `coco_push_struct'
  ;;; reserved is already an unbound variable (a REF to itself), so the
  ;;; copy maps the store variable to the SLOT and pushes nothing; met
  ;;; again, the slot is pointed at that. The copy of `f(X, X)' is three
  ;;; cells, as `coco_make' would build it. Binding such a variable writes
  ;;; the slot, which is what binding any argument variable does.
  ;;;
  ;;; THE MAP IS PROBED ONCE per occurrence (`coco_varmap_intern'): found,
  ;;; or entered, in the one walk down the chain.
  (func coco_store_get_vm ((coco_machine * m) (coco_store * st) (size_t t)
                           (coco_varmap * vm)) (out size_t)
        (let ((coco_copyframe * fs . nil) (size_t flen . 0) (size_t fcap . 0)
              (size_t r . 0) (u64 c . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          ;; the root: a variable, an atom or number, or a compound
          (if (coco-tag-is REF c)
              (let ((size_t to . 0) (size_t v . #'(coco_new_var m)))
                (if (== 1 (coco_varmap_intern vm t v (aof to)))
                    (block (set ($ (cof m) heap_len) v) (return to)))
                (return v)))
          (if (not (coco-tag-is FUN c)) (return (coco_push m c)))
          (set fs (cast (coco_copyframe *) (coco_wframes_take m (aof fcap))))
          (let ((u32 n . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity)))
            (set r (coco_push_struct m c n))
            (if (> n 0)
                (if (not (coco_frames_push (aof fs) (aof flen) (aof fcap) t (+ r 1) n))
                    (set (-> m oom) 1))))
          (while (> flen 0)
            (let ((size_t fi . #'(- flen 1)))
              (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n))
                  (block (set flen fi) continue))
              (let ((size_t src . #'(coco_store_deref st (+ ($ (nth fi fs) src)
                                                           (+ (cast size_t ($ (nth fi fs) i)) 1))))
                    (size_t slot . #'(+ ($ (nth fi fs) dst)
                                        (cast size_t ($ (nth fi fs) i))))
                    (u64 cs . 0))
                (set ($ (nth fi fs) i) (+ ($ (nth fi fs) i) 1))
                (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n)) (set flen fi))
                (set cs (nth src (-> st cells)))
                (cond
                  ((coco-tag-is REF cs)
                   ;; first met: the slot IS the variable; met again: point
                   ;; the slot at the one it became
                   (let ((size_t to . 0))
                     (if (== 1 (coco_varmap_intern vm src slot (aof to)))
                         (coco_set_arg m slot to))))
                  ((coco-tag-is FUN cs)
                   (let ((u32 nn . #'($ (nth (cast size_t (coco-payload cs)) (-> m functors)) arity))
                         (size_t hh . #'(coco_push_struct m cs nn)))
                     (coco_set_arg m slot hh)
                     (if (> nn 0)
                         (if (not (coco_frames_push (aof fs) (aof flen) (aof fcap) src (+ hh 1) nn))
                             (set (-> m oom) 1)))))
                  (#t (coco_set_arg m slot (coco_push m cs)))))))
          (coco_wframes_give m (cast (void *) fs) fcap)
          (return r)))

  (func coco_store_get ((coco_machine * m) (coco_store * st) (size_t t)) (out size_t)
        (let ((coco_varmap vm . '{ nil nil 0 0 0 })
              (size_t r . 0))
          (coco_varmap_take m (aof vm))
          (set r (coco_store_get_vm m st t (aof vm)))
          (coco_varmap_give m (aof vm))
          (return r)))

  (func coco_store_read ((coco_machine * m) (coco_store * st) (size_t t)) (out size_t)
        (let ((size_t r . #'(coco_store_get m st t)))
          (if (== (-> m cyc_puts) 0) (return r))
          (return (coco_unfactor m r))))

  (func coco_store_read_block ((coco_machine * m) (coco_store * st) (size_t t) (size_t size))
        (out size_t)
        (let ((size_t h . #'(-> m heap_len)))
          (if (or (== size 0)
                  (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                  (aof (-> m heap_cap)) (+ h size) (sizeof u64))))
              (return (coco_store_read m st t)))
          (memcpy (cast (void *) (aof (nth h (-> m heap))))
                  (cast (const void *) (aof (nth t (-> st cells))))
                  (* size (sizeof u64)))
          (for ((size_t i . h)) (< i (+ h size)) ((++ i))
            (let ((u64 c . #'(nth i (-> m heap))))
              (if (coco-tag-is REF c)
                  (set (nth i (-> m heap))
                       (coco-cell REF (+ (- (cast size_t (coco-payload c)) t) h))))))
          (set (-> m heap_len) (+ h size))
          (if (== (-> m cyc_puts) 0) (return h))
          (return (coco_unfactor m h))))

  ;;; THE STORE'S SPAN IS THE COPY'S LENGTH PLUS ONE CELL PER DISTINCT
  ;;; VARIABLE, which the map counted as it entered them: the put gave each
  ;;; one a cell besides its argument slot, and the copy gives it the slot
  ;;; alone. Every other cell has its twin -- a header, a slot, an atom or
  ;;; a number -- and a repeated variable has none on either side. A ROOT
  ;;; that is a variable is the one cell on both sides, so it is not
  ;;; counted twice. Until 1.8.48 the dead were counted at the copy's
  ;;; length, which was the span before the copy put a variable in its slot
  ;;; (1.8.43), and a store compacted later than it said.
  (func coco_store_get_span ((coco_machine * m) (coco_store * st) (size_t t)
                             (size_t * span)) (out size_t)
        (let ((coco_varmap vm . '{ nil nil 0 0 0 })
              (size_t mark . #'(-> m heap_len))
              (size_t r . 0))
          (coco_varmap_take m (aof vm))
          (set r (coco_store_get_vm m st t (aof vm)))
          (set (cof span) (+ (- (-> m heap_len) mark) ($ vm len)))
          (if (coco-tag-is REF (nth (coco_store_deref st t) (-> st cells)))
              (set (cof span) (- (cof span) 1)))
          (coco_varmap_give m (aof vm))
          (return r)))

  ;;; Three words per pending pair: the heap side, the other side, and
  ;;; which kind the other side is -- 0 a store index, 1 a heap index (a
  ;;; store variable met again brings the heap term it was mapped to).
  (static)
  (func coco_su_push ((coco_machine * m) (size_t ** wl) (size_t * wlen) (size_t * wcap)
                      (size_t a) (size_t b) (size_t kind)) (out int)
        (if (< (cof wcap) (+ (cof wlen) 3))
            (let ((size_t ncap . #'(? (== (cof wcap) 0) 96 (* (cof wcap) 2)))
                  (void * nb))
              (set nb (realloc (cast (void *) (cof wl)) (* ncap (sizeof size_t))))
              (if (== nb nil) (block (set (-> m oom) 1) (return 0)))
              (set (cof wl) (cast (size_t *) nb))
              (set (cof wcap) ncap)))
        (set (nth (cof wlen) (cof wl)) a)
        (set (nth (+ (cof wlen) 1) (cof wl)) b)
        (set (nth (+ (cof wlen) 2) (cof wl)) kind)
        (set (cof wlen) (+ (cof wlen) 3))
        (return 1))

  ;;; ITERATIVE, as `coco_unify' is, and for the same reason: a list's depth
  ;;; is its length. The pairs wait in the machine's pair stack, pushed
  ;;; right to left so the walk stays left to right. The heap-heap case is
  ;;; `coco_unify''s own, written out here so a repeated variable does not
  ;;; start a second walk with a worklist of its own.
  (func coco_store_unify ((coco_machine * m) (coco_store * st) (size_t a) (size_t s)
                          (coco_varmap * vm)) (out int)
        (let ((size_t * wl . nil) (size_t wlen . 0) (size_t wcap . 0)
              (size_t kind . 0) (int ok . 1) (int running . 1)
              ;; the pairs of heap compounds before a pair is `coco_unify''s,
              ;; whose walk links them (1.10.19): two cyclic terms a store
              ;; variable meets went round for ever. The store's side is a
              ;; tree, and ends
              (size_t budget . #'(-> m heap_len)))
          (set wl (coco_wpairs_take m (aof wcap)))
          (while (== running 1)
            (set a (coco_deref m a))
            (if (== kind 1)
                ;; ---- both on the heap: coco_unify's cases ----
                (block
                 (set s (coco_deref m s))
                 (if (!= a s)
                     (let ((u64 ca . #'(nth a (-> m heap)))
                           (u64 cb . #'(nth s (-> m heap))))
                       (cond
                         ((coco-tag-is REF ca)
                          (if (coco-tag-is REF cb)
                              (if (> a s) (coco_bind m a s) (coco_bind m s a))
                              (coco_bind m a s)))
                         ((coco-tag-is REF cb) (coco_bind m s a))
                         ((!= (coco-tag ca) (coco-tag cb)) (set ok 0))
                         ((coco-tag-is ATOM ca) (if (!= ca cb) (set ok 0)))
                         ((coco-tag-is INT ca)  (if (!= ca cb) (set ok 0)))
                         ((coco-tag-is FLT ca)
                          (if (not (coco_flt_eq m ca cb)) (set ok 0)))
                         ;; a rational is its reduced pair (2.5.0)
                         ((coco-tag-is RAT ca)
                          (if (not (and (coco-tag-is RAT cb) (coco_rat_eq m ca cb)))
                              (set ok 0)))
                         ;; a boxed integer by its value (2.0.0)
                         ((coco-tag-is BIG ca)
                          (if (not (coco-big-p cb))
                              (set ok 0)
                            (if (!= (nth (cast size_t (coco-payload ca)) (-> m bigs))
                                    (nth (cast size_t (coco-payload cb)) (-> m bigs)))
                                (set ok 0))))
                         ((coco-tag-is STR ca)
                          (if (not (coco_str_eq m ca cb)) (set ok 0)))
                         ((coco-tag-is FUN ca)
                          (cond
                            ((!= (coco-payload ca) (coco-payload cb)) (set ok 0))
                            ((== budget 0) (if (not (coco_unify m a s)) (set ok 0)))
                            (#t
                             (set budget (- budget 1))
                             (let ((u32 n . #'(coco_arity m a)))
                               (for ((u32 i . n)) (> i 0) ((set i (- i 1)))
                                    (let ((u32 j . #'(- i 1)))
                                      (if (not (coco_su_push m (aof wl) (aof wlen) (aof wcap)
                                                             (coco_arg m a j) (coco_arg m s j) 1))
                                          (set ok 0))))))))
                         (#t (set ok 0))))))
                ;; ---- heap against store ----
                (block
                 (set s (coco_store_deref st s))
                 (let ((u64 ca . #'(nth a (-> m heap)))
                       (u64 cs . #'(nth s (-> st cells))))
                   (cond
                     ;; a store variable: mapped to what it meets the first
                     ;; time, unified with that the next
                     ((coco-tag-is REF cs)
                      (let ((size_t to . 0))
                        (if (coco_varmap_get vm s (aof to))
                            (if (not (coco_su_push m (aof wl) (aof wlen) (aof wcap) a to 1))
                                (set ok 0))
                          (if (not (coco_varmap_put vm s a)) (set ok 0)))))
                     ;; an unbound heap variable against something: the
                     ;; something is copied now, through the shared map, and
                     ;; the variable bound to the copy
                     ((coco-tag-is REF ca)
                      (if (coco-tag-is FUN cs)
                          (coco_bind m a (coco_store_get_vm m st s vm))
                          (coco_bind m a (coco_push m cs))))
                     ((!= (coco-tag ca) (coco-tag cs)) (set ok 0))
                     ((coco-tag-is ATOM ca) (if (!= ca cs) (set ok 0)))
                     ((coco-tag-is INT ca)  (if (!= ca cs) (set ok 0)))
                     ((coco-tag-is FLT ca)
                      ;; the store shares the machine's float table by
                      ;; index; two floats are one by their bits (2.1.1)
                      (if (not (coco_flt_eq m ca cs)) (set ok 0)))
                     ;; a rational is its reduced pair (2.5.0)
                     ((coco-tag-is RAT ca)
                      (if (not (and (coco-tag-is RAT cs) (coco_rat_eq m ca cs)))
                          (set ok 0)))
                     ;; and its integer table (2.0.0)
                     ((coco-tag-is BIG ca)
                      (if (not (coco-big-p cs))
                          (set ok 0)
                        (if (!= (nth (cast size_t (coco-payload ca)) (-> m bigs))
                                (nth (cast size_t (coco-payload cs)) (-> m bigs)))
                            (set ok 0))))
                     ((coco-tag-is STR ca)
                      (if (not (coco_str_eq m ca cs)) (set ok 0)))
                     ((coco-tag-is FUN ca)
                      (if (!= (coco-payload ca) (coco-payload cs))
                          (set ok 0)
                          (let ((u32 n . #'(coco_arity m a)))
                            (for ((u32 i . n)) (> i 0) ((set i (- i 1)))
                                 (let ((u32 j . #'(- i 1)))
                                   ;; the store lays a compound out as the
                                   ;; heap does: the header, then its slots
                                   (if (not (coco_su_push m (aof wl) (aof wlen) (aof wcap)
                                                          (coco_arg m a j) (+ s (+ (cast size_t j) 1)) 0))
                                       (set ok 0)))))))
                     (#t (set ok 0))))))
            (if (or (== ok 0) (== wlen 0))
                (set running 0)
                (block
                  (set kind (nth (- wlen 1) wl))
                  (set s (nth (- wlen 2) wl))
                  (set a (nth (- wlen 3) wl))
                  (set wlen (- wlen 3)))))
          (coco_wpairs_give m wl wcap)
          (return ok)))

  (func coco_store_clause_parts ((coco_store * st) (coco_machine * m) (size_t clause)
                                 (u64 neck) (size_t * head) (size_t * body))
        (set clause (coco_store_deref st clause))
        (set (cof head) clause)
        (set (cof body) 0)
        (let ((u64 c . #'(nth clause (-> st cells))))
          (if (not (coco-tag-is FUN c)) (return))
          (let ((coco_functor * f . #'(aof (nth (cast size_t (coco-payload c)) (-> m functors)))))
            (if (or (!= (-> f arity) 2) (!= (-> f name) neck)) (return)))
          (set (cof head) (+ clause 1))
          (set (cof body) (+ clause 2))))

  ) ; impl-kb

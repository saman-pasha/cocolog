;;;; cocolog -- the missing core builtins, as a module
;;;
;;; SWI has 655 built-in predicates. Most of them cannot exist here and it is
;;; worth saying which and why rather than leaving a reader to discover it:
;;; everything stream-shaped (there is no `open/3', so nothing to answer with),
;;; everything module-shaped, threads, tabling, the foreign interface, and
;;; SWI's own `prolog_*' introspection. Strings are a fifth: cocolog reads
;;; "abc" as a code list, which is the ISO default, so `string_concat/3' and
;;; its family have no type to work on.
;;;
;;; WHAT IS LEFT IS THE ISO CORE, and that is what this module is. The set was
;;; computed rather than remembered: the ISO built-in predicates plus the SWI
;;; extras that everyone treats as core, minus the forty-eight cocolog already
;;; had. What remained is here.
;;;
;;; STILL MISSING AFTER THIS, and each for a reason rather than for want of
;;; time:
;;;
;;;   catch/3 and throw/1  -- a catch is a new kind of choice-point frame, and
;;;     every kind of frame has to be written into a frozen machine and read
;;;     back (state.cicili). It is the suspension format that makes this a
;;;     change rather than an addition, and it deserves its own.
;;;
;;;   bagof/3 and setof/3  -- not findall plus a sort. They BACKTRACK over the
;;;     bindings of the free variables of the goal, answering one group per
;;;     witness, and that needs the engine to enumerate the groups. Shipping
;;;     findall-and-sort under those names would be a predicate that agrees
;;;     with SWI until the first free variable and then quietly does not.
;;;
;;;   op/3 and current_op/3  -- the reader's operator table is emitted from
;;;     `*operators*' at build time, which is what keeps the reader and the
;;;     writer from disagreeing. A run-time table is a real change to
;;;     syntax.cicili and to what a frozen machine has to carry.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

(DEFPARAMETER *builtins-predicates*
  '(("findall"                 3 coco_b_findall)
    ("findall"                 4 coco_b_findall4)
    ("forall"                  2 coco_b_forall)
    ("aggregate_all"           3 coco_b_aggregate_all)
    ("call_limited"            3 coco_b_call_limited)
    ("call_metered"            4 coco_b_call_metered)
    ("$trace_window"           4 coco_b_trace_window)

    ("succ"                    2 coco_b_succ)
    ("plus"                    3 coco_b_plus)

    ("ground"                  1 coco_b_ground)
    ("acyclic_term"            1 coco_b_acyclic_term)
    ("cyclic_term"             1 coco_b_cyclic_term)
    ("term_variables"          2 coco_b_term_variables)
    ("unify_with_occurs_check" 2 coco_b_unify_occurs)

    ("atom_chars"              2 coco_b_atom_chars)
    ("char_code"               2 coco_b_char_code)
    ("number_chars"            2 coco_b_number_chars)
    ("atom_number"             2 coco_b_atom_number)
    ("upcase_atom"             2 coco_b_upcase)
    ("downcase_atom"           2 coco_b_downcase)
    ("term_to_atom"            2 coco_b_term_to_atom)
    ("$sub_atom"               5 coco_b_sub_atom_at)
    ("$atom_split"             3 coco_b_atom_split)
    ("$atom_join"              3 coco_b_atom_join)

    ("writeq"                  1 coco_b_writeq)
    ("write_term"              2 coco_b_write_term)
    ("tab"                     1 coco_b_tab)

    ("$clause"                 3 coco_b_clause_at)
    ("$pred_count"             3 coco_b_pred_count)
    ("$predicates"             1 coco_b_predicates)
    ("$pred_props"             2 coco_b_pred_props)
    ("abolish"                 1 coco_b_abolish)

    ("nb_setval"               2 coco_b_setval)
    ("nb_getval"               2 coco_b_getval)
    ("nb_current"              2 coco_b_nb_current :declines)
    ("$nb_keys"                1 coco_b_nb_keys)
    ("garbage_collect"         0 coco_b_garbage_collect)
    ("prewarm"                 1 coco_b_prewarm)
    ("statistics"              2 coco_b_statistics)
    ("$store_mute"             0 coco_b_store_mute)
    ("$store_unmute"           0 coco_b_store_unmute)
    ("b_setval"                2 coco_b_setval)
    ("b_getval"                2 coco_b_getval)

    ("with_output_to"          2 coco_b_with_output_to)

    ("getenv"                  2 coco_b_getenv)
    ("setenv"                  2 coco_b_setenv)
    ("unsetenv"                1 coco_b_unsetenv)

    ("format"                  1 coco_b_format1)
    ("format"                  2 coco_b_format2)
    ("format"                  3 coco_b_format3)
    ("flush_output"            0 coco_b_flush)

    ("code_type"               2 coco_b_code_type)
    ("char_type"               2 coco_b_char_type)

    ("op"                      3 coco_b_op)
    ("$ops"                    1 coco_b_ops)

    ("halt"                    1 coco_b_halt1)))

;;; THE C PREDICATES OF THE COMPILED-IN MODULES, for predicate_property/2
;;; (1.10.28): a module's dispatcher is all that knows its names and asking
;;; it is calling it, so the names come from the tables the dispatchers are
;;; built from. Expanded after every file is read (cocolog.cicili imports
;;; them all first), and a table a build left out is skipped. A module
;;; loaded from a `.so' has no table here and is not answered.
(DEFMACRO coco-emit-claims (fname &REST tables)
  (LET ((rows (LOOP FOR tbl IN tables
                    WHEN (BOUNDP tbl) APPEND (SYMBOL-VALUE tbl))))
    `(func ,fname ((const char * name) (u32 arity)) (out int)
       (cond
         ,@(MAPCAR (LAMBDA (row)
                     `((and (== arity ,(SECOND row)) (== 0 (strcmp name ,(FIRST row)))) (return 1)))
                   rows)
         (#t (return 0))))))

;;; THE CONTROL CONSTRUCTS A PROGRAM CALLS, by name AND arity, as SWI
;;; lists them: `*construct-names*' holds the engine's own markers too
;;; ('$k', [], ':-'), which are not predicates, and a name alone would
;;; make true/1 one.
(DEFPARAMETER *callable-constructs*
  '(("true" 0) ("fail" 0) ("false" 0) ("!" 0) ("trace" 0) ("notrace" 0)
    ("," 2) (";" 2) ("->" 2) ("*->" 2) ("\\+" 1) ("not" 1) ("once" 1) ("ignore" 1)
    ("call" 1) ("call" 2) ("call" 3) ("call" 4) ("call" 5) ("call" 6) ("call" 7) ("call" 8)
    ("catch" 3) ("throw" 1)))

(DEFPARAMETER *builtins-prolog*
  (FORMAT NIL "~{~A ~}"
          (LIST
           ;; ---- with_local_clauses/1 -----------------------------------
           ;;
           ;; What a module's clauses already get, asked for by a program:
           ;; inside Goal an `assertz' lands in THIS machine's store and is
           ;; not written through to the knowledge base. A worker holding a
           ;; turn's snapshot wants exactly that -- the state is transient,
           ;; it belongs to the machine proving with it, and writing it to
           ;; the database is both wrong and, under `--embed' with more than
           ;; one worker, a deadlock.
           ;;
           ;; IT UNMUTES ON ALL THREE WAYS OUT, which is the whole reason it
           ;; exists rather than the raw pair: a mute left on silently drops
           ;; every later write, and the program that finds out is the one
           ;; whose database is empty an hour later. The shape is
           ;; `with_mutex/2's, for the same reason.
           "with_local_clauses(G) :- '$store_mute', ( catch(G, E, true) -> '$store_unmute', ( nonvar(E) -> throw(E) ; true ) ; '$store_unmute', fail )."

           ;; ---- string/1 IS NOT HERE ------------------------------------
           ;;
           ;; It was `string(_) :- fail.', with a comment saying cocolog has
           ;; no string type. It has one -- a sixth cell tag, `STR' in
           ;; `*cell-tags*' -- and `string/1' is a C builtin in
           ;; lib/solve.cicili's `*builtins*' table, which SHADOWS a clause:
           ;; dispatch is construct, then C builtin, then module, then the
           ;; knowledge base, so a C-registered name never reaches the store.
           ;;
           ;; So the clause could not run, and it was not merely inert.
           ;; `listing(string/1)' printed `string(_):-fail.' and told a reader
           ;; the opposite of what the interpreter does, and the comment above
           ;; it was where MODULES.md got the claim that cocolog has no string
           ;; type. cocolint's own N2 rule is about exactly this shape: a
           ;; C-registered name given clauses is dead code that `listing/1'
           ;; will happily show.
           ;;
           ;; What the old comment was RIGHT about is why the predicate has to
           ;; exist at all: SWI's `string_without//2' asks `string(End)' to
           ;; decide whether to convert its argument and falls through to the
           ;; code-list clause when the answer is no. That still works -- the C
           ;; `string/1' answers false for a code list -- and the vendored
           ;; dcg/basics is gated on it.

           ;; ---- once/1 and ignore/1 ARE NOT HERE -------------------------
           ;;
           ;; They were, for a day, as `once(G) :- call(G), !.' and two
           ;; clauses for `ignore/1' -- which is how every Prolog textbook
           ;; writes them and is not where they belong in THIS interpreter.
           ;; Both are `(G -> true ; X)' with a different X, and cocolog has
           ;; an if-then-else construct in the engine already: they are two
           ;; lines in `lib/solve.cicili', beside `\\+', calling the same
           ;; `coco_ite'.
           ;;
           ;; WHAT THAT BUYS, beyond a frame and a `call' per invocation: the
           ;; goal gets its cut barrier FROM THE CONSTRUCT rather than from a
           ;; hand-written `!', which is what makes `once/1' opaque to cut the
           ;; way ISO 8.15.2 says -- and there is nothing left to get wrong.
           ;;
           ;; FOUND BY WRITING A TUTORIAL, either way. `tutorials/basics/05'
           ;; wanted to say "once/1 is a cut with a name, and reads better",
           ;; ran, and got `existence_error(procedure, once/1)'. Every Prolog
           ;; has had these for forty years; nothing in this interpreter had
           ;; needed them, which is exactly the kind of hole a suite of its
           ;; own tests cannot find.

           ;; ---- library(error): must_be/2 and is_of_type/2 ---------------
           ;;
           ;; NOT ITS OWN MODULE, and that is a judgement rather than an
           ;; oversight: two predicates do not earn a file, a registration and
           ;; a line in the build. They belong to `library(error)' and are
           ;; recorded as such in MODULES.md, so a later split has somewhere to
           ;; split from.
           ;;
           ;; THE ERROR IT RAISES IS NOT ALWAYS A TYPE ERROR. An unbound value
           ;; has no type to be wrong, so it is an instantiation error; `var'
           ;; is the one type a BOUND value fails, so it is an uninstantiation
           ;; error. test/files/must_be.pl holds all three against SWI.
           "must_be(Type, X) :- is_of_type(Type, X), !."
           "must_be(Type, X) :- '$must_be_failed'(Type, X)."

           ;; the two throwers library(error) exports that the vendored
           ;; libraries call by name -- ordsets.pl reaches type_error/2 and
           ;; assoc.pl domain_error/2 -- and compound_name_arity/3, which
           ;; assoc.pl's error:has_type(assoc, _) extension leans on.
           "type_error(Type, V) :- throw(error(type_error(Type, V), _))."
           "domain_error(Domain, V) :- throw(error(domain_error(Domain, V), _))."
           "instantiation_error(_) :- throw(error(instantiation_error, _))."
           "compound_name_arity(C, N, A) :- compound(C), functor(C, N, A)."
           "compound_name_arguments(C, N, A) :- compound(C), !, C =.. [N|A]."
           "compound_name_arguments(C, N, A) :- C =.. [N|A], compound(C)."

           ;; what library(yall) reaches. Attributed variables do not exist
           ;; here, so the attribute-blind copy IS the copy; and with one
           ;; namespace, stripping a module qualifier is peeling `:'s.
           "copy_term_nat(T, C) :- copy_term(T, C)."
           ;; cyclic_term/1 and acyclic_term/1, which lambda_calls/3 asks
           ;; defensively before walking a term, are C above (1.10.18)
           "strip_module(T, M, G) :- '$strip_module'(T, user, M, G)."
           "'$strip_module'(T, _, M, G) :- nonvar(T), T = W:T1, !, '$strip_module'(T1, W, M, G)."
           "'$strip_module'(G, W, W, G)."
           "'$must_be_failed'(var, X) :- !, throw(error(uninstantiation_error(X), _))."
           "'$must_be_failed'(ground, _) :- !, throw(error(instantiation_error, _))."
           "'$must_be_failed'(_, X) :- var(X), !, throw(error(instantiation_error, _))."
           ;; A LIST OF THE WRONG THING NAMES THE ELEMENT, not the list. SWI
           ;; answers `type_error(char, 97)' for `must_be(chars, [97])' -- which
           ;; is the useful half of the message, and the half a caller cannot
           ;; work out from `type_error(chars, [97])'.
           "'$must_be_failed'(chars, X) :- is_list(X), '$bad_elem'(X, char, B), !,"
           "    throw(error(type_error(char, B), _))."
           "'$must_be_failed'(codes, X) :- is_list(X), '$bad_elem'(X, code, B), !,"
           "    throw(error(type_error(code, B), _))."
           "'$must_be_failed'(Type, X) :- throw(error(type_error(Type, X), _))."
           "'$bad_elem'([X|_], T, X) :- \\+ is_of_type(T, X), !."
           "'$bad_elem'([_|Xs], T, B) :- '$bad_elem'(Xs, T, B)."

           "is_of_type(any, _)."
           "is_of_type(var, X) :- var(X)."
           "is_of_type(nonvar, X) :- nonvar(X)."
           "is_of_type(ground, X) :- ground(X)."
           "is_of_type(atom, X) :- atom(X)."
           "is_of_type(atomic, X) :- atomic(X)."
           "is_of_type(callable, X) :- callable(X)."
           "is_of_type(compound, X) :- compound(X)."
           "is_of_type(integer, X) :- integer(X)."
           "is_of_type(float, X) :- float(X)."
           "is_of_type(number, X) :- number(X)."
           "is_of_type(boolean, X) :- (X == true ; X == false), !."
           "is_of_type(nonneg, X) :- integer(X), X >= 0."
           "is_of_type(positive_integer, X) :- integer(X), X > 0."
           "is_of_type(negative_integer, X) :- integer(X), X < 0."
           "is_of_type(oneof(L), X) :- ground(X), memberchk(X, L)."
           "is_of_type(between(L, H), X) :- number(X), X >= L, X =< H."
           "is_of_type(list, X) :- is_list(X)."
           "is_of_type(proper_list, X) :- is_list(X)."
           "is_of_type(list_or_partial_list, X) :- '$partial_list'(X)."
           ;; a char is a ONE-character atom and a code a non-negative
           ;; integer -- `[ab]' is not a list of chars and `[-1]' not one of
           ;; codes, which is what makes the element-naming above worth having
           "is_of_type(char, X) :- atom(X), atom_length(X, 1)."
           "is_of_type(code, X) :- integer(X), X >= 0."
           "is_of_type(chars, X) :- is_list(X), '$all_of'(X, char)."
           "is_of_type(codes, X) :- is_list(X), '$all_of'(X, code)."
           "is_of_type(text, X) :- (atom(X) ; is_list(X)), !."
           "'$all_of'([], _)."
           "'$all_of'([X|Xs], T) :- is_of_type(T, X), '$all_of'(Xs, T)."
           "'$partial_list'(X) :- var(X), !."
           "'$partial_list'([])."
           "'$partial_list'([_|T]) :- '$partial_list'(T)."

           ;; ---- between/3, which enumerates and so must be clauses --------
           "between(L, H, X) :- integer(X), !, X >= L, X =< H."
           "between(L, H, L) :- L =< H."
           "between(L, H, X) :- L < H, M is L + 1, between(M, H, X)."

           ;; ---- clause/2, over the primitive that answers by position -----
           ;; The count is taken once and the position enumerated, so a clause
           ;; asserted while this is backtracking does not shift the ones after
           ;; it under the cursor -- which is the hazard `retract' has always
           ;; had against a running query, and is written down in STATUS.md.
           "clause(H, B) :- '$pred_count'(H, N, _), N > 0, between(1, N, I), '$clause'(H, B, I)."

           ;; ---- current_predicate/1 ---------------------------------------
           "current_predicate(N/A) :- '$predicates'(L), '$cp_member'(N/A, L)."
           "'$cp_member'(X, [X|_])."
           "'$cp_member'(X, [_|T]) :- '$cp_member'(X, T)."

           ;; ---- nb_current/2 with its key unbound (1.12.0) ---------------
           ;; The C half answers a bound key in one step and declines an
           ;; unbound one, which enumerates, to this clause
           "nb_current(K, V) :- '$nb_keys'(Ks), '$cp_member'(K, Ks), nb_getval(K, V)."

           ;; ---- predicate_property/2 (1.10.28) -----------------------------
           ;; A head names one predicate, whose properties the C half lists;
           ;; an unbound head walks current_predicate/1's, the program's.
           ;; M:H is H (one namespace), so user:H walks them too.
           "predicate_property(H, P) :- nonvar(H), H = _:G, !, predicate_property(G, P)."
           "predicate_property(H, P) :- nonvar(H), !, '$pred_props'(H, Ps), '$cp_member'(P, Ps)."
           "predicate_property(H, P) :- current_predicate(N/A), functor(H, N, A), '$pred_props'(H, Ps), '$cp_member'(P, Ps)."

           ;; ---- retractall/1 ----------------------------------------------
           ;;
           ;; RECURSION, NOT A FAILURE-DRIVEN LOOP, and the difference is a bug
           ;; this predicate carried in silence. It used to be
           ;;
           ;;     retractall(H) :- retract(H), fail.
           ;;     retractall(_).
           ;;
           ;; with a comment saying that was "the only way to do it with a
           ;; deterministic retract" -- which has it exactly backwards. A
           ;; failure-driven loop iterates by BACKTRACKING INTO its goal, so it
           ;; needs a retract that answers many times. Ours answers once, like
           ;; every builtin here, so `fail' had nothing to go back into: the
           ;; first clause removed ONE clause and gave up, the second clause
           ;; succeeded, and `retractall(p(_))' left every p but the first
           ;; where it was, answering `true' about it.
           ;;
           ;; FOUND BY WRITING A TUTORIAL -- `tutorials/basics/07', which
           ;; retracts three facts and counts what is left. Nothing in the
           ;; suite had ever called `retractall/1' on a predicate with more
           ;; than one clause and then LOOKED.
           ;;
           ;; `copy_term' IS WHAT MAKES THE RECURSION WORK. A successful
           ;; retract binds the variables in its argument -- `retractall(p(_))'
           ;; would come back with the `_' bound to the first clause's value --
           ;; so recursing on that term would then match only clauses like the
           ;; one already gone. The copy is retracted; the original stays open.
           ;;
           ;; AND THE BODY IS ASKED FOR OPEN, deliberately. When `retract/1'
           ;; learned to respect the body (kb.cicili: the shorthand is
           ;; `(H :- true)', a CivV capture's finding), riding the shorthand
           ;; here would have quietly narrowed retractall to true-bodied
           ;; clauses -- while SWI's retractall removes EVERY clause whose
           ;; head unifies, rules included. `(C :- _)' is that contract,
           ;; spelled out.
           "retractall(H) :- copy_term(H, C), retract((C :- _)), !, retractall(H)."
           "retractall(_)."

           ;; ---- sub_atom/5, which enumerates every substring ---------------
           ;; The C half answers ONE substring given where it starts and how
           ;; long it is; the enumeration is here, where the engine can make
           ;; the choice points. The bound-Sub case is separated out because
           ;; enumerating every B and L to find a known substring is O(n^2)
           ;; when a search is O(n).
           "sub_atom(A, B, L, Aft, Sub) :- atom(Sub), !, atom_length(A, N), atom_length(Sub, L), Max is N - L, between(0, Max, B), '$sub_atom'(A, B, L, Aft, Sub)."
           "sub_atom(A, B, L, Aft, Sub) :- atom_length(A, N), between(0, N, B), Rest is N - B, between(0, Rest, L), '$sub_atom'(A, B, L, Aft, Sub)."

           ;; ---- sub_string/5 ------------------------------------------------
           ;; THE SAME ENUMERATION AS sub_atom/5, ANSWERING A STRING. It is
           ;; here and not in C for the reason string_concat/3's comment
           ;; gives: SWI backtracks over every way of cutting a string, and a
           ;; C builtin in this engine answers once. The engine makes the
           ;; choice points, so the enumeration lives where the engine is.
           ;;
           ;; Sub is matched as TEXT, so a string, an atom or a number all
           ;; work in that position -- which is SWI's rule for every text
           ;; argument.
           ;;
           ;; NO BACKSLASH-QUOTE IN THIS COMMENT, and that is not a style
           ;; note. The blocklist's shape-2 scanner reads every string literal
           ;; inside a *X-prolog* DEFPARAMETER and does NOT skip line
           ;; comments, so an escaped quote written here starts a string it
           ;; never meant to and every literal after it is read at the wrong
           ;; boundary. It invented three tier-1 names -- sink/0, spec/0,
           ;; ty/0 -- and lost sub_string/5, which the store probe caught
           ;; because the store had never heard of the three. Written once
           ;; with the escape IN the warning, which cost a second round.
           "sub_string(S, B, L, Aft, Sub) :- nonvar(Sub), !, string_length(S, N), string_length(Sub, L), Max is N - L, between(0, Max, B), '$sub_string'(S, B, L, Aft, Sub)."
           "sub_string(S, B, L, Aft, Sub) :- string_length(S, N), between(0, N, B), Rest is N - B, between(0, Rest, L), '$sub_string'(S, B, L, Aft, Sub)."
           "'$sub_string'(S, B, L, Aft, Sub) :- string_codes(S, Cs), length(Pre, B), append(Pre, Mid, Cs), length(Mid, ML), MidL is ML, length(SubCs, L), append(SubCs, Post, Mid), length(Post, Aft), string_codes(Sub0, SubCs), sub_string_same(Sub, Sub0), MidL >= L."
           ;; Sub may arrive as a string, an atom or a number; compare the text.
           "sub_string_same(Sub, Sub0) :- var(Sub), !, Sub = Sub0."
           "sub_string_same(Sub, Sub0) :- string(Sub), !, Sub == Sub0."
           "sub_string_same(Sub, Sub0) :- atom_string(Sub, S1), S1 == Sub0."

           ;; ---- atomic_list_concat/2,3 -------------------------------------
           ;; With a separator and an unbound list it SPLITS, which is the mode
           ;; everybody actually uses it in.
           ;;
           ;; A LIST THAT IS MERELY NOT GROUND SPLITS TOO, which is SWI's rule
           ;; and was not this one: only a bare variable did, so
           ;; `atomic_list_concat([A,B], -, 'x-y')' -- the shape a caller
           ;; writes when it knows how many parts it wants -- went to the JOIN
           ;; and raised instantiation_error about its own output. The third
           ;; argument decides: bound, and the list not ground, means split.
           "atomic_list_concat(L, A) :- '$atom_join'(L, '', A)."
           "atomic_list_concat(L, Sep, A) :- var(L), !, '$atom_split'(A, Sep, L)."
           "atomic_list_concat(L, Sep, A) :- nonvar(A), \\+ ground(L), !, '$atom_split'(A, Sep, L)."
           "atomic_list_concat(L, Sep, A) :- '$atom_join'(L, Sep, A)."

           ;; ---- current_op/3 -----------------------------------------------
           ;; Enumerating is backtracking, so the C half hands over the whole
           ;; table at once and `member/2' does the rest -- the same shape
           ;; `current_predicate/1' has, and for the same reason.
           "current_op(P, T, N) :- '$ops'(L), '$cp_member'(op(P, T, N), L)."

           ;; ---- keysort/2 --------------------------------------------------
           ;; Sorting by the key and keeping duplicates, stably, is exactly
           ;; what `sort/4' at key 1 with `@=<' does -- and stability is not
           ;; incidental here: `bagof/3' groups by the key and the order within
           ;; a group is the order the solutions came in.
           "keysort(L, S) :- sort(1, @=<, L, S)."

           ;; ---- bagof/3 and setof/3 ----------------------------------------
           ;;
           ;; NOT findall PLUS A SORT. They BACKTRACK, answering one solution
           ;; per distinct binding of the goal's FREE VARIABLES -- the ones
           ;; that appear in the goal, do not appear in the template, and were
           ;; not existentially quantified with `^'. `bagof(X, p(X,Y), L)' over
           ;; p(1,a), p(2,b), p(3,a) answers three times: Y=a with [1,3], then
           ;; Y=b with [2], then Y=c with [1].
           ;;
           ;; The whole of it is: work out the witness, collect Witness-Template
           ;; pairs with findall, sort them by witness, group the runs, and hand
           ;; the groups to `member/2' -- which is where the backtracking comes
           ;; from, and is why this is clauses and not C.
           ;;
           ;; AND THEY FAIL ON NO SOLUTIONS, where findall answers []. That is
           ;; the other half of what makes them different predicates.

           ;; `V^Goal' peeled off, however deep, with the quantified variables
           ;; collected as they go.
           "'$carets'(G, G2, Ex) :- nonvar(G), G = (V^G1), !, '$carets'(G1, G2, Ex1), Ex = [V|Ex1]."
           "'$carets'(G, G, [])."

           ;; membership and subtraction BY IDENTITY: these are variables, and
           ;; two distinct free variables unify with each other while being
           ;; different witnesses entirely.
           "'$var_in'(X, [Y|_]) :- X == Y, !."
           "'$var_in'(X, [_|T]) :- '$var_in'(X, T)."
           "'$vars_minus'([], _, [])."
           "'$vars_minus'([H|T], L, R) :- ( '$var_in'(H, L) -> R = R1 ; R = [H|R1] ), '$vars_minus'(T, L, R1)."

           "'$witness'(T, G0, G, W) :- '$carets'(G0, G, Ex), term_variables(G, GV), term_variables(T, TV), term_variables(Ex, EV), '$vars_minus'(GV, TV, V1), '$vars_minus'(V1, EV, W)."

           ;; runs of equal keys become one group. The keys are compared with
           ;; `==' and not `=': unifying them would merge two groups whose
           ;; witnesses merely happen to unify.
           "'$group'([], [])."
           "'$group'([K-V|T], [K-[V|Vs]|R]) :- '$same_key'(K, T, Vs, T1), '$group'(T1, R)."
           "'$same_key'(K, [K1-V|T], [V|Vs], T1) :- K1 == K, !, '$same_key'(K, T, Vs, T1)."
           "'$same_key'(_, T, [], T)."

           "bagof(T, G0, B) :- '$witness'(T, G0, G, W), '$bagof'(W, T, G, B)."
           ;; no free variables: one answer, and it is findall's -- except that
           ;; an empty one is a failure
           "'$bagof'([], T, G, B) :- !, findall(T, G, B), B \\== []."
           "'$bagof'(W, T, G, B) :- Wt =.. ['$w'|W], findall(Wt-T, G, Pairs), Pairs \\== [], keysort(Pairs, Sorted), '$group'(Sorted, Groups), member(Wt-B, Groups)."

           ;; setof is bagof with the group sorted, which also removes its
           ;; duplicates -- and the groups themselves already arrive in witness
           ;; order because keysort put them there.
           "setof(T, G, S) :- bagof(T, G, B), sort(B, S)."

           ;; ---- print/1 is write/1 here; SWI routes it through portray -----
           "print(X) :- write(X)."

           ;; ---- atom_string-free helpers the tests lean on -----------------
           "atom_chars_list(A, L) :- atom_chars(A, L).")))

(generic decl-builtins
  ()

  (decl) (func coco_builtins_module () (out int))

  ) ; decl-builtins


(generic impl-builtins
  ()

  ;;; Declared before they are used: `aggregate_all' reaches the sort, and the
  ;;; two recursive term walks call themselves through a name that has to
  ;;; exist first.
  (static) (decl) (func coco_b_is_ground ((coco_machine * m) (size_t t)) (out int))
  (static) (decl) (func coco_b_collect_vars ((coco_machine * m) (size_t t) (int seen)
                                           (size_t ** v) (size_t * n) (size_t * cap)) (out int))
  (static) (decl) (func coco_b_atom_to_number ((coco_engine * e) (const char * text)
                                             (size_t to)) (out int))
  (static) (decl) (func coco_b_text_dup ((coco_engine * e) (size_t t)) (out char *))
  (static) (decl) (func coco_b_sort_terms ((coco_machine * m) (size_t * v) (size_t n)))
  (static) (decl) (func coco_b_case ((coco_engine * e) (size_t g) (int up)) (out int))
  (static) (decl) (func coco_b_typename ((int type)) (out const char *))
  (static) (decl) (func coco_b_ops_push ((coco_engine * e) (size_t ** v) (size_t * n)
                                       (size_t * cap) (int dyn)))

  ;;; ---- all solutions ---------------------------------------------------

  ;;; 2 IS PASSED STRAIGHT THROUGH, in all four of these. It means the goal
  ;;; threw, a catch frame took the ball, and the engine is already pointed at
  ;;; that catch's recovery -- so answering anything else here would throw the
  ;;; recovery away. It used to be -1, which ended the whole query: a `throw'
  ;;; inside a findall, a forall or an aggregate_all was uncatchable.
  (func coco_b_findall ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t lst . 0)
              (int fr . #'(coco_engine_findall e (coco_m_arg e g 0)
                                               (coco_m_arg e g 1) (aof lst) (aof g))))
          (if (== fr 2) (return 2))
          (if (not fr) (return -1))
          (return (coco_m_unify e (coco_m_arg e g 2) lst))))

  ;;; `findall(T, G, L, Tail)' -- the difference list form. The collected list
  ;;; ends in Tail instead of `[]', which is what makes it appendable without
  ;;; walking it again.
  (func coco_b_findall4 ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t lst . 0) (size_t * v . nil) (size_t n . 0) (size_t out)
              (int fr . #'(coco_engine_findall e (coco_m_arg e g 0)
                                               (coco_m_arg e g 1) (aof lst) (aof g))))
          (if (== fr 2) (return 2))
          (if (not fr) (return -1))
          (if (not (coco_m_list_array e lst (aof v) (aof n))) (return 0))
          (set out (coco_m_arg e g 3))
          (for ((size_t i . n)) (> i 0) ((-- i))
            (set out (coco_cons m (nth (- i 1) v) out)))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 2) out))))

  ;;; ---- a goal under a ceiling ------------------------------------------
  ;;;
  ;;; `call_limited(Goal, Limit, Result)' -- run Goal, spending at most Limit
  ;;; inferences. Result is `true' if it succeeded or
  ;;; `inference_limit_exceeded' if the ceiling stopped it; the whole thing
  ;;; FAILS if Goal failed, which is what makes it usable where `once/1' was.
  ;;;
  ;;; NOT NAMED `call_with_inference_limit/3', deliberately. SWI's leaves the
  ;;; goal's choice points alive and this commits to the first solution, and
  ;;; the rule this file already states about bagof and setof applies: a
  ;;; predicate that agrees with SWI until it does not is worse than one that
  ;;; never claimed to. Somebody porting code gets an existence error and
  ;;; reads this, rather than a program that works until a page backtracks.
  ;;;
  ;;; WHAT IT IS FOR. library(httpd) runs a page with it, so a page that loops
  ;;; costs one request instead of the server. Before this there was no way to
  ;;; bound anything from inside a program at all: `max_steps' belonged to the
  ;;; composition root and `cocolog step' was the only thing that set it.
  ;;;
  ;;; AN EXCEPTION INSIDE IS STILL AN EXCEPTION OUTSIDE, and getting that
  ;;; right cost a field on the engine. The nested engine unwinds its own
  ;;; stack, so the ball's term is gone by the time control is back here --
  ;;; except that `coco_throw' puts every ball in the STORE before it starts
  ;;; unwinding, and the engine now records which cell. It is read back and
  ;;; thrown again out here, so an enclosing `catch/3' matches it exactly as
  ;;; it would have without the fence.
  ;;;
  ;;; THAT IS NOT A DETAIL. library(httpd) answers 500 for a page that throws
  ;;; and 404 for one that fails, which it can only tell apart by catching
  ;;; the first -- and when this builtin was first written without the
  ;;; re-raise, wrapping the page in it turned every page error into a dead
  ;;; request handler. The suite caught it in one run.
  ;;;
  ;;; `findall/3' still has the older behaviour -- an uncaught throw inside it
  ;;; ends the query with a message no `catch/3' sees. The machinery to fix it
  ;;; is now here; changing it is a change to a core predicate and wants its
  ;;; own case, so it has not been made in passing.
  (func coco_b_call_limited ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 lim . 0) (u64 used . 0) (int rc . 0))
          (if (not (coco_m_int e (coco_m_arg e g 1) (aof lim)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 1))))
          ;; A CEILING OF ZERO WOULD MEAN "NO LIMIT" one layer down, where 0 is
          ;; how `max_steps' spells unbounded -- so a caller asking for nothing
          ;; would silently get everything. It is a domain error instead.
          (if (< lim 1)
              (return (coco_m_domain_error e "positive_integer" (coco_m_arg e g 1))))
          (set rc (coco_engine_call_limited e (coco_m_arg e g 0)
                                            (cast u64 lim) (aof used) (aof g)))
          (if (== rc -1) (return -1))
          ;; 3 is "it threw and an outer catch took it": the continuation is
          ;; already set, which is what 2 means to the engine here
          (if (== rc 3) (return 2))
          (if (== rc 0) (return 0))
          (if (== rc 2)
              (return (coco_m_unify_atom e (coco_m_arg e g 2)
                                         "inference_limit_exceeded")))
          (return (coco_m_unify_atom e (coco_m_arg e g 2) "true"))))

  ;;; ---- and what the goal COST -----------------------------------------
  ;;;
  ;;; `call_metered(Goal, Limit, Used, Result)' -- the same ceiling, plus the
  ;;; number of inferences the goal actually SPENT.
  ;;;
  ;;; THE ENGINE HAS ALWAYS COUNTED THEM and never told a program.
  ;;; `coco_engine_call_limited' fills in `used' for its own accounting -- an
  ;;; outer budget that did not charge for a fenced goal would be a hole in
  ;;; the fence -- and the machine runner prints the same number as
  ;;; "finished after N inference(s)". Both are OUTSIDE the proof: one is C,
  ;;; the other is a line on a terminal. So anything written in Prolog that
  ;;; wanted to charge for work had to guess at the work, which is the one
  ;;; thing a meter must not do.
  ;;;
  ;;; IT SUCCEEDS WHERE `call_limited/3' FAILS, and that is the difference
  ;;; worth the separate name. A meter that says nothing about a goal that
  ;;; failed cannot bill one, and a failed goal has spent real inferences --
  ;;; searching for a proof that was not there is exactly the work an
  ;;; attacker would like to be free. So this one always succeeds (unless
  ;;; Goal throws), Result is `true', `failed' or
  ;;; `inference_limit_exceeded', and Used is filled in for all three.
  ;;;
  ;;; Everything else is `call_limited/3's, deliberately and by sharing its
  ;;; implementation: the ceiling narrows to what an outer budget has left
  ;;; and never widens, a limit below 1 is a domain error rather than
  ;;; "unlimited", and bindings survive only a success.
  ;;;
  ;;; AN EXCEPTION INSIDE IS STILL AN EXCEPTION OUTSIDE -- re-thrown here as
  ;;; it is there -- and the count is lost with the frame that carried it. A
  ;;; caller that must charge for a goal that throws puts its own `catch/3'
  ;;; INSIDE the meter, where the throw is an outcome instead of an escape.
  ;;; That is not a workaround: which exceptions are failures is the
  ;;; caller's policy, and a meter that decided it would be deciding for
  ;;; everybody.
  ;;;
  ;;; THE COUNT IS DETERMINISTIC, which is what makes it usable as a price:
  ;;; the same goal against the same clauses spends the same inferences in
  ;;; every process, so two parties that never met can compute the same fee
  ;;; and check each other's. `test/meter.sh' pins that as its own check.
  (func coco_b_call_metered ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 lim . 0) (u64 used . 0) (int rc . 0))
          (if (not (coco_m_int e (coco_m_arg e g 1) (aof lim)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 1))))
          (if (< lim 1)
              (return (coco_m_domain_error e "positive_integer" (coco_m_arg e g 1))))
          (set rc (coco_engine_call_limited e (coco_m_arg e g 0)
                                            (cast u64 lim) (aof used) (aof g)))
          (if (== rc -1) (return -1))
          ;; 3 is "it threw and an outer catch took it": the continuation is
          ;; already set, and there is nothing here left to report to
          (if (== rc 3) (return 2))
          ;; The count FIRST, and on every outcome -- a caller that reads it
          ;; only when the goal succeeded is back to guessing at the
          ;; expensive half. Unifying after the ceiling is safe: the undo
          ;; that dropped the goal's bindings is already done, and this cell
          ;; is built above the mark it came back to.
          (if (not (coco_m_unify_int e (coco_m_arg e g 2) (cast i64 used)))
              (return 0))
          (if (== rc 0)
              (return (coco_m_unify_atom e (coco_m_arg e g 3) "failed")))
          (if (== rc 2)
              (return (coco_m_unify_atom e (coco_m_arg e g 3)
                                         "inference_limit_exceeded")))
          (return (coco_m_unify_atom e (coco_m_arg e g 3) "true"))))

  ;;; ---- a window of a run, RECORDED (1.10.12) ----------------------------
  ;;;
  ;;; `'$trace_window'(Goal, Options, Events, End)' -- what library(flow/debug)
  ;;; stands on (DESIGN-flow.md 9.5). Goal is proved once in a nested
  ;;; engine, untraced at full speed up to the inference a window opens at,
  ;;; recorded from there, and every binding it made is undone at the end.
  ;;; Options:
  ;;;
  ;;;   from(F)     the first inference recorded; 0, the default, records
  ;;;               nothing -- a probe, which learns how the run ends
  ;;;   to(T)       the last; the run stops past it (0, the default: never)
  ;;;   answers(K)  the run goes on through K answers (1)
  ;;;   text(N)     an argument is written whole up to N characters (200)
  ;;;   journal(record(File))   every portal call of the run journalled into
  ;;;                           File (1.10.15, `coco_jrnl' in solve.cicili)
  ;;;   journal(replay(File))   every portal call answered from File's entry
  ;;;                           for it, and nothing run
  ;;;   ask(Cond, Holds)        Cond proved once where the run stopped --
  ;;;                           its last inference, its K-th answer, its
  ;;;                           failure, its exception -- over the bindings
  ;;;                           the run left there, sharing the goal's
  ;;;                           variables; Holds true, false, limit (ten
  ;;;                           million inferences), exception(Ball) or
  ;;;                           error (1.10.16, D4: "the first inference at
  ;;;                           which something holds" is a search over runs
  ;;;                           stopped at to(I) and asked there)
  ;;;
  ;;; End is `end(How, Used, Answers)': How is `answer' (the K-th was found),
  ;;; `false', `limit' (stopped past T), `exception(Ball)', `halt(Code)',
  ;;; `error(Message)', or -- replaying -- `diverged(At, Want, Got)': at
  ;;; inference At the run left the one its journal recorded, Want what the
  ;;; journal held there and Got what the replay did, each `portal(I,
  ;;; Module, Name/Arity, CallText)' or `none'; Used the inferences spent,
  ;;; counted as an untraced run counts them; Answers the inference each
  ;;; answer came at. Events are in
  ;;; the order they happened, each with its inference I, its depth D and C,
  ;;; the goal's cell -- its call's name: a Call's cell is what its Exit,
  ;;; Fail and Redo carry, and a cell is used again only once backtracking
  ;;; has gone back past every call made after it:
  ;;;
  ;;;   call(I, D, C, Parent, Name, Args)   Parent the cell of the call it is
  ;;;                                       in, 0 when that began before the
  ;;;                                       window
  ;;;   exit(I, D, C, Name, Args)           as the proof left the arguments
  ;;;   fail(I, D, C, Name, Args)           the call is over, for good
  ;;;   redo(I, D, C, Name, Args)           re-entered for its next clause
  ;;;   clause(I, D, C, N)                  it entered its N-th clause
  ;;;   nohead(I, D, C, N)                  the N-th clause's head did not unify
  ;;;   throw(I, D, C, Ball)                raised in the body of call C
  ;;;   catch(I, D, C)                      taken by a catch/3 in C's body
  ;;;
  ;;; An argument, and a ball, is its text as `writeq' writes it: an atom,
  ;;; or `cut(Prefix, Length)' past N characters. A builtin's Call and Exit
  ;;; are one inference; a predicate's Exit is the inference of the last
  ;;; goal its proof took.
  (static)
  (func coco_b_rec_text ((coco_machine * m) (coco_rec * r) (size_t k)) (out size_t)
        (let ((coco_rtext * x . #'(aof (nth k (-> r txs))))
              (size_t a . 0))
          (set a (coco_new_atom_id m (coco_intern_len m (+ (-> r arena) (-> x off))
                                                      (cast size_t (-> x len)))))
          (if (== (-> x chars) (-> x full)) (return a))
          (let ((size_t args [2]))
            (set (nth 0 args) a)
            (set (nth 1 args) (coco_new_int m (cast i64 (-> x full))))
            (return (coco_make m "cut" 2 args)))))

  (static)
  (func coco_b_rec_event ((coco_machine * m) (coco_rec * r) (coco_rev * v)) (out size_t)
        (let ((size_t a [6]) (size_t texts . #'(coco_new_atom m "[]")) (u32 i . 0))
          (set (nth 0 a) (coco_new_int m (cast i64 (-> v inf))))
          (set (nth 1 a) (coco_new_int m (cast i64 (-> v depth))))
          (set (nth 2 a) (coco_new_int m (cast i64 (-> v cell))))
          (set i (-> v ntext))
          (while (> i 0)
            (set i (- i 1))
            (set texts (coco_cons m (coco_b_rec_text m r (+ (-> v text) (cast size_t i))) texts)))
          (cond
            ((== (-> v kind) COCO_REV_CALL)
             (block (set (nth 3 a) (coco_new_int m (cast i64 (-> v aux))))
                    (set (nth 4 a) (coco_new_atom_id m (-> v name)))
                    (set (nth 5 a) texts)
                    (return (coco_make m "call" 6 a))))
            ((or (or (== (-> v kind) COCO_REV_EXIT) (== (-> v kind) COCO_REV_FAIL))
                 (== (-> v kind) COCO_REV_REDO))
             (block (set (nth 3 a) (coco_new_atom_id m (-> v name)))
                    (set (nth 4 a) texts)
                    (return (coco_make m (? (== (-> v kind) COCO_REV_EXIT) "exit"
                                            (? (== (-> v kind) COCO_REV_FAIL) "fail" "redo"))
                                       5 a))))
            ((or (== (-> v kind) COCO_REV_CLAUSE) (== (-> v kind) COCO_REV_NOHEAD))
             (block (set (nth 3 a) (coco_new_int m (cast i64 (-> v aux))))
                    (return (coco_make m (? (== (-> v kind) COCO_REV_CLAUSE) "clause" "nohead")
                                       4 a))))
            ((== (-> v kind) COCO_REV_THROW)
             (block (set (nth 3 a) (coco_b_rec_text m r (-> v text)))
                    (return (coco_make m "throw" 4 a)))))
          (return (coco_make m "catch" 3 a))))

  ;;; A WHOLE FILE as malloc'd text, or null: the journal a replay reads
  (static)
  (func coco_b_slurp ((const char * path)) (out char *)
        (let ((FILE * f . #'(fopen path "rb")) (char * buf . nil) (long n . 0))
          (if (== f nil) (return nil))
          (fseek f 0 SEEK_END)
          (set n (ftell f))
          (fseek f 0 SEEK_SET)
          (if (< n 0) (block (fclose f) (return nil)))
          (set buf (cast (char *) (malloc (+ (cast size_t n) 1))))
          (if (== buf nil) (block (fclose f) (return nil)))
          (if (and (> n 0) (!= (cast size_t n) (fread buf 1 (cast size_t n) f)))
              (block (free buf) (fclose f) (return nil)))
          (set (nth (cast size_t n) buf) (cast char 0))
          (fclose f)
          (return buf)))

  ;;; ... and the journal a record wrote: 1, or 0 when the file would not take it
  (static)
  (func coco_b_spill ((const char * path) (const char * s) (size_t n)) (out int)
        (let ((FILE * f . #'(fopen path "wb")) (int ok . 1))
          (if (== f nil) (return 0))
          (if (and (> n 0) (!= n (fwrite s 1 n f))) (set ok 0))
          (if (!= 0 (fclose f)) (set ok 0))
          (return ok)))

  ;;; `journal(record(File))' or `journal(replay(File))': MODE 1 or 2 and the
  ;;; file's name in PATH, or 0
  (static)
  (func coco_b_journal_opt ((coco_engine * e) (size_t o) (char * path) (size_t cap)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (u32 ar . 0)
              (const char * nm . nil) (size_t w . 0) (size_t f . 0))
          (set nm (coco_m_functor e o (aof ar)))
          (if (or (== nm nil) (or (!= ar 1) (!= 0 (strcmp nm "journal")))) (return 0))
          (set w (coco_deref m (coco_m_arg e o 0)))
          (set nm (coco_m_functor e w (aof ar)))
          (if (or (== nm nil) (!= ar 1)) (return 0))
          (set f (coco_deref m (coco_m_arg e w 0)))
          (if (not (coco-tag-is ATOM (nth f (-> m heap)))) (return 0))
          (snprintf path cap "%s" (coco_atom_name m (coco_name_of m f)))
          (if (== 0 (strcmp nm "record")) (return 1))
          (if (== 0 (strcmp nm "replay")) (return 2))
          (return 0)))

  (func coco_b_trace_window ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_rec r) (size_t * v . nil) (size_t n . 0)
              (i64 from . 0) (i64 to . 0) (i64 answers . 1) (i64 tmax . 200)
              (u64 used . 0) (u64 * ats . nil) (u64 nats . 0) (size_t ball . 0)
              (int haltcode . 0) (int rc . 0)
              (size_t evs . 0) (size_t how . 0) (size_t al . 0) (size_t end . 0)
              (coco_jrnl jr) (int jmode . 0) (char jpath [1024]) (size_t jopt . 0)
              (int jbad . 0) (size_t askcell . 0) (i64 askat . -1))
          (if (coco_m_is_var e (coco_m_arg e g 0)) (return (coco_m_instantiation_error e)))
          (if (!= (-> m rec) nil)
              (return (coco_m_permission_error e "open" "trace_window" (coco_m_arg e g 0))))
          (if (not (coco_m_list_array e (coco_m_arg e g 1) (aof v) (aof n)))
              (return (coco_m_type_error e "list" (coco_m_arg e g 1))))
          (for ((size_t i . 0)) (< i n) ((++ i))
            (let ((size_t o . #'(coco_deref m (nth i v))) (u32 ar . 0)
                  (const char * nm . nil) (i64 x . 0) (int ok . 0) (int jm . 0))
              (set nm (coco_m_functor e o (aof ar)))
              (if (and (!= nm nil) (== ar 1) (coco_m_int e (coco_m_arg e o 0) (aof x)))
                  (cond ((and (== 0 (strcmp nm "from")) (>= x 0)) (block (set from x) (set ok 1)))
                        ((and (== 0 (strcmp nm "to")) (>= x 0)) (block (set to x) (set ok 1)))
                        ((and (== 0 (strcmp nm "answers")) (>= x 1)) (block (set answers x) (set ok 1)))
                        ((and (== 0 (strcmp nm "text")) (>= x 1)) (block (set tmax x) (set ok 1)))))
              (if (not ok)
                  (block (set jm (coco_b_journal_opt e o jpath (sizeof jpath)))
                         (if (!= jm 0) (block (set jmode jm) (set jopt o) (set ok 1)))))
              ;; ask(Cond, Holds): Cond asked where the run stops (1.10.16)
              (if (and (not ok) (and (!= nm nil) (and (== ar 2) (== 0 (strcmp nm "ask")))))
                  (block (set askcell (coco_deref m (coco_m_arg e o 0)))
                         (set askat (cast i64 i))
                         (set ok 1)))
              (if (not ok)
                  (block (free v)
                         (return (coco_m_domain_error e "trace_window_option" o))))))
          (free v)
          (if (and (!= to 0) (< to from))
              (return (coco_m_domain_error e "trace_window_option" (coco_m_arg e g 1))))
          ;; THE JOURNAL (1.10.15): a record starts empty under its header, a
          ;; replay reads the record's file whole before the run starts
          (if (!= jmode 0)
              (block
               (coco_jr_init (aof jr) jmode)
               (if (== jmode 1)
                   (coco_sb_put (aof ($ jr out))
                                "%% cocolog journal: j(I, Module, Name/Arity, CallText, Outcome), a portal call of the run a line (DESIGN-flow.md 9.2)\n"))
               (if (== jmode 2)
                   (let ((char * text . #'(coco_b_slurp jpath)) (char err [256]))
                     (if (== text nil)
                         (block (coco_jr_free (aof jr))
                                (return (coco_m_existence_error e "journal" jopt))))
                     (if (not (coco_jr_load m (aof jr) text err (sizeof err)))
                         (block (coco_jr_free (aof jr))
                                (return (coco_m_error e "'$trace_window'/4" err))))))))
          (set ats (cast (u64 *) (malloc (* (cast size_t answers) (sizeof u64)))))
          (if (== ats nil)
              (block (if (!= jmode 0) (coco_jr_free (aof jr)))
                     (return (coco_m_resource_error e "memory"))))
          (memset (aof r) 0 (sizeof coco_rec))
          (set ($ r from) (cast u64 from))
          (set ($ r to) (cast u64 to))
          (set ($ r tmax) (cast u32 tmax))
          (if (!= jmode 0) (set ($ r jr) (aof jr)))
          (set ($ r ask) askcell)
          (set rc (coco_engine_window e (coco_m_arg e g 0) (aof r) (cast u64 answers)
                                      (aof used) ats (aof nats) (aof ball) (aof haltcode) (aof g)))
          (if (== jmode 1)
              (if (not (coco_b_spill jpath ($ ($ jr out) s) ($ ($ jr out) len))) (set jbad 1)))
          (if (and (== jmode 2) (and (>= rc 0) (<= rc 4))) (coco_jr_settle (aof jr) used))
          ;; the events, last first, so the list is built in one pass
          (set evs (coco_new_atom m "[]"))
          (let ((size_t k . #'($ r nevs)))
            (while (> k 0)
              (set k (- k 1))
              (set evs (coco_cons m (coco_b_rec_event m (aof r) (aof (nth k ($ r evs)))) evs))))
          (cond ((and (== jmode 2) ($ jr div))
                 (let ((size_t da [3]))
                   (coco_jr_diverged m (aof jr) (aof (nth 0 da)) (aof (nth 1 da)) (aof (nth 2 da)))
                   (set how (coco_make m "diverged" 3 da))))
                ((== rc 1) (set how (coco_new_atom m "answer")))
                ((== rc 0) (set how (coco_new_atom m "false")))
                ((== rc 2) (set how (coco_new_atom m "limit")))
                ((== rc 3) (set how (coco_make1 m "exception" ball)))
                ((== rc 4) (set how (coco_make1 m "halt" (coco_new_int m (cast i64 haltcode)))))
                (#t (set how (coco_make1 m "error" (coco_new_atom m (-> e err))))))
          (set al (coco_new_atom m "[]"))
          (let ((u64 k . nats))
            (while (> k 0)
              (set k (- k 1))
              (set al (coco_cons m (coco_new_int m (cast i64 (nth k ats))) al))))
          (let ((size_t ea [3]))
            (set (nth 0 ea) how)
            (set (nth 1 ea) (coco_new_int m (cast i64 used)))
            (set (nth 2 ea) al)
            (set end (coco_make m "end" 3 ea)))
          (free ats)
          (coco_rec_free (aof r))
          (if (!= jmode 0) (coco_jr_free (aof jr)))
          ;; the file by its name: a collection in the run may have moved
          ;; the option's cell
          (if jbad (return (coco_m_permission_error e "write" "journal" (coco_new_atom m jpath))))
          (if (-> m oom) (return (coco_m_resource_error e "memory")))
          (if (not (coco_m_unify e (coco_m_arg e g 2) evs)) (return 0))
          ;; ask's answer: true, false, limit, exception(Ball) or error -- its
          ;; option found again by its place, the run having moved the cells
          (if (>= askat 0)
              (let ((size_t hv . 0))
                (cond ((== ($ r holds) 1) (set hv (coco_new_atom m "true")))
                      ((== ($ r holds) 0) (set hv (coco_new_atom m "false")))
                      ((== ($ r holds) 2) (set hv (coco_new_atom m "limit")))
                      ((== ($ r holds) 3)
                       (block (set (-> (-> e st) dead) (+ (-> (-> e st) dead) ($ r hbsize)))
                              (set hv (coco_make1 m "exception"
                                                  (coco_store_read m (-> e st) ($ r hball))))))
                      (#t (set hv (coco_new_atom m "error"))))
                (if (not (coco_m_list_array e (coco_m_arg e g 1) (aof v) (aof n)))
                    (return (coco_m_type_error e "list" (coco_m_arg e g 1))))
                (if (>= (cast size_t askat) n)
                    (block (free v) (return (coco_m_error e "'$trace_window'/4" "the options moved"))))
                (let ((size_t o . #'(coco_deref m (nth (cast size_t askat) v))))
                  (free v)
                  (if (not (coco_m_unify e (coco_m_arg e o 1) hv)) (return 0)))))
          (return (coco_m_unify e (coco_m_arg e g 3) end))))

  ;;; `forall(C, A)' is `\+ (C, \+ A)', and is written that way rather than by
  ;;; collecting: it stops at the first counterexample and builds no list.
  (func coco_b_forall ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t lst . 0)
              (size_t goal . #'(coco_make2 m "," (coco_m_arg e g 0)
                                         (coco_make1 m "\\+" (coco_m_arg e g 1))))
              (int fr . #'(coco_engine_findall e (coco_new_atom m "x") goal (aof lst) (aof g))))
          (if (== fr 2) (return 2))
          (if (not fr) (return -1))
          ;; no counterexample means the list is empty
          (return (? (coco_m_is_atom e (coco_deref m lst)) 1 0))))

  ;;; `aggregate_all(Spec, Goal, Result)'. count, count(T), sum(T), max(T),
  ;;; min(T), bag(T) and set(T) -- the seven SWI documents for the form that
  ;;; does not group.
  (func coco_b_aggregate_all ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t spec . #'(coco_m_arg e g 0))
              (size_t goal . #'(coco_m_arg e g 1))
              (size_t tmpl) (const char * what)
              (size_t lst . 0) (size_t * v . nil) (size_t n . 0))

          ;; a bare `count' collects a constant; everything else collects the
          ;; argument of the spec
          (if (coco_m_is_atom e spec)
              (block (set what (coco_m_atom e spec))
                     (set tmpl (coco_new_atom m "x")))
            (block
             (if (not (coco_is_callable m spec))
                 (return (coco_m_domain_error e "aggregate_spec" spec)))
             (set what (coco_atom_name m (coco_name_of m spec)))
             ;; `max(Expr, Witness)' and `min(Expr, Witness)' collect the
             ;; pair Expr-Witness; everything else is Spec(Template)
             (cond
               ((and (== (coco_arity m spec) 2)
                     (or (== 0 (strcmp what "max")) (== 0 (strcmp what "min"))))
                (set tmpl (coco_make2 m "-" (coco_arg m spec 0) (coco_arg m spec 1)))
                (set what (? (== 0 (strcmp what "max")) "max2" "min2")))
               ((== (coco_arity m spec) 1)
                (set tmpl (coco_arg m spec 0)))
               (#t (return (coco_m_domain_error e "aggregate_spec" spec))))))

          (let ((int fr . #'(coco_engine_findall e tmpl goal (aof lst) (aof g))))
            (if (== fr 2) (return 2))
            (if (not fr) (return -1)))
          (if (not (coco_m_list_array e lst (aof v) (aof n))) (return 0))

          (if (== 0 (strcmp what "count"))
              (block (free v) (return (coco_m_unify_int e (coco_m_arg e g 2) (cast i64 n)))))

          (if (== 0 (strcmp what "bag"))
              (block (free v) (return (coco_m_unify e (coco_m_arg e g 2) lst))))

          (if (== 0 (strcmp what "set"))
              (let ((size_t k . 0))
                (coco_b_sort_terms m v n)
                (for ((size_t i . 0)) (< i n) ((++ i))
                  (if (or (== k 0) (!= 0 (coco_compare m (nth (- k 1) v) (nth i v))))
                      (block (set (nth k v) (nth i v)) (set k (+ k 1)))))
                (let ((size_t out . #'(coco_m_list e v k)))
                  (free v)
                  (return (coco_m_unify e (coco_m_arg e g 2) out)))))

          ;; the numeric three. An empty list is a failure for max and min --
          ;; there is no answer -- and zero for sum, which is what SWI does.
          (if (== 0 (strcmp what "sum"))
              (let ((double acc . 0.0) (int all_int . 1))
                (for ((size_t i . 0)) (< i n) ((++ i))
                  (let ((double d . 0.0) (i64 iv . 0))
                    (if (not (coco_m_int e (nth i v) (aof iv))) (set all_int 0))
                    (if (not (coco_m_float e (nth i v) (aof d)))
                        ;; the term is taken BEFORE the array goes: reading
                        ;; `(nth i v)' after the free is a use-after-free, and
                        ;; it segfaulted on the first list of integers
                        (let ((size_t bad . #'(nth i v)))
                          (free v)
                          (return (coco_m_type_error e "number" bad))))
                    (set acc (+ acc d))))
                (free v)
                (return (? all_int
                           (coco_m_unify_int e (coco_m_arg e g 2) (cast i64 acc))
                           (coco_m_unify_float e (coco_m_arg e g 2) acc)))))

          (if (or (== 0 (strcmp what "max")) (== 0 (strcmp what "min")))
              (let ((int want_max . #'(? (== 0 (strcmp what "max")) 1 0))
                    (size_t best . 0))
                (if (== n 0) (block (free v) (return 0)))
                (set best (nth 0 v))
                (for ((size_t i . 1)) (< i n) ((++ i))
                  (let ((double a . 0.0) (double b . 0.0))
                    (if (or (not (coco_m_float e best (aof a)))
                            (not (coco_m_float e (nth i v) (aof b))))
                        (let ((size_t bad . #'(nth i v)))
                          (free v)
                          (return (coco_m_type_error e "number" bad))))
                    (if (? want_max (> b a) (< b a)) (set best (nth i v)))))
                (free v)
                (return (coco_m_unify e (coco_m_arg e g 2) best))))

          ;; the witness forms: numeric on the expression, the whole
          ;; max(Expr, Witness) / min(Expr, Witness) term as the answer
          (if (or (== 0 (strcmp what "max2")) (== 0 (strcmp what "min2")))
              (let ((int want_max . #'(? (== 0 (strcmp what "max2")) 1 0))
                    (size_t best . 0))
                (if (== n 0) (block (free v) (return 0)))
                (set best (nth 0 v))
                (for ((size_t i . 1)) (< i n) ((++ i))
                  (let ((double a . 0.0) (double b . 0.0))
                    (if (or (not (coco_m_float e (coco_arg m (coco_deref m best) 0) (aof a)))
                            (not (coco_m_float e (coco_arg m (coco_deref m (nth i v)) 0) (aof b))))
                        (let ((size_t bad . #'(nth i v)))
                          (free v)
                          (return (coco_m_type_error e "number" bad))))
                    (if (? want_max (> b a) (< b a)) (set best (nth i v)))))
                (let ((size_t bp . #'(coco_deref m best))
                      (size_t out . 0))
                  (set out (coco_make2 m (? want_max "max" "min")
                                       (coco_arg m bp 0) (coco_arg m bp 1)))
                  (free v)
                  (return (coco_m_unify e (coco_m_arg e g 2) out)))))

          (free v)
          (return (coco_m_domain_error e "aggregate_spec" (coco_m_arg e g 0))))) 

  ;;; ---- arithmetic in the small ----------------------------------------

  ;;; `succ(?X, ?Y)' -- Y is X+1, either way round, over NATURAL numbers only,
  ;;; which is what makes `succ(X, 0)' fail rather than answer -1.
  (func coco_b_succ ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 a . 0) (i64 b . 0))
          (if (coco_m_int e (coco_m_arg e g 0) (aof a))
              (block (if (< a 0) (return 0))
                     (return (coco_m_unify_int e (coco_m_arg e g 1) (+ a 1)))))
          (if (coco_m_int e (coco_m_arg e g 1) (aof b))
              (block (if (<= b 0) (return 0))
                     (return (coco_m_unify_int e (coco_m_arg e g 0) (- b 1)))))
          (return (coco_m_instantiation_error e))))

  ;;; `plus(?A, ?B, ?C)' -- any one of the three may be the unbound one.
  (func coco_b_plus ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 a . 0) (i64 b . 0) (i64 c . 0)
              (int ha . 0) (int hb . 0) (int hc . 0))
          (set ha (coco_m_int e (coco_m_arg e g 0) (aof a)))
          (set hb (coco_m_int e (coco_m_arg e g 1) (aof b)))
          (set hc (coco_m_int e (coco_m_arg e g 2) (aof c)))
          (if (and ha hb) (return (coco_m_unify_int e (coco_m_arg e g 2) (+ a b))))
          (if (and ha hc) (return (coco_m_unify_int e (coco_m_arg e g 1) (- c a))))
          (if (and hb hc) (return (coco_m_unify_int e (coco_m_arg e g 0) (- c b))))
          (return (coco_m_instantiation_error e))))

  ;;; ---- terms ------------------------------------------------------------

  ;;; GROUND, WITH EACH COMPOUND MET ONCE: the walk ground/1 starts again
  ;;; when its first has met more compounds than the heap holds -- a cycle
  ;;; it was going round, or a DAG that shares them (2^40 steps for one
  ;;; that doubles forty times).
  (static)
  (func coco_b_ground_seen ((coco_machine * m) (size_t t)) (out int)
        (let ((coco_varmap vm . '{ nil nil 0 0 0 })
              (size_t * wl . nil) (size_t wlen . 0) (size_t wcap . 0)
              (int r . 1) (size_t st . 0))
          (coco_varmap_take m (aof vm))
          (if (not (coco_cells_push (aof wl) (aof wlen) (aof wcap) t)) (set r -1))
          (while (and (== r 1) (> wlen 0))
            (set wlen (- wlen 1))
            (let ((size_t a . #'(coco_deref m (nth wlen wl))))
              (cond
                ((coco-tag-is REF (nth a (-> m heap))) (set r 0))
                ((and (coco-tag-is FUN (nth a (-> m heap)))
                      (not (coco_varmap_get (aof vm) a (aof st))))
                 (if (not (coco_varmap_put (aof vm) a 1)) (set r -1))
                 (for ((u32 i . 0)) (< i (coco_arity m a)) ((++ i))
                   (if (not (coco_cells_push (aof wl) (aof wlen) (aof wcap) (coco_arg m a i)))
                       (set r -1))))
                (#t (block)))))
          (free wl)
          (coco_varmap_give m (aof vm))
          (if (== r -1) (block (set (-> m oom) 1) (return 0)))
          (return r)))

  ;;; A LOOP (1.10.19): it was a recursion, and `X = f(X), ground(X)' took
  ;;; the C stack down. The compounds wait on the machine's pair stack, an
  ;;; atom or a number is passed where it stands, and the arguments go on
  ;;; right to left, so a list's tail comes off after its head and the
  ;;; stack stays a cell or two deep however long the list. Past the heap's
  ;;; worth of compounds, `coco_b_ground_seen'.
  (static)
  (func coco_b_is_ground ((coco_machine * m) (size_t t0)) (out int)
        (let ((size_t * wl . nil) (size_t wlen . 0) (size_t wcap . 0)
              (size_t t . #'(coco_deref m t0)) (size_t budget . #'(-> m heap_len)))
          (if (coco-tag-is REF (nth t (-> m heap))) (return 0))
          (if (not (coco-tag-is FUN (nth t (-> m heap)))) (return 1))
          (set wl (coco_wpairs_take m (aof wcap)))
          (while 1
            (if (== (-- budget) 0)
                (block (coco_wpairs_give m wl wcap) (return (coco_b_ground_seen m t0))))
            (for ((u32 i . #'(coco_arity m t))) (> i 0) ((set i (- i 1)))
              (let ((size_t a . #'(coco_deref m (coco_arg m t (- i 1)))))
                (if (coco-tag-is REF (nth a (-> m heap)))
                    (block (coco_wpairs_give m wl wcap) (return 0)))
                (if (coco-tag-is FUN (nth a (-> m heap)))
                    (if (not (coco_cells_push (aof wl) (aof wlen) (aof wcap) a))
                        (block (set (-> m oom) 1) (coco_wpairs_give m wl wcap) (return 0))))))
            (if (== wlen 0) (block (coco_wpairs_give m wl wcap) (return 1)))
            (set wlen (- wlen 1))
            (set t (nth wlen wl)))
          (return 1)))

  (func coco_b_ground ((coco_engine * e) (size_t g)) (out int)
        (return (coco_b_is_ground (coco_m_machine e) (coco_m_arg e g 0))))

  ;;; acyclic_term/1 and cyclic_term/1 ANSWER THE QUESTION (1.10.18):
  ;;; through 1.10.17 they were a fact and a fail, on the ground that
  ;;; nothing here could hold a cycle. `coco_acyclic' (lib/term.cicili);
  ;;; a walk that could not get the memory to finish answers acyclic,
  ;;; which is what both said before.
  (func coco_b_acyclic_term ((coco_engine * e) (size_t g)) (out int)
        (return (? (== 0 (coco_acyclic (coco_m_machine e) (coco_m_arg e g 0))) 0 1)))

  (func coco_b_cyclic_term ((coco_engine * e) (size_t g)) (out int)
        (return (? (== 0 (coco_acyclic (coco_m_machine e) (coco_m_arg e g 0))) 1 0)))

  ;;; One variable for term_variables/2, unless it is there already.
  (static)
  (func coco_b_var_add ((size_t ** v) (size_t * n) (size_t * cap) (size_t t)) (out int)
        (for ((size_t i . 0)) (< i (cof n)) ((++ i))
          (if (== (nth i (cof v)) t) (return 1)))
        (if (>= (cof n) (cof cap))
            (let ((size_t ncap . #'(? (== (cof cap) 0) 8 (* (cof cap) 2)))
                  (size_t * nb))
              (set nb (cast (size_t *) (realloc (cof v) (* ncap (sizeof size_t)))))
              (if (== nb nil) (return 0))
              (set (cof v) nb)
              (set (cof cap) ncap)))
        (set (nth (cof n) (cof v)) t)
        (set (cof n) (+ (cof n) 1))
        (return 1))

  ;;; Every distinct unbound variable, in the order first met -- which is the
  ;;; order SWI answers in and is not the same as any sorted order. A LOOP
  ;;; (1.10.19), as ground/1's: a variable or a compound goes on the
  ;;; machine's pair stack, the arguments right to left so they come off
  ;;; left to right. Answers 1, -1 when the walk could not grow, and 0 when
  ;;; it met more compounds than the heap holds; the caller asks again with
  ;;; SEEN, and each compound is walked once -- as SWI's walk does from its
  ;;; first, which is why the second walk starts at the top: the order a
  ;;; cycle's variables come in is SWI's.
  (static)
  (func coco_b_collect_vars ((coco_machine * m) (size_t t) (int seen) (size_t ** v)
                             (size_t * n) (size_t * cap)) (out int)
        (let ((coco_varmap vm . '{ nil nil 0 0 0 })
              (size_t * wl . nil) (size_t wlen . 0) (size_t wcap . 0)
              (size_t budget . #'(-> m heap_len)) (int r . 1) (size_t st . 0))
          (if seen (coco_varmap_take m (aof vm)))
          (set wl (coco_wpairs_take m (aof wcap)))
          (if (not (coco_cells_push (aof wl) (aof wlen) (aof wcap) t)) (set r -1))
          (while (and (== r 1) (> wlen 0))
            (set wlen (- wlen 1))
            (let ((size_t a . #'(coco_deref m (nth wlen wl))))
              (cond
                ((coco-tag-is REF (nth a (-> m heap)))
                 (if (not (coco_b_var_add v n cap a)) (set r -1)))
                ((coco-tag-is FUN (nth a (-> m heap)))
                 (cond
                   ((and seen (coco_varmap_get (aof vm) a (aof st))) (block))
                   ((and (not seen) (== budget 0)) (set r 0))
                   (#t
                    (if seen
                        (if (not (coco_varmap_put (aof vm) a 1)) (set r -1))
                        (set budget (- budget 1)))
                    (for ((u32 i . #'(coco_arity m a))) (> i 0) ((set i (- i 1)))
                      (let ((size_t x . #'(coco_deref m (coco_arg m a (- i 1)))))
                        (if (or (coco-tag-is REF (nth x (-> m heap)))
                                (coco-tag-is FUN (nth x (-> m heap))))
                            (if (not (coco_cells_push (aof wl) (aof wlen) (aof wcap) x))
                                (set r -1))))))))
                (#t (block)))))
          (coco_wpairs_give m wl wcap)
          (if seen (coco_varmap_give m (aof vm)))
          (return r)))

  (func coco_b_term_variables ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t * v . nil) (size_t n . 0) (size_t cap . 0) (size_t out) (int r . 0))
          (set r (coco_b_collect_vars m (coco_m_arg e g 0) 0 (aof v) (aof n) (aof cap)))
          (if (== r 0)
              (block (set n 0)
                     (set r (coco_b_collect_vars m (coco_m_arg e g 0) 1 (aof v) (aof n) (aof cap)))))
          (if (== r -1) (set (-> m oom) 1))
          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 1) out))))

  ;;; UNIFICATION THAT REFUSES TO BUILD A CYCLE: unify, then ask of each
  ;;; variable the unify bound whether its binding holds it again
  ;;; (`coco_occurs', the variable taken off for the question). That is
  ;;; SWI's occurs check asked at the end rather than at each binding, and
  ;;; it comes to the same: a binding that holds its variable is a cycle
  ;;; through it, and no later binding takes one away. A cyclic term the
  ;;; arguments held before is no binding of this unify, and is left alone.
  ;;; Through 1.10.18 it asked whether the whole result could be walked
  ;;; 5000 deep: a tree 6000 deep failed, a cyclic term unified with itself
  ;;; failed, and a DAG 40 deep took 2^40 steps (1.10.19).
  (func coco_b_unify_occurs ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t mark . #'(coco_m_mark e))
              (size_t a . #'(coco_m_arg e g 0))
              (size_t b . #'(coco_m_arg e g 1)))
          (if (not (coco_m_unify e a b)) (block (coco_m_undo e mark) (return 0)))
          (for ((size_t i . mark)) (< i (-> m trail_len)) ((++ i))
            (let ((size_t v . #'(nth i (-> m trail)))
                  (u64 keep . #'(nth v (-> m heap)))
                  (int occ . 0))
              (set (nth v (-> m heap)) (coco-cell REF v))
              (set occ (coco_occurs m v (cast size_t (coco-payload keep))))
              (set (nth v (-> m heap)) keep)
              (if (!= occ 0) (block (coco_m_undo e mark) (return 0)))))
          (return 1)))

  ;;; ---- atoms ------------------------------------------------------------

  ;;; A LIST OF ONE-CHARACTER ATOMS AS TEXT, on the end of B -- atom_chars/2
  ;;; and number_chars/2 read the other way. Answers 1, or 0 with RC the
  ;;; builtin's answer: SWI's error, a partial list or an unbound element
  ;;; instantiation_error, a list that is its own tail type_error(list, L),
  ;;; any other element type_error(character, E). A character is a byte
  ;;; here, so a letter of two bytes in UTF-8, `á', is no character (SWI's
  ;;; are letters), and an improper list, `[d|r]', is an instantiation
  ;;; error where SWI says type_error(list, L).
  ;;;
  ;;; THE CULPRIT IS NAMED BEFORE THE ARRAY IS FREED (1.11.8). Each builtin
  ;;; freed the array and then read the element out of it for its error:
  ;;; an element that was not one character -- `á', `ab', a number, a
  ;;; variable -- took the process down (SIGSEGV, exit status 139) where it
  ;;; stood first or second, whose sixteen bytes glibc writes its free list
  ;;; over, and further on named a stale index that still held it. The bug
  ;;; `$atom_join' records fixing below. The element is a heap index, kept
  ;;; in BAD before the free. AND THE TEXT GROWS: it was a `char[4096]', and
  ;;; a list of 4096 characters or more FAILED, with no error.
  (static)
  (func coco_b_chars_text ((coco_engine * e) (size_t l) (coco_strbuf * b) (int * rc)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t * v . nil) (size_t n . 0) (size_t bad . 0) (int why . 0))
          (if (not (coco_m_list_array e l (aof v) (aof n)))
              (block
               ;; a list that is its own tail is no list (1.10.19)
               (if (coco_list_cyclic m l)
                   (set (cof rc) (coco_m_type_error e "list" l))
                   (set (cof rc) (coco_m_instantiation_error e)))
               (return 0)))
          (for ((size_t i . 0)) (< i n) ((++ i))
            (let ((const char * c . #'(coco_m_atom e (nth i v))))
              (cond
                ((coco_m_is_var e (nth i v)) (block (set why 1) break))
                ((or (== c nil) (!= 1 (strlen c))) (block (set why 2) (set bad (nth i v)) break))
                ((not (coco_sb_putc b (nth 0 c))) (block (set why 3) break)))))
          (free v)
          (cond
            ((== why 1) (set (cof rc) (coco_m_instantiation_error e)))
            ((== why 2) (set (cof rc) (coco_m_type_error e "character" bad)))
            ((== why 3) (set (cof rc) (coco_m_resource_error e "memory"))))
          (return (== why 0))))

  ;;; A character is a ONE-CHARACTER ATOM in Prolog, not a code. `atom_chars'
  ;;; and `atom_codes' differ in exactly that.
  (func coco_b_atom_chars ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t a . #'(coco_m_arg e g 0)))
          ;; the text of any length, an atom a byte: through 1.11.7 it went
          ;; through 4096 bytes, and a longer atom was taken for no text at
          ;; all -- an instantiation error from the list's side
          (if (not (coco_m_is_var e a))
              (let ((char * buf . #'(coco_b_text_dup e a)))
                (if (!= buf nil)
                    (let ((size_t lst . #'(coco_m_nil e)))
                      (for ((size_t i . #'(strlen buf))) (> i 0) ((-- i))
                        (let ((char one [2]))
                          (set (nth 0 one) (nth (- i 1) buf))
                          (set (nth 1 one) (cast char 0))
                          (set lst (coco_cons m (coco_new_atom m one) lst))))
                      (free buf)
                      (return (coco_m_unify e (coco_m_arg e g 1) lst))))))
          ;; the other way: a list of one-character atoms into an atom
          (let ((coco_strbuf b) (int rc . 0))
            (coco_sb_init (aof b))
            (if (not (coco_b_chars_text e (coco_m_arg e g 1) (aof b) (aof rc)))
                (block (coco_sb_free (aof b)) (return rc)))
            (set rc (coco_m_unify_atom e (coco_m_arg e g 0) (? (== ($ b s) nil) "" ($ b s))))
            (coco_sb_free (aof b))
            (return rc))))

  (func coco_b_char_code ((coco_engine * e) (size_t g)) (out int)
        (let ((const char * c . #'(coco_m_atom e (coco_m_arg e g 0))) (i64 code . 0))
          (if (and (!= c nil) (== 1 (strlen c)))
              (return (coco_m_unify_int e (coco_m_arg e g 1)
                                      (bitand (cast i64 (nth 0 c)) 255))))
          (if (coco_m_int e (coco_m_arg e g 1) (aof code))
              (let ((char one [2]))
                (if (or (< code 0) (> code 255)) (return 0))
                (set (nth 0 one) (cast char code))
                (set (nth 1 one) (cast char 0))
                (return (coco_m_unify_atom e (coco_m_arg e g 0) one))))
          (return (coco_m_instantiation_error e))))

  ;;; Like atom_chars but the atom has to read back as a number.
  (func coco_b_number_chars ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (char buf [4096]))
          ;; number -> chars
          (let ((i64 iv . 0) (double d . 0.0))
            (if (or (coco_m_int e (coco_m_arg e g 0) (aof iv))
                    (coco_m_float e (coco_m_arg e g 0) (aof d)))
                (let ((coco_strbuf b) (size_t lst . #'(coco_m_nil e)))
                  (coco_sb_init (aof b))
                  (coco_write_term m (aof b) (coco_m_arg e g 0) 0 0)
                  (snprintf buf (sizeof buf) "%s" (? (== ($ b s) nil) "" ($ b s)))
                  (coco_sb_free (aof b))
                  (for ((size_t i . #'(strlen buf))) (> i 0) ((-- i))
                    (let ((char one [2]))
                      (set (nth 0 one) (nth (- i 1) buf))
                      (set (nth 1 one) (cast char 0))
                      (set lst (coco_cons m (coco_new_atom m one) lst))))
                  (return (coco_m_unify e (coco_m_arg e g 1) lst)))))
          ;; chars -> number (the list read as atom_chars/2 reads it)
          (let ((coco_strbuf b) (int rc . 0))
            (coco_sb_init (aof b))
            (if (not (coco_b_chars_text e (coco_m_arg e g 1) (aof b) (aof rc)))
                (block (coco_sb_free (aof b)) (return rc)))
            (set rc (coco_b_atom_to_number e (? (== ($ b s) nil) "" ($ b s)) (coco_m_arg e g 0)))
            (coco_sb_free (aof b))
            (return rc))))

  ;;; Reads TEXT as a Prolog term and insists it is a number. Going through the
  ;;; reader rather than `strtod' is what makes `0xff' and `0'a' work here
  ;;; exactly as they do in a source file.
  (static)
  (func coco_b_atom_to_number ((coco_engine * e) (const char * text) (size_t to)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (size_t t . 0)
              (size_t mark . #'(-> (coco_m_machine e) heap_len)))
          (if (not (coco_read_term_from m text (aof t)))
              (block (set (-> m heap_len) mark) (return 0)))
          (let ((i64 iv . 0) (double d . 0.0))
            (if (or (coco_m_int e t (aof iv)) (coco_m_float e t (aof d)))
                (return (coco_m_unify e to t))))
          (set (-> m heap_len) mark)
          (return 0)))

  (func coco_b_atom_number ((coco_engine * e) (size_t g)) (out int)
        (let ((char buf [4096]) (i64 iv . 0) (double d . 0.0))
          ;; number -> atom
          (if (or (coco_m_int e (coco_m_arg e g 1) (aof iv))
                  (coco_m_float e (coco_m_arg e g 1) (aof d)))
              (let ((coco_strbuf b) (int rc))
                (coco_sb_init (aof b))
                (coco_write_term (coco_m_machine e) (aof b) (coco_m_arg e g 1) 0 0)
                (set rc (coco_m_unify_atom e (coco_m_arg e g 0)
                                         (? (== ($ b s) nil) "" ($ b s))))
                (coco_sb_free (aof b))
                (return rc)))
          ;; atom -> number, and a FAILURE when the atom is not one, which is
          ;; the whole difference between this and `atom_to_term'
          (if (coco_m_is_var e (coco_m_arg e g 0))
              (return (coco_m_instantiation_error e)))
          (if (not (coco_m_text e (coco_m_arg e g 0) buf (sizeof buf)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (return (coco_b_atom_to_number e buf (coco_m_arg e g 1)))))

  (static)
  (func coco_b_case ((coco_engine * e) (size_t g) (int up)) (out int)
        (let ((char buf [4096]))
          (if (not (coco_m_text e (coco_m_arg e g 0) buf (sizeof buf)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (for ((size_t i . 0)) (< i (strlen buf)) ((++ i))
            (let ((int c . #'(bitand (cast int (nth i buf)) 255)))
              (if up
                  (if (and (>= c 97) (<= c 122)) (set (nth i buf) (cast char (- c 32))))
                (if (and (>= c 65) (<= c 90)) (set (nth i buf) (cast char (+ c 32)))))))
          (return (coco_m_unify_atom e (coco_m_arg e g 1) buf))))

  ;;; A one-character atom, for a `chars(...)' sink.
  (static)
  (func coco_fmt_one_char ((coco_engine * e) (char c)) (out size_t)
        (let ((char one [2]))
          (set (nth 0 one) c)
          (set (nth 1 one) (cast char 0))
          (return (coco_new_atom (coco_m_machine e) one))))

  ;;; ---- format/1,2,3 ---------------------------------------------------
  ;;;
  ;;; WHY IT IS HERE AT ALL: SWI's `library(dcg/basics)' generates numbers with
  ;;; `format(codes(H,T), '~d', [I])' -- four calls, and without them half that
  ;;; library only works in the parsing direction. It is also the predicate a
  ;;; Prolog program reaches for more than any other, so its absence was a hole
  ;;; whoever found it next would have fallen into.
  ;;;
  ;;; WHAT IS NOT IMPLEMENTED, and says so rather than guessing: the COLUMN
  ;;; directives `~t', `~|' and `~+'. They lay text out in fields by measuring
  ;;; what has been emitted since the last column stop, which is a second pass
  ;;; over the buffer this does not make. Silently ignoring them would turn a
  ;;; table into a run-on line and blame the program; the error names the
  ;;; directive instead.

  ;;; One argument at a time. Answers 0 when there are none left, which every
  ;;; caller turns into `format/2: not enough arguments'.
  (static)
  (func coco_fmt_arg ((const size_t * items) (size_t n) (size_t * i) (size_t * out))
        (out int)
        (if (>= (cof i) n) (return 0))
        (set (cof out) (nth (cof i) items))
        (set (cof i) (+ (cof i) 1))
        (return 1))

  ;;; A number in BASE, into BUF. Bases 2..36, digits lower or upper case.
  (static)
  (func coco_fmt_radix ((i64 v) (int base) (int upper) (char * buf) (size_t cap))
        (let ((char tmp [80]) (size_t n . 0) (int neg . 0) (u64 u)
              (const char * lo . "0123456789abcdefghijklmnopqrstuvwxyz")
              (const char * up . "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"))
          (if (< v 0) (block (set neg 1) (set u (cast u64 (- 0 v)))) (set u (cast u64 v)))
          (if (== u 0) (block (set (nth n tmp) (cast char 48)) (set n 1)))
          (while (> u 0)
            (set (nth n tmp) (nth (cast size_t (% u (cast u64 base))) (? upper up lo)))
            (set n (+ n 1))
            (set u (/ u (cast u64 base))))
          (let ((size_t k . 0))
            (if neg (block (if (< k (- cap 1)) (block (set (nth k buf) (cast char 45))
                                                      (set k (+ k 1))))))
            (while (> n 0)
              (set n (- n 1))
              (if (< k (- cap 1)) (block (set (nth k buf) (nth n tmp)) (set k (+ k 1)))))
            (set (nth k buf) (cast char 0)))))

  ;;; `~2d' of 1234 is `12.34': the argument says how many digits are after a
  ;;; point that is inserted, not how wide the field is.
  (static)
  (func coco_fmt_fixed ((coco_strbuf * b) (i64 v) (long places)) (out int)
        (let ((char digits [80]) (size_t len . 0) (int neg . #'(? (< v 0) 1 0)))
          (coco_fmt_radix (? neg (- 0 v) v) 10 0 digits (sizeof digits))
          (set len (strlen digits))
          (if neg (if (not (coco_sb_putc b (cast char 45))) (return 0)))
          (if (<= places 0)
              (return (coco_sb_put b digits)))
          ;; a number with fewer digits than places needs leading zeros, and a
          ;; `0.' in front of them -- `~4d' of 7 is `0.0007'
          (if (<= len (cast size_t places))
              (block
               (if (not (coco_sb_put b "0.")) (return 0))
               (for ((size_t i . len)) (< i (cast size_t places)) ((++ i))
                 (if (not (coco_sb_putc b (cast char 48))) (return 0)))
               (return (coco_sb_put b digits))))
          (for ((size_t i . 0)) (< i len) ((++ i))
            (if (== i (- len (cast size_t places)))
                (if (not (coco_sb_putc b (cast char 46))) (return 0)))
            (if (not (coco_sb_putc b (nth i digits))) (return 0)))
          (return 1)))

  ;;; `~D' groups by threes: 1234567 becomes 1,234,567.
  (static)
  (func coco_fmt_grouped ((coco_strbuf * b) (i64 v)) (out int)
        (let ((char digits [80]) (size_t len . 0) (int neg . #'(? (< v 0) 1 0)))
          (coco_fmt_radix (? neg (- 0 v) v) 10 0 digits (sizeof digits))
          (set len (strlen digits))
          (if neg (if (not (coco_sb_putc b (cast char 45))) (return 0)))
          (for ((size_t i . 0)) (< i len) ((++ i))
            (if (and (> i 0) (== 0 (% (- len i) 3)))
                (if (not (coco_sb_putc b (cast char 44))) (return 0)))
            (if (not (coco_sb_putc b (nth i digits))) (return 0)))
          (return 1)))

  ;;; THE TEXT OF A TERM, OF ANY LENGTH, put on the end of B: what
  ;;; `coco_m_text' takes -- a string with no NUL in it, an atom, an integer,
  ;;; a list of codes 1 to 255 or of one-character atoms -- without its
  ;;; buffer. Answers 1, or 0 for a term that is not text, B left as it was.
  ;;; `~a' and `~s' (and the format itself, and term_to_atom/2 reading an
  ;;; atom) went through a buffer of 8192 bytes, and text that long raised
  ;;; `format/2: ~s wants text' -- naming the one thing that was not wrong.
  ;;; library(xml) writes its whole document with one `~s', so every
  ;;; document of 8 KB or more failed the same way (fixed in 1.10.6).
  (static)
  (func coco_text_put ((coco_engine * e) (size_t t) (coco_strbuf * b)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t keep . #'(-> b len)) (i64 iv . 0)
              (const char * sp . nil) (size_t sn . 0))
          (set t (coco_deref m t))
          (if (coco_string_text m t (aof sp) (aof sn))
              (block
               (for ((size_t i . 0)) (< i sn) ((++ i))
                    (if (== (nth i sp) (cast char 0)) (return 0)))
               (return (coco_sb_put_len b sp sn))))
          (if (coco_m_is_atom e t)
              (return (coco_sb_put b (coco_atom_name m (coco_name_of m t)))))
          (if (coco_m_int e t (aof iv))
              (return (coco_sb_put_i64 b iv)))
          ;; a list of character codes -- what "abc" reads as -- or, under
          ;; `double_quotes = chars', of one-character atoms. One that is its
          ;; own tail is no text: past the heap's length the walk has gone
          ;; round (1.10.19; a format, its `~s' and term_to_atom/2 wrote until
          ;; memory ran out), counted down in the machine (`lbudget'), as the
          ;; other list walks count
          (set (-> m lbudget) (-> m heap_len))
          (while 1
            (if (coco_m_is_atom e t)
                (block
                 (if (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) "[]")) (return 1))
                 break))
            (if (not (coco_is_cons m t)) break)
            (if (== (-- (-> m lbudget)) 0) break)
            (let ((size_t h . #'(coco_deref m (coco_arg m t 0))) (i64 c . 0))
              (if (not (coco_m_int e h (aof c)))
                  (block
                   (if (not (coco_m_is_atom e h)) break)
                   (let ((const char * cs . #'(coco_atom_name m (coco_name_of m h))))
                     (if (!= (strlen cs) 1) break)
                     (set c (cast i64 (bitand (cast int (nth 0 cs)) 255))))))
              (if (or (< c 1) (> c 255)) break)
              (if (not (coco_sb_putc b (cast char c))) break))
            (set t (coco_deref m (coco_arg m t 1))))
          ;; not text: whatever the walk put on is taken off again
          (set (-> b len) keep)
          (if (!= (-> b s) nil) (set (nth keep (-> b s)) (cast char 0)))
          (return 0)))

  ;;; Builds the whole of one format into B. Answers 1, or 0 with ERR set to a
  ;;; message the caller raises -- so that every way of going wrong is reported
  ;;; the same way whichever of the three arities was called.
  (static)
  (func coco_fmt_build ((coco_engine * e) (const char * f) (const size_t * items)
                        (size_t n) (coco_strbuf * b) (char * err) (size_t errlen))
        (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (size_t ai . 0) (size_t i . 0))
          (while (!= (nth i f) 0)
            ;; 126 is `~'
            (if (!= (nth i f) 126)
                (block (if (not (coco_sb_putc b (nth i f)))
                           (block (snprintf err errlen "format/2: out of memory") (return 0)))
                       (set i (+ i 1))
                       continue))
            (set i (+ i 1))
            (let ((long num . 0) (int have . 0) (char d))
              ;; 42 is `*': the count comes from the arguments
              (if (== (nth i f) 42)
                  (let ((size_t a . 0) (i64 v . 0))
                    (if (not (coco_fmt_arg items n (aof ai) (aof a)))
                        (block (snprintf err errlen "format/2: not enough arguments") (return 0)))
                    (if (not (coco_m_int e a (aof v)))
                        (block (snprintf err errlen "format/2: ~* wants an integer") (return 0)))
                    (set num (cast long v)) (set have 1) (set i (+ i 1)))
                (while (and (>= (nth i f) 48) (<= (nth i f) 57))
                  (set num (+ (* num 10) (cast long (- (nth i f) 48))))
                  (set have 1)
                  (set i (+ i 1))))
              (set d (nth i f))
              (if (== d 0)
                  (block (snprintf err errlen "format/2: the format ends in `~~'") (return 0)))
              (set i (+ i 1))

              ;; 126 `~~', 110 `~n', 105 `~i'
              (if (== d 126)
                  (block (coco_sb_putc b (cast char 126)) continue))
              (if (== d 110)
                  (block (for ((long k . 0)) (< k (? have num 1)) ((++ k))
                           (coco_sb_putc b (cast char 10)))
                         continue))
              (if (== d 105)
                  (let ((size_t a . 0))
                    (if (not (coco_fmt_arg items n (aof ai) (aof a)))
                        (block (snprintf err errlen "format/2: not enough arguments") (return 0)))
                    continue))
              ;; 116 `~t', 124 `~|', 43 `~+' -- see the head of this section
              (if (or (or (== d 116) (== d 124)) (== d 43))
                  (block (snprintf err errlen
                                   "format/2: cocolog has no column directives (~~t, ~~| and ~~+)")
                         (return 0)))

              ;; everything below takes an argument
              (let ((size_t a . 0))
                (if (not (coco_fmt_arg items n (aof ai) (aof a)))
                    (block (snprintf err errlen "format/2: not enough arguments") (return 0)))

                ;; 119 `~w', 113 `~q', 112 `~p'
                (if (or (or (== d 119) (== d 113)) (== d 112))
                    (block (coco_write_term m b a (? (== d 113) 1 0) 0) continue))

                ;; 97 `~a', 115 `~s' -- an atom, or a list of codes, of any
                ;; length (`coco_text_put')
                (if (or (== d 97) (== d 115))
                    (block
                      (if (not (coco_text_put e a b))
                          (block (snprintf err errlen
                                           "format/2: ~~%c wants text" d)
                                 (return 0)))
                      continue))

                ;; 99 `~c' -- a code, NUM times
                (if (== d 99)
                    (let ((i64 v . 0))
                      (if (not (coco_m_int e a (aof v)))
                          (block (snprintf err errlen "format/2: ~~c wants a code") (return 0)))
                      (for ((long k . 0)) (< k (? have num 1)) ((++ k))
                        (coco_sb_putc b (cast char v)))
                      continue))

                ;; 100 `~d', 68 `~D'
                (if (or (== d 100) (== d 68))
                    (let ((i64 v . 0))
                      (if (not (coco_m_int e a (aof v)))
                          (block (snprintf err errlen "format/2: ~~%c wants an integer" d)
                                 (return 0)))
                      (if (== d 68)
                          (coco_fmt_grouped b v)
                        (coco_fmt_fixed b v (? have num 0)))
                      continue))

                ;; 114 `~r', 82 `~R' -- NUM is the base
                (if (or (== d 114) (== d 82))
                    (let ((i64 v . 0) (char buf [80]))
                      (if (not (coco_m_int e a (aof v)))
                          (block (snprintf err errlen "format/2: ~~%c wants an integer" d)
                                 (return 0)))
                      (if (or (< num 2) (> num 36))
                          (block (snprintf err errlen
                                           "format/2: ~~%c wants a base between 2 and 36" d)
                                 (return 0)))
                      (coco_fmt_radix v (cast int num) (? (== d 82) 1 0) buf (sizeof buf))
                      (coco_sb_put b buf)
                      continue))

                ;; 101 `~e', 102 `~f', 103 `~g'
                (if (or (or (== d 101) (== d 102)) (== d 103))
                    (let ((double v . 0.0) (i64 iv . 0) (char buf [128]) (char spec [16]))
                      (if (not (coco_m_float e a (aof v)))
                          (if (coco_m_int e a (aof iv))
                              (set v (cast double iv))
                            (block (snprintf err errlen "format/2: ~~%c wants a number" d)
                                   (return 0))))
                      (snprintf spec (sizeof spec) "%%.%ld%c" (? have num 6) d)
                      (snprintf buf (sizeof buf) spec v)
                      (coco_sb_put b buf)
                      continue))

                (snprintf err errlen "format/2: no such directive ~~%c" d)
                (return 0))))
          (return 1)))

  ;;; The arguments, as an array. `format("~w", foo)' is legal and means one
  ;;; argument, so anything that is not a proper list is taken for a single
  ;;; term -- SWI's rule, and the reason `format("~w", [1,2])' means two
  ;;; arguments while `format("~w", [[1,2]])' means one.
  (static)
  (func coco_fmt_args ((coco_engine * e) (size_t t) (size_t ** items) (size_t * n)
                       (size_t * one)) (out int)
        (if (coco_m_list_array e t items n) (return 1))
        (set (nth 0 one) t)
        (set (cof items) one)
        (set (cof n) 1)
        (return 0))          ; 0 means "do not free it"

  ;;; Puts TEXT where SINK says. SINK is `(cast size_t -1)' for stdout -- what
  ;;; format/1,2 pass -- and otherwise one of the
  ;;; forms `format/3' and `with_output_to/2' share -- a stream by name, or a
  ;;; term to unify with the text.
  ;;;
  ;;; `codes(H, T)' and `chars(H, T)' ask for a DIFFERENCE list: H is the text
  ;;; followed by T, not by `[]'. That is what makes the four `format/3' calls
  ;;; in SWI's dcg/basics work as grammar bodies -- each appends to whatever is
  ;;; still to come, which is exactly what a DCG body has to do.
  ;;;
  ;;; A SINK A MODULE OWNS IS ASKED ABOUT FIRST: library(stream) installs a
  ;;; hook (`coco_m_sink_install') and takes '$stream'(N), a stream's alias,
  ;;; and user_output while a file is the current output. It answers 0 for
  ;;; everything else, so with no module loaded nothing below has moved.
  (static)
  (func coco_sink_deliver ((coco_engine * e) (size_t sink) (const char * out)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)))
          ;; STDOUT IS SIZE_MAX, AND WAS 0 UNTIL 1.8.34 -- but 0 is a heap cell
          ;; like any other, the first term the reader built, so a query whose
          ;; first term was its sink atom (`format(nosuch_sink, x, [])') took
          ;; this path and printed where it should have raised, and an alias
          ;; there would have gone to stdout. No cell index reaches SIZE_MAX.
          (if (== sink (cast size_t -1)) (block (fputs out stdout) (return 1)))
          (let ((int hooked . #'(coco_m_sink_call e sink out (strlen out))))
            (if (!= hooked 0) (return hooked)))

          (let ((size_t d . #'(coco_deref m sink)))
            (if (not (coco_is_callable m d))
                (return (coco_m_domain_error e "output_sink" sink)))

            ;; a stream by name
            (if (== (coco_arity m d) 0)
                (let ((const char * nm . #'(coco_atom_name m (coco_name_of m d))))
                  (if (== 0 (strcmp nm "user_output")) (block (fputs out stdout) (return 1)))
                  (if (== 0 (strcmp nm "user_error")) (block (fputs out stderr) (return 1)))
                  (return (coco_m_domain_error e "output_sink" sink))))

            (let ((const char * nm . #'(coco_atom_name m (coco_name_of m d)))
                  (u32 ar . #'(coco_arity m d))
                  (int as_chars . 0) (int as_atom . 0) (int as_string . 0))
              (if (== 0 (strcmp nm "atom")) (set as_atom 1))
              (if (== 0 (strcmp nm "chars")) (set as_chars 1))
              ;; `string(S)' IS A SINK NOW, and it was a domain_error for as
              ;; long as there was no string type to put anything in. SWI's
              ;; `format(string(S), ...)' is the ordinary way to build one, so
              ;; leaving it refused would have meant a type you can make with
              ;; twelve predicates and cannot format into.
              (if (== 0 (strcmp nm "string")) (set as_string 1))
              (if (and (and (not as_atom) (not as_chars))
                       (and (not as_string) (!= 0 (strcmp nm "codes"))))
                  (return (coco_m_domain_error e "output_sink" sink)))
              (if (or (< ar 1) (> ar 2))
                  (return (coco_m_domain_error e "output_sink" sink)))
              ;; `atom(A, B)' is not a thing -- only the LIST sinks take a
              ;; tail, because a difference list is the only one of the four
              ;; that has anywhere to put it.
              (if (and (or as_atom as_string) (== ar 2))
                  (return (coco_m_domain_error e "output_sink" sink)))

              (if as_atom
                  (return (? (coco_m_unify_atom e (coco_arg m d 0) out) 1 0)))
              (if as_string
                  (return (? (coco_m_unify_string e (coco_arg m d 0) out (strlen out)) 1 0)))

              (let ((size_t tail . #'(? (== ar 2) (coco_arg m d 1) (coco_m_nil e)))
                    (size_t acc) (size_t len . #'(strlen out)))
                (set acc tail)
                (while (> len 0)
                  (set len (- len 1))
                  (let ((size_t c . #'(? as_chars
                                         (coco_fmt_one_char e (nth len out))
                                         (coco_new_int m (cast i64 (bitand (cast int (nth len out)) 255))))))
                    (set acc (coco_m_cons e c acc))))
                (return (? (coco_m_unify e (coco_arg m d 0) acc) 1 0)))))))

  ;;; Shared by all three arities. SINK is `(cast size_t -1)' for stdout.
  (static)
  (func coco_fmt_do ((coco_engine * e) (size_t sink) (size_t fmt) (size_t argt))
        (out int)
        (let ((coco_strbuf fb) (char err [192])
              (coco_strbuf b) (size_t * items . nil) (size_t n . 0)
              (size_t one [1]) (int owned . 0) (int ok . 0))

          ;; the format itself is text: an atom, or the code list "..." reads
          ;; as -- of any length, as its arguments are
          (coco_sb_init (aof fb))
          (if (not (coco_text_put e fmt (aof fb)))
              (block (coco_sb_free (aof fb))
                     (return (coco_m_type_error e "text" fmt))))

          (set owned (coco_fmt_args e argt (aof items) (aof n) one))
          (coco_sb_init (aof b))
          (set (nth 0 err) (cast char 0))
          (set ok (coco_fmt_build e (? (== ($ fb s) nil) "" ($ fb s)) items n (aof b) err (sizeof err)))
          (coco_sb_free (aof fb))
          (if owned (free items))

          ;; WHAT WAS FORMATTED BEFORE THE ERROR STILL COMES OUT, when the
          ;; sink is a stream. SWI formats straight to the stream and so emits
          ;; everything up to the directive that failed; this builds a buffer
          ;; first, so it has to put the buffer out by hand to behave the same.
          ;; `format("~w ~w", [one])' prints `one ' and then raises, in both.
          ;; A term sink gets nothing: there is no half-built atom to unify.
          (if (not ok)
              (block
               (if (== sink (cast size_t -1))
                   (if (!= ($ b s) nil) (fputs ($ b s) stdout)))
               (coco_sb_free (aof b))
               ;; a refused buffer is resource_error(memory) (1.10.28)
               (if (== 0 (strcmp err "format/2: out of memory"))
                   (return (coco_m_resource_error e "memory")))
               (return (coco_m_error e err ""))))

          (let ((int rc . #'(coco_sink_deliver e sink (? (== ($ b s) nil) "" ($ b s)))))
            (coco_sb_free (aof b))
            (return rc))))

  ;;; ---- with_output_to/2 -----------------------------------------------
  ;;;
  ;;; `with_output_to(codes(H, T), write(F))' -- SWI's dcg/basics uses exactly
  ;;; that, once, to render a float. It is also the general answer to "what did
  ;;; this goal print", which nothing else here can ask.
  ;;;
  ;;; TWO AWKWARD THINGS, both worth knowing about before touching this.
  ;;;
  ;;; FIRST, THE REDIRECTION IS AT THE FILE DESCRIPTOR, not at a `FILE *' this
  ;;; code passes around. cocolog writes with `printf', `fputs' and `fputc' to
  ;;; the literal `stdout' in some seventy places; threading a stream argument
  ;;; through all of them is the tidier design and a much larger change. So fd 1
  ;;; is pointed at a `tmpfile' for the duration and put back afterwards. A
  ;;; temporary file and not a pipe: a pipe holds 64K and a goal that printed
  ;;; more than that would block for ever with nobody reading.
  ;;;
  ;;; SECOND, THE GOAL RUNS IN A NESTED ENGINE and so cannot be suspended. That
  ;;; is the same limit `findall/3' has and for the same reason -- a builtin
  ;;; cannot hand a continuation back to the engine that called it. A machine
  ;;; frozen in the middle of one of these would have to freeze a redirected
  ;;; file descriptor with it, which is not a thing a database row can hold.
  ;;;
  ;;; It is `once/1' and not a generator: the FIRST solution is kept, with its
  ;;; bindings, and the goal is not re-entered. SWI's is semi-deterministic too.
  (func coco_b_with_output_to ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t sink . #'(coco_m_arg e g 0))
              (size_t goal . #'(coco_m_arg e g 1))
              (coco_engine sub)
              (FILE * tmp . nil) (int saved . -1) (int rc . 0)
              (int threw . 0) (size_t ball_cell . 0) (size_t ball_size . 0)
              (char * text . nil) (long len . 0))

          (if (coco_m_is_var e goal) (return (coco_m_instantiation_error e)))

          (set tmp (tmpfile))
          (if (== tmp nil) (return (coco_m_error e "with_output_to/2" "cannot open a temporary file")))
          (fflush stdout)
          (set saved (dup 1))
          (if (< saved 0)
              (block (fclose tmp)
                     (return (coco_m_error e "with_output_to/2" "cannot save stdout"))))
          (if (< (dup2 (fileno tmp) 1) 0)
              (block (close saved) (fclose tmp)
                     (return (coco_m_error e "with_output_to/2" "cannot redirect stdout"))))

          (coco_engine_init (aof sub) m st)
          ;; the inner goal spends the outer one's remaining budget, so a step
          ;; limit cannot be overrun from in here
          (if (!= (-> e max_steps) 0)
              (set ($ sub max_steps)
                   (? (>= (-> e steps) (-> e max_steps)) 1
                      (- (-> e max_steps) (-> e steps)))))
          (coco_engine_ask (aof sub) goal)
          ;; the trace follows the proof inside, depth and all, as it does
          ;; into a findall's -- through 1.10.16 this engine traced as
          ;; `--trace' had started it whatever trace/0 and notrace/0 had said
          ;; since, and counted its depths from 1 (1.10.17, the backtrace)
          (set ($ sub trace) (-> e trace))
          (set ($ sub trace_depth) (-> e trace_depth))
          (set ($ sub trace_goal) (-> e trace_goal))
          ;; THE GOAL MAY COLLECT THE HEAP (1.9.4; `coco_engine_findall'):
          ;; the sink, which is read after it, is told to the collector, and
          ;; the machine's marks at the start go with the inner engine
          (let ((size_t hold [1]) (size_t * holdp . nil) (size_t nhold . 1) (int held . 0))
            (set (nth 0 hold) sink)
            (set holdp hold)
            (set held (coco_heap_root_push m (aof holdp) (aof nhold)))
            (set ($ sub ptrail) ($ (cof m) trail_len))
            (set ($ sub pheap) ($ (cof m) heap_len))
            (set ($ sub gc) (? (and held (-> e gc)) 1 0))
            (let ((size_t gsaved . #'(coco_gc_nested_begin m ($ sub pheap))))
              (set rc (coco_engine_next (aof sub)))
              (coco_gc_nested_end m gsaved))
            (if held (coco_heap_root_pop m))
            (set sink (nth 0 hold)))
          (set (-> e steps) (+ (-> e steps) ($ sub steps)))
          ;; AND THE BALL WITH IT, which this did not do until 1.2.12 and the
          ;; other six nested-engine builtins have done since 1.1.0. A
          ;; sub-engine has a choice stack of its own, so a `throw' inside the
          ;; goal finds no catch frame THERE and comes back as an error --
          ;; and copying the message out while dropping the term made
          ;;
          ;;     catch(with_output_to(atom(A), G), E, true)
          ;;
          ;; catch nothing: the query simply ended. findall/3,4, forall/2,
          ;; aggregate_all/3, bagof/3 and setof/3 are `coco_engine_findall'
          ;; and were all fixed together; this one is its own sub-engine in
          ;; this file and was missed. The cell is read HERE, before
          ;; `coco_engine_free' memsets the sub-engine, and thrown again below
          ;; once stdout is back where it belongs.
          (if (== rc -1)
              (block (snprintf (-> e err) 512 "%s" ($ sub err))
                     (if ($ sub has_ball)
                         (block (set threw 1) (set ball_cell ($ sub ball_cell))
                                (set ball_size ($ sub ball_size))))))
          (coco_engine_free (aof sub))

          ;; PUT STDOUT BACK BEFORE ANYTHING ELSE, whatever happened. An early
          ;; return from here on would leave the process writing into a file
          ;; nobody will ever read.
          (fflush stdout)
          (dup2 saved 1)
          (close saved)

          (if (!= rc 1)
              (block (fclose tmp)
                     ;; THROWN AGAIN, IN THE OUTER ENGINE, where the catch
                     ;; frames are -- and stdout is already restored above, so
                     ;; a recovery goal that prints prints to the terminal
                     ;; rather than into a temporary file nobody will read. 2
                     ;; is the builtin protocol's "the continuation is already
                     ;; set"; -1 when nothing caught it, which is the uncaught
                     ;; path this had always taken.
                     ;;
                     ;; AND THE TWO ARMS WERE THE WRONG WAY ROUND, which made
                     ;; a goal that merely FAILED throw. `(if C A B)' runs A
                     ;; when C holds, so a ball was counted dead and never
                     ;; rethrown, while a plain failure fell into the else and
                     ;; threw `coco_store_get(st, 0)' -- cell zero, whatever
                     ;; the store happened to put there first. Measured:
                     ;; `with_output_to(codes(C), fail)' threw
                     ;; `file_base_name(A,B):-'$path_split'(A,C,B)', the first
                     ;; clause of library(files)'s Prolog half, on every sink
                     ;; and whether or not the program loaded that library.
                     ;; SWI's with_output_to/2 fails when its goal fails.
                     (if threw
                         (block (set (-> st dead) (+ (-> st dead) ball_size))
                                ;; the inner throw's backtrace is the one kept
                                (set (-> m btkeep) 1)
                                (return (? (coco_m_thrown e (coco_store_read m st ball_cell)) 2 -1))))
                     (if (== rc -1) (return -1))
                     (return 0)))

          (fflush tmp)
          (fseek tmp 0 SEEK_END)
          (set len (ftell tmp))
          (if (< len 0) (set len 0))
          (set text (cast (char *) (malloc (cast size_t (+ len 1)))))
          (if (== text nil)
              (block (fclose tmp)
                     (return (coco_m_resource_error e "memory"))))
          (rewind tmp)
          (if (> len 0)
              (if (!= (cast long (fread text 1 (cast size_t len) tmp)) len)
                  (block (free text) (fclose tmp)
                         (return (coco_m_error e "with_output_to/2" "cannot read back the output")))))
          (set (nth (cast size_t len) text) (cast char 0))
          (fclose tmp)

          (let ((int out . #'(coco_sink_deliver e sink text)))
            (free text)
            (return out))))

  ;;; `flush_output/0' -- SWI'S, AND IT WAS MISSING. cocolog writes to the
  ;;; literal stdout, which the C library buffers by LINE at a terminal and
  ;;; by BLOCK everywhere else. So a program that prints a marker and then
  ;;; blocks -- a server saying it is listening, a long job saying where it
  ;;; has got to -- prints nothing at all when its output is a pipe or a
  ;;; file, and everything at once when it finally exits.
  ;;;
  ;;; FOUND BY WRITING test/tls.sh. The server printed READY, the harness
  ;;; waited for READY to appear in the log, and the log stayed empty until
  ;;; the server gave up and exited -- at which point the whole transcript
  ;;; arrived, correct and far too late. Interactively it had always
  ;;; worked, because a terminal is line buffered.
  ;;;
  ;;; No argument, because there is one output. When cocolog grows a stream
  ;;; layer this becomes `flush_output/1' with this as its default.
  (func coco_b_flush ((coco_engine * e) (size_t g)) (out int)
        (fflush stdout)
        (return 1))

  (func coco_b_format1 ((coco_engine * e) (size_t g)) (out int)
        (return (coco_fmt_do e (cast size_t -1) (coco_m_arg e g 0) (coco_m_nil e))))

  (func coco_b_format2 ((coco_engine * e) (size_t g)) (out int)
        (return (coco_fmt_do e (cast size_t -1) (coco_m_arg e g 0) (coco_m_arg e g 1))))

  (func coco_b_format3 ((coco_engine * e) (size_t g)) (out int)
        (return (coco_fmt_do e (coco_m_arg e g 0) (coco_m_arg e g 1) (coco_m_arg e g 2))))


  ;;; ---- character classification ---------------------------------------
  ;;;
  ;;; `code_type/2' and `char_type/2'. WRITTEN AGAINST A RUNNING SWI, not
  ;;; against its manual, because the two disagree in places that matter here:
  ;;;
  ;;;   `alpha' is LETTERS ONLY -- the manual says "letter or digit", and the
  ;;;   implementation agrees with neither the manual nor `alnum'.
  ;;;
  ;;;   `to_upper(L)' gives the LOWERCASE of the code, and `to_lower(U)' the
  ;;;   uppercase. Read once that seems backwards; the name describes what the
  ;;;   code can be converted TO, and the argument is the other case. SWI's own
  ;;;   `library(dcg/basics)' relies on it: `alpha_to_lower' matches a letter
  ;;;   and takes `to_upper(L)' to get L lowercased.
  ;;;
  ;;; test/files/ctype.pl walks 0..127 through every category in both systems
  ;;; and compares, so a guess here does not survive.
  ;;;
  ;;; ASCII ONLY. `isalpha' and friends are locale-dependent and cocolog reads
  ;;; bytes, so the classification is written out rather than delegated -- a C
  ;;; library in another locale must not change what a program means.
  (static)
  (func coco_ct_upper ((int c)) (out int) (return (? (and (>= c 65) (<= c 90)) 1 0)))
  (static)
  (func coco_ct_lower ((int c)) (out int) (return (? (and (>= c 97) (<= c 122)) 1 0)))
  (static)
  (func coco_ct_digit ((int c)) (out int) (return (? (and (>= c 48) (<= c 57)) 1 0)))
  (static)
  (func coco_ct_alpha ((int c)) (out int)
        (return (? (or (coco_ct_upper c) (coco_ct_lower c)) 1 0)))
  (static)
  (func coco_ct_alnum ((int c)) (out int)
        (return (? (or (coco_ct_alpha c) (coco_ct_digit c)) 1 0)))
  (static)
  (func coco_ct_tolower ((int c)) (out int) (return (? (coco_ct_upper c) (+ c 32) c)))
  (static)
  (func coco_ct_toupper ((int c)) (out int) (return (? (coco_ct_lower c) (- c 32) c)))

  ;;; The hex weight of C, or -1.
  (static)
  (func coco_ct_xweight ((int c)) (out int)
        (if (coco_ct_digit c) (return (- c 48)))
        (if (and (>= c 97) (<= c 102)) (return (+ 10 (- c 97))))
        (if (and (>= c 65) (<= c 70)) (return (+ 10 (- c 65))))
        (return -1))

  ;;; The categories with no argument. Answers 1, 0, or -1 for "not a category
  ;;; I know", which the caller turns into a domain error rather than a silent
  ;;; failure -- a typo in a type name should say so.
  (static)
  (func coco_ct_plain ((const char * t) (int c)) (out int)
        (if (== 0 (strcmp t "alpha"))   (return (coco_ct_alpha c)))
        (if (== 0 (strcmp t "alnum"))   (return (coco_ct_alnum c)))
        (if (== 0 (strcmp t "digit"))   (return (coco_ct_digit c)))
        (if (== 0 (strcmp t "upper"))   (return (coco_ct_upper c)))
        (if (== 0 (strcmp t "lower"))   (return (coco_ct_lower c)))
        ;; csym is alnum plus underscore, csymf the same without the digits:
        ;; what may appear in a C identifier, and what may start one
        (if (== 0 (strcmp t "csym"))    (return (? (or (coco_ct_alnum c) (== c 95)) 1 0)))
        (if (== 0 (strcmp t "csymf"))   (return (? (or (coco_ct_alpha c) (== c 95)) 1 0)))
        (if (== 0 (strcmp t "ascii"))   (return (? (and (>= c 0) (<= c 127)) 1 0)))
        ;; `space' is every blank; `white' only the two that can sit inside a
        ;; line. That distinction is the whole reason both exist.
        (if (== 0 (strcmp t "space"))
            (return (? (or (== c 32) (and (>= c 9) (<= c 13))) 1 0)))
        (if (== 0 (strcmp t "white"))   (return (? (or (== c 32) (== c 9)) 1 0)))
        (if (== 0 (strcmp t "cntrl"))   (return (? (or (< c 32) (== c 127)) 1 0)))
        (if (== 0 (strcmp t "graph"))   (return (? (and (> c 32) (< c 127)) 1 0)))
        (if (== 0 (strcmp t "print"))   (return (? (and (>= c 32) (< c 127)) 1 0)))
        (if (== 0 (strcmp t "punct"))
            (return (? (and (and (> c 32) (< c 127)) (not (coco_ct_alnum c))) 1 0)))
        (if (== 0 (strcmp t "end_of_line")) (return (? (and (>= c 10) (<= c 13)) 1 0)))
        (if (== 0 (strcmp t "newline"))  (return (? (== c 10) 1 0)))
        (if (== 0 (strcmp t "period"))   (return (? (or (or (== c 46) (== c 33)) (== c 63)) 1 0)))
        (if (== 0 (strcmp t "quote"))
            (return (? (or (or (== c 39) (== c 34)) (== c 96)) 1 0)))
        ;; what may start and continue a Prolog variable or identifier
        (if (== 0 (strcmp t "prolog_var_start"))
            (return (? (or (coco_ct_upper c) (== c 95)) 1 0)))
        (if (== 0 (strcmp t "prolog_atom_start")) (return (coco_ct_lower c)))
        (if (== 0 (strcmp t "prolog_identifier_continue"))
            (return (? (or (coco_ct_alnum c) (== c 95)) 1 0)))
        (if (== 0 (strcmp t "prolog_symbol"))
            ;; `c' is guarded because `strchr' finds the terminating NUL and
            ;; would call code 0 a symbol character
            (return (? (and (!= c 0) (!= nil (strchr "+-*/\\^<>=~:.?@#&$" c))) 1 0)))
        (return -1))

  ;;; The shared half of `code_type/2' and `char_type/2'. AS_CHAR says whether
  ;;; the argument, and any code the category hands back, is a one-character
  ;;; atom rather than a number -- the only difference between the two.
  (static)
  (func coco_b_ctype ((coco_engine * e) (size_t g) (int as_char)) (out int)
        (let ((size_t ct . #'(coco_m_arg e g 0))
              (size_t ty . #'(coco_m_arg e g 1))
              (int c . 0))

          ;; ENUMERATING IS NOT SUPPORTED. `code_type(C, alpha)' with C unbound
          ;; has fifty-two answers and a builtin here cannot succeed twice --
          ;; see the head of lib/solve.cicili. Raising says so; failing would
          ;; read as "no letters are alphabetic".
          (if (coco_m_is_var e ct) (return (coco_m_instantiation_error e)))

          (if as_char
              (let ((char buf [8]))
                (if (not (coco_m_text e ct buf (sizeof buf)))
                    (return (coco_m_type_error e "character" ct)))
                (if (!= 1 (cast int (strlen buf)))
                    (return (coco_m_type_error e "character" ct)))
                (set c (bitand (cast int (nth 0 buf)) 255))) 
            (let ((i64 v . 0))
              (if (not (coco_m_int e ct (aof v)))
                  (return (coco_m_type_error e "integer" ct)))
              (set c (cast int v))))

          (if (coco_m_is_var e ty) (return (coco_m_instantiation_error e)))
          (if (not (coco_m_is_atom e ty))
              ;; a category with an argument: `upper(L)', `xdigit(W)' and so on
              (let ((coco_machine * mm . #'(coco_m_machine e))
                    (size_t d . #'(coco_deref mm ty)))
                (if (or (not (coco_is_callable mm d)) (!= (coco_arity mm d) 1))
                    (return (coco_m_type_error e "char_type" ty)))
                (let ((const char * tn . #'(coco_atom_name mm (coco_name_of mm d)))
                      (size_t a . #'(coco_arg mm d 0))
                      (int want . -1) (int weight . 0))

                  (if (== 0 (strcmp tn "upper"))
                      (block (if (not (coco_ct_upper c)) (return 0))
                             (set want (coco_ct_tolower c))))
                  (if (== 0 (strcmp tn "lower"))
                      (block (if (not (coco_ct_lower c)) (return 0))
                             (set want (coco_ct_toupper c))))
                  ;; to_upper/to_lower succeed for ANY code -- they are "can be
                  ;; converted", and a code with no other case converts to itself
                  (if (== 0 (strcmp tn "to_upper")) (set want (coco_ct_tolower c)))
                  (if (== 0 (strcmp tn "to_lower")) (set want (coco_ct_toupper c)))

                  (if (== 0 (strcmp tn "digit"))
                      (block (if (not (coco_ct_digit c)) (return 0))
                             ;; the WEIGHT, not the code: `digit(W)' of `7' is 7
                             (set weight (- c 48))
                             (return (? (coco_m_unify_int e a (cast i64 weight)) 1 0))))
                  (if (== 0 (strcmp tn "xdigit"))
                      (block (set weight (coco_ct_xweight c))
                             (if (< weight 0) (return 0))
                             (return (? (coco_m_unify_int e a (cast i64 weight)) 1 0))))

                  (if (< want 0) (return (coco_m_type_error e "char_type" ty)))
                  (if as_char
                      (let ((char one [2]))
                        (set (nth 0 one) (cast char want))
                        (set (nth 1 one) (cast char 0))
                        (return (? (coco_m_unify_atom e a one) 1 0))))
                  (return (? (coco_m_unify_int e a (cast i64 want)) 1 0)))))

          (let ((int r . #'(coco_ct_plain (coco_m_atom e ty) c)))
            (if (< r 0) (return (coco_m_type_error e "char_type" ty)))
            (return r))))

  (func coco_b_code_type ((coco_engine * e) (size_t g)) (out int)
        (return (coco_b_ctype e g 0)))

  (func coco_b_char_type ((coco_engine * e) (size_t g)) (out int)
        (return (coco_b_ctype e g 1)))

  (func coco_b_upcase ((coco_engine * e) (size_t g)) (out int) (return (coco_b_case e g 1)))
  (func coco_b_downcase ((coco_engine * e) (size_t g)) (out int) (return (coco_b_case e g 0)))

  ;;; Both directions: a term written out, or an atom read back in -- of any
  ;;; length (`coco_text_put'; it was a buffer of 8192 bytes).
  (func coco_b_term_to_atom ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)))
          (if (not (coco_m_is_var e (coco_m_arg e g 0)))
              (let ((coco_strbuf b) (int rc))
                (coco_sb_init (aof b))
                (coco_write_term m (aof b) (coco_m_arg e g 0) 1 0)
                (set rc (coco_m_unify_atom e (coco_m_arg e g 1)
                                         (? (== ($ b s) nil) "" ($ b s))))
                (coco_sb_free (aof b))
                (return rc)))
          (let ((coco_strbuf tb) (size_t t . 0) (int rc))
            (coco_sb_init (aof tb))
            ;; `text', as SWI names it (1.10.19; it said `atom'): a code
            ;; list is text here too, and a list that is its own tail none
            (if (not (coco_text_put e (coco_m_arg e g 1) (aof tb)))
                (block (coco_sb_free (aof tb))
                       (return (coco_m_type_error e "text" (coco_m_arg e g 1)))))
            (if (not (coco_read_term_from m (? (== ($ tb s) nil) "" ($ tb s)) (aof t)))
                (block
                 (set rc (coco_m_error e "term_to_atom/2 cannot read" (? (== ($ tb s) nil) "" ($ tb s))))
                 (coco_sb_free (aof tb))
                 (return rc)))
            (coco_sb_free (aof tb))
            (return (coco_m_unify e (coco_m_arg e g 0) t)))))

  ;;; One substring, at a known place and length. The enumeration is in the
  ;;; Coco half, where the engine can make the choice points.
  ;;; THIS HAD A 4096-BYTE CLIFF and reported it as the wrong error entirely.
  ;;; Two fixed buffers and a `coco_m_text' that answers 0 for "does not fit"
  ;;; exactly as it does for "not text at all" -- so `sub_atom' on an atom of
  ;;; 4096 characters raised `type_error(atom, <the atom>)', which is a
  ;;; diagnosis pointing at the one thing that was not wrong. 4095 worked.
  ;;;
  ;;; Found by library(httpd) reading a 5000-byte response back, which is the
  ;;; ordinary size of a web page and not an exotic input at all.
  ;;;
  ;;; THE ATOM IS NOW READ WHERE IT LIVES. `coco_m_atom' hands back the
  ;;; pointer into the atom table, so the common case copies NOTHING before
  ;;; the substring itself -- which is both the fix and faster than what it
  ;;; replaces. Only the substring is allocated, and only for as long as it
  ;;; takes to intern it.
  ;;;
  ;;; ORDER MATTERS ON THE NEXT FOUR LINES: the integers are read BEFORE the
  ;;; pointer is taken, because anything that allocates can move the atom
  ;;; table under it. Nothing between `coco_m_atom' and the `memcpy' does.
  (func coco_b_sub_atom_at ((coco_engine * e) (size_t g)) (out int)
        (let ((const char * s . nil) (char num [64]) (char * out . nil)
              (i64 before . 0) (i64 len . 0) (size_t n . 0) (int rc . 1))
          (if (not (coco_m_int e (coco_m_arg e g 1) (aof before))) (return 0))
          (if (not (coco_m_int e (coco_m_arg e g 2) (aof len))) (return 0))
          (if (or (< before 0) (< len 0)) (return 0))
          (set s (coco_m_atom e (coco_m_arg e g 0)))
          ;; Not an atom: an integer, which is the only other thing the Coco
          ;; half's `atom_length' lets through, and 64 bytes is more than any
          ;; of them needs.
          (if (== s nil)
              (block
               (if (not (coco_m_text e (coco_m_arg e g 0) num (sizeof num)))
                   (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
               (set s num)))
          (set n (strlen s))
          (if (> (cast size_t (+ before len)) n) (return 0))
          (set out (cast (char *) (malloc (+ (cast size_t len) 1))))
          (if (== out nil) (return 0))
          (memcpy out (+ s before) (cast size_t len))
          (set (nth len out) (cast char 0))
          (let ((size_t mark . #'(coco_m_mark e)))
            (if (not (coco_m_unify_int e (coco_m_arg e g 3)
                                     (cast i64 (- n (cast size_t (+ before len))))))
                (block (coco_m_undo e mark) (set rc 0)))
            (if (and rc (not (coco_m_unify_atom e (coco_m_arg e g 4) out)))
                (block (coco_m_undo e mark) (set rc 0))))
          (free out)
          (return rc)))

  ;;; A term's text in a buffer of its own, or nil when it is not text.
  ;;;
  ;;; `coco_m_text' writes into a buffer the CALLER sizes and answers 0 both
  ;;; for "this is not text" and for "it did not fit" -- so a fixed buffer
  ;;; turns a long atom into a type error or a silent failure, and there is
  ;;; no way to tell the two apart without asking again with more room. An
  ;;; atom is asked its own length and fits first time; everything else is
  ;;; guessed at, doubling, and stops at 16 MB -- because a term that is not
  ;;; text fails at EVERY size, and doubling for ever on a `foo(1)' would be
  ;;; a way to run out of memory reporting a type error.
  ;;;
  ;;; The caller frees it, and decides which error a nil is.
  (static)
  (func coco_b_text_dup ((coco_engine * e) (size_t t)) (out char *)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t d . #'(coco_deref (coco_m_machine e) t))
              (size_t cap . 4096))
          ;; AN ATOM ANSWERS ITS OWN SIZE, so the large case that actually
          ;; turns up -- a file read into one atom, a generated program, a
          ;; page -- is ONE malloc of exactly the right length and no
          ;; doubling at all. Only a string or a code list has to be guessed
          ;; at, and only a term that is not text pays the whole ladder.
          (if (coco_m_is_atom e d)
              (set cap (+ 1 (strlen (coco_atom_name m (coco_name_of m d))))))
          (while (<= cap 16777216)
            (let ((char * one . #'(cast (char *) (malloc cap))))
              (if (== one nil) (return nil))
              (if (coco_m_text e d one cap) (return one))
              (free one)
              (set cap (* cap 2))))
          (return nil)))

  ;;; `$atom_split(Atom, Sep, Parts)'. An empty separator would split into
  ;;; nothing sensible, so it is refused here and the caller's clause never
  ;;; sends one.
  ;;;
  ;;; THE ATOM GROWS. It was a `char a[8192]', so splitting anything larger
  ;;; -- a page, a file read in, a joined program -- raised
  ;;; `type_error(atom, ...)' about an atom that is plainly an atom, which is
  ;;; the same 8 KB ceiling `$atom_join' had on the way out.
  (func coco_b_atom_split ((coco_engine * e) (size_t g)) (out int)
        (let ((char * a . #'(coco_b_text_dup e (coco_m_arg e g 0))) (char sep [256])
              (char ** parts . nil) (size_t n . 0) (size_t cap . 0) (int rc))
          (if (== a nil)
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (if (not (coco_m_text e (coco_m_arg e g 1) sep (sizeof sep)))
              (block (free a) (return (coco_m_type_error e "atom" (coco_m_arg e g 1)))))
          (if (== 0 (strlen sep))
              (block (free a)
                     (return (coco_m_error e "atomic_list_concat/3 cannot split on an empty separator" nil))))
          (let ((char * p . a))
            (while 1
              (let ((char * q . #'(strstr p sep)))
                (if (>= n cap)
                    (let ((size_t ncap . #'(? (== cap 0) 8 (* cap 2)))
                          (char ** nb))
                      (set nb (cast (char **) (realloc parts (* ncap (sizeof (char *))))))
                      (if (== nb nil) break)
                      (set parts nb)
                      (set cap ncap)))
                (if (== q nil)
                    (block (set (nth n parts) (strdup p)) (set n (+ n 1)) break))
                (set (nth 0 q) (cast char 0))
                (set (nth n parts) (strdup p))
                (set n (+ n 1))
                (set (nth 0 q) (nth 0 sep))
                (set p (+ q (strlen sep))))))
          (set rc (coco_m_unify e (coco_m_arg e g 2) (coco_m_atom_list e parts n)))
          (for ((size_t i . 0)) (< i n) ((++ i)) (free (nth i parts)))
          (free parts)
          (free a)
          (return rc)))

  ;;; `'$atom_join'(List, Sep, Atom)' -- what atomic_list_concat/2,3 joins with.
  ;;;
  ;;; THE RESULT GROWS. It was a `char out[8192]' and a bare `return 0' when
  ;;; the join outran it, so `atomic_list_concat/2' over anything sizeable
  ;;; simply FAILED, with no error term and nothing on stderr: measured, 6400
  ;;; characters answered and 8320 did not. A caller reading that failure as
  ;;; "these atoms do not join" is reading a buffer size, and the sizeable
  ;;; case is the ordinary one -- a page, a generated program, a CSV row.
  ;;; A `coco_strbuf' grows, so what is left is memory.
  ;;;
  ;;; AND THE ERROR TERM IS BUILT BEFORE THE ARRAY IS FREED. It was
  ;;; `(block (free v) (return (coco_m_type_error e "atomic" (nth i v))))',
  ;;; reading the culprit out of memory it had just handed back -- which is
  ;;; why the ball named the FIRST element rather than the offending one, and
  ;;; why it could crash outright instead. The heap INDEX is copied out
  ;;; first now: it is a number, and the array being freed held numbers, not
  ;;; the heap they point into.
  ;;;
  ;;; AN UNBOUND ELEMENT IS AN instantiation_error, which is SWI's answer and
  ;;; the one a caller can act on. It used to be `type_error(atomic, ...)'
  ;;; naming whatever the freed array happened to still hold.
  (func coco_b_atom_join ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t * v . nil) (size_t n . 0)
              (char sep [256]) (coco_strbuf b)
              (int why . 0) (size_t bad . 0) (int rc . 0))
          (if (not (coco_m_list_array e (coco_m_arg e g 0) (aof v) (aof n)))
              (return (coco_m_type_error e "list" (coco_m_arg e g 0))))
          (if (not (coco_m_text e (coco_m_arg e g 1) sep (sizeof sep)))
              (block (free v) (return (coco_m_type_error e "atom" (coco_m_arg e g 1)))))
          (coco_sb_init (aof b))
          (for ((size_t i . 0)) (< i n) ((++ i))
            (block
             (if (> i 0) (coco_sb_put (aof b) sep))
             (if (coco_m_is_var e (nth i v))
                 (block (set why 1) (set bad (nth i v)) break))
             (let ((char * one . #'(coco_b_text_dup e (nth i v))))
               (if (== one nil)
                   (block (set why 2) (set bad (nth i v)) break))
               (coco_sb_put (aof b) one)
               (free one))))
          (free v)
          (if (== why 1)
              (block (coco_sb_free (aof b)) (return (coco_m_instantiation_error e))))
          (if (== why 2)
              (block (coco_sb_free (aof b)) (return (coco_m_type_error e "atomic" bad))))
          (set rc (coco_m_unify_atom e (coco_m_arg e g 2)
                                     (? (== ($ b s) nil) "" ($ b s))))
          (coco_sb_free (aof b))
          (return rc)))

  ;;; ---- writing ----------------------------------------------------------

  (func coco_b_writeq ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_term (coco_m_machine e) (aof b) (coco_m_arg e g 0) 1 0)
          (if (!= ($ b s) nil) (fputs ($ b s) stdout))
          (coco_sb_free (aof b))
          (return 1)))

  ;;; `write_term(Term, Options)'. `quoted(true)', `ignore_ops(true)' and
  ;;; `variable_names(['X'=V, ...])' are the ones the writer has -- the last
  ;;; since 1.10.6: each named variable still unbound is written as its name,
  ;;; where through 1.10.5 the option was read past and every variable came
  ;;; out `_G' and a number. Anything else in the list is ignored rather
  ;;; than refused, because an option a writer does not implement is not a
  ;;; reason to fail a program.
  (func coco_b_write_term ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t * v . nil) (size_t n . 0)
              (int quoted . 0) (int ignore_ops . 0) (coco_strbuf b)
              (size_t * nv . nil) (size_t nn . 0) (size_t k . 0)
              (size_t * cells . nil) (u64 * names . nil))
          (if (coco_m_list_array e (coco_m_arg e g 1) (aof v) (aof n))
              (for ((size_t i . 0)) (< i n) ((++ i))
                (let ((size_t o . #'(coco_deref m (nth i v))))
                  (if (and (coco_is_callable m o) (== 1 (coco_arity m o)))
                      (let ((const char * nm . #'(coco_atom_name m (coco_name_of m o)))
                            (const char * val . #'(coco_m_atom e (coco_deref m (coco_arg m o 0)))))
                        (if (and (!= val nil) (== 0 (strcmp val "true")))
                            (block
                             (if (== 0 (strcmp nm "quoted")) (set quoted 1))
                             (if (== 0 (strcmp nm "ignore_ops")) (set ignore_ops 1))))
                        (if (and (== 0 (strcmp nm "variable_names")) (== cells nil))
                            (if (coco_m_list_array e (coco_arg m o 0) (aof nv) (aof nn))
                                (block
                                 (set cells (cast (size_t *) (malloc (* (+ nn 1) (sizeof size_t)))))
                                 (set names (cast (u64 *) (malloc (* (+ nn 1) (sizeof u64)))))
                                 (if (and (!= cells nil) (!= names nil))
                                     (for ((size_t j . 0)) (< j nn) ((++ j))
                                       (let ((size_t p . #'(coco_deref m (nth j nv))))
                                         (if (and (and (coco_is_callable m p) (== 2 (coco_arity m p)))
                                                  (== 0 (strcmp (coco_atom_name m (coco_name_of m p)) "=")))
                                             (let ((size_t nmc . #'(coco_deref m (coco_arg m p 0)))
                                                   (size_t vc . #'(coco_deref m (coco_arg m p 1))))
                                               (if (and (coco_m_is_atom e nmc)
                                                        (coco-tag-is REF (nth vc (-> m heap))))
                                                   (block (set (nth k cells) vc)
                                                          (set (nth k names) (coco_name_of m nmc))
                                                          (set k (+ k 1)))))))))
                                 (free nv)))))))))
          (free v)
          (coco_sb_init (aof b))
          (if (and (!= cells nil) (!= names nil))
              (block (set (-> m wcells) cells) (set (-> m wnames) names) (set (-> m nwnames) k)))
          (coco_write_term m (aof b) (coco_m_arg e g 0) quoted ignore_ops)
          (set (-> m wcells) nil) (set (-> m wnames) nil) (set (-> m nwnames) 0)
          (free cells) (free names)
          (if (!= ($ b s) nil) (fputs ($ b s) stdout))
          (coco_sb_free (aof b))
          (return 1)))

  ;;; ---- the environment --------------------------------------------------
  ;;;
  ;;; SWI's `getenv/2', `setenv/2' and `unsetenv/1'. getenv FAILS for a
  ;;; name that is not set rather than throwing -- "is this set" is an
  ;;; ordinary question with an ordinary no, and a program that wants an
  ;;; error can write `( getenv(X, V) -> true ; throw(...) )'.
  ;;;
  ;;; This is the one channel by which a value reaches a program WITHOUT
  ;;; passing through the knowledge base, which is why it is worth having
  ;;; and not only convenience: a consulted file becomes clauses, and
  ;;; clauses become rows. A secret that must not become a row -- a
  ;;; node's signing key, a token -- has nowhere else to arrive from.
  (func coco_b_getenv ((coco_engine * e) (size_t g)) (out int)
        (let ((char name [512]))
          (if (not (coco_m_text e (coco_m_arg e g 0) name (sizeof name)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (let ((const char * v . #'(getenv name)))
            (if (== v nil) (return 0))
            (return (coco_m_unify_atom e (coco_m_arg e g 1) v)))))

  (func coco_b_setenv ((coco_engine * e) (size_t g)) (out int)
        (let ((char name [512]) (char val [4096]))
          (if (not (coco_m_text e (coco_m_arg e g 0) name (sizeof name)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (if (not (coco_m_text e (coco_m_arg e g 1) val (sizeof val)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 1))))
          (return (? (== 0 (setenv name val 1)) 1 0))))

  (func coco_b_unsetenv ((coco_engine * e) (size_t g)) (out int)
        (let ((char name [512]))
          (if (not (coco_m_text e (coco_m_arg e g 0) name (sizeof name)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (unsetenv name)
          (return 1)))

  (func coco_b_tab ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 n . 0))
          (if (not (coco_m_int e (coco_m_arg e g 0) (aof n)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
          (for ((i64 i . 0)) (< i n) ((++ i)) (fputc 32 stdout))
          (return 1)))

  ;;; ---- the clause database ----------------------------------------------

  ;;; How many clauses a predicate has, and its index in the store. The index
  ;;; comes back too so that `$clause' need not find it again.
  (func coco_b_pred_count ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t head . #'(coco_m_arg e g 0)))
          (if (not (coco_is_callable m head))
              (return (coco_m_type_error e "callable" head)))
          (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m head)
                                               (coco_arity m head))))
            (if (>= pi ($ (cof st) npreds)) (return 0))
            (coco_pred_ensure st pi)
            (let ((size_t mark . #'(coco_m_mark e)))
              (if (not (coco_m_unify_int e (coco_m_arg e g 1)
                                       (cast i64 ($ (nth pi ($ (cof st) preds)) nclauses))))
                  (block (coco_m_undo e mark) (return 0)))
              (if (not (coco_m_unify_int e (coco_m_arg e g 2) (cast i64 pi)))
                  (block (coco_m_undo e mark) (return 0))))
            (return 1))))

  ;;; The Ith clause of the predicate named by Head, as Head and Body. I counts
  ;;; from one, because the Coco half enumerates it with `between/3'.
  (func coco_b_clause_at ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t head . #'(coco_m_arg e g 0))
              (i64 want . 0))
          (if (not (coco_m_int e (coco_m_arg e g 2) (aof want))) (return 0))
          (if (not (coco_is_callable m head)) (return 0))
          (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m head)
                                               (coco_arity m head))))
            (if (>= pi ($ (cof st) npreds)) (return 0))
            (coco_pred_ensure st pi)
            (let ((coco_pred * p . #'(aof (nth pi ($ (cof st) preds)))))
              (if (or (< want 1) (> (cast size_t want) (-> p nclauses))) (return 0))
              (let ((size_t mark . #'(coco_m_mark e))
                    (size_t t . #'(coco_store_get m st (nth (- want 1) (-> p clauses))))
                    (size_t h . 0) (size_t bdy . 0))
                (coco_clause_parts m t (aof h) (aof bdy))
                ;; a fact's body is `true', which is what SWI answers too
                (if (== bdy 0) (set bdy (coco_new_atom m "true")))
                (if (not (coco_m_unify e head h))
                    (block (coco_m_undo e mark) (return 0)))
                (if (not (coco_m_unify e (coco_m_arg e g 1) bdy))
                    (block (coco_m_undo e mark) (return 0)))
                (return 1))))))

  ;;; Every predicate the store DEFINES, as Name/Arity: one with a clause, or
  ;;; one declared dynamic (an assert declares it too), as SWI counts them.
  ;;; The table holds more -- a call, or `clause/2', makes an entry for a
  ;;; name it looks up, and a call to it still raises `existence_error' --
  ;;; and those are left out, as are the library's own predicates:
  ;;; `current_predicate/1' is about the program. The program's own files
  ;;; are the program's (`own', 1.10.28): `-s FILE', ensure_loaded/1 and
  ;;; use_module/1 of a path load them as modules, and through 1.10.27 their
  ;;; predicates were left out with the library's.
  (func coco_b_predicates ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t * v . nil) (size_t n . 0) (size_t cap . 0) (size_t out))
          (coco_store_warm st)
          (for ((size_t i . 0)) (< i ($ (cof st) npreds)) ((++ i))
            (if (and (or (not ($ (nth i ($ (cof st) preds)) library))
                         ($ (nth i ($ (cof st) preds)) own))
                     (or (> ($ (nth i ($ (cof st) preds)) nclauses) 0)
                         ($ (nth i ($ (cof st) preds)) dynamic)))
                (block
                 (if (>= n cap)
                     (let ((size_t ncap . #'(? (== cap 0) 16 (* cap 2)))
                           (size_t * nb))
                       (set nb (cast (size_t *) (realloc v (* ncap (sizeof size_t)))))
                       (if (== nb nil) break)
                       (set v nb)
                       (set cap ncap)))
                 (set (nth n v)
                      (coco_make2 m "/"
                                (coco_new_atom m (coco_atom_name m ($ (nth i ($ (cof st) preds)) name)))
                                (coco_new_int m (cast i64 ($ (nth i ($ (cof st) preds)) arity)))))
                 (set n (+ n 1)))))
          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 0) out))))

  (coco-emit-claims coco_b_tier1_claims *builtins-predicates* *lists-predicates*
                    *files-predicates* *dcg-predicates* *library-predicates*
                    *zigurat-predicates*)
  (coco-emit-claims coco_b_construct_claims *callable-constructs*)

  ;;; PREDICATE_PROPERTY/2'S C HALF (1.10.28): '$pred_props'(Head, Props),
  ;;; the properties of the predicate Head names, or a failure where
  ;;; nothing defines it -- SWI's answer for an unknown one. Module:Head
  ;;; names Head: there is one namespace. A control construct is visible,
  ;;; built_in, static and defined (`coco_b_construct_claims', by name and
  ;;; arity), and a C predicate of the engine's table or of a compiled-in
  ;;; module (`coco_b_tier1_claims') foreign too; a
  ;;; predicate of the store with a clause or a dynamic declaration is
  ;;; visible, dynamic or static, defined, with number_of_clauses(N) and
  ;;; number_of_rules(R). Where SWI says a library's predicate is built_in
  ;;; or imported_from(Lib), this does not: a library's clauses are
  ;;; consulted muted and carry no file (`coco_consult'). A module loaded
  ;;; from a `.so' is not answered: its dispatcher is all that knows its
  ;;; names, and asking it is calling it.
  (func coco_b_pred_props ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t h . #'(coco_m_arg e g 0))
              (size_t v [8]) (size_t n . 0) (u64 nid . 0) (u32 ar . 0) (int c . 0))
          (if (coco_is_compound2 m h ":") (set h (coco_deref m (coco_arg m h 1))))
          (if (coco_m_is_var e h) (return (coco_m_instantiation_error e)))
          (if (not (coco_is_callable m h)) (return (coco_m_type_error e "callable" h)))
          (set nid (coco_name_of m h))
          (set ar (coco_arity m h))
          (set c (or (>= (coco_builtin_index m nid ar) 0)
                     (coco_b_tier1_claims (coco_atom_name m nid) ar)))
          (if (or c (coco_b_construct_claims (coco_atom_name m nid) ar))
              (block
                (set (nth n v) (coco_new_atom m "visible")) (++ n)
                (set (nth n v) (coco_new_atom m "built_in")) (++ n)
                (if c (block (set (nth n v) (coco_new_atom m "foreign")) (++ n)))
                (set (nth n v) (coco_new_atom m "static")) (++ n)
                (set (nth n v) (coco_new_atom m "defined")) (++ n)
                (return (coco_m_unify e (coco_m_arg e g 1) (coco_m_list e v n)))))
          (let ((size_t pi . #'(coco_pred_intern st nid ar)))
            (if (>= pi ($ (cof st) npreds)) (return 0))
            (coco_pred_ensure st pi)
            (let ((coco_pred * p . #'(aof (nth pi ($ (cof st) preds))))
                  (size_t rules . 0) (size_t mark . #'($ (cof m) heap_len))
                  (u64 tid . #'(coco_intern m "true")))
              (if (and (== (-> p nclauses) 0) (not (-> p dynamic))) (return 0))
              ;; a rule is a clause whose body is not `true'; the predicate
              ;; read through its index each time round, as after
              (for ((size_t i . 0)) (< i ($ (nth pi ($ (cof st) preds)) nclauses)) ((++ i))
                (let ((size_t t . #'(coco_store_get m st (nth i ($ (nth pi ($ (cof st) preds)) clauses))))
                      (size_t ch . 0) (size_t cb . 0))
                  (coco_clause_parts m t (aof ch) (aof cb))
                  (if (and (!= cb 0)
                           (not (and (coco-tag-is ATOM (nth (coco_deref m cb) (-> m heap)))
                                     (== (coco_name_of m (coco_deref m cb)) tid))))
                      (set rules (+ rules 1)))
                  (set (-> m heap_len) mark)))
              ;; the store may have moved under the reads: read P again
              (set p (aof (nth pi ($ (cof st) preds))))
              (set (nth n v) (coco_new_atom m "visible")) (++ n)
              (set (nth n v) (coco_new_atom m (? (-> p dynamic) "dynamic" "static"))) (++ n)
              (set (nth n v) (coco_new_atom m "defined")) (++ n)
              (set (nth n v) (coco_make1 m "number_of_clauses" (coco_new_int m (cast i64 (-> p nclauses))))) (++ n)
              (set (nth n v) (coco_make1 m "number_of_rules" (coco_new_int m (cast i64 rules)))) (++ n)
              (return (coco_m_unify e (coco_m_arg e g 1) (coco_m_list e v n)))))))

  ;;; `abolish(Name/Arity)' -- every clause of it goes, and the write-through
  ;;; hook hears about it because this is a retract of the whole predicate.
  (func coco_b_abolish ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t spec . #'(coco_m_arg e g 0)))
          (if (not (coco_is_compound2 m spec "/"))
              (return (coco_m_type_error e "predicate_indicator" spec)))
          (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
                (size_t ar . #'(coco_deref m (coco_arg m spec 1)))
                (i64 arity . 0))
            (if (not (coco_m_is_atom e nm))
                (return (coco_m_type_error e "atom" nm)))
            (if (not (coco_m_int e ar (aof arity)))
                (return (coco_m_type_error e "integer" ar)))
            (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m nm) (cast u32 arity))))
              (if (>= pi ($ (cof st) npreds)) (return 1))
              (coco_pred_ensure st pi)
              ;; retract the first clause until there is none, so that the
              ;; backend hears once per removal exactly as it would from a
              ;; program doing the same thing
              (while (> ($ (nth pi ($ (cof st) preds)) nclauses) 0)
                (let ((size_t mark . #'($ (cof m) heap_len))
                      (size_t t . #'(coco_store_get m st
                                                  (nth 0 ($ (nth pi ($ (cof st) preds)) clauses)))))
                  (coco_retract st m t)
                  (set (-> m heap_len) mark)))
              (coco_store_maybe_compact st m)
              (return 1)))))

  ;;; ---- global variables -------------------------------------------------
  ;;;
  ;;; `nb_' and `b_' are the same thing here. SWI's differ on backtracking --
  ;;; a `b_setval' is undone and an `nb_setval' is not -- and undoing one would
  ;;; need a trail entry that is not a variable binding, which the trail
  ;;; carries only for a heap cell (setarg/3's value entry, 1.12.0): a global
  ;;; lives in the store. They are documented as the non-backtrackable pair.
  ;;;
  ;;; THE VALUE GOES IN THE STORE, not the heap: a global that a query set has
  ;;; to survive the query's heap being wound back, and the store is the only
  ;;; thing here that does not shrink.

  ;;; AND THE TABLE IS THE STORE'S, which is `coco_global' and the three
  ;;; members beside `cells' in lib/kb.cicili -- that header carries the
  ;;; whole argument. In one line: an entry holds an index into ONE store's
  ;;; cells, so a table shared between stores hands one store's index to
  ;;; another, and `run_isolated/2' -- a fresh store -- read garbage or
  ;;; segfaulted. Globals are therefore per-store, which is the semantics a
  ;;; fresh machine should have anyway.
  ;;;
  ;;; NOTHING HERE IS FILE-SCOPE ANY MORE, and that is the point: a static
  ;;; table is appended to by every thread at once, and eight of them
  ;;; writing 800 globals each aborted the process on its `realloc'.

  ;;; ---- clauses that stay in this machine ---------------------------------
  ;;;
  ;;; MUTING IS WHAT A MODULE'S CLAUSES ALREADY GET, and there was no way to
  ;;; ask for it from Prolog. `coco_store_mute' stops the write-through hooks
  ;;; firing, so an `assertz' lands in this machine's store and nowhere else
  ;;; -- which is exactly what a module's clauses need, "they belong to the
  ;;; BUILD and not to the knowledge base", and exactly what a WORKER's
  ;;; snapshot needs for the same reason.
  ;;;
  ;;; Reported from CivV: `library(cowork)' told a two-worker crew four
  ;;; clauses under `--embed' and EIGHT rows landed in the knowledge base,
  ;;; one copy per worker. Transient turn state, written to the user's
  ;;; database, once per worker. And it deadlocked past a handful of clauses,
  ;;; because both workers wanted the embedded store while the caller sat
  ;;; waiting for them.
  ;;;
  ;;; THE RAW PAIR IS `$'-PREFIXED ON PURPOSE. A mute that somebody forgets
  ;;; to undo silently drops every later write, so the public form is
  ;;; `with_local_clauses/1', which unmutes on success, on failure and on the
  ;;; way out of a throw. It is a COUNTER underneath, so it nests.
  (func coco_b_store_mute ((coco_engine * e) (size_t g)) (out int)
        (coco_store_mute (-> e st))
        (return 1))

  (func coco_b_store_unmute ((coco_engine * e) (size_t g)) (out int)
        (coco_store_unmute (-> e st))
        (return 1))

  ;;; A GLOBAL BY NAME (1.9.4), through the store's hash of them
  ;;; (`gbuckets'): an open table of an entry's index plus one, kept under
  ;;; half full and probed in a line from the name's hash. Through 1.9.3
  ;;; every read and every write scanned from the first global made, and
  ;;; the translator keeps one per word it has looked up -- its lesson made
  ;;; 1 710 and read them 3.7 million times. Answers the index, or -1.
  (static)
  (func coco_global_find ((coco_store * st) (u64 name)) (out i64)
        (if (== (-> st gbucket_cap) 0) (return -1))
        (let ((size_t mask . #'(- (-> st gbucket_cap) 1))
              (size_t j . #'(cast size_t (bitand (coco_name_arity_hash name 0) (cast u64 mask)))))
          (while 1
            (let ((size_t v . #'(nth j (-> st gbuckets))))
              (if (== v 0) (return -1))
              (if (== ($ (nth (- v 1) (-> st globals)) name) name) (return (cast i64 (- v 1))))
              (set j (bitand (+ j 1) mask))))
          (return -1)))

  ;;; Entry I into the hash: the first empty slot on its name's line
  (static)
  (func coco_global_place ((coco_store * st) (size_t i))
        (let ((size_t mask . #'(- (-> st gbucket_cap) 1))
              (size_t j . #'(cast size_t (bitand (coco_name_arity_hash ($ (nth i (-> st globals)) name) 0)
                                                (cast u64 mask)))))
          (while (!= (nth j (-> st gbuckets)) 0)
            (set j (bitand (+ j 1) mask)))
          (set (nth j (-> st gbuckets)) (+ i 1))))

  ;;; A NEW ENTRY I, the table doubled first when one more would put it
  ;;; over half full: every entry below I is put back from the array
  ;;; itself, which is the truth -- the table is only how to find it.
  ;;; 0 when it would not grow.
  (static)
  (func coco_global_hash ((coco_store * st) (size_t i)) (out int)
        (if (> (* (+ i 1) 2) (-> st gbucket_cap))
            (let ((size_t ncap . #'(? (== (-> st gbucket_cap) 0) 16 (* (-> st gbucket_cap) 2)))
                  (size_t * nb . nil))
              (while (> (* (+ i 1) 2) ncap) (set ncap (* ncap 2)))
              (set nb (cast (size_t *) (calloc ncap (sizeof size_t))))
              (if (== nb nil) (return 0))
              (free (-> st gbuckets))
              (set (-> st gbuckets) nb)
              (set (-> st gbucket_cap) ncap)
              (for ((size_t k . 0)) (< k i) ((++ k))
                (coco_global_place st k))))
        (coco_global_place st i)
        (return 1))

  (func coco_b_setval ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t k . #'(coco_m_arg e g 0)))
          (if (not (coco_m_is_atom e k)) (return (coco_m_type_error e "atom" k)))
          (let ((coco_store * st . #'(-> e st))
                (u64 name . #'(coco_name_of m k))
                (size_t cell . #'(coco_store_put (-> e st) m (coco_m_arg e g 1)))
                ;; whether a machine may keep the value and hand it out
                ;; shared (1.12.1, `coco_b_global_term'): the put met no
                ;; variable. A cyclic value goes in as its factors, which
                ;; have, and is copied at every read.
                (int ground . #'(== (-> st put_vars) 0))
                (i64 at . #'(coco_global_find st name)))
            (set (-> st gver) (+ (-> st gver) 1))
            (if (>= at 0)
                (let ((size_t i . #'(cast size_t at)))
                  ;; the old value is an orphan now, and its size was kept
                  (set (-> st dead) (+ (-> st dead) ($ (nth i (-> st globals)) size)))
                  (set ($ (nth i (-> st globals)) cell) cell)
                  (set ($ (nth i (-> st globals)) size) (- (-> st len) cell))
                  (set ($ (nth i (-> st globals)) ver) (-> st gver))
                  (set ($ (nth i (-> st globals)) ground) ground)
                  (coco_store_maybe_compact st m)
                  (return 1)))
            (if (>= (-> st nglobals) (-> st gcap))
                (let ((size_t ncap . #'(? (== (-> st gcap) 0) 8 (* (-> st gcap) 2)))
                      (coco_global * nb))
                  (set nb (cast (coco_global *)
                                (realloc (-> st globals) (* ncap (sizeof coco_global)))))
                  (if (== nb nil) (return 0))
                  (set (-> st globals) nb)
                  (set (-> st gcap) ncap)))
            (set ($ (nth (-> st nglobals) (-> st globals)) name) name)
            (set ($ (nth (-> st nglobals) (-> st globals)) cell) cell)
            (set ($ (nth (-> st nglobals) (-> st globals)) size) (- (-> st len) cell))
            (set ($ (nth (-> st nglobals) (-> st globals)) ver) (-> st gver))
            (set ($ (nth (-> st nglobals) (-> st globals)) ground) ground)
            (if (not (coco_global_hash st (-> st nglobals))) (return 0))
            (set (-> st nglobals) (+ (-> st nglobals) 1))
            (coco_store_maybe_compact st m)
            (return 1))))

  ;;; A GLOBAL'S VALUE ON THE HEAP (1.12.1). Every read copies the value
  ;;; as its block (`coco_store_read_block'): through 1.12.0 a read walked
  ;;; it a cell at a time, 98 us for a list of 3 000 entries against 26
  ;;; now, and the translator's reads (one per word it looks up) were 12 %
  ;;; of its instructions. A GROUND value is then kept by the machine
  ;;; (`gcache', a root of the collector, by the global's index and
  ;;; version, for the store whose serial it names) and handed out shared,
  ;;; as SWI hands out its globals: nothing can bind a ground term, and a
  ;;; setarg/3 or nb_setarg/3 on it changes the global (setarg/3's until
  ;;; backtracking takes it back), which nb_setval/2 replaces. It is kept
  ;;; FOR AS LONG AS IT LIVES: its sentinel on the trail (`coco-trail-tag')
  ;;; is undone when backtracking, or the end of a nested search, goes back
  ;;; past the copy and takes its cells, and a read that finds the sentinel
  ;;; gone from where it was put (`coco_gcache_ok') copies again.
  ;;; Nothing else that winds the heap back can reach it: the positions a
  ;;; host winds back to (a consult's after a directive) are raised over it
  ;;; here, and every other wind-back undoes the trail with it or runs no
  ;;; goal. Raising EVERY mark instead, as SWI freezes its global stack at
  ;;; nb_setval/2, kept what backtracking had always given back, and the
  ;;; translator's case ran 12 % slower for twice the collections (16 to
  ;;; 34). nb_setarg/3 on a copy pins it (`coco_gcache_pin'), and its
  ;;; write lasts as SWI's. A value with a variable in it is a fresh copy
  ;;; at every read -- each read's variables its own, where SWI shares them
  ;;; too -- and so is an atom or a number, a cell to copy.
  (static)
  (func coco_b_global_term ((coco_engine * e) (size_t i)) (out size_t)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t cell . #'($ (nth i (-> st globals)) cell))
              (size_t size . #'($ (nth i (-> st globals)) size))
              (u64 ver . #'($ (nth i (-> st globals)) ver))
              (size_t h0 . 0) (size_t r . 0) (u64 sn . 0) (size_t tp . 0))
          (if (not ($ (nth i (-> st globals)) ground)) (return (coco_store_read_block m st cell size)))
          (if (!= (-> m gcache_ss) (-> st serial)) (coco_gcache_drop m (-> st serial)))
          (if (and (< i (-> m gcache_cap)) (== ($ (nth i (-> m gcache)) ver) ver)
                   (coco_gcache_ok m i))
              (return ($ (nth i (-> m gcache)) root)))
          (set h0 (-> m heap_len))
          (set r (coco_deref m (coco_store_read_block m st cell size)))
          (if (or (-> m oom) (not (coco-tag-is FUN (nth r (-> m heap))))) (return r))
          ;; no room to keep it, or to say where it was made (a sentinel
          ;; holds an index under 2^23 - 1): handed out as a copy, as it
          ;; always was
          (if (or (>= (+ i 1) (- (<< (cast size_t 1) 23) 1)) (not (coco_gcache_room m i))) (return r))
          (set sn (bitand (+ (-> m gfills) 1) (- (<< (cast u64 1) 23) 1)))
          (if (== sn 0) (set sn 1))
          (set tp (-> m trail_len))
          (if (not (coco_trail_sent m sn i)) (return r))
          (set (-> m gfills) sn)
          (coco_heap_raise_positions m 0 (-> m heap_len))
          (set ($ (nth i (-> m gcache)) ver) ver)
          (set ($ (nth i (-> m gcache)) root) r)
          (set ($ (nth i (-> m gcache)) serial) sn)
          (set ($ (nth i (-> m gcache)) tpos) tp)
          (set ($ (nth i (-> m gcache)) lo) h0)
          (set ($ (nth i (-> m gcache)) hi) (-> m heap_len))
          (set ($ (nth i (-> m gcache)) pinned) 0)
          (if (or (< h0 (-> m gspan_lo)) (>= (-> m gspan_lo) (-> m gspan_hi)))
              (set (-> m gspan_lo) h0))
          (if (> (-> m heap_len) (-> m gspan_hi)) (set (-> m gspan_hi) (-> m heap_len)))
          (return r)))

  (func coco_b_getval ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t k . #'(coco_m_arg e g 0)))
          (if (not (coco_m_is_atom e k)) (return (coco_m_type_error e "atom" k)))
          (let ((coco_store * st . #'(-> e st))
                (i64 at . #'(coco_global_find st (coco_name_of m k))))
            (if (>= at 0)
                (return (coco_m_unify e (coco_m_arg e g 1) (coco_b_global_term e (cast size_t at)))))
            (return (coco_m_existence_error e "variable" (coco_m_arg e g 0))))))

  ;;; `nb_current(?Key, ?Value)' (1.12.0): the global's value, read as
  ;;; nb_getval/2 reads it, or a FAILURE where there is no global of that
  ;;; name -- where nb_getval/2 raises, so a program asks whether there is
  ;;; one in one step rather than three (`catch/3', the read, its exit). A
  ;;; key bound to anything but an atom is SWI's type_error(atom, K). An
  ;;; unbound key ENUMERATES, which no C predicate here does (every builtin
  ;;; is deterministic): this one declines the goal (`coco_m_decline', the
  ;;; `:declines' row) and it goes on to this module's clause, which walks
  ;;; '$nb_keys'/1 -- the globals in the order they were made.
  (func coco_b_nb_current ((coco_engine * e) (size_t g) (int * found)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t k . #'(coco_m_arg e g 0)))
          (if (coco_m_is_var e k)
              (block (coco_m_decline e) (set (cof found) 0) (return 0)))
          (if (not (coco_m_is_atom e k)) (return (coco_m_type_error e "atom" k)))
          (let ((coco_store * st . #'(-> e st))
                (i64 at . #'(coco_global_find st (coco_name_of m k))))
            (if (< at 0) (return 0))
            (return (coco_m_unify e (coco_m_arg e g 1) (coco_b_global_term e (cast size_t at)))))))

  ;;; `'$nb_keys'(-Keys)': every global's name, in the order made
  (func coco_b_nb_keys ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t l . #'(coco_m_nil e))
              (size_t i . #'(-> st nglobals)))
          (while (> i 0)
            (set i (- i 1))
            (set l (coco_m_cons e (coco_new_atom_id m ($ (nth i (-> st globals)) name)) l)))
          (return (coco_m_unify e (coco_m_arg e g 0) l))))

  ;;; `prewarm(-Count)' asks the backend, once, about every predicate a MODULE
  ;;; owns and remembers the ones it has no rows for, so that the fresh store
  ;;; every `run_isolated/2' proof gets need not ask again. Count is how many
  ;;; joined the table on this call -- 0 on a second call, and 0 under
  ;;; `--local', where there is no backend to ask.
  ;;;
  ;;; CALL IT BEFORE YOU SPAWN. The table is process-wide and unguarded, the
  ;;; same contract `use_module' has and for the same reason: a lock here would
  ;;; sit under the first call of every predicate of every proof in the
  ;;; process. `library(httpd)' calls it in `httpd_serve/3' before the pool
  ;;; starts.
  ;;;
  ;;; AND IT PAYS ONLY WHERE THE FETCHES RECUR, which is narrower than it
  ;;; sounds and was measured the hard way. The call itself asks about every
  ;;; library predicate the process has -- 437 of them with the tier-1
  ;;; libraries loaded -- so it costs ~51 ms up front and earns it back at 51
  ;;; fetches a request. An httpd pool repays that in about nine requests,
  ;;; because a fresh store per REQUEST asks again every time.
  ;;;
  ;;; `library(cowork)' IS NOT THAT SHAPE AND DELIBERATELY DOES NOT CALL IT. A
  ;;; crew worker's store lives as long as the worker and is filled lazily, so
  ;;; it asks only about the predicates its own jobs call, once -- about
  ;;; fifteen a worker, measured. Pre-warming a crew therefore buys 437 fetches
  ;;; to save perhaps 180, and it measured 4-6x WORSE at every crew size
  ;;; tried: a crew of four went 13 ms to 51, a crew of twelve 21 ms to 65,
  ;;; with one real job each. The rule is the fetches RECURRING, not the
  ;;; threads existing.
  ;;;
  ;;; WHAT IT COSTS IF YOU ARE WRONG is in `coco_store_prewarm' in lib/kb.cicili:
  ;;; a predicate a MODULE defines, written into the knowledge base by another
  ;;; process after this call, is not seen by this one. The program's own
  ;;; predicates are untouched and are fetched per request as they always were.
  (func coco_b_prewarm ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t n . #'(coco_store_prewarm (-> e st) (coco_m_machine e))))
          (return (coco_m_unify e (coco_m_arg e g 0)
                                  (coco_m_new_int e (cast i64 n))))))

  ;;; `garbage_collect/0' compacts the store -- see `coco_store_compact' in
  ;;; lib/kb.cicili for what that reclaims and when it happens unasked. It
  ;;; always succeeds, and it is allowed anywhere a goal is: inside a
  ;;; findall's goal or a directive the roots those hold move with the rest.
  ;;;
  ;;; AND IT ASKS FOR A HEAP COLLECTION at the next step boundary, because a
  ;;; builtin is the one place a collection cannot run -- this call's own
  ;;; frame holds the goal. The request is a threshold of 0 (`gc_next' on
  ;;; the machine). Where the collector may not run (a host that did not
  ;;; turn it on, a search whose starter told the collector nothing of its
  ;;; own frame) the request waits for a step where it may. See
  ;;; `coco_heap_gc' in lib/solve.cicili.
  (func coco_b_garbage_collect ((coco_engine * e) (size_t g)) (out int)
        (coco_store_compact (-> e st) (coco_m_machine e))
        (set (-> (coco_m_machine e) gc_next) 0)
        (return 1))

  ;;; `statistics/2', the keys a program can act on. SWI's names where SWI
  ;;; has the number -- `cputime' in seconds as a float, `inferences',
  ;;; `globalused' and `trailused' in bytes, `atoms' and `functors' as
  ;;; counts -- and `store_used' for what SWI has no word for: the bytes the
  ;;; store's cell array holds, live and orphaned alike, which is the number
  ;;; that `garbage_collect/0' brings down. Any other key is a
  ;;; `domain_error(statistics_key, K)'.
  ;;;
  ;;; AND THE CAPS BESIDE THE LENGTHS (1.2.14): `store_cap', `globalcap' and
  ;;; `trailcap' are what the process HOLDS where the three `used' keys are
  ;;; what the program put there, plus `choicepoints', `strings' and
  ;;; `compactions'. A length answers what you asked and can still leave you
  ;;; looking at the wrong number: CivV read `store_used' at 28 MB inside a
  ;;; window whose footprint was 13.2 GB. An array that doubles sits at up to
  ;;; twice its contents, and only the cap says so.
  ;;;
  ;;; AND `heap_collections' (1.8.36): how many times `coco_heap_gc' has run
  ;;; on this machine -- `compactions' is the store's count, this the heap's.
  ;;; Zero is the honest answer under a host that never turned it on.
  (func coco_b_statistics ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t k . #'(coco_deref (coco_m_machine e) (coco_m_arg e g 0)))
              (size_t out . #'(coco_m_arg e g 1))
              (i64 v . 0))
          (if (not (coco_m_is_atom e k)) (return (coco_m_type_error e "atom" k)))
          (let ((const char * key . #'(coco_atom_name m (coco_name_of m k))))
            (cond
              ((== 0 (strcmp key "cputime"))
               ;; CLOCKS_PER_SEC is a macro Cicili cannot see; POSIX fixes it
               ;; at one million, on this platform and the other one
               (return (coco_m_unify e out (coco_m_new_float
                                             e (/ (cast double (clock)) 1000000.0)))))
              ((== 0 (strcmp key "inferences")) (set v (cast i64 (-> e steps))))
              ((== 0 (strcmp key "globalused")) (set v (cast i64 (* (-> m heap_len) 8))))
              ((== 0 (strcmp key "trailused"))  (set v (cast i64 (* (-> m trail_len) 8))))
              ((== 0 (strcmp key "atoms"))      (set v (cast i64 (-> m atoms_len))))
              ((== 0 (strcmp key "functors"))   (set v (cast i64 (-> m functors_len))))
              ((== 0 (strcmp key "store_used")) (set v (cast i64 (* (-> st len) 8))))
              ;; THE CAPS, NOT ONLY THE LENGTHS, because the length is what a
              ;; program put there and the CAP is what the process is holding
              ;; -- and an array that doubles sits at up to twice its contents
              ;; between one compaction and the next. CivV read `store_used' at
              ;; 28 MB inside a window whose footprint was 13.2 GB; the length
              ;; was telling the truth and was not the question.
              ((== 0 (strcmp key "store_cap"))  (set v (cast i64 (* (-> st cap) 8))))
              ((== 0 (strcmp key "globalcap"))  (set v (cast i64 (* (-> m heap_cap) 8))))
              ((== 0 (strcmp key "trailcap"))   (set v (cast i64 (* (-> m trail_cap) 8))))
              ((== 0 (strcmp key "choicepoints")) (set v (cast i64 (-> e nchoices))))
              ((== 0 (strcmp key "compactions")) (set v (cast i64 (-> st ncompacts))))
              ;; the HEAP's collections, where `compactions' is the store's
              ((== 0 (strcmp key "heap_collections")) (set v (cast i64 (-> m gc_count))))
              ((== 0 (strcmp key "strings"))    (set v (cast i64 (-> m strings_len))))
              (#t (return (coco_m_domain_error e "statistics_key" k))))
            (return (coco_m_unify e out (coco_m_new_int e v))))))

  ;;; ---- operators --------------------------------------------------------

  (static)
  (func coco_b_typename ((int type)) (out const char *)
        (if (== type COCO_XFX) (return "xfx"))
        (if (== type COCO_XFY) (return "xfy"))
        (if (== type COCO_YFX) (return "yfx"))
        (if (== type COCO_FY)  (return "fy"))
        (return "fx"))

  ;;; `op(+Priority, +Type, +Name)'. Name may be a list of names, which is what
  ;;; every real operator declaration uses. Priority 0 takes the operator away.
  (func coco_b_op ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 prec . 0) (int type . 0) (int kind . 0)
              (const char * ts)
              (size_t * names . nil) (size_t n . 0))

          (if (coco_m_is_var e (coco_m_arg e g 0)) (return (coco_m_instantiation_error e)))
          (if (not (coco_m_int e (coco_m_arg e g 0) (aof prec)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
          (if (or (< prec 0) (> prec 1200))
              (return (coco_m_domain_error e "operator_priority" (coco_m_arg e g 0))))

          (set ts (coco_m_atom e (coco_m_arg e g 1)))
          (if (== ts nil)
              (block (if (coco_m_is_var e (coco_m_arg e g 1))
                         (return (coco_m_instantiation_error e)))
                     (return (coco_m_type_error e "atom" (coco_m_arg e g 1)))))
          (if (not (coco_op_type_of ts (aof type) (aof kind)))
              (return (coco_m_domain_error e "operator_specifier" (coco_m_arg e g 1))))

          ;; one name, or a list of them
          (if (not (coco_m_list_array e (coco_m_arg e g 2) (aof names) (aof n)))
              (let ((const char * one . #'(coco_m_atom e (coco_m_arg e g 2))))
                (if (== one nil)
                    (block (if (coco_m_is_var e (coco_m_arg e g 2))
                               (return (coco_m_instantiation_error e)))
                           (return (coco_m_type_error e "atom" (coco_m_arg e g 2)))))
                (if (not (coco_op_define one (cast int prec) type kind))
                    (return (coco_m_error e "that operator name will not fit" one)))
                (return 1)))

          (for ((size_t i . 0)) (< i n) ((++ i))
            (let ((const char * one . #'(coco_m_atom e (nth i names))))
              (if (== one nil)
                  (block (free names)
                         (return (coco_m_type_error e "atom" (nth i names)))))
              (if (not (coco_op_define one (cast int prec) type kind))
                  (block (free names)
                         (return (coco_m_error e "that operator name will not fit" one))))))
          (free names)
          (return 1)))

  ;;; Every operator there is, as `op(Priority, Type, Name)'. The DECLARED ones
  ;;; first and the built-in ones after, with a built-in left out when a
  ;;; declaration of the same name and kind has hidden it -- so what comes back
  ;;; is what the reader would actually do, not two tables stuck together.
  (func coco_b_ops ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t * v . nil) (size_t n . 0) (size_t cap . 0) (size_t out))

          (coco_b_ops_push e (aof v) (aof n) (aof cap) 1)
          (coco_b_ops_push e (aof v) (aof n) (aof cap) 0)

          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 0) out))))

  ;;; DECLARED when `dyn', built-in otherwise. Pulled out because the two loops
  ;;; are the same but for which table they read and whether they skip.
  (static)
  (func coco_b_ops_push ((coco_engine * e) (size_t ** v) (size_t * n) (size_t * cap)
                       (int dyn))
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t total . #'(? dyn (coco_op_dyn_count) (coco_op_static_count))))
          (for ((size_t i . 0)) (< i total) ((++ i))
            (let ((const char * name . nil) (int prec . 0)
                  (int type . 0) (int kind . 0))
              (if (not (? dyn (coco_op_dyn_at i (aof name) (aof prec) (aof type) (aof kind))
                          (coco_op_static_at i (aof name) (aof prec) (aof type) (aof kind))))
                  continue)
              ;; a declaration with priority 0 is not an operator, and a
              ;; built-in that one has hidden is not one either
              (if (== prec 0) continue)
              (if (not dyn)
                  (let ((int dp . 0) (int dt . 0))
                    (if (>= (coco_op_dyn_lookup_pub name kind (aof dp) (aof dt)) 0)
                        continue)))
              (if (>= (cof n) (cof cap))
                  (let ((size_t ncap . #'(? (== (cof cap) 0) 64 (* (cof cap) 2)))
                        (size_t * nb))
                    (set nb (cast (size_t *) (realloc (cof v) (* ncap (sizeof size_t)))))
                    (if (== nb nil) (return))
                    (set (cof v) nb)
                    (set (cof cap) ncap)))
              (let ((size_t args [3]))
                (set (nth 0 args) (coco_new_int m (cast i64 prec)))
                (set (nth 1 args) (coco_new_atom m (coco_b_typename type)))
                (set (nth 2 args) (coco_new_atom m name))
                (set (nth (cof n) (cof v)) (coco_make m "op" 3 args)))
              (set (cof n) (+ (cof n) 1))))))

  ;;; ---- halting ----------------------------------------------------------

  (func coco_b_halt1 ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 code . 0))
          (coco_m_int e (coco_m_arg e g 0) (aof code))
          (set (-> e halted) 1)
          (set (-> e halt_code) (cast int code))
          (return 1)))

  ;;; ---- a sort the aggregation needs -------------------------------------

  ;;; RUNG 191.14 (from CivV): THREAD-LOCAL, and it has to be. The array
  ;;; qsort is handed holds HEAP INDICES, not pointers, and this variable is
  ;;; the only thing that says which machine those indices belong to. As a
  ;;; file-scope static it was one slot for the whole process, so two threads
  ;;; sorting at once had the second overwrite the first's machine and the
  ;;; first's comparator then indexed a foreign heap.
  ;;;
  ;;; Reproduced through library(cowork) itself: 2000 sorting jobs on a
  ;;; four-worker crew while the main thread sorted 1500 times -- SIGSEGV,
  ;;; three runs of three. With a thin overlap it comes back clean every
  ;;; time, which is why a light test does not find it. CivV sorts three
  ;;; times a frame in its renderer and about twenty times an AI turn, so a
  ;;; crew doing game work overlaps the drawing thread by construction.
  ;;;
  ;;; `(thread-local)' emits `__thread', which takes a trivially destroyed
  ;;; type -- a bare pointer qualifies, as x509's and tls's buffers do. It
  ;;; replaces `(static)' rather than joining it because no attribute in this
  ;;; tree is stacked and the emitter has never been asked to.
  (thread-local) (var coco_machine * coco_b_sort_machine)

  (static)
  (func coco_b_sort_cmp ((const void * a) (const void * b)) (out int)
        (return (coco_compare coco_b_sort_machine
                            (cof (cast (const size_t *) a))
                            (cof (cast (const size_t *) b)))))

  (static)
  (func coco_b_sort_terms ((coco_machine * m) (size_t * v) (size_t n))
        (set coco_b_sort_machine m)
        (qsort v n (sizeof size_t) coco_b_sort_cmp))

  ;;; ---- the module -------------------------------------------------------

  (static) (coco-emit-module-dispatch coco_b_dispatch *builtins-predicates*)

  (coco-defmodule coco_builtins_module "builtins" coco_b_dispatch *builtins-prolog*)

  ) ; impl-builtins

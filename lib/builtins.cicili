;;;; cocolog -- the missing core builtins, as a module
;;;
;;; SWI has 655 built-in predicates. Most of them cannot exist here and it is
;;; worth saying which and why rather than leaving a reader to discover it:
;;; everything stream-shaped (there is no `open/3', so nothing to answer with),
;;; everything module-shaped, threads, tabling, the foreign interface, and
;;; SWI's own `prolog_*' introspection. Strings are a fifth: cocolog reads
;;; "abc" as a code list, which is the ISO default, so `string_concat/3' and
;;; its family have no type to work on.
;;;
;;; WHAT IS LEFT IS THE ISO CORE, and that is what this module is. The set was
;;; computed rather than remembered: the ISO built-in predicates plus the SWI
;;; extras that everyone treats as core, minus the forty-eight cocolog already
;;; had. What remained is here.
;;;
;;; STILL MISSING AFTER THIS, and each for a reason rather than for want of
;;; time:
;;;
;;;   catch/3 and throw/1  -- a catch is a new kind of choice-point frame, and
;;;     every kind of frame has to be written into a frozen machine and read
;;;     back (state.cicili). It is the suspension format that makes this a
;;;     change rather than an addition, and it deserves its own.
;;;
;;;   bagof/3 and setof/3  -- not findall plus a sort. They BACKTRACK over the
;;;     bindings of the free variables of the goal, answering one group per
;;;     witness, and that needs the engine to enumerate the groups. Shipping
;;;     findall-and-sort under those names would be a predicate that agrees
;;;     with SWI until the first free variable and then quietly does not.
;;;
;;;   op/3 and current_op/3  -- the reader's operator table is emitted from
;;;     `*operators*' at build time, which is what keeps the reader and the
;;;     writer from disagreeing. A run-time table is a real change to
;;;     syntax.cicili and to what a frozen machine has to carry.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

(DEFPARAMETER *builtins-predicates*
  '(("findall"                 3 coco_b_findall)
    ("findall"                 4 coco_b_findall4)
    ("forall"                  2 coco_b_forall)
    ("aggregate_all"           3 coco_b_aggregate_all)

    ("succ"                    2 coco_b_succ)
    ("plus"                    3 coco_b_plus)

    ("ground"                  1 coco_b_ground)
    ("term_variables"          2 coco_b_term_variables)
    ("unify_with_occurs_check" 2 coco_b_unify_occurs)

    ("atom_chars"              2 coco_b_atom_chars)
    ("char_code"               2 coco_b_char_code)
    ("number_chars"            2 coco_b_number_chars)
    ("atom_number"             2 coco_b_atom_number)
    ("upcase_atom"             2 coco_b_upcase)
    ("downcase_atom"           2 coco_b_downcase)
    ("term_to_atom"            2 coco_b_term_to_atom)
    ("$sub_atom"               5 coco_b_sub_atom_at)
    ("$atom_split"             3 coco_b_atom_split)
    ("$atom_join"              3 coco_b_atom_join)

    ("writeq"                  1 coco_b_writeq)
    ("write_term"              2 coco_b_write_term)
    ("tab"                     1 coco_b_tab)

    ("$clause"                 3 coco_b_clause_at)
    ("$pred_count"             3 coco_b_pred_count)
    ("$predicates"             1 coco_b_predicates)
    ("abolish"                 1 coco_b_abolish)

    ("nb_setval"               2 coco_b_setval)
    ("nb_getval"               2 coco_b_getval)
    ("b_setval"                2 coco_b_setval)
    ("b_getval"                2 coco_b_getval)

    ("op"                      3 coco_b_op)
    ("$ops"                    1 coco_b_ops)

    ("halt"                    1 coco_b_halt1)))

(DEFPARAMETER *builtins-prolog*
  (FORMAT NIL "~{~A ~}"
          (LIST
           ;; ---- between/3, which enumerates and so must be clauses --------
           "between(L, H, X) :- integer(X), !, X >= L, X =< H."
           "between(L, H, L) :- L =< H."
           "between(L, H, X) :- L < H, M is L + 1, between(M, H, X)."

           ;; ---- clause/2, over the primitive that answers by position -----
           ;; The count is taken once and the position enumerated, so a clause
           ;; asserted while this is backtracking does not shift the ones after
           ;; it under the cursor -- which is the hazard `retract' has always
           ;; had against a running query, and is written down in STATUS.md.
           "clause(H, B) :- '$pred_count'(H, N, _), N > 0, between(1, N, I), '$clause'(H, B, I)."

           ;; ---- current_predicate/1 ---------------------------------------
           "current_predicate(N/A) :- '$predicates'(L), '$cp_member'(N/A, L)."
           "'$cp_member'(X, [X|_])."
           "'$cp_member'(X, [_|T]) :- '$cp_member'(X, T)."

           ;; ---- retractall/1 ----------------------------------------------
           ;; Retracting inside a failure-driven loop, which is the only way to
           ;; do it with a deterministic `retract'.
           "retractall(H) :- retract(H), fail."
           "retractall(_)."

           ;; ---- sub_atom/5, which enumerates every substring ---------------
           ;; The C half answers ONE substring given where it starts and how
           ;; long it is; the enumeration is here, where the engine can make
           ;; the choice points. The bound-Sub case is separated out because
           ;; enumerating every B and L to find a known substring is O(n^2)
           ;; when a search is O(n).
           "sub_atom(A, B, L, Aft, Sub) :- atom(Sub), !, atom_length(A, N), atom_length(Sub, L), Max is N - L, between(0, Max, B), '$sub_atom'(A, B, L, Aft, Sub)."
           "sub_atom(A, B, L, Aft, Sub) :- atom_length(A, N), between(0, N, B), Rest is N - B, between(0, Rest, L), '$sub_atom'(A, B, L, Aft, Sub)."

           ;; ---- atomic_list_concat/2,3 -------------------------------------
           ;; With a separator and an unbound list it SPLITS, which is the mode
           ;; everybody actually uses it in.
           "atomic_list_concat(L, A) :- '$atom_join'(L, '', A)."
           "atomic_list_concat(L, Sep, A) :- var(L), !, '$atom_split'(A, Sep, L)."
           "atomic_list_concat(L, Sep, A) :- '$atom_join'(L, Sep, A)."

           ;; ---- current_op/3 -----------------------------------------------
           ;; Enumerating is backtracking, so the C half hands over the whole
           ;; table at once and `member/2' does the rest -- the same shape
           ;; `current_predicate/1' has, and for the same reason.
           "current_op(P, T, N) :- '$ops'(L), '$cp_member'(op(P, T, N), L)."

           ;; ---- keysort/2 --------------------------------------------------
           ;; Sorting by the key and keeping duplicates, stably, is exactly
           ;; what `sort/4' at key 1 with `@=<' does -- and stability is not
           ;; incidental here: `bagof/3' groups by the key and the order within
           ;; a group is the order the solutions came in.
           "keysort(L, S) :- sort(1, @=<, L, S)."

           ;; ---- bagof/3 and setof/3 ----------------------------------------
           ;;
           ;; NOT findall PLUS A SORT. They BACKTRACK, answering one solution
           ;; per distinct binding of the goal's FREE VARIABLES -- the ones
           ;; that appear in the goal, do not appear in the template, and were
           ;; not existentially quantified with `^'. `bagof(X, p(X,Y), L)' over
           ;; p(1,a), p(2,b), p(3,a) answers three times: Y=a with [1,3], then
           ;; Y=b with [2], then Y=c with [1].
           ;;
           ;; The whole of it is: work out the witness, collect Witness-Template
           ;; pairs with findall, sort them by witness, group the runs, and hand
           ;; the groups to `member/2' -- which is where the backtracking comes
           ;; from, and is why this is clauses and not C.
           ;;
           ;; AND THEY FAIL ON NO SOLUTIONS, where findall answers []. That is
           ;; the other half of what makes them different predicates.

           ;; `V^Goal' peeled off, however deep, with the quantified variables
           ;; collected as they go.
           "'$carets'(G, G2, Ex) :- nonvar(G), G = (V^G1), !, '$carets'(G1, G2, Ex1), Ex = [V|Ex1]."
           "'$carets'(G, G, [])."

           ;; membership and subtraction BY IDENTITY: these are variables, and
           ;; two distinct free variables unify with each other while being
           ;; different witnesses entirely.
           "'$var_in'(X, [Y|_]) :- X == Y, !."
           "'$var_in'(X, [_|T]) :- '$var_in'(X, T)."
           "'$vars_minus'([], _, [])."
           "'$vars_minus'([H|T], L, R) :- ( '$var_in'(H, L) -> R = R1 ; R = [H|R1] ), '$vars_minus'(T, L, R1)."

           "'$witness'(T, G0, G, W) :- '$carets'(G0, G, Ex), term_variables(G, GV), term_variables(T, TV), term_variables(Ex, EV), '$vars_minus'(GV, TV, V1), '$vars_minus'(V1, EV, W)."

           ;; runs of equal keys become one group. The keys are compared with
           ;; `==' and not `=': unifying them would merge two groups whose
           ;; witnesses merely happen to unify.
           "'$group'([], [])."
           "'$group'([K-V|T], [K-[V|Vs]|R]) :- '$same_key'(K, T, Vs, T1), '$group'(T1, R)."
           "'$same_key'(K, [K1-V|T], [V|Vs], T1) :- K1 == K, !, '$same_key'(K, T, Vs, T1)."
           "'$same_key'(_, T, [], T)."

           "bagof(T, G0, B) :- '$witness'(T, G0, G, W), '$bagof'(W, T, G, B)."
           ;; no free variables: one answer, and it is findall's -- except that
           ;; an empty one is a failure
           "'$bagof'([], T, G, B) :- !, findall(T, G, B), B \\== []."
           "'$bagof'(W, T, G, B) :- Wt =.. ['$w'|W], findall(Wt-T, G, Pairs), Pairs \\== [], keysort(Pairs, Sorted), '$group'(Sorted, Groups), member(Wt-B, Groups)."

           ;; setof is bagof with the group sorted, which also removes its
           ;; duplicates -- and the groups themselves already arrive in witness
           ;; order because keysort put them there.
           "setof(T, G, S) :- bagof(T, G, B), sort(B, S)."

           ;; ---- print/1 is write/1 here; SWI routes it through portray -----
           "print(X) :- write(X)."

           ;; ---- atom_string-free helpers the tests lean on -----------------
           "atom_chars_list(A, L) :- atom_chars(A, L).")))

(generic decl-builtins
  ()

  (decl) (func coco_builtins_module () (out int))

  ) ; decl-builtins


(generic impl-builtins
  ()

  ;;; Declared before they are used: `aggregate_all' reaches the sort, and the
  ;;; two recursive term walks call themselves through a name that has to
  ;;; exist first.
  (static) (decl) (func coco_b_is_ground ((coco_machine * m) (size_t t)) (out int))
  (static) (decl) (func coco_b_acyclic ((coco_machine * m) (size_t t) (int depth)) (out int))
  (static) (decl) (func coco_b_collect_vars ((coco_machine * m) (size_t t)
                                           (size_t ** v) (size_t * n) (size_t * cap)))
  (static) (decl) (func coco_b_atom_to_number ((coco_engine * e) (const char * text)
                                             (size_t to)) (out int))
  (static) (decl) (func coco_b_sort_terms ((coco_machine * m) (size_t * v) (size_t n)))
  (static) (decl) (func coco_b_case ((coco_engine * e) (size_t g) (int up)) (out int))
  (static) (decl) (func coco_b_typename ((int type)) (out const char *))
  (static) (decl) (func coco_b_ops_push ((coco_engine * e) (size_t ** v) (size_t * n)
                                       (size_t * cap) (int dyn)))

  ;;; ---- all solutions ---------------------------------------------------

  (func coco_b_findall ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t lst . 0))
          (if (not (coco_engine_findall e (coco_m_arg e g 0) (coco_m_arg e g 1) (aof lst)))
              (return -1))
          (return (coco_m_unify e (coco_m_arg e g 2) lst))))

  ;;; `findall(T, G, L, Tail)' -- the difference list form. The collected list
  ;;; ends in Tail instead of `[]', which is what makes it appendable without
  ;;; walking it again.
  (func coco_b_findall4 ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t lst . 0) (size_t * v . nil) (size_t n . 0) (size_t out))
          (if (not (coco_engine_findall e (coco_m_arg e g 0) (coco_m_arg e g 1) (aof lst)))
              (return -1))
          (if (not (coco_m_list_array e lst (aof v) (aof n))) (return 0))
          (set out (coco_m_arg e g 3))
          (for ((size_t i . n)) (> i 0) ((-- i))
            (set out (coco_cons m (nth (- i 1) v) out)))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 2) out))))

  ;;; `forall(C, A)' is `\+ (C, \+ A)', and is written that way rather than by
  ;;; collecting: it stops at the first counterexample and builds no list.
  (func coco_b_forall ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t lst . 0)
              (size_t goal . #'(coco_make2 m "," (coco_m_arg e g 0)
                                         (coco_make1 m "\\+" (coco_m_arg e g 1)))))
          (if (not (coco_engine_findall e (coco_new_atom m "x") goal (aof lst)))
              (return -1))
          ;; no counterexample means the list is empty
          (return (? (coco_m_is_atom e (coco_deref m lst)) 1 0))))

  ;;; `aggregate_all(Spec, Goal, Result)'. count, count(T), sum(T), max(T),
  ;;; min(T), bag(T) and set(T) -- the seven SWI documents for the form that
  ;;; does not group.
  (func coco_b_aggregate_all ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t spec . #'(coco_m_arg e g 0))
              (size_t goal . #'(coco_m_arg e g 1))
              (size_t tmpl) (const char * what)
              (size_t lst . 0) (size_t * v . nil) (size_t n . 0))

          ;; a bare `count' collects a constant; everything else collects the
          ;; argument of the spec
          (if (coco_m_is_atom e spec)
              (block (set what (coco_m_atom e spec))
                     (set tmpl (coco_new_atom m "x")))
            (block
             (if (not (coco_is_callable m spec))
                 (return (coco_m_domain_error e "aggregate_spec" spec)))
             (if (!= (coco_arity m spec) 1)
                 (return (coco_m_domain_error e "aggregate_spec" spec)))
             (set what (coco_atom_name m (coco_name_of m spec)))
             (set tmpl (coco_arg m spec 0))))

          (if (not (coco_engine_findall e tmpl goal (aof lst))) (return -1))
          (if (not (coco_m_list_array e lst (aof v) (aof n))) (return 0))

          (if (== 0 (strcmp what "count"))
              (block (free v) (return (coco_m_unify_int e (coco_m_arg e g 2) (cast i64 n)))))

          (if (== 0 (strcmp what "bag"))
              (block (free v) (return (coco_m_unify e (coco_m_arg e g 2) lst))))

          (if (== 0 (strcmp what "set"))
              (let ((size_t k . 0))
                (coco_b_sort_terms m v n)
                (for ((size_t i . 0)) (< i n) ((++ i))
                  (if (or (== k 0) (!= 0 (coco_compare m (nth (- k 1) v) (nth i v))))
                      (block (set (nth k v) (nth i v)) (set k (+ k 1)))))
                (let ((size_t out . #'(coco_m_list e v k)))
                  (free v)
                  (return (coco_m_unify e (coco_m_arg e g 2) out)))))

          ;; the numeric three. An empty list is a failure for max and min --
          ;; there is no answer -- and zero for sum, which is what SWI does.
          (if (== 0 (strcmp what "sum"))
              (let ((double acc . 0.0) (int all_int . 1))
                (for ((size_t i . 0)) (< i n) ((++ i))
                  (let ((double d . 0.0) (i64 iv . 0))
                    (if (not (coco_m_int e (nth i v) (aof iv))) (set all_int 0))
                    (if (not (coco_m_float e (nth i v) (aof d)))
                        ;; the term is taken BEFORE the array goes: reading
                        ;; `(nth i v)' after the free is a use-after-free, and
                        ;; it segfaulted on the first list of integers
                        (let ((size_t bad . #'(nth i v)))
                          (free v)
                          (return (coco_m_type_error e "number" bad))))
                    (set acc (+ acc d))))
                (free v)
                (return (? all_int
                           (coco_m_unify_int e (coco_m_arg e g 2) (cast i64 acc))
                           (coco_m_unify_float e (coco_m_arg e g 2) acc)))))

          (if (or (== 0 (strcmp what "max")) (== 0 (strcmp what "min")))
              (let ((int want_max . #'(? (== 0 (strcmp what "max")) 1 0))
                    (size_t best . 0))
                (if (== n 0) (block (free v) (return 0)))
                (set best (nth 0 v))
                (for ((size_t i . 1)) (< i n) ((++ i))
                  (let ((double a . 0.0) (double b . 0.0))
                    (if (or (not (coco_m_float e best (aof a)))
                            (not (coco_m_float e (nth i v) (aof b))))
                        (let ((size_t bad . #'(nth i v)))
                          (free v)
                          (return (coco_m_type_error e "number" bad))))
                    (if (? want_max (> b a) (< b a)) (set best (nth i v)))))
                (free v)
                (return (coco_m_unify e (coco_m_arg e g 2) best))))

          (free v)
          (return (coco_m_domain_error e "aggregate_spec" (coco_m_arg e g 0))))) 

  ;;; ---- arithmetic in the small ----------------------------------------

  ;;; `succ(?X, ?Y)' -- Y is X+1, either way round, over NATURAL numbers only,
  ;;; which is what makes `succ(X, 0)' fail rather than answer -1.
  (func coco_b_succ ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 a . 0) (i64 b . 0))
          (if (coco_m_int e (coco_m_arg e g 0) (aof a))
              (block (if (< a 0) (return 0))
                     (return (coco_m_unify_int e (coco_m_arg e g 1) (+ a 1)))))
          (if (coco_m_int e (coco_m_arg e g 1) (aof b))
              (block (if (<= b 0) (return 0))
                     (return (coco_m_unify_int e (coco_m_arg e g 0) (- b 1)))))
          (return (coco_m_instantiation_error e))))

  ;;; `plus(?A, ?B, ?C)' -- any one of the three may be the unbound one.
  (func coco_b_plus ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 a . 0) (i64 b . 0) (i64 c . 0)
              (int ha . 0) (int hb . 0) (int hc . 0))
          (set ha (coco_m_int e (coco_m_arg e g 0) (aof a)))
          (set hb (coco_m_int e (coco_m_arg e g 1) (aof b)))
          (set hc (coco_m_int e (coco_m_arg e g 2) (aof c)))
          (if (and ha hb) (return (coco_m_unify_int e (coco_m_arg e g 2) (+ a b))))
          (if (and ha hc) (return (coco_m_unify_int e (coco_m_arg e g 1) (- c a))))
          (if (and hb hc) (return (coco_m_unify_int e (coco_m_arg e g 0) (- c b))))
          (return (coco_m_instantiation_error e))))

  ;;; ---- terms ------------------------------------------------------------

  (static)
  (func coco_b_is_ground ((coco_machine * m) (size_t t)) (out int)
        (set t (coco_deref m t))
        (if (coco-tag-is REF (nth t (-> m heap))) (return 0))
        (if (not (coco_is_callable m t)) (return 1))
        (for ((u32 i . 0)) (< i (coco_arity m t)) ((++ i))
          (if (not (coco_b_is_ground m (coco_arg m t i))) (return 0)))
        (return 1))

  (func coco_b_ground ((coco_engine * e) (size_t g)) (out int)
        (return (coco_b_is_ground (coco_m_machine e) (coco_m_arg e g 0))))

  ;;; Every distinct unbound variable, in the order first met -- which is the
  ;;; order SWI answers in and is not the same as any sorted order.
  (static)
  (func coco_b_collect_vars ((coco_machine * m) (size_t t) (size_t ** v)
                           (size_t * n) (size_t * cap))
        (set t (coco_deref m t))
        (if (coco-tag-is REF (nth t (-> m heap)))
            (block
             (for ((size_t i . 0)) (< i (cof n)) ((++ i))
               (if (== (nth i (cof v)) t) (return)))
             (if (>= (cof n) (cof cap))
                 (let ((size_t ncap . #'(? (== (cof cap) 0) 8 (* (cof cap) 2)))
                       (size_t * nb))
                   (set nb (cast (size_t *) (realloc (cof v) (* ncap (sizeof size_t)))))
                   (if (== nb nil) (return))
                   (set (cof v) nb)
                   (set (cof cap) ncap)))
             (set (nth (cof n) (cof v)) t)
             (set (cof n) (+ (cof n) 1))
             (return)))
        (if (not (coco_is_callable m t)) (return))
        (for ((u32 i . 0)) (< i (coco_arity m t)) ((++ i))
          (coco_b_collect_vars m (coco_arg m t i) v n cap)))

  (func coco_b_term_variables ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t * v . nil) (size_t n . 0) (size_t cap . 0) (size_t out))
          (coco_b_collect_vars (coco_m_machine e) (coco_m_arg e g 0)
                             (aof v) (aof n) (aof cap))
          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 1) out))))

  ;;; Unification that refuses to build a cyclic term. cocolog's `=' does not
  ;;; check -- no Prolog's does by default -- so this one unifies and then
  ;;; looks, winding back if what came out is not a term.
  (func coco_b_unify_occurs ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t mark . #'(coco_m_mark e))
              (size_t a . #'(coco_m_arg e g 0))
              (size_t b . #'(coco_m_arg e g 1)))
          (if (not (coco_m_unify e a b)) (block (coco_m_undo e mark) (return 0)))
          ;; a cycle shows up as a term that cannot be walked to a finite depth
          (if (not (coco_b_acyclic (coco_m_machine e) a 0))
              (block (coco_m_undo e mark) (return 0)))
          (return 1)))

  ;;; Depth-bounded rather than marking: a cyclic term has no finite depth, so
  ;;; a bound deeper than any real term will do and costs nothing to unwind.
  (static)
  (func coco_b_acyclic ((coco_machine * m) (size_t t) (int depth)) (out int)
        (if (> depth 5000) (return 0))
        (set t (coco_deref m t))
        (if (not (coco_is_callable m t)) (return 1))
        (for ((u32 i . 0)) (< i (coco_arity m t)) ((++ i))
          (if (not (coco_b_acyclic m (coco_arg m t i) (+ depth 1))) (return 0)))
        (return 1))

  ;;; ---- atoms ------------------------------------------------------------

  ;;; A character is a ONE-CHARACTER ATOM in Prolog, not a code. `atom_chars'
  ;;; and `atom_codes' differ in exactly that.
  (func coco_b_atom_chars ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (char buf [4096]))
          (if (coco_m_text e (coco_m_arg e g 0) buf (sizeof buf))
              (let ((size_t lst . #'(coco_m_nil e)) (size_t len . #'(strlen buf)))
                (for ((size_t i . len)) (> i 0) ((-- i))
                  (let ((char one [2]))
                    (set (nth 0 one) (nth (- i 1) buf))
                    (set (nth 1 one) (cast char 0))
                    (set lst (coco_cons m (coco_new_atom m one) lst))))
                (return (coco_m_unify e (coco_m_arg e g 1) lst))))
          ;; the other way: a list of one-character atoms into an atom
          (let ((size_t * v . nil) (size_t n . 0) (char out [4096]))
            (if (not (coco_m_list_array e (coco_m_arg e g 1) (aof v) (aof n)))
                (return (coco_m_instantiation_error e)))
            (if (>= n (sizeof out)) (block (free v) (return 0)))
            (for ((size_t i . 0)) (< i n) ((++ i))
              (let ((const char * c . #'(coco_m_atom e (coco_deref m (nth i v)))))
                (if (or (== c nil) (!= 1 (strlen c)))
                    (block (free v) (return (coco_m_type_error e "character"
                                                             (nth i v)))))
                (set (nth i out) (nth 0 c))))
            (set (nth n out) (cast char 0))
            (free v)
            (return (coco_m_unify_atom e (coco_m_arg e g 0) out)))))

  (func coco_b_char_code ((coco_engine * e) (size_t g)) (out int)
        (let ((const char * c . #'(coco_m_atom e (coco_m_arg e g 0))) (i64 code . 0))
          (if (and (!= c nil) (== 1 (strlen c)))
              (return (coco_m_unify_int e (coco_m_arg e g 1)
                                      (bitand (cast i64 (nth 0 c)) 255))))
          (if (coco_m_int e (coco_m_arg e g 1) (aof code))
              (let ((char one [2]))
                (if (or (< code 0) (> code 255)) (return 0))
                (set (nth 0 one) (cast char code))
                (set (nth 1 one) (cast char 0))
                (return (coco_m_unify_atom e (coco_m_arg e g 0) one))))
          (return (coco_m_instantiation_error e))))

  ;;; Like atom_chars but the atom has to read back as a number.
  (func coco_b_number_chars ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t * v . nil) (size_t n . 0) (char buf [4096]))
          ;; number -> chars
          (let ((i64 iv . 0) (double d . 0.0))
            (if (or (coco_m_int e (coco_m_arg e g 0) (aof iv))
                    (coco_m_float e (coco_m_arg e g 0) (aof d)))
                (let ((coco_strbuf b) (size_t lst . #'(coco_m_nil e)))
                  (coco_sb_init (aof b))
                  (coco_write_term m (aof b) (coco_m_arg e g 0) 0 0)
                  (snprintf buf (sizeof buf) "%s" (? (== ($ b s) nil) "" ($ b s)))
                  (coco_sb_free (aof b))
                  (for ((size_t i . #'(strlen buf))) (> i 0) ((-- i))
                    (let ((char one [2]))
                      (set (nth 0 one) (nth (- i 1) buf))
                      (set (nth 1 one) (cast char 0))
                      (set lst (coco_cons m (coco_new_atom m one) lst))))
                  (return (coco_m_unify e (coco_m_arg e g 1) lst)))))
          ;; chars -> number
          (if (not (coco_m_list_array e (coco_m_arg e g 1) (aof v) (aof n)))
              (return (coco_m_instantiation_error e)))
          (if (>= n (sizeof buf)) (block (free v) (return 0)))
          (for ((size_t i . 0)) (< i n) ((++ i))
            (let ((const char * c . #'(coco_m_atom e (coco_deref m (nth i v)))))
              (if (or (== c nil) (!= 1 (strlen c)))
                  (block (free v) (return (coco_m_type_error e "character" (nth i v)))))
              (set (nth i buf) (nth 0 c))))
          (set (nth n buf) (cast char 0))
          (free v)
          (return (coco_b_atom_to_number e buf (coco_m_arg e g 0)))))

  ;;; Reads TEXT as a Prolog term and insists it is a number. Going through the
  ;;; reader rather than `strtod' is what makes `0xff' and `0'a' work here
  ;;; exactly as they do in a source file.
  (static)
  (func coco_b_atom_to_number ((coco_engine * e) (const char * text) (size_t to)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (size_t t . 0)
              (size_t mark . #'($ (cof (coco_m_machine e)) heap_len)))
          (if (not (coco_read_term_from m text (aof t)))
              (block (set (-> m heap_len) mark) (return 0)))
          (let ((i64 iv . 0) (double d . 0.0))
            (if (or (coco_m_int e t (aof iv)) (coco_m_float e t (aof d)))
                (return (coco_m_unify e to t))))
          (set (-> m heap_len) mark)
          (return 0)))

  (func coco_b_atom_number ((coco_engine * e) (size_t g)) (out int)
        (let ((char buf [4096]) (i64 iv . 0) (double d . 0.0))
          ;; number -> atom
          (if (or (coco_m_int e (coco_m_arg e g 1) (aof iv))
                  (coco_m_float e (coco_m_arg e g 1) (aof d)))
              (let ((coco_strbuf b) (int rc))
                (coco_sb_init (aof b))
                (coco_write_term (coco_m_machine e) (aof b) (coco_m_arg e g 1) 0 0)
                (set rc (coco_m_unify_atom e (coco_m_arg e g 0)
                                         (? (== ($ b s) nil) "" ($ b s))))
                (coco_sb_free (aof b))
                (return rc)))
          ;; atom -> number, and a FAILURE when the atom is not one, which is
          ;; the whole difference between this and `atom_to_term'
          (if (coco_m_is_var e (coco_m_arg e g 0))
              (return (coco_m_instantiation_error e)))
          (if (not (coco_m_text e (coco_m_arg e g 0) buf (sizeof buf)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (return (coco_b_atom_to_number e buf (coco_m_arg e g 1)))))

  (static)
  (func coco_b_case ((coco_engine * e) (size_t g) (int up)) (out int)
        (let ((char buf [4096]))
          (if (not (coco_m_text e (coco_m_arg e g 0) buf (sizeof buf)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (for ((size_t i . 0)) (< i (strlen buf)) ((++ i))
            (let ((int c . #'(bitand (cast int (nth i buf)) 255)))
              (if up
                  (if (and (>= c 97) (<= c 122)) (set (nth i buf) (cast char (- c 32))))
                (if (and (>= c 65) (<= c 90)) (set (nth i buf) (cast char (+ c 32)))))))
          (return (coco_m_unify_atom e (coco_m_arg e g 1) buf))))

  (func coco_b_upcase ((coco_engine * e) (size_t g)) (out int) (return (coco_b_case e g 1)))
  (func coco_b_downcase ((coco_engine * e) (size_t g)) (out int) (return (coco_b_case e g 0)))

  ;;; Both directions: a term written out, or an atom read back in.
  (func coco_b_term_to_atom ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (char buf [8192]))
          (if (not (coco_m_is_var e (coco_m_arg e g 0)))
              (let ((coco_strbuf b) (int rc))
                (coco_sb_init (aof b))
                (coco_write_term m (aof b) (coco_m_arg e g 0) 1 0)
                (set rc (coco_m_unify_atom e (coco_m_arg e g 1)
                                         (? (== ($ b s) nil) "" ($ b s))))
                (coco_sb_free (aof b))
                (return rc)))
          (if (not (coco_m_text e (coco_m_arg e g 1) buf (sizeof buf)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 1))))
          (let ((size_t t . 0))
            (if (not (coco_read_term_from m buf (aof t)))
                (return (coco_m_error e "term_to_atom/2 cannot read" buf)))
            (return (coco_m_unify e (coco_m_arg e g 0) t)))))

  ;;; One substring, at a known place and length. The enumeration is in the
  ;;; Coco half, where the engine can make the choice points.
  (func coco_b_sub_atom_at ((coco_engine * e) (size_t g)) (out int)
        (let ((char a [4096]) (char out [4096])
              (i64 before . 0) (i64 len . 0) (size_t n))
          (if (not (coco_m_text e (coco_m_arg e g 0) a (sizeof a)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (if (not (coco_m_int e (coco_m_arg e g 1) (aof before))) (return 0))
          (if (not (coco_m_int e (coco_m_arg e g 2) (aof len))) (return 0))
          (set n (strlen a))
          (if (or (< before 0) (< len 0)) (return 0))
          (if (> (cast size_t (+ before len)) n) (return 0))
          (memcpy out (+ a before) (cast size_t len))
          (set (nth len out) (cast char 0))
          (let ((size_t mark . #'(coco_m_mark e)))
            (if (not (coco_m_unify_int e (coco_m_arg e g 3)
                                     (cast i64 (- n (cast size_t (+ before len))))))
                (block (coco_m_undo e mark) (return 0)))
            (if (not (coco_m_unify_atom e (coco_m_arg e g 4) out))
                (block (coco_m_undo e mark) (return 0))))
          (return 1)))

  ;;; `$atom_split(Atom, Sep, Parts)'. An empty separator would split into
  ;;; nothing sensible, so it is refused here and the caller's clause never
  ;;; sends one.
  (func coco_b_atom_split ((coco_engine * e) (size_t g)) (out int)
        (let ((char a [8192]) (char sep [256])
              (char ** parts . nil) (size_t n . 0) (size_t cap . 0) (int rc))
          (if (not (coco_m_text e (coco_m_arg e g 0) a (sizeof a)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (if (not (coco_m_text e (coco_m_arg e g 1) sep (sizeof sep)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 1))))
          (if (== 0 (strlen sep))
              (return (coco_m_error e "atomic_list_concat/3 cannot split on an empty separator" nil)))
          (let ((char * p . a))
            (while 1
              (let ((char * q . #'(strstr p sep)))
                (if (>= n cap)
                    (let ((size_t ncap . #'(? (== cap 0) 8 (* cap 2)))
                          (char ** nb))
                      (set nb (cast (char **) (realloc parts (* ncap (sizeof (char *))))))
                      (if (== nb nil) break)
                      (set parts nb)
                      (set cap ncap)))
                (if (== q nil)
                    (block (set (nth n parts) (strdup p)) (set n (+ n 1)) break))
                (set (nth 0 q) (cast char 0))
                (set (nth n parts) (strdup p))
                (set n (+ n 1))
                (set (nth 0 q) (nth 0 sep))
                (set p (+ q (strlen sep))))))
          (set rc (coco_m_unify e (coco_m_arg e g 2) (coco_m_atom_list e parts n)))
          (for ((size_t i . 0)) (< i n) ((++ i)) (free (nth i parts)))
          (free parts)
          (return rc)))

  (func coco_b_atom_join ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t * v . nil) (size_t n . 0)
              (char sep [256]) (char out [8192]) (size_t len . 0))
          (if (not (coco_m_list_array e (coco_m_arg e g 0) (aof v) (aof n)))
              (return (coco_m_type_error e "list" (coco_m_arg e g 0))))
          (if (not (coco_m_text e (coco_m_arg e g 1) sep (sizeof sep)))
              (block (free v) (return (coco_m_type_error e "atom" (coco_m_arg e g 1)))))
          (set (nth 0 out) (cast char 0))
          (for ((size_t i . 0)) (< i n) ((++ i))
            (let ((char one [4096]))
              (if (not (coco_m_text e (nth i v) one (sizeof one)))
                  (block (free v) (return (coco_m_type_error e "atomic" (nth i v)))))
              (if (> i 0)
                  (block (if (>= (+ len (strlen sep)) (sizeof out))
                             (block (free v) (return 0)))
                         (memcpy (+ out len) sep (strlen sep))
                         (set len (+ len (strlen sep)))))
              (if (>= (+ len (strlen one) 1) (sizeof out))
                  (block (free v) (return 0)))
              (memcpy (+ out len) one (strlen one))
              (set len (+ len (strlen one)))
              (set (nth len out) (cast char 0))))
          (free v)
          (return (coco_m_unify_atom e (coco_m_arg e g 2) out))))

  ;;; ---- writing ----------------------------------------------------------

  (func coco_b_writeq ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_term (coco_m_machine e) (aof b) (coco_m_arg e g 0) 1 0)
          (if (!= ($ b s) nil) (fputs ($ b s) stdout))
          (coco_sb_free (aof b))
          (return 1)))

  ;;; `write_term(Term, Options)'. `quoted(true)' and `ignore_ops(true)' are
  ;;; the two the writer actually has; anything else in the list is ignored
  ;;; rather than refused, because an option a writer does not implement is
  ;;; not a reason to fail a program.
  (func coco_b_write_term ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t * v . nil) (size_t n . 0)
              (int quoted . 0) (int ignore_ops . 0) (coco_strbuf b))
          (if (coco_m_list_array e (coco_m_arg e g 1) (aof v) (aof n))
              (for ((size_t i . 0)) (< i n) ((++ i))
                (let ((size_t o . #'(coco_deref m (nth i v))))
                  (if (and (coco_is_callable m o) (== 1 (coco_arity m o)))
                      (let ((const char * nm . #'(coco_atom_name m (coco_name_of m o)))
                            (const char * val . #'(coco_m_atom e (coco_deref m (coco_arg m o 0)))))
                        (if (and (!= val nil) (== 0 (strcmp val "true")))
                            (block
                             (if (== 0 (strcmp nm "quoted")) (set quoted 1))
                             (if (== 0 (strcmp nm "ignore_ops")) (set ignore_ops 1)))))))))
          (free v)
          (coco_sb_init (aof b))
          (coco_write_term m (aof b) (coco_m_arg e g 0) quoted ignore_ops)
          (if (!= ($ b s) nil) (fputs ($ b s) stdout))
          (coco_sb_free (aof b))
          (return 1)))

  (func coco_b_tab ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 n . 0))
          (if (not (coco_m_int e (coco_m_arg e g 0) (aof n)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
          (for ((i64 i . 0)) (< i n) ((++ i)) (fputc 32 stdout))
          (return 1)))

  ;;; ---- the clause database ----------------------------------------------

  ;;; How many clauses a predicate has, and its index in the store. The index
  ;;; comes back too so that `$clause' need not find it again.
  (func coco_b_pred_count ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t head . #'(coco_m_arg e g 0)))
          (if (not (coco_is_callable m head))
              (return (coco_m_type_error e "callable" head)))
          (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m head)
                                               (coco_arity m head))))
            (if (>= pi ($ (cof st) npreds)) (return 0))
            (coco_pred_ensure st pi)
            (let ((size_t mark . #'(coco_m_mark e)))
              (if (not (coco_m_unify_int e (coco_m_arg e g 1)
                                       (cast i64 ($ (nth pi ($ (cof st) preds)) nclauses))))
                  (block (coco_m_undo e mark) (return 0)))
              (if (not (coco_m_unify_int e (coco_m_arg e g 2) (cast i64 pi)))
                  (block (coco_m_undo e mark) (return 0))))
            (return 1))))

  ;;; The Ith clause of the predicate named by Head, as Head and Body. I counts
  ;;; from one, because the Coco half enumerates it with `between/3'.
  (func coco_b_clause_at ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t head . #'(coco_m_arg e g 0))
              (i64 want . 0))
          (if (not (coco_m_int e (coco_m_arg e g 2) (aof want))) (return 0))
          (if (not (coco_is_callable m head)) (return 0))
          (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m head)
                                               (coco_arity m head))))
            (if (>= pi ($ (cof st) npreds)) (return 0))
            (coco_pred_ensure st pi)
            (let ((coco_pred * p . #'(aof (nth pi ($ (cof st) preds)))))
              (if (or (< want 1) (> (cast size_t want) (-> p nclauses))) (return 0))
              (let ((size_t mark . #'(coco_m_mark e))
                    (size_t t . #'(coco_store_get m st (nth (- want 1) (-> p clauses))))
                    (size_t h . 0) (size_t bdy . 0))
                (coco_clause_parts m t (aof h) (aof bdy))
                ;; a fact's body is `true', which is what SWI answers too
                (if (== bdy 0) (set bdy (coco_new_atom m "true")))
                (if (not (coco_m_unify e head h))
                    (block (coco_m_undo e mark) (return 0)))
                (if (not (coco_m_unify e (coco_m_arg e g 1) bdy))
                    (block (coco_m_undo e mark) (return 0)))
                (return 1))))))

  ;;; Every predicate the store knows, as Name/Arity. The library's own
  ;;; predicates are left out: `current_predicate/1' is about the program.
  (func coco_b_predicates ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t * v . nil) (size_t n . 0) (size_t cap . 0) (size_t out))
          (coco_store_warm st)
          (for ((size_t i . 0)) (< i ($ (cof st) npreds)) ((++ i))
            (if (not ($ (nth i ($ (cof st) preds)) library))
                (block
                 (if (>= n cap)
                     (let ((size_t ncap . #'(? (== cap 0) 16 (* cap 2)))
                           (size_t * nb))
                       (set nb (cast (size_t *) (realloc v (* ncap (sizeof size_t)))))
                       (if (== nb nil) break)
                       (set v nb)
                       (set cap ncap)))
                 (set (nth n v)
                      (coco_make2 m "/"
                                (coco_new_atom m (coco_atom_name m ($ (nth i ($ (cof st) preds)) name)))
                                (coco_new_int m (cast i64 ($ (nth i ($ (cof st) preds)) arity)))))
                 (set n (+ n 1)))))
          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 0) out))))

  ;;; `abolish(Name/Arity)' -- every clause of it goes, and the write-through
  ;;; hook hears about it because this is a retract of the whole predicate.
  (func coco_b_abolish ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t spec . #'(coco_m_arg e g 0)))
          (if (not (coco_is_compound2 m spec "/"))
              (return (coco_m_type_error e "predicate_indicator" spec)))
          (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
                (size_t ar . #'(coco_deref m (coco_arg m spec 1)))
                (i64 arity . 0))
            (if (not (coco_m_is_atom e nm))
                (return (coco_m_type_error e "atom" nm)))
            (if (not (coco_m_int e ar (aof arity)))
                (return (coco_m_type_error e "integer" ar)))
            (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m nm) (cast u32 arity))))
              (if (>= pi ($ (cof st) npreds)) (return 1))
              (coco_pred_ensure st pi)
              ;; retract the first clause until there is none, so that the
              ;; backend hears once per removal exactly as it would from a
              ;; program doing the same thing
              (while (> ($ (nth pi ($ (cof st) preds)) nclauses) 0)
                (let ((size_t mark . #'($ (cof m) heap_len))
                      (size_t t . #'(coco_store_get m st
                                                  (nth 0 ($ (nth pi ($ (cof st) preds)) clauses)))))
                  (coco_retract st m t)
                  (set (-> m heap_len) mark)))
              (return 1)))))

  ;;; ---- global variables -------------------------------------------------
  ;;;
  ;;; `nb_' and `b_' are the same thing here. SWI's differ on backtracking --
  ;;; a `b_setval' is undone and an `nb_setval' is not -- and undoing one would
  ;;; need a trail entry that is not a variable binding, which the trail does
  ;;; not carry. They are documented as the non-backtrackable pair.
  ;;;
  ;;; THE VALUE GOES IN THE STORE, not the heap: a global that a query set has
  ;;; to survive the query's heap being wound back, and the store is the only
  ;;; thing here that does not shrink.

  (struct coco_b_global
    (member u64    name)
    (member size_t cell))

  (static) (var coco_b_global * coco_b_globals)
  (static) (var size_t coco_b_nglobals)
  (static) (var size_t coco_b_gcap)

  (func coco_b_setval ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t k . #'(coco_m_arg e g 0)))
          (if (not (coco_m_is_atom e k)) (return (coco_m_type_error e "atom" k)))
          (let ((u64 name . #'(coco_name_of m k))
                (size_t cell . #'(coco_store_put (-> e st) m (coco_m_arg e g 1))))
            (for ((size_t i . 0)) (< i coco_b_nglobals) ((++ i))
              (if (== ($ (nth i coco_b_globals) name) name)
                  (block (set ($ (nth i coco_b_globals) cell) cell) (return 1))))
            (if (>= coco_b_nglobals coco_b_gcap)
                (let ((size_t ncap . #'(? (== coco_b_gcap 0) 8 (* coco_b_gcap 2)))
                      (coco_b_global * nb))
                  (set nb (cast (coco_b_global *)
                                (realloc coco_b_globals (* ncap (sizeof coco_b_global)))))
                  (if (== nb nil) (return 0))
                  (set coco_b_globals nb)
                  (set coco_b_gcap ncap)))
            (set ($ (nth coco_b_nglobals coco_b_globals) name) name)
            (set ($ (nth coco_b_nglobals coco_b_globals) cell) cell)
            (set coco_b_nglobals (+ coco_b_nglobals 1))
            (return 1))))

  (func coco_b_getval ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t k . #'(coco_m_arg e g 0)))
          (if (not (coco_m_is_atom e k)) (return (coco_m_type_error e "atom" k)))
          (let ((u64 name . #'(coco_name_of m k)))
            (for ((size_t i . 0)) (< i coco_b_nglobals) ((++ i))
              (if (== ($ (nth i coco_b_globals) name) name)
                  (return (coco_m_unify e (coco_m_arg e g 1)
                                      (coco_store_get m (-> e st)
                                                    ($ (nth i coco_b_globals) cell))))))
            (return (coco_m_existence_error e "variable" (coco_m_arg e g 0))))))

  ;;; ---- operators --------------------------------------------------------

  (static)
  (func coco_b_typename ((int type)) (out const char *)
        (if (== type COCO_XFX) (return "xfx"))
        (if (== type COCO_XFY) (return "xfy"))
        (if (== type COCO_YFX) (return "yfx"))
        (if (== type COCO_FY)  (return "fy"))
        (return "fx"))

  ;;; `op(+Priority, +Type, +Name)'. Name may be a list of names, which is what
  ;;; every real operator declaration uses. Priority 0 takes the operator away.
  (func coco_b_op ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (i64 prec . 0) (int type . 0) (int kind . 0)
              (const char * ts)
              (size_t * names . nil) (size_t n . 0))

          (if (coco_m_is_var e (coco_m_arg e g 0)) (return (coco_m_instantiation_error e)))
          (if (not (coco_m_int e (coco_m_arg e g 0) (aof prec)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
          (if (or (< prec 0) (> prec 1200))
              (return (coco_m_domain_error e "operator_priority" (coco_m_arg e g 0))))

          (set ts (coco_m_atom e (coco_m_arg e g 1)))
          (if (== ts nil)
              (block (if (coco_m_is_var e (coco_m_arg e g 1))
                         (return (coco_m_instantiation_error e)))
                     (return (coco_m_type_error e "atom" (coco_m_arg e g 1)))))
          (if (not (coco_op_type_of ts (aof type) (aof kind)))
              (return (coco_m_domain_error e "operator_specifier" (coco_m_arg e g 1))))

          ;; one name, or a list of them
          (if (not (coco_m_list_array e (coco_m_arg e g 2) (aof names) (aof n)))
              (let ((const char * one . #'(coco_m_atom e (coco_m_arg e g 2))))
                (if (== one nil)
                    (block (if (coco_m_is_var e (coco_m_arg e g 2))
                               (return (coco_m_instantiation_error e)))
                           (return (coco_m_type_error e "atom" (coco_m_arg e g 2)))))
                (if (not (coco_op_define one (cast int prec) type kind))
                    (return (coco_m_error e "that operator name will not fit" one)))
                (return 1)))

          (for ((size_t i . 0)) (< i n) ((++ i))
            (let ((const char * one . #'(coco_m_atom e (nth i names))))
              (if (== one nil)
                  (block (free names)
                         (return (coco_m_type_error e "atom" (nth i names)))))
              (if (not (coco_op_define one (cast int prec) type kind))
                  (block (free names)
                         (return (coco_m_error e "that operator name will not fit" one))))))
          (free names)
          (return 1)))

  ;;; Every operator there is, as `op(Priority, Type, Name)'. The DECLARED ones
  ;;; first and the built-in ones after, with a built-in left out when a
  ;;; declaration of the same name and kind has hidden it -- so what comes back
  ;;; is what the reader would actually do, not two tables stuck together.
  (func coco_b_ops ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t * v . nil) (size_t n . 0) (size_t cap . 0) (size_t out))

          (coco_b_ops_push e (aof v) (aof n) (aof cap) 1)
          (coco_b_ops_push e (aof v) (aof n) (aof cap) 0)

          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 0) out))))

  ;;; DECLARED when `dyn', built-in otherwise. Pulled out because the two loops
  ;;; are the same but for which table they read and whether they skip.
  (static)
  (func coco_b_ops_push ((coco_engine * e) (size_t ** v) (size_t * n) (size_t * cap)
                       (int dyn))
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t total . #'(? dyn (coco_op_dyn_count) (coco_op_static_count))))
          (for ((size_t i . 0)) (< i total) ((++ i))
            (let ((const char * name . nil) (int prec . 0)
                  (int type . 0) (int kind . 0))
              (if (not (? dyn (coco_op_dyn_at i (aof name) (aof prec) (aof type) (aof kind))
                          (coco_op_static_at i (aof name) (aof prec) (aof type) (aof kind))))
                  continue)
              ;; a declaration with priority 0 is not an operator, and a
              ;; built-in that one has hidden is not one either
              (if (== prec 0) continue)
              (if (not dyn)
                  (let ((int dp . 0) (int dt . 0))
                    (if (>= (coco_op_dyn_lookup_pub name kind (aof dp) (aof dt)) 0)
                        continue)))
              (if (>= (cof n) (cof cap))
                  (let ((size_t ncap . #'(? (== (cof cap) 0) 64 (* (cof cap) 2)))
                        (size_t * nb))
                    (set nb (cast (size_t *) (realloc (cof v) (* ncap (sizeof size_t)))))
                    (if (== nb nil) (return))
                    (set (cof v) nb)
                    (set (cof cap) ncap)))
              (let ((size_t args [3]))
                (set (nth 0 args) (coco_new_int m (cast i64 prec)))
                (set (nth 1 args) (coco_new_atom m (coco_b_typename type)))
                (set (nth 2 args) (coco_new_atom m name))
                (set (nth (cof n) (cof v)) (coco_make m "op" 3 args)))
              (set (cof n) (+ (cof n) 1))))))

  ;;; ---- halting ----------------------------------------------------------

  (func coco_b_halt1 ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 code . 0))
          (coco_m_int e (coco_m_arg e g 0) (aof code))
          (set (-> e halted) 1)
          (set (-> e halt_code) (cast int code))
          (return 1)))

  ;;; ---- a sort the aggregation needs -------------------------------------

  (static) (var coco_machine * coco_b_sort_machine)

  (static)
  (func coco_b_sort_cmp ((const void * a) (const void * b)) (out int)
        (return (coco_compare coco_b_sort_machine
                            (cof (cast (const size_t *) a))
                            (cof (cast (const size_t *) b)))))

  (static)
  (func coco_b_sort_terms ((coco_machine * m) (size_t * v) (size_t n))
        (set coco_b_sort_machine m)
        (qsort v n (sizeof size_t) coco_b_sort_cmp))

  ;;; ---- the module -------------------------------------------------------

  (static) (coco-emit-module-dispatch coco_b_dispatch *builtins-predicates*)

  (coco-defmodule coco_builtins_module "builtins" coco_b_dispatch *builtins-prolog*)

  ) ; impl-builtins

;;;; cocolog -- compiled clauses: the head and body programs, the guards
;;;; and the environments
;;;
;;; A PIECE OF THE KNOWLEDGE BASE, split out of lib/kb.cicili for size
;;; (2.16.1, where that file had reached 8 080 lines). The four pieces are ONE
;;; translation unit, emitted in this order by cocolog.cicili and by the test
;;; binaries that link the store: kb, kb-compile, kb-pred, kb-consult. So a
;;; function here calls only what an earlier piece defined or `decl-kb'
;;; declared, exactly as when they were one file. lib/kb.cicili keeps the
;;; compiler's tables and macros and every declaration.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

(generic impl-kb-compile
  ()

  ;;; ---- compiled clauses --------------------------------------------------
  ;;;
  ;;; ONE WORD AN INSTRUCTION: the operation in the low eight bits, a frame
  ;;; index K in the next twenty-four, an argument index or an arity N in
  ;;; the high thirty-two; a constant or a functor follows in the word
  ;;; after. EACH NUMBER HAS A FIELD OF ITS OWN: GET_STRUCT once packed its
  ;;; argument index and its arity into sixteen bits each, and a head
  ;;; holding a structure of 65 536 arguments read back with every one of
  ;;; them wrong (1.8.45). A clause whose frame needs more than K can hold
  ;;; is not compiled (`coco_clause_code'). The head's instructions:
  ;;;
  ;;;   GET_VAR    k i     frame[k] is the call's argument i, dereferenced
  ;;;   GET_VAL    k i     unify frame[k] with argument i
  ;;;   GET_CONST  i  C    argument i is the constant C, or is bound to it
  ;;;   GET_STRUCT i n F   argument i (in K) is F/n: read its arguments, or
  ;;;                      build it and bind the argument to it -- READ or
  ;;;                      WRITE
  ;;;   GET_STRUCT_T k n F the same on frame[k]: a nested structure the
  ;;;                      parent left in a temporary
  ;;;   UNIFY_VAR   k      the next argument of the structure in hand is a
  ;;;                      variable met first: frame[k] is its slot
  ;;;   UNIFY_VAL   k      ... a variable met before: unify, or write it
  ;;;   UNIFY_CONST C      ... the constant C
  ;;;
  ;;; and the body's, which build a goal top down over ONE reservation:
  ;;; the goal's root word carries every cell the goal takes, and each
  ;;; argument word the offset from the goal's base of the slot it fills
  ;;; (in K) and, for a constant or a structure, of the cell it puts
  ;;; there (in N) -- settled here, so the executor keeps no stack of
  ;;; open structures and checks nothing (1.8.46; through 1.8.45 the
  ;;; words said "the next slot" and the executor found it on a frame
  ;;; stack, growing the heap once per structure, as the copy does):
  ;;;
  ;;;   GOAL_STRUCT t F    a goal F/_ starts: t cells, the header first
  ;;;   GOAL_ATOM   C      a goal that is an atom
  ;;;   GOAL_VAR    k      a goal that is a variable (call/1's business)
  ;;;   GOAL_VAR_1  k      ... met first here
  ;;;   ARG_CONST   o a C  slot o: the constant C, in cell a
  ;;;   ARG_VAR     k o    slot o: frame[k]
  ;;;   ARG_VAR_1   k o    slot o IS the variable, met first here
  ;;;   ARG_STRUCT  o a F  slot o: the structure whose header F is cell a,
  ;;;                      and whose own slots the words that follow fill
  ;;;
  ;;; and the first goal's REGISTER FORM (`rbody', Stage 3), which writes
  ;;; its arguments into the engine's registers and builds no header and
  ;;; no slots; what it nests takes the body's ARG words, offset from its
  ;;; one reservation (`cc_reg_form'):
  ;;;
  ;;;   RGOAL       n t    t cells for what the goal nests (left out when
  ;;;                      there are none); n its arity
  ;;;   RARG_CONST  r a C  register r: the constant C, in cell a
  ;;;   RARG_VAR    k r    register r: frame[k]
  ;;;   RARG_VAR_1  k r a  register r: a fresh variable in cell a, frame[k]
  ;;;   RARG_STRUCT r a F  register r: the structure whose header F is cell a
  ;;;
  ;;; A program ends where its length says (there was an END word through
  ;;; 1.8.45, one dispatch a clause for nothing).
  ;;;
  ;;; The executor names them too (`coco_clause_run'), never their numbers:
  ;;; ONE TABLE, read two ways -- the `cc_NAME' functions below, which the
  ;;; compiler calls, and `(cc-op "NAME")', a number at expansion time, for
  ;;; a `case' label in the executor's switch, which must be a constant.
  ;;; Nothing else may spell an opcode's number.
  (static) (func cc_GET_VAR () (out u64) (return (cc-op "GET_VAR")))
  (static) (func cc_GET_VAL () (out u64) (return (cc-op "GET_VAL")))
  (static) (func cc_GET_CONST () (out u64) (return (cc-op "GET_CONST")))
  (static) (func cc_GET_STRUCT () (out u64) (return (cc-op "GET_STRUCT")))
  (static) (func cc_GET_STRUCT_T () (out u64) (return (cc-op "GET_STRUCT_T")))
  (static) (func cc_UNIFY_VAR () (out u64) (return (cc-op "UNIFY_VAR")))
  (static) (func cc_UNIFY_VAL () (out u64) (return (cc-op "UNIFY_VAL")))
  (static) (func cc_UNIFY_CONST () (out u64) (return (cc-op "UNIFY_CONST")))
  (static) (func cc_GOAL_STRUCT () (out u64) (return (cc-op "GOAL_STRUCT")))
  (static) (func cc_GOAL_ATOM () (out u64) (return (cc-op "GOAL_ATOM")))
  (static) (func cc_GOAL_VAR () (out u64) (return (cc-op "GOAL_VAR")))
  (static) (func cc_GOAL_VAR_1 () (out u64) (return (cc-op "GOAL_VAR_1")))
  (static) (func cc_ARG_CONST () (out u64) (return (cc-op "ARG_CONST")))
  (static) (func cc_ARG_VAR () (out u64) (return (cc-op "ARG_VAR")))
  (static) (func cc_ARG_VAR_1 () (out u64) (return (cc-op "ARG_VAR_1")))
  (static) (func cc_ARG_STRUCT () (out u64) (return (cc-op "ARG_STRUCT")))
  (static) (func cc_RGOAL () (out u64) (return (cc-op "RGOAL")))
  (static) (func cc_RARG_CONST () (out u64) (return (cc-op "RARG_CONST")))
  (static) (func cc_RARG_VAR () (out u64) (return (cc-op "RARG_VAR")))
  (static) (func cc_RARG_VAR_1 () (out u64) (return (cc-op "RARG_VAR_1")))
  (static) (func cc_RARG_STRUCT () (out u64) (return (cc-op "RARG_STRUCT")))
  (static) (func cc_AG_LOAD () (out u64) (return (cc-op "AG_LOAD")))
  (static) (func cc_AG_PUSH () (out u64) (return (cc-op "AG_PUSH")))
  (static) (func cc_AG_BIN () (out u64) (return (cc-op "AG_BIN")))
  (static) (func cc_AG_UN () (out u64) (return (cc-op "AG_UN")))
  (static) (func cc_AG_CMP () (out u64) (return (cc-op "AG_CMP")))
  (static) (func cc_AG_ISF () (out u64) (return (cc-op "AG_ISF")))
  (static) (func cc_AG_ISV () (out u64) (return (cc-op "AG_ISV")))
  (static) (func cc_AG_ISC () (out u64) (return (cc-op "AG_ISC")))
  (static) (func cc_AG_TYPE () (out u64) (return (cc-op "AG_TYPE")))
  (static) (func cc_FRESH () (out u64) (return (cc-op "FRESH")))
  (static) (func cc_AG_ISX () (out u64) (return (cc-op "AG_ISX")))
  (static) (func cc_AG_CMPX () (out u64) (return (cc-op "AG_CMPX")))

  (func coco_regs_max () (out u32) (return 8))

  (static)
  (func cc_word ((u64 op) (u64 k) (u64 n)) (out u64)
        (return (bitor op (bitor (<< (bitand k 16777215) 8) (<< n 32)))))
  (static) (func cc_op ((u64 w)) (out u64) (return (bitand w 255)))
  (static) (func cc_k ((u64 w)) (out size_t) (return (cast size_t (bitand (>> w 8) 16777215))))
  (static) (func cc_n ((u64 w)) (out u64) (return (>> w 32)))

  ;;; A growing word buffer, for the two programs as they are emitted.
  (struct coco_cbuf
    (member u64 *  w)
    (member size_t len)
    (member size_t cap))

  (static)
  (func cc_emit ((coco_cbuf * b) (u64 w)) (out int)
        (if (>= (-> b len) (-> b cap))
            (let ((size_t ncap . #'(? (== (-> b cap) 0) 16 (* (-> b cap) 2)))
                  (void * nb . #'(realloc (cast (void *) (-> b w)) (* ncap (sizeof u64)))))
              (if (== nb nil) (return 0))
              (set (-> b w) (cast (u64 *) nb))
              (set (-> b cap) ncap)))
        (set (nth (-> b len) (-> b w)) w)
        (set (-> b len) (+ (-> b len) 1))
        (return 1))

  ;;; One pending compound of a compilation: the structure's store index,
  ;;; how many of its arguments are emitted, and for the head the frame
  ;;; index its temporary was left in.
  (struct coco_cframe
    (member size_t src)
    (member size_t k)
    (member u32    n)
    (member u32    i))

  (static)
  (func cc_frames_push ((coco_cframe ** fs) (size_t * len) (size_t * cap)
                        (size_t src) (size_t k) (u32 n)) (out int)
        (if (>= (cof len) (cof cap))
            (let ((size_t ncap . #'(? (== (cof cap) 0) 32 (* (cof cap) 2)))
                  (void * nb . #'(realloc (cast (void *) (cof fs)) (* ncap (sizeof coco_cframe)))))
              (if (== nb nil) (return 0))
              (set (cof fs) (cast (coco_cframe *) nb))
              (set (cof cap) ncap)))
        (set ($ (nth (cof len) (cof fs)) src) src)
        (set ($ (nth (cof len) (cof fs)) k) k)
        (set ($ (nth (cof len) (cof fs)) n) n)
        (set ($ (nth (cof len) (cof fs)) i) 0)
        (set (cof len) (+ (cof len) 1))
        (return 1))

  ;;; The frame index of the store variable at S, numbering it if this is
  ;;; its first occurrence; FIRST says which it was.
  (static)
  (func cc_var ((coco_varmap * vm) (size_t s) (u32 * nvars) (int * first)) (out size_t)
        (let ((size_t k . 0))
          (if (== 1 (coco_varmap_intern vm s (cast size_t (cof nvars)) (aof k)))
              (block (set (cof first) 0) (return k)))
          (set (cof first) 1)
          (set k (cast size_t (cof nvars)))
          (set (cof nvars) (+ (cof nvars) 1))
          (return k)))

  ;;; The arguments of one head structure, as UNIFY instructions: a
  ;;; variable by its frame index, a constant by its cell, and a nested
  ;;; structure through a temporary -- the WAM's flattening -- with the
  ;;; structure itself queued to be emitted after, breadth first, so it is
  ;;; always read or written after its parent put its slot in hand.
  (static)
  (func cc_head_args ((coco_store * st) (coco_machine * m) (size_t src) (u32 an)
                      (coco_varmap * vm) (u32 * nvars) (coco_cbuf * b)
                      (coco_cframe ** q) (size_t * qlen) (size_t * qcap)) (out int)
        (let ((int ok . 1))
          (for ((u32 j . 0)) (< j an) ((++ j))
            (let ((size_t sa . #'(coco_store_deref st (+ src (+ (cast size_t j) 1))))
                  (u64 cs . 0) (int sfirst . 0))
              (set cs (nth sa (-> st cells)))
              (cond
                ((coco-tag-is REF cs)
                 (let ((size_t k . #'(cc_var vm sa nvars (aof sfirst))))
                   (if (not (cc_emit b (cc_word (? sfirst (cc_UNIFY_VAR) (cc_UNIFY_VAL)) k 0)))
                       (set ok 0))))
                ((coco-tag-is FUN cs)
                 (let ((size_t t . #'(cast size_t (cof nvars)))
                       (u32 sn . #'($ (nth (cast size_t (coco-payload cs)) (-> m functors)) arity)))
                   (set (cof nvars) (+ (cof nvars) 1))
                   (if (not (cc_emit b (cc_word (cc_UNIFY_VAR) t 0))) (set ok 0))
                   (if (not (cc_frames_push q qlen qcap sa t sn)) (set ok 0))))
                (#t
                 (if (not (cc_emit b (cc_word (cc_UNIFY_CONST) 0 0))) (set ok 0))
                 (if (not (cc_emit b cs)) (set ok 0))))))
          (return ok)))

  ;;; THE HEAD. Each top-level argument gets its GET instruction and, for a
  ;;; structure, its arguments' UNIFY instructions right after; the nested
  ;;; structures those queued are worked off in order.
  (static)
  (func cc_compile_head ((coco_store * st) (coco_machine * m) (size_t head)
                         (coco_varmap * vm) (u32 * nvars) (coco_cbuf * b)) (out int)
        (let ((coco_cframe * q . nil) (size_t qlen . 0) (size_t qcap . 0) (size_t qi . 0)
              (u64 c . #'(nth head (-> st cells))) (int ok . 1))
          (if (not (coco-tag-is FUN c)) (return 1))
          (let ((u32 n . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity)))
            (for ((u32 i . 0)) (< i n) ((++ i))
              (let ((size_t a . #'(coco_store_deref st (+ head (+ (cast size_t i) 1))))
                    (u64 ca . 0) (int first . 0))
                (set ca (nth a (-> st cells)))
                (cond
                  ((coco-tag-is REF ca)
                   (let ((size_t k . #'(cc_var vm a nvars (aof first))))
                     (if (not (cc_emit b (cc_word (? first (cc_GET_VAR) (cc_GET_VAL)) k i)))
                         (set ok 0))))
                  ((coco-tag-is FUN ca)
                   (let ((u32 an . #'($ (nth (cast size_t (coco-payload ca)) (-> m functors)) arity)))
                     ;; the argument index in K, which has twenty-four bits
                     (if (> i 16777215) (set ok 0))
                     (if (not (cc_emit b (cc_word (cc_GET_STRUCT) (cast u64 i) (cast u64 an))))
                         (set ok 0))
                     (if (not (cc_emit b (coco-payload ca))) (set ok 0))
                     (if (not (cc_head_args st m a an vm nvars b (aof q) (aof qlen) (aof qcap)))
                         (set ok 0))))
                  (#t
                   (if (not (cc_emit b (cc_word (cc_GET_CONST) 0 i))) (set ok 0))
                   (if (not (cc_emit b ca)) (set ok 0)))))))
          (while (and ok (< qi qlen))
            (let ((size_t src . #'($ (nth qi q) src)) (size_t t . #'($ (nth qi q) k))
                  (u32 an . #'($ (nth qi q) n))
                  (u64 cs0 . #'(nth ($ (nth qi q) src) (-> st cells))))
              (if (not (cc_emit b (cc_word (cc_GET_STRUCT_T) t (cast u64 an)))) (set ok 0))
              (if (not (cc_emit b (coco-payload cs0))) (set ok 0))
              (if (not (cc_head_args st m src an vm nvars b (aof q) (aof qlen) (aof qcap)))
                  (set ok 0))
              (set qi (+ qi 1))))
          (free q)
          (return ok)))

  ;;; THE CELLS A GOAL TAKES ON THE HEAP, built as the executor builds it:
  ;;; a structure's header and its slots, a constant argument's own cell,
  ;;; nothing for a variable (its slot is the variable, or points at one
  ;;; that exists). 0 when the walk's stack could not grow, which the
  ;;; compile reads as "not compiled".
  (static)
  (func cc_goal_cells ((coco_store * st) (coco_machine * m) (size_t t)) (out size_t)
        (let ((coco_cframe * fs . nil) (size_t flen . 0) (size_t fcap . 0)
              (size_t total . 0) (int ok . 1) (u64 c . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (if (not (coco-tag-is FUN c)) (return 1))
          (let ((u32 n . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity)))
            (set total (+ (cast size_t n) 1))
            (if (> n 0)
                (if (not (cc_frames_push (aof fs) (aof flen) (aof fcap) t 0 n)) (set ok 0))))
          (while (and ok (> flen 0))
            (let ((size_t fi . #'(- flen 1)))
              (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n))
                  (block (set flen fi) continue))
              (let ((size_t sa . #'(coco_store_deref st (+ ($ (nth fi fs) src)
                                                          (+ (cast size_t ($ (nth fi fs) i)) 1))))
                    (u64 cs . 0))
                (set ($ (nth fi fs) i) (+ ($ (nth fi fs) i) 1))
                (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n)) (set flen fi))
                (set cs (nth sa (-> st cells)))
                (cond
                  ((coco-tag-is REF cs) (block))
                  ((coco-tag-is FUN cs)
                   (let ((u32 sn . #'($ (nth (cast size_t (coco-payload cs)) (-> m functors)) arity)))
                     (set total (+ total (+ (cast size_t sn) 1)))
                     (if (> sn 0)
                         (if (not (cc_frames_push (aof fs) (aof flen) (aof fcap) sa 0 sn)) (set ok 0)))))
                  (#t (set total (+ total 1)))))))
          (free fs)
          (return (? ok total 0))))

  ;;; ONE GOAL OF THE BODY, top down: the root's instruction, then its
  ;;; arguments depth first, each structure's arguments right after its
  ;;; own word -- the order the copy walks, and the order the executor
  ;;; fills slots in. THE LAYOUT IS SETTLED HERE: the root's cells come
  ;;; first, then each nested structure's and each constant's in emission
  ;;; order, so every slot and every cell has an offset from the goal's
  ;;; base known at compile time -- the slot's in a word's K, the cell's
  ;;; in its N -- and the root's word carries the goal's total, for the
  ;;; executor to reserve in one go (1.8.46). A frame's `k' is its
  ;;; structure's offset, so its i'th slot is at k + 1 + i.
  (static)
  (func cc_compile_goal ((coco_store * st) (coco_machine * m) (size_t t)
                         (coco_varmap * vm) (u32 * nvars) (coco_cbuf * b)) (out int)
        (let ((coco_cframe * fs . nil) (size_t flen . 0) (size_t fcap . 0)
              (u64 c . 0) (int ok . 1) (int first . 0) (size_t top . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (cond
            ((coco-tag-is REF c)
             (let ((size_t k . #'(cc_var vm t nvars (aof first))))
               (if (not (cc_emit b (cc_word (? first (cc_GOAL_VAR_1) (cc_GOAL_VAR)) k 0)))
                   (set ok 0))
               (return ok)))
            ((coco-tag-is FUN c)
             (let ((u32 n . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity))
                   (size_t total . #'(cc_goal_cells st m t)))
               (if (== total 0) (return 0))
               (if (not (cc_emit b (cc_word (cc_GOAL_STRUCT) 0 (cast u64 total)))) (set ok 0))
               (if (not (cc_emit b (coco-payload c))) (set ok 0))
               (set top (+ (cast size_t n) 1))
               (if (> n 0)
                   (if (not (cc_frames_push (aof fs) (aof flen) (aof fcap) t 0 n)) (set ok 0)))))
            (#t
             (if (not (cc_emit b (cc_word (cc_GOAL_ATOM) 0 0))) (set ok 0))
             (if (not (cc_emit b c)) (set ok 0))
             (return ok)))
          (while (and ok (> flen 0))
            (let ((size_t fi . #'(- flen 1)))
              (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n))
                  (block (set flen fi) continue))
              (let ((size_t sa . #'(coco_store_deref st (+ ($ (nth fi fs) src)
                                                          (+ (cast size_t ($ (nth fi fs) i)) 1))))
                    (size_t off . #'(+ ($ (nth fi fs) k) (+ (cast size_t ($ (nth fi fs) i)) 1)))
                    (u64 cs . 0))
                (set ($ (nth fi fs) i) (+ ($ (nth fi fs) i) 1))
                (if (>= ($ (nth fi fs) i) ($ (nth fi fs) n)) (set flen fi))
                (set cs (nth sa (-> st cells)))
                ;; a slot offset is K's twenty-four bits; a goal is a
                ;; clause's and a clause fits a page, so this cannot be
                ;; reached, and is refused rather than wrapped
                (if (> off 16777215) (set ok 0))
                (cond
                  ((coco-tag-is REF cs)
                   (let ((size_t k . #'(cc_var vm sa nvars (aof first))))
                     (if (not (cc_emit b (cc_word (? first (cc_ARG_VAR_1) (cc_ARG_VAR)) k (cast u64 off))))
                         (set ok 0))))
                  ((coco-tag-is FUN cs)
                   (let ((u32 sn . #'($ (nth (cast size_t (coco-payload cs)) (-> m functors)) arity))
                         (size_t at . top))
                     (set top (+ top (+ (cast size_t sn) 1)))
                     (if (not (cc_emit b (cc_word (cc_ARG_STRUCT) (cast u64 off) (cast u64 at)))) (set ok 0))
                     (if (not (cc_emit b (coco-payload cs))) (set ok 0))
                     (if (> sn 0)
                         (if (not (cc_frames_push (aof fs) (aof flen) (aof fcap) sa at sn)) (set ok 0)))))
                  (#t
                   (let ((size_t at . top))
                     (set top (+ top 1))
                     (if (not (cc_emit b (cc_word (cc_ARG_CONST) (cast u64 off) (cast u64 at)))) (set ok 0))
                     (if (not (cc_emit b cs)) (set ok 0))))))))
          (free fs)
          (return ok)))

  ;;; THE BODY: its right spine of `,' is one goal per term, up to 63; what
  ;;; is left past that is one `,' goal, which the engine takes apart as it
  ;;; always did. For each goal, STARTS answers where its words begin and
  ;;; NVAFTER how many variables were numbered once it was compiled -- so a
  ;;; variable whose number is at least the count before goal I is met
  ;;; first in goal I, which is what the guards need to know
  ;;; (`cc_compile_guards') and the environment (`cc_compile_env').
  (static)
  (func cc_compile_body ((coco_store * st) (coco_machine * m) (size_t body)
                         (coco_varmap * vm) (u32 * nvars) (coco_cbuf * b) (u32 * ngoals)
                         (u32 * starts) (u32 * nvafter)) (out int)
        (let ((size_t g . #'(coco_store_deref st body)) (int ok . 1) (u32 count . 0)
              (u64 comma . #'(coco_intern m ",")))
          (while (and ok (< count 63))
            (let ((u64 c . #'(nth g (-> st cells))))
              (if (and (coco-tag-is FUN c)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) comma))
                  (block
                   (set (nth count starts) (cast u32 (-> b len)))
                   (if (not (cc_compile_goal st m (+ g 1) vm nvars b)) (set ok 0))
                   (set (nth count nvafter) (cof nvars))
                   (set count (+ count 1))
                   (set g (coco_store_deref st (+ g 2))))
                  break)))
          ;; the last goal, or everything that is left
          (if ok
              (block
               (set (nth count starts) (cast u32 (-> b len)))
               (if (not (cc_compile_goal st m g vm nvars b)) (set ok 0))
               (set (nth count nvafter) (cof nvars))
               (set count (+ count 1))))
          (set (cof ngoals) count)
          (return ok)))

  ;;; ---- the guards (Stage 4 of compiled control) --------------------------
  ;;;
  ;;; ARITHMETIC WAS MOST OF WHAT THE BENCH TASKS DO, AND ALL OF IT WAS
  ;;; INTERPRETED TWICE: `A1 is A0 + K' was built on the heap as a term when
  ;;; its clause was entered, put on the continuation in a frame, taken out
  ;;; by the next step, dispatched to `is/2', and its expression walked by
  ;;; `coco_arith' -- per goal, about as much again as a call costs. Counted
  ;;; on 1.9.0, `is/2' and the six comparisons were 67 % of the inferences
  ;;; of the counting loop, 62 % of queens', 67 % of the sort task's and
  ;;; 43 % of the lookup's, and most of them stand at the START of a body:
  ;;; a counter, an accumulator, a guard.
  ;;;
  ;;; So the goals a body starts with are compiled, when they are `X is E',
  ;;; a comparison of two expressions, or a type test of a variable, into a
  ;;; program over a stack of integers that reads the clause's own frame
  ;;; (`gbody'), and they are run as the clause is entered, right after the
  ;;; head: no term, no frame, no step. The proposal's Stage 4 made the
  ;;; whole body lazy to get here; that changes the continuation's shape
  ;;; and a frozen machine's format, and counted on the translator its
  ;;; bodies average 1.9 goals -- the lazy body had little else to save.
  ;;; The leading goals need none of it: nothing runs between a clause's
  ;;; entry and its first goal, so running them there is running them when
  ;;; the step would have, and the continuation never holds anything new.
  ;;;
  ;;; A GUARD ONLY EVER TAKES THE ROAD THE STEP WOULD HAVE TAKEN. Integers
  ;;; only, computed as `coco_arith' computes them (the same C, so the same
  ;;; wrap past 2^63); a variable that is not bound to an integer, a zero
  ;;; divisor, a float anywhere, an operator not in `*cc-gops*' -- anything
  ;;; the step would raise for, or answer a float to -- stops the guards
  ;;; before that goal does anything, and the goal and the rest of the body
  ;;; are built and stepped as they always were (`gstart'). Each guard that
  ;;; runs is still an inference (`statistics(inferences)' and the
  ;;; inference limit count it, and a guard that fails counts as the step
  ;;; that failed); under trace none runs, the ports being printed from
  ;;; goals.

  ;;; The names a Cicili string cannot carry, by their codes: `/\', `\/',
  ;;; `\' and `=\=', and `\==' for Stage 7.
  (static) (var char CC_GN_AND [] . '{ 47 92 0 })
  (static) (var char CC_GN_OR  [] . '{ 92 47 0 })
  (static) (var char CC_GN_NOT [] . '{ 92 0 })
  (static) (var char CC_GN_NEQ [] . '{ 61 92 61 0 })
  (static) (var char CC_GN_NEQEQ [] . '{ 92 61 61 0 })

  ;;; The guard code of an operator S of arity N: KIND 0 an arithmetic one,
  ;;; KIND 1 a comparison, KIND 2 a type test; 0 for none.
  (static)
  (func cc_guard_code ((const char * s) (u32 n) (int kind)) (out u64)
        (if (and (== kind 0) (== n 2))
            (block
             (if (== 0 (strcmp s "+")) (return (cc-gop "+")))
             (if (== 0 (strcmp s "-")) (return (cc-gop "-")))
             (if (== 0 (strcmp s "*")) (return (cc-gop "*")))
             (if (== 0 (strcmp s "//")) (return (cc-gop "//")))
             (if (== 0 (strcmp s "div")) (return (cc-gop "div")))
             (if (== 0 (strcmp s "mod")) (return (cc-gop "mod")))
             (if (== 0 (strcmp s "rem")) (return (cc-gop "rem")))
             (if (== 0 (strcmp s "min")) (return (cc-gop "min")))
             (if (== 0 (strcmp s "max")) (return (cc-gop "max")))
             (if (== 0 (strcmp s ">>")) (return (cc-gop ">>")))
             (if (== 0 (strcmp s "<<")) (return (cc-gop "<<")))
             (if (== 0 (strcmp s CC_GN_AND)) (return (cc-gop "bitand")))
             (if (== 0 (strcmp s CC_GN_OR)) (return (cc-gop "bitor")))
             (if (== 0 (strcmp s "xor")) (return (cc-gop "xor")))
             (return 0)))
        (if (and (== kind 0) (== n 1))
            (block
             (if (== 0 (strcmp s "-")) (return (cc-gop "neg")))
             (if (== 0 (strcmp s "+")) (return (cc-gop "pos")))
             (if (== 0 (strcmp s CC_GN_NOT)) (return (cc-gop "bitnot")))
             (if (== 0 (strcmp s "abs")) (return (cc-gop "abs")))
             (if (== 0 (strcmp s "sign")) (return (cc-gop "sign")))
             (return 0)))
        (if (and (== kind 1) (== n 2))
            (block
             (if (== 0 (strcmp s "<")) (return (cc-gop "<")))
             (if (== 0 (strcmp s ">")) (return (cc-gop ">")))
             (if (== 0 (strcmp s "=<")) (return (cc-gop "=<")))
             (if (== 0 (strcmp s ">=")) (return (cc-gop ">=")))
             (if (== 0 (strcmp s "=:=")) (return (cc-gop "=:=")))
             (if (== 0 (strcmp s CC_GN_NEQ)) (return (cc-gop "numneq")))
             (return 0)))
        (if (and (== kind 2) (== n 1))
            (block
             (if (== 0 (strcmp s "var")) (return (cc-gop "var")))
             (if (== 0 (strcmp s "nonvar")) (return (cc-gop "nonvar")))
             (if (== 0 (strcmp s "atom")) (return (cc-gop "atom")))
             (if (== 0 (strcmp s "integer")) (return (cc-gop "integer")))
             (if (== 0 (strcmp s "number")) (return (cc-gop "number")))
             (if (== 0 (strcmp s "atomic")) (return (cc-gop "atomic")))
             (if (== 0 (strcmp s "compound")) (return (cc-gop "compound")))
             (return 0)))
        (return 0))

  ;;; One more value on the guard's stack, of the sixteen it has.
  (static)
  (func cc_guard_push ((u32 * sp)) (out int)
        (set (cof sp) (+ (cof sp) 1))
        (return (? (<= (cof sp) 16) 1 0)))

  ;;; AN EXPRESSION AS STACK CODE: a variable met before this goal (a frame
  ;;; index under LIMIT), an integer, or an operator of `cc_guard_code' over
  ;;; expressions. 0 for anything else -- a float, an atom, a variable met
  ;;; first here (an instantiation error the goal will raise), an operator
  ;;; the guards do not evaluate -- and the goal is left to the step. DEPTH
  ;;; bounds the recursion, which is the expression's as the program wrote
  ;;; it.
  (static)
  (func cc_guard_expr ((coco_store * st) (coco_machine * m) (size_t t) (coco_varmap * vm)
                       (u32 limit) (coco_cbuf * b) (u32 depth) (u32 * sp)) (out int)
        (set t (coco_store_deref st t))
        (if (> depth 24) (return 0))
        (let ((u64 c . #'(nth t (-> st cells))))
          (cond
            ((coco-tag-is REF c)
             (let ((size_t k . 0))
               (if (!= 1 (coco_varmap_get vm t (aof k))) (return 0))
               (if (>= k (cast size_t limit)) (return 0))
               (if (not (cc_emit b (cc_word (cc_AG_LOAD) (cast u64 k) 0))) (return 0))
               (return (cc_guard_push sp))))
            ((coco-tag-is INT c)
             (if (not (cc_emit b (cc_word (cc_AG_PUSH) 0 0))) (return 0))
             (if (not (cc_emit b c)) (return 0))
             (return (cc_guard_push sp)))
            ((coco-tag-is FUN c)
             (let ((coco_functor * f . #'(aof (nth (cast size_t (coco-payload c)) (-> m functors))))
                   (u64 op . 0))
               (set op (cc_guard_code (coco_atom_name m (-> f name)) (-> f arity) 0))
               (if (== op 0) (return 0))
               (for ((u32 i . 0)) (< i (-> f arity)) ((++ i))
                 (if (not (cc_guard_expr st m (+ t (+ (cast size_t i) 1)) vm limit b (+ depth 1) sp))
                     (return 0)))
               (if (== (-> f arity) 2)
                   (block (if (not (cc_emit b (cc_word (cc_AG_BIN) op 0))) (return 0))
                          (set (cof sp) (- (cof sp) 1)))
                   (if (not (cc_emit b (cc_word (cc_AG_UN) op 0))) (return 0)))
               (return 1)))
            (#t (return 0)))))

  ;;; ONE GOAL AS A GUARD, if it is one: `X is E', a comparison of two
  ;;; expressions, or a type test of a variable met before it. LIMIT is how
  ;;; many variables were met before this goal (the head's and the earlier
  ;;; goals'): only the left of an `is' may be one met first here, and that
  ;;; one is written into the frame (AG_ISF) where the body would have made
  ;;; it a fresh variable -- its later goals read it there either way. 0,
  ;;; with nothing emitted, when the goal is not a guard.
  (static)
  (func cc_guard_goal ((coco_store * st) (coco_machine * m) (size_t t) (coco_varmap * vm)
                       (u32 limit) (coco_cbuf * b)) (out int)
        (let ((u64 c . 0) (u32 sp . 0) (size_t mark . #'(-> b len)) (int ok . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (if (not (coco-tag-is FUN c)) (return 0))
          (let ((coco_functor * f . #'(aof (nth (cast size_t (coco-payload c)) (-> m functors))))
                (const char * s . nil) (u64 cmp . 0) (u64 typ . 0))
            ;; a name a program file took over (redefine_system_predicate/1,
            ;; 3.1.0) is the program's predicate, called
            (if (and (!= (-> st ntaken) 0) (coco_pred_taken st (-> f name) (-> f arity)))
                (return 0))
            (set s (coco_atom_name m (-> f name)))
            (set cmp (cc_guard_code s (-> f arity) 1))
            (set typ (cc_guard_code s (-> f arity) 2))
            (cond
              ;; X is E: E, then the left -- a variable met before (bound,
              ;; or compared when it is bound), one met first here (made),
              ;; or an integer (compared)
              ((and (== (-> f arity) 2) (== 0 (strcmp s "is")))
               (if (cc_guard_expr st m (+ t 2) vm limit b 0 (aof sp))
                   (let ((size_t l . #'(coco_store_deref st (+ t 1)))
                         (u64 lc . 0) (size_t k . 0))
                     (set lc (nth l (-> st cells)))
                     (cond
                       ((coco-tag-is REF lc)
                        (if (== 1 (coco_varmap_get vm l (aof k)))
                            (set ok (cc_emit b (cc_word (? (>= k (cast size_t limit)) (cc_AG_ISF) (cc_AG_ISV))
                                                        (cast u64 k) 0)))))
                       ((coco-tag-is INT lc)
                        (set ok (and (cc_emit b (cc_word (cc_AG_ISC) 0 0)) (cc_emit b lc))))
                       (#t (block))))))
              ;; a comparison: both sides, then the test
              ((!= cmp 0)
               (if (and (cc_guard_expr st m (+ t 1) vm limit b 0 (aof sp))
                        (cc_guard_expr st m (+ t 2) vm limit b 0 (aof sp)))
                   (set ok (cc_emit b (cc_word (cc_AG_CMP) cmp 0)))))
              ;; a type test of a variable met before this goal
              ((!= typ 0)
               (let ((size_t v . #'(coco_store_deref st (+ t 1))) (size_t k . 0))
                 (if (and (coco-tag-is REF (nth v (-> st cells)))
                          (== 1 (coco_varmap_get vm v (aof k)))
                          (< k (cast size_t limit)))
                     (set ok (cc_emit b (cc_word (cc_AG_TYPE) (cast u64 k) typ))))))
              (#t (block))))
          (if (not ok) (set (-> b len) mark))
          (return ok)))

  ;;; THE GUARDS OF A BODY: its leading goals, while each is one and eight
  ;;; at most, compiled into one program (B). NVHEAD is how many variables
  ;;; the head numbered and NVAFTER the counts `cc_compile_body' kept, so
  ;;; goal I's limit is NVAFTER[I - 1], the head's for goal 0. Answers how
  ;;; many goals it took.
  (static)
  (func cc_compile_guards ((coco_store * st) (coco_machine * m) (size_t body) (coco_varmap * vm)
                           (u32 nvhead) (const u32 * nvafter) (u32 ngoals) (coco_cbuf * b)) (out u32)
        (let ((size_t g . #'(coco_store_deref st body)) (u32 count . 0)
              (u64 comma . #'(coco_intern m ",")))
          (while (and (< count 8) (< count ngoals))
            (let ((u64 c . #'(nth g (-> st cells))) (size_t goal . g) (int more . 0))
              (if (and (coco-tag-is FUN c)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) comma))
                  (block (set goal (+ g 1)) (set more 1)))
              (if (not (cc_guard_goal st m goal vm (? (== count 0) nvhead (nth (- count 1) nvafter)) b))
                  break)
              (set count (+ count 1))
              (if (not more) break)
              (set g (coco_store_deref st (+ g 2)))))
          (return count)))

  ;;; THE FIRST GOAL'S WORDS, TURNED FOR THE REGISTERS. W[FROM..TO) is the
  ;;; goal as `cc_compile_goal' emitted it; RB receives the same goal with
  ;;; its own slots turned into registers and every other offset taken from
  ;;; the start of ONE reservation for what is left: the nested structures
  ;;; and the constants where the term had them, less the header and the
  ;;; slots, then a cell for each variable first met as an argument of the
  ;;; goal itself -- in the term, the slot was that variable. 0, and RB
  ;;; empty, when the goal is not a structure or has more arguments than
  ;;; the registers hold.
  (static)
  (func cc_reg_form ((coco_machine * m) (const u64 * w) (size_t from) (size_t to)
                     (coco_cbuf * rb) (u64 * rfid) (u32 * rarity)) (out int)
        (let ((u64 w0 . 0) (u64 fid . 0) (u32 n . 0) (size_t top . 0) (size_t rest . 0)
              (size_t fresh . 0) (size_t pc . 0) (int ok . 1))
          (if (>= from to) (return 0))
          (set w0 (nth from w))
          (if (!= (cc_op w0) (cc_GOAL_STRUCT)) (return 0))
          (set fid (nth (+ from 1) w))
          (set n ($ (nth (cast size_t fid) (-> m functors)) arity))
          (if (or (== n 0) (> n (coco_regs_max))) (return 0))
          (set top (+ (cast size_t n) 1))
          (set rest (- (cast size_t (cc_n w0)) top))
          ;; the goal's own variables met first here, each a cell of its own
          (set pc (+ from 2))
          (while (< pc to)
            (let ((u64 x . #'(nth pc w)) (u64 op . 0))
              (set op (cc_op x))
              (set pc (+ pc 1))
              (cond
                ((or (== op (cc_ARG_CONST)) (== op (cc_ARG_STRUCT))) (set pc (+ pc 1)))
                ((== op (cc_ARG_VAR_1))
                 (if (< (cast size_t (cc_n x)) top) (set fresh (+ fresh 1)))))))
          ;; the reservation, when there is anything to reserve: a goal whose
          ;; arguments are all variables met before -- `app(T, L, R)' --
          ;; is its RARG_VAR words and nothing else
          (if (> (+ rest fresh) 0)
              (if (not (cc_emit rb (cc_word (cc_RGOAL) (cast u64 n) (cast u64 (+ rest fresh))))) (set ok 0)))
          (set fresh 0)
          (set pc (+ from 2))
          (while (and ok (< pc to))
            (let ((u64 x . #'(nth pc w)) (u64 op . 0) (size_t k . 0) (size_t nn . 0))
              (set op (cc_op x))
              (set k (cc_k x))
              (set nn (cast size_t (cc_n x)))
              (set pc (+ pc 1))
              (cond
                ;; ARG_CONST and ARG_STRUCT: K the slot, N the cell
                ((or (== op (cc_ARG_CONST)) (== op (cc_ARG_STRUCT)))
                 (if (< k top)
                     (set ok (cc_emit rb (cc_word (? (== op (cc_ARG_CONST)) (cc_RARG_CONST) (cc_RARG_STRUCT))
                                                  (cast u64 (- k 1)) (cast u64 (- nn top)))))
                     (set ok (cc_emit rb (cc_word op (cast u64 (- k top)) (cast u64 (- nn top))))))
                 (if ok (set ok (cc_emit rb (nth pc w))))
                 (set pc (+ pc 1)))
                ;; ARG_VAR: K the frame index, N the slot
                ((== op (cc_ARG_VAR))
                 (if (< nn top)
                     (set ok (cc_emit rb (cc_word (cc_RARG_VAR) (cast u64 k) (cast u64 (- nn 1)))))
                     (set ok (cc_emit rb (cc_word op (cast u64 k) (cast u64 (- nn top)))))))
                ((== op (cc_ARG_VAR_1))
                 (if (< nn top)
                     (block
                      (set ok (cc_emit rb (cc_word (cc_RARG_VAR_1) (cast u64 k) (cast u64 (- nn 1)))))
                      (if ok (set ok (cc_emit rb (cast u64 (+ rest fresh)))))
                      (set fresh (+ fresh 1)))
                     (set ok (cc_emit rb (cc_word op (cast u64 k) (cast u64 (- nn top)))))))
                (#t (set ok 0)))))
          (if (not ok) (block (set (-> rb len) 0) (return 0)))
          (set (cof rfid) fid)
          (set (cof rarity) n)
          (return 1)))

  ;;; WHETHER THE REGISTERS PAY FOR A GOAL OF FUNCTOR FID: they do for a
  ;;; call the step can try from them, one with a single candidate, and
  ;;; cost a goal term built from them for any other. A predicate with two
  ;;; clauses or more whose first argument is a variable leaves two
  ;;; candidates for EVERY call, so its goal is built as the term it always
  ;;; was: queens' select/3 and safe/3 were 1.4 % dearer an inference with
  ;;; their calls in registers. Asked once, when the clause is compiled; a
  ;;; predicate the store does not have yet, or has not fetched, is given
  ;;; the benefit of the doubt, and one that changes after is only a
  ;;; little slower, never wrong.
  (static)
  (func cc_regs_worth ((coco_store * st) (coco_machine * m) (u64 fid)) (out int)
        (let ((coco_functor * f . #'(aof (nth (cast size_t fid) (-> m functors))))
              (size_t pi . #'(coco_pred_find st (-> f name) (-> f arity)))
              (size_t nv . 0))
          (if (>= pi (-> st npreds)) (return 1))
          (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
            (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
              (if (== (nth i (-> p keys)) 0)
                  (block (set nv (+ nv 1))
                         (if (>= nv 2) (return 0))))))
          (return 1)))

  ;;; ---- environments (Stage 5 of compiled control) --------------------------
  ;;;
  ;;; A BODY'S LATER GOALS WERE BUILT WHEN ITS CLAUSE WAS ENTERED: every goal
  ;;; after the first a term on the heap with a four-cell `'$k'' frame of its
  ;;; own, each taken apart again by a step of its own -- dereferenced, its
  ;;; name and its stamp asked, then called. A call among them is a term
  ;;; built only to be read back into arguments. Now a body with a call or a
  ;;; cut among its later goals writes ONE environment when it is entered:
  ;;; its code, the continuation it returns to, its goals' cut barrier, a
  ;;; slot for each variable a later call reads and one for each later goal
  ;;; that is still a term -- a builtin, a construct -- built at entry as it
  ;;; always was -- and a position cell per later goal. The continuation
  ;;; becomes the first position, and the step goes on from there
  ;;; (`coco_env_take' in solve.cicili): a call is written into the
  ;;; registers from the slots and tried as a first goal is, a cut cuts to
  ;;; the barrier, and a term is taken from its slot and dispatched as a
  ;;; frame's goal was. A continuation is still ONE cell wherever it is
  ;;; kept, and a step that pops a frame tests one tag, as before. The
  ;;; environment is an ordinary compound on the heap, so backtracking
  ;;; takes it with the rest and the collector moves it like any other --
  ;;; and keeps the whole of it from any of its positions (`coco_gc_mark');
  ;;; its code is an integer the collector does not follow. A frozen
  ;;; machine carries none: a freeze builds the goals the positions stand
  ;;; for (`coco_engine_materialize').

  ;;; ENVIRONMENTS ARE ON unless `COCOLOG_ENV' says 0 -- the stage's arm,
  ;;; and the switch the engine's cases run under to hold both forms of a
  ;;; body to one answer. Read at the first compile, so it costs a clause
  ;;; entry nothing.
  (static) (var int cc_env_state . 0)

  (static)
  (func cc_env_enabled () (out int)
        (if (== cc_env_state 0)
            (let ((const char * s . #'(getenv "COCOLOG_ENV")))
              (set cc_env_state (? (and (!= s nil) (== 0 (strcmp s "0"))) 2 1))))
        (return (? (== cc_env_state 1) 1 0)))

  ;;; THE BUILTINS IN PLACE (Stage 7) are on unless `COCOLOG_INPLACE' says
  ;;; 0, the stage's arm, read at the first compile as the one above is.
  (static) (var int cc_inplace_state . 0)

  (static)
  (func cc_inplace_enabled () (out int)
        (if (== cc_inplace_state 0)
            (let ((const char * s . #'(getenv "COCOLOG_INPLACE")))
              (set cc_inplace_state (? (and (!= s nil) (== 0 (strcmp s "0"))) 2 1))))
        (return (? (== cc_inplace_state 1) 1 0)))

  ;;; THE FUSED GUARD WORDS (AG_ISX, AG_CMPX) are on unless `COCOLOG_FUSE'
  ;;; says 0, their arm, read at the first compile as the two above are.
  (static) (var int cc_fuse_state . 0)

  (static)
  (func cc_fuse_enabled () (out int)
        (if (== cc_fuse_state 0)
            (let ((const char * s . #'(getenv "COCOLOG_FUSE")))
              (set cc_fuse_state (? (and (!= s nil) (== 0 (strcmp s "0"))) 2 1))))
        (return (? (== cc_fuse_state 1) 1 0)))

  ;;; WHETHER A LATER GOAL OF FUNCTOR FID IS REACHED AS A CALL: a predicate
  ;;; of the program's own -- not a construct's name, not a core builtin's
  ;;; -- of one to eight arguments, whose call the registers pay for
  ;;; (`cc_regs_worth'). Anything else is built at entry as it always was.
  ;;; A module's predicate cannot be told from here, and is built from the
  ;;; environment when it is reached (`coco_env_take').
  (static)
  (func cc_env_callable ((coco_store * st) (coco_machine * m) (u64 fid)) (out int)
        (let ((u64 name . #'($ (nth (cast size_t fid) (-> m functors)) name))
              (u32 arity . #'($ (nth (cast size_t fid) (-> m functors)) arity)))
          (if (or (== arity 0) (> arity (coco_regs_max))) (return 0))
          (if (not (-> m ids_ready)) (return 0))
          (if (coco_is_construct m name) (return 0))
          (if (>= (coco_builtin_index m name arity) 0) (return 0))
          (return (cc_regs_worth st m fid))))

  ;;; THE UNITS OF A BODY (Stages 5 and 6), compiled from the clause's own
  ;;; term in a second pass with a variable map of its own: the head again,
  ;;; then the body's goals in the order `cc_compile_body' took them, each
  ;;; goal depth first as `cc_compile_goal' walks one -- so every variable
  ;;; gets the frame index it got there, which the end of the pass checks.
  ;;; A unit is what one `'$k'' frame held through 1.9.2 (`coco_egoal'): a
  ;;; goal of the body after its first, or a construct's condition, branch,
  ;;; item or own `$cut', `$true' and `$fail'. A goal that is a term is
  ;;; built at entry by the entry program XBODY, in that order, its root
  ;;; kept in the environment's next term slot; a call's first-met
  ;;; variables are made there as FRESH words, and every variable it reads
  ;;; gets a slot. So every variable is made in the order the body made it,
  ;;; and nothing a construct writes around its goals -- the `;', the `->',
  ;;; the `,' -- is built at all. US holds the units from 1; XB, EB, GB, TB
  ;;; and RB the entry program, the calls' programs, one goal's words, one
  ;;; call's words over the slots and its register form, and QB a guard's
  ;;; program (Stage 7); EMAP and EINIT the variable slots (NEMAP the
  ;;; frame's size); the atoms the constructs are told by, and the
  ;;; functors a freeze builds two of them back with.
  (struct coco_ucomp
    (member coco_store * st)
    (member coco_machine * m)
    (member coco_varmap * vm)
    (member u32 nvars)
    (member coco_egoal * us)
    (member u32 nu)
    (member u32 ucap)
    (member coco_cbuf xb)
    (member coco_cbuf eb)
    (member coco_cbuf gb)
    (member coco_cbuf tb)
    (member coco_cbuf rb)
    (member coco_cbuf qb)
    (member u32 * emap)
    (member u32 * einit)
    (member u32 nemap)
    (member u32 nes)
    (member u32 nterm)
    (member u32 nslot)
    (member u32 ncons)
    (member u32 depth)
    (member int ok)
    (member u64 n_semi)
    (member u64 n_arrow)
    (member u64 n_soft)
    (member u64 n_neg)
    (member u64 n_not)
    (member u64 n_once)
    (member u64 n_ignore)
    (member u64 n_comma)
    (member u64 n_true)
    (member u64 n_fail)
    (member u64 n_false)
    (member u64 n_cut)
    (member u64 n_dtrue)
    (member u64 n_dfail)
    (member u64 f_cut)
    ;; the owner of a unit inside a structure `once/1' and its kin are
    ;; called with: `'<meta-call>'/1', SYS (3.1.0, `cc_ulink')
    (member u64 t_meta))

  ;;; A new unit of KIND, all else 0; 0 when the table would not grow.
  (static)
  (func cc_unew ((coco_ucomp * uc) (u32 kind)) (out u32)
        (if (>= (+ (-> uc nu) 1) (-> uc ucap))
            (let ((u32 ncap . #'(? (== (-> uc ucap) 0) 16 (* (-> uc ucap) 2)))
                  (void * nb . #'(realloc (cast (void *) (-> uc us)) (* (cast size_t ncap) (sizeof coco_egoal)))))
              (if (== nb nil) (block (set (-> uc ok) 0) (return 0)))
              (set (-> uc us) (cast (coco_egoal *) nb))
              (set (-> uc ucap) ncap)))
        (set (-> uc nu) (+ (-> uc nu) 1))
        (memset (cast (void *) (aof (nth (-> uc nu) (-> uc us)))) 0 (sizeof coco_egoal))
        (set ($ (nth (-> uc nu) (-> uc us)) kind) kind)
        (return (-> uc nu)))

  ;;; A construct's own `$true' or `$fail', which nothing wrote: ATOM is
  ;;; the one its frame held.
  (static)
  (func cc_usyn ((coco_ucomp * uc) (u32 kind) (u64 atom)) (out u32)
        (let ((u32 u . #'(cc_unew uc kind)))
          (if (!= u 0) (set ($ (nth u (-> uc us)) fid) atom))
          (return u)))

  ;;; A GOAL'S WORDS OVER THE ENVIRONMENT'S SLOTS (Stages 5 and 7): W[0,
  ;;; LEN), as `cc_compile_goal' emitted them, into TB with each variable an
  ;;; ARG_VAR of its slot -- every variable the goal has gets one -- and
  ;;; each it meets first made at entry, a FRESH word in the entry program.
  ;;; A call's are made in the order its words name them (Stage 5); BYCELL
  ;;; makes them in the order of the cells its term gave them (Stage 7), so
  ;;; that a builtin's variables stand where its term made them, in the
  ;;; order `compare/3' sees unbound variables in -- 64 of them at most: 0
  ;;; past that, with none made and OK still set.
  (static)
  (func cc_uslots ((coco_ucomp * uc) (const u64 * w) (size_t len) (int bycell)) (out int)
        (let ((size_t pc . 0) (u32 fk [64]) (u32 fn [64]) (u32 nf . 0))
          (set ($ (-> uc tb) len) 0)
          (while (and (-> uc ok) (< pc len))
            (let ((u64 x . #'(nth pc w)) (u64 op . 0))
              (set op (cc_op x))
              (set pc (+ pc 1))
              (if (or (== op (cc_ARG_VAR)) (== op (cc_ARG_VAR_1)))
                  (let ((size_t k . #'(cc_k x)))
                    (if (>= k (cast size_t (-> uc nemap)))
                        (block (set (-> uc ok) 0) (return 0)))
                    (if (== op (cc_ARG_VAR_1))
                        (if bycell
                            (block (if (>= nf 64) (return 0))
                                   (set (nth nf fk) (cast u32 k))
                                   (set (nth nf fn) (cast u32 (cc_n x)))
                                   (set nf (+ nf 1)))
                            (if (not (cc_emit (aof (-> uc xb)) (cc_word (cc_FRESH) (cast u64 k) 0)))
                                (set (-> uc ok) 0))))
                    (if (== (nth k (-> uc emap)) 0)
                        (block (set (nth (-> uc nes) (-> uc einit)) (cast u32 k))
                               (set (-> uc nes) (+ (-> uc nes) 1))
                               (set (nth k (-> uc emap)) (-> uc nes))))
                    (if (not (cc_emit (aof (-> uc tb)) (cc_word (cc_ARG_VAR)
                                                                (cast u64 (- (nth k (-> uc emap)) 1))
                                                                (cc_n x))))
                        (set (-> uc ok) 0)))
                  (block
                   (if (not (cc_emit (aof (-> uc tb)) x)) (set (-> uc ok) 0))
                   ;; and the functor or the constant after it
                   (if (or (== op (cc_GOAL_STRUCT)) (== op (cc_ARG_CONST)) (== op (cc_ARG_STRUCT)))
                       (block (if (not (cc_emit (aof (-> uc tb)) (nth pc w))) (set (-> uc ok) 0))
                              (set pc (+ pc 1))))))))
          ;; the ones met first, made in the order of their cells
          (while (and (-> uc ok) (> nf 0))
            (let ((u32 best . 0))
              (for ((u32 j . 1)) (< j nf) ((++ j))
                (if (< (nth j fn) (nth best fn)) (set best j)))
              (if (not (cc_emit (aof (-> uc xb)) (cc_word (cc_FRESH) (cast u64 (nth best fk)) 0)))
                  (set (-> uc ok) 0))
              (set nf (- nf 1))
              (set (nth best fk) (nth nf fk))
              (set (nth best fn) (nth nf fn))))
          (return (-> uc ok))))

  ;;; WHETHER A GOAL OF FUNCTOR FID IS A BUILTIN DONE IN PLACE (Stage 7),
  ;;; its words compiled with LIMIT variables met before it: a GUARD when
  ;;; `cc_guard_goal' takes it, its program left in QB over the frame's
  ;;; numbering; a SIDES for `=/2', `==/2' and `\==/2', FORM 0, 1 and 2; a
  ;;; BUILTIN for any other core builtin with arguments, FORM its row; and
  ;;; a TERM for anything else.
  (static)
  (func cc_uplace ((coco_ucomp * uc) (size_t t) (u64 fid) (u32 limit) (u32 * form)) (out u32)
        (let ((coco_machine * m . #'(-> uc m))
              (u64 name . #'($ (nth (cast size_t fid) (-> m functors)) name))
              (u32 arity . #'($ (nth (cast size_t fid) (-> m functors)) arity))
              (const char * s . nil) (int row . -1))
          (set ($ (-> uc qb) len) 0)
          (if (cc_guard_goal (-> uc st) m t (-> uc vm) limit (aof (-> uc qb)))
              (return (cc-eg "GUARD")))
          (set ($ (-> uc qb) len) 0)
          (if (or (== arity 0) (not (-> m ids_ready)) (coco_is_construct m name))
              (return (cc-eg "TERM")))
          (if (== arity 2)
              (block
               (set s (coco_atom_name m name))
               (if (== 0 (strcmp s "=")) (block (set (cof form) 0) (return (cc-eg "SIDES"))))
               (if (== 0 (strcmp s "==")) (block (set (cof form) 1) (return (cc-eg "SIDES"))))
               (if (== 0 (strcmp s CC_GN_NEQEQ)) (block (set (cof form) 2) (return (cc-eg "SIDES"))))))
          ;; the row the functor keeps, as the step reads it: none for a
          ;; name a program file took over (3.1.0, `coco_bix_fill')
          (let ((coco_functor * f . #'(aof (nth (cast size_t fid) (-> m functors)))))
            (if (== (-> f bix) 0) (set (-> f bix) (coco_bix_fill m (-> uc st) name arity)))
            (set row (- (cast int (-> f bix)) 2)))
          (if (< row 0) (return (cc-eg "TERM")))
          (set (cof form) (cast u32 row))
          (return (cc-eg "BUILTIN"))))

  ;;; ONE WORD FOR A GUARD OF TWO OPERANDS: QB as `X is A op B' over `+',
  ;;; `-' or `*' with X a variable -- [LOAD a | PUSH c] twice, [BIN op],
  ;;; [ISV x | ISF x] -- or as a comparison of two -- the two, [CMP c] -- is
  ;;; written into EB as AG_ISX or AG_CMPX, its K the slot of X, its N the
  ;;; operator's code with 256 for an A that is an integer and 512 for a B,
  ;;; then A and B: each its slot, or its cell. 1 when it took QB (with OK
  ;;; clear when a variable has no slot, as `cc_uguard' refuses it), 0 when
  ;;; QB is any other shape, nothing written. What the stack program
  ;;; dispatched as four words is then one, and its unit a GUARDX
  ;;; (`cc_uleaf', `coco_env_guardx').
  (static)
  (func cc_ufuse ((coco_ucomp * uc)) (out int)
        (let ((u64 * q . #'($ (-> uc qb) w)) (size_t qn . #'($ (-> uc qb) len)) (size_t pc . 0)
              (u64 opd [2]) (u64 fl . 0) (u64 op . 0) (u64 code . 0) (u64 xs . 0))
          (for ((u32 i . 0)) (< i 2) ((++ i))
            (if (>= pc qn) (return 0))
            (cond
              ((== (cc_op (nth pc q)) (cc_AG_LOAD))
               (set (nth i opd) (cast u64 (cc_k (nth pc q))))
               (set pc (+ pc 1)))
              ((and (== (cc_op (nth pc q)) (cc_AG_PUSH)) (< (+ pc 1) qn))
               (set (nth i opd) (nth (+ pc 1) q))
               (set fl (bitor fl (<< (cast u64 256) i)))
               (set pc (+ pc 2)))
              (#t (return 0))))
          (if (>= pc qn) (return 0))
          (set code (cast u64 (cc_k (nth pc q))))
          (cond
            ((and (== (cc_op (nth pc q)) (cc_AG_BIN))
                  (or (== code (cc-gop "+")) (== code (cc-gop "-")) (== code (cc-gop "*")))
                  (== (+ pc 2) qn)
                  (or (== (cc_op (nth (+ pc 1) q)) (cc_AG_ISV)) (== (cc_op (nth (+ pc 1) q)) (cc_AG_ISF))))
             (let ((size_t k . #'(cc_k (nth (+ pc 1) q))))
               (if (or (>= k (cast size_t (-> uc nemap))) (== (nth k (-> uc emap)) 0))
                   (block (set (-> uc ok) 0) (return 1)))
               (set xs (cast u64 (- (nth k (-> uc emap)) 1)))
               (set op (cc_AG_ISX))))
            ((and (== (cc_op (nth pc q)) (cc_AG_CMP)) (== (+ pc 1) qn))
             (set op (cc_AG_CMPX)))
            (#t (return 0)))
          ;; each variable its slot
          (for ((u32 i . 0)) (< i 2) ((++ i))
            (if (not (bitand fl (<< (cast u64 256) i)))
                (let ((size_t k . #'(cast size_t (nth i opd))))
                  (if (or (>= k (cast size_t (-> uc nemap))) (== (nth k (-> uc emap)) 0))
                      (block (set (-> uc ok) 0) (return 1)))
                  (set (nth i opd) (cast u64 (- (nth k (-> uc emap)) 1))))))
          (if (not (cc_emit (aof (-> uc eb)) (cc_word op xs (bitor code fl)))) (set (-> uc ok) 0))
          (if (not (cc_emit (aof (-> uc eb)) (nth 0 opd))) (set (-> uc ok) 0))
          (if (not (cc_emit (aof (-> uc eb)) (nth 1 opd))) (set (-> uc ok) 0))
          (return 1)))

  ;;; A GUARD'S PROGRAM OVER THE SLOTS (Stage 7): QB's words, numbered by
  ;;; the frame, into EB with each variable its slot -- every variable of
  ;;; the goal has one by now (`cc_uslots') -- and the left of an `is' met
  ;;; first here bound where the environment made it: AG_ISV, not AG_ISF.
  ;;; One word when it can be (`cc_ufuse'), under `COCOLOG_FUSE'.
  (static)
  (func cc_uguard ((coco_ucomp * uc)) (out int)
        (if (and (cc_fuse_enabled) (cc_ufuse uc)) (return (-> uc ok)))
        (let ((u64 * q . #'($ (-> uc qb) w)) (size_t qn . #'($ (-> uc qb) len)) (size_t pc . 0))
          (while (and (-> uc ok) (< pc qn))
            (let ((u64 x . #'(nth pc q)) (u64 op . 0))
              (set op (cc_op x))
              (set pc (+ pc 1))
              (cond
                ((or (== op (cc_AG_LOAD)) (== op (cc_AG_TYPE)) (== op (cc_AG_ISV)) (== op (cc_AG_ISF)))
                 (let ((size_t k . #'(cc_k x)))
                   (if (or (>= k (cast size_t (-> uc nemap))) (== (nth k (-> uc emap)) 0))
                       (block (set (-> uc ok) 0) (return 0)))
                   (if (not (cc_emit (aof (-> uc eb))
                                     (cc_word (? (== op (cc_AG_ISF)) (cc_AG_ISV) op)
                                              (cast u64 (- (nth k (-> uc emap)) 1)) (cc_n x))))
                       (set (-> uc ok) 0))))
                ((or (== op (cc_AG_PUSH)) (== op (cc_AG_ISC)))
                 (if (not (cc_emit (aof (-> uc eb)) x)) (set (-> uc ok) 0))
                 (if (not (cc_emit (aof (-> uc eb)) (nth pc q))) (set (-> uc ok) 0))
                 (set pc (+ pc 1)))
                (#t (if (not (cc_emit (aof (-> uc eb)) x)) (set (-> uc ok) 0))))))
          (return (-> uc ok))))

  ;;; A GOAL THAT IS NO CONSTRUCT: a CALL when its predicate is the
  ;;; program's own and the registers pay (`cc_env_callable'); a builtin
  ;;; done in place (Stage 7, `cc_uplace'): a GUARD or a SIDES over the
  ;;; slots, or a BUILTIN, a TERM its step calls by its row; a TERM built
  ;;; at entry otherwise.
  (static)
  (func cc_uleaf ((coco_ucomp * uc) (size_t t)) (out u32)
        (let ((coco_store * st . #'(-> uc st)) (coco_machine * m . #'(-> uc m))
              (u64 * w . nil) (size_t len . 0) (u32 u . 0)
              (u32 limit . #'(-> uc nvars)) (u32 kind . 0) (u32 form . 0))
          (set ($ (-> uc gb) len) 0)
          (if (not (cc_compile_goal st m t (-> uc vm) (aof (-> uc nvars)) (aof (-> uc gb))))
              (block (set (-> uc ok) 0) (return 0)))
          (set w ($ (-> uc gb) w))
          (set len ($ (-> uc gb) len))
          (set kind (cc-eg "TERM"))
          (if (== (cc_op (nth 0 w)) (cc_GOAL_STRUCT))
              (cond
                ((cc_env_callable st m (nth 1 w)) (set kind (cc-eg "CALL")))
                ((cc_inplace_enabled) (set kind (cc_uplace uc t (nth 1 w) limit (aof form))))))
          ;; a call, two sides or a guard: its words over the slots, its
          ;; first-met variables made at entry in its place -- in the order
          ;; its term made them, for the builtins; one with more of those
          ;; than that keeps track of is a term
          (if (and (or (== kind (cc-eg "CALL")) (== kind (cc-eg "SIDES")) (== kind (cc-eg "GUARD")))
                   (not (cc_uslots uc w len (!= kind (cc-eg "CALL")))))
              (block (if (not (-> uc ok)) (return 0))
                     (set kind (cc-eg "TERM"))))
          (if (or (== kind (cc-eg "CALL")) (== kind (cc-eg "SIDES")))
              (let ((u64 fid . 0) (u32 arity . 0))
                ;; and its register form, which `cc_env_callable' or the
                ;; arity has said there is: only memory makes this fail
                (set ($ (-> uc rb) len) 0)
                (if (not (and (-> uc ok)
                              (cc_reg_form m ($ (-> uc tb) w) 0 ($ (-> uc tb) len) (aof (-> uc rb))
                                           (aof fid) (aof arity))))
                    (block (set (-> uc ok) 0) (return 0)))
                (set u (cc_unew uc kind))
                (if (== u 0) (return 0))
                (set ($ (nth u (-> uc us)) fid) fid)
                (set ($ (nth u (-> uc us)) arity) arity)
                (set ($ (nth u (-> uc us)) form) form)
                (set ($ (nth u (-> uc us)) tat) (cast u32 ($ (-> uc eb) len)))
                (set ($ (nth u (-> uc us)) tlen) (cast u32 ($ (-> uc tb) len)))
                (for ((size_t j . 0)) (and (-> uc ok) (< j ($ (-> uc tb) len))) ((++ j))
                  (if (not (cc_emit (aof (-> uc eb)) (nth j ($ (-> uc tb) w)))) (set (-> uc ok) 0)))
                (set ($ (nth u (-> uc us)) rat) (cast u32 ($ (-> uc eb) len)))
                (set ($ (nth u (-> uc us)) rlen) (cast u32 ($ (-> uc rb) len)))
                (for ((size_t j . 0)) (and (-> uc ok) (< j ($ (-> uc rb) len))) ((++ j))
                  (if (not (cc_emit (aof (-> uc eb)) (nth j ($ (-> uc rb) w)))) (set (-> uc ok) 0)))
                (return u)))
          (if (== kind (cc-eg "GUARD"))
              (block
               (set u (cc_unew uc kind))
               (if (== u 0) (return 0))
               (set ($ (nth u (-> uc us)) fid) (nth 1 w))
               (set ($ (nth u (-> uc us)) arity) ($ (nth (cast size_t (nth 1 w)) (-> m functors)) arity))
               ;; its term over the slots, for when the program cannot decide
               (set ($ (nth u (-> uc us)) tat) (cast u32 ($ (-> uc eb) len)))
               (set ($ (nth u (-> uc us)) tlen) (cast u32 ($ (-> uc tb) len)))
               (for ((size_t j . 0)) (and (-> uc ok) (< j ($ (-> uc tb) len))) ((++ j))
                 (if (not (cc_emit (aof (-> uc eb)) (nth j ($ (-> uc tb) w)))) (set (-> uc ok) 0)))
               ;; and its program over them, a GUARDX when that is one
               ;; fused word
               (set ($ (nth u (-> uc us)) rat) (cast u32 ($ (-> uc eb) len)))
               (if (not (cc_uguard uc)) (return 0))
               (set ($ (nth u (-> uc us)) rlen) (- (cast u32 ($ (-> uc eb) len)) ($ (nth u (-> uc us)) rat)))
               (if (> ($ (nth u (-> uc us)) rlen) 0)
                   (let ((u64 x . #'(nth ($ (nth u (-> uc us)) rat) ($ (-> uc eb) w))))
                     (if (or (== (cc_op x) (cc_AG_ISX)) (== (cc_op x) (cc_AG_CMPX)))
                         (set ($ (nth u (-> uc us)) kind) (cc-eg "GUARDX")))))
               (return u)))
          ;; a term: built at entry over the frame, as before -- a BUILTIN
          ;; is one, called by its row
          (set u (cc_unew uc kind))
          (if (== u 0) (return 0))
          ;; a goal that is a variable of the clause is meta-called in it,
          ;; as swipl's call/1 (3.1.0, META; `cc_ulink' adds the owner)
          (if (coco-tag-is REF (nth (coco_store_deref st t) (-> st cells)))
              (set ($ (nth u (-> uc us)) tag) (coco-bar-metabit)))
          (set ($ (nth u (-> uc us)) form) form)
          (set ($ (nth u (-> uc us)) tslot) (-> uc nterm))
          (set (-> uc nterm) (+ (-> uc nterm) 1))
          (for ((size_t j . 0)) (and (-> uc ok) (< j len)) ((++ j))
            (if (not (cc_emit (aof (-> uc xb)) (nth j w))) (set (-> uc ok) 0)))
          (return u)))

  (static) (decl) (func cc_ubranch ((coco_ucomp * uc) (size_t t)) (out u32))

  ;;; WHETHER A STRUCTURE once/1, ignore/1 OR not/1 IS CALLED WITH HAS A
  ;;; GOAL THAT IS NO GOAL among its leaves (3.1.0): such a call stays a
  ;;; term, for the construct to raise type_error(callable, G) of the whole
  ;;; (`coco_goal_ok') where swipl's compile of G does, before any of it
  ;;; runs -- compiled in place, `once((fail, 1))' failed and raised
  ;;; nothing. A variable, an atom and a compound are goals.
  (static)
  (func cc_bad_leaf ((coco_ucomp * uc) (size_t t) (u32 depth)) (out int)
        (let ((coco_store * st . #'(-> uc st)) (coco_machine * m . #'(-> uc m)) (u64 c . 0))
          (while 1
            (set t (coco_store_deref st t))
            (set c (nth t (-> st cells)))
            (if (or (coco-tag-is REF c) (coco-tag-is ATOM c)) (return 0))
            (if (not (coco-tag-is FUN c)) (return 1))
            (if (> depth 64) (return 0))
            (let ((u64 nm . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) name))
                  (u32 ar . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity)))
              (cond
                ((and (== ar 2) (or (== nm (-> uc n_comma)) (== nm (-> uc n_semi))
                                    (== nm (-> uc n_arrow)) (== nm (-> uc n_soft))))
                 (if (cc_bad_leaf uc (+ t 1) (+ depth 1)) (return 1))
                 (set t (+ t 2)))
                ((and (== ar 1) (== nm (-> uc n_neg)))
                 (set t (+ t 1)))
                (#t (return 0)))))
          (return 0)))

  ;;; WHICH CONSTRUCT A GOAL IS, as a unit compiles it (Stage 6): 0 to 4
  ;;; the five forms of an if-then-else (`coco_egoal'), 9 a disjunction, -1
  ;;; none -- an `( C *-> T ; E )' among them, which stays a term, and a
  ;;; once/1, ignore/1 or not/1 of a structure with a goal that is no goal
  ;;; in it (`cc_bad_leaf'). CT, TT and ET are where its condition, then and
  ;;; else are, F2 the `->'.
  (static)
  (func cc_uform ((coco_ucomp * uc) (size_t t) (size_t * ct) (size_t * tt) (size_t * et)
                  (u64 * f2)) (out int)
        (let ((coco_store * st . #'(-> uc st)) (coco_machine * m . #'(-> uc m))
              (u64 c . #'(nth t (-> st cells))) (u64 nm . 0) (u32 ar . 0))
          (if (not (coco-tag-is FUN c)) (return -1))
          (set nm ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name))
          (set ar ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity))
          (if (and (== ar 2) (== nm (-> uc n_semi)))
              (let ((size_t l . #'(coco_store_deref st (+ t 1))) (u64 lc . 0))
                (set lc (nth l (-> st cells)))
                (if (and (coco-tag-is FUN lc)
                         (== ($ (nth (cast size_t (coco-payload lc)) (-> m functors)) arity) 2))
                    (let ((u64 ln . #'($ (nth (cast size_t (coco-payload lc)) (-> m functors)) name)))
                      (if (== ln (-> uc n_arrow))
                          (block (set (cof ct) (+ l 1)) (set (cof tt) (+ l 2)) (set (cof et) (+ t 2))
                                 (set (cof f2) (coco-payload lc))
                                 (return 0)))
                      (if (== ln (-> uc n_soft)) (return -1))))
                (set (cof ct) (+ t 1)) (set (cof tt) (+ t 2))
                (return 9)))
          (if (and (== ar 2) (== nm (-> uc n_arrow)))
              (block (set (cof ct) (+ t 1)) (set (cof tt) (+ t 2)) (return 1)))
          ;; not/1 or ignore/1 that a program file took over is a call of
          ;; the program's predicate (3.1.0, `coco_claim_kind')
          (if (and (== ar 1) (or (== nm (-> uc n_not)) (== nm (-> uc n_ignore)))
                   (!= (-> st ntaken) 0) (coco_pred_taken st nm 1))
              (return -1))
          (if (and (== ar 1) (or (== nm (-> uc n_not)) (== nm (-> uc n_once)) (== nm (-> uc n_ignore)))
                   (cc_bad_leaf uc (+ t 1) 0))
              (return -1))
          (if (and (== ar 1) (or (== nm (-> uc n_neg)) (== nm (-> uc n_not))))
              (block (set (cof ct) (+ t 1)) (return 2)))
          (if (and (== ar 1) (== nm (-> uc n_once)))
              (block (set (cof ct) (+ t 1)) (return 3)))
          (if (and (== ar 1) (== nm (-> uc n_ignore)))
              (block (set (cof ct) (+ t 1)) (return 4)))
          (return -1)))

  ;;; ONE UNIT: a cut, `true' or `fail'; a construct, its parts compiled in
  ;;; the order they were written; or a goal that is neither
  ;;; (`cc_uleaf'). Constructs nested past 64 stay terms.
  (static)
  (func cc_unit ((coco_ucomp * uc) (size_t t)) (out u32)
        (let ((coco_store * st . #'(-> uc st))
              (u64 c . 0) (u32 u . 0) (int form . -1)
              (size_t ct . 0) (size_t tt . 0) (size_t et . 0) (u64 f2 . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (if (coco-tag-is ATOM c)
              (let ((u64 a . #'(coco-payload c)) (u32 kind . 99))
                (cond ((== a (-> uc n_true)) (set kind (cc-eg "TRUE")))
                      ((or (== a (-> uc n_fail)) (== a (-> uc n_false))) (set kind (cc-eg "FAIL")))
                      ((== a (-> uc n_cut)) (set kind (cc-eg "CUT"))))
                (if (!= kind 99)
                    (block (set u (cc_usyn uc kind a))
                           (return u)))))
          (if (< (-> uc depth) 64) (set form (cc_uform uc t (aof ct) (aof tt) (aof et) (aof f2))))
          (if (== form 9)
              ;; ( C ; D )
              (block
               (set u (cc_unew uc (cc-eg "DISJ")))
               (if (== u 0) (return 0))
               (set ($ (nth u (-> uc us)) fid) (coco-payload c))
               (set (-> uc depth) (+ (-> uc depth) 1))
               (let ((u32 x . #'(cc_ubranch uc ct))) (set ($ (nth u (-> uc us)) a) x))
               (let ((u32 y . #'(cc_ubranch uc tt))) (set ($ (nth u (-> uc us)) b) y))
               (set (-> uc depth) (- (-> uc depth) 1))
               (set (-> uc ncons) (+ (-> uc ncons) 1))
               (return u)))
          (if (>= form 0)
              ;; an if-then-else, written one of five ways: its condition,
              ;; then its then and else -- written, or the `$true' and
              ;; `$fail' `coco_ite' gave the forms that write neither -- and
              ;; the cut after the condition
              (block
               (set u (cc_unew uc (cc-eg "ITE")))
               (if (== u 0) (return 0))
               (set ($ (nth u (-> uc us)) fid) (coco-payload c))
               (set ($ (nth u (-> uc us)) fid2) f2)
               (set ($ (nth u (-> uc us)) form) (cast u32 form))
               (set ($ (nth u (-> uc us)) tslot) (-> uc nslot))
               (set (-> uc nslot) (+ (-> uc nslot) 1))
               (set (-> uc depth) (+ (-> uc depth) 1))
               (let ((u32 x . #'(cc_ubranch uc ct))) (set ($ (nth u (-> uc us)) a) x))
               (if (<= form 1)
                   (let ((u32 y . #'(cc_ubranch uc tt))) (set ($ (nth u (-> uc us)) b) y))
                   (let ((u32 y . #'(cc_usyn uc (? (== form 2) (cc-eg "FAIL") (cc-eg "TRUE"))
                                               (? (== form 2) (-> uc n_dfail) (-> uc n_dtrue)))))
                     (set ($ (nth u (-> uc us)) b) y)))
               (if (== form 0)
                   (let ((u32 z . #'(cc_ubranch uc et))) (set ($ (nth u (-> uc us)) c) z))
                   (let ((int yes . #'(or (== form 2) (== form 4))))
                     (let ((u32 z . #'(cc_usyn uc (? yes (cc-eg "TRUE") (cc-eg "FAIL"))
                                               (? yes (-> uc n_dtrue) (-> uc n_dfail)))))
                       (set ($ (nth u (-> uc us)) c) z))))
               (let ((u32 d . #'(cc_usyn uc (cc-eg "CUTC") (-> uc f_cut))))
                 (if (!= d 0)
                     (block (set ($ (nth d (-> uc us)) tslot) ($ (nth u (-> uc us)) tslot))
                            (set ($ (nth u (-> uc us)) d) d))))
               (set (-> uc depth) (- (-> uc depth) 1))
               (set (-> uc ncons) (+ (-> uc ncons) 1))
               (return u)))
          (return (cc_uleaf uc t))))

  ;;; ONE FRAME'S WORTH: a `,' -- one step takes it apart into its items,
  ;;; up to 63 and the rest as one, as `coco_k_push_body' does -- or one
  ;;; unit.
  (static)
  (func cc_ubranch ((coco_ucomp * uc) (size_t t)) (out u32)
        (let ((coco_store * st . #'(-> uc st)) (coco_machine * m . #'(-> uc m))
              (u64 c . 0) (u32 u . 0) (u32 last . 0) (u32 n . 0) (size_t g . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (if (not (and (coco-tag-is FUN c) (< (-> uc depth) 64)
                        (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                        (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) (-> uc n_comma))))
              (return (cc_unit uc t)))
          (set u (cc_unew uc (cc-eg "CONJ")))
          (if (== u 0) (return 0))
          (set ($ (nth u (-> uc us)) fid) (coco-payload c))
          (set (-> uc depth) (+ (-> uc depth) 1))
          (set g t)
          (while (and (-> uc ok) (< n 63)
                      (coco-tag-is FUN (nth g (-> st cells)))
                      (== ($ (nth (cast size_t (coco-payload (nth g (-> st cells)))) (-> m functors)) arity) 2)
                      (== ($ (nth (cast size_t (coco-payload (nth g (-> st cells)))) (-> m functors)) name)
                          (-> uc n_comma)))
            (let ((u32 x . #'(cc_ubranch uc (+ g 1))))
              (if (== last 0) (set ($ (nth u (-> uc us)) a) x) (set ($ (nth last (-> uc us)) sib) x))
              (set last x)
              (set n (+ n 1))
              (set g (coco_store_deref st (+ g 2)))))
          ;; the last item, or everything that is left
          (let ((u32 x . #'(cc_ubranch uc g)))
            (if (== last 0) (set ($ (nth u (-> uc us)) a) x) (set ($ (nth last (-> uc us)) sib) x))
            (set n (+ n 1)))
          (set ($ (nth u (-> uc us)) arity) n)
          (set (-> uc depth) (- (-> uc depth) 1))
          (set (-> uc ncons) (+ (-> uc ncons) 1))
          (return u)))

  ;;; WHERE EACH UNIT GOES NEXT, AND WHICH BARRIER ITS GOALS CUT TO: AFTER
  ;;; and BCTX for U, and inside it what `coco_ite', a disjunction and
  ;;; `coco_k_push_body' gave each part -- a condition its own barrier (its
  ;;; slot's height, plus one) and the cut after it next; the then and the
  ;;; else, a disjunction's arms and a conjunction's items the barrier of
  ;;; the construct; each item the next item.
  ;;; AND WHOSE IT IS (3.1.0): OTAG, the owner its goal is handed over with
  ;;; (`tag', `coco-bar-pred'), kept with the META a variable goal has --
  ;;; the clause's predicate at the body's level and inside `\+', an
  ;;; if-then-else and a disjunction, which swipl compiles in the clause;
  ;;; `once/1', `ignore/1' or `not/1' for the goal one of those is called
  ;;; with and the cut after it, swipl's frames of their own; and
  ;;; `'<meta-call>'/1' for a structure one of those is called with, which
  ;;; swipl compiles into a clause of that name.
  (static)
  (func cc_ulink ((coco_ucomp * uc) (u32 u) (u32 after) (u32 bctx) (u64 otag))
        (let ((u32 kind . #'($ (nth u (-> uc us)) kind)))
          (set ($ (nth u (-> uc us)) next) after)
          (set ($ (nth u (-> uc us)) bslot) bctx)
          (set ($ (nth u (-> uc us)) tag)
               (bitor otag (bitand ($ (nth u (-> uc us)) tag) (coco-bar-metabit))))
          (cond
            ((== kind (cc-eg "CONJ"))
             (let ((u32 v . #'($ (nth u (-> uc us)) a)))
               (while (!= v 0)
                 (let ((u32 nx . #'($ (nth v (-> uc us)) sib)))
                   (cc_ulink uc v (? (!= nx 0) nx after) bctx otag)
                   (set v nx)))))
            ((== kind (cc-eg "ITE"))
             (let ((u32 cu . #'($ (nth u (-> uc us)) a)) (u32 tu . #'($ (nth u (-> uc us)) b))
                   (u32 eu . #'($ (nth u (-> uc us)) c)) (u32 du . #'($ (nth u (-> uc us)) d))
                   (u32 sl . #'($ (nth u (-> uc us)) tslot))
                   (u32 fm . #'($ (nth u (-> uc us)) form))
                   (u64 fid . #'($ (nth u (-> uc us)) fid))
                   (u64 stag . otag) (u64 ctag . otag))
               ;; once/1, ignore/1 and not/1 are swipl's frames
               (if (or (== fm 3) (== fm 4)
                       (and (== fm 2) (== ($ (nth (cast size_t fid) (-> (-> uc m) functors)) name)
                                          (-> uc n_not))))
                   (let ((u32 ck . #'($ (nth cu (-> uc us)) kind)))
                     (set stag (bitor (coco-bar-sysbit) (coco-bar-of fid)))
                     (set ctag (? (or (== ck (cc-eg "CONJ")) (== ck (cc-eg "ITE")) (== ck (cc-eg "DISJ")))
                                  (-> uc t_meta) stag))))
               (cc_ulink uc cu du (+ sl 1) ctag)
               (cc_ulink uc du tu bctx stag)
               (cc_ulink uc tu after bctx stag)
               (cc_ulink uc eu after bctx stag)))
            ((== kind (cc-eg "DISJ"))
             (cc_ulink uc ($ (nth u (-> uc us)) a) after bctx otag)
             (cc_ulink uc ($ (nth u (-> uc us)) b) after bctx otag)))))

  ;;; Whether a body's FIRST goal is a unit: a construct a unit compiles, or
  ;;; a `,'. Any other first goal is handed over as it always was.
  (static)
  (func cc_ufirst ((coco_ucomp * uc) (size_t t)) (out int)
        (let ((coco_store * st . #'(-> uc st)) (coco_machine * m . #'(-> uc m))
              (size_t ct . 0) (size_t tt . 0) (size_t et . 0) (u64 f2 . 0) (u64 c . 0))
          (set t (coco_store_deref st t))
          (set c (nth t (-> st cells)))
          (if (and (coco-tag-is FUN c)
                   (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                   (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) (-> uc n_comma)))
              (return 1))
          (return (? (>= (cc_uform uc t (aof ct) (aof tt) (aof et) (aof f2)) 0) 1 0))))

  ;;; WHETHER A BODY HAS A CONSTRUCT A UNIT COMPILES from goal NGD on -- an
  ;;; if-then-else in any of its forms, a disjunction, a `,' left over
  ;;; past 63 goals -- by name and arity alone, over the goals as
  ;;; `cc_compile_body' takes them. Asked before anything else, so a body
  ;;; without one compiles as it did through 1.9.2: the second pass for
  ;;; every body cost each clause compiled 9 000 instructions, and a
  ;;; program of fresh clauses each called once 60 % more. A yes is not
  ;;; the last word (an `*->' among the forms makes no environment).
  (static)
  (func cc_body_has_unit ((coco_ucomp * uc) (size_t body) (u32 ngd)) (out int)
        (let ((coco_store * st . #'(-> uc st)) (coco_machine * m . #'(-> uc m))
              (size_t g . #'(coco_store_deref st body)) (u32 count . 0) (int more . 1))
          (while more
            (let ((u64 c . #'(nth g (-> st cells))) (size_t goal . 0))
              (if (and (< count 63) (coco-tag-is FUN c)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) (-> uc n_comma)))
                  (block (set goal (+ g 1)) (set g (coco_store_deref st (+ g 2))))
                  (block (set goal g) (set more 0)))
              (if (>= count ngd)
                  (let ((u64 gc . #'(nth (coco_store_deref st goal) (-> st cells))))
                    (if (coco-tag-is FUN gc)
                        (let ((u64 nm . #'($ (nth (cast size_t (coco-payload gc)) (-> m functors)) name))
                              (u32 ar . #'($ (nth (cast size_t (coco-payload gc)) (-> m functors)) arity)))
                          (if (and (== ar 2) (or (== nm (-> uc n_semi)) (== nm (-> uc n_arrow))
                                                 (== nm (-> uc n_comma))))
                              (return 1))
                          (if (and (== ar 1) (or (== nm (-> uc n_neg)) (== nm (-> uc n_not))
                                                 (== nm (-> uc n_once)) (== nm (-> uc n_ignore))))
                              (return 1))))))
              (set count (+ count 1))))
          (return 0)))

  ;;; THE ENVIRONMENT OF A BODY, its units compiled as above. A body makes
  ;;; one when it has a construct -- an if-then-else, a disjunction, a `,'
  ;;; inside either -- whose term, frames and taking apart the units save.
  ;;; One without makes none: its later goals reached from an environment
  ;;; cost what their terms and frames did (Stage 5 alone, measured on the
  ;;; linter at -0.19 % to +0.09 %, and 1.2 % more on queens, whose calls
  ;;; leave choices). HEAD and BODY are the clause's. The units start at
  ;;; the body's first goal that is not a guard (`ngd', which CD has by
  ;;; now): the guards before it, and that goal when it is handed over, are
  ;;; numbered and nothing more.
  ;;; Answers 0 when memory ran short, with CD unchanged -- and 1, with CD
  ;;; unchanged too, when the body makes none, when it holds more terms
  ;;; than an entry keeps roots for, or when the numbering came out other
  ;;; than the body's own, which would be a bug and builds no environment.
  (static)
  (func cc_compile_env ((coco_store * st) (coco_machine * m) (coco_code * cd)
                        (size_t head) (size_t body)) (out int)
        (let ((coco_varmap vm . '{ nil nil 0 0 0 })
              (coco_ucomp uc)
              (coco_cbuf hb . '{ nil 0 0 })
              (u32 bus [64]) (u32 nb . 0) (u32 ehand . 1) (u32 count . 0) (int more . 1)
              (u32 ngd . #'(-> cd ngd)) (size_t g . 0) (u64 comma . 0))
          (memset (cast (void *) (aof uc)) 0 (sizeof coco_ucomp))
          (set ($ uc st) st)
          (set ($ uc m) m)
          (set ($ uc vm) (aof vm))
          (set ($ uc ok) 1)
          ;; the names a construct is told by: the machine's own, or
          ;; interned here when it has none yet
          (let ((u64 nm [14]) (u64 fc . 0))
            (if (not (coco_unit_names m nm (aof fc)))
                (block (set (nth 0 nm) (coco_intern m ";"))
                       (set (nth 1 nm) (coco_intern m "->"))
                       (set (nth 2 nm) (coco_intern m "*->"))
                       (set (nth 3 nm) (coco_intern m "\\+"))
                       (set (nth 4 nm) (coco_intern m "not"))
                       (set (nth 5 nm) (coco_intern m "once"))
                       (set (nth 6 nm) (coco_intern m "ignore"))
                       (set (nth 7 nm) (coco_intern m ","))
                       (set (nth 8 nm) (coco_intern m "true"))
                       (set (nth 9 nm) (coco_intern m "fail"))
                       (set (nth 10 nm) (coco_intern m "false"))
                       (set (nth 11 nm) (coco_intern m "!"))
                       (set (nth 12 nm) (coco_intern m "$true"))
                       (set (nth 13 nm) (coco_intern m "$fail"))
                       (set fc (coco_functor_id m (coco_intern m "$cut") 1))))
            (set ($ uc n_semi) (nth 0 nm))
            (set ($ uc n_arrow) (nth 1 nm))
            (set ($ uc n_soft) (nth 2 nm))
            (set ($ uc n_neg) (nth 3 nm))
            (set ($ uc n_not) (nth 4 nm))
            (set ($ uc n_once) (nth 5 nm))
            (set ($ uc n_ignore) (nth 6 nm))
            (set ($ uc n_comma) (nth 7 nm))
            (set ($ uc n_true) (nth 8 nm))
            (set ($ uc n_fail) (nth 9 nm))
            (set ($ uc n_false) (nth 10 nm))
            (set ($ uc n_cut) (nth 11 nm))
            (set ($ uc n_dtrue) (nth 12 nm))
            (set ($ uc n_dfail) (nth 13 nm))
            (set ($ uc f_cut) fc))
          (set comma ($ uc n_comma))
          ;; a body with no construct after its guards makes none, and is
          ;; not compiled again to find that out (`cc_body_has_unit')
          (if (not (cc_body_has_unit (aof uc) body ngd)) (return 1))
          (set ($ uc nemap) (+ (-> cd nvars) 1))
          (set ($ uc emap) (cast (u32 *) (calloc (cast size_t ($ uc nemap)) (sizeof u32))))
          (set ($ uc einit) (cast (u32 *) (calloc (cast size_t ($ uc nemap)) (sizeof u32))))
          (if (or (== ($ uc emap) nil) (== ($ uc einit) nil) (-> m oom)) (set ($ uc ok) 0))
          (coco_varmap_take m (aof vm))
          ;; the head again, for its numbering
          (if (and ($ uc ok) (not (cc_compile_head st m head (aof vm) (aof ($ uc nvars)) (aof hb))))
              (set ($ uc ok) 0))
          (free ($ hb w))
          ;; the body's goals as `cc_compile_body' takes them: up to 63, and
          ;; what is left as one
          (set g (coco_store_deref st body))
          (while (and ($ uc ok) more)
            (let ((u64 c . #'(nth g (-> st cells))) (size_t goal . 0))
              (if (and (< count 63) (coco-tag-is FUN c)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) 2)
                       (== ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name) comma))
                  (block (set goal (+ g 1)) (set g (coco_store_deref st (+ g 2))))
                  (block (set goal g) (set more 0)))
              (if (or (< count ngd) (and (== count ngd) (not (cc_ufirst (aof uc) goal))))
                  ;; a guard, or the first goal after the guards when it is
                  ;; handed over: its numbering only
                  (block (set ($ ($ uc gb) len) 0)
                         (if (not (cc_compile_goal st m goal (aof vm) (aof ($ uc nvars)) (aof ($ uc gb))))
                             (set ($ uc ok) 0)))
                  (block (if (== count ngd) (set ehand 0))
                         (set (nth nb bus) (cc_ubranch (aof uc) goal))
                         (set nb (+ nb 1))))
              (set count (+ count 1))))
          (coco_varmap_give m (aof vm))
          ;; where each body-level unit goes next: the one after it, and
          ;; the body's end; each cuts to the environment's barrier, and is
          ;; the clause's (3.1.0)
          (if ($ uc ok)
              (block
               (set ($ uc t_meta) (bitor (coco-bar-sysbit)
                                         (coco-bar-of (coco_functor_id m (coco_intern m "<meta-call>") 1))))
               (for ((u32 i . 0)) (< i nb) ((++ i))
                 (cc_ulink (aof uc) (nth i bus) (? (< (+ i 1) nb) (nth (+ i 1) bus) 0) 0
                           (-> cd ptag)))))
          (free ($ ($ uc gb) w)) (free ($ ($ uc tb) w)) (free ($ ($ uc rb) w)) (free ($ ($ uc qb) w))
          (free ($ uc emap))
          (if (or (not ($ uc ok)) (== ($ uc ncons) 0) (== nb 0) (> ($ uc nterm) 64)
                  (!= ($ uc nvars) (-> cd nvars)))
              (let ((int oom . #'(not ($ uc ok))))
                (free ($ uc einit)) (free (cast (void *) ($ uc us)))
                (free ($ ($ uc eb) w)) (free ($ ($ uc xb) w))
                (return (? oom 0 1))))
          ;; what taking each unit reads, as offsets from the header
          ;; (`coco_egoal'): position U is PB + U, condition slot S is SB + S
          (let ((u32 pb . #'(+ (+ (+ ($ uc nes) ($ uc nterm)) ($ uc nslot)) 3))
                (u32 sb . #'(+ (+ ($ uc nes) ($ uc nterm)) 4)))
            (for ((u32 i . 1)) (<= i ($ uc nu)) ((++ i))
              (let ((coco_egoal * x . #'(aof (nth i ($ uc us)))))
                (set (-> x noff) (? (== (-> x next) 0) 2 (+ pb (-> x next))))
                (set (-> x boff) (? (== (-> x bslot) 0) 3 (+ sb (- (-> x bslot) 1))))
                (set (-> x badd) (? (== (-> x bslot) 0) 0 1))
                (cond
                  ((or (== (-> x kind) (cc-eg "TERM")) (== (-> x kind) (cc-eg "BUILTIN")))
                   (set (-> x soff) (+ (+ ($ uc nes) (-> x tslot)) 4)))
                  ((or (== (-> x kind) (cc-eg "ITE")) (== (-> x kind) (cc-eg "CUTC")))
                   (set (-> x soff) (+ sb (-> x tslot)))))
                (if (!= (-> x a) 0) (set (-> x aoff) (+ pb (-> x a))))
                (cond
                  ((== (-> x kind) (cc-eg "ITE")) (set (-> x coff) (+ pb (-> x c))))
                  ((== (-> x kind) (cc-eg "DISJ")) (set (-> x coff) (+ pb (-> x b)))))
                (if (or (== (-> x kind) (cc-eg "CALL")) (== (-> x kind) (cc-eg "SIDES")))
                    (let ((u32 all . 1))
                      (for ((u32 j . 0)) (< j (-> x rlen)) ((++ j))
                        (if (!= (cc_op (nth (+ (-> x rat) j) ($ ($ uc eb) w))) (cc_RARG_VAR))
                            (set all 0)))
                      (set (-> x rvars) all))))))
          ;; the entry's alike tail (`etmpl'): the condition slots and the
          ;; positions, which begin at PB + 1
          (let ((size_t nsl . #'(cast size_t ($ uc nslot)))
                (size_t nu . #'(cast size_t ($ uc nu)))
                (size_t ps . #'(cast size_t (+ (+ (+ ($ uc nes) ($ uc nterm)) ($ uc nslot)) 4)))
                (u64 * t . nil))
            (set t (cast (u64 *) (malloc (* (+ nsl nu) (sizeof u64)))))
            (if (== t nil)
                (block (free ($ uc einit)) (free (cast (void *) ($ uc us)))
                       (free ($ ($ uc eb) w)) (free ($ ($ uc xb) w))
                       (return 0)))
            (for ((size_t s . 0)) (< s nsl) ((++ s))
              (set (nth s t) (coco-int-cell 0)))
            (for ((size_t s . 0)) (< s nu) ((++ s))
              (set (nth (+ nsl s) t) (coco-cell POS (bitor (<< (+ ps s) 16) (+ s 1)))))
            (set (-> cd etmpl) t))
          (set (-> cd nes) ($ uc nes))
          (set (-> cd nterm) ($ uc nterm))
          (set (-> cd nslot) ($ uc nslot))
          (set (-> cd nunit) ($ uc nu))
          (set (-> cd eu0) (nth 0 bus))
          (set (-> cd ehand) ehand)
          (set (-> cd einit) ($ uc einit))
          (set (-> cd egoals) ($ uc us))
          (set (-> cd ebody) ($ ($ uc eb) w))
          (set (-> cd eblen) ($ ($ uc eb) len))
          (set (-> cd xbody) ($ ($ uc xb) w))
          (set (-> cd xblen) ($ ($ uc xb) len))
          ;; code, parent, barrier, the slots, and a position per unit
          (set (-> cd efid) (coco_functor_id m (coco_intern m "$e")
                                             (+ (+ (+ (+ ($ uc nes) ($ uc nterm)) ($ uc nslot)) ($ uc nu)) 3)))
          (set (-> cd env) 1)
          (return 1)))

  (static)
  (func coco_code_free ((coco_code * cd))
        (if (== cd nil) (return))
        (free (-> cd head))
        (free (-> cd body))
        (free (-> cd rbody))
        (free (-> cd gbody))
        (free (-> cd einit))
        (free (cast (void *) (-> cd egoals)))
        (free (-> cd ebody))
        (free (-> cd xbody))
        (free (-> cd etmpl))
        (free cd))

  (func coco_code_table_clear ((coco_store * st))
        (for ((size_t i . 0)) (< i (-> st code_cap)) ((++ i))
          (if (!= (nth i (-> st code_keys)) 0)
              (block (coco_code_free (cast (coco_code *) (nth i (-> st code_vals))))
                     (set (nth i (-> st code_keys)) 0)
                     (set (nth i (-> st code_vals)) nil))))
        (set (-> st code_len) 0))

  (static)
  (func coco_code_slot ((size_t cap) (size_t key)) (out size_t)
        (let ((u64 h . #'(* (cast u64 key) (cast u64 0x9E3779B97F4A7C15))))
          (set h (xor h (>> h 32)))
          (set h (xor h (>> h 16)))
          (return (cast size_t (bitand h (cast u64 (- cap 1)))))))

  (static)
  (func coco_code_find ((coco_store * st) (size_t clause)) (out coco_code *)
        (if (== (-> st code_cap) 0) (return nil))
        (let ((size_t mask . #'(- (-> st code_cap) 1))
              (size_t i . #'(coco_code_slot (-> st code_cap) (+ clause 1))))
          (while (!= (nth i (-> st code_keys)) 0)
            (if (== (nth i (-> st code_keys)) (+ clause 1))
                (return (cast (coco_code *) (nth i (-> st code_vals)))))
            (set i (bitand (+ i 1) mask)))
          (return nil)))

  (static)
  (func coco_code_put ((coco_store * st) (size_t clause) (coco_code * cd)) (out int)
        ;; under half full before the probe that places it
        (if (> (* (+ (-> st code_len) 1) 2) (-> st code_cap))
            (let ((size_t ncap . #'(? (== (-> st code_cap) 0) 256 (* (-> st code_cap) 2)))
                  (size_t * nk . #'(cast (size_t *) (calloc ncap (sizeof size_t))))
                  (void ** nv . #'(cast (void **) (calloc ncap (sizeof size_t)))))
              (if (or (== nk nil) (== nv nil)) (block (free nk) (free nv) (return 0)))
              (for ((size_t i . 0)) (< i (-> st code_cap)) ((++ i))
                (let ((size_t key . #'(nth i (-> st code_keys))))
                  (if (!= key 0)
                      (let ((size_t j . #'(coco_code_slot ncap key)))
                        (while (!= (nth j nk) 0) (set j (bitand (+ j 1) (- ncap 1))))
                        (set (nth j nk) key)
                        (set (nth j nv) (nth i (-> st code_vals)))))))
              (free (-> st code_keys)) (free (-> st code_vals))
              (set (-> st code_keys) nk) (set (-> st code_vals) nv) (set (-> st code_cap) ncap)))
        (let ((size_t mask . #'(- (-> st code_cap) 1))
              (size_t i . #'(coco_code_slot (-> st code_cap) (+ clause 1))))
          (while (!= (nth i (-> st code_keys)) 0) (set i (bitand (+ i 1) mask)))
          (set (nth i (-> st code_keys)) (+ clause 1))
          (set (nth i (-> st code_vals)) (cast (void *) cd))
          (set (-> st code_len) (+ (-> st code_len) 1))
          (return 1)))

  ;;; A DEAD CLAUSE'S CODE THAT AN ENVIRONMENT HAS NAMED IS RETIRED, NOT
  ;;; FREED (Stage 5): an environment on the heap may be part way through
  ;;; that very body -- a clause retracted while it runs keeps running the
  ;;; code it was entered with, which is the logical update view the copy
  ;;; of the body gave before -- and reads its code at every goal. Kept on
  ;;; the store's retired list until a heap collection finds no environment
  ;;; naming it (`coco_code_sweep'), a query starts with nothing running
  ;;; (`coco_code_retired_free'), or the store is freed. A code no
  ;;; environment ever named -- a fact, a body of one goal, a clause never
  ;;; entered since it was compiled -- is freed at once as before.
  (static)
  (func coco_code_retire ((coco_store * st) (coco_code * cd))
        (if (== cd nil) (return))
        (if (not (-> cd envd)) (block (coco_code_free cd) (return)))
        (set (-> cd rnext) (-> st retired))
        (set (-> st retired) (cast (void *) cd))
        (set (-> st nretired) (+ (-> st nretired) 1)))

  (func coco_code_sweep ((coco_store * st) (u64 epoch))
        (let ((coco_code * cd . #'(cast (coco_code *) (-> st retired)))
              (coco_code * keep . nil) (size_t n . 0))
          (while (!= cd nil)
            (let ((coco_code * next . #'(cast (coco_code *) (-> cd rnext))))
              (if (== (-> cd gcmark) epoch)
                  (block (set (-> cd rnext) (cast (void *) keep))
                         (set keep cd)
                         (set n (+ n 1)))
                  (coco_code_free cd))
              (set cd next)))
          (set (-> st retired) (cast (void *) keep))
          (set (-> st nretired) n)))

  (func coco_code_retired_free ((coco_store * st))
        (let ((coco_code * cd . #'(cast (coco_code *) (-> st retired))))
          (while (!= cd nil)
            (let ((coco_code * next . #'(cast (coco_code *) (-> cd rnext))))
              (coco_code_free cd)
              (set cd next)))
          (set (-> st retired) nil)
          (set (-> st nretired) 0)))

  ;;; A CLAUSE THAT DIES TAKES ITS PROGRAM WITH IT -- a retract, a reconsult
  ;;; -- or the table keeps every dead clause's code until the next
  ;;; compaction, which counts store cells and not this: a million
  ;;; retract-and-assert cycles held 298 MB where 1.8.41 held 70 (1.8.45).
  ;;; A hole in a linear-probed table is filled by shifting back each later
  ;;; entry of its run whose home slot does not lie between the two. A code
  ;;; an environment named goes to the retired list instead
  ;;; (`coco_code_retire').
  (func coco_code_drop ((coco_store * st) (size_t clause))
        (if (== (-> st code_len) 0) (return))
        (let ((size_t mask . #'(- (-> st code_cap) 1))
              (size_t i . #'(coco_code_slot (-> st code_cap) (+ clause 1)))
              (size_t j . 0) (size_t h . 0))
          (while (!= (nth i (-> st code_keys)) (+ clause 1))
            (if (== (nth i (-> st code_keys)) 0) (return))
            (set i (bitand (+ i 1) mask)))
          (coco_code_retire st (cast (coco_code *) (nth i (-> st code_vals))))
          (set (-> st code_len) (- (-> st code_len) 1))
          (set j i)
          (while 1
            (set j (bitand (+ j 1) mask))
            (if (== (nth j (-> st code_keys)) 0) break)
            (set h (coco_code_slot (-> st code_cap) (nth j (-> st code_keys))))
            ;; home h cyclically in (i, j]: the entry is where it belongs
            (if (? (<= i j) (and (< i h) (<= h j)) (or (< i h) (<= h j)))
                continue)
            (set (nth i (-> st code_keys)) (nth j (-> st code_keys)))
            (set (nth i (-> st code_vals)) (nth j (-> st code_vals)))
            (set i j))
          (set (nth i (-> st code_keys)) 0)
          (set (nth i (-> st code_vals)) nil)))

  ;;; EVERY CLAUSE'S PROGRAM DROPPED, each compiled again at its next
  ;;; selection (3.1.0): a program file took not/1 or ignore/1 over
  ;;; (`coco_pred_take_over'), which a body compiled before runs as the
  ;;; construct, in place. A code the table no longer keys -- held by its
  ;;; predicate's slot alone, after a table that would not grow -- is
  ;;; retired from the slot; each of the rest from the table, as a dead
  ;;; clause's is (`coco_code_retire': an environment may be part way
  ;;; through it).
  (func coco_code_forget_all ((coco_store * st))
        (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
          (let ((coco_pred * p . #'(aof (nth i (-> st preds)))))
            (if (!= (-> p codes) nil)
                (for ((size_t j . 0)) (< j (-> p nclauses)) ((++ j))
                  (let ((coco_code * cd . #'(cast (coco_code *) (nth j (-> p codes)))))
                    (if (!= cd nil)
                        (block
                          (if (!= (coco_code_find st (nth j (-> p clauses))) cd)
                              (coco_code_retire st cd))
                          (set (nth j (-> p codes)) nil))))))))
        (for ((size_t i . 0)) (< i (-> st code_cap)) ((++ i))
          (if (!= (nth i (-> st code_keys)) 0)
              (block (coco_code_retire st (cast (coco_code *) (nth i (-> st code_vals))))
                     (set (nth i (-> st code_keys)) 0)
                     (set (nth i (-> st code_vals)) nil))))
        (set (-> st code_len) 0))

  ;;; THE OWNER A CLAUSE'S BODY GOALS CARRY (3.1.0, `coco-bar-of'): the
  ;;; functor of HEAD, a store cell, or of an atom's name and no arguments;
  ;;; 0 for anything else, and past what the tag's 25 bits hold
  (func coco_head_tag ((coco_store * st) (coco_machine * m) (size_t head)) (out u64)
        (let ((u64 hc . #'(nth (coco_store_deref st head) (-> st cells))) (u64 pf . 0))
          (cond ((coco-tag-is FUN hc) (set pf (cast u64 (coco-payload hc))))
                ((coco-tag-is ATOM hc) (set pf (coco_functor_id m (cast u64 (coco-payload hc)) 0)))
                (#t (return 0)))
          (if (>= (+ pf 1) 33554431) (return 0))
          (return (coco-bar-of pf))))

  (func coco_clause_code ((coco_store * st) (coco_machine * m) (size_t clause)) (out coco_code *)
        (let ((coco_code * cd . #'(coco_code_find st clause)))
          (if (!= cd nil) (return cd))
          ;; THE FIRST COMPILE (2.9.0) changes the one store's code table.
          (with-green-write nil
          ;; THE FIND AGAIN UNDER THE BARRIER: the find above is lock-free,
          ;; and a task on another worker may have compiled this clause
          ;; between it and this barrier. Its program is the one the
          ;; predicate already holds; compile nothing and use it.
          (let ((coco_code * cd2 . #'(coco_code_find st clause)))
            (if (!= cd2 nil) (return cd2)))
          (let ((coco_varmap vm . '{ nil nil 0 0 0 })
                (coco_cbuf hb . '{ nil 0 0 }) (coco_cbuf bb . '{ nil 0 0 })
                (coco_cbuf rb . '{ nil 0 0 }) (coco_cbuf gb . '{ nil 0 0 })
                (size_t head . 0) (size_t body . 0) (u32 nvars . 0) (u32 ngoals . 0)
                (u32 nvhead . 0) (u32 starts [64]) (u32 nvafter [64]) (u32 ngd . 0)
                (size_t rstart . 0) (u64 rfid . 0) (u32 rarity . 0)
                (int ok . 1))
            (coco_store_clause_parts st m clause (coco_intern m ":-") (aof head) (aof body))
            (set head (coco_store_deref st head))
            ;; a head is an atom or a compound; anything else is not compiled
            (if (not (or (coco-tag-is ATOM (nth head (-> st cells)))
                         (coco-tag-is FUN (nth head (-> st cells)))))
                (return nil))
            (coco_varmap_take m (aof vm))
            (if (not (cc_compile_head st m head (aof vm) (aof nvars) (aof hb))) (set ok 0))
            (set nvhead nvars)
            (if (and ok (!= body 0))
                (if (not (cc_compile_body st m body (aof vm) (aof nvars) (aof bb) (aof ngoals)
                                          starts nvafter))
                    (set ok 0)))
            ;; the guards the body starts with (Stage 4), over the numbering
            ;; the body made: a goal is one only when everything it reads was
            ;; met before it
            (if (and ok (!= body 0))
                (set ngd (cc_compile_guards st m body (aof vm) nvhead nvafter ngoals (aof gb))))
            ;; the first goal that is not a guard, for the registers, when it
            ;; can go there and it pays (`cc_regs_worth'); a goal that cannot
            ;; keeps only its term form, which is no loss
            (if (and ok (!= body 0) (< ngd ngoals))
                (block
                 (set rstart (? (< (+ ngd 1) ngoals) (cast size_t (nth (+ ngd 1) starts)) ($ bb len)))
                 (if (not (and (cc_reg_form m ($ bb w) (cast size_t (nth ngd starts)) rstart
                                            (aof rb) (aof rfid) (aof rarity))
                               (cc_regs_worth st m rfid)))
                     (block (free ($ rb w)) (set ($ rb w) nil) (set ($ rb len) 0)))))
            ;; a frame index is K's twenty-four bits; a clause with more
            ;; variables and temporaries than that is matched and copied
            (if (> nvars 16777215) (set ok 0))
            (coco_varmap_give m (aof vm))
            (if (not ok)
                (block (free ($ hb w)) (free ($ bb w)) (free ($ rb w)) (free ($ gb w)) (return nil)))
            (set cd (cast (coco_code *) (calloc 1 (sizeof coco_code))))
            (if (== cd nil)
                (block (free ($ hb w)) (free ($ bb w)) (free ($ rb w)) (free ($ gb w)) (return nil)))
            (set (-> cd head) ($ hb w)) (set (-> cd hlen) ($ hb len))
            (set (-> cd body) ($ bb w)) (set (-> cd blen) ($ bb len))
            (set (-> cd nvars) nvars)
            (set (-> cd ngoals) ngoals)
            (set (-> cd rbody) ($ rb w)) (set (-> cd rblen) ($ rb len))
            (set (-> cd rstart) rstart)
            (set (-> cd rfid) rfid)
            (set (-> cd rarity) rarity)
            (set (-> cd gbody) ($ gb w)) (set (-> cd gblen) ($ gb len))
            (set (-> cd ngd) ngd)
            ;; where the body is built from after I guards: goal I's words,
            ;; or the end when every goal was a guard
            (for ((u32 i . 0)) (<= i ngd) ((++ i))
              (set (nth i (-> cd gstart)) (? (< i ngoals) (nth i starts) (cast u32 ($ bb len)))))
            ;; THE ENVIRONMENT (Stages 5 and 6), for a body with a construct
            ;; after its guards (`cc_compile_env' decides). A body with
            ;; guards and an environment has an executor of its own, with a
            ;; runner of its own for them (`coco_clause_run_ge'): asking the
            ;; guards' executor for an environment too cost the counting
            ;; loop 8 instructions a turn. A body an environment could not
            ;; be had for -- memory -- keeps the form it had, which is no loss
            ;; the predicate it is a clause of, for what its body's errors
            ;; name (3.1.0, `coco-bar-pred'): the head's functor, or the
            ;; functor of an atom's name and no arguments -- before the
            ;; environment, whose units are its too
            (set (-> cd ptag) (coco_head_tag st m head))
            (if (and (cc_env_enabled) (!= body 0))
                (cc_compile_env st m cd head body))
            ;; and whether entering it takes more than the plain executor
            (set (-> cd ex) (+ (? (> ngd 0) 1 0) (? (!= (-> cd env) 0) 2 0)))
            (if (not (coco_code_put st clause cd))
                (block (coco_code_free cd) (return nil)))
            (return cd)))))

  ;;; A constant against a dereferenced heap cell: bound to a copy when the
  ;;; cell is unbound, else the same comparison `coco_unify' makes.
  (static)
  (func cc_match_const ((coco_machine * m) (size_t a) (u64 c)) (out int)
        (let ((u64 ca . #'(nth a (-> m heap))))
          (if (coco-tag-is REF ca)
              (block (coco_bind m a (coco_push m c)) (return 1)))
          ;; the same word is the same constant, whatever its tag: the
          ;; common match decided before the tables are asked (2.0.0)
          (if (== ca c) (return 1))
          (if (!= (coco-tag ca) (coco-tag c)) (return 0))
          (cond
            ((coco-tag-is FLT ca) (return (coco_flt_eq m ca c)))
            ((coco-tag-is STR ca) (return (coco_str_eq m ca c)))
            ;; a rational is its reduced pair (2.5.0)
            ((coco-tag-is RAT ca)
             (return (? (and (coco-tag-is RAT c) (coco_rat_eq m ca c)) 1 0)))
            ;; a boxed integer by its value, as a float is (2.0.0)
            ((coco-tag-is BIG ca)
             (block
              (if (not (coco-big-p c)) (return 0))
              (return (? (== (nth (cast size_t (coco-payload ca)) (-> m bigs))
                             (nth (cast size_t (coco-payload c)) (-> m bigs))) 1 0))))
            (#t (return 0)))))

  ;;; Answers 1 when the head matched (the goals are built), 0 when it did
  ;;; not, and -1 when it could not run at all -- no frame to be had -- which
  ;;; the caller answers by matching the clause in the store instead: a
  ;;; clause skipped because memory was short would be a wrong answer.
  ;;;
  ;;; A SWITCH, NOT A CHAIN: the opcode is a jump, where a chain of
  ;;; comparisons cost each instruction its position in the chain. And THE
  ;;; SLOTS ARE RESERVED, NOT WRITTEN (`coco_push_struct_raw'): every slot
  ;;; of every structure built here is written by exactly one instruction
  ;;; before anything can read it -- the two that leave a slot as the
  ;;; variable it is (UNIFY_VAR in write mode, ARG_VAR_1) write the
  ;;; variable themselves -- so the walk that cleared them to variables was
  ;;; a store per slot for nothing. Nothing reads a half-built structure: a
  ;;; structure's instructions follow its GET or ARG at once, and a nested
  ;;; one is reached only through the slot its parent wrote.
  (func coco_clause_run ((coco_machine * m) (coco_store * st) (coco_code * cd)
                         (size_t call) (size_t * goals) (size_t * ngoals)) (out int)
        (let ((size_t frame_small [128])
              (size_t * frame . nil) (size_t frcap . 0)
              (size_t pc . 0)
              (size_t S . 0) (int write . 0) (int ok . 1))
          (set (cof ngoals) 0)
          ;; THE FRAME: 128 slots on the C stack, or the machine's kept array
          ;; -- never a malloc and a free per call, which is what the walk
          ;; stacks stopped doing (1.8.38)
          (if (<= (-> cd nvars) 128)
              (set frame frame_small)
              (set frame (coco_cslots_take m (cast size_t (-> cd nvars)) (aof frcap))))
          (if (== frame nil) (return -1))
          ;; ---- the head ----
          (while (and ok (< pc (-> cd hlen)))
            (let ((u64 w . #'(nth pc (-> cd head))))
              (set pc (+ pc 1))
              (switch (cast int (cc_op w))
                (case (cc-op "GET_VAR")
                  (set (nth (cc_k w) frame) (coco_deref m (+ call (+ (cast size_t (cc_n w)) 1))))
                  break)
                (case (cc-op "GET_VAL")
                  (if (not (coco_unify m (nth (cc_k w) frame) (+ call (+ (cast size_t (cc_n w)) 1))))
                      (set ok 0))
                  break)
                (case (cc-op "GET_CONST")
                  (let ((u64 c . #'(nth pc (-> cd head))))
                    (set pc (+ pc 1))
                    (if (not (cc_match_const m (coco_deref m (+ call (+ (cast size_t (cc_n w)) 1))) c))
                        (set ok 0)))
                  break)
                (case (cc-op "GET_STRUCT")
                  ;; the argument index is in K, the arity in N
                  (let ((u64 fid . #'(nth pc (-> cd head)))
                        (u32 n . #'(cast u32 (cc_n w)))
                        (size_t a . #'(coco_deref m (+ call (+ (cc_k w) 1)))))
                    (set pc (+ pc 1))
                    (let ((u64 ca . #'(nth a (-> m heap))))
                      (cond
                        ((coco-tag-is REF ca)
                         ;; WRITE: the structure is built and the variable bound to it
                         (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN fid) n)))
                           (coco_bind m a h)
                           (set S (+ h 1))
                           (set write 1)))
                        ((and (coco-tag-is FUN ca) (== (coco-payload ca) fid))
                         (set S (+ a 1))
                         (set write 0))
                        (#t (set ok 0)))))
                  break)
                (case (cc-op "GET_STRUCT_T")
                  ;; the temporary is in K, the arity in N
                  (let ((u64 fid . #'(nth pc (-> cd head)))
                        (u32 n . #'(cast u32 (cc_n w)))
                        (size_t a . #'(coco_deref m (nth (cc_k w) frame))))
                    (set pc (+ pc 1))
                    (let ((u64 ca . #'(nth a (-> m heap))))
                      (cond
                        ((coco-tag-is REF ca)
                         (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN fid) n)))
                           (coco_bind m a h)
                           (set S (+ h 1))
                           (set write 1)))
                        ((and (coco-tag-is FUN ca) (== (coco-payload ca) fid))
                         (set S (+ a 1))
                         (set write 0))
                        (#t (set ok 0)))))
                  break)
                (case (cc-op "UNIFY_VAR")
                  ;; write: the slot IS the variable, and is written as one
                  (if write
                      (block (set (nth S (-> m heap)) (coco-cell REF S))
                             (set (nth (cc_k w) frame) S))
                      (set (nth (cc_k w) frame) (coco_deref m S)))
                  (set S (+ S 1))
                  break)
                (case (cc-op "UNIFY_VAL")
                  (if write
                      (coco_set_arg m S (coco_deref m (nth (cc_k w) frame)))
                      (if (not (coco_unify m (nth (cc_k w) frame) S)) (set ok 0)))
                  (set S (+ S 1))
                  break)
                (case (cc-op "UNIFY_CONST")
                  (let ((u64 c . #'(nth pc (-> cd head))))
                    (set pc (+ pc 1))
                    (if write
                        (coco_set_arg m S (coco_push m c))
                        (if (not (cc_match_const m (coco_deref m S) c)) (set ok 0)))
                    (set S (+ S 1)))
                  break)
                (default (set ok 0)))))
          (if (not ok)
              (block (if (!= frame frame_small) (coco_cslots_give m frame frcap)) (return 0)))
          ;; ---- the body ----
          ;; EVERY GOAL IS ONE RESERVATION: its GOAL_STRUCT carries the
          ;; cells the whole goal takes -- header, slots, every nested
          ;; structure's and every constant's -- and reserves them in one
          ;; growth check; the ARG words that follow carry the OFFSET from
          ;; the goal's base of the slot they fill and of the cell they
          ;; put there, settled when the clause was compiled, so each is a
          ;; store or two with nothing to check and no stack of pending
          ;; structures to keep (1.8.46; through 1.8.45 the executor
          ;; walked a frame stack to find the next slot and grew the heap
          ;; per structure, as the copy does).
          (if (> (-> cd blen) 0)
              (let ((size_t ng . 0) (size_t h . 0))
                (set pc 0)
                ;; the program's length is its end: no END word to dispatch
                (while (and ok (< pc (-> cd blen)))
                  (let ((u64 w . #'(nth pc (-> cd body))))
                    (set pc (+ pc 1))
                    (switch (cast int (cc_op w))
                      (case (cc-op "GOAL_STRUCT")
                        (let ((u64 fid . #'(nth pc (-> cd body)))
                              (size_t total . #'(cast size_t (cc_n w))))
                          (set pc (+ pc 1))
                          (set h (-> m heap_len))
                          (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                            (aof (-> m heap_cap)) (+ h total) (sizeof u64)))
                              (block (set ok 0) break))
                          (set (-> m heap_len) (+ h total))
                          (set (nth h (-> m heap)) (coco-cell FUN fid))
                          (if (< ng 64) (block (set (nth ng goals) h) (set ng (+ ng 1)))))
                        break)
                      (case (cc-op "GOAL_ATOM")
                        (let ((u64 c . #'(nth pc (-> cd body))))
                          (set pc (+ pc 1))
                          (if (< ng 64) (block (set (nth ng goals) (coco_push m c)) (set ng (+ ng 1)))))
                        break)
                      (case (cc-op "GOAL_VAR")
                        (if (< ng 64) (block (set (nth ng goals) (coco_deref m (nth (cc_k w) frame)))
                                             (set ng (+ ng 1))))
                        break)
                      (case (cc-op "GOAL_VAR_1")
                        (let ((size_t v . #'(coco_new_var m)))
                          (set (nth (cc_k w) frame) v)
                          (if (< ng 64) (block (set (nth ng goals) v) (set ng (+ ng 1)))))
                        break)
                      (case (cc-op "ARG_CONST")
                        ;; the constant in its own cell, the slot pointing at it
                        (let ((u64 c . #'(nth pc (-> cd body)))
                              (size_t at . #'(+ h (cast size_t (cc_n w)))))
                          (set pc (+ pc 1))
                          (set (nth at (-> m heap)) c)
                          (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                        break)
                      (case (cc-op "ARG_VAR")
                        (set (nth (+ h (cast size_t (cc_n w))) (-> m heap))
                             (coco-cell REF (coco_deref m (nth (cc_k w) frame))))
                        break)
                      (case (cc-op "ARG_VAR_1")
                        ;; the slot IS the variable, and is written as one
                        (let ((size_t slot . #'(+ h (cast size_t (cc_n w)))))
                          (set (nth slot (-> m heap)) (coco-cell REF slot))
                          (set (nth (cc_k w) frame) slot))
                        break)
                      (case (cc-op "ARG_STRUCT")
                        ;; the header where the compiler placed it; its own
                        ;; slots are filled by the words that follow
                        (let ((u64 fid . #'(nth pc (-> cd body)))
                              (size_t at . #'(+ h (cast size_t (cc_n w)))))
                          (set pc (+ pc 1))
                          (set (nth at (-> m heap)) (coco-cell FUN fid))
                          (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                        break)
                      (default (set ok 0)))))
                (set (cof ngoals) ng)))
          (if (!= frame frame_small) (coco_cslots_give m frame frcap))
          ;; the head matched; a body that could not be built is not a
          ;; head that failed to match, and must not be reported as one
          (return (? ok 1 -1))))

  ;;; Floored division's correction, as `coco_floor_adjusts' makes it for
  ;;; `div' and `mod': a copy, that one being the engine's and this file
  ;;; read before it.
  (static)
  (func cc_floor_adjusts ((i64 a) (i64 b)) (out int)
        (let ((i64 r . #'(% a b)))
          (return (? (and (!= r 0) (!= (< r 0) (< b 0))) 1 0))))

  ;;; THE GUARDS' RUNNER (`cc-guards-body'), for the guards' own executor,
  ;;; and its copy for the executor that makes an environment after them.
  (static)
  (func cc_guards_run ((coco_machine * m) (coco_code * cd) (size_t * frame) (u32 budget)
                       (int * failed)) (out u32)
        (cc-guards-body (-> cd gbody) (-> cd gblen) cc-frame-var 0))
  (static)
  (func cc_guards_run_e ((coco_machine * m) (coco_code * cd) (size_t * frame) (u32 budget)
                         (int * failed)) (out u32)
        (cc-guards-body (-> cd gbody) (-> cd gblen) cc-frame-var 0))

  ;;; THE SAME, TWO WAYS MORE (Stage 3): a call whose arguments are in
  ;;; registers (ARGS, CALL not read), and a first goal written into the
  ;;; engine's registers (REGS, when the code has the form for it) rather
  ;;; than built. A function of its own, so a clause that uses neither --
  ;;; every body that starts with a builtin -- runs the one above, exactly
  ;;; as it ran before there were registers.
  (func coco_clause_run_r ((coco_machine * m) (coco_store * st) (coco_code * cd)
                         (size_t call) (const size_t * args)
                         (size_t * goals) (size_t * ngoals) (size_t * regs)) (out int)
        (let ((size_t frame_small [128])
              (size_t * frame . nil) (size_t frcap . 0)
              (size_t pc . 0)
              (size_t S . 0) (int write . 0) (int ok . 1))
          (set (cof ngoals) 0)
          ;; THE FRAME: 128 slots on the C stack, or the machine's kept array
          ;; -- never a malloc and a free per call, which is what the walk
          ;; stacks stopped doing (1.8.38)
          (if (<= (-> cd nvars) 128)
              (set frame frame_small)
              (set frame (coco_cslots_take m (cast size_t (-> cd nvars)) (aof frcap))))
          (if (== frame nil) (return -1))
          ;; ---- the head, over the call as a term or in registers ----
          (if (== args nil)
              (cc-head-program cc-arg-term)
              (cc-head-program cc-arg-reg))
          (if (not ok)
              (block (if (!= frame frame_small) (coco_cslots_give m frame frcap)) (return 0)))
          ;; ---- the body, its first goal into the registers when it can ----
          (cc-body-program (-> cd body) 0 (-> cd blen) (and (!= regs nil) (> (-> cd rblen) 0)))
          (if (!= frame frame_small) (coco_cslots_give m frame frcap))
          ;; the head matched; a body that could not be built is not a
          ;; head that failed to match, and must not be reported as one
          (return (? ok 1 -1))))

  ;;; AND ONCE MORE, FOR A BODY THAT STARTS WITH GUARDS (Stage 4): the
  ;;; same, with the guards run between the head and the body -- at most
  ;;; BUDGET of them, their count in GDONE, the one that failed counted
  ;;; too, as the step that failed would have been. A function of its own
  ;;; again, so that a clause without guards pays nothing for them: in the
  ;;; one above they cost naive reverse 33 instructions a call, in an
  ;;; out-parameter and the registers it took. ITS GUARDS' RUNNER IS ITS
  ;;; OWN (`cc_guards_run', one caller), so that the compiler keeps it in
  ;;; this function: called from a second executor too (Stage 5's first
  ;;; form), it became a call of its own and cost the counting loop 6
  ;;; instructions a turn.
  (func coco_clause_run_g ((coco_machine * m) (coco_store * st) (coco_code * cd)
                         (size_t call) (const size_t * args)
                         (size_t * goals) (size_t * ngoals) (size_t * regs)
                         (u32 budget) (u32 * gdone)) (out int)
        (let ((size_t frame_small [128])
              (size_t * frame . nil) (size_t frcap . 0)
              (size_t pc . 0)
              (size_t S . 0) (int write . 0) (int ok . 1)
              (u32 gi . 0) (int gfail . 0))
          (set (cof ngoals) 0)
          (set (cof gdone) 0)
          (if (<= (-> cd nvars) 128)
              (set frame frame_small)
              (set frame (coco_cslots_take m (cast size_t (-> cd nvars)) (aof frcap))))
          (if (== frame nil) (return -1))
          ;; ---- the head ----
          (if (== args nil)
              (cc-head-program cc-arg-term)
              (cc-head-program cc-arg-reg))
          (if (not ok)
              (block (if (!= frame frame_small) (coco_cslots_give m frame frcap)) (return 0)))
          ;; ---- the guards, where the step would have run them: next ----
          (set gi (cc_guards_run m cd frame budget (aof gfail)))
          (if gfail
              (block (set (cof gdone) (+ gi 1))
                     (if (!= frame frame_small) (coco_cslots_give m frame frcap))
                     (return 0)))
          (set (cof gdone) gi)
          ;; ---- the body, from the first goal that was not run here; into
          ;; the registers only when every guard ran ----
          (cc-body-program (-> cd body) (cast size_t (nth gi (-> cd gstart))) (-> cd blen)
                           (and (== gi (-> cd ngd)) (!= regs nil) (> (-> cd rblen) 0)))
          (if (!= frame frame_small) (coco_cslots_give m frame frcap))
          (return (? ok 1 -1))))

  ;;; AND FOR A BODY WITH NO GUARDS THAT MAKES AN ENVIRONMENT (Stage 5): the
  ;;; head, then only the first goal -- into the registers when they can
  ;;; take it, built otherwise, `rstart' being where the goal after it
  ;;; begins -- and then the later goals' entry program and the environment
  ;;; (`cc-env-entry'), as ER asks.
  (func coco_clause_run_e ((coco_machine * m) (coco_store * st) (coco_code * cd)
                         (size_t call) (const size_t * args)
                         (size_t * goals) (size_t * ngoals) (size_t * regs)
                         (coco_envreq * er)) (out int)
        (let ((size_t frame_small [128])
              (size_t * frame . nil) (size_t frcap . 0)
              (size_t pc . 0)
              (size_t S . 0) (int write . 0) (int ok . 1))
          (set (cof ngoals) 0)
          (if (<= (-> cd nvars) 128)
              (set frame frame_small)
              (set frame (coco_cslots_take m (cast size_t (-> cd nvars)) (aof frcap))))
          (if (== frame nil) (return -1))
          ;; ---- the head ----
          (if (== args nil)
              (cc-head-program cc-arg-term)
              (cc-head-program cc-arg-reg))
          (if (not ok)
              (block (if (!= frame frame_small) (coco_cslots_give m frame frcap)) (return 0)))
          ;; ---- the first goal, alone, when it is handed over -- a first
          ;; goal that is a construct is a unit, and built by the entry
          ;; program -- and the environment ----
          (if (-> cd ehand)
              (cc-body-program (-> cd body) 0 (-> cd rstart) (and (!= regs nil) (> (-> cd rblen) 0))))
          (if ok (cc-env-entry))
          (if (!= frame frame_small) (coco_cslots_give m frame frcap))
          (return (? ok 1 -1))))

  ;;; AND FOR A BODY THAT STARTS WITH GUARDS AND MAKES AN ENVIRONMENT AFTER
  ;;; THEM (Stage 6): the head, the guards as `coco_clause_run_g' runs them
  ;;; (BUDGET, GDONE), and then, when every guard ran, the first goal after
  ;;; them -- into the registers or built, `rstart' being where the goal
  ;;; after it begins -- and the environment, as ER asks. Guards that
  ;;; stopped before the last build the body from the one they stopped at,
  ;;; as `coco_clause_run_g' does, and make no environment: ER's next stays
  ;;; 0, and REGS is not written.
  (func coco_clause_run_ge ((coco_machine * m) (coco_store * st) (coco_code * cd)
                          (size_t call) (const size_t * args)
                          (size_t * goals) (size_t * ngoals) (size_t * regs)
                          (coco_envreq * er) (u32 budget) (u32 * gdone)) (out int)
        (let ((size_t frame_small [128])
              (size_t * frame . nil) (size_t frcap . 0)
              (size_t pc . 0)
              (size_t S . 0) (int write . 0) (int ok . 1)
              (u32 gi . 0) (int gfail . 0))
          (set (cof ngoals) 0)
          (set (cof gdone) 0)
          (if (<= (-> cd nvars) 128)
              (set frame frame_small)
              (set frame (coco_cslots_take m (cast size_t (-> cd nvars)) (aof frcap))))
          (if (== frame nil) (return -1))
          ;; ---- the head ----
          (if (== args nil)
              (cc-head-program cc-arg-term)
              (cc-head-program cc-arg-reg))
          (if (not ok)
              (block (if (!= frame frame_small) (coco_cslots_give m frame frcap)) (return 0)))
          ;; ---- the guards ----
          (set gi (cc_guards_run_e m cd frame budget (aof gfail)))
          (if gfail
              (block (set (cof gdone) (+ gi 1))
                     (if (!= frame frame_small) (coco_cslots_give m frame frcap))
                     (return 0)))
          (set (cof gdone) gi)
          (if (< gi (-> cd ngd))
              ;; ---- stopped short: the body from that guard, as it was ----
              (cc-body-program (-> cd body) (cast size_t (nth gi (-> cd gstart))) (-> cd blen) 0)
              ;; ---- the first goal after the guards, when it is handed
              ;; over, and the environment ----
              (block
               (if (-> cd ehand)
                   (cc-body-program (-> cd body) (cast size_t (nth gi (-> cd gstart))) (-> cd rstart)
                                    (and (!= regs nil) (> (-> cd rblen) 0))))
               (if ok (cc-env-entry))))
          (if (!= frame frame_small) (coco_cslots_give m frame frcap))
          (return (? ok 1 -1))))

  ;;; GOAL I OF AN ENVIRONMENT, REACHED (`coco_env_take' in solve.cicili,
  ;;; and a freeze): the words the body would have run for it when the
  ;;; clause was entered, a variable read from the environment's slot where
  ;;; the body read the frame -- into the registers for a call, one
  ;;; reservation holding whatever it nests, as the first goal's register
  ;;; form is run; or built as its term, one reservation for the whole
  ;;; goal, the very term entering the clause would have built
  ;;; (`cc-env-slot1'). No variable is made here: every one a later goal
  ;;; meets first was made with the environment. ENV is the header.
  (func coco_env_regs ((coco_machine * m) (coco_code * cd) (size_t env) (u32 i)
                       (size_t * regs)) (out int)
        (let ((coco_egoal * g . #'(aof (nth i (-> cd egoals))))
              (u64 * rp . #'(+ (-> cd ebody) (-> g rat)))
              (size_t rn . #'(cast size_t (-> g rlen)))
              (size_t eb . #'(+ env 4))
              (size_t h . 0) (size_t rpc . 0))
          (while (< rpc rn)
            (let ((u64 w . #'(nth rpc rp)))
              (set rpc (+ rpc 1))
              (switch (cast int (cc_op w))
                (case (cc-op "RARG_VAR")
                  (set (nth (cast size_t (cc_n w)) regs) (cc-env-slot (cc_k w)))
                  break)
                (case (cc-op "RGOAL")
                  (let ((size_t total . #'(cast size_t (cc_n w))))
                    (set h (-> m heap_len))
                    (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                      (aof (-> m heap_cap)) (+ h total) (sizeof u64)))
                        (return 0))
                    (set (-> m heap_len) (+ h total)))
                  break)
                (case (cc-op "RARG_CONST")
                  (let ((u64 c . #'(nth rpc rp))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set rpc (+ rpc 1))
                    (set (nth at (-> m heap)) c)
                    (set (nth (cc_k w) regs) at))
                  break)
                (case (cc-op "RARG_STRUCT")
                  (let ((u64 fid . #'(nth rpc rp))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set rpc (+ rpc 1))
                    (set (nth at (-> m heap)) (coco-cell FUN fid))
                    (set (nth (cc_k w) regs) at))
                  break)
                (case (cc-op "ARG_CONST")
                  (let ((u64 c . #'(nth rpc rp))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set rpc (+ rpc 1))
                    (set (nth at (-> m heap)) c)
                    (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                  break)
                (case (cc-op "ARG_VAR")
                  (set (nth (+ h (cast size_t (cc_n w))) (-> m heap))
                       (coco-cell REF (cc-env-slot (cc_k w))))
                  break)
                (case (cc-op "ARG_STRUCT")
                  (let ((u64 fid . #'(nth rpc rp))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set rpc (+ rpc 1))
                    (set (nth at (-> m heap)) (coco-cell FUN fid))
                    (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                  break)
                (default (return 0)))))
          (return 1)))

  (func coco_env_term ((coco_machine * m) (coco_code * cd) (size_t env) (u32 i)
                       (size_t * out)) (out int)
        (let ((coco_egoal * g . #'(aof (nth i (-> cd egoals))))
              (u64 * prog . #'(+ (-> cd ebody) (-> g tat)))
              (size_t len . #'(cast size_t (-> g tlen)))
              (size_t eb . #'(+ env 4))
              (size_t h . 0) (size_t pc . 0))
          (while (< pc len)
            (let ((u64 w . #'(nth pc prog)))
              (set pc (+ pc 1))
              (switch (cast int (cc_op w))
                (case (cc-op "GOAL_STRUCT")
                  (let ((u64 fid . #'(nth pc prog))
                        (size_t total . #'(cast size_t (cc_n w))))
                    (set pc (+ pc 1))
                    (set h (-> m heap_len))
                    (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                                      (aof (-> m heap_cap)) (+ h total) (sizeof u64)))
                        (return 0))
                    (set (-> m heap_len) (+ h total))
                    (set (nth h (-> m heap)) (coco-cell FUN fid))
                    (set (cof out) h))
                  break)
                (case (cc-op "GOAL_ATOM")
                  (let ((u64 c . #'(nth pc prog)) (size_t at . 0))
                    (set pc (+ pc 1))
                    ;; 0 is no room: the environment below is cell 1 or on
                    (set at (coco_push m c))
                    (if (== at 0) (return 0))
                    (set (cof out) at))
                  break)
                (case (cc-op "GOAL_VAR")
                  (set (cof out) (cc-env-slot1 (cc_k w)))
                  break)
                (case (cc-op "ARG_CONST")
                  (let ((u64 c . #'(nth pc prog))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set pc (+ pc 1))
                    (set (nth at (-> m heap)) c)
                    (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                  break)
                (case (cc-op "ARG_VAR")
                  ;; the variable as the clause's entry left it: one link
                  (set (nth (+ h (cast size_t (cc_n w))) (-> m heap))
                       (coco-cell REF (cc-env-slot1 (cc_k w))))
                  break)
                (case (cc-op "ARG_STRUCT")
                  (let ((u64 fid . #'(nth pc prog))
                        (size_t at . #'(+ h (cast size_t (cc_n w)))))
                    (set pc (+ pc 1))
                    (set (nth at (-> m heap)) (coco-cell FUN fid))
                    (set (nth (+ h (cc_k w)) (-> m heap)) (coco-cell REF at)))
                  break)
                (default (return 0)))))
          (return 1)))

  ;;; A GUARD, DONE IN PLACE (Stage 7): unit U's program over the
  ;;; environment's slots, one goal -- 1 when it passed, 0 with FAILED set
  ;;; when it failed, 0 with FAILED clear when it could not decide and did
  ;;; nothing, for the step to build its term and take it as it always did.
  (static)
  (func coco_env_guard ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                        (int * failed)) (out u32)
        (let ((coco_egoal * g . #'(aof (nth u (-> cd egoals))))
              (size_t eb . #'(+ env 4)) (u32 budget . 1))
          (cc-guards-body (+ (-> cd ebody) (-> g rat)) (cast size_t (-> g rlen)) cc-env-slot 1)))

  ;;; A GUARDX, DONE IN PLACE: unit U's one fused word (`cc_ufuse') reads
  ;;; its two operands, each a slot or a cell, and does nothing unless both
  ;;; are integers; the rest is the stack program's, the same C on the same
  ;;; values. Answers as `coco_env_guard' does.
  (static)
  (func coco_env_guardx ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                         (int * failed)) (out u32)
        (let ((coco_egoal * g . #'(aof (nth u (-> cd egoals))))
              (size_t eb . #'(+ env 4))
              (u64 * fp . #'(+ (-> cd ebody) (-> g rat)))
              (u64 w . #'(nth 0 fp)) (u64 f . #'(cc_n w))
              (u64 ca . #'(nth 1 fp)) (u64 cb . #'(nth 2 fp)) (int pass . 1))
          (set (cof failed) 0)
          (if (not (bitand f 256)) (set ca (nth (cc-env-slot ca) (-> m heap))))
          (if (not (bitand f 512)) (set cb (nth (cc-env-slot cb) (-> m heap))))
          (if (not (and (coco-tag-is INT ca) (coco-tag-is INT cb))) (return 0))
          ;; ON THE CELLS THEMSELVES (2.0.0): an INT is its value times
          ;; sixteen over the tag 2 (four tag bits, 2.5.0), so A + B is the
          ;; cell CA - 2 + CB, A - B the cell CA - CB + 2 and A * B the cell
          ;; (CA - 2) * B + 2 -- and a result past the 60 bits a cell keeps
          ;; is exactly a 64-bit overflow of that sum, which the step boxes.
          ;; Two cells compare as their values do. Through 1.15.0 the values
          ;; were taken out of their cells and the result put back in one,
          ;; wrapping at 61 bits.
          (let ((i64 a . #'(cast i64 ca)) (i64 b . #'(cast i64 cb)))
            (if (== (cc_op w) (cc-op "AG_ISX"))
                (let ((i64 r . 0) (size_t v . 0) (u64 c . 0))
                  (switch (cast int (bitand f 255))
                    (case (cc-gop "+") (if (coco_add_ovf (- a 2) b (aof r)) (return 0)) break)
                    (case (cc-gop "-")
                      (if (coco_sub_ovf a b (aof r)) (return 0))
                      (set r (+ r 2)) break)
                    (case (cc-gop "*")
                      (if (coco_mul_ovf (- a 2) (coco-signed-payload cb) (aof r)) (return 0))
                      (set r (+ r 2)) break)
                    (default (return 0)))
                  ;; the left: bound to the result, or compared with it
                  (set v (cc-env-slot (cc_k w)))
                  (set c (nth v (-> m heap)))
                  (if (coco-tag-is REF c)
                      (coco_bind m v (coco_push m (cast u64 r)))
                      (set pass (== c (cast u64 r)))))
                (switch (cast int (bitand f 255))
                  (case (cc-gop "<") (set pass (< a b)) break)
                  (case (cc-gop ">") (set pass (> a b)) break)
                  (case (cc-gop "=<") (set pass (<= a b)) break)
                  (case (cc-gop ">=") (set pass (>= a b)) break)
                  (case (cc-gop "=:=") (set pass (== a b)) break)
                  (case (cc-gop "numneq") (set pass (!= a b)) break)
                  (default (return 0)))))
          (if pass (return 1))
          (set (cof failed) 1)
          (return 0)))

  ;;; TWO SIDES, DONE IN PLACE (Stage 7): unit U's two arguments read out of
  ;;; the slots as a call's are -- copied when both are variables
  ;;; (`rvars'), anything they nest made in one reservation otherwise
  ;;; (`coco_env_regs') -- and unified (`=/2') or compared (`==/2',
  ;;; `\==/2'), as the builtins unify and compare their two arguments. 1
  ;;; true, 0 false, -1 when the heap would not grow.
  (static)
  (func coco_env_sides ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)) (out int)
        (let ((coco_egoal * g . #'(aof (nth u (-> cd egoals))))
              (size_t rg [8]) (size_t eb . #'(+ env 4)))
          (if (-> g rvars)
              (let ((u64 * rp . #'(+ (-> cd ebody) (-> g rat))))
                (for ((u32 j . 0)) (< j (-> g rlen)) ((++ j))
                  (let ((u64 w . #'(nth j rp)))
                    (set (nth (cast size_t (cc_n w)) rg) (coco_deref m (+ eb (cc_k w)))))))
              (if (not (coco_env_regs m cd env u rg)) (return -1)))
          (switch (cast int (-> g form))
            (case 0 (return (? (coco_unify m (nth 0 rg) (nth 1 rg)) 1 0)))
            (case 1 (return (? (== 0 (coco_compare m (nth 0 rg) (nth 1 rg))) 1 0)))
            (default (return (? (!= 0 (coco_compare m (nth 0 rg) (nth 1 rg))) 1 0))))))

  ;;; A compound of functor FID over X (and Y, for N 2) as they are: the
  ;;; body program's way, never dereferenced.
  (static)
  (func cc_make_raw ((coco_machine * m) (u64 fid) (u32 n) (size_t x) (size_t y) (size_t * out)) (out int)
        (let ((size_t h . #'(coco_push_struct_raw m (coco-cell FUN fid) n)))
          (if (== h 0) (return 0))
          (set (nth (+ h 1) (-> m heap)) (coco-cell REF x))
          (if (== n 2) (set (nth (+ h 2) (-> m heap)) (coco-cell REF y)))
          (set (cof out) h)
          (return 1)))

  ;;; UNIT U OF THE ENVIRONMENT AT ENV, AS THE TERM ITS FRAME HELD THROUGH
  ;;; 1.9.2 (Stage 6), into OUT -- for a freeze, which writes no
  ;;; environment, and for the tracer, which prints its ports from terms. A
  ;;; goal that is a term is the one entering the clause built, one link
  ;;; from its slot (a BUILTIN's too); a call, a guard and two sides are
  ;;; built from the variable slots (`coco_env_term'); a construct is built
  ;;; back from its parts as it was written, with the functors it was
  ;;; written with; a cut after a condition is `'$cut'(H)' for the height
  ;;; its slot holds. 1, or 0 when the heap would not grow. Recursive over
  ;;; the constructs' nesting, which the compiler keeps under 64.
  (func coco_unit_term ((coco_machine * m) (coco_code * cd) (size_t env) (u32 u)
                        (size_t * out)) (out int)
        (let ((coco_egoal * g . #'(aof (nth u (-> cd egoals))))
              (u32 kind . 0) (size_t x . 0) (size_t y . 0) (size_t z . 0))
          (set kind (-> g kind))
          (if (or (== kind (cc-eg "TERM")) (== kind (cc-eg "BUILTIN")))
              (block
               (set (cof out) (cast size_t (coco-payload (nth (+ env (+ (+ (cast size_t (-> cd nes))
                                                                          (cast size_t (-> g tslot))) 4))
                                                              (-> m heap)))))
               (return 1)))
          (if (or (== kind (cc-eg "CALL")) (== kind (cc-eg "GUARD")) (== kind (cc-eg "GUARDX"))
                  (== kind (cc-eg "SIDES")))
              (return (coco_env_term m cd env u out)))
          (if (or (== kind (cc-eg "CUT")) (== kind (cc-eg "TRUE")) (== kind (cc-eg "FAIL")))
              (block (set x (coco_push m (coco-cell ATOM (-> g fid))))
                     (if (== x 0) (return 0))
                     (set (cof out) x)
                     (return 1)))
          (if (== kind (cc-eg "CUTC"))
              (block (set x (coco_new_int m (coco-signed-payload
                                             (nth (coco-env-slot-at env cd (-> g tslot)) (-> m heap)))))
                     (if (== x 0) (return 0))
                     (return (cc_make_raw m (-> g fid) 1 x 0 out))))
          (if (== kind (cc-eg "CONJ"))
              (let ((size_t items [64]) (u32 n . 0) (u32 v . #'(-> g a)))
                (while (and (!= v 0) (< n 64))
                  (if (not (coco_unit_term m cd env v (aof (nth n items)))) (return 0))
                  (set n (+ n 1))
                  (set v ($ (nth v (-> cd egoals)) sib)))
                (if (== n 0) (return 0))
                ;; right-nested, as it was written
                (set x (nth (- n 1) items))
                (while (> n 1)
                  (set n (- n 1))
                  (if (not (cc_make_raw m (-> g fid) 2 (nth (- n 1) items) x (aof x))) (return 0)))
                (set (cof out) x)
                (return 1)))
          (if (== kind (cc-eg "DISJ"))
              (block (if (not (coco_unit_term m cd env (-> g a) (aof x))) (return 0))
                     (if (not (coco_unit_term m cd env (-> g b) (aof y))) (return 0))
                     (return (cc_make_raw m (-> g fid) 2 x y out))))
          (if (== kind (cc-eg "ITE"))
              (block
               (if (not (coco_unit_term m cd env (-> g a) (aof x))) (return 0))
               (if (== (-> g form) 0)
                   (block (if (not (coco_unit_term m cd env (-> g b) (aof y))) (return 0))
                          (if (not (cc_make_raw m (-> g fid2) 2 x y (aof z))) (return 0))
                          (if (not (coco_unit_term m cd env (-> g c) (aof y))) (return 0))
                          (return (cc_make_raw m (-> g fid) 2 z y out))))
               (if (== (-> g form) 1)
                   (block (if (not (coco_unit_term m cd env (-> g b) (aof y))) (return 0))
                          (return (cc_make_raw m (-> g fid) 2 x y out))))
               (return (cc_make_raw m (-> g fid) 1 x 0 out))))
          (return 0)))

  ) ; impl-kb-compile

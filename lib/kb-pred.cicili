;;;; cocolog -- predicates: reclaiming the store, the predicate table,
;;;; asserting, the indexes and the logical update view
;;;
;;; A PIECE OF THE KNOWLEDGE BASE, split out of lib/kb.cicili for size
;;; (2.16.1, where that file had reached 8 080 lines). The four pieces are ONE
;;; translation unit, emitted in this order by cocolog.cicili and by the test
;;; binaries that link the store: kb, kb-compile, kb-pred, kb-consult. So a
;;; function here calls only what an earlier piece defined or `decl-kb'
;;; declared, exactly as when they were one file. lib/kb.cicili keeps the
;;; compiler's tables and macros and every declaration.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

(generic impl-kb-pred
  ()

  ;;; ---- reclaiming the store ---------------------------------------------
  ;;;
  ;;; THE STORE NEVER SHRANK, and `nb_setval/2' was the bill. Every write
  ;;; copies a whole term into `cells' -- a clause, a global's new value, a
  ;;; ball, each solution a `findall/3' keeps -- and nothing ever took one
  ;;; out: a retract dropped the clause from its predicate and orphaned the
  ;;; cells, and a global written again simply pointed elsewhere. Measured
  ;;; on cicili-lang's driver, which keeps its symbol tables in globals and
  ;;; writes them back after every step: 105 049 `nb_setval' calls, 103 192
  ;;; of them overwrites, put 1 073 MB into a store whose LIVE contents --
  ;;; every clause of every predicate and the current value of every global
  ;;; -- came to 20 MB. Ninety-eight per cent garbage, and it was the
  ;;; larger half of a process that needed 3.4 GB to compile 12 lines of
  ;;; C++.
  ;;;
  ;;; COMPACTION COPIES WHAT IS REACHABLE AND DROPS THE ARRAY. Everything
  ;;; the store can still reach is a root the store itself holds -- a
  ;;; `clauses[]' entry of some predicate, or a global's `cell' -- and a
  ;;; term is copied out to the heap and back into a fresh array by the two
  ;;; walkers that put it there, so a compacted term is exactly what an
  ;;; `assertz' of its copy would have stored. The heap is wound back after
  ;;; every term. Nothing else moves: `keys' hold cell VALUES, `chain' and
  ;;; `slots' hold positions, `origins' hold atoms, so the first-argument
  ;;; index stays valid across a compaction and `clause_ix' goes on meaning
  ;;; what it meant.
  ;;;
  ;;; WHEN: at a SAFE POINT, once at least four million cells (32 MB) are
  ;;; known dead and they outnumber the live ones -- or, as the net under
  ;;; that, once the store has grown by as much again as it held at the
  ;;; last compaction and by those 32 MB. The dead are counted where a
  ;;; death is cheap to see: a global's old value (its size is kept beside
  ;;; its cell), a retracted or reconsulted clause and an initialization
  ;;; goal that has run (each was just copied to the heap, and the span is
  ;;; the copy's length and a cell for each of its variables --
  ;;; `coco_store_get_span'), a findall's solutions (their puts are its own),
  ;;; a ball once caught. The growth net is for whatever a site forgets to
  ;;; count, because the one it forgets is the one that grows without
  ;;; bound; its price is a compaction of a store that is all live once per
  ;;; doubling, the amortised cost of the `realloc' it already pays. The
  ;;; first draft counted growth alone, and 3 000 `asserta' calls followed
  ;;; by 2 999 retracts kept 192 MB for 16 KB of clauses: the mark had been
  ;;; set while everything was live, and a retract never lowered it.
  ;;; `garbage_collect/0' forces one.
  ;;;
  ;;; A SAFE POINT IS ONE WHERE EVERY CELL INDEX ANYBODY HOLDS IS ONE THE
  ;;; STORE KNOWS ABOUT. Two callers keep indices of their own for a
  ;;; while: `coco_engine_findall' keeps each solution's root in an array
  ;;; until the search is over, and a consult keeps its `initialization/1'
  ;;; goals until they have run. Both REGISTER the array (`coco_store_root_push',
  ;;; a stack, popped on the way out) and a compaction rewrites its entries
  ;;; like any other root. Registered rather than declined, because a
  ;;; `forall/2' IS a findall and a script's whole life runs inside its
  ;;; `initialization(main)' -- a compaction declined under either would
  ;;; never have happened at all. A ball is put and read back by the frame
  ;;; that catches it with no goal run between; a clause is registered
  ;;; before its assert returns. Everything else that reads a cell reads
  ;;; it at once.
  ;;;
  ;;; THE CHECK SITES: `nb_setval/2', the assert and retract builtins,
  ;;; `abolish/1', the end of a `findall/3', a caught throw, and the end of
  ;;; a consult. Each one asks; the policy lives here.

  (func coco_store_compact ((coco_store * st) (coco_machine * m)) (out int)
        ;; A GREEN WORLD HOLDS OTHER MACHINES' FRAMES (2.7.0): the compaction
        ;; moves cells those machines' engines name, and its roots are the
        ;; writing machine's. Leave the store grown until the world ends.
        (if (!= (-> st machines) nil) (return 0))
        (let ((coco_store tmp)
              (size_t nroots . 0) (size_t * roots . nil) (size_t k . 0)
              (size_t hmark . #'(-> m heap_len)))
          (memset (aof tmp) 0 (sizeof coco_store))
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (set nroots (+ nroots ($ (coco-pred-at (-> st predp) i) nclauses))))
          (set nroots (+ nroots (-> st nglobals)))
          (for ((size_t i . 0)) (< i (-> st nroots)) ((++ i))
            (set nroots (+ nroots (cof ($ (nth i (-> st roots)) len)))))
          (set roots (cast (size_t *) (malloc (* (+ nroots 1) (sizeof size_t)))))
          (if (== roots nil) (return 0))
          ;; ONE ALLOCATION, EXACTLY SIZED, AND THE REASON IS A FROZEN MACHINE.
          ;; The new array used to be grown by `coco_store_grow' as the copy
          ;; filled it -- doubling from 64 cells, which for a large store is a
          ;; LADDER of large reallocs (16, 32, 64, 128, 256 MB), each one a
          ;; fresh region while the old store is still held, and the last rung
          ;; overshooting past what was needed. Reported from CivV as a window
          ;; that took a 16 GB machine down with 122 MALLOC_REALLOC regions of
          ;; 128 MB while `store_used' read 28 MB: the peak is not the store,
          ;; it is what compacting the store transiently costs. Measured here,
          ;; 64 MB live: 86 large blocks and a 580 MB peak.
          ;;
          ;; What is live cannot exceed what is there, so `len' is an upper
          ;; bound known before the walk starts: size the array to exactly
          ;; that and `coco_store_grow' never fires, because the cap is
          ;; already enough.
          ;;
          ;; A SEMISPACE WAS TRIED HERE AND REVERTED, because the thing it
          ;; bought was already free. Keeping the old array to copy into next
          ;; time removes a large malloc and a large free per compaction --
          ;; and those cost nothing on Darwin: 100 alloc/free cycles of 128 MB
          ;; leave `phys_footprint' at ZERO, measured, so a freed large region
          ;; goes back at once rather than sitting dirty in the allocator's
          ;; cache. The spare's footprint was real and its benefit was not.
          ;; (Which also says what CivV's 122 live MALLOC_REALLOC regions of
          ;; 128 MB were NOT: not allocator debris, so something held them.)
          (let ((size_t want . #'(? (> (-> st len) 0) (-> st len) 1)))
            (set ($ tmp cells) (cast (u64 *) (malloc (* want (sizeof u64)))))
            (if (== ($ tmp cells) nil) (block (free roots) (return 0)))
            (set ($ tmp cap) want))
          ;; pass one: every live term through the heap into the fresh array,
          ;; in a fixed order -- the predicates' clauses, then the globals
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) i))))
              (for ((size_t j . 0)) (< j (-> p nclauses)) ((++ j))
                (let ((size_t h . #'(coco_store_get m st (nth j (-> p clauses)))))
                  (set (nth k roots) (coco_store_put (aof tmp) m h))
                  (set k (+ k 1))
                  (set (-> m heap_len) hmark)))))
          (for ((size_t i . 0)) (< i (-> st nglobals)) ((++ i))
            (let ((size_t h . #'(coco_store_get m st ($ (nth i (-> st globals)) cell))))
              (set (nth k roots) (coco_store_put (aof tmp) m h))
              (set ($ (nth i (-> st globals)) size) (- ($ tmp len) (nth k roots)))
              (set k (+ k 1))
              (set (-> m heap_len) hmark)))
          (for ((size_t i . 0)) (< i (-> st nroots)) ((++ i))
            (let ((coco_rootset * rs . #'(aof (nth i (-> st roots)))))
              (for ((size_t j . 0)) (< j (cof (-> rs len))) ((++ j))
                (let ((size_t h . #'(coco_store_get m st (nth j (cof (-> rs cells))))))
                  (set (nth k roots) (coco_store_put (aof tmp) m h))
                  (set k (+ k 1))
                  (set (-> m heap_len) hmark)))))
          ;; an allocation that failed leaves the old store exactly as it was
          ;; an allocation that failed leaves the old store exactly as it was
          (if (or ($ tmp oom) (-> m oom))
              (block (free ($ tmp cells)) (free roots) (return 0)))
          ;; pass two: the roots move, and nothing else does. Each clause's
          ;; compiled program stays its own, found by the old cell while the
          ;; table still knows it, and is keyed by the new one below
          (set k 0)
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) i))))
              (for ((size_t j . 0)) (< j (-> p nclauses)) ((++ j))
                (let ((coco_code * cd . #'(cast (coco_code *) (nth j (-> p codes)))))
                  (if (== cd nil) (set cd (coco_code_find st (nth j (-> p clauses)))))
                  (if (!= cd nil) (set (-> cd kept) 1))
                  (set (nth j (-> p codes)) (cast (void *) cd)))
                (set (nth j (-> p clauses)) (nth k roots))
                (set k (+ k 1)))))
          (for ((size_t i . 0)) (< i (-> st nglobals)) ((++ i))
            (set ($ (nth i (-> st globals)) cell) (nth k roots))
            (set k (+ k 1)))
          (for ((size_t i . 0)) (< i (-> st nroots)) ((++ i))
            (let ((coco_rootset * rs . #'(aof (nth i (-> st roots)))))
              (for ((size_t j . 0)) (< j (cof (-> rs len))) ((++ j))
                (set (nth j (cof (-> rs cells))) (nth k roots))
                (set k (+ k 1)))))
          ;; and the slack the upper bound left over goes back: a SHRINKING
          ;; realloc trims the tail rather than copying, so the store really
          ;; does come down to what it holds, which is what the number
          ;; `garbage_collect/0' moves ought to mean.
          (if (< ($ tmp len) ($ tmp cap))
              (let ((size_t keep . #'(? (> ($ tmp len) 0) ($ tmp len) 1))
                    (void * trimmed))
                (set trimmed (realloc (cast (void *) ($ tmp cells)) (* keep (sizeof u64))))
                (if (!= trimmed nil)
                    (block (set ($ tmp cells) (cast (u64 *) trimmed))
                           (set ($ tmp cap) keep)))))
          (free (-> st cells))
          (set (-> st cells) ($ tmp cells))
          (set (-> st len) ($ tmp len))
          (set (-> st cap) ($ tmp cap))
          (set (-> st mark) ($ tmp len))
          (set (-> st dead) 0)
          (set (-> st ncompacts) (+ (-> st ncompacts) 1))
          ;; EVERY CLAUSE CELL MOVED, so every compiled clause is keyed by a
          ;; cell that no longer means it -- and was compiled again on the
          ;; next ask through 1.9.2. It is KEYED AGAIN instead (Stage 5): a
          ;; code holds constants and functor ids, never a store cell, so
          ;; it is as good as it was, and an environment on the heap may be
          ;; part way through it, so it may not be freed under a running
          ;; body -- and a compaction runs at a safe point INSIDE a query
          ;; (a throw, a findall). What no live clause owns any more goes
          ;; the way a dead clause's code goes (`coco_code_retire').
          (for ((size_t i . 0)) (< i (-> st code_cap)) ((++ i))
            (if (!= (nth i (-> st code_keys)) 0)
                (let ((coco_code * cd . #'(cast (coco_code *) (nth i (-> st code_vals)))))
                  (if (not (-> cd kept)) (coco_code_retire st cd))
                  (set (nth i (-> st code_keys)) 0)
                  (set (nth i (-> st code_vals)) nil))))
          (set (-> st code_len) 0)
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) i))))
              (for ((size_t j . 0)) (< j (-> p nclauses)) ((++ j))
                (let ((coco_code * cd . #'(cast (coco_code *) (nth j (-> p codes)))))
                  (if (and (!= cd nil) (-> cd kept))
                      (block (set (-> cd kept) 0)
                             ;; a table that would not grow loses the key,
                             ;; not the code: the predicate's slot keeps it
                             (coco_code_put st (nth j (-> p clauses)) cd)))))))
          (free roots)
          (return 1)))

  (func coco_store_maybe_compact ((coco_store * st) (coco_machine * m)) (out int)
        (if (!= (-> st machines) nil) (return 0))
        (if (!= (-> st private) 0) (return 0))
        (let ((size_t growth . #'(- (-> st len) (-> st mark)))
              (size_t dead . #'(-> st dead))
              (size_t live . #'(? (> (-> st len) (-> st dead)) (- (-> st len) (-> st dead)) 0)))
          ;; enough known dead, and more of them than live
          (if (and (>= dead 4194304) (>= dead live)) (return (coco_store_compact st m)))
          ;; or, whatever was counted, grown by as much again as was live
          (if (and (>= growth 4194304) (>= growth (-> st mark))) (return (coco_store_compact st m)))
          (return 0)))

  (func coco_store_root_push ((coco_store * st) (size_t ** cells) (size_t * len)) (out int)
        (if (not (coco_store_grow st (cast (void **) (aof (-> st roots)))
                                (aof (-> st root_cap)) (+ (-> st nroots) 1)
                                (sizeof coco_rootset)))
            (return 0))
        (set ($ (nth (-> st nroots) (-> st roots)) cells) cells)
        (set ($ (nth (-> st nroots) (-> st roots)) len) len)
        (set (-> st nroots) (+ (-> st nroots) 1))
        (return 1))

  (func coco_store_root_pop ((coco_store * st))
        (if (> (-> st nroots) 0) (set (-> st nroots) (- (-> st nroots) 1))))

  ;;; The term is copied to the heap, measured there (`coco_store_get_span':
  ;;; the copy's length is not the span) and wound back.
  (func coco_store_orphan ((coco_store * st) (coco_machine * m) (size_t cell))
        ;; a clause's compiled program dies with it
        (coco_code_drop st cell)
        (let ((size_t mark . #'(-> m heap_len))
              (size_t span . 0))
          (coco_store_get_span m st cell (aof span))
          (set (-> st dead) (+ (-> st dead) span))
          (set (-> m heap_len) mark)))

  ;;; ---- predicates -------------------------------------------------------

  ;;; The predicate table at twice the size, or at 256 the first time, every
  ;;; entry put back from the predicates themselves.
  (static)
  (func coco_preds_rehash ((coco_store * st)) (out int)
        (let ((size_t ncap . #'(? (== (-> st pred_bucket_cap) 0) 256
                                  (* (-> st pred_bucket_cap) 2)))
              (size_t * nb . #'(cast (size_t *) (calloc ncap (sizeof size_t)))))
          (if (== nb nil) (block (set (-> st oom) 1) (return 0)))
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (let ((size_t j . #'(cast size_t
                                      (bitand (coco_name_arity_hash ($ (coco-pred-at (-> st predp) i) name)
                                                                    ($ (coco-pred-at (-> st predp) i) arity))
                                              (cast u64 (- ncap 1))))))
              (while (!= (nth j nb) 0)
                (set j (bitand (+ j 1) (- ncap 1))))
              (set (nth j nb) (+ i 1))))
          (free (-> st pred_buckets))
          (set (-> st pred_buckets) nb)
          (set (-> st pred_bucket_cap) ncap)
          (return 1)))

  ;;; The slot NAME/ARITY is in, or would go into: probing from its hash, the
  ;;; first slot that holds it or is empty. `coco_pred_make' keeps the table
  ;;; under half full, so the probe always ends.
  (static)
  (func coco_pred_slot ((coco_store * st) (u64 name) (u32 arity)) (out size_t)
        (let ((size_t mask . #'(- (-> st pred_bucket_cap) 1))
              (size_t j . 0))
          (set j (cast size_t (bitand (coco_name_arity_hash name arity) (cast u64 mask))))
          (while (!= (nth j (-> st pred_buckets)) 0)
            (let ((size_t i . #'(- (nth j (-> st pred_buckets)) 1)))
              (if (and (== ($ (coco-pred-at (-> st predp) i) name) name)
                       (== ($ (coco-pred-at (-> st predp) i) arity) arity))
                  (return j)))
            (set j (bitand (+ j 1) mask)))
          (return j)))

  ;;; HASHED, as the functor table is and for the same reason: a store that
  ;;; holds a library has hundreds of predicates, and this is asked on every
  ;;; call -- as a scan it was 15 % of the program's instructions. It
  ;;; answers NPREDS for a predicate the store does not have, as it always
  ;;; did, and a store with no table yet has no predicate yet.
  (func coco_pred_find ((coco_store * st) (u64 name) (u32 arity)) (out size_t)
        (if (== (-> st pred_buckets) nil) (return (-> st npreds)))
        (let ((size_t j . #'(coco_pred_slot st name arity)))
          (if (== (nth j (-> st pred_buckets)) 0) (return (-> st npreds)))
          (return (- (nth j (-> st pred_buckets)) 1))))

  (static) (decl) (func coco_pred_make ((coco_store * st) (u64 name) (u32 arity)) (out size_t))

  ;;; ROOM FOR ONE PREDICATE MORE (3.64.0): a chunk of 256 when the chunks
  ;;; are full, the table grown by a pointer to each of its predicates, and
  ;;; the predicates already made left where they stand (`coco-pred-at').
  ;;; The table itself may move: nobody holds a place in it. Through 3.63.2 the
  ;;; predicates were one array grown by realloc, and a green task waiting
  ;;; at a barrier with one of them in hand -- a clause compiled at its first
  ;;; call, an index built -- held freed memory once another task's write
  ;;; made a predicate past the array's room. 0 where memory would not grow.
  ;;; The chunk's predicates are zeroed one at a time as they are made
  ;;; (`coco_pred_make'), so it is not zeroed whole: a calloc of each chunk
  ;;; cost every start 124 000 instructions of memset.
  (static)
  (func coco_preds_block ((coco_store * st)) (out int)
        (if (< (-> st npreds) (-> st pred_cap)) (return 1))
        (let ((size_t b . #'(/ (-> st pred_cap) 256))
              (coco_pred * blk . nil))
          (if (not (coco_store_grow_meta st (cast (void **) (aof (-> st pchunk))) (aof (-> st pchunk_cap))
                                         (+ b 1) (sizeof (coco_pred *))))
              (return 0))
          (if (not (coco_store_grow_meta st (cast (void **) (aof (-> st predp))) (aof (-> st predp_cap))
                                         (+ (-> st pred_cap) 256) (sizeof (coco_pred *))))
              (return 0))
          ;; a block a task makes in a world on lines of its own (3.78.19,
          ;; `coco-meta-moved'): every call reads its predicates
          (set blk (cast (coco_pred *) (coco-meta-moved st nil 0 (* 256 (sizeof coco_pred))
                                                        (malloc (* 256 (sizeof coco_pred))))))
          (if (== blk nil) (block (set (-> st oom) 1) (return 0)))
          (set (nth b (-> st pchunk)) blk)
          (for ((size_t k . 0)) (< k 256) ((++ k))
            (set (nth (+ (-> st pred_cap) k) (-> st predp)) (aof (nth k blk))))
          (set (-> st pred_cap) (+ (-> st pred_cap) 256))
          (return 1)))

  (func coco_pred_intern ((coco_store * st) (u64 name) (u32 arity)) (out size_t)
        (return (coco_pred_make st name arity)))

  (static)
  (func coco_pred_make ((coco_store * st) (u64 name) (u32 arity)) (out size_t)
        (let ((size_t i . #'(coco_pred_find st name arity)))
          (if (< i (-> st npreds)) (return i))
          ;; THE FIRST CALL CREATES IT (2.9.0): the one store is changed
          ;; with every other worker stopped at its safe point.
          (with-green-write nil
          ;; THE FIND AGAIN, NOW THAT THE OTHER WORKERS ARE STOPPED. The
          ;; find above is lock-free and this is a double-checked lock: a
          ;; reader's call creates a predicate too (`coco_pred_of'), and
          ;; one may have made the entry between that find and this
          ;; barrier. Creating a SECOND entry for the same name overwrites
          ;; the bucket slot, and the clauses already attached to the
          ;; first become unreachable -- a concurrent stress lost each
          ;; writer's first one or two asserts that way. Under the barrier
          ;; the recheck sees the stable state, the world lock having
          ;; ordered the two creations.
          (let ((size_t j . #'(coco_pred_find st name arity)))
            (if (< j (-> st npreds)) (return j)))
          ;; under half full before the probe that places it
          (if (> (* (+ (-> st npreds) 1) 2) (-> st pred_bucket_cap))
              (if (not (coco_preds_rehash st)) (return (-> st npreds))))
          (if (not (coco_preds_block st)) (return (-> st npreds)))
          (memset (aof (coco-pred-at (-> st predp) (-> st npreds))) 0 (sizeof coco_pred))
          (set ($ (coco-pred-at (-> st predp) (-> st npreds)) name) name)
          (set ($ (coco-pred-at (-> st predp) (-> st npreds)) arity) arity)
          (set (nth (coco_pred_slot st name arity) (-> st pred_buckets)) (+ (-> st npreds) 1))
          (set (-> st npreds) (+ (-> st npreds) 1))
          (return (- (-> st npreds) 1)))))

  (func coco_pred_of ((coco_store * st) (coco_machine * m) (size_t goal)) (out size_t)
        (set goal (coco_deref m goal))
        (if (not (coco_is_callable m goal)) (return (-> st npreds)))
        (return (coco_pred_make st (coco_name_of m goal) (coco_arity m goal))))

  ;;; THE DECLARATIONS A BACKEND HAS ALREADY SHOWN US, for the next store.
  ;;;
  ;;; A `run_isolated/2' half is a fresh store. A call to a predicate the
  ;;; backend DECLARED dynamic but never wrote to has no clauses to fetch,
  ;;; so the store does not know it is dynamic and the engine asks the
  ;;; backend for every declaration (`coco_store_warm'). The first half pays
  ;;; that scan once; every later half paid it again, because the knowledge
  ;;; -- "this name/arity is dynamic even with no rows" -- lived only in the
  ;;; store that had just died. Measured from CivV: three empty dynamics,
  ;;; one per computer half, 64, 62 and 66 ms; one seeded row cured each
  ;;; half because then the fetch had a clause.
  ;;;
  ;;; The declaration is program text, not a row: abolish/1 alone withdraws
  ;;; it (3.36.0, `coco_dynamic_forget'), and it is the same in every store
  ;;; of one backend. Remembering it here
  ;;; lets `coco_pred_ensure' mark a fresh store's empty predicate dynamic
  ;;; after its one per-predicate fetch, with no whole-store warm. Only a
  ;;; store WITH a backend consults it, so a local store keeps raising for
  ;;; a name nobody declared.
  (struct coco_dynamic_ent
    (member char * name)
    (member u32    arity))

  (static) (var coco_dynamic_ent * coco_dynamic_tab . nil)
  (static) (var size_t coco_dynamic_n . 0)
  (static) (var size_t coco_dynamic_cap . 0)
  ;; written by a `run_isolated' half and read by the next, possibly on
  ;; different OS threads; the declaration is monotonic, the table is not
  (static) (var pthread_mutex_t coco_dynamic_mx . PTHREAD_MUTEX_INITIALIZER)

  (static)
  (func coco_dynamic_has_locked ((const char * name) (u32 arity)) (out int)
        (for ((size_t i . 0)) (< i coco_dynamic_n) ((++ i))
          (if (and (== arity ($ (nth i coco_dynamic_tab) arity))
                   (== 0 (strcmp name ($ (nth i coco_dynamic_tab) name))))
              (return 1)))
        (return 0))

  (func coco_dynamic_known ((const char * name) (u32 arity)) (out int)
        (if (== name nil) (return 0))
        (pthread_mutex_lock (aof coco_dynamic_mx))
        (let ((int has . #'(coco_dynamic_has_locked name arity)))
          (pthread_mutex_unlock (aof coco_dynamic_mx))
          (return has)))

  (func coco_dynamic_remember ((const char * name) (u32 arity)) (out int)
        (if (== name nil) (return 0))
        (pthread_mutex_lock (aof coco_dynamic_mx))
        (let ((int answer . 0) (size_t len . 0) (char * copy . nil))
          (if (coco_dynamic_has_locked name arity)
              (block (pthread_mutex_unlock (aof coco_dynamic_mx)) (return 0)))
          (if (>= coco_dynamic_n coco_dynamic_cap)
              (let ((size_t ncap . #'(? (== coco_dynamic_cap 0) 64 (* coco_dynamic_cap 2)))
                    (void * nb))
                (set nb (realloc (cast (void *) coco_dynamic_tab)
                                 (* ncap (sizeof coco_dynamic_ent))))
                (if (== nb nil)
                    (block (pthread_mutex_unlock (aof coco_dynamic_mx)) (return 0)))
                (set coco_dynamic_tab (cast (coco_dynamic_ent *) nb))
                (set coco_dynamic_cap ncap)))
          (set len (+ (strlen name) 1))
          (set copy (cast (char *) (malloc len)))
          (if (!= copy nil)
              (block
               (memcpy (cast (void *) copy) (cast (const void *) name) len)
               (set ($ (nth coco_dynamic_n coco_dynamic_tab) name) copy)
               (set ($ (nth coco_dynamic_n coco_dynamic_tab) arity) arity)
               (set coco_dynamic_n (+ coco_dynamic_n 1))
               (set answer 1)))
          (pthread_mutex_unlock (aof coco_dynamic_mx))
          (return answer)))

  ;;; ...AND WITHDRAWN BY abolish/1 (3.36.0, `coco_pred_undeclare'): a store
  ;;; made after it is not told the name was ever declared.
  (func coco_dynamic_forget ((const char * name) (u32 arity))
        (if (== name nil) (return))
        (pthread_mutex_lock (aof coco_dynamic_mx))
        (for ((size_t i . 0)) (< i coco_dynamic_n) ((++ i))
          (if (and (== arity ($ (nth i coco_dynamic_tab) arity))
                   (== 0 (strcmp name ($ (nth i coco_dynamic_tab) name))))
              (block
                (free (cast (void *) ($ (nth i coco_dynamic_tab) name)))
                (set coco_dynamic_n (- coco_dynamic_n 1))
                (set (nth i coco_dynamic_tab) (nth coco_dynamic_n coco_dynamic_tab))
                break)))
        (pthread_mutex_unlock (aof coco_dynamic_mx)))

  ;;; The backend is asked once per predicate and the answer is remembered
  ;;; whether or not it produced clauses -- otherwise a call to an undefined
  ;;; predicate inside a loop is a database round trip per iteration.
  ;;;
  ;;; A READ THAT FAILED IS NO ANSWER (2.11.1), and is not remembered as one.
  ;;; It answers 0 with the reason on the store (`fetch_err', `fetch_pi',
  ;;; `fetch_oom') and leaves nothing behind: the clauses the fetch had added
  ;;; before it failed are taken out again, the predicate is not marked
  ;;; loaded, so the next call asks the backend again, and `empty_fetch'
  ;;; stays unset, so the pre-warm never takes a failure for an absence.
  ;;; Through 2.11.0 the predicate was marked loaded before the fetch and
  ;;; kept whatever arrived, and every caller ignored the answer: one row
  ;;; this binary could not read and the predicate answered the others in
  ;;; silence -- and the next `assertz' rewrote it whole from that copy, and
  ;;; the database lost the row (an outside review's finding, reproduced on
  ;;; the server). Every caller now raises on the 0 (`coco_fetch_error' in
  ;;; lib/solve.cicili), and a write refuses before it touches the predicate.
  ;;;
  ;;; Out of range answers 1: there is nothing to ask about, and the caller's
  ;;; own test of the index is what refuses it.
  (static) (decl) (func coco_pred_cut_back ((coco_store * st) (size_t pi) (size_t keep)))

  (func coco_pred_ensure ((coco_store * st) (size_t pi)) (out int)
        (if (>= pi (-> st npreds)) (return 1))
        (if ($ (coco-pred-at (-> st predp) pi) loaded) (return 1))
        (with-green-write nil
          (if ($ (coco-pred-at (-> st predp) pi) loaded) (return 1))
          ;; loaded BEFORE the hook runs: the clauses it asserts find the
          ;; predicate loaded, and do not ask the backend again
          (set ($ (coco-pred-at (-> st predp) pi) loaded) 1)
          (if (== (-> st fetch) nil) (return 1))
          (set (nth 0 (-> st fetch_err)) (cast char 0))
          (set (-> st fetch_oom) 0)
        ;; WHETHER THE BACKEND HAD ANYTHING, recorded where it can be seen:
        ;; the fetch is the only moment the difference shows, because a module's
        ;; predicate has its own clauses either way. `coco_store_prewarm' reads it.
        (let ((size_t before . #'($ (coco-pred-at (-> st predp) pi) nclauses))
              (size_t len0 . #'(-> st len))
              (int rc . #'((-> st fetch) st (-> st ctx)
                                            ($ (coco-pred-at (-> st predp) pi) name)
                                            ($ (coco-pred-at (-> st predp) pi) arity))))
          (if (== rc 0)
              (block
                (coco_pred_cut_back st pi before)
                ;; the cells those clauses were put into belong to nothing
                ;; now; counted, the next compaction takes them
                (if (> (-> st len) len0)
                    (set (-> st dead) (+ (-> st dead) (- (-> st len) len0))))
                (set ($ (coco-pred-at (-> st predp) pi) loaded) 0)
                (set (-> st fetch_pi) pi)
                (if (== (nth 0 (-> st fetch_err)) (cast char 0))
                    (snprintf (-> st fetch_err) 256 "%s" "the knowledge base did not answer"))
                (return 0)))
          (if (== ($ (coco-pred-at (-> st predp) pi) nclauses) before)
              (set ($ (coco-pred-at (-> st predp) pi) empty_fetch) 1))
          ;; A DECLARATION AN EARLIER STORE ALREADY FOUND: mark this empty
          ;; predicate dynamic and let the call fail here. The alternative
          ;; is the whole-store warm on the existence-error path below,
          ;; every fresh `run_isolated' half. A NAME the backend has rows
          ;; for never reaches this test, because the fetch added them.
          (if (and (!= (-> st warm) nil)
                   (== ($ (coco-pred-at (-> st predp) pi) nclauses) before)
                   (not ($ (coco-pred-at (-> st predp) pi) dynamic))
                   (!= (-> st name_m) nil)
                   (coco_dynamic_known
                    (coco_atom_name (cast (coco_machine *) (-> st name_m))
                                    ($ (coco-pred-at (-> st predp) pi) name))
                    ($ (coco-pred-at (-> st predp) pi) arity)))
              (set ($ (coco-pred-at (-> st predp) pi) dynamic) 1))
          (return rc))))

  ;;; THE CLAUSES PI HAS, READ FROM THE BACKEND FIRST WHERE THEY WERE NOT
  ;;; (2.11.1): `coco_pred_ensure', answering the count the step tests next
  ;;; anyway, and 0 when the read failed. So a failed read takes the step's
  ;;; way for a predicate with no clauses, where `loaded' (0 only after a
  ;;; failed read) tells it from one and the step raises it, and the way for
  ;;; a predicate with clauses has no test it did not have through 2.11.0.
  ;;; (weak), never inlined: a test of the answer in the step loop itself
  ;;; gave the failure 3/8 of every call's path in clang's estimate, which put
  ;;; the loop's calls of `coco_push_choice' and `coco_arg_key' under its
  ;;; threshold for a cold call site, and left them out of line (queens
  ;;; +3.1 % of its work, tools/flow/zero.sh). A predicate read already is
  ;;; answered here, without the call of `coco_pred_ensure' (two calls a
  ;;; call cost naive reverse 2.6 % of its work). AND COLD (2.11.3): the
  ;;; step calls it only for a predicate not read yet (`coco_pred_count').
  (weak) (cold)
  (func coco_pred_ready ((coco_store * st) (size_t pi)) (out size_t)
        (if ($ (coco-pred-at (-> st predp) pi) loaded)
            (return ($ (coco-pred-at (-> st predp) pi) nclauses)))
        (if (not (coco_pred_ensure st pi)) (return 0))
        (return ($ (coco-pred-at (-> st predp) pi) nclauses)))

  ;;; THE COUNT THE STEP TESTS (2.11.3): a predicate read already answers
  ;;; its clause count here, inline, and only one not read yet -- its first
  ;;; call, or the next one after a read that failed -- goes to
  ;;; `coco_pred_ready'. THE CALL WAS THE GREEN WORLD'S WHOLE COST TO THE
  ;;; UNTRACED ENGINE: through 2.8.1 clang inlined `coco_pred_ensure' into
  ;;; the step, whose price a call was its first two tests; 2.9.0's write
  ;;; barrier made its body too big to inline, and every call of a plain
  ;;; predicate paid a call of 19 instructions (nrev +2.53 % of its work,
  ;;; queens +1.39 %, lookup +1.13 %), which no release counted; 2.11.1's
  ;;; `coco_pred_ready' made it 12. Answered inline, the test costs the
  ;;; loop nothing that counts -- `coco_engine_run' ran a few instructions
  ;;; FEWER -- and against 2.11.2 nrev runs 1.87 % fewer instructions,
  ;;; queens 0.73 %, lookup 0.98 % (tools/flow/zero.sh) and the loop 1.52 %
  ;;; (STATUS.md, 2.11.3).
  (static) (inline)
  (func coco_pred_count ((coco_store * st) (size_t pi)) (out size_t)
        (if ($ (coco-pred-at (-> st predp) pi) loaded)
            (return ($ (coco-pred-at (-> st predp) pi) nclauses)))
        (return (coco_pred_ready st pi)))

  ;;; ------------------------------------------------------------------
  ;;; PRE-WARM: the predicates a MODULE owns that the knowledge base has no
  ;;; rows for, remembered once for the whole process.
  ;;;
  ;;; WHY IT EXISTS. `run_isolated/2' gives every httpd request a fresh store,
  ;;; and a fresh store asks the backend once per predicate -- `coco_pred_ensure'
  ;;; above. Measured on a page that reads one row over the binary protocol:
  ;;; 52 predicates asked A REQUEST, 6.06 ms of a 10.47 ms request spent inside
  ;;; the hook, 117 us a fetch, against 0.99 ms for the same page on a store
  ;;; that persists. FIFTY-ONE of the 52 are a module's own -- 27 of
  ;;; library(http), 18 of library(httpd), six of the tier-1 libraries -- and
  ;;; every one is a question whose answer cannot change while the process
  ;;; runs, because the module registry is fixed once the modules are loaded.
  ;;;
  ;;; ONLY THE ABSENCE IS REMEMBERED. A predicate joins this table when a real
  ;;; fetch was made for it and the backend added NOTHING, so a later store may
  ;;; mark it loaded without asking. If the backend DID have rows the predicate
  ;;; is not in the table and every store fetches it exactly as before. The
  ;;; program's own predicates are never in it, because only a MUTED assert
  ;;; sets `library' -- which is the same flag `listing' uses to tell the
  ;;; library from the program.
  ;;;
  ;;; THE STALENESS CONTRACT IS NARROW AND IS THE WHOLE COST. Another process
  ;;; asserting into a predicate a MODULE defines -- `member/2',
  ;;; `httpd_route/3' -- after the pre-warm will not be seen here. Nothing else
  ;;; changes: the program's own predicates are fetched on every request with
  ;;; the freshness they always had. It is the module registry's own contract,
  ;;; and it carries the module registry's own rule -- PRE-WARM BEFORE YOU
  ;;; SPAWN. The table is written once and then read by every worker thread
  ;;; with no lock, exactly as `use_module' is.
  (struct coco_prewarm_ent
    (member char * name)
    (member u32    arity))

  (static) (var coco_prewarm_ent * coco_prewarm_tab . nil)
  (static) (var size_t coco_prewarm_n . 0)
  (static) (var size_t coco_prewarm_cap . 0)

  (func coco_prewarm_has ((const char * name) (u32 arity)) (out int)
        (if (== coco_prewarm_tab nil) (return 0))
        (for ((size_t i . 0)) (< i coco_prewarm_n) ((++ i))
          (if (and (== arity ($ (nth i coco_prewarm_tab) arity))
                   (== 0 (strcmp name ($ (nth i coco_prewarm_tab) name))))
              (return 1)))
        (return 0))

  (static)
  (func coco_prewarm_add ((const char * name) (u32 arity)) (out int)
        (if (coco_prewarm_has name arity) (return 0))
        (if (>= coco_prewarm_n coco_prewarm_cap)
            (let ((size_t ncap . #'(? (== coco_prewarm_cap 0) 64 (* coco_prewarm_cap 2)))
                  (void * nb))
              (set nb (realloc (cast (void *) coco_prewarm_tab)
                               (* ncap (sizeof coco_prewarm_ent))))
              (if (== nb nil) (return 0))
              (set coco_prewarm_tab (cast (coco_prewarm_ent *) nb))
              (set coco_prewarm_cap ncap)))
        (let ((size_t len . #'(+ (strlen name) 1))
              (char * copy))
          (set copy (cast (char *) (malloc len)))
          (if (== copy nil) (return 0))
          (memcpy (cast (void *) copy) (cast (const void *) name) len)
          (set ($ (nth coco_prewarm_n coco_prewarm_tab) name) copy)
          (set ($ (nth coco_prewarm_n coco_prewarm_tab) arity) arity)
          (set coco_prewarm_n (+ coco_prewarm_n 1))
          (return 1)))

  ;;; Fetch every library predicate this store has not asked about yet, and
  ;;; remember the ones the backend had nothing for. The clause count before
  ;;; and after is what says so: a module's predicate already HAS clauses --
  ;;; its own -- so an empty predicate is not the test, an unchanged one is.
  ;;;
  ;;; `predp' is re-read through the store on every line rather than held: a
  ;;; fetch may intern predicates of its own and grow the table, which is
  ;;; also why the loop re-reads `npreds'.
  (func coco_store_prewarm ((coco_store * st) (coco_machine * m)) (out size_t)
        (let ((size_t added . 0))
          (if (== (-> st fetch) nil) (return 0))
          ;; the names this pass interns are the root's; the declaration
          ;; cache in `coco_pred_ensure' resolves through the same table
          (if (== (-> st name_m) nil)
              (set (-> st name_m) (cast (void *) (coco_troot m))))
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (if ($ (coco-pred-at (-> st predp) i) library)
                (block
                  ;; A LIBRARY PREDICATE THIS STORE HAS NOT ASKED ABOUT IS
                  ;; ASKED NOW; one already asked carries its own answer in
                  ;; `empty_fetch', so the pass does not depend on whether
                  ;; the program called something before it got here. It was
                  ;; ordering alone that left `httpd_option/3' out, because
                  ;; `httpd_serve/3' reads its own options before it starts
                  ;; the pool -- one fetch a request, for a predicate the
                  ;; pass was written to cover.
                  (if (not ($ (coco-pred-at (-> st predp) i) loaded)) (coco_pred_ensure st i))
                  (if ($ (coco-pred-at (-> st predp) i) empty_fetch)
                      (if (coco_prewarm_add (coco_atom_name m ($ (coco-pred-at (-> st predp) i) name))
                                            ($ (coco-pred-at (-> st predp) i) arity))
                          (set added (+ added 1)))))))
          (return added)))

  (func coco_store_warm ((coco_store * st)) (out int)
        (if (== (-> st warm) nil) (return 1))
        (let ((int ok . #'((-> st warm) st (-> st ctx))))
          ;; KEEP WHAT THE WARM TAUGHT THE NEXT STORE: the declarations it
          ;; loaded, name by name. `run_isolated' dies; this table does not.
          (if (and (!= ok 0) (!= (-> st name_m) nil))
              (let ((coco_machine * nm . #'(cast (coco_machine *) (-> st name_m))))
                (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
                  (if ($ (coco-pred-at (-> st predp) i) dynamic)
                      (coco_dynamic_remember
                       (coco_atom_name nm ($ (coco-pred-at (-> st predp) i) name))
                       ($ (coco-pred-at (-> st predp) i) arity))))))
          (return ok)))

  ;;; `:- dynamic name/arity'. The predicate is INTERNED and not merely looked
  ;;; up: declaring one is how a program says it exists, and a dynamic
  ;;; predicate with no clauses yet is a predicate, not a typo.
  (func coco_pred_dynamic ((coco_store * st) (u64 name) (u32 arity)) (out int)
        (let ((size_t pi . #'(coco_pred_intern st name arity)))
          (if (>= pi (-> st npreds)) (return 0))
          ;; already declared: say so and do not tell the backend twice
          (if ($ (coco-pred-at (-> st predp) pi) dynamic) (return 1))
          (set ($ (coco-pred-at (-> st predp) pi) dynamic) 1)
          (if (coco_store_is_muted st) (return 1))
          (if (== (-> st on_dynamic) nil) (return 1))
          (set (nth 0 (-> st write_err)) (cast char 0))
          (let ((int ok . #'((-> st on_dynamic) st (-> st ctx) pi)))
            (if ok (return 1)))
          ;; REFUSED BY THE BACKEND (3.0.3): not declared, and said so in the
          ;; backend's words, never memory's
          (set ($ (coco-pred-at (-> st predp) pi) dynamic) 0)
          (if (== (nth 0 (-> st write_err)) (cast char 0))
              (snprintf (-> st write_err) 256 "the knowledge base refused the declaration"))
          (return -1)))

  ;;; ABOLISH/1 TAKES THE DECLARATIONS AWAY (3.36.0, swipl's
  ;;; abolishProcedure, which resets a predicate's attributes): dynamic,
  ;;; discontiguous and multifile, public, volatile, transparent, a
  ;;; non-terminal and what the tracer hides, so a call of it raises
  ;;; existence_error as one never defined does. The
  ;;; next store this process makes is not told it was dynamic
  ;;; (`coco_dynamic_forget'), and the backend hears it, the predicate's
  ;;; DYNAMIC 0 (`on_dynamic', which takes the declaration's row away), as
  ;;; it heard the declaration -- never while the store is muted. WHETHER OR
  ;;; NOT THIS PROCESS KNEW IT DYNAMIC: a declaration is learnt from the
  ;;; backend only on the way to an existence error (`warmed', the step),
  ;;; so a process that met the predicate's clauses first never read the
  ;;; row, and the first cut, which told the backend of a declaration it
  ;;; knew alone, left the row standing -- the call after abolish/1 failed,
  ;;; its warm finding the row, and the next process found it dynamic. 1,
  ;;; or -1 the backend refused it (`write_err'), the predicate undeclared
  ;;; here all the same.
  (func coco_pred_undeclare ((coco_store * st) (size_t pi)) (out int)
        (if (>= pi (-> st npreds)) (return 1))
        (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) pi))))
          (set (-> p dynamic) 0)
          (set (-> p declared) 0)
          (set (-> p pattrs) 0)
          ;; and what predicate_property/2 told of it (3.41.0), and the
          ;; spec its calls were qualified by (3.46.0): `pattrs' 0 above
          ;; forgets the call, so the next declaration is the step's again,
          ;; as swipl's abolish/1 drops the code its first call built
          (free (-> p pmeta))
          (set (-> p pmeta) nil)
          (free (-> p pmq))
          (set (-> p pmq) nil)
          (set (-> p pfile) 0)
          (set (-> p pline) 0)
          (if (!= (-> st name_m) nil)
              (coco_dynamic_forget (coco_atom_name (cast (coco_machine *) (-> st name_m)) (-> p name))
                                   (-> p arity)))
          (if (or (coco_store_is_muted st) (== (-> st on_dynamic) nil)) (return 1))
          (set (nth 0 (-> st write_err)) (cast char 0))
          (let ((int ok . #'((-> st on_dynamic) st (-> st ctx) pi)))
            (if ok (return 1)))
          (if (== (nth 0 (-> st write_err)) (cast char 0))
              (snprintf (-> st write_err) 256 "the knowledge base refused to forget the declaration"))
          (return -1)))

  ;;; A DECLARATION'S NAME (3.1.0): KIND 0 dynamic, 1 discontiguous, 2
  ;;; multifile, as the directive and the goal both say it
  (func coco_decl_kind ((int kind)) (out const char *)
        (if (== kind 1) (return "discontiguous"))
        (if (== kind 2) (return "multifile"))
        (if (== kind 3) (return "public"))
        (if (== kind 4) (return "volatile"))
        (if (== kind 5) (return "module_transparent"))
        (if (== kind 6) (return "thread_local"))
        (return "dynamic"))

  ;;; The kind a declaration's name is (3.2.0: the four after multifile/1,
  ;;; swipl's), or -1.
  (func coco_decl_kind_of ((const char * name)) (out int)
        (if (== 0 (strcmp name "dynamic")) (return 0))
        (if (== 0 (strcmp name "discontiguous")) (return 1))
        (if (== 0 (strcmp name "multifile")) (return 2))
        (if (== 0 (strcmp name "public")) (return 3))
        (if (== 0 (strcmp name "volatile")) (return 4))
        (if (== 0 (strcmp name "module_transparent")) (return 5))
        (if (== 0 (strcmp name "thread_local")) (return 6))
        (return -1))

  ;;; ONE INDICATOR DECLARED (3.1.0), what each part of a spec that passed
  ;;; its checks makes: KIND 0 dynamic/1 (`coco_pred_dynamic', remembered
  ;;; for the fresh stores of `run_isolated/2'), 1 discontiguous/1 and 2
  ;;; multifile/1 the predicate defined (`declared'); 3 public/1, 4
  ;;; volatile/1 and 5 module_transparent/1 an attribute and no more
  ;;; (`pattrs', 3.2.0), and 6 thread_local/1 dynamic/1's with two -- every
  ;;; dynamic predicate is the thread's own here, a thread having a store of
  ;;; its own. A name the engine or a compiled-in module implements, and
  ;;; which is not ISO, is the PROGRAM's from here on (`coco_pred_take_over'),
  ;;; as swipl makes a user's declaration of a system predicate a local
  ;;; one, which a call then finds with no clauses -- unless a library's
  ;;; load muted the store -- save by an attribute alone, which leaves it
  ;;; the system's, as swipl's public/1 does. 1 declared, 0 out of memory,
  ;;; -1 the backend refused it (`write_err').
  ;;; A NON-TERMINAL (3.14.0), swipl's predicate attribute: set by a grammar
  ;;; rule a load translates and by non_terminal/1, asked by expand_term/2
  ;;; before it gives a rule its declaration (`'$nt_known'/1'), told by
  ;;; predicate_property/2 (`pattrs' 16). 1, or 0 out of memory.
  (func coco_pred_nt_mark ((coco_store * st) (u64 nid) (u32 n)) (out int)
        (let ((size_t pi . #'(coco_pred_intern st nid n)))
          (if (>= pi (-> st npreds)) (return 0))
          (set ($ (coco-pred-at (-> st predp) pi) pattrs) (bitor ($ (coco-pred-at (-> st predp) pi) pattrs) 16))
          (return 1)))

  ;;; WHETHER A DECLARATION OF NID/N FINDS IT DEFINED (3.78.1,
  ;;; `coco_pred_defined') -- and the two hooks print_message/2 reads are
  ;;; however early a file declares them: swipl's system declares them
  ;;; before any file is read, where `run FILE' reads cocolog's library at
  ;;; the file's first goal, after the declarations that come first
  (static)
  (func coco_pred_known ((coco_store * st) (coco_machine * m) (u64 nid) (u32 n)) (out int)
        (if (== n 3)
            (let ((const char * nm . #'(coco_atom_name m nid)))
              (if (or (== 0 (strcmp nm "$prolog_message")) (== 0 (strcmp nm "$prolog_error_message")))
                  (return 1))))
        (return (coco_pred_defined st (coco_pred_find st nid n))))

  (func coco_decl_pi ((coco_store * st) (coco_machine * m) (u64 nid) (u32 n) (int kind)) (out int)
        (let ((size_t pi . 0) (int ok . 1) (size_t head . 0)
              ;; defined before this declaration, read before it sets anything
              (int known . #'(? (and (!= (-> m sfcur) 0) (<= kind 2))
                                (coco_pred_known st m nid n) 0)))
          (cond
            ((or (== kind 0) (== kind 6))
             (set ok (coco_pred_dynamic st nid n))
             (if (!= ok 1) (return ok))
             (coco_dynamic_remember (coco_atom_name m nid) n)
             (if (== kind 6)
                 (block
                   (set pi (coco_pred_intern st nid n))
                   (if (>= pi (-> st npreds)) (return 0))
                   (set ($ (coco-pred-at (-> st predp) pi) pattrs)
                        (bitor ($ (coco-pred-at (-> st predp) pi) pattrs) 10)))))
            ((or (== kind 1) (== kind 2))
             (set pi (coco_pred_intern st nid n))
             (if (>= pi (-> st npreds)) (return 0))
             (set ($ (coco-pred-at (-> st predp) pi) declared)
                  (bitor ($ (coco-pred-at (-> st predp) pi) declared) (? (== kind 2) 2 1))))
            (#t
             (set pi (coco_pred_intern st nid n))
             (if (>= pi (-> st npreds)) (return 0))
             (set ($ (coco-pred-at (-> st predp) pi) pattrs)
                  (bitor ($ (coco-pred-at (-> st predp) pi) pattrs) (? (== kind 3) 1 (? (== kind 4) 2 4))))
             (return 1)))
          ;; A DECLARATION REGISTERS THE PREDICATE WITH THE FILE BEING READ
          ;; (3.78.0, source_file/2), as swipl's: dynamic, discontiguous and
          ;; multifile -- not thread_local/1, public/1, volatile/1 or
          ;; module_transparent/1 (meta_predicate/1's is
          ;; `coco_pred_meta_note') -- and, as swipl's, only a predicate it
          ;; found undefined or the file's already (3.78.1, KNOWN): one
          ;; another file defined is that file's alone, and a hook swipl's
          ;; system declares is no file's
          (if (and (!= (-> m sfcur) 0) (<= kind 2))
              (let ((size_t spi . #'(coco_pred_intern st nid n)))
                (if (< spi (-> st npreds)) (coco_srcf_note st m spi known))))
          ;; A MODULE/2 READ'S DECLARATION NAMES THE PREDICATE'S MODULE, as
          ;; its first clause does (3.37.0, `coco_pred_note_mod'): listing/1
          ;; writes `:- dynamic mm:md/1.' of a predicate declared alone
          (if (!= (-> m ssu_mod) 0)
              (block
                (set pi (coco_pred_intern st nid n))
                (if (>= pi (-> st npreds)) (return 0))
                (if (and (== ($ (coco-pred-at (-> st predp) pi) pmod) 0)
                         (== ($ (coco-pred-at (-> st predp) pi) nclauses) 0))
                    (coco_pred_note_mod st m pi))))
          (if (and (or (not (coco_store_is_muted st)) (-> st ownload))
                   (== (coco_claim_kind m nid n) 1))
              (block
                (set pi (coco_pred_intern st nid n))
                (if (>= pi (-> st npreds)) (return 0))
                (if (not ($ (coco-pred-at (-> st predp) pi) taken))
                    (block
                      (if (== n 0)
                          (set head (coco_new_atom_id m nid))
                          (set head (coco_push_struct m (coco-cell FUN (coco_functor_id m nid n)) n)))
                      (if (and (> n 0) (== head 0)) (return 0))
                      (coco_pred_take_over st m pi head
                                           (bitand ($ (coco-pred-at (-> st predp) pi) pattrs) 96))))))
          ;; dynamic, discontiguous and multifile define (3.6.0, `ldefs'),
          ;; as swipl's; the other four do not
          (if (<= kind 2) (set (-> m ldefs) (+ (-> m ldefs) 1)))
          (return 1)))

  ;;; A SPEC A DIRECTIVE DECLARES AT ONCE (3.1.0): every part of it
  ;;; Name/Arity or Name//Arity, an atom and an arity from 0 that comes to
  ;;; 255 at most, none of swipl's ISO predicates, its lists proper ones.
  ;;; Anything else goes the goal's way (`'$decl_directive'/2'), which says
  ;;; what is wrong with each part in swipl's words and declares the rest.
  (func coco_decl_plain ((coco_machine * m) (size_t spec)) (out int)
        (set spec (coco_deref m spec))
        (if (coco-tag-is REF (nth spec (-> m heap))) (return 0))
        (if (or (coco_is_compound2 m spec ",") (coco_is_cons m spec))
            (block
              (if (not (coco_decl_plain m (coco_arg m spec 0))) (return 0))
              (return (coco_decl_plain m (coco_arg m spec 1)))))
        (if (coco_is_nil m spec) (return 1))
        (if (coco_is_compound2 m spec ":")
            (return (coco_decl_plain m (coco_arg m spec 1))))
        (if (and (not (coco_is_compound2 m spec "/")) (not (coco_is_compound2 m spec "//")))
            (return 0))
        (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
              (size_t ar . #'(coco_deref m (coco_arg m spec 1)))
              (i64 n . 0))
          (if (not (coco-tag-is ATOM (nth nm (-> m heap)))) (return 0))
          (if (not (coco-is-int (nth ar (-> m heap)))) (return 0))
          (set n (coco_int_val m (nth ar (-> m heap))))
          (if (< n 0) (return 0))
          (if (coco_is_compound2 m spec "//") (set n (+ n 2)))
          (if (> n 255) (return 0))
          (if (coco_iso_predicate (coco_atom_name m (coco_name_of m nm)) (cast u32 n)) (return 0))
          (return 1)))

  ;;; True when T is the compound NAME of arity one -- `:- G' and nothing else,
  ;;; so far, but it reads better than the test written out.
  (static)
  (func coco_is_compound1 ((coco_machine * m) (size_t t) (const char * name)) (out int)
        (set t (coco_deref m t))
        (if (not (coco_is_callable m t)) (return 0))
        (if (!= (coco_arity m t) 1) (return 0))
        (return (? (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) name)) 1 0)))

  ;;; True when T is the compound NAME/2 -- the shape every spec is built from.
  (func coco_is_compound2 ((coco_machine * m) (size_t t) (const char * name)) (out int)
        (if (not (coco_is_callable m t)) (return 0))
        (if (!= (coco_arity m t) 2) (return 0))
        (return (? (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) name)) 1 0)))

  ;;; ...the walk, MD the innermost qualifier of what it walks, (size_t) -1
  ;;; for none: prolog:message//1 is the hook (`coco_hook_nid', 3.78.1)
  (static) (decl)
  (func coco_dynamic_spec_in ((coco_store * st) (coco_machine * m) (size_t spec) (int kind)
                            (char * err) (size_t errlen) (size_t md)) (out int))

  (func coco_dynamic_spec ((coco_store * st) (coco_machine * m) (size_t spec) (int kind)
                         (char * err) (size_t errlen)) (out int)
        (return (coco_dynamic_spec_in st m spec kind err errlen (cast size_t -1))))

  (static)
  (func coco_dynamic_spec_in ((coco_store * st) (coco_machine * m) (size_t spec) (int kind)
                            (char * err) (size_t errlen) (size_t md)) (out int)
        (set spec (coco_deref m spec))

        ;; `a/1, b/2' -- what the reader makes of a comma separated list of
        ;; them, and the form nearly every Prolog file uses -- and `[a/1,
        ;; b/2]', a list of them, which some do.
        (if (or (coco_is_compound2 m spec ",") (coco_is_cons m spec))
            (block
             (if (not (coco_dynamic_spec_in st m (coco_arg m spec 0) kind err errlen md)) (return 0))
             (return (coco_dynamic_spec_in st m (coco_arg m spec 1) kind err errlen md))))

        ;; `system:goal_expansion/2' -- a module-qualified spec, from a file
        ;; written for a Prolog with modules. One namespace: the qualifier
        ;; peels off, the same rule a qualified clause head follows.
        (if (coco_is_compound2 m spec ":")
            (return (coco_dynamic_spec_in st m (coco_arg m spec 1) kind err errlen
                                          (coco_deref m (coco_arg m spec 0)))))

        ;; the end of a list is not a spec and not an error either
        (if (coco_is_nil m spec) (return 1))

        ;; `foo//1' -- a grammar rule's indicator, foo/3 (3.0.0, swipl's)
        (if (and (not (coco_is_compound2 m spec "/")) (not (coco_is_compound2 m spec "//")))
            (block (snprintf err errlen "%s: expected Name/Arity" (coco_decl_kind kind)) (return 0)))

        (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
              (size_t ar . #'(coco_deref m (coco_arg m spec 1)))
              (i64 plus . #'(? (coco_is_compound2 m spec "//") 2 0)))
          (if (not (coco-tag-is ATOM (nth nm (-> m heap))))
              (block (snprintf err errlen "%s: the name must be an atom" (coco_decl_kind kind))
                     (return 0)))
          (if (not (coco-is-int (nth ar (-> m heap))))
              (block (snprintf err errlen "%s: the arity must be an integer" (coco_decl_kind kind))
                     (return 0)))
          (let ((i64 n . #'(+ (coco_int_val m (nth ar (-> m heap))) plus)))
            (if (or (< n 0) (> n 255))
                (block (snprintf err errlen "%s: arity out of range" (coco_decl_kind kind))
                       (return 0)))
            ;; one swipl refuses, reached only where no engine runs the goal
            (if (coco_iso_predicate (coco_atom_name m (coco_name_of m nm)) (cast u32 n))
                (block (snprintf err errlen "%s: No permission to modify static procedure `%s/%u'"
                                 (coco_decl_kind kind) (coco_atom_name m (coco_name_of m nm))
                                 (cast unsigned n))
                       (return 0)))
            (let ((int ok . #'(coco_decl_pi st m (coco_hook_nid m md (coco_name_of m nm) (cast u32 n))
                                             (cast u32 n) kind)))
              (if (== ok 0)
                  (block (snprintf err errlen "%s: out of memory" (coco_decl_kind kind)) (return 0)))
              (if (< ok 0)
                  (block (snprintf err errlen "%s: %s" (coco_decl_kind kind) (-> st write_err))
                         (return 0))))
            (return 1))))

  ;;; WHETHER THE META_PREDICATE DECLARATION OF PREDICATE PI MARKS AN
  ;;; ARGUMENT SWIPL QUALIFIES WITH A MODULE (3.45.0): `0' to `9', `:',
  ;;; `^' or `//' (written `/') -- as the declaration stood at the
  ;;; predicate's first call (3.46.0, `pmq'). Decided by the declaration,
  ;;; which sets `pattrs' 512 (`coco_pred_meta_note'), so the step asks a bit
  (static) (inline)
  (func coco_pred_meta_q ((coco_store * st) (size_t pi)) (out int)
        (return (!= (bitand ($ (coco-pred-at (-> st predp) pi) pattrs) 512) 0)))

  ;;; WHETHER A META ARGUMENT OF SPEC IS ONE A MODULE IS GIVEN TO: a digit,
  ;;; `:', `^' or `//' (`/'), the declaration making the predicate
  ;;; transparent, as swipl's meta_declaration() makes it (3.48.2):
  ;;; predicate_property/2's transparent, listing/1's hidden
  ;;; `:- module_transparent' line, the `$/0' guard a last call drops
  ;;; (`coco_det_transparent') -- and its own module the one its clauses'
  ;;; meta calls are made in, a module_transparent/1 after it
  ;;; notwithstanding (`coco_meta_ctx'), as swipl's frame keeps it
  (static)
  (func coco_meta_spec_module ((const char * spec)) (out int)
        (if (== spec nil) (return 0))
        (for ((size_t i . 0)) (!= (nth i spec) (cast char 0)) ((++ i))
          (let ((int ch . #'(cast int (nth i spec))))
            (if (or (and (>= ch 48) (<= ch 57)) (or (== ch 58) (or (== ch 94) (== ch 47))))
                (return 1))))
        (return 0))

  ;;; A META_PREDICATE DECLARATION'S SPECS NOTED (3.41.0), for
  ;;; predicate_property/2's meta_predicate(Spec) and transparent: each
  ;;; Name(Arg, ...) of a conjunction, under its qualifiers, its
  ;;; arguments a character each as lib/swipl-props.cicili writes them, on
  ;;; the predicate Name/Arity (`pmeta'). A spec holding what is no meta
  ;;; argument -- swipl's domain_error(meta_argument_specifier, X) -- is
  ;;; passed by; one of no arguments is noted, as swipl's (3.46.0: through
  ;;; 3.45.0 passed by), its spec the empty string. A LIST IS A HEAD, the
  ;;; list's own predicate's (`[:|+]', 3.48.0), as swipl's meta_predicate/1
  ;;; reads it and as `coco_pred_meta_check' walks it: through 3.47.0 its
  ;;; elements were noted, each a head, and `[:|+]' declared (:)/0 and (+)/0.
  ;;; As swipl keeps a spec (3.48.2), `*' is `?', and the predicate is
  ;;; transparent as its arguments say: an earlier module_transparent/1
  ;;; is taken away (`pattrs' 4), a later one stands.
  (static)
  (func coco_pred_meta_note ((coco_store * st) (coco_machine * m) (size_t t))
        (set t (coco_deref m t))
        (if (coco_is_compound2 m t ",")
            (block
             (coco_pred_meta_note st m (coco_arg m t 0))
             (coco_pred_meta_note st m (coco_arg m t 1))
             (return)))
        (while (coco_is_compound2 m t ":") (set t (coco_deref m (coco_arg m t 1))))
        (if (not (coco_is_callable m t)) (return))
        (let ((u32 k . #'(coco_arity m t)) (char * s . nil) (size_t pi . 0))
          (set s (cast (char *) (malloc (+ k 1))))
          (if (== s nil) (return))
          (for ((u32 i . 0)) (< i k) ((++ i))
            (let ((size_t a . #'(coco_deref m (coco_arg m t i))) (int ch . 0))
              (cond
                ((coco-tag-is INT (nth a (-> m heap)))
                 (let ((i64 iv . #'(coco_int_val m (nth a (-> m heap)))))
                   ;; a digit, `0' to `9'
                   (if (and (>= iv 0) (<= iv 9)) (set ch (+ 48 (cast int iv))))))
                ((coco-tag-is ATOM (nth a (-> m heap)))
                 (let ((const char * an . #'(coco_atom_name m (coco_name_of m a))))
                   (cond
                     ;; `//' is `/'
                     ((== 0 (strcmp an "//")) (set ch 47))
                     ;; `*' is `?', as swipl keeps it (3.48.2)
                     ((== 0 (strcmp an "*")) (set ch 63))
                     ((and (== (strlen an) 1) (!= (strchr ":^?+-" (nth 0 an)) nil))
                      (set ch (nth 0 an)))
                     (#t (block)))))
                (#t (block)))
              (if (== ch 0) (block (free s) (return)))
              (set (nth i s) (cast char ch))))
          (set (nth k s) (cast char 0))
          (set pi (coco_pred_make st (coco_name_of m t) k))
          (if (>= pi (-> st npreds)) (block (free s) (return)))
          ;; the file being read registers it, as swipl's (3.78.0), where it
          ;; is undefined or the file's already (3.78.1): a meta_predicate/1
          ;; declaration defines nothing, so what it finds is what was before
          (if (!= (-> m sfcur) 0)
              (coco_srcf_note st m pi (coco_pred_known st m (coco_name_of m t) k)))
          (free ($ (coco-pred-at (-> st predp) pi) pmeta))
          (set ($ (coco-pred-at (-> st predp) pi) pmeta) s)
          ;; TRANSPARENT AS THE SPEC SAYS (3.48.2), swipl's
          ;; meta_declaration(), which sets the predicate's transparency
          ;; from its arguments alone: a module_transparent/1 before it is
          ;; gone, one after it sets it again (through 3.48.1 kept)
          (set ($ (coco-pred-at (-> st predp) pi) pattrs)
               (- ($ (coco-pred-at (-> st predp) pi) pattrs) (bitand ($ (coco-pred-at (-> st predp) pi) pattrs) 4)))
          ;; THE STEP QUALIFIES AS THE DECLARATION STOOD AT THE PREDICATE'S
          ;; FIRST CALL (3.46.0), as swipl 9.0.4's, whose first call builds
          ;; the code that calls it and keeps it till abolish/1: before a
          ;; step called it (`pattrs' 128) the declaration is the step's
          ;; too (`pmq'), and whether it qualifies (512); after, it is
          ;; predicate_property/2's alone. So a predicate called before its
          ;; declaration never qualifies (3.45.0's `pattrs' 256), and one
          ;; that qualified goes on through `meta_predicate p(?)' -- which
          ;; through 3.45.0 ended it, the spec read at each call
          (if (== (bitand ($ (coco-pred-at (-> st predp) pi) pattrs) 128) 0)
              (let ((char * q . #'(strdup s)))
                (free ($ (coco-pred-at (-> st predp) pi) pmq))
                (set ($ (coco-pred-at (-> st predp) pi) pmq) q)
                (set ($ (coco-pred-at (-> st predp) pi) pattrs)
                     (- ($ (coco-pred-at (-> st predp) pi) pattrs) (bitand ($ (coco-pred-at (-> st predp) pi) pattrs) 512)))
                (if (and (!= q nil) (coco_meta_spec_module q))
                    (block
                      (set ($ (coco-pred-at (-> st predp) pi) pattrs) (bitor ($ (coco-pred-at (-> st predp) pi) pattrs) 512))
                      ;; AND THE STAMP ITS FUNCTOR TOOK WHILE IT WAS PLAIN
                      ;; IS STALE (3.46.0): a call after abolish/1 stamped
                      ;; it (`fgen', 0 no generation), and a stamped goal
                      ;; never reaches the slow path that qualifies it
                      (if (coco-tag-is FUN (nth t (-> m heap)))
                          (set ($ (nth (cast size_t (coco-payload (nth t (-> m heap)))) (-> m functors)) fgen)
                               0))))))))

  ;;; ONE HEAD OF A META_PREDICATE SPEC, H, AS SWIPL'S meta_declaration()
  ;;; CHECKS IT (3.46.0, pl-proc.c): its qualifiers taken off where an atom
  ;;; names the module, as PL_strip_module takes them (`_:p(0)' is a head
  ;;; of (:)/2), the head a callable term, no ISO predicate's -- asked
  ;;; before its arguments -- and each argument in order an integer 0 to 9
  ;;; within a C int, or ?, +, -, *, :, ^ or //. 0 when all of it holds,
  ;;; and with NOTE the head declared; else the fault, *BAD its culprit: 1
  ;;; an unbound head, 2 one that is no callable term, 3 an ISO
  ;;; predicate's, 4 an unbound argument, 5 an integer or an atom that is
  ;;; no specifier, 6 any other argument, 7 an integer past a C int, 8 the
  ;;; list's end, which the goal fails at (3.47.0)
  (static)
  (func coco_pred_meta_head ((coco_store * st) (coco_machine * m) (size_t h) (int note)
                             (size_t * bad)) (out int)
        (set h (coco_deref m h))
        (while (and (coco_is_compound2 m h ":")
                    (coco-tag-is ATOM (nth (coco_deref m (coco_arg m h 0)) (-> m heap))))
          (set h (coco_deref m (coco_arg m h 1))))
        (set (cof bad) h)
        (if (coco-tag-is REF (nth h (-> m heap))) (return 1))
        ;; the list's end names no predicate swipl's meta_declaration() can
        ;; look up, and fails with no error (3.47.0)
        (if (coco_is_nil m h) (return 8))
        (if (not (coco_is_callable m h)) (return 2))
        (if (coco_iso_predicate (coco_atom_name m (coco_name_of m h)) (coco_arity m h)) (return 3))
        (for ((u32 i . 0)) (< i (coco_arity m h)) ((++ i))
          (let ((size_t a . #'(coco_deref m (coco_arg m h i))) (u64 c . 0))
            (set c (nth a (-> m heap)))
            (set (cof bad) a)
            (cond
              ((coco-tag-is REF c) (return 4))
              ((coco-is-int c)
               (let ((i64 v . #'(coco_int_val m c)))
                 (if (or (< v -2147483648) (> v 2147483647)) (return 7))
                 (if (or (< v 0) (> v 9)) (return 5))))
              ((or (coco-tag-is ATOM c) (coco_is_nil m a))
               (let ((const char * an . #'(coco_atom_name m (coco_name_of m a))))
                 (if (not (or (== 0 (strcmp an "//"))
                              (and (== (strlen an) 1) (!= (strchr ":^?+-*" (nth 0 an)) nil))))
                     (return 5))))
              (#t (return 6)))))
        (if note (coco_pred_meta_note st m h))
        (return 0))

  ;;; A META_PREDICATE SPEC T CHECKED AS SWIPL'S meta_predicate/1 CHECKS
  ;;; IT (3.46.0): a conjunction at its top walked left to right, never one
  ;;; under a qualifier or on the left, which is a head of ','/2 and an ISO
  ;;; predicate's; each part a head (`coco_pred_meta_head'). With NOTE the
  ;;; heads before a fault are declared, as swipl's stand
  (func coco_pred_meta_check ((coco_store * st) (coco_machine * m) (size_t t) (int note)
                              (size_t * bad)) (out int)
        (set t (coco_deref m t))
        (while (coco_is_compound2 m t ",")
          (let ((int r . #'(coco_pred_meta_head st m (coco_arg m t 0) note bad)))
            (if (!= r 0) (return r))
            (set t (coco_deref m (coco_arg m t 1)))))
        (return (coco_pred_meta_head st m t note bad)))

  ;;; Is F one of the three flags a directive answers itself, the ones that
  ;;; act on what the rest of the file reads (2.2.2)? Every other
  ;;; `:- set_prolog_flag(F, V)' is a goal.
  (static)
  (func coco_reader_flag ((coco_machine * m) (size_t f)) (out int)
        (set f (coco_deref m f))
        (if (or (not (coco_is_callable m f)) (!= (coco_arity m f) 0)) (return 0))
        (let ((const char * fn . #'(coco_atom_name m (coco_name_of m f))))
          (return (? (or (== 0 (strcmp fn "generate_debug_info")) (== 0 (strcmp fn "text_units"))
                         (== 0 (strcmp fn "double_quotes")))
                     1 0))))

  (func coco_directive ((coco_store * st) (coco_machine * m) (size_t g)
                      (coco_initgoals * inits) (int line)
                      (char * err) (size_t errlen)) (out int)
        (set g (coco_deref m g))
        (if (not (coco_is_callable m g))
            (block (snprintf err errlen "a directive must be a callable term") (return 0)))

        (let ((const char * name . #'(coco_atom_name m (coco_name_of m g)))
              (u32 n . #'(coco_arity m g))
              ;; MAY THE GOAL COLLECT THE HEAP (1.9.6)? Only if the consult
              ;; said so (`dgc', lib/term.cicili), and only around a call of
              ;; the goal hook below that this frame has made safe: what it
              ;; reads of the term afterwards registered first.
              (int vouch . #'(-> m dgc)))
          (set (-> m dgc) 0)

          ;; ---- `:- dynamic S.', `:- discontiguous S.', `:- multifile S.' --
          ;;
          ;; DECLARED HERE, at once, when every part of S is a plain
          ;; indicator (`coco_decl_plain') -- what nearly every file says.
          ;; Any other S goes the goal's way, `'$decl_directive'(Kind, S)'
          ;; (3.1.0, library(builtins)' Prolog half), which runs each part
          ;; of S as its own goal and reports what one raises in swipl's
          ;; two lines, at this directive's place, as swipl's directive
          ;; does: `:- dynamic([a/1, b]).' declares a/1 and says b is no
          ;; predicate indicator. Through
          ;; 3.0.4 discontiguous and multifile were accepted and ignored, and
          ;; dynamic gave up at a spec's first fault in words of its own.
          ;; and swipl's other four (3.2.0): public, volatile,
          ;; module_transparent and thread_local, the last always the goal's
          ;; way, which refuses a predicate that has clauses already
          (if (== n 1)
              (let ((int kind . #'(coco_decl_kind_of name)))
                (if (>= kind 0)
                    (block
                      (if (or (and (!= kind 6) (coco_decl_plain m (coco_arg m g 0)))
                              (== coco_goal_hook nil))
                          (return (coco_dynamic_spec st m (coco_arg m g 0) kind err errlen)))
                      ;; nothing of the term is read after it, so it may
                      ;; collect as it stands
                      (let ((int r . 0))
                        (set (-> m dgc) vouch)
                        (set r (coco_goal_hook st m (coco_make2 m "$decl_directive"
                                                                (coco_new_atom m name)
                                                                (coco_arg m g 0))
                                               0 err errlen))
                        (set (-> m dgc) 0)
                        (if (== r 1) (return 1))
                        (if (== r 0)
                            (block (coco_directive_failed m g err errlen)
                                   (return 2)))
                        (return 0))))))

          ;; ---- `:- at_halt(G).' (3.71.0) ------------------------------
          ;;
          ;; A HOOK OF THE FILE'S, BEHIND THE OTHERS: swipl's term
          ;; expansion makes the directive a clause '$at_halt'(M:G,
          ;; File:Line) of the file, in its order, where a goal's
          ;; at_halt/1 is asserta/1's. The goal hook runs
          ;; '$at_halt_directive'(G) (library(builtins)' Prolog half),
          ;; which reads the directive's place; with no hook, a binary
          ;; with no such module, the directive is the goal below.
          (if (and (== n 1) (!= coco_goal_hook nil) (== 0 (strcmp name "at_halt")))
              (let ((int r . 0))
                (set (-> m dgc) vouch)
                (set r (coco_goal_hook st m (coco_make1 m "$at_halt_directive" (coco_arg m g 0))
                                       0 err errlen))
                (set (-> m dgc) 0)
                (if (== r 1) (return 1))
                (if (== r 0)
                    (block (coco_directive_failed m g err errlen)
                           (return 2)))
                (return 0)))

          ;; `:- op(P, T, N)'. THIS ONE HAS TO BE HERE and not left to the
          ;; engine, because a declaration has to take effect for the REST OF
          ;; THE FILE being read -- the clauses after it are parsed with it in
          ;; force, and a directive handled after the whole file was read would
          ;; be too late to matter. It is also why this file, which is compiled
          ;; below the engine and cannot run a goal, reaches into syntax.cicili
          ;; instead: the operator table is the reader's, and the reader is
          ;; what a directive like this is about.
          ;;
          ;; ONE THAT op/3 WOULD REFUSE IS LEFT TO THE GOAL BELOW (3.0.0):
          ;; nothing of it was defined, and the builtin raises swipl's error
          ;; term, reported as every raising directive's is.
          (if (and (== n 3) (== 0 (strcmp name "op")))
              (let ((int r . #'(coco_op_apply m g err errlen)))
                (if (!= r -1) (return r))
                (if (== coco_goal_hook nil) (return 0))))

          ;; ---- what the head of a library file says --------------------
          ;;
          ;; ACCEPTED AND IGNORED, so that a file written for a Prolog with
          ;; modules can be read here unedited. cocolog has ONE namespace: a
          ;; `:- module(m, [a/1])' does not hide anything, so every predicate
          ;; in such a file is callable whether the file exported it or not.
          ;; That is a real difference and not a shim -- it is recorded in
          ;; MODULES.md rather than pretended away. Refusing the directive
          ;; would only mean editing every borrowed file, which buys nothing
          ;; and loses the ability to diff a copy against its upstream.
          ;;
          ;; `use_module' and `ensure_loaded' name a library to load, and
          ;; since the loader grew a run-time seam they TRY: the hook below
          ;; resolves against the registered modules and the library path.
          ;; ONE THAT LOADS NOTHING SAYS SO, in SWI's words and with both of
          ;; SWI's lines -- the ERROR saying why (`source_sink ... does not
          ;; exist' for a library that is not there), then the Warning that
          ;; the directive failed -- and the load goes on. It used to stay
          ;; quiet about a library it could not find, so that a file borrowed
          ;; from SWI read unedited; then a program on a machine without
          ;; raylib loaded cleanly and failed at its first drawing call,
          ;; `Unknown procedure: ray_log_level/1', with nothing to say the
          ;; load had gone wrong first. The borrowed file is still quiet where
          ;; that is the truth: SWI's names for what this build carries under
          ;; another arrangement are answered as loaded (library.cicili's
          ;; `lb_carried').
          ;; `meta_predicate' tells which arguments a call qualifies with
          ;; its module (3.45.0, `coco_meta_qualify'; noted below).
          ;; module/2 and meta_predicate/1 define (3.6.0, `ldefs'), as swipl's
          ;; and names the module a single-sided rule's error names (3.19.0)
          (if (and (== n 2) (== 0 (strcmp name "module")))
              (let ((size_t mn . #'(coco_deref m (coco_arg m g 0))))
                (if (coco-tag-is ATOM (nth mn (-> m heap)))
                    (block
                      (set (-> m ssu_mod) (+ (coco_name_of m mn) 1))
                      ;; the module the source file defines (3.78.0,
                      ;; current_module/1)
                      (coco_srcf_module m (coco_atom_name m (coco_name_of m mn)))))
                (set (-> m ldefs) (+ (-> m ldefs) 1))
                (return 1)))
          (if (or (and (<= n 2) (>= n 1) (== 0 (strcmp name "use_module")))
                  (and (== n 1) (== 0 (strcmp name "ensure_loaded"))))
              (block
               (if (== coco_use_module_hook nil) (return 1))
               (set (nth 0 err) (cast char 0))
               ;; THE LOAD RUNS AT THE DIRECTIVE (3.6.0), as swipl's, and its
               ;; directives may collect: the spec is written out for the
               ;; report first, so nothing of the term is read after it. A
               ;; ball that is no error(_, _) ended that load, and ends this
               ;; one (4)
               (let ((int r . 0) (coco_strbuf b))
                 (coco_sb_init (aof b))
                 (coco_write_term m (aof b) (coco_deref m (coco_arg m g 0)) 1 0)
                 ;; WHAT IT IMPORTS (3.42.0), noted before the load too
                 (if (!= coco_import_hook nil) (coco_import_hook st m g))
                 ;; the rules the reads under way gave stand with their last
                 ;; clause where the load's goals run (3.78.13), as where a
                 ;; goal's do: the module's read is one of its own, muted,
                 ;; and its goals settle none of this read's, so a call they
                 ;; made of this file's rules failed where swipl's raises
                 (coco_consult_ssu_settle st m)
                 (set (-> m dgc) vouch)
                 (set r (coco_use_module_hook st m (coco_arg m g 0) err errlen))
                 (set (-> m dgc) 0)
                 (if (== r -1)
                     (snprintf err errlen "source_sink `%s' does not exist"
                               (? (== ($ b s) nil) "?" ($ b s)))
                   (if (and (!= r 1) (== (nth 0 err) (cast char 0)))
                       (snprintf err errlen "%s: could not be loaded"
                                 (? (== ($ b s) nil) "?" ($ b s)))))
                 (coco_sb_free (aof b))
                 (if (== r 1) (return 1))
                 (if (== r -5) (return 4))
                 (return 3))))
          ;; `autoload/1,2' is use_module that loads lazily; same answer
          ;; here, and autoload/2's list is imported (3.42.0), as swipl's
          ;; current_predicate/1 names it before any load
          (if (and (<= n 2) (== 0 (strcmp name "autoload")))
              (block (if (!= coco_import_hook nil) (coco_import_hook st m g))
                     (return 1)))
          ;; its specs noted for predicate_property/2 (3.41.0) and for the
          ;; step, which qualifies the arguments they mark (3.45.0). ONE
          ;; THAT meta_predicate/1 WOULD REFUSE IS LEFT TO THE GOAL BELOW
          ;; (3.46.0), as op/3's is: the goal declares the heads before the
          ;; fault and raises swipl's error, reported as every raising
          ;; directive's is (through 3.45.0 such a spec was taken in
          ;; silence, a list's heads declared and a fault's passed by)
          (if (and (== n 1) (== 0 (strcmp name "meta_predicate")))
              (let ((size_t bad . 0))
                (if (or (== coco_goal_hook nil)
                        (== (coco_pred_meta_check st m (coco_arg m g 0) 0 (aof bad)) 0))
                    (block (coco_pred_meta_note st m (coco_arg m g 0))
                           (set (-> m ldefs) (+ (-> m ldefs) 1)) (return 1)))))

          ;; `:- set_prolog_flag(double_quotes, V)'. ACCEPTED, for all four of
          ;; SWI's values -- codes, chars, atom, string -- and it really
          ;; changes what the reader builds for the rest of the file. It used
          ;; to accept `codes' and refuse the rest BY NAME, on the argument
          ;; that nodding at a flag cocolog would not honour makes every
          ;; `"..."' in the file mean something other than it says. That
          ;; argument was right, and the answer to it was to honour the flag
          ;; rather than to keep refusing: there is a string type now, and an
          ;; atom was always makeable.
          ;;
          ;; THESE THREE ARE ANSWERED HERE, the flags that act on what the
          ;; rest of the file reads; every other flag, and a flag that is no
          ;; atom, is a GOAL (2.2.2), run below as any directive's goal is:
          ;; set_prolog_flag/2 (lib/library.cicili) sets the float flags and
          ;; refuses the rest in swipl's words -- an ERROR naming the ball,
          ;; where through 2.2.1 this said `cocolog has no flag'.
          (if (and (== n 2) (== 0 (strcmp name "set_prolog_flag"))
                   (coco_reader_flag m (coco_arg m g 0)))
              (let ((size_t f . #'(coco_deref m (coco_arg m g 0)))
                    (size_t v . #'(coco_deref m (coco_arg m g 1))))
                ;; `generate_debug_info' false: the predicates this read
                ;; defines from here on hide their children from the
                ;; tracer, as swipl's nodebug libraries (3.27.0, `nodbg');
                ;; true puts it back, and any other value is honoured as
                ;; through 3.26
                (if (== 0 (strcmp (coco_atom_name m (coco_name_of m f)) "generate_debug_info"))
                    (let ((const char * vn . #'(? (coco-tag-is ATOM (nth v (-> m heap)))
                                                   (coco_atom_name m (coco_name_of m v)) "")))
                      (if (or (== 0 (strcmp vn "false")) (== 0 (strcmp vn "off")))
                          (set (-> m nodbg) 1))
                      (if (or (== 0 (strcmp vn "true")) (== 0 (strcmp vn "on")))
                          (set (-> m nodbg) 0))
                      (return 1)))
                ;; `text_units' (1.13.0): what the text builtins count in,
                ;; bytes or characters, for this machine and every machine
                ;; made after it (lib/term.cicili, `coco_text_default')
                (if (== 0 (strcmp (coco_atom_name m (coco_name_of m f)) "text_units"))
                    (block
                     (if (and (coco_is_callable m v) (== (coco_arity m v) 0))
                         (let ((const char * val . #'(coco_atom_name m (coco_name_of m v))))
                           (if (== 0 (strcmp val "bytes"))
                               (block (set (-> m text_chars) 0) (coco_text_default_set 0) (return 1)))
                           (if (== 0 (strcmp val "characters"))
                               (block (set (-> m text_chars) 1) (coco_text_default_set 1) (return 1)))))
                     (snprintf err errlen "set_prolog_flag: text_units takes bytes or characters")
                     (return 0)))
                ;; `double_quotes', the one left. IT TAKES EFFECT FOR THE
                ;; REST OF THE CONSULT, not for the directive's own term --
                ;; the term is already read by the time this runs, which is
                ;; the same order SWI reads in.
                (if (and (coco_is_callable m v) (== (coco_arity m v) 0))
                    (let ((const char * val . #'(coco_atom_name m (coco_name_of m v))))
                      (if (== 0 (strcmp val "codes"))  (block (set (-> m double_quotes) 0) (return 1)))
                      (if (== 0 (strcmp val "chars"))  (block (set (-> m double_quotes) 1) (return 1)))
                      (if (== 0 (strcmp val "atom"))   (block (set (-> m double_quotes) 2) (return 1)))
                      (if (== 0 (strcmp val "string")) (block (set (-> m double_quotes) 3) (return 1)))))
                (snprintf err errlen
                          "set_prolog_flag: double_quotes takes codes, chars, atom or string")
                (return 0)))

          ;; ---- `:- initialization(G)', and `initialization(G, When)' ----
          ;;
          ;; PUT OFF UNTIL THE FILE IS READ, which is the whole point of the
          ;; directive: a goal written at the top of a file may call
          ;; predicates written at the bottom of it, and a directive that ran
          ;; where it stands could not. The goal goes into the STORE and its
          ;; cell into INITS, because the heap this term is on is wound back
          ;; as soon as the clause is done with.
          ;;
          ;; SWI'S FOUR WHENS, three of which mean something here. `now' runs
          ;; it where it stands -- the one case that is just a goal with a
          ;; longer name. `after_load' is the default and what `/1' means.
          ;; `main' is after_load and then HALT: SWI makes the goal the
          ;; program, and a program that has finished is a process that has
          ;; finished. `restore_state' and the rest belong to saved states,
          ;; which cocolog does not have, and are refused by name rather than
          ;; nodded at -- the same rule `set_prolog_flag' follows above.
          (if (and (>= n 1) (<= n 2) (== 0 (strcmp name "initialization")))
              (let ((int mode . 0))
                (if (== n 2)
                    (let ((size_t w . #'(coco_deref m (coco_arg m g 1))))
                      (if (or (not (coco_is_callable m w)) (!= (coco_arity m w) 0))
                          (block (snprintf err errlen
                                           "initialization: the second argument names when")
                                 (return 0)))
                      (let ((const char * wn . #'(coco_atom_name m (coco_name_of m w))))
                        (cond
                          ((== 0 (strcmp wn "after_load")) (set mode 0))
                          ((== 0 (strcmp wn "main"))       (set mode 1))
                          ((== 0 (strcmp wn "now"))        (set mode 2))
                          (#t (block (snprintf err errlen
                                        "initialization: `%s' is not a when cocolog has -- after_load, main or now"
                                        wn)
                                     (return 0)))))))
                (if (== mode 2)
                    (block
                     (if (== coco_goal_hook nil)
                         (block (snprintf err errlen
                                          "initialization(G, now): there is no engine over this store")
                                (return 0)))
                     ;; nothing of the term is read after it -- the message
                     ;; for a failure is fixed text -- so it may collect as
                     ;; it stands. AN INITIALIZATION GOAL'S, in swipl's
                     ;; words (3.1.0): its report names the place again
                     ;; under the directive's, and a ball is what
                     ;; '$run_init_goal'/1 takes, every one
                     (let ((int r . 0) (char place [600]))
                       (set (nth 0 place) (cast char 0))
                       (if (!= (-> m sloc_file) nil)
                           (snprintf place (sizeof place) "%s:%d: " (-> m sloc_file) line))
                       (coco_consult_ssu_settle st m)
                       (set (-> m dgc) vouch)
                       (set r (coco_goal_hook st m (coco_arg m g 0) 1 err errlen))
                       (set (-> m dgc) 0)
                       (if (== r 1) (return 1))
                       (if (== r 0)
                           (block (snprintf err errlen "%sInitialization goal failed" place)
                                  (return 2)))
                       (let ((char * msg . #'(strdup err)))
                         (if (!= msg nil)
                             (block (snprintf err errlen "%sInitialization goal raised exception:\n%s"
                                              place msg)
                                    (free msg))))
                       (return 0))))
                (if (== inits nil)
                    (block (snprintf err errlen
                                     "initialization: nothing here can put a goal off")
                           (return 0)))
                ;; NO ZERO CHECK ON THE CELL: zero is the first cell of an
                ;; empty store and a perfectly good answer -- reading it as
                ;; failure reported an out of memory that had not happened for
                ;; every `initialization' in the first file of a session.
                (let ((size_t cell . #'(coco_store_put st m (coco_arg m g 0))))
                  (if (not (coco_inits_add inits cell mode line))
                      (block (snprintf err errlen "initialization: out of memory") (return 0)))
                  ;; an after_load goal put off defines (3.6.0, `ldefs'), as
                  ;; swipl's; a `main' one does not (3.7.0): a file that
                  ;; holds nothing else is no source file, and swipl drops
                  ;; its main
                  (if (== mode 0) (set (-> m ldefs) (+ (-> m ldefs) 1)))
                  (return 1))))

          ;; ---- AND EVERYTHING ELSE IS A GOAL ----------------------------
          ;;
          ;; Which is what a directive IS in every other Prolog, and what
          ;; this file could not do for as long as it had no way to reach an
          ;; engine. `:- assert(seen(0)).', `:- ( ok -> true ; report ).',
          ;; `:- main.' all run, here, in the order the file writes them.
          ;;
          ;; A GOAL THAT FAILS IS NOT AN ERROR IN THE FILE, and the message
          ;; says so in SWI's words: a failure is a Warning naming the
          ;; directive, an exception is an ERROR naming the ball. Both leave
          ;; the load running.
          (if (== coco_goal_hook nil)
              (block (snprintf err errlen "unsupported directive: %s/%u" name (cast unsigned n))
                     (return 0)))
          ;;
          ;; THE GOAL IS REGISTERED AROUND IT (1.9.6), because a goal that
          ;; collects moves the cells under it and the message for a failure
          ;; writes it afterwards. Unregistered, it runs collecting nothing.
          ;;
          ;; A BALL THAT IS AN error(_, _) IS BOTH (3.1.0), as swipl's
          ;; '$execute_directive_3' catches only those: the ERROR saying why
          ;; and the Warning that the directive failed (3, the caller's).
          ;; ANY OTHER ENDS THE LOAD (4): the hook kept it on the machine
          ;; (`lball') for whoever asked for the load to throw.
          (let ((int r . 0) (size_t * gp . nil) (size_t gl . 1) (int held . 0))
            (set gp (aof g))
            (set held (coco_heap_root_push m (aof gp) (aof gl)))
            ;; the rules the reads under way gave stand with their last
            ;; clause where the goal runs (3.78.13, `coco_consult_ssu_settle')
            (coco_consult_ssu_settle st m)
            (set (-> m dgc) (? held vouch 0))
            (set r (coco_goal_hook st m g 0 err errlen))
            (set (-> m dgc) 0)
            (if held (coco_heap_root_pop m))
            (if (== r 1) (return 1))
            (if (== r -2) (return 4))
            (if (== r -1) (return 3))
            (if (== r 0)
                ;; NAMING THE GOAL, as SWI does -- `Goal (directive) failed:
                ;; user:seen(0)'. A file with three directives in it and a
                ;; message that named none of them would send the reader to
                ;; count lines.
                (block (coco_directive_failed m g err errlen)
                       (return 2)))
            (return 0))))

  ;;; `Goal (directive) failed: user:G', swipl's words: the goal qualified as
  ;;; swipl qualifies it, by the one namespace there is (3.1.0; through 3.0
  ;;; it had no qualifier)
  (func coco_directive_failed ((coco_machine * m) (size_t g) (char * err) (size_t errlen))
        (let ((coco_strbuf b)
              (size_t q . #'(coco_make2 m ":" (coco_new_atom m "user") (coco_deref m g))))
          (coco_sb_init (aof b))
          (coco_write_term m (aof b) q 1 0)
          (snprintf err errlen "Goal (directive) failed: %s"
                    (? (== ($ b s) nil) "?" ($ b s)))
          (coco_sb_free (aof b))))

  ;;; ---- asserting --------------------------------------------------------

  (func coco_clause_parts ((coco_machine * m) (size_t clause) (size_t * head) (size_t * body))
        (set clause (coco_deref m clause))
        (set (cof head) clause)
        (set (cof body) 0)
        (if (not (coco_is_callable m clause)) (return))
        (if (!= (coco_arity m clause) 2) (return))
        (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m clause)) ":-")) (return))
        (set (cof head) (coco_arg m clause 0))
        (set (cof body) (coco_arg m clause 1)))

  ;;; ---- first-argument indexing ------------------------------------------

  (func coco_no_clause () (out size_t) (return (cast size_t -1)))

  (func coco_arg_key ((coco_machine * m) (size_t t)) (out u64)
        (set t (coco_deref m t))
        (if (not (coco_is_callable m t)) (return 0))
        (if (== (coco_arity m t) 0) (return 0))
        (let ((u64 c . #'(nth (coco_deref m (coco_arg m t 0)) (-> m heap))))
          ;; an unbound argument constrains nothing, and a float, a string,
          ;; a boxed integer or a rational cannot be compared as a cell --
          ;; see the struct
          (if (coco-tag-is REF c) (return 0))
          (if (coco-tag-is FLT c) (return 0))
          (if (coco-tag-is STR c) (return 0))
          (if (coco-tag-is BIG c) (return 0))
          (if (coco-tag-is RAT c) (return 0))
          (return c)))

  ;;; A PREDICATE SMALLER THAN THIS IS NOT WORTH A TABLE. Below it the scan
  ;;; over `keys' is a handful of contiguous machine words and beats a hash
  ;;; lookup outright; above it the table is what stops the walk growing with
  ;;; the predicate. Almost every rule ever written is under it and pays
  ;;; nothing at all.
  (static) (func coco_index_floor () (out size_t) (return 8))

  ;;; The slot KEY lives in, probing linearly from its hash. Answers the slot
  ;;; whether or not it is occupied, so a caller that means to insert may
  ;;; write it -- and never fails, because the table is kept below half full.
  (static)
  (func coco_kslot_of ((coco_pred * p) (u64 key)) (out coco_kslot *)
        ;; the cell's low four bits are a tag and its payload is an index, so
        ;; the interesting bits are the high ones: a multiply spreads them
        ;; down before the mask takes the bottom of the word. The table is
        ;; kept below half full, so the probe always finds a slot.
        (let ((u64 h . #'(* key 1099511628211))
              (size_t i . 0) (size_t mask . #'(- (-> p nslots) 1)))
          (set i (cast size_t (bitand (>> h 7) (cast u64 mask))))
          (while 1
            (let ((coco_kslot * sl . #'(aof (nth i (-> p slots)))))
              (if (== (-> sl key) 0) (return sl))
              (if (== (-> sl key) key) (return sl)))
            (set i (bitand (+ i 1) mask)))
          (return nil)))

  (static)
  (func coco_chain_add ((coco_pred * p) (u64 key) (size_t at))
        (set (nth at (-> p chain)) (coco_no_clause))
        (if (== key 0)
            (block
             (if (== (-> p varhead) (coco_no_clause))
                 (set (-> p varhead) at)
               (set (nth (-> p vartail) (-> p chain)) at))
             (set (-> p vartail) at)
             (set (-> p nvar) (+ (-> p nvar) 1))
             (return)))
        (let ((coco_kslot * sl . #'(coco_kslot_of p key)))
          (if (== (-> sl key) 0)
              (block (set (-> sl key) key)
                     (set (-> sl head) at)
                     (set (-> sl tail) at)
                     (set (-> sl count) 1)
                     (if (== (-> p kmax) 0) (set (-> p kmax) 1))
                     (return)))
          (set (nth (-> sl tail) (-> p chain)) at)
          (set (-> sl tail) at)
          (set (-> sl count) (+ (-> sl count) 1))
          (if (> (-> sl count) (-> p kmax)) (set (-> p kmax) (-> sl count)))))

  ;;; Builds the table from the keys, in clause order, so every chain comes
  ;;; out ascending. O(n) and paid once per invalidation.
  (static)
  ;;; UNDER THE BARRIER, with the recheck inside (3.64.0): every worker of a
  ;;; green world reads the one store's index, and through 3.63.2 two first
  ;;; calls after a write rebuilt it at once, each reallocating the slots
  ;;; under the other.
  (func coco_pred_reindex ((coco_store * st) (coco_pred * p)) (out int)
        (with-green-write nil
          (if (-> p indexed) (return 1))
          (let ((size_t want . 16))
            (while (< want (* (-> p nclauses) 2)) (set want (* want 2)))
            (if (!= (-> p nslots) want)
                (let ((void * ns . #'(coco-meta-moved st (cast (void *) (-> p slots)) 0
                                                      (* want (sizeof coco_kslot))
                                                      (realloc (cast (void *) (-> p slots))
                                                               (* want (sizeof coco_kslot))))))
                  (if (== ns nil) (block (set (-> st oom) 1) (return 0)))
                  (set (-> p slots) (cast (coco_kslot *) ns))
                  (set (-> p nslots) want)))
            (memset (cast (void *) (-> p slots)) 0 (* (-> p nslots) (sizeof coco_kslot))))
          (set (-> p varhead) (coco_no_clause))
          (set (-> p vartail) (coco_no_clause))
          (set (-> p nvar) 0)
          (set (-> p kmax) 0)
          (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
            (coco_chain_add p (nth i (-> p keys)) i))
          (set (-> p indexed) 1)
          (return 1)))

  ;;; Walks one chain to its first entry at or after FROM. The chains are in
  ;;; ascending order, so this stops at the first candidate rather than
  ;;; scanning the whole of one.
  (static)
  (func coco_chain_from ((coco_pred * p) (size_t h) (size_t from)) (out size_t)
        (while (and (!= h (coco_no_clause)) (< h from))
          (set h (nth h (-> p chain))))
        (return h))

  ;;; THE REBUILD A WALK ASKS FOR (3.64.0): none in a world -- see
  ;;; `coco_pred_next_clause'. Its own function, never inlined: with the
  ;;; world's question in the walk's cold branch, the walk saved more
  ;;; registers at every call (queens +0.97 % of its work, lookup +0.37 %,
  ;;; all of it in `coco_pred_next_clause').
  (weak)
  (func coco_pred_reindex_walk ((coco_store * st) (coco_pred * p)) (out int)
        (if (coco_g_here) (return 0))
        (return (coco_pred_reindex st p)))

  (func coco_pred_next_clause ((coco_store * st) (coco_pred * p)
                             (u64 key) (size_t from)) (out size_t)
        (if (>= from (-> p nclauses)) (return (coco_no_clause)))
        ;; a call whose first argument is unbound (or a float, or absent) has
        ;; nothing to discriminate on, and every clause is a candidate
        (if (== key 0) (return from))

        ;; small, or waiting to be rebuilt and not worth rebuilding: the scan
        ;; over `keys' still skips the copy and the unification, which is the
        ;; part that costs. A RETRY IN A WORLD REBUILDS NO INDEX (3.64.0):
        ;; the rebuild waits at the write barrier, where this worker answers
        ;; the other workers' writes, and an asserta that lands there moves
        ;; every clause on by one -- the frame's place with it
        ;; (`coco_frames_on'), not FROM, which the caller read before it.
        ;; The retry then tried the clause it had just tried again (a walk
        ;; that yields at each answer beside a writer, test/async.pl's
        ;; `retry_walks': 1 to 14 walks wrong of 12 000 a run). A call's
        ;; probe still rebuilds, before any place is read; this scan is the
        ;; same walk, slower.
        (if (or (< (-> p nclauses) (coco_index_floor))
                (and (== (-> p indexed) 0) (not (coco_pred_reindex_walk st p))))
            (block
             (for ((size_t i . from)) (< i (-> p nclauses)) ((++ i))
               (let ((u64 k . #'(nth i (-> p keys))))
                 (if (or (== k 0) (== k key)) (return i))))
             (return (coco_no_clause))))

        ;; two candidates: the first clause of this key at or after FROM, and
        ;; the first key-0 clause there -- whichever comes first is the one
        ;; the program would have reached by walking
        ;; A RETRY STARTS FROM THE CLAUSE JUST TRIED. FROM is one past it,
        ;; and that clause sits in the chain of its key -- this key's or
        ;; the key-0 chain -- so its link IS that chain's first entry at or
        ;; after FROM, and only the other chain is walked from its head.
        ;; Walking both from their heads made a retry through a chain of N
        ;; clauses cost N, and backtracking through one key's clauses N
        ;; squared: 2000 lookups in a table of one language took 4.3 s.
        (let ((coco_kslot * sl . #'(coco_kslot_of p key))
              (int back . #'(> from 0))
              (u64 kprev . 0)
              (size_t a . #'(coco_no_clause))
              (size_t b . #'(coco_no_clause)))
          (if back (set kprev (nth (- from 1) (-> p keys))))
          (set b (? (and back (== kprev 0)) (nth (- from 1) (-> p chain))
                    (coco_chain_from p (-> p varhead) from)))
          ;; an UNOCCUPIED slot is where this key WOULD go, and its zeroed
          ;; head is a real position -- so nothing of this key exists
          (if (!= (-> sl key) 0)
              (set a (? (and back (== kprev key)) (nth (- from 1) (-> p chain))
                        (coco_chain_from p (-> sl head) from))))
          (if (== a (coco_no_clause)) (return b))
          (if (== b (coco_no_clause)) (return a))
          (return (? (< a b) a b))))

  ;;; EVERY INDEX OF A PREDICATE, dropped: what renumbers the clauses --
  ;;; asserta, retract, a reconsult, a sweep of the dead -- leaves the chains
  ;;; naming the wrong positions, and the next call that wants a table
  ;;; rebuilds it.
  ;;; The deep index's nodes keep their place, functor and members' tables
  ;;; (3.64.0): a choice frame names a node by its index, and a retry
  ;;; builds it again from the clauses as they are now.
  (static)
  (func coco_pred_unindex ((coco_pred * p))
        (set (-> p indexed) 0)
        (if (!= (-> p aix) nil)
            (let ((coco_aixs * a . #'(-> p aix)))
              (for ((u32 j . 0)) (< j (coco_aix_count)) ((++ j))
                (set ($ (nth j (-> a args)) indexed) 0))
              (for ((u32 i . 0)) (< i (-> a nnodes)) ((++ i))
                (let ((coco_dnode * d . #'(nth i (-> a nodes))))
                  (set (-> d built) 0)
                  (if (!= (-> d tabs) nil)
                      (for ((u32 t . 0)) (< t (coco_dnode_ntabs d)) ((++ t))
                        (set ($ (nth t (-> d tabs)) indexed) 0))))))))

  ;;; ---- the logical update view ------------------------------------------

  ;;; P's `nprobe' from its counts, after every write of either.
  (static) (inline)
  (func coco_pred_nprobe ((coco_pred * p))
        (set (-> p nprobe) (? (and (== (-> p ntomb) 0) (<= (-> p nclauses) 4294967295))
                              (cast u32 (-> p nclauses)) 0)))

  ;;; THE CLAUSES OF PI PAST THE FIRST KEEP, TAKEN BACK (2.11.1): what a
  ;;; fetch had added when it failed (`coco_pred_ensure'). They are the last
  ;;; ones -- a fetch appends, and nothing else touches the predicate while
  ;;; it runs -- and no call has seen them, so they are simply dropped: their
  ;;; programs, if any were made, the count, and every index, which named
  ;;; their positions. Their cells the caller counts dead.
  (static)
  (func coco_pred_cut_back ((coco_store * st) (size_t pi) (size_t keep))
        (if (>= pi (-> st npreds)) (return))
        (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) pi))))
          (if (<= (-> p nclauses) keep) (return))
          (for ((size_t i . keep)) (< i (-> p nclauses)) ((++ i))
            (coco_code_drop st (nth i (-> p clauses))))
          (set (-> p nclauses) keep)
          (set (-> p tver) (+ (-> p tver) 1))
          (coco_pred_nprobe p)
          (coco_pred_unindex p)))

  (func coco_pred_dead ((coco_pred * p) (size_t i)) (out int)
        (return (and (!= (-> p ntomb) 0) (!= (nth i (-> p tomb)) 0))))

  (func coco_pred_live ((coco_pred * p)) (out size_t)
        (return (- (-> p nclauses) (-> p ntomb))))

  ;;; WHETHER PREDICATE PI OF ST IS DEFINED, swipl's isDefinedProcedure():
  ;;; a live clause, or dynamic, discontiguous or multifile -- a library's
  ;;; too, as swipl's user hooks (file_search_path/2) are defined from the
  ;;; start, and the two hooks print_message/2 reads, which its library
  ;;; declares multifile as swipl's system does. A declaration that finds
  ;;; its predicate defined registers it with the file being read only
  ;;; where the file's list holds it already (3.78.1, `coco_srcf_note')
  (func coco_pred_defined ((coco_store * st) (size_t pi)) (out int)
        (if (>= pi (-> st npreds)) (return 0))
        (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) pi))))
          (return (or (> (coco_pred_live p) 0) (-> p dynamic) (!= 0 (bitand (-> p declared) 3))))))

  (func coco_pred_live_before ((coco_pred * p) (size_t ix)) (out size_t)
        (if (== (-> p ntomb) 0) (return ix))
        (let ((size_t n . 0))
          (for ((size_t i . 0)) (and (< i ix) (< i (-> p nclauses))) ((++ i))
            (if (== (nth i (-> p tomb)) 0) (set n (+ n 1))))
          (return n)))

  (func coco_pred_live_at ((coco_pred * p) (size_t n)) (out size_t)
        (if (== (-> p ntomb) 0) (return (? (< n (-> p nclauses)) n (coco_no_clause))))
        (let ((size_t i . 0) (size_t k . 0))
          ;; on from the last answer, when nothing changed since and N is
          ;; not before it
          (if (and (== (-> p lver) (-> p tver)) (<= (-> p lord) n) (< (-> p lpos) (-> p nclauses)))
              (block (set i (-> p lpos)) (set k (-> p lord))))
          (while (< i (-> p nclauses))
            (if (== (nth i (-> p tomb)) 0)
                (block
                 (if (== k n)
                     (block (set (-> p lord) n) (set (-> p lpos) i)
                            (set (-> p lver) (-> p tver))
                            (return i)))
                 (set k (+ k 1))))
            (set i (+ i 1)))
          (return (coco_no_clause))))

  ;;; PI READY TO KEEP DEAD CLAUSES: its TOMB made the first time, as long
  ;;; as the clause list's capacity, and the predicate put on the store's
  ;;; list. Answers 0 with no memory for either, and the caller takes the
  ;;; clause out as a retract always did.
  (static)
  (func coco_tomb_ready ((coco_store * st) (size_t pi)) (out int)
        (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) pi))))
          (if (== (-> p tomb) nil)
              (let ((size_t cap . #'(? (> (-> p clause_cap) 0) (-> p clause_cap) 1)))
                (set (-> p tomb) (cast (u32 *) (coco-meta-moved st nil 0 (* cap (sizeof u32))
                                                                (calloc cap (sizeof u32)))))
                (if (== (-> p tomb) nil) (return 0))
                (set (-> p tomb_cap) cap)))
          (if (not (-> p tlisted))
              (block
               (if (not (coco_store_grow st (cast (void **) (aof (-> st tpreds)))
                                       (aof (-> st tpred_cap)) (+ (-> st ntpreds) 1)
                                       (sizeof size_t)))
                   (return 0))
               (set (nth (-> st ntpreds) (-> st tpreds)) pi)
               (set (-> st ntpreds) (+ (-> st ntpreds) 1))
               (set (-> p tlisted) 1)))
          (return 1)))

  ;;; Clause I of P dies as death ERA, P ready (`coco_tomb_ready').
  (static)
  (func coco_tomb_set ((coco_pred * p) (size_t i) (u32 era))
        (set (nth i (-> p tomb)) era)
        (set (-> p ntomb) (+ (-> p ntomb) 1))
        (coco_pred_nprobe p)
        (set (-> p tver) (+ (-> p tver) 1)))

  ;;; A DEATH ON PI UNDER AN OPEN CALL: the count it is given, one past the
  ;;; last, when a frame is open on PI -- each open one that has lived
  ;;; through no death given it as its first (`fera', `coco_frames_on') --
  ;;; and PI is ready to keep its dead (`coco_tomb_ready'); 0 when no frame
  ;;; is open, or there is no memory for the dead, and the caller takes the
  ;;; clause out as a retract always did. (A frame given a count no death
  ;;; then took sees the next death as its first, which it lives through.)
  (static)
  (func coco_tomb_open ((coco_store * st) (coco_machine * m) (size_t pi)) (out u32)
        (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) pi)))
              (u32 era . #'(+ (-> p tera) 1)))
          (if (== (coco_frames_on m st pi 1 era 0) 0) (return 0))
          (if (not (coco_tomb_ready st pi)) (return 0))
          (set (-> p tera) era)
          (return era)))

  (func coco_pred_sweep ((coco_store * st) (coco_machine * m) (size_t pi))
        (if (>= pi (-> st npreds)) (return))
        (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) pi)))
              (size_t kept . 0))
          (if (== (-> p ntomb) 0) (return))
          (with-green-write nil
          (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
            (if (!= (nth i (-> p tomb)) 0)
                ;; the cells to the next compaction and the program now
                ;; (`coco_store_orphan'), as a retract would have done when
                ;; the clause died
                (coco_store_orphan st m (nth i (-> p clauses)))
              (block
                (if (!= kept i)
                    (block (set (nth kept (-> p clauses)) (nth i (-> p clauses)))
                           (set (nth kept (-> p keys)) (nth i (-> p keys)))
                           (set (nth kept (-> p origins)) (nth i (-> p origins)))
                           (set (nth kept (-> p muted)) (nth i (-> p muted)))
                           (set (nth kept (-> p codes)) (nth i (-> p codes)))))
                (set kept (+ kept 1)))))
          (set (-> p nclauses) kept)
          (set (-> p ntomb) 0)
          (coco_pred_nprobe p)
          (free (cast (void *) (-> p tomb)))
          (set (-> p tomb) nil)
          (set (-> p tomb_cap) 0)
          (set (-> p tprobe) 0)
          (set (-> p tback) 0)
          ;; no frame is open on it, so the count of deaths starts again
          (set (-> p tera) 0)
          ;; the positions after each dead one have moved
          (set (-> p tver) (+ (-> p tver) 1))
          (coco_pred_unindex p))))

  (func coco_tomb_sweep_all ((coco_store * st) (coco_machine * m))
        (with-green-write nil
          (for ((size_t i . 0)) (< i (-> st ntpreds)) ((++ i))
            (let ((size_t pi . #'(nth i (-> st tpreds))))
              (coco_pred_sweep st m pi)
              (if (< pi (-> st npreds)) (set ($ (coco-pred-at (-> st predp) pi) tlisted) 0))))
          (set (-> st ntpreds) 0)))

  (func coco_tomb_try_sweep ((coco_store * st) (coco_machine * m) (size_t pi)) (out int)
        (if (== ($ (coco-pred-at (-> st predp) pi) ntomb) 0) (return 1))
        ;; a sweep measures what it orphans on a machine's heap
        (if (== m nil) (return 0))
        ;; IN A GREEN WORLD A FRAME THAT STANDS STILL SAYS NO WITHOUT THE
        ;; BARRIER (3.78.20, `coco_g_frame_still'): the caller's own, the
        ;; host's, or a task's no worker is running. Through 3.78.19 each try
        ;; stopped the world first -- a wait for every other worker's quantum
        ;; to end -- and a frame held open on the dead turned it down after.
        ;; NOR DOES A FRAME A RUNNING TASK MAY HOLD (3.78.21): the tasks
        ;; running are asked, and the try is turned down until each has
        ;; answered at its next standstill, where the barrier waited for
        ;; that standstill.
        ;; `framed' is read with no lock: a stale answer is a barrier more
        (if (and (!= (-> st machines) nil)
                 (and ($ (coco-pred-at (-> st predp) pi) framed)
                      (coco_g_frame_still m st pi)))
            (return 0))
        (with-green-write nil
          (if (!= (coco_frames_on m st pi 0 0 0) 0) (return 0))
          (coco_pred_sweep st m pi)
          (return 1)))

  ;;; THE DEAD OF PI TAKEN OUT WHERE THEY ARE DUE (`coco-tomb-due', 3.78.15)
  ;;; and no frame is open on them: what a retract/1 or clause/2 walk asks
  ;;; as it begins, once a clause of PI is dead. Out of line and cold, so
  ;;; the walk keeps the one test of `ntomb' it made through 3.78.14: the
  ;;; due test inline cost a counter of one clause four instructions a turn
  ;;; in the registers of the walk that sweeps nothing. The sites that only
  ;;; a predicate with dead clauses, or a big one, reaches ask it inline: out
  ;;; of line there too, a table of 20 rows updated in place paid nineteen
  ;;; an update for the calls.
  (weak) (cold)
  (func coco_tomb_due_sweep ((coco_store * st) (coco_machine * m) (size_t pi))
        (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) pi))))
          (if (coco-tomb-due p) (coco_tomb_try_sweep st m pi))))

  ;;; WHAT A CALL THAT MET THE DEAD OWES THEIR SWEEP (3.78.19): put into
  ;;; the predicate's `tprobe' at once where no green world shares the
  ;;; store, and else held on the calling task's machine (`tcp', `tcn') and
  ;;; put in a sixteenth of what the next try needs at a time, 64 at least
  ;;; (`coco-tomb-batch', 3.78.21; 64 through 3.78.20), when the task's
  ;;; calls move to another predicate with dead clauses, and as the machine
  ;;; is freed (`coco_tomb_flush'). The predicate's line is read by every
  ;;; worker's call of it: through 3.78.18 each call stored into it, and
  ;;; eight tasks calling one predicate with dead clauses that a frame kept
  ;;; from their sweep took 1.1 to 1.5 times eight with a predicate each at
  ;;; one call a turn, and 2.3 to 2.8 times at four (STATUS.md); at 64 a
  ;;; put, 1.01 to 1.07 times at four. What the calls have paid is counted
  ;;; as before, a batch a machine late at most, and a sweep is tried as
  ;;; they have paid for it. Only a task's machine holds a count back (an
  ;;; alias, `tbase'): it is freed before the store it counts for, which
  ;;; the host's machine is not.
  ;;;
  ;;; FOUR PREDICATES' CHARGES AT ONCE (3.78.21): a slot a predicate, the
  ;;; newest first; a predicate the machine holds no slot for puts the
  ;;; oldest slot's charge in and takes the front. Through 3.78.20 the
  ;;; machine held one, and a loop that called two such predicates in turn
  ;;; put its charge in at every call: eight tasks calling the same two took
  ;;; 2.43 times eight with a pair each at four calls a turn (STATUS.md).
  (static)
  (func coco_tomb_charge_at ((coco_store * st) (coco_machine * m) (coco_pred * p) (size_t paid))
        (if (or (== m nil) (== (-> st machines) nil) (== (-> m tbase) nil))
            (block (coco-tomb-charge p paid) (return)))
        (let ((u32 * q . #'(aof (-> p tprobe))) (int k . 0))
          (while (and (< k 4) (!= (nth k (-> m tcp)) q)) (set k (+ k 1)))
          (if (== k 4)
              (block
               (coco_tomb_flush_at m 3)
               (for ((int j . 3)) (> j 0) ((-- j))
                 (set (nth j (-> m tcp)) (nth (- j 1) (-> m tcp)))
                 (set (nth j (-> m tcn)) (nth (- j 1) (-> m tcn))))
               (set (nth 0 (-> m tcp)) q)
               (set (nth 0 (-> m tcn)) 0)
               (set k 0)))
          (set (nth k (-> m tcn)) (? (> paid (- 4294967295 (nth k (-> m tcn)))) 4294967295
                                     (+ (nth k (-> m tcn)) paid)))
          (if (>= (cast size_t (nth k (-> m tcn))) (coco-tomb-batch p))
              (coco_tomb_flush_at m k))))

  ;;; THE PROBE OF A PREDICATE WITH DEAD CLAUSES, out of line: the first
  ;;; LIVE candidate and whether there is a second, a new call seeing none
  ;;; of the dead. Each such call pays one, and one more for each dead
  ;;; clause it passes (`coco_tomb_charge_at'), and once the calls have paid
  ;;; for a sweep (`coco-tomb-paid', 3.78.15) the dead are taken out first
  ;;; if no frame is open on the predicate any more -- so that a predicate
  ;;; read and no longer changed after a death does not pay for its dead
  ;;; for ever, and the dead an eighth of the live leaves are not passed by
  ;;; every call of a big one. A frame still open doubles what the calls
  ;;; must have paid for the next try (`tback', twenty doublings at most):
  ;;; the try walked the choices down to that frame, and below a deep search
  ;;; a try every few calls would cost more than the dead (a count put back
  ;;; to 0 as well moved nothing measurable). Through 3.78.14 every 256th
  ;;; call took them, a pass over the predicate a few hundred calls however
  ;;; big it was, and a walk of the choices as often while a frame stayed
  ;;; open. Weak, so never inlined into the probe every call makes.
  (weak)
  (func coco_pred_probe_dead ((coco_store * st) (coco_pred * p) (u64 key) (size_t * ix)
                              (coco_machine * m) (u32 pos)) (out int)
        (if (and (!= (-> p ntomb) 0) (!= m nil) (coco-tomb-paid p))
            (let ((size_t pi . #'(coco_pred_find st (-> p name) (-> p arity))))
              (if (coco_tomb_try_sweep st m pi)
                  (return (coco_pred_probe_at st m p pos key ix)))
              (if (< (-> p tback) 20) (set (-> p tback) (+ (-> p tback) 1)))))
        (let ((size_t a . #'(coco_pred_next_at st m p pos key 0))
              (size_t b . 0) (size_t paid . 1))
          (while (and (!= a (coco_no_clause)) (coco_pred_dead p a))
            (set paid (+ paid 1))
            (set a (coco_pred_next_at st m p pos key (+ a 1))))
          (if (== a (coco_no_clause))
              (block (coco_tomb_charge_at st m p paid) (return 0)))
          (set (cof ix) a)
          (set b (coco_pred_next_at st m p pos key (+ a 1)))
          (while (and (!= b (coco_no_clause)) (coco_pred_dead p b))
            (set paid (+ paid 1))
            (set b (coco_pred_next_at st m p pos key (+ b 1))))
          (coco_tomb_charge_at st m p paid)
          (return (? (== b (coco_no_clause)) 1 2))))

  ;;; WHERE A PROBE GOES WHEN `nprobe' IS 0: no clause, or a dead one, or
  ;;; more clauses than 32 bits count -- each asked here, out of line, so
  ;;; the probe every call makes tests its count once.
  (weak)
  (func coco_pred_probe_cold ((coco_store * st) (coco_pred * p) (u64 key) (size_t * ix)
                              (coco_machine * m) (u32 pos)) (out int)
        (if (== (-> p nclauses) 0) (return 0))
        (return (coco_pred_probe_dead st p key ix m pos)))

  ;;; THE FIRST CANDIDATE AND WHETHER THERE IS A SECOND, in one ask: 0 for
  ;;; no clause that can match, 1 for exactly one (its position in IX), 2
  ;;; for more, with IX the first -- what a call needs to know to go
  ;;; without a choice frame (`coco_engine_run', 1.8.46). A small
  ;;; predicate's scan finds both in one pass over its keys where two asks
  ;;; of `coco_pred_next_clause' made two passes and two calls; an indexed
  ;;; one still asks twice. A predicate with dead clauses asks out of line.
  ;;;
  ;;; ITS COUNT IS `nprobe', and that one test is the dead clauses' too: a
  ;;; test of `ntomb' beside it was a load and a branch more a call, nrev
  ;;; +0.64 % of 2.2.5's work where this is +0.32 % (STATUS.md, the logical
  ;;; update view).
  ;;;
  ;;; 3 IS 2 WHERE SWIPL WOULD ASK ANOTHER ARGUMENT (3.24.0, `coco_pred_jit'),
  ;;; of a predicate under the floor with more than one argument: its first
  ;;; argument unbound, or the first two candidates both of its key -- swipl's
  ;;; "duplicate" (pl-index.c, first_clause_guarded). Asked only where a
  ;;; second candidate is found, so a call that has one pays nothing.
  (func coco_pred_probe ((coco_store * st) (coco_pred * p) (u64 key) (size_t * ix) (coco_machine * m)) (out int)
        (let ((size_t n . #'(cast size_t (-> p nprobe))))
          (if (== n 0) (return (coco_pred_probe_cold st p key ix m 0)))
          (if (== key 0)
              (block (set (cof ix) 0)
                     (return (? (== n 1) 1
                                (? (and (< n (coco_index_floor)) (>= (-> p arity) 2)) 3 2)))))
          (if (or (< n (coco_index_floor))
                  (and (== (-> p indexed) 0) (not (coco_pred_reindex st p))))
              (let ((size_t first . #'(coco_no_clause)))
                (for ((size_t i . 0)) (< i n) ((++ i))
                  (let ((u64 k . #'(nth i (-> p keys))))
                    (if (or (== k 0) (== k key))
                        (block
                         ;; a one-argument predicate's too since 3.64.0: the
                         ;; JIT index looks inside its argument where that is
                         ;; a compound the clauses share (`coco_deep_select')
                         (if (!= first (coco_no_clause))
                             (block (set (cof ix) first)
                                    (return (? (and (== k key) (== (nth first (-> p keys)) key)
                                                    (< n (coco_index_floor)))
                                               3 2))))
                         (set first i)))))
                (if (== first (coco_no_clause)) (return 0))
                (set (cof ix) first)
                (return 1)))
          (let ((size_t a . #'(coco_pred_next_clause st p key 0)))
            (if (== a (coco_no_clause)) (return 0))
            (set (cof ix) a)
            (return (? (== (coco_pred_next_clause st p key (+ a 1)) (coco_no_clause)) 1 2)))))

  ;;; ---- the other arguments' indexes ---------------------------------------
  ;;;
  ;;; THE FIRST ARGUMENT IS NOT ALWAYS THE ONE THAT CHOOSES. A call whose
  ;;; first argument is unbound -- `mean(W, house)', a lookup read the
  ;;; other way -- walked the whole predicate head by head, and so did a
  ;;; call whose first argument most clauses share: a table of one language
  ;;; keyed on the language did exactly that to the program, four
  ;;; minutes a sentence, until its facts were renamed per language.
  ;;; The second to the eighth argument
  ;;; can each have an index of their own now, built the first time a call
  ;;; wants one and chosen by how few candidates it leaves.

  ;;; A first argument that leaves this many candidates or fewer is good
  ;;; enough, and the others are not asked.
  (static) (func coco_aix_enough () (out size_t) (return 4))

  ;;; THE FIRST ARGUMENT WILL DO, known without a look in any table: a
  ;;; predicate under the floor -- almost every rule -- or a bound key into
  ;;; a table where no key leaves more than a few candidates, a table of
  ;;; facts keyed on what they are looked up by. The engine asks this
  ;;; before `coco_pred_select_key', and a call it answers yes for is
  ;;; selected exactly as it was before the other arguments had tables.
  (static)
  (func coco_pred_first_enough ((coco_pred * p) (u64 key)) (out int)
        (return (or (< (-> p nclauses) (coco_index_floor))
                    (and (!= key 0) (-> p indexed)
                         (<= (+ (-> p kmax) (-> p nvar)) (coco_aix_enough))))))

  ;;; A heap cell's key, as `coco_arg_key' reads the first argument's.
  (static)
  (func coco_cell_key ((coco_machine * m) (size_t a)) (out u64)
        (let ((u64 c . #'(nth (coco_deref m a) (-> m heap))))
          (if (or (coco-tag-is REF c) (coco-tag-is FLT c) (coco-tag-is STR c)
                  (coco-tag-is BIG c) (coco-tag-is RAT c))
              (return 0))
          (return c)))

  ;;; Argument J's key in a clause's head, read from the store: what
  ;;; `coco_arg_key' gave the first argument of the term it came from.
  (static)
  (func coco_store_arg_key ((coco_store * st) (coco_machine * m) (size_t clause)
                            (u64 neck) (u32 j)) (out u64)
        (let ((size_t head . 0) (size_t body . 0) (u64 c . 0) (u64 a . 0))
          (coco_store_clause_parts st m clause neck (aof head) (aof body))
          (set head (coco_store_deref st head))
          (set c (nth head (-> st cells)))
          (if (not (coco-tag-is FUN c)) (return 0))
          (if (<= ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity) j) (return 0))
          (set a (nth (coco_store_deref st (+ head (+ (cast size_t j) 1))) (-> st cells)))
          (if (or (coco-tag-is REF a) (coco-tag-is FLT a) (coco-tag-is STR a)
                  (coco-tag-is BIG a) (coco-tag-is RAT a))
              (return 0))
          (return a)))

  ;;; `coco_kslot_of', `coco_chain_add' and `coco_chain_from', on another
  ;;; argument's table
  (static)
  (func coco_aix_slot ((coco_argix * x) (u64 key)) (out coco_kslot *)
        (let ((u64 h . #'(* key 1099511628211))
              (size_t mask . #'(- (-> x nslots) 1))
              (size_t i . 0))
          (set i (cast size_t (bitand (>> h 7) (cast u64 mask))))
          (while 1
            (let ((coco_kslot * sl . #'(aof (nth i (-> x slots)))))
              (if (or (== (-> sl key) 0) (== (-> sl key) key)) (return sl)))
            (set i (bitand (+ i 1) mask)))
          (return nil)))

  (static)
  (func coco_aix_add ((coco_argix * x) (u64 key) (size_t at))
        (set (nth at (-> x chain)) (coco_no_clause))
        (if (== key 0)
            (block
             (if (== (-> x varhead) (coco_no_clause))
                 (set (-> x varhead) at)
               (set (nth (-> x vartail) (-> x chain)) at))
             (set (-> x vartail) at)
             (set (-> x nvar) (+ (-> x nvar) 1))
             (return)))
        (let ((coco_kslot * sl . #'(coco_aix_slot x key)))
          (if (== (-> sl key) 0)
              (block (set (-> sl key) key)
                     (set (-> sl head) at)
                     (set (-> sl tail) at)
                     (set (-> sl count) 1)
                     (return)))
          (set (nth (-> sl tail) (-> x chain)) at)
          (set (-> sl tail) at)
          (set (-> sl count) (+ (-> sl count) 1))))

  (static)
  (func coco_aix_from ((coco_argix * x) (size_t h) (size_t from)) (out size_t)
        (while (and (!= h (coco_no_clause)) (< h from))
          (set h (nth h (-> x chain))))
        (return h))

  ;;; WHAT P's `aix' NAMES, made the first time anything wants it (2.9.0's
  ;;; index array, 3.64.0's `coco_aixs'); nil when memory would not grow.
  ;;; The barrier stops the other workers while the one store changes.
  (static)
  (func coco_aixs_of ((coco_store * st) (coco_pred * p)) (out coco_aixs *)
        (if (== (-> p aix) nil)
            (block
             (with-green-write nil
               (if (== (-> p aix) nil)
                   (block
                    (set (-> p aix) (cast (coco_aixs *) (coco-meta-moved st nil 0 (sizeof coco_aixs)
                                                                         (calloc 1 (sizeof coco_aixs)))))
                    (if (== (-> p aix) nil) (set (-> st oom) 1)))))))
        (return (-> p aix)))

  ;;; ARGUMENT POS'S INDEX, built now if it is not: each clause's key read
  ;;; from its head, the table sized to stay under half full. nil when
  ;;; memory would not grow -- the call then stays on the first argument,
  ;;; which is slower and exactly as right.
  (static)
  (func coco_aix_get ((coco_store * st) (coco_machine * m) (coco_pred * p) (u32 pos)) (out coco_argix *)
        (let ((coco_argix * x . nil) (size_t n . 0)
              (u64 neck . 0) (coco_aixs * ax . #'(coco_aixs_of st p)))
          (if (== ax nil) (return nil))
          (set x (aof (nth (- pos 1) (-> ax args))))
          (if (-> x indexed) (return x))
          ;; THE FIRST BUILD OF POS'S INDEX, under the barrier, with the
          ;; recheck inside: another worker's build may have finished while
          ;; this one waited -- and its clause count read there, as another's
          ;; assertz may have gone through in the wait (through 3.63.2 it was
          ;; read before, and a table so built had no row for that clause)
          (with-green-write nil
            (if (-> x indexed) (return x))
            (set n (-> p nclauses))
            (set neck (coco_intern m ":-"))
            (coco-argix-fill x n i (coco_store_arg_key st m (nth i (-> p clauses)) neck pos))
            (return x))))

  ;;; ---- swipl's deep index: the tables (3.64.0) ----------------------------
  ;;;
  ;;; A NODE (`coco_dnode', lib/kb.cicili) IS A LIST INDEX'S CLAUSE LIST:
  ;;; the clauses of the level above whose argument there is one functor's
  ;;; compound, each table of it an argument of the compound. Here: the
  ;;; store walk to a clause's term at a node, a node's members and tables,
  ;;; the walk a retry makes over them, and a call's key at a node. Which
  ;;; node a call descends to is below, after swipl's JIT index
  ;;; (`coco_deep_select').

  (static) (func coco_dnode_none () (out u32) (return 4294967295))

  ;;; THE POSITION A CHOICE FRAME KEEPS for table J of node I: bit 31, the
  ;;; node above the table's three bits -- read back by `coco_call_arg_key'
  ;;; and `coco_pred_next_at', the two readers of a frame's `ixpos'
  (static) (inline)
  (func coco_deep_pos ((u32 i) (u32 j)) (out u32)
        (return (bitor (cast u32 2147483648) (bitor (<< i 3) j))))
  (static) (inline)
  (func coco_deep_node_of ((u32 pos)) (out u32)
        (return (bitand (>> pos 3) 268435455)))

  ;;; Node I of P, or nil
  (static)
  (func coco_dnode_at ((coco_pred * p) (u32 i)) (out coco_dnode *)
        (if (or (== (-> p aix) nil) (>= i (-> (-> p aix) nnodes))) (return nil))
        (return (nth i (-> (-> p aix) nodes))))

  ;;; A STORE CELL's KEY, as `coco_cell_key' reads a heap cell's: none for
  ;;; a variable, a float, a string, a boxed integer or a rational
  (static)
  (func coco_store_cell_key ((coco_store * st) (size_t a)) (out u64)
        (let ((u64 c . #'(nth a (-> st cells))))
          (if (or (coco-tag-is REF c) (coco-tag-is FLT c) (coco-tag-is STR c)
                  (coco-tag-is BIG c) (coco-tag-is RAT c))
              (return 0))
          (return c)))

  ;;; THE TERM OF A STORED CLAUSE AT NODE D's PLACE: its store cell in T and
  ;;; 2 where each term on the way is the node's functor's compound; 1
  ;;; where one has no key -- a variable, which any compound matches, or a
  ;;; float, a string or a big number, which no key names, as the tables
  ;;; above read it; 0 where another functor or constant stands, and the
  ;;; clause is no member. D nil is the head itself.
  (static)
  (func coco_store_path_walk ((coco_store * st) (coco_machine * m) (size_t clause) (u64 neck)
                              (coco_dnode * d) (size_t * t)) (out int)
        (let ((size_t head . 0) (size_t body . 0) (size_t a . 0) (u64 k . 0))
          (coco_store_clause_parts st m clause neck (aof head) (aof body))
          (set a (coco_store_deref st head))
          (if (!= d nil)
              (for ((u32 l . 0)) (< l (-> d depth)) ((++ l))
                (set a (coco_store_deref st (+ a (+ (cast size_t (nth l (-> d path))) 1))))
                (set k (coco_store_cell_key st a))
                (if (== k 0) (return 1))
                (if (!= k (nth l (-> d pfun))) (return 0))))
          (set (cof t) a)
          (return 2)))

  ;;; A MEMBER'S KEY AT ARGUMENT J OF NODE D's COMPOUND: none where the
  ;;; walk met a term with none
  (static)
  (func coco_store_deep_key ((coco_store * st) (coco_machine * m) (size_t clause) (u64 neck)
                             (coco_dnode * d) (u32 j)) (out u64)
        (let ((size_t t . 0))
          (if (!= (coco_store_path_walk st m clause neck d (aof t)) 2) (return 0))
          (return (coco_store_cell_key st (coco_store_deref st (+ t (+ (cast size_t j) 1)))))))

  ;;; NODE NI's TABLE OF ITS COMPOUND's ARGUMENT J, built now if it is not:
  ;;; each member's key there, its chains and slots over the members'
  ;;; indices. nil where the node is not built, or memory would not grow.
  ;;; The node is asked again under the barrier: waiting there this worker
  ;;; acknowledges another's write (`coco_g_write_begin'), which may have
  ;;; left the node to be built again, its members as they were.
  (static)
  (func coco_dtab_get ((coco_store * st) (coco_machine * m) (coco_pred * p) (u32 ni) (u32 j)) (out coco_argix *)
        (let ((coco_dnode * d . #'(coco_dnode_at p ni))
              (coco_argix * x . nil) (size_t n . 0) (u64 neck . 0))
          (if (or (== d nil) (not (-> d built)) (>= j (coco_dnode_ntabs d))) (return nil))
          (set x (aof (nth j (-> d tabs))))
          (if (-> x indexed) (return x))
          (with-green-write nil
            (if (-> x indexed) (return x))
            (if (not (-> d built)) (return nil))
            (set n (-> d nmem))
            (set neck (coco_intern m ":-"))
            (coco-argix-fill x n i (coco_store_deep_key st m (nth (nth i (-> d mem)) (-> p clauses))
                                                        neck d j))
            (return x))))

  ;;; NODE NI BUILT, the level above first: its members are the clauses
  ;;; there whose key at its argument is its functor, or none (as
  ;;; `coco_store_path_walk' reads them). nil where memory would not grow.
  ;;; ALL OF IT UNDER ONE BARRIER, the level above with it (a barrier
  ;;; inside a barrier takes nothing): waiting at it this worker
  ;;; acknowledges another's write, which may grow the keys read before it
  ;;; -- an assertz's -- or leave the level above to be built again.
  (static)
  (func coco_dnode_ensure ((coco_store * st) (coco_machine * m) (coco_pred * p) (u32 ni)) (out coco_dnode *)
        (let ((coco_dnode * d . #'(coco_dnode_at p ni))
              (coco_dnode * pd . nil) (u64 * keys . nil) (size_t n . 0))
          (if (== d nil) (return nil))
          (if (-> d built) (return d))
          (with-green-write nil
            (if (-> d built) (return d))
            (if (== (-> d parent) (coco_dnode_none))
                (if (== (-> d apos) 0)
                    (block (set keys (-> p keys)) (set n (-> p nclauses)))
                    (let ((coco_argix * x . #'(coco_aix_get st m p (-> d apos))))
                      (if (== x nil) (return nil))
                      (set keys (-> x keys))
                      (set n (-> p nclauses))))
                (let ((coco_argix * x . nil))
                  (set pd (coco_dnode_ensure st m p (-> d parent)))
                  (if (== pd nil) (return nil))
                  (set x (coco_dtab_get st m p (-> d parent) (-> d apos)))
                  (if (== x nil) (return nil))
                  (set keys (-> x keys))
                  (set n (-> pd nmem))))
            (set (-> d nmem) 0)
            (for ((size_t i . 0)) (< i n) ((++ i))
              (let ((u64 k . #'(nth i keys)))
                (if (or (== k 0) (== k (-> d fkey)))
                    (block
                     (if (not (coco_store_grow_meta st (cast (void **) (aof (-> d mem))) (aof (-> d mcap))
                                                    (+ (-> d nmem) 1) (sizeof size_t)))
                         (return nil))
                     (set (nth (-> d nmem) (-> d mem)) (? (== pd nil) i (nth i (-> pd mem))))
                     (set (-> d nmem) (+ (-> d nmem) 1))))))
            (set (-> d built) 1)
            (return d))))

  ;;; Node D and its tables left to be built again
  (static)
  (func coco_dnode_unbuild ((coco_dnode * d))
        (set (-> d built) 0)
        (if (!= (-> d tabs) nil)
            (for ((u32 t . 0)) (< t (coco_dnode_ntabs d)) ((++ t))
              (set ($ (nth t (-> d tabs)) indexed) 0))))

  ;;; THE FIRST MEMBER OF NODE D AT OR AFTER POSITION FROM: its index, NMEM
  ;;; past the last. The members are ascending, so a halving.
  (static)
  (func coco_dnode_from ((coco_dnode * d) (size_t from)) (out size_t)
        (let ((size_t lo . 0) (size_t hi . #'(-> d nmem)))
          (while (< lo hi)
            (let ((size_t mid . #'(+ lo (/ (- hi lo) 2))))
              (if (< (nth mid (-> d mem)) from) (set lo (+ mid 1)) (set hi mid))))
          (return lo)))

  ;;; NODE D's TABLE J if it is built, else nil
  (static) (inline)
  (func coco_dtab_had ((coco_dnode * d) (u32 j)) (out coco_argix *)
        (if (or (== (-> d tabs) nil) (>= j (coco_dnode_ntabs d))) (return nil))
        (if (not ($ (nth j (-> d tabs)) indexed)) (return nil))
        (return (aof (nth j (-> d tabs)))))

  ;;; `coco_pred_next_at' ON TABLE POS OF P's DEEP INDEX: the first member at
  ;;; or after FROM whose key is KEY or none, as a position in the clause
  ;;; list -- from the member just tried where the clause just tried is one,
  ;;; as the argument tables start from it. A node or a table that cannot be
  ;;; had answers every member, or every clause: slower and exactly as
  ;;; right. Weak, so the walk a retry makes on an argument's table keeps
  ;;; its registers.
  (weak)
  (func coco_deep_next ((coco_store * st) (coco_machine * m) (coco_pred * p)
                        (u32 pos) (u64 key) (size_t from)) (out size_t)
        (let ((u32 ni . #'(coco_deep_node_of pos))
              (coco_dnode * d . #'(coco_dnode_at p (coco_deep_node_of pos)))
              (coco_argix * x . nil) (size_t lo . 0))
          (if (>= from (-> p nclauses)) (return (coco_no_clause)))
          ;; IN A WORLD A NODE OR A TABLE NOT BUILT IS WALKED AS NONE: its
          ;; build would wait at the barrier (see `coco_pred_next_clause'),
          ;; and with none taken nothing here changes while it is read
          (if (or (== d nil) (not (-> d built)))
              (block
               (if (coco_g_here) (return from))
               (set d (coco_dnode_ensure st m p ni))
               (if (== d nil) (return from))))
          (if (!= key 0)
              (block
               (set x (coco_dtab_had d (bitand pos 7)))
               (if (and (== x nil) (not (coco_g_here)))
                   (set x (coco_dtab_get st m p ni (bitand pos 7))))))
          (set lo (coco_dnode_from d from))
          (if (>= lo (-> d nmem)) (return (coco_no_clause)))
          (if (== x nil) (return (nth lo (-> d mem))))
          (let ((coco_kslot * sl . #'(coco_aix_slot x key))
                (int back . #'(and (> lo 0) (== (nth (- lo 1) (-> d mem)) (- from 1))))
                (u64 kprev . 0)
                (size_t a . #'(coco_no_clause))
                (size_t b . #'(coco_no_clause)))
            (if back (set kprev (nth (- lo 1) (-> x keys))))
            (set b (? (and back (== kprev 0)) (nth (- lo 1) (-> x chain))
                      (coco_aix_from x (-> x varhead) lo)))
            (if (!= (-> sl key) 0)
                (set a (? (and back (== kprev key)) (nth (- lo 1) (-> x chain))
                          (coco_aix_from x (-> sl head) lo))))
            (if (and (== a (coco_no_clause)) (== b (coco_no_clause))) (return (coco_no_clause)))
            (return (nth (? (< a b) a b) (-> d mem))))))

  ;;; A CALL's KEY AT TABLE POS OF P's DEEP INDEX: its term walked down the
  ;;; node's path, the key of argument J there -- none where the walk meets
  ;;; what the node's path is not, which no call keyed on the node has
  (weak)
  (func coco_deep_call_key ((coco_machine * m) (coco_pred * p) (size_t call) (u32 pos)) (out u64)
        (let ((coco_dnode * d . #'(coco_dnode_at p (coco_deep_node_of pos)))
              (size_t t . #'(coco_deref m call)))
          (if (== d nil) (return 0))
          (for ((u32 l . 0)) (< l (-> d depth)) ((++ l))
            (set t (coco_deref m (+ t (+ (cast size_t (nth l (-> d path))) 1))))
            (if (!= (nth t (-> m heap)) (nth l (-> d pfun))) (return 0)))
          (return (coco_cell_key m (+ t (+ (cast size_t (bitand pos 7)) 1))))))

  ;;; THE CLAUSE JUST APPENDED AT THE END OF P, put into every built node it
  ;;; is a member of: at the end of the members, its position the highest
  ;;; there is, and of each built table's chain, its key read from the head
  ;;; just stored -- as `coco_pred_add_clause' extends the argument tables.
  ;;; A table that would be over half full, or a node that would not grow,
  ;;; is left to be built again.
  (static)
  (func coco_deep_add ((coco_store * st) (coco_machine * m) (coco_pred * p) (size_t clause))
        (let ((coco_aixs * ax . #'(-> p aix))
              (u64 neck . #'(coco_intern m ":-"))
              (size_t at . #'(- (-> p nclauses) 1))
              (size_t t . 0))
          (for ((u32 i . 0)) (< i (-> ax nnodes)) ((++ i))
            (let ((coco_dnode * d . #'(nth i (-> ax nodes))))
              (if (and (-> d built) (!= (coco_store_path_walk st m clause neck d (aof t)) 0))
                  (if (not (coco_store_grow_meta st (cast (void **) (aof (-> d mem))) (aof (-> d mcap))
                                                 (+ (-> d nmem) 1) (sizeof size_t)))
                      (coco_dnode_unbuild d)
                      (let ((size_t mi . #'(-> d nmem)))
                        (set (nth mi (-> d mem)) at)
                        (set (-> d nmem) (+ mi 1))
                        (for ((u32 j . 0)) (< j (coco_dnode_ntabs d)) ((++ j))
                          (let ((coco_argix * x . #'(aof (nth j (-> d tabs)))))
                            (if (-> x indexed)
                                (if (and (< (* (-> d nmem) 2) (-> x nslots))
                                         (coco_store_grow_meta st (cast (void **) (aof (-> x keys))) (aof (-> x key_cap))
                                                               (-> d nmem) (sizeof u64))
                                         (coco_store_grow_meta st (cast (void **) (aof (-> x chain))) (aof (-> x chain_cap))
                                                               (-> d nmem) (sizeof size_t)))
                                    (block
                                     (set (nth mi (-> x keys)) (coco_store_deep_key st m clause neck d j))
                                     (coco_aix_add x (nth mi (-> x keys)) mi))
                                  (set (-> x indexed) 0))))))))))))

  ;;; THE ARGUMENT TO INDEX ON -- see the declaration. A predicate under the
  ;;; floor scans its first argument's keys as it always did, and pays a
  ;;; comparison for this; one whose first argument chooses well pays a
  ;;; probe of the table its next ask makes anyway.
  (func coco_pred_select ((coco_store * st) (coco_machine * m) (coco_pred * p)
                          (size_t call)) (out coco_ixsel)
        (let ((coco_ixsel r)
              (size_t best . 0) (u32 n . 0))
          (set ($ r key) (coco_arg_key m call))
          (set ($ r pos) 0)
          (if (< (-> p nclauses) (coco_index_floor)) (return r))
          ;; how many candidates the first argument leaves
          (if (== ($ r key) 0)
              (set best (-> p nclauses))
              (block
               (if (and (== (-> p indexed) 0) (not (coco_pred_reindex st p))) (return r))
               (let ((coco_kslot * sl . #'(coco_kslot_of p ($ r key))))
                 (set best (+ (-> p nvar) (? (== (-> sl key) 0) 0 (-> sl count)))))
               (if (<= best (coco_aix_enough)) (return r))))
          ;; and how many each other bound one does, the fewest winning --
          ;; the earlier argument on a tie, but A COMPOUND'S OVER A CHOICE
          ;; THAT IS NO LIST INDEX (3.73.2): the call may go down into it
          ;; (below), as swipl's list index takes it where its assessment
          ;; finds no other argument better -- over an unbound first
          ;; argument, a key every clause shares, a compound a clause's
          ;; variable keeps from being a list index; one that is keeps the
          ;; tie, swipl's first. Through 3.73.1 `p(_, [w])' over
          ;; forty thousand facts of `p(K, [W])' walked every one of them.
          ;; A predicate of one argument has none, and is asked only
          ;; below, whether to look inside it.
          (set call (coco_deref m call))
          (set n (? (< (-> p arity) 2) 0 (- (-> p arity) 1)))
          (if (> n (coco_aix_count)) (set n (coco_aix_count)))
          (for ((u32 j . 1)) (<= j n) ((++ j))
            (let ((u64 kj . #'(coco_cell_key m (+ call (+ (cast size_t j) 1)))))
              (if (!= kj 0)
                  (let ((coco_argix * x . #'(coco_aix_get st m p j)))
                    (if (!= x nil)
                        (let ((coco_kslot * sl . #'(coco_aix_slot x kj))
                              (size_t c . 0))
                          (set c (+ (-> x nvar) (? (== (-> sl key) 0) 0 (-> sl count))))
                          (if (or (< c best)
                                  (and (== c best)
                                       (and (coco-tag-is FUN kj)
                                            (not (and (coco-tag-is FUN ($ r key))
                                                      (coco_root_list st m p ($ r pos) -1.0))))))
                              (block (set best c) (set ($ r pos) j) (set ($ r key) kj)))))))))
          ;; A FUNCTOR TOO MANY CLAUSES SHARE, where swipl's list index would
          ;; hold them, keys the call inside its compound (3.64.0,
          ;; `coco_deep_select'): its first argument's own key there walked
          ;; the whole chain, a lookup by a handle of a hundred thousand
          ;; facts 290 times swipl's time
          (if (and (> best (coco_aix_enough)) (coco-tag-is FUN ($ r key))
                   (coco_root_list st m p ($ r pos) -1.0))
              (return (coco_deep_select st m p ($ r pos) ($ r key)
                                        (coco_deref m (+ call (+ (cast size_t ($ r pos)) 1))))))
          (return r)))

  (func coco_call_arg_key ((coco_machine * m) (coco_pred * p) (size_t call) (u32 pos)) (out u64)
        (if (== pos 0) (return (coco_arg_key m call)))
        (if (!= (bitand pos (cast u32 2147483648)) 0) (return (coco_deep_call_key m p call pos)))
        (return (coco_cell_key m (+ (coco_deref m call) (+ (cast size_t pos) 1)))))

  ;;; THE TABLE OF ARGUMENT POS A WALK READS: in a world, one not built is
  ;;; none and every clause from the walk's place a candidate -- its build
  ;;; would wait at the barrier (see `coco_pred_next_clause'). A call's
  ;;; choice of argument built it (`coco_pred_select', `coco_pred_jit').
  (static)
  (func coco_aix_walk ((coco_store * st) (coco_machine * m) (coco_pred * p) (u32 pos)) (out coco_argix *)
        (if (and (or (== (-> p aix) nil) (not ($ (nth (- pos 1) (-> (-> p aix) args)) indexed)))
                 (coco_g_here))
            (return nil))
        (return (coco_aix_get st m p pos)))

  (func coco_pred_next_at ((coco_store * st) (coco_machine * m) (coco_pred * p)
                           (u32 pos) (u64 key) (size_t from)) (out size_t)
        (if (== pos 0) (return (coco_pred_next_clause st p key from)))
        ;; a table of the deep index (3.64.0), out of line
        (if (!= (bitand pos (cast u32 2147483648)) 0) (return (coco_deep_next st m p pos key from)))
        (if (== key 0) (return (coco_pred_next_clause st p key from)))
        (if (>= from (-> p nclauses)) (return (coco_no_clause)))
        (let ((coco_argix * x . #'(coco_aix_walk st m p pos)))
          ;; no table to be had: every clause from FROM is a candidate
          (if (== x nil) (return from))
          ;; from the clause just tried, as `coco_pred_next_clause' does
          (let ((coco_kslot * sl . #'(coco_aix_slot x key))
                (int back . #'(> from 0))
                (u64 kprev . 0)
                (size_t a . #'(coco_no_clause))
                (size_t b . #'(coco_no_clause)))
            (if back (set kprev (nth (- from 1) (-> x keys))))
            (set b (? (and back (== kprev 0)) (nth (- from 1) (-> x chain))
                      (coco_aix_from x (-> x varhead) from)))
            (if (!= (-> sl key) 0)
                (set a (? (and back (== kprev key)) (nth (- from 1) (-> x chain))
                          (coco_aix_from x (-> sl head) from))))
            (if (== a (coco_no_clause)) (return b))
            (if (== b (coco_no_clause)) (return a))
            (return (? (< a b) a b)))))

  (func coco_pred_probe_at ((coco_store * st) (coco_machine * m) (coco_pred * p)
                            (u32 pos) (u64 key) (size_t * ix)) (out int)
        (if (or (== pos 0) (and (== key 0) (== (bitand pos (cast u32 2147483648)) 0)))
            (return (coco_pred_probe st p key ix m)))
        (if (== (-> p nprobe) 0) (return (coco_pred_probe_cold st p key ix m pos)))
        (let ((size_t a . #'(coco_pred_next_at st m p pos key 0)))
          (if (== a (coco_no_clause)) (return 0))
          (set (cof ix) a)
          (return (? (== (coco_pred_next_at st m p pos key (+ a 1)) (coco_no_clause)) 1 2))))

  ;;; ---- swipl's JIT index, for a predicate under the floor (3.24.0) --------
  ;;;
  ;;; A CALL WHOSE FIRST ARGUMENT CANNOT CHOOSE IS KEYED ON ANOTHER, as
  ;;; swipl's first_clause_guarded keys it (pl-index.c, read at 9.0.4): its
  ;;; first argument unbound, or the first two clauses it leaves both of its
  ;;; key. Below the floor through 3.23.0 every such call was keyed on its
  ;;; first argument alone, and `q(_, [1, 2])' over `q(_, []). q(_, [_|T]) :-
  ;;; q(_, T).' left a choice point at its last step where swipl leaves none.
  ;;; The argument is chosen as swipl's bestHash chooses it: of the call's
  ;;; bound arguments the one whose assessment over the clauses promises the
  ;;; most (`coco_jit_assess'), the first on a tie, and none that promises
  ;;; nothing -- an argument some clause leaves unbound past a tenth of its
  ;;; values. Swipl's own index on the first argument winning keeps the call
  ;;; where it was, and an argument that is a list index goes on inside the
  ;;; compound (3.64.0, `coco_deep_select', below). Not swipl's (COMPAT.md):
  ;;; an index of two arguments together, keys of floats and strings, an
  ;;; argument past the eighth, an index kept from the calls before, and
  ;;; 9.0.4's reading of a key after two anonymous variables in a row as none
  ;;; (`v(_, _, x)', pl-comp.c's skipArgs).

  ;;; SWIPL'S ASSESSMENT OF ONE ARGUMENT, the clauses' N KEYS at it
  ;;; (assess_remove_duplicates): its distinct keys D and the clauses with
  ;;; none V, the speedup N*D / (N - V + V*D) punished by the spread of the
  ;;; keys' counts (1 + stdev*D/N), nothing for clauses with no key past a
  ;;; tenth of D, and nothing for one value that is no compound. Through
  ;;; 3.63 that one promised 1, for keyed on it a call has the candidates of
  ;;; no index, all or none; since the deep index (3.64.0) it is swipl's
  ;;; nothing, or it ties with a compound's argument that promises 1 and
  ;;; takes it from the list index that argument is (`dn(x, f(a))').
  ;;; Quadratic in N, which is under the floor of eight.
  (static)
  (func coco_jit_assess ((u64 * keys) (size_t n)) (out double)
        (let ((size_t v . 0) (size_t d . 0) (u64 k1 . 0)
              (double a . 0.0) (double q . 0.0) (double s . 0.0))
          (for ((size_t i . 0)) (< i n) ((++ i))
            (let ((u64 k . #'(nth i keys)) (int seen . 0))
              (if (== k 0)
                  (set v (+ v 1))
                  (block
                   (for ((size_t j . 0)) (< j i) ((++ j))
                     (if (== (nth j keys) k) (set seen 1)))
                   (if (not seen)
                       (let ((size_t c . 0) (double a0 . a))
                         (for ((size_t j . i)) (< j n) ((++ j))
                           (if (== (nth j keys) k) (set c (+ c 1))))
                         (set d (+ d 1))
                         (set k1 k)
                         ;; the mean and squares of the counts, Welford's, as
                         ;; swipl's
                         (set a (+ a (/ (- (cast double c) a) (cast double d))))
                         (set q (+ q (* (- (cast double c) a0) (- (cast double c) a))))))))))
          (if (== d 0) (return 0.0))
          (if (and (== d 1) (not (coco-tag-is FUN k1))) (return 0.0))
          (set s (/ (cast double (* n d)) (cast double (+ (- n v) (* v d)))))
          (set s (/ s (+ 1.0 (/ (* (sqrt (/ q (cast double d))) (cast double d)) (cast double n)))))
          (if (> (/ (cast double v) (cast double d)) 0.1) (return 0.0))
          (return s)))

  ;;; ARGUMENT POS'S SPEEDUP for P as its clauses stand, assessed again only
  ;;; after they change (`tver'): the first argument's from P's own keys, any
  ;;; other's from its index, built here if it is not. Written under the
  ;;; green barrier, as the index is.
  (static)
  (func coco_jit_speedup ((coco_store * st) (coco_machine * m) (coco_pred * p) (u32 pos)) (out double)
        (let ((u64 ver . #'(bitor (cast u64 (-> p tver)) (<< (cast u64 1) 32))))
          (if (== pos 0)
              (block
               (if (!= (-> p j0ver) ver)
                   (let ((double s . #'(coco_jit_assess (-> p keys) (-> p nclauses))))
                     (with-green-write nil
                       (set (-> p j0spd) s)
                       (set (-> p j0ver) ver))))
               (return (-> p j0spd))))
          (let ((coco_argix * x . #'(coco_aix_get st m p pos)))
            (if (== x nil) (return 0.0))
            (if (!= (-> x aver) ver)
                (let ((double s . #'(coco_jit_assess (-> x keys) (-> p nclauses))))
                  (with-green-write nil
                    (set (-> x aspd) s)
                    (set (-> x aver) ver))))
            (return (-> x aspd)))))

  ;;; THE CALL'S KEY AT POS: from its term at CALL, or from REGS, the
  ;;; registers it was written into
  (static)
  (func coco_jit_key ((coco_machine * m) (coco_pred * p) (size_t call) (size_t * regs) (u32 pos)) (out u64)
        (if (!= regs nil) (return (coco_cell_key m (nth pos regs))))
        (return (coco_call_arg_key m p call pos)))

  ;;; THE CALL'S TERM AT POS, dereferenced: from CALL, or from REGS
  (static)
  (func coco_jit_term ((coco_machine * m) (size_t call) (size_t * regs) (u32 pos)) (out size_t)
        (if (!= regs nil) (return (coco_deref m (nth pos regs))))
        (return (coco_deref m (+ (coco_deref m call) (+ (cast size_t pos) 1)))))

  ;;; THE PROBE ON THE ARGUMENT SWIPL WOULD INDEX -- see the declaration and
  ;;; above. 2 with KPOS untouched where it would index the first argument,
  ;;; or none. Where swipl would make its index there a list index, and the
  ;;; call's key there is a functor's, the call is keyed inside the compound
  ;;; (3.64.0, `coco_deep_select'), and KPOS is what that chose.
  (weak)
  (func coco_pred_jit ((coco_store * st) (coco_machine * m) (coco_pred * p) (size_t call)
                       (size_t * regs) (size_t * ix) (u32 * kpos)) (out int)
        (let ((u32 na . #'(-> p arity)) (int best . -1) (double bs . 0.0) (u64 kb . 0))
          (if (> na (+ (coco_aix_count) 1)) (set na (+ (coco_aix_count) 1)))
          (for ((u32 pos . 0)) (< pos na) ((++ pos))
            (if (!= (coco_jit_key m p call regs pos) 0)
                (let ((double s . #'(coco_jit_speedup st m p pos)))
                  (if (> s bs) (block (set bs s) (set best (cast int pos)))))))
          (if (< best 0) (return 2))
          (set kb (coco_jit_key m p call regs (cast u32 best)))
          (if (and (coco-tag-is FUN kb) (coco_root_list st m p (cast u32 best) bs))
              (let ((coco_ixsel r . #'(coco_deep_select st m p (cast u32 best) kb
                                                        (coco_jit_term m call regs (cast u32 best))))
                    (int dr . 0))
                (set (cof kpos) ($ r pos))
                ;; the first argument's own probe answers 3 where it would
                ;; ask this: the answer is its 2
                (set dr (coco_pred_probe_at st m p ($ r pos) ($ r key) ix))
                (return (? (== dr 3) 2 dr))))
          (if (== best 0) (return 2))
          (set (cof kpos) (cast u32 best))
          (return (coco_pred_probe_at st m p (cast u32 best) kb ix))))

  ;;; ---- swipl's deep index: the choice (3.64.0) -----------------------------
  ;;;
  ;;; A CALL WHOSE BEST ARGUMENT SWIPL WOULD MAKE A LIST INDEX IS KEYED INSIDE
  ;;; ITS COMPOUND, as pl-index.c keys it (read at 9.0.4): first_clause_guarded
  ;;; finds the bucket of the call's functor there, a clause list of its own,
  ;;; and is asked again of that list and the compound's arguments
  ;;; (nextClauseFromBucket), at most seven deep (MAXINDEXDEPTH). Each level
  ;;; walks a list of ten clauses or fewer on its first argument and asks
  ;;; the others only where the first two candidates are both of the call's
  ;;; key there, else keys the call on the bound argument whose assessment
  ;;; promises the most (bestHash), and goes deeper where that one is a list
  ;;; index again and the call's key there a functor. Through 3.63 a call of
  ;;; `p(f(a))' over `p(f(a)). p(f(b)).' left a choice point where swipl
  ;;; leaves none, and a lookup by a handle `n(Doc, Index, Gen)' walked every
  ;;; fact of the handle's functor (Ambitious's finding 13: 290 times swipl's
  ;;; time over a hundred thousand). Not swipl's (COMPAT.md): what its
  ;;; indexes kept from the calls before decide, an index of two arguments,
  ;;; and keys of floats and strings, which a list index of swipl's has and
  ;;; a variable's place here takes.

  ;;; SWIPL'S ASSESSMENT OF A TABLE OF N CLAUSES from its slots, in a pass
  ;;; over them where `coco_jit_assess' is quadratic in N: its distinct keys
  ;;; D and the clauses with none NVAR, N*D / (N - V + V*D) over
  ;;; 1 + stdev*D/N, nothing for one value that is no compound -- swipl's own
  ;;; rule, which the predicate's own arguments under the floor do not keep
  ;;; (`coco_jit_assess') -- and nothing for clauses with no key past a
  ;;; tenth of D
  (static)
  (func coco_slots_assess ((coco_kslot * sl) (size_t nslots) (size_t nvar) (size_t n)) (out double)
        (let ((size_t d . 0) (double a . 0.0) (double q . 0.0) (double s . 0.0) (u64 k1 . 0))
          (for ((size_t i . 0)) (< i nslots) ((++ i))
            (if (!= ($ (nth i sl) key) 0)
                (let ((double c . #'(cast double ($ (nth i sl) count))) (double a0 . a))
                  (set d (+ d 1))
                  (set k1 ($ (nth i sl) key))
                  (set a (+ a (/ (- c a) (cast double d))))
                  (set q (+ q (* (- c a0) (- c a)))))))
          (if (== d 0) (return 0.0))
          (if (and (== d 1) (not (coco-tag-is FUN k1))) (return 0.0))
          (set s (/ (cast double (* n d)) (cast double (+ (- n nvar) (* nvar d)))))
          (set s (/ s (+ 1.0 (/ (* (sqrt (/ q (cast double d))) (cast double d)) (cast double n)))))
          (if (> (/ (cast double nvar) (cast double d)) 0.1) (return 0.0))
          (return s)))

  ;;; HOW OFTEN EACH OF THE N VARIABLES AT STORE CELLS VS OCCURS IN THE
  ;;; CLAUSE, in CNT: every argument of every compound of it counted, its
  ;;; first occurrence the variable's own cell, the others references to
  ;;; it. A walk of its own stack, so a long list is no C recursion.
  (static)
  (func coco_store_var_counts ((coco_store * st) (coco_machine * m) (size_t clause)
                               (size_t * vs) (u32 * cnt) (u32 n))
        (let ((size_t buf [64]) (size_t * sk . buf) (size_t cap . 64) (size_t top . 0)
              (size_t c0 . #'(coco_store_deref st clause)))
          (for ((u32 k . 0)) (< k n) ((++ k)) (set (nth k cnt) 0))
          (if (not (coco-tag-is FUN (nth c0 (-> st cells)))) (return))
          (set (nth 0 sk) c0)
          (set top 1)
          (while (> top 0)
            (set top (- top 1))
            (let ((size_t t . #'(nth top sk))
                  (u32 ar . #'($ (nth (cast size_t (coco-payload (nth t (-> st cells)))) (-> m functors)) arity)))
              (for ((u32 i . 0)) (< i ar) ((++ i))
                (let ((size_t a . #'(coco_store_deref st (+ t (+ (cast size_t i) 1))))
                      (u64 c . 0))
                  (set c (nth a (-> st cells)))
                  (cond
                    ((coco-tag-is REF c)
                     (for ((u32 k . 0)) (< k n) ((++ k))
                       (if (== (nth k vs) a) (set (nth k cnt) (+ (nth k cnt) 1)))))
                    ((coco-tag-is FUN c)
                     (if (>= top cap)
                         (let ((size_t * g . #'(cast (size_t *) (malloc (* (* cap 2) (sizeof size_t))))))
                           ;; no room for the walk: what it counted stands,
                           ;; a count that can only be short
                           (if (== g nil) (block (if (!= sk buf) (free (cast (void *) sk))) (return)))
                           (memcpy (cast (void *) g) (cast (void *) sk) (* top (sizeof size_t)))
                           (if (!= sk buf) (free (cast (void *) sk)))
                           (set sk g)
                           (set cap (* cap 2))))
                     (set (nth top sk) a)
                     (set top (+ top 1))))))))
          (if (!= sk buf) (free (cast (void *) sk)))))

  ;;; WHETHER NEITHER VARIABLE X NOR Y OCCURS IN THE HEAD BEFORE COMPOUND T,
  ;;; the head read in the compiler's order: its arguments left to right,
  ;;; each compound's before what follows it
  (static)
  (func coco_store_first_at ((coco_store * st) (coco_machine * m) (size_t clause) (u64 neck)
                             (size_t t) (size_t x) (size_t y)) (out int)
        (let ((size_t buf [64]) (size_t * sk . buf) (size_t cap . 64) (size_t top . 0)
              (size_t head . 0) (size_t body . 0) (int r . 1) (int go . 1))
          (coco_store_clause_parts st m clause neck (aof head) (aof body))
          (set (nth 0 sk) (coco_store_deref st head))
          (set top 1)
          (while (and go (> top 0))
            (set top (- top 1))
            (let ((size_t a . #'(nth top sk)) (u64 c . 0))
              (set c (nth a (-> st cells)))
              (cond
                ((== a t) (set go 0))
                ((coco-tag-is REF c) (if (or (== a x) (== a y)) (block (set r 0) (set go 0))))
                ((coco-tag-is FUN c)
                 (let ((u32 ar . #'($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity)))
                   (if (> (+ top (cast size_t ar)) cap)
                       (let ((size_t nc . #'(* (+ top (cast size_t ar)) 2))
                             (size_t * g . nil))
                         (set g (cast (size_t *) (malloc (* nc (sizeof size_t)))))
                         (if (== g nil) (block (set r 0) (set go 0)))
                         (if (!= g nil)
                             (block
                              (memcpy (cast (void *) g) (cast (void *) sk) (* top (sizeof size_t)))
                              (if (!= sk buf) (free (cast (void *) sk)))
                              (set sk g)
                              (set cap nc)))))
                   ;; the arguments pushed last first, so the first is read first
                   (if go
                       (let ((u32 i . ar))
                         (while (> i 0)
                           (set i (- i 1))
                           (set (nth top sk) (coco_store_deref st (+ a (+ (cast size_t i) 1))))
                           (set top (+ top 1))))))))))
          (if (!= sk buf) (free (cast (void *) sk)))
          (return r)))

  ;;; WHAT indexableCompound READS OF THE ARGUMENTS AT STORE CELLS
  ;;; VS[FROM..TO), CNT their variables' counts: the variables at their end
  ;;; that occur once dropped, as the compound's H_POP takes them, and 1
  ;;; where any left is no variable, or one that occurs once -- an H_VOID
  ;;; where the others are H_VAR
  (static)
  (func coco_voids_read ((coco_store * st) (size_t * vs) (u32 * cnt) (u32 from) (u32 to)) (out int)
        (let ((u32 e . to))
          (while (and (> e from) (coco-tag-is REF (nth (nth (- e 1) vs) (-> st cells)))
                      (== (nth (- e 1) cnt) 1))
            (set e (- e 1)))
          (for ((u32 i . from)) (< i e) ((++ i))
            (if (or (not (coco-tag-is REF (nth (nth i vs) (-> st cells)))) (== (nth i cnt) 1))
                (return 1)))
          (return 0)))

  ;;; WHETHER SWIPL'S COMPILER MAKES THE COMPOUND OF A STORED CLAUSE AT
  ;;; ARGUMENT J OF NODE D's PLACE (D nil: the head's) AN INDEXABLE ONE, as
  ;;; pl-index.c's indexableCompound reads the head's code (pl-comp.c): an
  ;;; argument that is no variable makes it one, and so does one that occurs
  ;;; once in the clause -- H_VOID -- before a variable that occurs again,
  ;;; though not the ones at its end, which the compiler folds into the
  ;;; compound's H_POP. A list cell of two variables each met first there and
  ;;; occurring again is one instruction, H_LIST_FF, whose test reads what
  ;;; follows it: the arguments after it in its compound as above, or the
  ;;; head's next ones, which always read as one. A compound past sixteen
  ;;; variables is taken as none.
  (static)
  (func coco_store_indexable ((coco_store * st) (coco_machine * m) (size_t clause) (u64 neck)
                              (coco_dnode * d) (u32 j)) (out int)
        (let ((size_t par . 0) (size_t t . 0) (u64 c . 0) (u32 ar . 0) (u32 par_ar . 0)
              (size_t vs [16]) (u32 cnt [16]) (u32 nv . 0) (u32 nt . 0) (int ff . 0))
          (if (!= (coco_store_path_walk st m clause neck d (aof par)) 2) (return 0))
          (set t (coco_store_deref st (+ par (+ (cast size_t j) 1))))
          (set c (nth t (-> st cells)))
          (if (not (coco-tag-is FUN c)) (return 0))
          (set ar ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity))
          (if (> ar 16) (return 0))
          ;; an argument that is no variable
          (for ((u32 i . 0)) (< i ar) ((++ i))
            (set (nth i vs) (coco_store_deref st (+ t (+ (cast size_t i) 1))))
            (if (not (coco-tag-is REF (nth (nth i vs) (-> st cells)))) (return 1)))
          (set nt ar)
          (set nv ar)
          ;; a list cell of two distinct variables may be H_LIST_FF: the
          ;; arguments after it in its compound are asked too
          (set ff (and (== ar 2) (!= (nth 0 vs) (nth 1 vs))
                       (== (coco-payload c) (coco_cons_fid m))))
          (if (and ff (!= d nil))
              (block
               (set par_ar ($ (nth (cast size_t (coco-payload (nth par (-> st cells)))) (-> m functors)) arity))
               (for ((u32 i . #'(+ j 1))) (and (< i par_ar) (< nv 16)) ((++ i))
                 (set (nth nv vs) (coco_store_deref st (+ par (+ (cast size_t i) 1))))
                 (set nv (+ nv 1)))))
          (coco_store_var_counts st m clause vs cnt nv)
          (if ff
              (set ff (and (>= (nth 0 cnt) 2) (>= (nth 1 cnt) 2)
                           (coco_store_first_at st m clause neck t (nth 0 vs) (nth 1 vs)))))
          (if ff
              ;; what follows H_LIST_FF: the head's next argument, or the
              ;; compound's arguments after it, its trailing voids its H_POP
              (block
               (if (== d nil) (return 1))
               (return (coco_voids_read st vs cnt nt nv)))
              (return (coco_voids_read st vs cnt 0 nt)))))

  ;;; WHETHER A FUNCTOR's FIRST RUN OF CLAUSES IN A TABLE HOLDS TWO THAT
  ;;; SWIPL's COMPILER MAKES INDEXABLE COMPOUNDS (`coco_store_indexable'),
  ;;; assess_remove_duplicates' funct_count: a run is clauses next to each
  ;;; other with one key, in the table's order, and only each key's first
  ;;; counts -- 9.0.4 merges a key's later runs into it and keeps the
  ;;; first's count (pl-index.c's `s->nvcomp += s->nvcomp'). The table is
  ;;; X, or P's own first argument's where X is nil; its entries are P's
  ;;; clauses, or node D's members. A run is a key's first where the key's
  ;;; chain begins, which the slot keeps.
  (static)
  (func coco_deep_functs ((coco_store * st) (coco_machine * m) (coco_pred * p) (coco_dnode * d)
                          (u32 j) (coco_argix * x)) (out int)
        (let ((u64 * keys . #'(? (== x nil) (-> p keys) (-> x keys)))
              (size_t n . #'(? (== d nil) (-> p nclauses) (-> d nmem)))
              (u64 neck . #'(coco_intern m ":-"))
              (int first . 0) (int cnt . 0))
          (for ((size_t i . 0)) (< i n) ((++ i))
            (let ((u64 k . #'(nth i keys)))
              (if (or (== i 0) (!= k (nth (- i 1) keys)))
                  (let ((coco_kslot * sl . nil))
                    (set cnt 0)
                    (set first 0)
                    (if (coco-tag-is FUN k)
                        (block
                         (set sl (? (== x nil) (coco_kslot_of p k) (coco_aix_slot x k)))
                         (set first (== (-> sl head) i))))))
              (if (and first
                       (coco_store_indexable st m (nth (? (== d nil) i (nth i (-> d mem))) (-> p clauses))
                                             neck d j))
                  (block (set cnt (+ cnt 1)) (if (>= cnt 2) (return 1))))))
          (return 0)))

  ;;; THE SPEEDUP OF NODE NI's TABLE J as its members stand (`tver'), from
  ;;; its slots
  (static)
  (func coco_dtab_speedup ((coco_store * st) (coco_machine * m) (coco_pred * p) (u32 ni) (u32 j)) (out double)
        (let ((coco_argix * x . #'(coco_dtab_get st m p ni j))
              (coco_dnode * d . #'(coco_dnode_at p ni))
              (u64 ver . #'(bitor (cast u64 (-> p tver)) (<< (cast u64 1) 32))))
          (if (== x nil) (return 0.0))
          (if (!= (-> x aver) ver)
              (let ((double s . #'(coco_slots_assess (-> x slots) (-> x nslots) (-> x nvar) (-> d nmem))))
                (with-green-write nil
                  (set (-> x aspd) s)
                  (set (-> x aver) ver))))
          (return (-> x aspd))))

  ;;; WHETHER SWIPL WOULD MAKE A TABLE OF N CLAUSES WHOSE SPEEDUP IS S A LIST
  ;;; INDEX (assess_remove_duplicates' `list'): S under 0.8 of N, no clause
  ;;; with no key there, and a functor's run of two indexable compounds
  (static)
  (func coco_deep_list_rule ((coco_store * st) (coco_machine * m) (coco_pred * p) (coco_dnode * d)
                             (u32 j) (coco_argix * x) (double s) (size_t n) (size_t nvar)) (out int)
        (if (not (< s (* 0.8 (cast double n)))) (return 0))
        (if (!= nvar 0) (return 0))
        (return (coco_deep_functs st m p d j x)))

  ;;; ... of node NI's table J, its speedup S, as its members stand
  (static)
  (func coco_dtab_list ((coco_store * st) (coco_machine * m) (coco_pred * p) (u32 ni) (u32 j)
                        (double s)) (out int)
        (let ((coco_argix * x . #'(coco_dtab_get st m p ni j))
              (coco_dnode * d . #'(coco_dnode_at p ni))
              (u64 ver . #'(bitor (cast u64 (-> p tver)) (<< (cast u64 1) 32)))
              (int r . 0))
          (if (== x nil) (return 0))
          (if (== (-> x lver) ver) (return (-> x alist)))
          (set r (coco_deep_list_rule st m p d j x s (-> d nmem) (-> x nvar)))
          (with-green-write nil
            (set (-> x alist) r)
            (set (-> x lver) ver))
          (return r)))

  ;;; ... of P's own argument POS (see the declaration), as its clauses
  ;;; stand: the first argument's table is P's, the others' `coco_aix_get''s
  (func coco_root_list ((coco_store * st) (coco_machine * m) (coco_pred * p) (u32 pos) (double s)) (out int)
        (let ((coco_aixs * ax . #'(coco_aixs_of st p))
              (coco_argix * x . nil)
              (u64 ver . #'(bitor (cast u64 (-> p tver)) (<< (cast u64 1) 32)))
              (size_t nvar . 0) (int r . 0))
          (if (== ax nil) (return 0))
          (if (== pos 0)
              (block
               (if (== (-> ax l0ver) ver) (return (-> ax l0list)))
               (if (and (== (-> p indexed) 0) (not (coco_pred_reindex st p))) (return 0))
               (set nvar (-> p nvar))
               (if (< s 0.0) (set s (coco_slots_assess (-> p slots) (-> p nslots) nvar (-> p nclauses)))))
              (block
               (set x (coco_aix_get st m p pos))
               (if (== x nil) (return 0))
               (if (== (-> x lver) ver) (return (-> x alist)))
               (set nvar (-> x nvar))
               (if (< s 0.0) (set s (coco_slots_assess (-> x slots) (-> x nslots) nvar (-> p nclauses))))))
          (set r (coco_deep_list_rule st m p nil pos x s (-> p nclauses) nvar))
          (with-green-write nil
            (if (== x nil)
                (block (set (-> ax l0list) r) (set (-> ax l0ver) ver))
                (block (set (-> x alist) r) (set (-> x lver) ver))))
          (return r)))

  ;;; ---- the nodes, found and made

  (static) (inline)
  (func coco_dnode_hash ((u32 par) (u32 apos) (u64 fkey)) (out u64)
        (return (* (xor (xor fkey (<< (cast u64 par) 3)) (cast u64 apos)) 1099511628211)))

  ;;; THE NODE BELOW PAR (`coco_dnode_none' for P's own arguments) AT ITS
  ;;; ARGUMENT APOS FOR FKEY's FUNCTOR: its index, or `coco_dnode_none'
  (static)
  (func coco_dnode_find ((coco_aixs * ax) (u32 par) (u32 apos) (u64 fkey)) (out u32)
        (if (== (-> ax nhcap) 0) (return (coco_dnode_none)))
        (let ((size_t mask . #'(- (cast size_t (-> ax nhcap)) 1))
              (size_t i . 0))
          (set i (cast size_t (bitand (>> (coco_dnode_hash par apos fkey) 7) (cast u64 mask))))
          (while (!= (nth i (-> ax nhash)) 0)
            (let ((coco_dnode * d . #'(nth (- (nth i (-> ax nhash)) 1) (-> ax nodes))))
              (if (and (== (-> d parent) par) (== (-> d apos) apos) (== (-> d fkey) fkey))
                  (return (- (nth i (-> ax nhash)) 1))))
            (set i (bitand (+ i 1) mask)))
          (return (coco_dnode_none))))

  ;;; Node NI put into the hash, which has room for it
  (static)
  (func coco_dnode_hput ((coco_aixs * ax) (u32 ni))
        (let ((coco_dnode * d . #'(nth ni (-> ax nodes)))
              (size_t mask . #'(- (cast size_t (-> ax nhcap)) 1))
              (size_t i . 0))
          (set i (cast size_t (bitand (>> (coco_dnode_hash (-> d parent) (-> d apos) (-> d fkey)) 7)
                                      (cast u64 mask))))
          (while (!= (nth i (-> ax nhash)) 0) (set i (bitand (+ i 1) mask)))
          (set (nth i (-> ax nhash)) (+ ni 1))))

  ;;; ... made where there is none, under the barrier: its path and functors
  ;;; its parent's and its own, a table an argument of its compound
  (static)
  (func coco_dnode_get ((coco_store * st) (coco_machine * m) (coco_pred * p)
                        (u32 par) (u32 apos) (u64 fkey)) (out u32)
        (let ((coco_aixs * ax . #'(coco_aixs_of st p)) (u32 ni . 0))
          (if (== ax nil) (return (coco_dnode_none)))
          (set ni (coco_dnode_find ax par apos fkey))
          (if (!= ni (coco_dnode_none)) (return ni))
          (with-green-write nil
            (set ni (coco_dnode_find ax par apos fkey))
            (if (!= ni (coco_dnode_none)) (return ni))
            (if (>= (-> ax nnodes) (-> ax ncap))
                (let ((u32 nc . #'(? (== (-> ax ncap) 0) 8 (* (-> ax ncap) 2)))
                      (void * g . nil))
                  (set g (coco-meta-moved st (cast (void *) (-> ax nodes))
                                          (* (cast size_t (-> ax ncap)) (sizeof (coco_dnode *)))
                                          (* (cast size_t nc) (sizeof (coco_dnode *)))
                                          (realloc (cast (void *) (-> ax nodes))
                                                   (* (cast size_t nc) (sizeof (coco_dnode *))))))
                  (if (== g nil) (block (set (-> st oom) 1) (return (coco_dnode_none))))
                  (set (-> ax nodes) (cast (coco_dnode **) g))
                  (set (-> ax ncap) nc)))
            (if (>= (* (+ (-> ax nnodes) 1) 2) (-> ax nhcap))
                (let ((u32 hc . #'(? (== (-> ax nhcap) 0) 16 (* (-> ax nhcap) 2)))
                      (u32 * h . nil))
                  (set h (cast (u32 *) (coco-meta-moved st nil 0 (* (cast size_t hc) (sizeof u32))
                                                        (calloc (cast size_t hc) (sizeof u32)))))
                  (if (== h nil) (block (set (-> st oom) 1) (return (coco_dnode_none))))
                  (free (cast (void *) (-> ax nhash)))
                  (set (-> ax nhash) h)
                  (set (-> ax nhcap) hc)
                  (for ((u32 i . 0)) (< i (-> ax nnodes)) ((++ i)) (coco_dnode_hput ax i))))
            (let ((coco_dnode * d . #'(cast (coco_dnode *) (coco-meta-moved st nil 0 (sizeof coco_dnode)
                                                                            (calloc 1 (sizeof coco_dnode))))))
              (if (== d nil) (block (set (-> st oom) 1) (return (coco_dnode_none))))
              (set (-> d parent) par)
              (set (-> d apos) apos)
              (set (-> d fkey) fkey)
              (set (-> d arity) ($ (nth (cast size_t (coco-payload fkey)) (-> m functors)) arity))
              (if (!= par (coco_dnode_none))
                  (let ((coco_dnode * pd . #'(nth par (-> ax nodes))))
                    (for ((u32 l . 0)) (< l (-> pd depth)) ((++ l))
                      (set (nth l (-> d path)) (nth l (-> pd path)))
                      (set (nth l (-> d pfun)) (nth l (-> pd pfun))))
                    (set (-> d depth) (-> pd depth))))
              (set (nth (-> d depth) (-> d path)) apos)
              (set (nth (-> d depth) (-> d pfun)) fkey)
              (set (-> d depth) (+ (-> d depth) 1))
              (if (> (-> d arity) 0)
                  (block
                   (set (-> d tabs) (cast (coco_argix *)
                                          (coco-meta-moved st nil 0
                                                           (* (cast size_t (coco_dnode_ntabs d)) (sizeof coco_argix))
                                                           (calloc (cast size_t (coco_dnode_ntabs d))
                                                                   (sizeof coco_argix)))))
                   (if (== (-> d tabs) nil)
                       (block (free (cast (void *) d)) (set (-> st oom) 1) (return (coco_dnode_none))))))
              (set ni (-> ax nnodes))
              (set (nth ni (-> ax nodes)) d)
              (set (-> ax nnodes) (+ ni 1))
              (coco_dnode_hput ax ni)
              (return ni)))))

  ;;; THE LEVEL LOOP -- see the declaration and the section's head. R is
  ;;; what to probe where nothing deeper can be had: the level above's table
  ;;; at the node's argument, with the node's functor -- its members.
  (func coco_deep_select ((coco_store * st) (coco_machine * m) (coco_pred * p)
                          (u32 apos) (u64 fkey) (size_t t)) (out coco_ixsel)
        (let ((coco_ixsel r) (u32 par . #'(coco_dnode_none)) (u32 ni . 0) (coco_dnode * d . nil))
          (set ($ r pos) apos)
          (set ($ r key) fkey)
          (while 1
            (set ni (coco_dnode_get st m p par apos fkey))
            (if (== ni (coco_dnode_none)) (return r))
            (set d (coco_dnode_ensure st m p ni))
            (if (or (== d nil) (== (-> d nmem) 0) (== (-> d arity) 0)) (return r))
            (let ((u32 na . #'(coco_dnode_ntabs d))
                  (u64 k0 . #'(coco_cell_key m (+ t 1)))
                  (int best . -1) (double bs . 0.0))
              ;; A LIST OF TEN CLAUSES OR FEWER WALKS ITS FIRST ARGUMENT, and
              ;; asks the others only where the first two candidates are
              ;; both of the call's key there (nextClauseArg1)
              (if (and (!= k0 0) (<= (-> d nmem) 10))
                  (let ((coco_argix * x . #'(coco_dtab_get st m p ni 0))
                        (size_t f . #'(coco_no_clause)) (size_t s . #'(coco_no_clause)))
                    (if (== x nil) (return r))
                    (for ((size_t i . 0)) (and (< i (-> d nmem)) (== s (coco_no_clause))) ((++ i))
                      (if (or (== (nth i (-> x keys)) 0) (== (nth i (-> x keys)) k0))
                          (if (== f (coco_no_clause)) (set f i) (set s i))))
                    (if (or (== s (coco_no_clause)) (!= (nth f (-> x keys)) k0)
                            (!= (nth s (-> x keys)) k0))
                        (block (set ($ r pos) (coco_deep_pos ni 0)) (set ($ r key) k0) (return r)))))
              ;; THE BOUND ARGUMENT THAT PROMISES THE MOST (bestHash), the
              ;; first on a tie
              (for ((u32 j . 0)) (< j na) ((++ j))
                (if (!= (coco_cell_key m (+ t (+ (cast size_t j) 1))) 0)
                    (let ((double s . #'(coco_dtab_speedup st m p ni j)))
                      (if (> s bs) (block (set bs s) (set best (cast int j)))))))
              (cond
                ((>= best 0)
                 (let ((u64 kb . #'(coco_cell_key m (+ t (+ (cast size_t best) 1)))))
                   (set ($ r pos) (coco_deep_pos ni (cast u32 best)))
                   (set ($ r key) kb)
                   ;; A LIST INDEX THERE, AND A FUNCTOR's KEY: one level
                   ;; deeper, seven at most
                   (if (not (and (coco-tag-is FUN kb) (< (-> d depth) 7)
                                 (coco_dtab_list st m p ni (cast u32 best) bs)))
                       (return r))
                   (set par ni)
                   (set apos (cast u32 best))
                   (set fkey kb)
                   (set t (coco_deref m (+ t (+ (cast size_t best) 1))))))
                ;; nothing indexable: the walk on the first argument, or
                ;; every member
                ((!= k0 0)
                 (set ($ r pos) (coco_deep_pos ni 0))
                 (set ($ r key) k0)
                 (return r))
                (#t (return r)))))
          (return r)))

  ;;; ROOM FOR MORE CLAUSES in every array parallel to P's clause list: 0
  ;;; when one would not grow, and nothing is added
  (static)
  (func coco_pred_room ((coco_store * st) (coco_pred * p) (size_t more)) (out int)
        (let ((size_t need . #'(+ (-> p nclauses) more)))
          (if (not (coco_store_grow_meta st (cast (void **) (aof (-> p origins)))
                                       (aof (-> p origin_cap)) need
                                       (sizeof u64)))
              (return 0))
          ;; and the dead's own list grows with the others while there is one
          (if (and (!= (-> p tomb) nil)
                   (not (coco_store_grow_meta st (cast (void **) (aof (-> p tomb)))
                                              (aof (-> p tomb_cap)) need
                                              (sizeof u32))))
              (return 0))
          (if (not (coco_store_grow_meta st (cast (void **) (aof (-> p clauses)))
                                       (aof (-> p clause_cap)) need
                                       (sizeof size_t)))
              (return 0))
          ;; the two parallel arrays grow with it, each with a cap of its own
          ;; -- three caps that always agree, rather than one the grower would
          ;; have to be taught to share
          (if (not (coco_store_grow_meta st (cast (void **) (aof (-> p keys)))
                                       (aof (-> p key_cap)) need
                                       (sizeof u64)))
              (return 0))
          (if (not (coco_store_grow_meta st (cast (void **) (aof (-> p chain)))
                                       (aof (-> p chain_cap)) need
                                       (sizeof size_t)))
              (return 0))
          (if (not (coco_store_grow_meta st (cast (void **) (aof (-> p muted)))
                                       (aof (-> p muted_cap)) need
                                       (sizeof int)))
              (return 0))
          (if (not (coco_store_grow_meta st (cast (void **) (aof (-> p codes)))
                                       (aof (-> p codes_cap)) need
                                       (sizeof size_t)))
              (return 0))
          (return 1)))

  (static)
  (func coco_pred_add_clause ((coco_store * st) (coco_machine * m) (size_t pi) (size_t clause)
                            (int at_end) (u64 key) (u64 origin) (int muted)) (out int)
        (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) pi))))
          ;; the dead gone first if no frame is open to want them: before an
          ;; asserta, which moves every clause anyway, and before an assertz
          ;; only once they are due (3.78.15, `coco-tomb-due'), the new
          ;; clause going after the dead. Through 3.78.14 any dead went
          ;; first, and an update -- a retract, then an assertz of the new
          ;; value -- cost the predicate's size at the assertz
          (if (and (!= (-> p ntomb) 0) (or (not at_end) (coco-tomb-due p)))
              (coco_tomb_try_sweep st m pi))
          ;; A PREDICATE WITH NO ROOM FOR ONE MORE CLAUSE FINISHES THE MACHINE
          ;; THAT ASKED (3.62.3, `coco_oom'): its arrays were refused even
          ;; the little that was needed. Through 3.62.2 the answer was 0 and
          ;; no more, and assertz/1 FAILED -- a goal that failed, in a
          ;; program that took its other branch (a task's `assertz' under two
          ;; requests in a row refused: test/async.pl, `refusals')
          (if (not (coco_pred_room st p 1)) (return (coco_oom m)))
          (if at_end
              (block (set (nth (-> p nclauses) (-> p clauses)) clause)
                     (set (nth (-> p nclauses) (-> p keys)) key)
                     (set (nth (-> p nclauses) (-> p origins)) origin)
                     (set (nth (-> p nclauses) (-> p muted)) muted)
                     (set (nth (-> p nclauses) (-> p codes)) nil)
                     (if (!= (-> p tomb) nil) (set (nth (-> p nclauses) (-> p tomb)) 0)))
            ;; asserta: shift the rest up by one and put this first. Every
            ;; clause after it is renumbered, and the chains hold POSITIONS,
            ;; so the index is dropped rather than patched.
            (block (let ((size_t i . #'(-> p nclauses)))
                     (while (> i 0)
                       (set (nth i (-> p clauses)) (nth (- i 1) (-> p clauses)))
                       (set (nth i (-> p keys)) (nth (- i 1) (-> p keys)))
                       (set (nth i (-> p origins)) (nth (- i 1) (-> p origins)))
                       (set (nth i (-> p muted)) (nth (- i 1) (-> p muted)))
                       (set (nth i (-> p codes)) (nth (- i 1) (-> p codes)))
                       (if (!= (-> p tomb) nil) (set (nth i (-> p tomb)) (nth (- i 1) (-> p tomb))))
                       (set i (- i 1))))
                   (set (nth 0 (-> p clauses)) clause)
                   (set (nth 0 (-> p keys)) key)
                   (set (nth 0 (-> p origins)) origin)
                   (set (nth 0 (-> p muted)) muted)
                   (set (nth 0 (-> p codes)) nil)
                   (if (!= (-> p tomb) nil) (set (nth 0 (-> p tomb)) 0))
                   ;; a first clause no file read: predicate_property/2's
                   ;; file(F) and line_count(L) are gone (3.41.0), as swipl's,
                   ;; which names the file of the first clause in its chain
                   (if (== origin 0) (block (set (-> p pfile) 0) (set (-> p pline) 0)))
                   (coco_pred_unindex p)))
          (set (-> p nclauses) (+ (-> p nclauses) 1))
          (coco_pred_nprobe p)
          (set (-> p tver) (+ (-> p tver) 1))
          ;; THE LOGICAL UPDATE VIEW: every frame open on the predicate is
          ;; moved on with the clauses it was going to try, and the one in
          ;; front is before where it stands -- a call open now never meets
          ;; it (`coco_frames_on')
          (if (not at_end) (coco_frames_on m st pi 2 0 0))
          ;; ASSERTZ KEEPS THE INDEX, and that is the case worth keeping: the
          ;; new clause is the highest position there is, so linking it onto
          ;; the tail of its chain leaves every chain ascending. Rebuilding
          ;; here instead would make a loop of asserts quadratic again, which
          ;; is the shape this whole change exists to remove.
          (if (and at_end (-> p indexed))
              (if (< (* (-> p nclauses) 2) (-> p nslots))
                  (coco_chain_add p key (- (-> p nclauses) 1))
                ;; the table would be over half full: let it be rebuilt, at a
                ;; bigger size, by whoever next wants it
                (set (-> p indexed) 0)))
          ;; AND EACH OTHER ARGUMENT'S TABLE THAT IS BUILT takes the clause
          ;; the same way, its key read from the head just stored -- a loop
          ;; of asserts and lookups by the second argument (a memo table)
          ;; would otherwise rebuild the table at every lookup
          (if (and at_end (!= (-> p aix) nil))
              (let ((u64 neck . #'(coco_intern m ":-"))
                    (size_t at . #'(- (-> p nclauses) 1)))
                ;; and the deep index's built nodes (3.64.0)
                (if (> (-> (-> p aix) nnodes) 0) (coco_deep_add st m p clause))
                (for ((u32 j . 0)) (< j (coco_aix_count)) ((++ j))
                  (let ((coco_argix * x . #'(aof (nth j (-> (-> p aix) args)))))
                    (if (-> x indexed)
                        (if (and (< (* (-> p nclauses) 2) (-> x nslots))
                                 (coco_store_grow_meta st (cast (void **) (aof (-> x keys))) (aof (-> x key_cap))
                                                       (-> p nclauses) (sizeof u64))
                                 (coco_store_grow_meta st (cast (void **) (aof (-> x chain))) (aof (-> x chain_cap))
                                                       (-> p nclauses) (sizeof size_t)))
                            (block
                             (set (nth at (-> x keys)) (coco_store_arg_key st m clause neck (+ j 1)))
                             (coco_aix_add x (nth at (-> x keys)) at))
                          (set (-> x indexed) 0)))))))
          (return 1)))

  ;;; CLAUSE PUT IN AT POSITION K OF PI, the clauses from K moved up one:
  ;;; the clause list, every array beside it, and every call open at or
  ;;; past K (`coco_frames_on' act 2) -- its caller has asked that no call
  ;;; open before K would see it (act 3). The positions moved, so every
  ;;; index goes, as an asserta's does.
  (static)
  (func coco_pred_insert_at ((coco_store * st) (coco_machine * m) (size_t pi) (size_t k)
                             (size_t clause) (u64 key) (u64 origin) (int muted)) (out int)
        (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) pi)))
              (size_t i . 0))
          (if (not (coco_pred_room st p 1)) (return (coco_oom m)))
          (set i (-> p nclauses))
          (while (> i k)
            (set (nth i (-> p clauses)) (nth (- i 1) (-> p clauses)))
            (set (nth i (-> p keys)) (nth (- i 1) (-> p keys)))
            (set (nth i (-> p origins)) (nth (- i 1) (-> p origins)))
            (set (nth i (-> p muted)) (nth (- i 1) (-> p muted)))
            (set (nth i (-> p codes)) (nth (- i 1) (-> p codes)))
            (if (!= (-> p tomb) nil) (set (nth i (-> p tomb)) (nth (- i 1) (-> p tomb))))
            (set i (- i 1)))
          (set (nth k (-> p clauses)) clause)
          (set (nth k (-> p keys)) key)
          (set (nth k (-> p origins)) origin)
          (set (nth k (-> p muted)) muted)
          (set (nth k (-> p codes)) nil)
          (if (!= (-> p tomb) nil) (set (nth k (-> p tomb)) 0))
          (set (-> p nclauses) (+ (-> p nclauses) 1))
          (coco_pred_nprobe p)
          (set (-> p tver) (+ (-> p tver) 1))
          (coco_pred_unindex p)
          (coco_frames_on m st pi 2 0 k)
          (return 1)))

  ;;; Whether PI holds a live clause ORIGIN put there, of the store's mute
  ;;; MUTE.
  (static)
  (func coco_pred_holds ((coco_store * st) (size_t pi) (u64 origin) (int mute)) (out int)
        (let ((coco_pred * p . #'(aof (coco-pred-at (-> st predp) pi))))
          (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
            (if (and (== (nth i (-> p origins)) origin) (== (nth i (-> p muted)) mute)
                     (not (coco_pred_dead p i)))
                (return 1)))
          (return 0)))

  ) ; impl-kb-pred

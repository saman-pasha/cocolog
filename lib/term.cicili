;;;; cocolog -- terms, and the machine that holds them
;;;
;;; WHY A FLAT HEAP AND NOT A POINTER GRAPH. cocolog exists to be saved and
;;; resumed: a machine is meant to stop mid-resolution, go into Zigurat, and
;;; come back somewhere else. A term made of malloc'd nodes cannot do that
;;; without a pointer-fixup pass over the whole graph, and a pointer-fixup pass
;;; is the sort of thing that works until the day the graph has a cycle in it.
;;;
;;; So a term is an INDEX into an array of 64-bit cells, and every reference
;;; inside a term is another index. The array is position independent by
;;; construction -- write it to a file, read it back at a different address,
;;; and every reference in it still means what it meant. That single decision
;;; is what makes `state.cicili' twenty lines of memcpy rather than a graph
;;; walker, and it is why the tag lives in the low bits of a word instead of in
;;; a struct with a pointer in it.
;;;
;;; THE CELL. Low 4 bits are the tag, the remaining 60 are the payload:
;;;
;;;   REF   payload is the cell this one points at; pointing at ITSELF is what
;;;         "unbound variable" means, so a fresh variable needs no separate
;;;         flag and dereferencing needs no null check.
;;;   ATOM  payload is an atom id -- an index into the machine's name table.
;;;   INT   payload IS the value, shifted; 60 bits signed, recovered with an
;;;         arithmetic shift so the sign comes back with it.
;;;   FUN   payload is a functor id -- an index into the functor table, which
;;;         holds {name atom, arity}. The arity is therefore not squeezed into
;;;         the cell and is not bounded by it.
;;;   FLT   payload indexes the float table, because a double does not fit in
;;;         60 bits and pretending otherwise would silently lose the mantissa.
;;;   BIG   payload indexes the integer table (2.0.0): an integer of 64 bits
;;;         that the 60 an INT keeps cannot hold. CANONICAL BY RANGE -- a value
;;;         that fits an INT is never boxed -- so two INTs are equal exactly
;;;         when their words are, and an INT never equals a BIG.
;;;   RAT   payload indexes the rational table (2.5.0): N/D in lowest terms,
;;;         D > 1. A denominator of 1 is the integer, never a RAT.
;;;
;;; A COMPOUND TERM IS ITS HEADER. If the cell at index t is a FUN, the term is
;;; a compound and its arguments are the cells at t+1 .. t+arity. There is no
;;; separate STR cell pointing at the header the way a WAM has: the header IS
;;; the term reference. That saves a cell and an indirection on every argument
;;; access, and the only thing it costs is that a compound cannot be moved
;;; without moving its arguments with it -- which a flat heap never does.
;;;
;;; THE TAG TABLE IS THE ONE DEFINITION. *cell-tags* below is read by the Lisp
;;; layer to emit the C enum, the constructors and the testers. Adding a tag is
;;; one line there, not five edits that have to agree; and because the macros
;;; know the numbers at expansion time, `(co.tag-is REF c)' expands to a
;;; comparison against a literal rather than a load of a named constant.
;;;
;;; THIS FILE IS THE FIRST OF TWO (2.16.1, when it had reached 3 852 lines):
;;; the tag table, the cell macros, the term DSL, every declaration, and the
;;; machine, its buffers, text, names and heap. term-walk.cicili is one
;;; translation unit with it, emitted right after it by cocolog.cicili and by
;;; every test binary: binding and the trail, the collector's host roots, the
;;; ground globals, unification, copying, cycles and the standard order.

;;; A library owns its namespace rather than borrowing the import prefix's --
;;; see doc/DOC-C.md, "A library's package". Options upper case, name lower,
;;; because a macro file is read with the case preserved.
(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;;; ------------------------------------------------------------------
;;;; The tag table, and the macros that read it
;;;; ------------------------------------------------------------------

;;; name, value, and what the payload means. The C enum, the `coco_mk_*'
;;; constructors and the `coco_is_*' testers are all generated from this.
(DEFPARAMETER *cell-tags*
  '((REF  0 "the cell this one points at; itself when unbound")
    (ATOM 1 "an atom id -- an index into the name table")
    (INT  2 "the value itself, shifted left by 4")
    (FUN  3 "a functor id -- an index into the functor table")
    (FLT  4 "an index into the float table")
    (STR  5 "an index into the string table -- SWI's string type")
    ;; never part of a term a program can reach: a cell of a clause's
    ;; environment that a continuation names (Stage 5, `coco_env_take')
    (POS  6 "a goal of an environment: the distance back to its header over bit 16, the goal's index under it")
    ;; an integer past the 60 bits an INT keeps (2.0.0), boxed as a float
    ;; is: never a value an INT could hold, so the two kinds never meet
    (BIG  7 "an index into the integer table -- a value past the 60 bits a cell holds")
    ;; a rational (2.5.0), N/D in lowest terms with D > 1: the ninth tag the
    ;; 3-bit layout had no room for
    (RAT  8 "an index into the rational table -- N/D, reduced, D > 1")))

(DEFUN tag-value (name)
  "The numeric tag NAME stands for, at macro-expansion time."
  (LET ((row (ASSOC name *cell-tags* :TEST #'STRING=)))
    (UNLESS row (ERROR "cocolog: unknown cell tag ~A" name))
    (SECOND row)))

(DEFUN tag-name (name)
  (INTERN (FORMAT NIL "COCO_~A" (STRING name))))

;;; The enum exists for the generated C to be readable and for a debugger to
;;; print something better than 3. Nothing in the macros below reads it -- they
;;; splice the number -- so it costs one enum and no indirection.
(DEFMACRO coco-emit-tag-enum ()
  `(enum coco_tag
     ,@(MAPCAR (LAMBDA (row) `(,(tag-name (FIRST row)) . ,(SECOND row)))
               *cell-tags*)))

;;;; ------------------------------------------------------------------
;;;; Cell accessors -- front-end macros, because each is used once
;;;; ------------------------------------------------------------------
;;; Per the library rule in lib/README.md: anything that touches its receiver
;;; more than once is a back-end function; a single-use accessor is a macro and
;;; compiles to inline syntax rather than a call. These all use their argument
;;; once, so they are macros -- and `tag-is' folds to a literal comparison.

;;; the tag of a cell
(DEFMACRO coco-tag (c) `(cast int (bitand ,c 15)))

;;; is this cell tagged NAME? NAME is a tag-table name, resolved here.
(DEFMACRO coco-tag-is (name c) `(== (cast int (bitand ,c 15)) ,(tag-value name)))

;;; the raw payload, unsigned
(DEFMACRO coco-payload (c) `(>> ,c 4))

;;; the payload of an INT cell, signed -- an arithmetic shift, so the sign of a
;;; negative integer survives the round trip. C leaves >> on a signed type
;;; implementation-defined for negatives in the standard and arithmetic in
;;; every compiler this targets; the cast makes which one is meant explicit.
(DEFMACRO coco-signed-payload (c) `(>> (cast i64 ,c) 4))

;;; build a cell of tag NAME with payload V
(DEFMACRO coco-cell (name v) `(bitor (<< (cast u64 ,v) 4) ,(tag-value name)))

;;; build an INT cell from a signed value
(DEFMACRO coco-int-cell (v) `(bitor (<< (cast u64 (cast i64 ,v)) 4) ,(tag-value 'INT)))

;;; `(coco-gvb-live m x)': whether the backtrackable global's entry X (a
;;; `coco_gvbox *') holds a box the heap still has (3.52.0, b_setval/2): its
;;; header '$gv'/2, its serial, and a value that is not the value cell
;;; itself -- the mark a box is made with, which the trail puts back where
;;; backtracking undoes the b_setval/2 that made it, whether the heap is
;;; wound back or kept (a freeze). A heap wound back past the box holds
;;; another term where it stood, or nothing, and no box of that serial.
(DEFMACRO coco-gvb-live (m x)
  `(and (>= (-> ,x box) 0) (< (+ (cast size_t (-> ,x box)) 2) (-> ,m heap_len))
        (== (nth (cast size_t (-> ,x box)) (-> ,m heap)) (coco-cell FUN (- (-> ,m gvb_fid) 1)))
        (== (nth (+ (cast size_t (-> ,x box)) 1) (-> ,m heap)) (coco-int-cell (-> ,x serial)))
        (!= (nth (+ (cast size_t (-> ,x box)) 2) (-> ,m heap))
            (coco-cell REF (+ (cast size_t (-> ,x box)) 2)))))

;;; DOES V FIT THE 60 BITS AN INT CELL KEEPS (2.0.0)? Shifted up and back
;;; down arithmetically, a value that fits comes back itself. V is read
;;; twice: a variable, never a call.
(DEFMACRO coco-fits-cell (v) `(== (>> (cast i64 (<< (cast u64 ,v) 4)) 4) (cast i64 ,v)))

;;; an integer of either kind: in the cell (INT) or boxed (BIG)
(DEFMACRO coco-is-int (c) `(or (coco-tag-is INT ,c) (coco-tag-is BIG ,c)))

;;; A RATIONAL HAS ITS OWN TAG (2.5.0). Four tag bits make room for the
;;; ninth; the payload names an entry of `m->rats', a reduced N/D with
;;; D > 1. It is a number in the index keys' eyes, so both a RAT and a BIG
;;; key as 0 (`coco_arg_key', `coco_cell_key', `coco_store_arg_key').
(DEFMACRO coco-rat-p (c) `(coco-tag-is RAT ,c))
(DEFMACRO coco-big-p (c) `(coco-tag-is BIG ,c))
(DEFMACRO coco-rat-index (c) `(coco-payload ,c))
;;; build a rational cell from a table index
(DEFMACRO coco-rat-cell (v) `(coco-cell RAT ,v))

;;; THE TRAIL'S PAIR BIT (1.12.0): a trail word with it set is one of the
;;; two words of a VALUE entry, `setarg/3''s -- the cell holding the old
;;; value, then the cell it is restored into -- and not a variable to
;;; unbind. Both words carry it, so a walk from either end knows a pair
;;; when it meets one; no cell index reaches 2^63.
(DEFMACRO coco-trail-pair () `(<< (cast u64 1) 63))

;;; THE CELL A PAIR'S WORD NAMES lies under bit 40 (1.12.1), and bits 40
;;; to 62 of both words are 0 in a value entry. In a ground global's
;;; SENTINEL they are not: the first word carries the global's index plus
;;; one, the second the copy's serial, and both name cell 0 -- so the undo,
;;; which puts the second word's cell back from the first's, writes cell 0
;;; with itself and needs no case of its own. The sentinel was put on the
;;; trail by the copy a machine keeps of a ground global
;;; (`coco_b_global_term'), and the copy stands while the sentinel does
;;; (`coco_gcache_ok'): backtracking past it took the copy's cells.
(DEFMACRO coco-trail-cell (w) `(bitand ,w (- (<< (cast u64 1) 40) 1)))
(DEFMACRO coco-trail-tag (w) `(bitand (>> ,w 40) (- (<< (cast u64 1) 23) 1)))

;;; THE STACK LIMIT AT A GROWTH (3.32.0): what an array of the stacks grows
;;; to under the machine's `slimit' (swipl's stack_limit flag). NCAP is the
;;; doubling and ROOM the entries the limit leaves the array. A doubling
;;; within ROOM and a sixteenth is taken; one past it stops at that while
;;; NEED is within ROOM, so a doubling past the limit is never made (a heap
;;; of 1 GB would take 2), and the growth after it comes as the array
;;; reaches the limit and asks again; NEED past ROOM is grown by a
;;; sixteenth, as a refused doubling is, and OVER is set: the running
;;; engine stops at its next step, halted 3, where the step collects where
;;; its engine may and asks what the stacks hold (`coco_halted_step'). The
;;; stop is made once the growth is given: a growth refused is memory's, as
;;; it always was (`coco_grow_short'). One rule for the heap and the trail
;;; (`coco_stack_cap', ROOM the limit's cells) and the choice stack
;;; (`coco_eng_grow_slow', ROOM the frames the limit leaves beside the heap,
;;; the trail and the other engines'). NCAP and OVER are assigned; ROOM and
;;; NEED are read more than once: variables, never calls.
(DEFMACRO coco-room-cap (room need ncap over)
  `(if (> ,ncap (+ ,room (+ (/ ,room 16) 64)))
       (if (<= ,need ,room)
           (set ,ncap (+ ,room (+ (/ ,room 16) 64)))
           (block
             (set ,over 1)
             (set ,ncap (+ ,need (+ (/ ,need 16) 64)))))))

;;;; ------------------------------------------------------------------
;;;; The term DSL -- Prolog terms as s-expressions, built at compile time
;;;; ------------------------------------------------------------------
;;;
;;; THIS IS THE PART THAT NEEDED A LISP UNDER IT. Building `f(X, g(1))' by hand
;;; is four calls and two index fixups, and the fixups are the interesting bit:
;;; a compound's arguments have to occupy the cells immediately behind its
;;; header, but building an argument PUSHES, so an argument cannot be written
;;; where it will end up. Every hand-written term therefore repeats the same
;;; reserve-then-fill dance, and every copy of it is a chance to fill the wrong
;;; slot.
;;;
;;; So the dance is written once, here, and the term is written as what it is:
;;;
;;;     (coco-term m (append (splice xs) (cons 1 nil) ?Rest))
;;;
;;; expands to the opens, the reservations and the fixups, in order, with the
;;; shared variables lifted to the top so that two mentions of ?Rest are one
;;; variable. Nothing survives to run time -- there is no parser here and no
;;; table of node types; the structure of the term IS the structure of the
;;; emitted code, which is the whole reason for writing a compiler in a Lisp.
;;;
;;; THE GRAMMAR.
;;;   42            an integer
;;;   3.5           a float
;;;   foo   "foo"   an atom; the string form is for names a Lisp symbol cannot
;;;                 hold, like 'hello world' or '[]'
;;;   ?X            a variable. Every ?X in one term is the SAME variable; a
;;;                 different term gets a different one.
;;;   (splice e)    an escape: e is Cicili code answering a term index that
;;;                 already exists. This is how a term refers to something the
;;;                 surrounding C code is already holding. The name is spelt
;;;                 out because the obvious `:' cannot be read -- a lone colon
;;;                 is not a Lisp token.
;;;   (f a b ...)   a compound of arity (length args)
;;;
;;; M is evaluated more than once, so it must be a plain pointer expression --
;;; a variable or (aof x), not a call.

(DEFVAR *term-serial* 0)

(DEFUN next-local (stem)
  (INTERN (FORMAT NIL "__co~A~A" stem (INCF *term-serial*))))

(DEFUN term-var-p (x)
  (AND (SYMBOLP x)
       (> (LENGTH (SYMBOL-NAME x)) 1)
       (CHAR= (CHAR (SYMBOL-NAME x) 0) #\?)))

(DEFUN term-escape-p (x)
  (AND (CONSP x) (SYMBOLP (CAR x)) (STRING= (SYMBOL-NAME (CAR x)) "splice")))

(DEFUN term-vars (expr acc)
  "Every distinct ?variable in EXPR, in order of first appearance."
  (COND ((term-var-p expr) (IF (MEMBER expr acc :TEST #'EQ) acc (APPEND acc (LIST expr))))
        ((term-escape-p expr) acc)
        ((CONSP expr) (DOLIST (e (CDR expr) acc) (SETF acc (term-vars e acc))))
        (T acc)))

(DEFUN atom-name-of (x)
  (COND ((STRINGP x) x)
        ((SYMBOLP x) (SYMBOL-NAME x))
        (T (ERROR "cocolog: ~S cannot name an atom" x))))

;;; Answers three values: the form that names the built term, the locals it
;;; needs declared, and the statements that build it -- in that order because
;;; the caller assembles one `letn' out of all three.
(DEFUN emit-term (m expr vars locals stmts)
  (COND
    ((term-var-p expr)
     (VALUES (CDR (ASSOC expr vars :TEST #'EQ)) locals stmts))

    ((term-escape-p expr)
     (VALUES (SECOND expr) locals stmts))

    ((INTEGERP expr)
     (LET ((s (next-local "i")))
       (VALUES s (APPEND locals (LIST `(size_t ,s)))
               (APPEND stmts (LIST `(set ,s (coco_new_int ,m ,expr)))))))

    ((FLOATP expr)
     (LET ((s (next-local "f")))
       (VALUES s (APPEND locals (LIST `(size_t ,s)))
               (APPEND stmts (LIST `(set ,s (coco_new_float ,m ,expr)))))))

    ((OR (STRINGP expr) (SYMBOLP expr))
     (LET ((s (next-local "a")))
       (VALUES s (APPEND locals (LIST `(size_t ,s)))
               (APPEND stmts (LIST `(set ,s (coco_new_atom ,m ,(atom-name-of expr))))))))

    ((CONSP expr)
     (LET* ((n (LENGTH (CDR expr)))
            (h (next-local "h"))
            (b (next-local "b")))
       (SETF locals (APPEND locals (LIST `(size_t ,h) `(size_t ,b))))
       ;; the header, then one placeholder variable per argument. The
       ;; placeholders are real unbound variables, so a term whose construction
       ;; is somehow abandoned half way is still a well-formed term.
       (SETF stmts (APPEND stmts
                           (LIST `(set ,h (coco_open_struct ,m ,(atom-name-of (CAR expr)) ,n))
                                 `(set ,b (+ ,h 1)))
                           (LOOP REPEAT n COLLECT `(coco_new_var ,m))))
       ;; then each argument, wherever it lands, pointed at from its slot
       (LOOP FOR arg IN (CDR expr)
             FOR i FROM 0
             DO (MULTIPLE-VALUE-BIND (sym l s) (emit-term m arg vars locals stmts)
                  (SETF locals l
                        stmts (APPEND s (LIST `(coco_set_arg ,m (+ ,b ,i) ,sym))))))
       (VALUES h locals stmts)))

    (T (ERROR "cocolog: ~S is not a term" expr))))

(DEFMACRO coco-term (m expr)
  (LET* ((vs (term-vars expr NIL))
         (vars (MAPCAR (LAMBDA (v) (CONS v (next-local "v"))) vs))
         (var-locals (MAPCAR (LAMBDA (pair) `(size_t ,(CDR pair) . #'(coco_new_var ,m))) vars)))
    (MULTIPLE-VALUE-BIND (root locals stmts) (emit-term m expr vars NIL NIL)
      `(letn (,@var-locals ,@locals) ,@stmts ,root))))

;;;; ------------------------------------------------------------------
;;;; Every code point's classes and other case (3.30.0)
;;;; ------------------------------------------------------------------
;;;
;;; lib/swipl-ctype.cicili holds what the reference swipl 9.0.4 answers on
;;; Linux for each code point from 0 to U+10FFFF, as runs (LO HI A B): the
;;; codes LO to HI hold A, B, A ... from LO, any other 0. These make them
;;; two-level tables as cocolog is built -- a page number a block of codes,
;;; each page held once -- so a code's classes are three reads, and the
;;; source keeps 46 KB of runs where the tables are 100 KB. `coco_ct_flags'
;;; answers its eleven class bits and a digit's weight, `coco_uc_case' its
;;; other case (towupper() and towlower() under C.UTF-8). A build that
;;; imports no table (lib/swipl-ctype.cicili ahead of this file) has no
;;; code in a class and every code in its own case. Through 3.29.0 the
;;; classes past ASCII were the scripts written out here by hand.

(DEFUN coco-ct-runs (name)
  (IF (BOUNDP name) (SYMBOL-VALUE name) NIL))

;;; every code's value from runs
(DEFUN coco-ct-vector (runs)
  (LET ((v (MAKE-ARRAY #x110000 :INITIAL-ELEMENT 0)))
    (DOLIST (r runs v)
      (DESTRUCTURING-BIND (lo hi a b) r
        (LOOP FOR k FROM lo TO hi
              DO (SETF (AREF v k) (IF (EVENP (- k lo)) a b)))))))

;;; V cut into pages of 2^SHIFT codes, each page held once: (INDEX VALUES
;;; COUNT), INDEX a page's number for each block of codes
(DEFUN coco-ct-pages (v shift)
  (LET ((size (ASH 1 shift)) (seen (MAKE-HASH-TABLE :TEST 'EQUAL))
        (index NIL) (vals NIL) (n 0))
    (LOOP FOR p FROM 0 BELOW (FLOOR (LENGTH v) size)
          DO (LET* ((page (COERCE (SUBSEQ v (* p size) (* (1+ p) size)) 'LIST))
                    (key (FORMAT NIL "~{~D ~}" page))
                    (k (GETHASH key seen)))
               (UNLESS k
                 (SETF k n)
                 (SETF (GETHASH key seen) n)
                 (INCF n)
                 (PUSH page vals))
               (PUSH k index)))
    (LIST (NREVERSE index) (LOOP FOR pg IN (NREVERSE vals) APPEND pg) n)))

;;; the type a page number is held in
(DEFUN coco-ct-index-type (n) (IF (<= n 256) 'u8 'u16))

;;; A CODE'S CLASSES, eleven bits -- alpha 1, upper 2, lower 4, print 8,
;;; space 16, cntrl 32, prolog_var_start 64, prolog_atom_start 128,
;;; prolog_identifier_continue 256, prolog_symbol 512, decimal 1024 -- and a
;;; digit's weight in bits 11 to 14; 0 for a code past U+10FFFF or below 0
(DEFMACRO coco-ct-emit-flags (fname)
  (LET ((v (coco-ct-vector (coco-ct-runs '*swipl-ctype-flags*))))
    (DOLIST (r (coco-ct-runs '*swipl-ctype-decimal*))
      (DESTRUCTURING-BIND (lo hi d) r
        (LOOP FOR k FROM lo TO hi
              DO (SETF (AREF v k) (LOGIOR (AREF v k) (ASH (+ k d) 11))))))
    (DESTRUCTURING-BIND (index vals n) (coco-ct-pages v 7)
      `(func ,fname ((i64 c)) (out u32)
             (let ((static) (const ,(coco-ct-index-type n) ix [] . '{ ,@index })
                   (static) (const u16 pg [] . '{ ,@vals }))
               (if (or (< c 0) (> c 1114111)) (return 0))
               (return (nth (+ (* (cast size_t (nth (>> c 7) ix)) 128) (cast size_t (bitand c 127)))
                            pg)))))))

;;; A CODE'S CLASSES TO THE READER AND THE WRITER (3.35.0): swipl's
;;; '$code_class'/2 -- layout 1, graphic 2, id_start 4, id_continue 8,
;;; upper 16 -- decimal 32, the reader's invalid 64 and 128 a character a
;;; quoted write escapes, from lib/swipl-ctype.cicili's fifth table; a code
;;; past U+10FFFF or below 0 is invalid and escaped. A code with none of
;;; 1, 2, 4, 32 and 64 reads as an atom of one character (pl-read.c's
;;; case_solo).
(DEFMACRO coco-ct-emit-read (fname)
  (LET ((v (coco-ct-vector (coco-ct-runs '*swipl-read-flags*))))
    (DESTRUCTURING-BIND (index vals n) (coco-ct-pages v 7)
      `(func ,fname ((i64 c)) (out u32)
             (let ((static) (const ,(coco-ct-index-type n) ix [] . '{ ,@index })
                   (static) (const u8 pg [] . '{ ,@vals }))
               (if (or (< c 0) (> c 1114111)) (return 192))
               (return (nth (+ (* (cast size_t (nth (>> c 7) ix)) 128) (cast size_t (bitand c 127)))
                            pg)))))))

;;; C's capital (UP 1) or small letter: C and one of the differences
;;; towupper() and towlower() make, a palette of them both share; C itself
;;; for a code past U+10FFFF or below 0
(DEFMACRO coco-ct-emit-case (fname)
  (LET* ((uruns (coco-ct-runs '*swipl-ctype-toupper*))
         (lruns (coco-ct-runs '*swipl-ctype-tolower*))
         (pal (LET ((s NIL))
                (DOLIST (r (APPEND uruns lruns)) (PUSHNEW (THIRD r) s) (PUSHNEW (FOURTH r) s))
                (CONS 0 (SORT (REMOVE 0 s) #'<))))
         (at (LET ((h (MAKE-HASH-TABLE)))
               (LOOP FOR d IN pal FOR i FROM 0 DO (SETF (GETHASH d h) i))
               h))
         (u (MAP 'VECTOR (LAMBDA (d) (GETHASH d at)) (coco-ct-vector uruns)))
         (l (MAP 'VECTOR (LAMBDA (d) (GETHASH d at)) (coco-ct-vector lruns))))
    (WHEN (> (LENGTH pal) 256) (ERROR "cocolog: ~D case differences, past a byte" (LENGTH pal)))
    (DESTRUCTURING-BIND (uindex uvals un) (coco-ct-pages u 8)
      (DESTRUCTURING-BIND (lindex lvals ln) (coco-ct-pages l 8)
        `(func ,fname ((i64 c) (int up)) (out i64)
               (let ((static) (const ,(coco-ct-index-type un) uix [] . '{ ,@uindex })
                     (static) (const u8 upg [] . '{ ,@uvals })
                     (static) (const ,(coco-ct-index-type ln) lix [] . '{ ,@lindex })
                     (static) (const u8 lpg [] . '{ ,@lvals })
                     (static) (const i32 pal [] . '{ ,@pal }))
                 (if (or (< c 0) (> c 1114111)) (return c))
                 (if up
                     (return (+ c (nth (nth (+ (* (cast size_t (nth (>> c 8) uix)) 256)
                                               (cast size_t (bitand c 255)))
                                            upg)
                                       pal))))
                 (return (+ c (nth (nth (+ (* (cast size_t (nth (>> c 8) lix)) 256)
                                           (cast size_t (bitand c 255)))
                                        lpg)
                                   pal)))))))))

;;; SWIPL'S ENCODING NAMES (3.58.0), 9.0.4's pl-file.c table with its MIME
;;; names: each the class its bytes are read in, as library(stream)'s
;;; `st_cls' classes them -- 0 UTF-8, 1 a byte a character, 2 UTF-16
;;; big-endian, 3 UTF-16 little-endian, 4 UCS-4 in the machine's order --
;;; and 5 `bom', which `:- encoding(E)' and load_files/2's encoding(E)
;;; take. `text' is the locale's in swipl and UTF-8 here (COMPAT.md). A
;;; strcmp a row (`coco_enc_class'): a load asks it once.
(DEFPARAMETER *coco-encodings*
  '(("utf8" 0) ("text" 0) ("UTF-8" 0) ("iso_latin_1" 1) ("octet" 1) ("ascii" 1)
    ("ISO-8859-1" 1) ("utf16be" 2) ("unicode_be" 2) ("UTF-16BE" 2) ("utf16le" 3)
    ("unicode_le" 3) ("UTF-16LE" 3) ("wchar_t" 4) ("bom" 5)))

(DEFMACRO coco-enc-class-body (nm)
  `(block
     ,@(MAPCAR (LAMBDA (row) `(if (== 0 (strcmp ,nm ,(FIRST row))) (return ,(SECOND row))))
               *coco-encodings*)
     (return -1)))

;;; ONE UTF-16 UNIT of U at I, in class CLS's order (2 big-endian, 3 little)
(DEFMACRO coco-u16-at (u i cls)
  `(? (== ,cls 2)
      (bitor (<< (cast i64 (nth ,i ,u)) 8) (cast i64 (nth (+ ,i 1) ,u)))
      (bitor (cast i64 (nth ,i ,u)) (<< (cast i64 (nth (+ ,i 1) ,u)) 8))))

;;; ONE UTF-16 UNIT W onto OUT in class CLS's order, 0 for no room
(DEFMACRO coco-u16-put (out w cls)
  `(? (== ,cls 2)
      (and (coco_sb_putc ,out (cast char (bitand (>> ,w 8) 255)))
           (coco_sb_putc ,out (cast char (bitand ,w 255))))
      (and (coco_sb_putc ,out (cast char (bitand ,w 255)))
           (coco_sb_putc ,out (cast char (bitand (>> ,w 8) 255))))))

;;;; ------------------------------------------------------------------
;;;; Declarations
;;;; ------------------------------------------------------------------

(generic decl-term
  ()

  (coco-emit-tag-enum)

  ;;; A name in the atom table. `hash' is kept beside the name so a lookup
  ;;; compares a word before it compares a string.
  (struct coco_atom
    (member char *   name)
    (member size_t   len)
    (member u64      hash))

  ;;; A STRING IS BYTES AND A LENGTH, NOT A C STRING, and that is the whole
  ;;; reason it is a type rather than an atom. An atom here is a NUL-terminated
  ;;; name in the atom table, so an atom carrying a NUL stops at it; a string
  ;;; carries its own length and a NUL is a byte like any other. That is also
  ;;; SWI's distinction, arrived at from the same place.
  ;;;
  ;;; NOT INTERNED, unlike an atom. Two equal strings are two entries, which is
  ;;; SWI's behaviour (a string is not a name) and is also what makes the table
  ;;; an array with no hash. `==' and unification compare the BYTES, so
  ;;; nothing observable depends on the sharing.
  ;;;
  ;;; THE TABLE IS RECLAIMED BY THE HEAP COLLECTOR (1.9.6), as the float
  ;;; table is: coco_backtrack winds `heap_len' back and leaves both alone, so
  ;;; through 1.9.5 a failure-driven loop that built strings grew this table
  ;;; until the machine was freed. A collection now marks every entry a cell
  ;;; still names -- the heap, every store on the machine, every compiled
  ;;; clause's constants -- frees the rest and keeps their indices for
  ;;; `coco_new_string' to reuse (`coco_tables_reclaim', lib/solve-gc.cicili).
  ;;; An entry's index never moves while a cell names it.
  (struct coco_str
    (member char *   p)
    (member size_t   n))

  ;;; A RATIONAL NUMBER (2.5.0): N/D, always reduced with D > 0, and never
  ;;; with D = 1 -- that is an integer. Both fit 64 bits, as every other
  ;;; integer here does; a numerator or denominator past them raises
  ;;; `evaluation_error(int_overflow)' where SWI would go on in a bignum.
  ;;; The table is reclaimed with the floats and strings.
  (struct coco_rat
    (member i64      n)
    (member i64      d))

  ;;; {name, arity}. Interned, so two compounds with the same functor share an
  ;;; id and comparing functors is comparing integers.
  (struct coco_functor
    (member u64      name)
    (member u32      arity)
    ;; WHERE A GOAL OF THIS FUNCTOR RESOLVED, remembered: the module that
    ;; owns the name, -2 for none (the knowledge base's), -1 for not asked
    ;; yet, stamped with the registry's generation so a module registered
    ;; later is asked again -- see `coco_extern_generation' in solve.cicili.
    ;; Not frozen with the machine: a thawed functor is asked afresh.
    (member i32      dmod)
    (member u32      dgen)
    ;; THE CORE BUILTIN A GOAL OF THIS FUNCTOR IS, remembered: 0 not asked,
    ;; 1 none, K+2 the K-th row of `*builtins*' (solve.cicili). The table
    ;; never changes, so there is no generation; a thawed functor starts at
    ;; 0 and is asked once.
    (member u32      bix)
    ;; THE PREDICATE A GOAL OF THIS FUNCTOR IS IN A STORE, remembered: the
    ;; store (its address and its serial, so a store reset or freed and
    ;; made again at the same address is not mistaken for the one that
    ;; answered) and the predicate's index in it. Predicates are only ever
    ;; appended to a store, so an index stays true as long as the store
    ;; does.
    (member void *   pst)
    (member u64      pserial)
    (member size_t   pidx)
    ;; A PLAIN PREDICATE, AND KNOWN TO BE ONE: no construct's name, no core
    ;; builtin, and no module claiming it as of the registry's generation
    ;; `fgen' -- stamped by the step's slow path once all three answers
    ;; above agree (solve.cicili, the dispatch in `coco_engine_run'). A
    ;; goal whose functor carries the current generation, in the store
    ;; `pst' names, goes straight to `pidx'; a module registered later
    ;; raises the generation and the next call asks everything again.
    ;; 0 is never a generation, so a fresh or thawed functor is unknown.
    (member u32      fgen)
    ;; THE ROW OF `*error-contexts*' A RAISE BY A GOAL OF THIS FUNCTOR NAMES
    ;; (3.0.0, `coco_err_ctx' in solve.cicili): 0 not asked, 1 none, K+2
    ;; row K. The table never changes; a thawed functor asks again.
    (member u32      ectx))

  ;;; A ROOT ARRAY A HOST OWNS, registered with the machine for as long as it
  ;;; holds heap cell indices across a run of the engine: where the array
  ;;; pointer lives, because its owner may grow it, and where its length
  ;;; lives. The heap collector rewrites every entry in place. The store's
  ;;; `coco_rootset' (lib/kb.cicili) is the same thing for the store's cells.
  ;;; `pos' says the entries are POSITIONS rather than cells (1.9.6): a heap
  ;;; length the host winds the machine back to, as a consult does after
  ;;; each directive -- kept true as cells move and marking nothing, as the
  ;;; marks a nested engine's builtin winds back to are.
  (struct coco_hroot
    (member size_t ** cells)
    (member size_t *  len)
    (member int       pos))

  ;;; A GROUND GLOBAL'S VALUE ON THIS MACHINE'S HEAP (1.12.1): the version
  ;;; of the global it was copied from (0: none), the term's cell, the
  ;;; copy's serial and where its sentinel stands on the trail (all ones:
  ;;; nothing can take the copy away), the cells the copy took, and whether
  ;;; it is pinned -- kept whatever backtracking does, because nb_setarg/3
  ;;; wrote into it. See `coco_b_global_term' in lib/builtins-db.cicili.
  (struct coco_gcache
    (member u64    ver)
    (member size_t root)
    (member u64    serial)
    (member size_t tpos)
    (member size_t lo)
    (member size_t hi)
    (member int    pinned))

  ;;; A BACKTRACKABLE GLOBAL (3.52.0, b_setval/2's, swipl's pl-gvar.c): the
  ;;; key's name, the box on this machine's heap that holds its value --
  ;;; `'$gv'(Serial, Value)', at BOX, -1 none -- the box's SERIAL, the
  ;;; machine's clock when b_setval/2 made it, and WCLOCK, the clock at its
  ;;; last write. The box is the key's while the heap holds it: its header,
  ;;; its serial and a value that is not its own cell (`coco-gvb-live').
  ;;; See `coco_b_bsetval' in lib/builtins-db.cicili.
  (struct coco_gvbox
    (member u64    name)
    (member i64    box)
    (member u64    serial)
    (member u64    wclock))

  ;;; A SIGNAL'S HANDLER WRITES THE ENGINE'S `halted' CELL, and nothing
  ;;; else (2.6.0): C allows an asynchronous handler to assign only a
  ;;; `volatile sig_atomic_t', which is what every `halted' now is. The
  ;;; alias is one Cicili type token, so a member can name it.
  (@define (code "coco_sig_halt volatile sig_atomic_t"))

  ;;; The machine. Everything in it is either a plain array of words or a
  ;;; length -- which is the whole point, and what `state.cicili' relies on.
  (struct coco_machine
    ;; the term store
    (member u64 *      heap)
    (member size_t     heap_len)
    (member size_t     heap_cap)

    ;; every binding made since the last choice point, so it can be undone
    (member u64 *      trail)
    (member size_t     trail_len)
    (member size_t     trail_cap)

    ;; interned names
    (member coco_atom *  atoms)
    (member size_t     atoms_len)
    (member size_t     atoms_cap)
    (member size_t *   atom_buckets)      ; open addressing, id+1, 0 is empty
    (member size_t     atom_bucket_cap)

    ;; interned functors, and the table that finds one by name and arity --
    ;; the atom table's shape, see `coco_functor_id'
    (member coco_functor * functors)
    (member size_t     functors_len)
    (member size_t     functors_cap)
    (member size_t *   functor_buckets)   ; open addressing, id+1, 0 is empty
    (member size_t     functor_bucket_cap)

    ;; doubles, which do not fit in a cell
    (member double *   floats)
    (member size_t     floats_len)
    (member size_t     floats_cap)

    ;; INTEGERS PAST THE 60 BITS A CELL KEEPS (2.0.0), boxed as the
    ;; doubles above are: a BIG cell names an entry, made by
    ;; `coco_new_int' for a value no INT holds, and reclaimed with the
    ;; floats (`coco_tables_reclaim')
    (member i64 *      bigs)
    (member size_t     bigs_len)
    (member size_t     bigs_cap)

    ;; RATIONAL NUMBERS (2.5.0), boxed as the integers above are: a RAT cell
    ;; names an entry, made by `coco_new_rat', and reclaimed with the floats.
    (member coco_rat * rats)
    (member size_t     rats_len)
    (member size_t     rats_cap)

    ;; HOW THE READER TURNS `"..."' INTO A TERM: 0 codes, 1 chars, 2 atom,
    ;; 3 string -- SWI's four `double_quotes' values. It lives on the MACHINE
    ;; rather than on the reader because `:- set_prolog_flag(double_quotes,
    ;; string)' must outlive the term it appears in and govern the rest of
    ;; the consult, which is what SWI does with it too.
    (member int        double_quotes)

    ;; WHAT A TEXT BUILTIN COUNTS IN (1.13.0, the `text_units' flag): 1
    ;; CHARACTERS, the text decoded as UTF-8 -- SWI's, and every machine's
    ;; default since 2.0.0 -- or 0 BYTES, the default through 1.x and all
    ;; cocolog did before 1.13.0. Taken from the process's default when the
    ;; machine is made (`coco_text_default': COCOLOG_TEXT_UNITS, or the last
    ;; `:- set_prolog_flag(text_units, V)'), and kept by a frozen machine.
    (member int        text_chars)

    ;; WHAT A FLOAT THAT IS NO NUMBER BECOMES (2.2.2, swipl's four flags),
    ;; a bit each, 0 for swipl's defaults: 1 float_overflow infinity, 2
    ;; float_zero_div infinity, 4 float_undefined nan, 8 float_underflow
    ;; error. Taken from the process's default when the machine is made
    ;; (`coco_fflags_default': the last set_prolog_flag/2 of one of them),
    ;; and kept by a frozen machine.
    (member int        fflags)

    ;; the string table -- see coco_str above
    (member coco_str * strings)
    (member size_t     strings_len)
    (member size_t     strings_cap)

    ;; THE ENGINE'S OWN VOCABULARY, INTERNED ONCE. Filled by `coco_ids_fill'
    ;; in solve.cicili the first time a query runs on this machine, and read
    ;; by the dispatcher instead of comparing a goal's name as a STRING --
    ;; which was 22.7 strcmps per inference and a quarter of the
    ;; interpreter's instructions on a tight recursion.
    ;;
    ;; ON THE MACHINE AND NOT THE ENGINE, because an atom id belongs to the
    ;; atom table: every engine over one machine shares it, a findall's
    ;; sub-engine included, and `coco_machine_init' memsets `ids_ready' back
    ;; to zero -- which is what makes a THAWED machine refill rather than
    ;; trust ids from an atom table that is no longer there.
    ;;
    ;; 256 is written out because a Cicili array size is one token and a
    ;; `#define' of your own is invisible to the language. The macro that
    ;; fills it checks the count at EXPANSION time, so a name added past the
    ;; end is a build error rather than a stray write. (192 through 3.19.5,
    ;; 191 of them used; 3.20.0's `$/1' and `@/2' and their two markers
    ;; passed it.)
    (member u64        ids [256])
    (member int        ids_ready)
    ;; THE ENGINE'S OWN FUNCTORS, INTERNED ONCE WITH THE ATOMS. `'$k'/3' is
    ;; built once per goal proven, and `coco_make' interned its name from a
    ;; C string every time -- strlen, hash and probe, then the functor
    ;; table's probe. Filled by `coco_ids_fill' beside `ids', so a thawed
    ;; machine refills both; the index of each is settled at expansion
    ;; time by `coco-fid' in solve.cicili.
    (member u64        fids [16])
    ;; THE LIST FUNCTOR `'.'/2', AS ITS ID PLUS ONE: 0 until a list cell is
    ;; first built or met (`coco_cons_fid', `coco_is_cons'). Every list cell
    ;; was built by name -- the atom and the functor probed again per cell --
    ;; and every walk along a list asked each cell's name with `strcmp'.
    ;; Lazily and not in `coco_machine_init', so the atom and functor tables
    ;; keep the order of first use they always had; `coco_machine_init'
    ;; memsets it, so a thawed machine finds it again.
    (member u64        cons1)
    ;; one byte per atom: 1 where the atom names a control construct, so the
    ;; engine's loop tells a construct from a predicate with one load. Sized
    ;; when `coco_ids_fill' runs; an atom past its end is not a construct.
    (member u8 *       cmask)
    (member size_t     cmask_len)

    ;; set when the machine runs out of memory, so callers may check once at
    ;; the end rather than after every push
    (member int        oom)

    ;; THE HEAP COLLECTOR'S BOOKKEEPING -- see `coco_heap_gc' in
    ;; lib/solve-gc.cicili. None of it is frozen with the machine: a thawed
    ;; machine starts from the defaults and collects when it next grows.
    ;;
    ;; RUNNING counts the engines inside `coco_engine_next' on this machine
    ;; right now. Through 1.9.3 a collection needed a count of one; since
    ;; 1.9.4 it finds the engines part way through a step on the chain
    ;; (`eng' below), and the count says only when NO engine runs -- when the
    ;; codes dead clauses retired are named by nothing (`coco_engine_ask').
    (member int        running)
    ;; the heap length that triggers the next collection, set by the first
    ;; run on this machine (`gc_floor') and by each collection. 0 is a
    ;; request: `garbage_collect/0' sets it, and the next step boundary of
    ;; an engine that may collect does (1.9.4; a flag of its own through
    ;; 1.9.3, one more load a step)
    (member size_t     gc_next)
    ;; collections so far, for `statistics/2'
    (member u64        gc_count)
    ;; the root arrays hosts hold, a stack -- see `coco_heap_root_push'
    (member coco_hroot * hroots)
    (member size_t     nhroots)
    (member size_t     hroot_cap)
    ;; THE GROUND GLOBALS THIS MACHINE HAS READ (1.12.1), by each one's index
    ;; in the table of the store whose serial is GCACHE_SS: a term copied
    ;; once and handed out shared, and a root of the collector.
    ;; `coco_gcache_drop' forgets them all. GFILLS is the last copy's
    ;; serial, and GSPAN_LO and GSPAN_HI hold every copy not pinned (an
    ;; empty span when LO is past HI), so nb_setarg/3 asks the table only
    ;; for a cell in it.
    (member coco_gcache * gcache)
    (member size_t     gcache_cap)
    (member u64        gcache_ss)
    (member u64        gfills)
    (member size_t     gspan_lo)
    (member size_t     gspan_hi)
    ;; THE WALK STACKS, KEPT. Copy, store-put and store-get each walk a term
    ;; on a stack of frames, unify and compare on a stack of pairs, and a
    ;; stack allocated per walk is a malloc and a free per CALL: queens took
    ;; 61 % longer for it (dd0895f, found by bisection). A walk borrows the
    ;; machine's -- so one nested inside it finds none and makes its own --
    ;; and gives it back when it ends. void *: the frame type comes later.
    (member void *     wframes)
    (member size_t     wframes_cap)
    (member size_t *   wpairs)
    (member size_t     wpairs_cap)
    ;; THE VARIABLE MAP, KEPT TOO: a copy maps each source variable to the
    ;; one it made (see `coco_varmap' below), and the map's two arrays used
    ;; to be grown and freed for every clause a call tried. A copy borrows
    ;; these -- `coco_varmap_take' -- and gives them back when it ends.
    (member u64 *      vmap_from)
    (member size_t *   vmap_to)
    (member size_t     vmap_cap)
    (member u64        vmap_epoch)
    ;; AND A COMPILED CLAUSE'S FRAME, past the 128 slots it finds on the C
    ;; stack: `coco_clause_run' (kb.cicili) borrows it -- `coco_cslots_take'
    ;; -- where it used to malloc and free one per call.
    (member size_t *   cslots)
    (member size_t     cslots_cap)
    ;; THE INNERMOST ENGINE RUNNING ON THIS MACHINE (1.9.4), each linked to
    ;; the one whose builtin started it (`outer' on the engine), so a
    ;; collection inside a nested engine finds every engine part way
    ;; through a step. Set and put back by `coco_engine_next'; a
    ;; `coco_engine *' this struct cannot name.
    (member void *     eng)
    ;; ITS `halted', for a growth that was refused and then given less
    ;; (`coco_grow_short') to stop the run with, which raises
    ;; resource_error(memory) at its next step (1.10.28). Set and put back
    ;; beside `eng'; nil when no engine runs. A signal handler writes the
    ;; same cell, through the address `coco_m_signal_cell' gives a module
    ;; (2.6.0), so it is `volatile sig_atomic_t'.
    (member coco_sig_halt *      haltp)
    ;; `coco_gc_floor', read by the first run on the machine (0 until then),
    ;; for a builtin that starts a nested engine to raise the threshold by
    ;; (`coco_gc_nested_begin')
    (member size_t     gc_floor)
    ;; A DIRECTIVE'S GOAL MAY COLLECT (1.9.6): a vouch, 1 meaning every C
    ;; frame between the call being made and the host has registered the
    ;; cells it reads afterwards. Set around ONE call: by a host that holds
    ;; none around its consult (`cocolog run', `cocolog consult'), by the
    ;; run's top around the modules' load and by `use_module' as a goal
    ;; around the library's, each when its engine may collect. Each frame on
    ;; the way (`coco_module_load', the consult, `coco_directive') reads it,
    ;; clears it, and sets it back only around a call whose cells it
    ;; registered; the goal hook (lib/library.cicili) is the last reader. A
    ;; directive's `use_module' runs no goal (no engine: the modules load
    ;; at the next run's top), so it is not vouched.
    (member int        dgc)
    ;; THE FLOAT AND STRING ENTRIES A COLLECTION FOUND DEAD (1.9.6), each a
    ;; stack of indices `coco_new_float' and `coco_new_string' take from
    ;; before they grow their table. Rebuilt whole by every reclamation
    ;; (`coco_tables_reclaim', lib/solve-gc.cicili), so nothing else writes
    ;; them.
    (member size_t *   ffree)
    (member size_t     nffree)
    (member size_t     ffree_cap)
    (member size_t *   sfree)
    (member size_t     nsfree)
    (member size_t     sfree_cap)
    ;; ...and the integer table's (2.0.0), `coco_new_big''s
    (member size_t *   bfree)
    (member size_t     nbfree)
    (member size_t     bfree_cap)
    ;; ...and the rational table's (2.5.0), `coco_new_rat''s
    (member size_t *   rfree)
    (member size_t     nrfree)
    (member size_t     rfree_cap)
    ;; entries made since the last reclamation. The reclamation runs only
    ;; once `tlimit' of them and half the heap's length were made, or
    ;; garbage_collect/0 asked -- its own cost is the words it looks at,
    ;; and a collection asked for it costs the heap -- and at `treq' a
    ;; collection is asked for (`gc_next' 0) if they reach that much
    (member size_t     tmade)
    (member size_t     tlimit)
    (member size_t     treq)
    ;; write_term/2's variable_names(Names), for the one write it is given
    ;; to: each named variable's cell and its name's atom id. The writer
    ;; asks here before it falls back to `_G' and the cell (1.10.6);
    ;; nothing else sets it, and it is empty again after the write
    (member size_t *   wcells)
    (member u64 *      wnames)
    (member size_t     nwnames)
    ;; THE RECORDER OF A WINDOW OF A RUN (1.10.12, library(flow/debug)):
    ;; `'$trace_window'/4' sets it for the one goal it proves, and every
    ;; engine on this machine that traces in record mode (`trace' 2) --
    ;; the window's own and the nested engines its builtins start -- writes
    ;; its events here. Null otherwise; a `coco_rec *' this struct cannot
    ;; name (lib/solve.cicili)
    (member void *     rec)
    ;; WHERE THE LAST BALL NOTHING WOULD CATCH WAS RAISED (1.10.17): the
    ;; lines `coco_throw' writes before it unwinds, each begun `ERROR: ',
    ;; for the host that reports the error to print after its message and
    ;; free (`coco_bt_say', lib/kb.cicili); nil when there are none.
    ;; BTKEEP is set by a builtin about to throw again, in its own engine,
    ;; a ball the engine it started raised -- the lines that throw wrote
    ;; are kept, and say more than this throw could
    (member char *     bt)
    (member int        btkeep)
    ;; THE WRITER'S CYCLE GUARD (1.10.18, lib/syntax.cicili): a compound the
    ;; writer meets WDEEP levels down asks whether its term is cyclic, and
    ;; one that is sets WCYC and WDEEP 0 -- every compound still to be
    ;; written then stops at once, and the top of the write takes back what
    ;; it wrote and writes the term in factors instead. 1024 between writes
    (member u32        wdeep)
    (member int        wcyc)
    ;; THE OTHER WALKS' CYCLE GUARD (1.10.19). WCEIL is the cell a copy or a
    ;; store's put may reach -- an index of the heap or of the store, set by
    ;; the walk's entry from the heap's length -- past which its term cannot
    ;; be a tree: the walk stops there, sets it 0, and its caller asks why.
    ;; CYC_PUTS counts the cyclic terms a store took as their factors,
    ;; `'$cyclic'(Template, [V1=T1, ...])': while it is 0 no reader looks
    ;; for one (`coco_store_read', lib/kb.cicili)
    (member size_t     wceil)
    (member size_t     cyc_puts)
    ;; `coco_compare''s countdown of the pairs of compounds it may meet
    ;; before it asks again with links, and the pair it asks of then
    ;; (1.10.19). Here and not locals: its loop has no register to spare,
    ;; and the budget in one put `m' on the stack -- reloaded every pair,
    ;; +8 instructions a pair of compounds
    (member size_t     cbudget)
    (member size_t     ca)
    (member size_t     cb)
    ;; `coco_unify''s countdown, which runs on from one unify to the next
    ;; and is armed again only when it reaches 0 -- no unify pays to arm
    ;; it. Reaching 0 in the middle of an ordinary unify costs that one its
    ;; links, which answer as the walk would; a cyclic one reaches it within
    ;; the heap's worth of pairs, or 2^20
    (member size_t     ubudget)
    ;; memberchk/2's countdown of the cells of its list, armed from the
    ;; heap's length (1.10.19): a list that is its own tail reaches 0. Here
    ;; for cbudget's reason -- a local cost the loop two spills a cell
    (member size_t     lbudget)

    ;; THE RATIONAL PAIR THE EVALUATOR LAST MADE (2.5.0). `coco_arith' hands
    ;; a rational back as `isf' 2 and these two cells rather than as two more
    ;; out-parameters: it recurses seven times for one `is', and three more
    ;; pointers cost every call its prologue. APPENDED, never inserted: the
    ;; machine is read on every step, and a field put in the middle moves
    ;; every offset after it. (Appending did not move the 4 % naive reverse
    ;; showed; it is prudence, not the cure.)
    (member i64        arith_n)
    (member i64        arith_d)

    ;; THE PSEUDO-RANDOM GENERATOR (2.5.0): xoshiro128**, seeded on its first
    ;; draw or by set_random/1. Deliberately not part of a frozen machine --
    ;; the state is not computation a thaw should go on with. Appended too.
    (member u32        rng [4])
    (member int        rng_ready)
    ;; THE GREEN WORLD'S SHARED TABLES (2.7.0): a green thread's machine
    ;; ALIASES the host machine's atom, functor, string, float, big and rat
    ;; tables rather than cloning them. TBASE is the root machine whose
    ;; tables these fields point to; TNEXT chains the root's aliases; the
    ;; root's TSHARED says the tables are shared, so the reclamation leaves
    ;; them alone; ST_NEXT chains the machines a store's frame walks visit
    ;; (the logical update view across green machines). Appended, as every
    ;; new machine field is.
    (member void *     tbase)
    (member void *     tnext)
    (member int        tshared)
    (member void *     st_next)
    ;; THE ENGINE A STOPPED GREEN MACHINE OWNS (2.7.0): `eng' is set only
    ;; while the engine runs (and its `outer' chain is live then); a
    ;; suspended thread's frames are found from this one, whose `outer' is
    ;; nil. Never `m->eng': pre-setting it made the engine its own outer.
    (member void *     keep_eng)
    ;; THE SHARED NAMES' GENERATION: a machine's table fields are copied from
    ;; the root when this differs from `coco_tbl_gen' -- at a run's start and
    ;; before an intern. While the tables are shared the growth never frees
    ;; the old array, so a copied pointer stays valid.
    (member size_t     tgen)
    ;; WHERE THE LOAD STANDS (2.16.0), for source_location/2 and so for
    ;; print_message/2's location line: the file and the line of the
    ;; directive whose goal is running, set by the load around the goal and
    ;; put back after it (a nested load has its own), nil outside one --
    ;; swipl's answers, which fail in an initialization/1 goal run after
    ;; the file and in the program. Appended.
    (member const char * sloc_file)
    (member int        sloc_line)
    ;; THE EMPTY LIST'S ATOM ID, PLUS ONE (3.0.0; 0 until it is first
    ;; asked, `coco_nil_id'): `[]' is told from `'[]'' by its id, never by
    ;; its name, which the two share. Appended.
    (member u64        nilid1)
    ;; WRITE_CANONICAL/1'S NAMES (3.1.0), for the one write that sets it:
    ;; a `coco_varmap *' from each variable of the term to 1 for `_' (met
    ;; once) or 2 + J for the J-th one met more than once (`A', `B', ...),
    ;; and `nwnames' 1 so the writer asks (`coco_write_canon'). Nil
    ;; otherwise. Appended.
    (member void *     wcanon)
    ;; A BALL THAT ENDS A LOAD (3.1.0): a directive's goal threw a term that
    ;; is no error(_, _), which swipl's '$execute_directive_3' does not
    ;; catch, so the load stops where it stands and the ball goes on to
    ;; whoever asked for it -- consult/1 raises it, a script's load is
    ;; `Prolog initialisation failed'. Its cell in the load's store plus
    ;; one (0 for none), and its size, put there by the goal hook and taken
    ;; by the first who can throw it (`coco_load_ball_take'). Appended.
    (member size_t     lball)
    (member size_t     lball_size)
    ;; WHAT A READ HAS DEFINED (3.6.0), a count: a clause
    ;; a consult adds, a dynamic, discontiguous, multifile or
    ;; meta_predicate declaration, a module/2, an initialization/1 goal put
    ;; off, an include, a load that finds its file. A READ OF A FILE COUNTS
    ;; ITS OWN, from 0, and puts the outer read's count back after: what a
    ;; file defined is swipl's source file, and a file whose reads defined
    ;; nothing is no loaded file, read again by the next load that names it
    ;; (lib/library.cicili, `coco_store_load_read', `coco_module_read_end').
    ;; A file a load finds is credited to the file that loads it at the
    ;; load, and a library read into the store on the way (the preloaded
    ;; modules, at a first directive's ask) to nobody; a host starts at 0
    (member u64        ldefs)
    ;; THE READS UNDER WAY (3.7.0), counted by `coco_consult_oid', and the
    ;; outermost one's goals put off (a `coco_initgoals *', lib/kb.cicili):
    ;; a nested read hands its initialization(G, main) up to that list, and
    ;; the outermost runs it after the whole load, as swipl's does
    (member int        lreads)
    (member void *     ltop)
    ;; WHERE A LOAD STANDS, beside `sloc_file' and `sloc_line' (3.14.0),
    ;; for prolog_load_context/2: the file the outermost read of this load
    ;; reads (an included file's includer), and the text being read with the
    ;; byte its term in hand starts at, set and put back where those are
    (member const char * sloc_src)
    (member const char * sloc_text)
    (member size_t     sloc_off)
    ;; THE SINGLE-SIDED PREDICATES A READ GAVE A CLAUSE (3.19.0, `Head =>
    ;; Body'), by index in the store, from the read's own base on (a nested
    ;; read pushes after it and takes its own back): the read's end puts a
    ;; last clause after each, `H :- '$ssu_none'(Mod, H)', which raises
    ;; swipl's existence_error(matching_rule, ...) when no head matched
    ;; (`coco_consult_ssu_close'). MOD is the read's module/2 name, its atom
    ;; id plus one, 0 for user. Appended.
    (member size_t *   ssu_pis)
    (member size_t     nssu)
    (member size_t     ssu_cap)
    (member u64        ssu_mod)
    ;; THE PRIORITY A WRITE STARTS AT (3.19.0, write_term/2's priority(P)), P
    ;; plus one, 0 for 1200: set around one write by `coco_wt_put' and read by
    ;; `coco_write_top' alone. Appended.
    (member int        wprec)
    ;; GENERATE_DEBUG_INFO FALSE FOR THE REST OF A READ (3.27.0), as swipl's
    ;; file-scoped flag: a predicate whose first clause the read adds hides
    ;; its children from the tracer (`pattrs' 32). Saved and put back around
    ;; each read (`coco_consult_oid'), 0 at a module's own. Appended.
    (member int        nodbg)
    ;; THE STACK LIMIT (3.32.0), swipl's `stack_limit' flag: how many bytes
    ;; the heap, the trail and the choice frames of the engines on the chain
    ;; may hold (`coco_stack_used'), 0 or less none -- a machine made by
    ;; `memset' alone has none. Taken from the process's default when the
    ;; machine is made (`coco_slimit_default': COCOLOG_STACK_LIMIT, or the
    ;; last set_prolog_flag/2 of it). A growth of the heap, the trail or a
    ;; choice stack past it stops the running engine at its next step
    ;; (halted 3, through `haltp'), which collects and asks again; so does a
    ;; collection that leaves more than it, with SOVER set, so the step asks
    ;; without collecting a second time (`coco_halted_step'). Appended.
    (member i64        slimit)
    (member int        sover)
    ;; THE DEPTH A WRITE IS CUT AT (3.49.0, write_term/2's max_depth(D),
    ;; swipl's pl-write.c): D, set around one write by `coco_wt_put' with
    ;; the write's mode 1024, and read only where that bit is on
    ;; (`coco_write_rec', `coco_write_list_cut'). Appended.
    (member i64        wmax)
    ;; THE TERM IN HAND AND ITS NAMES (3.51.0), for prolog_load_context/2's
    ;; `term' and `variable_names', swipl's '$term' and '$variable_names':
    ;; while a load asks a hook of a term, SLOC_TP points at the term as
    ;; read; while a hook or a directive's goal runs, SLOC_RD points at
    ;; the reader that read the term (a `coco_reader *', nil for
    ;; begin_of_file and end_of_file), whose names the bindings are made of
    ;; when a goal asks -- a hook collects nothing, and a directive's goal,
    ;; which may, holds the reader's variables as a root of the collector
    ;; (the term is `[]' there); nil elsewhere. Each points into the
    ;; consult's own frame and is set and put back where `sloc_file' is.
    ;; SLOC_RELOAD is 1 through a read of a file the store read before,
    ;; `coco_consult_oid''s AGAIN, swipl's `reloading'. Appended.
    (member size_t *   sloc_tp)
    (member int        sloc_reload)
    (member void *     sloc_rd)
    ;; THE BACKTRACKABLE GLOBALS (3.52.0, b_setval/2, swipl's): an entry a
    ;; key b_setval/2 ever named (GVB, GVB_LEN of GVB_CAP), never removed,
    ;; GVB_TERM the entry of '$term' plus one (expand_term/2's, which
    ;; prolog_load_context/2 reads); GVB_CLOCK counts b_setval/2's writes,
    ;; and GVB_HOOK0 is the clock where the innermost goal a load runs --
    ;; a hook or a directive's -- began: a box written before it is no
    ;; '$term' of that goal's (`coco_b_load_context'). GVB_FID is
    ;; '$gv'/2's functor id plus one, 0 until the first box. Appended.
    ;; LFLOOR is the heap where the term a load has in hand began, the
    ;; consult's mark before it read it: a cell under it is older than the
    ;; term, which an expansion hook's work on is undone as the hook returns
    ;; (`coco_consult_xcall'); and LHOOK is 1 for the one goal the next
    ;; `lb_goal_hook' runs when that goal is such a hook's. Appended.
    (member coco_gvbox * gvb)
    (member size_t     gvb_len)
    (member size_t     gvb_cap)
    (member size_t     gvb_term)
    (member u64        gvb_clock)
    (member u64        gvb_hook0)
    (member u64        gvb_fid)
    (member size_t     lfloor)
    (member int        lhook)
    ;; THE PORTRAY HOOK'S WRITE (3.54.0, swipl's callPortray(): print/1's
    ;; portray/1, write_term/2's portray(true) and portray_goal(G)): a write
    ;; in mode 8192 asks `coco_portray_hook' of each term it meets but a
    ;; variable. WPGOAL is portray_goal(G)'s G, 0 for portray/1, and WPOPTS
    ;; the write's options, of which call(G, T, Opts)'s Opts is made; WPFIRST
    ;; the buffer a portray goal's text began (no space goes before it, as
    ;; none goes before a write of swipl's); a goal that threw stops the
    ;; write (WPSTOP), WPCUT in WPCUTBUF where its text ends, and its ball is
    ;; kept (WPB_*, WPSTATE 1; 2 a goal that ended the run with none, 3 a
    ;; capture that could not be made) for the builtin to raise again once
    ;; it has put out what came before. Each is set around one write.
    ;; Appended.
    (member size_t     wpgoal)
    (member size_t     wpopts)
    (member void *     wpfirst)
    (member int        wpstop)
    (member void *     wpcutbuf)
    (member size_t     wpcut)
    (member int        wpstate)
    (member size_t     wpb_cell)
    (member size_t     wpb_size)
    (member void *     wpb_st)
    (member size_t     wpb_mark)
    ;; and WPNEST the portray goals running, one inside another: no more
    ;; than swipl's MAX_PORTRAY_NESTING, 100, past which the innermost write
    ;; raises resource_error(portray_nesting) (WPSTATE 4). Appended.
    (member int        wpnest)
    ;; WPGAPB and WPGAPQ (3.55.0): the buffer and the place where the text
    ;; of the innermost goal that failed having written ends, where the
    ;; term after it takes a gap -- unless another goal's text begins
    ;; there, which clears them, as no space goes before a write of
    ;; swipl's (`pgpg a', swipl's text, where 3.54.0 wrote `pg pg a').
    ;; Appended.
    (member void *     wpgapb)
    (member size_t     wpgapq)
    ;; A SOURCE FILE'S ENCODING (3.58.0, swipl's `:- encoding(E)', a BOM
    ;; and load_files/2's encoding(E)): LENC is what the next read of a
    ;; file asks -- 0 nothing (its BOM's, else UTF-8), a class plus one
    ;; (`coco_enc_class'), 6 `bom', 7 `default' -- set by a load around that read and
    ;; cleared by it; LCLS the class the text the next consult reads was
    ;; decoded from, which its `:- encoding(E)' writes the rest back in,
    ;; set by whoever read the file right before the consult, which takes
    ;; it as it begins. Appended.
    (member int        lenc)
    (member int        lcls)
    ;; WSHORT (3.59.0): the write in hand stopped for want of C stack, where
    ;; swipl's C_STACK_OVERFLOW_GUARDED catches the overflow -- its text
    ;; taken back, the write answering 0, and its builtin to raise
    ;; resource_error(c_stack) (`coco_write_short'). Cleared as every write
    ;; begins. Appended.
    (member int        wshort))

  ;;; A growable character buffer. The writer builds text in one, the state
  ;;; serialiser builds an encoded machine in one, and the Zigurat backends
  ;;; hand one to the wire. It is deliberately not a (<> vector char): those
  ;;; are `non-copy' and own their storage through `letin', which is the right
  ;;; arrangement for a value and the wrong one for a scratch buffer passed
  ;;; down a recursion by pointer.
  (struct coco_strbuf
    (member char *  s)
    (member size_t  len)
    (member size_t  cap))

  (decl) (func coco_sb_init ((coco_strbuf * b)))
  (decl) (func coco_sb_free ((coco_strbuf * b)))
  (decl) (func coco_sb_reset ((coco_strbuf * b)))
  (decl) (func coco_sb_putc ((coco_strbuf * b) (char c)) (out int))
  (decl) (func coco_sb_put ((coco_strbuf * b) (const char * s)) (out int))
  (decl) (func coco_sb_put_len ((coco_strbuf * b) (const char * s) (size_t n)) (out int))
  ;; Numbers, and only numbers. There is no printf-style appender here:
  ;; `va_start' takes the un-decayed last parameter and so is not something
  ;; Cicili declares (see lib/std/c/stdarg.cicili), and reaching for a `code'
  ;; escape to get one back would put an unchecked fragment in the middle of
  ;; the writer. Two fixed formatters cover everything the writer needs.
  (decl) (func coco_sb_put_i64 ((coco_strbuf * b) (i64 v)) (out int))
  (decl) (func coco_sb_put_double ((coco_strbuf * b) (double v)) (out int))

  ;; ---- text in characters (1.13.0, the `text_units' flag) ----
  (decl) (func coco_text_default () (out int))
  (decl) (func coco_text_default_set ((int chars)))
  (decl) (func coco_verbose_silent () (out int))
  (decl) (func coco_verbose_silent_set ((int on)))
  (decl) (func coco_optimise_unify () (out int))
  (decl) (func coco_optimise_unify_set ((int on)))
  ;; ---- the float flags (2.2.2) ----
  (decl) (func coco_fflags_default () (out int))
  (decl) (func coco_fflags_default_set ((int fl)))
  ;; ---- the stack limit (3.32.0) ----
  (decl) (func coco_slimit_default () (out i64))
  (decl) (func coco_slimit_default_set ((i64 v)))
  ;; ---- the console's column (2.16.0): `~N' and print_message/2 ----
  (decl) (func coco_out_note ((FILE * f) (const char * s) (size_t n)))
  (decl) (func coco_out_where ((i64 * nc) (i64 * nl) (i64 * lp) (i64 * nb)))
  (decl) (func coco_out_set_column ((i64 lp)))
  (decl) (func coco_out_puts ((FILE * f) (const char * s)))
  (decl) (func coco_out_putc ((FILE * f) (int c)))
  (decl) (func coco_out_open ((FILE * f)) (out int))
  (decl) (func coco_out_column ((FILE * f)) (out i64))
  (decl) (func coco_out_fresh ((FILE * f)))
  (decl) (func coco_out_lastc ((FILE * f)) (out i64))
  (decl) (func coco_out_lastc_set ((FILE * f) (i64 c)))
  (decl) (func coco_out_capture_begin () (out i64))
  (decl) (func coco_out_capture_end ((i64 saved)))
  (decl) (func coco_col_walk ((const char * s) (size_t from) (size_t to) (i64 col) (int mode)) (out i64))
  (decl) (func coco_utf8_get ((const char * s) (size_t n) (size_t * i)) (out i64))
  (decl) (func coco_utf8_enc ((char * u) (i64 cp)) (out int))
  (decl) (func coco_utf8_put ((coco_strbuf * b) (i64 cp)) (out int))
  ;; ---- a source file's encoding (3.58.0) ----
  (decl) (func coco_enc_class ((const char * name)) (out int))
  (decl) (func coco_text_raw ((const char * s) (int cls) (coco_strbuf * out)) (out int))
  (decl) (func coco_text_cook ((const char * raw) (size_t n) (int cls) (coco_strbuf * out)) (out int))
  (decl) (func coco_source_text ((const char * path) (int ask) (int * cls)) (out char *))
  (decl) (func coco_text_list ((coco_machine * m) (const char * s) (size_t n) (int as_chars) (size_t tail)) (out size_t))
  (decl) (func coco_utf8_count ((const char * s) (size_t n)) (out size_t))
  (decl) (func coco_utf8_at ((const char * s) (size_t n) (size_t k)) (out size_t))
  (decl) (func coco_utf8_one ((const char * s)) (out i64))
  (decl) (func coco_uc_case ((i64 c) (int up)) (out i64))
  (decl) (func coco_ct_flags ((i64 c)) (out u32))
  (decl) (func coco_rd_flags ((i64 c)) (out u32))
  (decl) (func coco_text_case ((const char * s) (size_t n) (int up) (coco_strbuf * o)) (out int))

  ;; ---- the two shifts, by any count (1.14.0) ----
  ;;; A SHIFT BY A COUNT C ALREADY SHIFTS BY C IN C only while C is 0 to 63:
  ;;; past that, and for a negative count, the shift is UNDEFINED (C11
  ;;; 6.5.7/3), and x86-64 and aarch64 both take the count modulo 64 -- so
  ;;; `1 >> 64' answered 1, `1 << 1000000' answered 1, and `1 >> -1'
  ;;; answered `1 >> 63' (cicilang's report, found when a 128-bit
  ;;; significand written as its two halves did not move). Here are SWI's
  ;;; answers instead, as far as a 64-bit integer carries them (2.0.0;
  ;;; through 1.15.0, 61 bits):
  ;;;   A >> N, N past 63: where an arithmetic shift ends, the sign of A --
  ;;;     0, or -1 -- which is what SWI's unbounded integers answer too.
  ;;;   A << N: SWI's answer when it fits 64 bits -- `1 << 62' is 2^62,
  ;;;     `-1 << 63' the least integer -- and OVF set when it does not, a
  ;;;     bit of A or its sign lost (`1 << 63', `1 << 64'): the caller
  ;;;     raises evaluation_error(int_overflow), where SWI, whose integers
  ;;;     have no width, answers 2^63. 0 shifted is 0 by any count.
  ;;;   A NEGATIVE COUNT shifts the other way, as SWI's does: `1 >> -1' is
  ;;;     2 and `4 << -1' is 2. A count whose magnitude is past 63 is the
  ;;;     other direction's rule above, and is tested BEFORE the negation,
  ;;;     which the smallest integer would overflow.
  ;;; The left shift goes through u64, because a left shift of a NEGATIVE
  ;;; value is undefined as well (6.5.7/4) and the bit pattern two's
  ;;; complement wants is the one an unsigned shift leaves; it kept every
  ;;; bit when shifting the result back arithmetically gives A again.
  ;;;
  ;;; Static, for the four callers that share them -- `coco_arith' in
  ;;; solve.cicili and the guards' runner, written once in kb.cicili and
  ;;; emitted three times -- and NOT forced inline, because clang inlines
  ;;; them where it wants to anyway: a `(static) (inline)' build (which
  ;;; takes no `(decl)' -- Cicili refuses an inline function declared and
  ;;; defined apart) counted within 200 instructions of this one on all
  ;;; three of zero.sh's programs, out of 47 million. What the two cost is
  ;;; not the call: it is the branches added to the guards' AG_BIN switch,
  ;;; which moved its registers -- lookup, whose bodies start with
  ;;; arithmetic and whose guards never shift, runs 0.047 % more
  ;;; instructions than 1.13.7 (STATUS.md).

  (static) (decl) (func coco_shift_right ((i64 a) (i64 n) (int * ovf)) (out i64))
  (static) (decl) (func coco_shift_left ((i64 a) (i64 n) (int * ovf)) (out i64))

  ;; ---- the sum, the difference and the product in 64 bits (2.0.0) ----
  ;;; A + B, A - B and A * B into R, answering 0 when 64 bits hold the
  ;;; result and 1 when they do not, R then what the hardware wrapped to.
  ;;; Every evaluator calls these -- `coco_arith', the guards' runner, the
  ;;; fused word, succ/plus, sum_list -- so that a result past 64 bits is
  ;;; evaluation_error(int_overflow) wherever it is computed. They are the
  ;;; compiler's own tests (`(code ...)': Cicili cannot name a builtin), an
  ;;; `add', `sub' or `imul' and a `jo': the same test written in 128 bits
  ;;; was nine instructions an add, and lookup ran 2.6 % more of them.

  ;; ---- lifecycle ----
  (decl) (func coco_machine_init ((coco_machine * m)) (out int))
  (decl) (func coco_machine_free ((coco_machine * m)))
  ;; A MACHINE OVER ANOTHER MACHINE'S TABLES: a green thread's, with its
  ;; own heap, trail and choices and the root's names. It links itself into
  ;; the root's alias list; freeing it unlinks and leaves the tables.
  (decl) (func coco_machine_init_alias ((coco_machine * m) (coco_machine * base)) (out int))
  ;; the root of an alias chain, and the two directions of the table copy:
  ;; the root's fields to an alias before it runs, an alias's after it has
  ;; grown the tables.
  (decl) (func coco_troot ((coco_machine * m)) (out coco_machine *))
  (decl) (func coco_tsync ((coco_machine * m)))
  (decl) (func coco_tupdate ((coco_machine * m)))
  ;; A green world shares the root's tables across OS threads: it hands the
  ;; table functions a mutex (coco_tbl_set) and a generation. The mutation
  ;; functions take the mutex around their growth; the VALUE reads on the run
  ;; paths stay lock-free, reading the fields a machine synced at its run.
  (decl) (func coco_tbl_set ((pthread_mutex_t * mx)))
  (decl) (func coco_tbl_sync ((coco_machine * m)))
  (decl) (func coco_tbl_begin ((coco_machine * m)))
  (decl) (func coco_tbl_end ((coco_machine * m)))
  ;; unlock without publishing: a look under the lock that found what it
  ;; wanted changed nothing, so the generation must not move
  (decl) (func coco_tbl_done ((coco_machine * m)))
  (decl) (func coco_tbl_grow ((coco_machine * m) (void ** buf) (size_t * cap)
                              (size_t need) (size_t esize)) (out int))

  ;; ---- names ----
  (decl) (func coco_intern ((coco_machine * m) (const char * name)) (out u64))
  (decl) (func coco_intern_len ((coco_machine * m) (const char * name) (size_t len)) (out u64))
  (decl) (func coco_atom_name ((coco_machine * m) (u64 id)) (out const char *))
  ;; THE EMPTY LIST AND THE ATOM `'[]'' (3.0.0): the list's end is the
  ;; table's entry for the name "[]", the atom a second entry of the same two
  ;; bytes that no lookup of the name finds (`coco_intern_tnil').
  (decl) (func coco_nil_id ((coco_machine * m)) (out u64))
  (decl) (func coco_intern_tnil ((coco_machine * m)) (out u64))
  (decl) (func coco_atom_is_tnil ((coco_machine * m) (u64 id)) (out int))
  (decl) (func coco_new_nil ((coco_machine * m)) (out size_t))
  (decl) (func coco_is_nil ((coco_machine * m) (size_t h)) (out int))
  (decl) (func coco_functor_id ((coco_machine * m) (u64 name) (u32 arity)) (out u64))
  ;; a name and an arity as one word, for the two tables that find one: the
  ;; functors here and the predicates in kb.cicili
  (decl) (func coco_name_arity_hash ((u64 name) (u32 arity)) (out u64))

  ;; ---- heap ----
  (decl) (func coco_push ((coco_machine * m) (u64 c)) (out size_t))
  (decl) (func coco_new_var ((coco_machine * m)) (out size_t))
  ;; a compound's header C and its N argument slots, each a fresh variable
  ;; for the caller to point somewhere (`coco_set_arg'), in one growth check
  ;; and N+1 stores: what the copy walks push for every compound they meet
  (decl) (func coco_push_struct ((coco_machine * m) (u64 c) (u32 n)) (out size_t))
  ;; the same with the N slots RESERVED AND NOT WRITTEN: for a caller that
  ;; will write every one of them itself before anything can read them
  ;; (the clause executor), and so saves a store per slot
  (decl) (func coco_push_struct_raw ((coco_machine * m) (u64 c) (u32 n)) (out size_t))
  (decl) (func coco_new_atom ((coco_machine * m) (const char * name)) (out size_t))
  ;; an atom of N bytes of text: "[]" the atom `'[]'', as `coco_new_atom'
  (decl) (func coco_new_text_atom ((coco_machine * m) (const char * s) (size_t n)) (out size_t))
  (decl) (func coco_new_int ((coco_machine * m) (i64 v)) (out size_t))
  (decl) (func coco_new_float ((coco_machine * m) (double v)) (out size_t))
  ;; an entry of the integer table holding V, and no cell (2.0.0): the
  ;; thaw's way to fill the table a frozen heap names
  (decl) (func coco_big_entry ((coco_machine * m) (i64 v)) (out size_t))
  ;; opens a compound of ARITY and answers its header index; the caller then
  ;; pushes exactly ARITY argument cells
  (decl) (func coco_open_struct ((coco_machine * m) (const char * name) (u32 arity)) (out size_t))
  ;; points a reserved argument cell at the term that was built for it. The
  ;; term DSL emits this rather than assigning into the heap itself: `->' wants
  ;; a pointer it can name, and the machine reaches the DSL as (aof m).
  (decl) (func coco_set_arg ((coco_machine * m) (size_t slot) (size_t val)))

  ;; Builds a compound whose arguments already exist. The DSL cannot help the
  ;; reader or the engine, which discover their arguments at run time, so they
  ;; get this instead: the arguments are known before the header is pushed, so
  ;; nothing has to be reserved and fixed up and the argument cells are simply
  ;; pushed as references.
  (decl) (func coco_make ((coco_machine * m) (const char * name) (u32 n) (const size_t * args)) (out size_t))
  (decl) (func coco_make1 ((coco_machine * m) (const char * name) (size_t a)) (out size_t))
  (decl) (func coco_make2 ((coco_machine * m) (const char * name) (size_t a) (size_t b)) (out size_t))
  ;; The same three BY FUNCTOR ID, for a caller that builds the same shape
  ;; on every inference and has interned it once: the engine's `'$k'/3',
  ;; `'$cut'/1' and the markers. `coco_make' pays an intern and a functor
  ;; probe per call; these pay the pushes and nothing else.
  (decl) (func coco_make_f ((coco_machine * m) (u64 fid) (u32 n) (const size_t * args)) (out size_t))
  (decl) (func coco_make1_f ((coco_machine * m) (u64 fid) (size_t a)) (out size_t))
  (decl) (func coco_make2_f ((coco_machine * m) (u64 fid) (size_t a) (size_t b)) (out size_t))
  ;; and an atom by its interned id, for the same reason
  (decl) (func coco_new_atom_id ((coco_machine * m) (u64 id)) (out size_t))
  ;; the list cell '.'(H, T) -- spelt out because the reader builds a great
  ;; many of them and `[H|T]' should not cost an array on the way past
  (decl) (func coco_cons ((coco_machine * m) (size_t h) (size_t t)) (out size_t))
  ;; `'.'/2''s functor id, interned the first time it is asked for
  (decl) (func coco_cons_fid ((coco_machine * m)) (out u64))
  ;; is T, dereferenced, a list cell? By the functor's id, never its name
  (decl) (func coco_is_cons ((coco_machine * m) (size_t t)) (out int))

  ;; ---- inspection ----
  (decl) (func coco_deref ((coco_machine * m) (size_t t)) (out size_t))
  (decl) (func coco_arity ((coco_machine * m) (size_t t)) (out u32))
  (decl) (func coco_name_of ((coco_machine * m) (size_t t)) (out u64))
  (decl) (func coco_arg ((coco_machine * m) (size_t t) (u32 i)) (out size_t))
  (decl) (func coco_is_callable ((coco_machine * m) (size_t t)) (out int))

  ;; ---- binding and backtracking ----
  (decl) (func coco_bind ((coco_machine * m) (size_t var) (size_t val)))
  ;; Puts a cell on the trail without binding it. Only `coco_thaw' wants this:
  ;; the heap it is restoring already holds the bindings, and what has to come
  ;; back is the record of which ones to undo.
  (decl) (func coco_trail_push ((coco_machine * m) (size_t var)) (out int))
  ;; A VALUE ENTRY (1.12.0, `setarg/3'): cell SAVED holds what cell AT held,
  ;; and backtracking past the entry puts it back. Two trail words, both
  ;; with the pair bit (`coco-trail-pair'), SAVED first. 0 when the trail
  ;; would not grow.
  (decl) (func coco_trail_pair ((coco_machine * m) (size_t saved) (size_t at)) (out int))
  ;; A GLOBAL'S SENTINEL (1.12.1, `coco-trail-tag'): the copy SERIAL of
  ;; global I was made here, I under 2^23 - 1 and SERIAL from 1 to 2^23 -
  ;; 1. 0 when the trail would not grow.
  (decl) (func coco_trail_sent ((coco_machine * m) (u64 serial) (size_t i)) (out int))
  (decl) (func coco_undo_to ((coco_machine * m) (size_t mark)))
  ;; WHAT WAS DONE SINCE MARK TO A CELL UNDER FLOOR IS UNDONE, the rest kept
  ;; done and its entries dropped (3.52.0): an expansion hook's work on what
  ;; is older than the term in hand (`coco_consult_xcall'), and all of a
  ;; load's goal's, FLOOR past every cell (`lb_goal_hook'). With KEEP the
  ;; sentinels of the ground globals' copies still standing stay, from
  ;; MARK in their order.
  (decl) (func coco_undo_older ((coco_machine * m) (size_t mark) (size_t floor) (int keep)))

  ;; ---- the heap collector's host roots ----
  ;;; A host that keeps heap cell indices of its own across
  ;;; `coco_engine_next' -- the REPL keeps the query's variables, to print
  ;;; their bindings -- registers the array they live in, so a collection
  ;;; moves them with the cells they name. A stack: pop in reverse order.
  ;;; `coco_heap_pos_push' registers heap POSITIONS (lengths the host winds
  ;;; the heap back to) on the same stack: moved, never marked.
  (decl) (func coco_heap_root_push ((coco_machine * m) (size_t ** cells) (size_t * len)) (out int))
  (decl) (func coco_heap_pos_push ((coco_machine * m) (size_t ** cells) (size_t * len)) (out int))
  (decl) (func coco_heap_root_pop ((coco_machine * m)))
  ;; every registered position at or above FROM raised to H (1.12.0)
  (decl) (func coco_heap_raise_positions ((coco_machine * m) (size_t from) (size_t h)))
  ;; the ground globals a machine holds (1.12.1): forget them all, the
  ;; cache then for the store whose serial is SS; room for entry I, 0 when
  ;; it would not grow; and whether the copy entry I holds still stands --
  ;; pinned, out of backtracking's reach, or its sentinel where it was put
  (decl) (func coco_gcache_drop ((coco_machine * m) (u64 ss)))
  (decl) (func coco_gcache_room ((coco_machine * m) (size_t i)) (out int))
  (decl) (func coco_gcache_ok ((coco_machine * m) (size_t i)) (out int))
  (decl) (func coco_unify ((coco_machine * m) (size_t a) (size_t b)) (out int))

  ;; ---- copying ----
  ;;; The variable map for one copy. AN OPEN-ADDRESSING TABLE, keyed by the
  ;;; source variable's index: `from' holds the key PLUS ONE (so 0 is an
  ;;; empty slot), `to' the variable it became, `cap' the table size (a
  ;;; power of two, kept under half full) and `len' how many are in it.
  ;;;
  ;;; It was a plain array of pairs scanned linearly, on the argument that a
  ;;; clause has a handful of distinct variables. A compiler's lowering rule
  ;;; has fifty, each occurring twice, and the scan made the copy of such a
  ;;; clause quadratic in them: measured on a fact of 64 variables, 72 % of
  ;;; the interpreter's instructions were in the copy, and a call cost 4.4
  ;;; microseconds where one of none took 0.9 -- most of it this map. A probe is a
  ;;; multiply, a mask and usually one comparison, whatever the count.
  ;;;
  ;;; It is declared here rather than hidden inside `coco_copy' because the
  ;;; clause store copies terms too -- out of the heap when a clause is
  ;;; asserted, back into it when one is used -- and the rule that one original
  ;;; variable becomes one fresh variable has to hold for all three.
  ;;;
  ;;; A COPY BORROWS THE MACHINE'S ARRAYS. `coco_varmap_take' hands over the
  ;;; pair the machine keeps, or an empty map when a copy nested inside
  ;;; another finds them gone; `coco_varmap_give' returns them, or frees
  ;;; them when the machine already holds a pair or this one grew past what
  ;;; is worth keeping. Two mallocs and two frees per clause tried were 4 %
  ;;; of the same measurement.
  ;;;
  ;;; NOTHING IS CLEARED BETWEEN COPIES. Each `from' entry carries the
  ;;; EPOCH of the copy that wrote it in its high 24 bits above the key, a
  ;;; take raises the epoch, and an entry from an earlier epoch is an empty
  ;;; slot to the probe -- so a copy of a term with two thousand variables
  ;;; does not leave every clause copy after it clearing a table that
  ;;; size. The epoch wraps at 2^24, when the table IS cleared, once.
  (struct coco_varmap
    (member u64 *    from)
    (member size_t * to)
    (member size_t   len)
    (member size_t   cap)
    (member u64      epoch))

  (decl) (func coco_varmap_get ((coco_varmap * vm) (size_t from) (size_t * out_to)) (out int))
  (decl) (func coco_varmap_put ((coco_varmap * vm) (size_t from) (size_t to)) (out int))
  ;; one probe for both: answers 1 and fills OUT_TO when FROM is mapped,
  ;; else maps it to TO and answers 0 (-1 when the table could not grow)
  (decl) (func coco_varmap_intern ((coco_varmap * vm) (size_t from) (size_t to)
                                   (size_t * out_to)) (out int))
  (decl) (func coco_varmap_free ((coco_varmap * vm)))
  (decl) (func coco_varmap_take ((coco_machine * m) (coco_varmap * vm)))
  (decl) (func coco_varmap_give ((coco_machine * m) (coco_varmap * vm)))

  ;;; One pending compound of a copy in flight: the source term, the first
  ;;; reserved destination slot, the arity, and how many arguments are done.
  ;;; Out here for the clause store's reason above: all three walks -- heap
  ;;; to heap, heap to store, store to heap -- carry their pending work in
  ;;; an array of these rather than in C stack frames, because a frame per
  ;;; argument is a frame per cons cell, and a list past ~50k elements
  ;;; overflowed the C stack and killed the process (measured: rc=139 on
  ;;; `assert' and `findall' of a 100000-element list).
  (struct coco_copyframe
    (member size_t src)
    (member size_t dst)
    (member u32    n)
    (member u32    i))

  (decl) (func coco_frames_push ((coco_copyframe ** fs) (size_t * len) (size_t * cap)
                                 (size_t src) (size_t dst) (u32 n)) (out int))

  ;; the machine's walk stacks, borrowed for one walk and given back -- see
  ;; the `wframes' and `wpairs' members
  (decl) (func coco_wframes_take ((coco_machine * m) (size_t * cap)) (out void *))
  (decl) (func coco_wframes_give ((coco_machine * m) (void * p) (size_t cap)))
  ;; the `cslots' member: at least NEED slots, or nil when none can be had
  (decl) (func coco_cslots_take ((coco_machine * m) (size_t need) (size_t * cap)) (out size_t *))
  (decl) (func coco_cslots_give ((coco_machine * m) (size_t * p) (size_t cap)))
  (decl) (func coco_wpairs_take ((coco_machine * m) (size_t * cap)) (out size_t *))
  (decl) (func coco_wpairs_give ((coco_machine * m) (size_t * p) (size_t cap)))

  ;; a fresh copy of T with fresh variables, pushed on the heap
  (decl) (func coco_copy ((coco_machine * m) (size_t t)) (out size_t))
  ;; is T free of cycles? 1 yes, 0 no (`X = f(X)'), -1 no memory to say
  (decl) (func coco_acyclic ((coco_machine * m) (size_t t)) (out int))
  ;; cyclic T in factors, NAME(Template, [V1=T1, ...]) on the heap, the
  ;; Vi in VARS (malloc'd); 0 when it could not be built
  (decl) (func coco_factorize ((coco_machine * m) (size_t t) (const char * name)
                               (size_t ** vars) (size_t * nvars)) (out size_t))
  ;; `'$cyclic'(Template, [V1=T1, ...])' as a store's put makes one: each Vi
  ;; bound to its Ti and the template answered -- the cyclic term again;
  ;; anything else answered as it is
  (decl) (func coco_unfactor ((coco_machine * m) (size_t t)) (out size_t))
  ;; does T, read through the bindings, hold the unbound variable V? 1, 0,
  ;; -1 when the walk could not grow
  (decl) (func coco_occurs ((coco_machine * m) (size_t v) (size_t t)) (out int))
  ;; is L a list whose tail comes back to itself?
  (decl) (func coco_list_cyclic ((coco_machine * m) (size_t l)) (out int))
  ;; one cell on a growable worklist (malloc'd, the caller frees it); 0
  ;; when it could not grow
  (decl) (func coco_cells_push ((size_t ** wl) (size_t * wlen) (size_t * wcap) (size_t a)) (out int))
  ;; the elements of such a list, every one at least once, in ITEMS
  ;; (malloc'd); 0 when L is none
  (decl) (func coco_list_cycle_items ((coco_machine * m) (size_t l) (size_t ** items)
                                      (size_t * n)) (out int))
  ;; structural comparison: <0, 0, >0 in the standard order of terms
  (decl) (func coco_compare ((coco_machine * m) (size_t a) (size_t b)) (out int))
  (decl) (func coco_str_eq ((coco_machine * m) (u64 ca) (u64 cb)) (out int))
  (decl) (func coco_flt_eq ((coco_machine * m) (u64 ca) (u64 cb)) (out int))
  (decl) (func coco_str_cmp ((coco_machine * m) (size_t a) (size_t b)) (out int))

  ) ; decl-term


;;;; ------------------------------------------------------------------
;;;; Implementation
;;;; ------------------------------------------------------------------

(generic impl-term
  ()

  ;;; A DOUBLING REFUSED (1.10.28): ask for what is needed and a sixteenth
  ;;; more, and if that is given, stop the running engine (`haltp'), whose
  ;;; next step raises error(resource_error(memory), _) for a catch/3 to
  ;;; take -- with room left for the ball and the unwinding, and nothing
  ;;; written wrong on the way, because this growth succeeded. Only when
  ;;; that is refused too is the machine finished: `oom', as before. Through
  ;;; 1.10.27 the doubling was all there was, and its refusal ended the run
  ;;; with `out of memory', which nothing could catch. Out of line, and
  ;;; cold: only a refusal comes here.
  (cold)
  (func coco_grow_short ((coco_machine * m) (void ** buf) (size_t * cap) (size_t need) (size_t esize))
        (out int)
        (let ((size_t ncap . #'(+ need (+ (/ need 16) 64)))
              (void * nbuf . #'(realloc (cof buf) (* ncap esize))))
          (if (== nbuf nil)
              (block (set (-> m oom) 1) (return 0)))
          (set (cof buf) nbuf)
          (set (cof cap) ncap)
          (if (!= (-> m haltp) nil)
              (if (== (cof (-> m haltp)) 0) (set (cof (-> m haltp)) 2)))
          (return 1)))

  ;;; The growth itself, out of line (weak: never inlined). Through 1.10.27
  ;;; it was inlined into every push with the test before it, and the call
  ;;; to `coco_grow_short' made each copy big enough that clang stopped
  ;;; inlining `coco_new_var' -- lookup ran 4.2 % more instructions, 1.66
  ;;; million of them in calls to it (1.10.28, callgrind).
  ;;; AND COLD (2.11.2, Cicili 3.1.0's `(cold)'): weak kept it out of line,
  ;;; but each block that calls it still weighed what clang's guess gave
  ;;; the test before it, and a hot function laid out its path and its
  ;;; registers around a growth that happens once a doubling. Cold, the
  ;;; block is unlikely: `coco_clause_run_r' ran 2.0 % fewer instructions
  ;;; on naive reverse, the cost 1.10.28 recorded (+0.63 % of nrev, all of
  ;;; it there) taken back and more (STATUS.md).
  ;;; THE STACK LIMIT AT A GROWTH (3.32.0): the heap and the trail are each
  ;;; capped by the limit's cells (`coco-room-cap', the rule the choice
  ;;; stack's growth shares); the collector waits for no more than the cells
  ;;; the trail and the choices leave the heap (`coco_heap_collect'), so a
  ;;; heap the limit holds is collected before it grows past it, and the
  ;;; collection asks what all of them hold. Only a doubling comes here.
  (weak) (cold)
  (func coco_stack_cap ((coco_machine * m) (void ** buf) (size_t need) (size_t ncap) (int * over))
        (out size_t)
        (if (and (!= buf (cast (void **) (aof (-> m heap))))
                 (!= buf (cast (void **) (aof (-> m trail)))))
            (return ncap))
        (let ((size_t lc . #'(cast size_t (/ (cast u64 (-> m slimit)) 8))))
          (coco-room-cap lc need ncap (cof over))
          (return ncap)))

  (weak) (cold)
  (func coco_grow_slow ((coco_machine * m) (void ** buf) (size_t * cap) (size_t need) (size_t esize))
        (out int)
        (let ((size_t ncap . #'(? (== (cof cap) 0) 64 (cof cap)))
              (void * nbuf) (int over . 0))
          (while (< ncap need) (set ncap (* ncap 2)))
          (if (> (-> m slimit) 0) (set ncap (coco_stack_cap m buf need ncap (aof over))))
          (set nbuf (realloc (cof buf) (* ncap esize)))
          (if (== nbuf nil)
              (return (coco_grow_short m buf cap need esize)))
          (set (cof buf) nbuf)
          (set (cof cap) ncap)
          (if (and over (!= (-> m haltp) nil))
              (if (== (cof (-> m haltp)) 0) (set (cof (-> m haltp)) 3)))
          (return 1)))

  ;;; GROWING. Every array in the machine grows the same way and every one of
  ;;; them has to answer "did that work?" the same way, so the growth is one
  ;;; static function taking the array by pointer-to-pointer and the element
  ;;; size: the test inlined where it is asked, the growth out of line
  ;;; (`coco_grow_slow'). A doubling refused is tried again smaller
  ;;; (`coco_grow_short'); a failure of that sets `oom' on the machine and
  ;;; leaves the array as it was: the caller can carry on writing nonsense
  ;;; into a machine that is already finished, and nothing dereferences a
  ;;; null on the way there.
  (static)
  (func coco_grow ((coco_machine * m) (void ** buf) (size_t * cap) (size_t need) (size_t esize))
        (out int)
        (if (<= need (cof cap)) (return 1))
        (return (coco_grow_slow m buf cap need esize)))

  ;;; djb2, widened to 64 bits. FNV-1a would be the usual choice and is not
  ;;; used here for a blunt reason: its offset basis is 14695981039346656037,
  ;;; which is above 2^63 and so cannot be written as a plain literal -- it
  ;;; would need a ULL suffix, and a suffix is not something a Cicili number
  ;;; carries. djb2's constants are 5381 and 33, the arithmetic is the same mod
  ;;; 2^64. THEN SPREAD (3.30.0), as `coco_name_arity_hash' spreads its word:
  ;;; multiplied by the FNV prime and the high bits folded down into the low
  ;;; ones the table's mask keeps. djb2 alone set short names apart in its
  ;;; high bits only, and the one-character atoms past ASCII, two to four
  ;;; bytes each, fell into a few runs of neighbouring slots that the linear
  ;;; probe walked to their end at each new atom: 40 000 of them by
  ;;; char_code/2 took 0.7 s and 20 000 0.09, and char_type(C, alpha), which
  ;;; makes 139 057, ran for minutes.
  (static)
  (func coco_hash ((const char * s) (size_t len)) (out u64)
        (let ((u64 h . 5381))
          (for ((size_t i . 0)) (< i len) ((++ i))
            (set h (xor (* h 33) (cast u64 (cast uchar (nth i s))))))
          (set h (* h 1099511628211))
          (return (xor h (>> h 29)))))

  ;;; ---- lifecycle ----------------------------------------------------

  (func coco_machine_init ((coco_machine * m)) (out int)
        (memset m 0 (sizeof coco_machine))
        (set (-> m atom_bucket_cap) 256)
        (set (-> m atom_buckets)
             (cast (size_t *) (calloc (-> m atom_bucket_cap) (sizeof size_t))))
        (if (== (-> m atom_buckets) nil)
            (block (set (-> m oom) 1) (return 0)))
        (set (-> m tlimit) 65536)
        (set (-> m treq) 65536)
        (set (-> m wdeep) 1024)
        (set (-> m wceil) (cast size_t -1))
        (set (-> m ubudget) 1048576)
        (set (-> m text_chars) (coco_text_default))
        (set (-> m fflags) (coco_fflags_default))
        (set (-> m slimit) (coco_slimit_default))
        (return 1))

  (func coco_troot ((coco_machine * m)) (out coco_machine *)
        (while (!= (-> m tbase) nil)
          (set m (cast (coco_machine *) (-> m tbase))))
        (return m))

  (static)
  (func coco_tcopy ((coco_machine * to) (coco_machine * from))
        (set (-> to atoms) (-> from atoms))
        (set (-> to atoms_len) (-> from atoms_len))
        (set (-> to atoms_cap) (-> from atoms_cap))
        (set (-> to atom_buckets) (-> from atom_buckets))
        (set (-> to atom_bucket_cap) (-> from atom_bucket_cap))
        (set (-> to functors) (-> from functors))
        (set (-> to functors_len) (-> from functors_len))
        (set (-> to functors_cap) (-> from functors_cap))
        (set (-> to functor_buckets) (-> from functor_buckets))
        (set (-> to functor_bucket_cap) (-> from functor_bucket_cap))
        (set (-> to floats) (-> from floats))
        (set (-> to floats_len) (-> from floats_len))
        (set (-> to floats_cap) (-> from floats_cap))
        (set (-> to bigs) (-> from bigs))
        (set (-> to bigs_len) (-> from bigs_len))
        (set (-> to bigs_cap) (-> from bigs_cap))
        (set (-> to rats) (-> from rats))
        (set (-> to rats_len) (-> from rats_len))
        (set (-> to rats_cap) (-> from rats_cap))
        (set (-> to strings) (-> from strings))
        (set (-> to strings_len) (-> from strings_len))
        (set (-> to strings_cap) (-> from strings_cap))
        (set (-> to ffree) (-> from ffree))
        (set (-> to nffree) (-> from nffree))
        (set (-> to ffree_cap) (-> from ffree_cap))
        (set (-> to sfree) (-> from sfree))
        (set (-> to nsfree) (-> from nsfree))
        (set (-> to sfree_cap) (-> from sfree_cap))
        (set (-> to bfree) (-> from bfree))
        (set (-> to nbfree) (-> from nbfree))
        (set (-> to bfree_cap) (-> from bfree_cap))
        (set (-> to rfree) (-> from rfree))
        (set (-> to nrfree) (-> from nrfree))
        (set (-> to rfree_cap) (-> from rfree_cap)))

  (func coco_tsync ((coco_machine * m))
        (let ((coco_machine * b . #'(coco_troot m)))
          (if (== b m) (return))
          (coco_tcopy m b)))

  (func coco_tupdate ((coco_machine * m))
        (let ((coco_machine * b . #'(coco_troot m)))
          (if (== b m) (return))
          (coco_tcopy b m)))

  ;;; THE SHARED NAMES' LOCK AND GENERATION. A green world sets a
  ;;; process-wide mutex; a table mutation takes it, syncs the machine's
  ;;; fields from the root when the generation moved, mutates, publishes to
  ;;; the root and moves the generation. A RUN takes the same mutex only to
  ;;; sync at its start; its value reads then hold no lock. Normal runs (no
  ;;; world) take no lock at all.
  (static) (var pthread_mutex_t * coco_tbl_mx . nil)
  (static) (var size_t coco_tbl_gen . 0)

  (func coco_tbl_set ((pthread_mutex_t * mx))
        (set coco_tbl_mx mx)
        (set coco_tbl_gen 0))

  (func coco_tbl_sync ((coco_machine * m))
        (if (== coco_tbl_mx nil) (return))
        ;; THE COMMON CASE IS NO WORK AND NO LOCK (2.9.2). A generation is a
        ;; word; while the tables are shared the old arrays are never freed,
        ;; so a machine one generation behind reads valid memory and its next
        ;; mutation's begin syncs it under the lock. The lock here was taken
        ;; by EVERY run of a green task, for nothing.
        (if (== (-> m tgen) coco_tbl_gen) (return))
        (pthread_mutex_lock coco_tbl_mx)
        (if (!= (-> m tgen) coco_tbl_gen)
            (block (coco_tsync m) (set (-> m tgen) coco_tbl_gen)))
        (pthread_mutex_unlock coco_tbl_mx))

  (func coco_tbl_begin ((coco_machine * m))
        (if (== coco_tbl_mx nil) (return))
        (pthread_mutex_lock coco_tbl_mx)
        (if (!= (-> m tgen) coco_tbl_gen)
            (block (coco_tsync m) (set (-> m tgen) coco_tbl_gen))))

  (func coco_tbl_end ((coco_machine * m))
        (if (== coco_tbl_mx nil)
            (block (coco_tupdate m) (return)))
        (coco_tupdate m)
        (set coco_tbl_gen (+ coco_tbl_gen 1))
        (set (-> m tgen) coco_tbl_gen)
        (pthread_mutex_unlock coco_tbl_mx))

  ;; A LOOK THAT FOUND THE NAME UNDER THE LOCK CHANGED NOTHING: unlock, and
  ;; move no generation -- a bump here would make every other machine resync
  ;; for the next run, which is what an intern hit used to do.
  (func coco_tbl_done ((coco_machine * m))
        (if (== coco_tbl_mx nil) (return))
        (pthread_mutex_unlock coco_tbl_mx))

  ;;; THE SHARED TABLES GROW WITHOUT FREEING the old array: a machine that
  ;;; synced its pointer before the growth keeps reading valid entries. The
  ;;; old array is leaked until the world ends (the root's current one is
  ;;; freed with the host machine); the leak is one array per growth.
  (func coco_tbl_grow ((coco_machine * m) (void ** buf) (size_t * cap)
                       (size_t need) (size_t esize)) (out int)
        (if (== coco_tbl_mx nil)
            (return (coco_grow m buf cap need esize)))
        ;; THE ROOM ALREADY THERE IS NOT GROWN. Without this the shared
        ;; path allocated and COPIED the whole table at every new entry --
        ;; cap entries for a need of len+1 -- so 20,000 floats (or strings,
        ;; bigs, rats) were quadratic: CivV measured float_new at 21.5 s
        ;; and float_same at 21.6 s in a green world, 8 ms outside it.
        (if (<= need (cof cap)) (return 1))
        (let ((size_t ncap . #'(? (== (cof cap) 0) 64 (cof cap)))
              (void * nbuf . nil))
          (while (< ncap need) (set ncap (* ncap 2)))
          (set nbuf (malloc (* ncap esize)))
          (if (== nbuf nil)
              (block (set (-> m oom) 1) (return 0)))
          (if (> (cof cap) 0)
              (memcpy nbuf (cof buf) (* (cof cap) esize)))
          (set (cof buf) nbuf)
          (set (cof cap) ncap)
          (return 1)))

  (func coco_machine_init_alias ((coco_machine * m) (coco_machine * base)) (out int)
        (memset m 0 (sizeof coco_machine))
        (set (-> m tlimit) 65536)
        (set (-> m treq) 65536)
        (set (-> m wdeep) 1024)
        (set (-> m wceil) (cast size_t -1))
        (set (-> m ubudget) 1048576)
        (set (-> m text_chars) (coco_text_default))
        (set (-> m fflags) (coco_fflags_default))
        (set (-> m slimit) (coco_slimit_default))
        (set (-> m tshared) 1)
        (let ((coco_machine * root . #'(coco_troot base)))
          ;; THE ALIAS LIST IS SHARED BY EVERY WORKER'S TASKS when the
          ;; world's root is one machine: link under the names mutex. A link
          ;; lost to a race leaves a freed machine on the list, and the next
          ;; walk over it is a use-after-free (light_green's SIGSEGV).
          (if (!= coco_tbl_mx nil) (pthread_mutex_lock coco_tbl_mx))
          (set (-> m tbase) (cast (void *) root))
          (set (-> m tnext) (-> root tnext))
          (set (-> root tnext) (cast (void *) m))
          (set (-> root tshared) 1)
          (coco_tsync m)
          (if (!= coco_tbl_mx nil) (pthread_mutex_unlock coco_tbl_mx)))
        (return 1))

  (func coco_machine_free ((coco_machine * m))
        (if (!= (-> m tbase) nil)
            (block
             ;; the alias list is shared: unlink under the same mutex
             (if (!= coco_tbl_mx nil) (pthread_mutex_lock coco_tbl_mx))
             (let ((coco_machine * root . #'(coco_troot m))
                   (coco_machine * prev . nil)
                   (coco_machine * cur . #'(cast (coco_machine *) (-> root tnext))))
               (while (!= cur nil)
                 (if (== cur m)
                     (block
                      (if (== prev nil) (set (-> root tnext) (-> m tnext))
                          (set (-> prev tnext) (-> m tnext)))
                      (break))
                   (block (set prev cur)
                          (set cur (cast (coco_machine *) (-> cur tnext)))))))
             (if (!= coco_tbl_mx nil) (pthread_mutex_unlock coco_tbl_mx))
             (free (-> m trail))
             (free (-> m heap))
             (free (-> m hroots))
             (free (-> m gcache))
             (free (-> m wframes))
             (free (-> m wpairs))
             (free (-> m vmap_from))
             (free (-> m vmap_to))
             (free (-> m cmask))
             (free (-> m cslots))
             (free (-> m bt))
             (free (-> m ssu_pis))
             (free (-> m gvb))
             (memset m 0 (sizeof coco_machine))
             (return)))
        (for ((size_t i . 0)) (< i (-> m atoms_len)) ((++ i))
          (free ($ (nth i (-> m atoms)) name)))
        (free (-> m atoms))
        (free (-> m atom_buckets))
        (free (-> m functors))
        (free (-> m functor_buckets))
        (free (-> m floats))
        (free (-> m bigs))
        (free (-> m rats))
        (for ((size_t i . 0)) (< i (-> m strings_len)) ((++ i))
          (free ($ (nth i (-> m strings)) p)))
        (free (-> m strings))
        (free (-> m ffree))
        (free (-> m sfree))
        (free (-> m bfree))
        (free (-> m rfree))
        (free (-> m trail))
        (free (-> m heap))
        (free (-> m hroots))
        (free (-> m gcache))
        (free (-> m wframes))
        (free (-> m wpairs))
        (free (-> m vmap_from))
        (free (-> m vmap_to))
        (free (-> m cmask))
        (free (-> m cslots))
        (free (-> m bt))
        (free (-> m ssu_pis))
        (free (-> m gvb))
        (memset m 0 (sizeof coco_machine)))

  ;;; ---- the character buffer ------------------------------------------

  (func coco_sb_init ((coco_strbuf * b))
        (set (-> b s) nil) (set (-> b len) 0) (set (-> b cap) 0))

  (func coco_sb_free ((coco_strbuf * b))
        (free (-> b s)) (set (-> b s) nil) (set (-> b len) 0) (set (-> b cap) 0))

  (func coco_sb_reset ((coco_strbuf * b))
        (set (-> b len) 0)
        (if (!= (-> b s) nil) (set (nth 0 (-> b s)) (cast char 0))))

  ;;; Room for N more characters AND the terminator. The buffer keeps a NUL at
  ;;; `len' at all times, so `b->s' is a C string the moment anything has been
  ;;; put in it and no caller has to remember to terminate it.
  (static)
  (func coco_sb_room ((coco_strbuf * b) (size_t n)) (out int)
        (if (< (+ (-> b len) (+ n 1)) (-> b cap)) (return 1))
        (let ((size_t ncap . #'(? (== (-> b cap) 0) 64 (-> b cap)))
              (char * ns))
          (while (<= ncap (+ (-> b len) (+ n 1))) (set ncap (* ncap 2)))
          (set ns (cast (char *) (realloc (-> b s) ncap)))
          (if (== ns nil) (return 0))
          (set (-> b s) ns)
          (set (-> b cap) ncap)
          (return 1)))

  (func coco_sb_putc ((coco_strbuf * b) (char c)) (out int)
        (if (not (coco_sb_room b 1)) (return 0))
        (set (nth (-> b len) (-> b s)) c)
        (set (-> b len) (+ (-> b len) 1))
        (set (nth (-> b len) (-> b s)) (cast char 0))
        (return 1))

  (func coco_sb_put_len ((coco_strbuf * b) (const char * s) (size_t n)) (out int)
        (if (not (coco_sb_room b n)) (return 0))
        (memcpy (+ (-> b s) (-> b len)) s n)
        (set (-> b len) (+ (-> b len) n))
        (set (nth (-> b len) (-> b s)) (cast char 0))
        (return 1))

  (func coco_sb_put ((coco_strbuf * b) (const char * s)) (out int)
        (return (coco_sb_put_len b s (strlen s))))

  ;;; ---- text in characters (1.13.0) ------------------------------------
  ;;;
  ;;; THE `text_units' FLAG. cocolog's text is UTF-8, and its builtins count
  ;;; CHARACTERS, SWI's -- atom_length('dár', 3), atom_codes/2 the code
  ;;; points -- since 2.0.0. Through 1.x they counted bytes, atom_length('dár',
  ;;; 4) and atom_codes/2 the UTF-8 bytes, and characters (1.13.0) were asked
  ;;; for; now bytes are, per machine: `:- set_prolog_flag(text_units,
  ;;; bytes)', or COCOLOG_TEXT_UNITS=bytes for a whole run. A frozen machine
  ;;; keeps the units it was frozen in, and one frozen before 1.13.0, which
  ;;; carries none, is bytes (lib/state.cicili).
  ;;;
  ;;; The process's default: COCOLOG_TEXT_UNITS read once, then the last
  ;;; set_prolog_flag/2's value, so a machine made after the directive -- a
  ;;; thread's, run_isolated/2's -- counts as the program does.
  (static) (var int coco_text_dflt . -1)

  (func coco_text_default () (out int)
        (if (< coco_text_dflt 0)
            (let ((const char * v . #'(getenv "COCOLOG_TEXT_UNITS")))
              (set coco_text_dflt (? (and (!= v nil) (== 0 (strcmp v "bytes"))) 0 1))))
        (return coco_text_dflt))

  (func coco_text_default_set ((int chars))
        (set coco_text_dflt chars))

  ;;; `verbose' SILENT (3.1.0), the process's as the flag is (lib/library.
  ;;; cicili keeps its value): swipl -q's, under which a load's failed
  ;;; `initialization(main, main)' says nothing and exits 1, as swipl's does
  (static) (var int coco_verbose_quiet . 0)

  (func coco_verbose_silent () (out int)
        (return coco_verbose_quiet))

  (func coco_verbose_silent_set ((int on))
        (set coco_verbose_quiet on))

  ;;; `optimise_unify' (3.15.0), swipl's and the process's: whether a store puts
  ;;; the unifications that begin a clause's body into its head
  ;;; (`coco_clause_compile' in lib/kb-consult.cicili)
  (static) (var int coco_optu . 1)

  (func coco_optimise_unify () (out int)
        (return coco_optu))

  (func coco_optimise_unify_set ((int on))
        (set coco_optu on))

  ;;; THE FLOAT FLAGS' DEFAULT (2.2.2): swipl's (0) until a set_prolog_flag/2
  ;;; of one of them, and then what it left, so a machine made after it -- a
  ;;; thread's, run_isolated/2's -- reckons as the program does, as
  ;;; `coco_text_default' keeps the units.
  (static) (var int coco_fflags_dflt . 0)

  (func coco_fflags_default () (out int)
        (return coco_fflags_dflt))

  (func coco_fflags_default_set ((int fl))
        (set coco_fflags_dflt fl))

  ;;; THE STACK LIMIT'S DEFAULT (3.32.0): swipl's, 1 GB, or COCOLOG_STACK_LIMIT
  ;;; read once (bytes, as the flag takes them), until a set_prolog_flag/2 of
  ;;; it, and then what it left, so a machine made after it -- a thread's,
  ;;; run_isolated/2's, a green task's -- is held to what the program asked
  ;;; for, as `coco_text_default' keeps the units. A value of 0 or less is
  ;;; no limit; one the variable does not spell as a number is the default.
  (static) (var i64 coco_slimit_dflt . 0)
  (static) (var int coco_slimit_read . 0)

  (func coco_slimit_default () (out i64)
        (if (not coco_slimit_read)
            (let ((const char * v . #'(getenv "COCOLOG_STACK_LIMIT")) (char * end . nil))
              (set coco_slimit_read 1)
              (set coco_slimit_dflt 1073741824)
              (if (and (!= v nil) (!= (nth 0 v) (cast char 0)))
                  (let ((i64 n . #'(cast i64 (strtol v (aof end) 10))))
                    (if (and (!= end nil) (== (nth 0 end) (cast char 0)))
                        (set coco_slimit_dflt n))))))
        (return coco_slimit_dflt))

  (func coco_slimit_default_set ((i64 v))
        (set coco_slimit_read 1)
        (set coco_slimit_dflt v))

  ;;; THE CONSOLE'S COLUMN (2.16.0): whether a line is open on stdout and on
  ;;; stderr -- the last character the engine wrote there was no newline --
  ;;; for format's `~N' and for print_message/2, whose every prefix begins
  ;;; with one. swipl keeps ONE position for user_output and user_error, so
  ;;; a line begun on either is open on both: `format(user_output, "abc",
  ;;; [])' and then `format(user_error, "~Nx~n", [])' puts the newline on
  ;;; stderr. While with_output_to/2 captures fd 1 (`coco_out_cap'), stdout
  ;;; keeps a column of its own, starting at 0, and stderr is the console's
  ;;; alone; the capture's end gives stdout the console's column back.
  ;;; WHAT IS COUNTED is what the engine writes -- write/1 and its kin, nl/0,
  ;;; tab/1, format/1,2,3, listing/0,1, the load's and the goal's reports,
  ;;; and library(stream)'s writes to its first three slots
  ;;; (`coco_m_out_note') -- and not what a module prints with stdio of its
  ;;; own, nor library(stream)'s set_output/1 to a file, which writes to fd 1
  ;;; and is counted as the console. Process-wide, as the descriptors are: a
  ;;; thread's write moves it too, a race that costs at most a newline.
  (static) (var int coco_out_mid . 0)
  (static) (var int coco_err_mid . 0)
  (static) (var int coco_out_cap . 0)
  ;;; and a capture's column, counted as the console's is (3.33.0): format's
  ;;; column stops begin where with_output_to/2's text stands, as swipl's
  ;;; begin where its memory stream's linepos stands
  (static) (var i64 coco_cap_lp . 0)

  ;;; AND THE CONSOLE'S POSITION (3.19.0), what character_count/2,
  ;;; line_count/2 and line_position/2 answer for user_output and
  ;;; user_error: ONE for the two, as swipl's, counted by the rules of a
  ;;; stream's position (library(stream)'s `st_pos_walk') from 0 -- swipl's
  ;;; standard streams count their lines from 0 -- over what the engine
  ;;; writes there, and not over a capture's writes to fd 1
  (static) (var i64 coco_con_nc . 0)
  (static) (var i64 coco_con_nl . 0)
  (static) (var i64 coco_con_lp . 0)
  (static) (var i64 coco_con_nb . 0)

  ;;; AND EACH ONE'S LAST CHARACTER (3.56.0), where write_term/2's
  ;;; partial(true) begins, as swipl's begins at the stream's lastc: one
  ;;; for user_output, one for user_error -- two streams in swipl, each its
  ;;; own lastc, though they share a position -- and a capture's, from none
  ;;; at its start as swipl's memory stream begins. -1 is none written yet.
  (static) (var i64 coco_out_lc . -1)
  (static) (var i64 coco_err_lc . -1)
  (static) (var i64 coco_cap_lc . -1)

  ;;; F's last character, the code that ends S[0..N), N > 0, whose last byte
  ;;; is past ASCII (3.56.0): a byte that ends no UTF-8 character is U+DC00
  ;;; plus it, as the reader takes one. Out of line and cold, the note's
  ;;; tail call: asked before its walks, the call made every note save five
  ;;; registers (17 instructions a write, where the tail call leaves 7)
  (weak) (cold)
  (func coco_out_note_wide ((FILE * f) (const char * s) (size_t n))
        (let ((size_t b . #'(- n 1)) (size_t j . 0) (i64 c . 0))
          (while (and (> b 0) (and (< (- n b) 4) (== (bitand (cast int (nth b s)) 192) 128)))
            (set b (- b 1)))
          (set j b)
          (set c (coco_utf8_get s n (aof j)))
          (if (!= j n) (set c (+ 56320 (bitand (cast int (nth (- n 1) s)) 255))))
          (coco_out_lastc_set f c)))

  (func coco_out_note ((FILE * f) (const char * s) (size_t n))
        (if (or (== s nil) (== n 0)) (return))
        (let ((int mid . #'(? (== (nth (- n 1) s) (cast char 10)) 0 1))
              (i64 lc . #'(bitand (cast i64 (nth (- n 1) s)) 255)))
          ;; and its last character, where partial(true) begins (3.56.0)
          (cond
            ((== f stdout) (set coco_out_mid mid) (if (not coco_out_cap) (set coco_err_mid mid))
             (if coco_out_cap (set coco_cap_lc lc) (set coco_out_lc lc)))
            ((== f stderr) (set coco_err_mid mid) (if (not coco_out_cap) (set coco_out_mid mid))
             (set coco_err_lc lc)))
          (if (and (== f stdout) coco_out_cap)
              (set coco_cap_lp (coco_col_walk s 0 n coco_cap_lp 1)))
          (if (or (== f stderr) (and (== f stdout) (not coco_out_cap)))
              (block
                (set coco_con_nb (+ coco_con_nb (cast i64 n)))
                (for ((size_t i . 0)) (< i n) ((++ i))
                  (let ((int c . #'(bitand (cast int (nth i s)) 255)))
                    ;; a byte that continues a UTF-8 character is no character
                    (if (!= (bitand c 192) 128)
                        (block
                          (set coco_con_nc (+ coco_con_nc 1))
                          (cond ((== c 10) (set coco_con_nl (+ coco_con_nl 1)) (set coco_con_lp 0))
                                ((== c 13) (set coco_con_lp 0))
                                ((== c 9) (set coco_con_lp (+ (bitor coco_con_lp 7) 1)))
                                ((== c 8) (if (> coco_con_lp 0) (set coco_con_lp (- coco_con_lp 1))))
                                (#t (set coco_con_lp (+ coco_con_lp 1))))))))))
          ;; a last byte past ASCII ends a character read whole, the note's
          ;; last act
          (if (< (nth (- n 1) s) 0) (coco_out_note_wide f s n))))

  ;;; the console's position: characters, the line, the column and bytes
  (func coco_out_where ((i64 * nc) (i64 * nl) (i64 * lp) (i64 * nb))
        (set (cof nc) coco_con_nc)
        (set (cof nl) coco_con_nl)
        (set (cof lp) coco_con_lp)
        (set (cof nb) coco_con_nb))

  ;;; and its column set, set_stream/2's line_position(N) of a standard
  ;;; stream (3.19.0, swipl's three share it)
  (func coco_out_set_column ((i64 lp))
        (set coco_con_lp lp))

  (func coco_out_puts ((FILE * f) (const char * s))
        (if (== s nil) (return))
        (fputs s f)
        (coco_out_note f s (strlen s)))

  (func coco_out_putc ((FILE * f) (int c))
        (let ((char one [2]))
          (set (nth 0 one) (cast char c))
          (set (nth 1 one) (cast char 0))
          (fputc c f)
          (coco_out_note f one 1)))

  ;;; 1 when a line is open on F (stdout or stderr), 0 at a line's start
  (func coco_out_open ((FILE * f)) (out int)
        (if (== f stdout) (return coco_out_mid))
        (if (== f stderr) (return coco_err_mid))
        (return 0))

  ;;; the column F stands at, where format's column stops begin (3.33.0):
  ;;; the console's, or stdout's in a capture
  (func coco_out_column ((FILE * f)) (out i64)
        (if (and (== f stdout) coco_out_cap) (return coco_cap_lp))
        (return coco_con_lp))

  ;;; `~N' on F: a newline only when a line is open there
  (func coco_out_fresh ((FILE * f))
        (if (coco_out_open f) (coco_out_putc f 10)))

  ;;; the last character written to F (stdout, a capture's while one runs,
  ;;; or stderr), -1 none, and set: library(stream)'s write_term/3 begins
  ;;; its capture where its stream stands (3.56.0)
  (func coco_out_lastc ((FILE * f)) (out i64)
        (if (and (== f stdout) coco_out_cap) (return coco_cap_lc))
        (if (== f stdout) (return coco_out_lc))
        (if (== f stderr) (return coco_err_lc))
        (return -1))

  (func coco_out_lastc_set ((FILE * f) (i64 c))
        (cond ((and (== f stdout) coco_out_cap) (set coco_cap_lc c))
              ((== f stdout) (set coco_out_lc c))
              ((== f stderr) (set coco_err_lc c))))

  ;;; with_output_to/2's capture of fd 1: stdout's column starts at 0 and is
  ;;; its own until the end, which gives back what the capture's start saved
  ;;; -- an outer capture's column, or the console's as stderr left it --
  ;;; and its last character starts at none (3.56.0): bit 0 the line open,
  ;;; bit 1 an outer capture, bits 2 to 23 the outer last character plus
  ;;; one, from bit 24 the column
  (func coco_out_capture_begin () (out i64)
        (let ((i64 saved . #'(bitor (cast i64 (bitor coco_out_mid (<< coco_out_cap 1)))
                                    (bitor (<< (bitand (+ coco_cap_lc 1) 4194303) 2)
                                           (<< coco_cap_lp 24)))))
          (set coco_out_cap 1)
          (set coco_out_mid 0)
          (set coco_cap_lp 0)
          (set coco_cap_lc -1)
          (return saved)))

  (func coco_out_capture_end ((i64 saved))
        (set coco_out_cap (cast int (bitand (>> saved 1) 1)))
        (set coco_out_mid (? coco_out_cap (cast int (bitand saved 1)) coco_err_mid))
        (set coco_cap_lc (- (bitand (>> saved 2) 4194303) 1))
        (set coco_cap_lp (>> saved 24)))

  ;;; THE COLUMN AFTER TEXT (3.33.0): S[FROM..TO) walked from COL, swipl's
  ;;; rules -- a character a column and a byte that continues one none, a
  ;;; newline and a return 0, a backspace one back -- and a tab a stream's
  ;;; (MODE 1: to the next multiple of eight, as the console and
  ;;; library(stream) count one) or format's own (MODE 0: pl-fmt.c's
  ;;; update_column(), (COL + 1) | 7, a column short of it)
  (func coco_col_walk ((const char * s) (size_t from) (size_t to) (i64 col) (int mode)) (out i64)
        (for ((size_t i . from)) (< i to) ((++ i))
          (let ((int c . #'(bitand (cast int (nth i s)) 255)))
            (if (!= (bitand c 192) 128)
                (cond ((or (== c 10) (== c 13)) (set col 0))
                      ((== c 9) (set col (? mode (+ (bitor col 7) 1) (bitor (+ col 1) 7))))
                      ((== c 8) (if (> col 0) (set col (- col 1))))
                      (#t (set col (+ col 1)))))))
        (return col))

  ;;; ONE CHARACTER OF S (N bytes) AT *I, as its code point, *I moved past
  ;;; it. A byte that begins no well-formed UTF-8 -- a stray continuation, a
  ;;; sequence cut short, an overlong form, a value past U+10FFFF -- is ONE
  ;;; character of its own, U+DC00 plus the byte (what Python calls
  ;;; surrogateescape), and `coco_utf8_put' writes that back as the byte:
  ;;; text that is not UTF-8 goes to codes and back unchanged. A LONE
  ;;; SURROGATE IS A CHARACTER (3.1.0, swipl's: atom_codes(A, [0xD800])),
  ;;; kept as its three bytes as UTF-8 would have them (what WTF-8 does), but
  ;;; for U+DC80..U+DCFF, which are the bytes above: those three bytes are
  ;;; three characters, so they too go back as they came.
  (func coco_utf8_get ((const char * s) (size_t n) (size_t * i)) (out i64)
        (let ((size_t k . #'(cof i))
              (i64 b0 . #'(cast i64 (cast uchar (nth (cof i) s))))
              (i64 cp . 0) (size_t need . 0) (i64 low . 0))
          (cond
            ((< b0 128) (set (cof i) (+ k 1)) (return b0))
            ((== (bitand b0 224) 192) (set cp (bitand b0 31)) (set need 1) (set low 128))
            ((== (bitand b0 240) 224) (set cp (bitand b0 15)) (set need 2) (set low 2048))
            ((== (bitand b0 248) 240) (set cp (bitand b0 7)) (set need 3) (set low 65536)))
          (if (or (== need 0) (>= (+ k need) n))
              (block (set (cof i) (+ k 1)) (return (+ 56320 b0))))
          (for ((size_t j . 1)) (<= j need) ((++ j))
            (let ((i64 bj . #'(cast i64 (cast uchar (nth (+ k j) s)))))
              (if (!= (bitand bj 192) 128)
                  (block (set (cof i) (+ k 1)) (return (+ 56320 b0))))
              (set cp (bitor (<< cp 6) (bitand bj 63)))))
          (if (or (or (< cp low) (> cp 1114111)) (and (>= cp 56448) (<= cp 56575)))
              (block (set (cof i) (+ k 1)) (return (+ 56320 b0))))
          (set (cof i) (+ k (+ need 1)))
          (return cp)))

  ;;; Code point CP as UTF-8 into U (room for 4), answering how many bytes:
  ;;; U+DC80..U+DCFF, what `coco_utf8_get' makes of a byte that was no
  ;;; character, as that byte, and any other surrogate as its three bytes;
  ;;; 0 for what is no character -- below 0, past U+10FFFF.
  (func coco_utf8_enc ((char * u) (i64 cp)) (out int)
        (if (or (< cp 0) (> cp 1114111)) (return 0))
        (if (< cp 128) (block (set (nth 0 u) (cast char cp)) (return 1)))
        (if (and (>= cp 56448) (<= cp 56575))
            (block (set (nth 0 u) (cast char (- cp 56320))) (return 1)))
        (if (< cp 2048)
            (block (set (nth 0 u) (cast char (bitor 192 (>> cp 6))))
                   (set (nth 1 u) (cast char (bitor 128 (bitand cp 63))))
                   (return 2)))
        (if (< cp 65536)
            (block (set (nth 0 u) (cast char (bitor 224 (>> cp 12))))
                   (set (nth 1 u) (cast char (bitor 128 (bitand (>> cp 6) 63))))
                   (set (nth 2 u) (cast char (bitor 128 (bitand cp 63))))
                   (return 3)))
        (set (nth 0 u) (cast char (bitor 240 (>> cp 18))))
        (set (nth 1 u) (cast char (bitor 128 (bitand (>> cp 12) 63))))
        (set (nth 2 u) (cast char (bitor 128 (bitand (>> cp 6) 63))))
        (set (nth 3 u) (cast char (bitor 128 (bitand cp 63))))
        (return 4))

  ;;; Code point CP on the end of B, as `coco_utf8_enc' writes it; 0 for no
  ;;; character or no room.
  (func coco_utf8_put ((coco_strbuf * b) (i64 cp)) (out int)
        (let ((char u [4]) (int k . #'(coco_utf8_enc u cp)))
          (if (== k 0) (return 0))
          (return (coco_sb_put_len b u (cast size_t k)))))

  ;;; ---- a source file's encoding (3.58.0) ---------------------------------
  ;;;
  ;;; THE READER READS UTF-8, and a file in another of swipl's encodings is
  ;;; decoded into it as it is read: its BOM (`coco_source_text'), the
  ;;; encoding a load names (load_files/2's encoding(E)), and from where it
  ;;; stands the encoding a `:- encoding(E)' directive names, the rest of
  ;;; the text written back in the class it was read in (`coco_text_raw')
  ;;; and decoded again in E's (`coco_text_cook'). A NUL in a file is C0 80
  ;;; in the text, so the text is a C string still and a NUL byte no end of
  ;;; it -- the bytes after a UTF-16 directive hold one each other byte.

  ;;; THE CLASS OF AN ENCODING'S NAME (`*coco-encodings*'), -1 for a name
  ;;; swipl has not
  (func coco_enc_class ((const char * name)) (out int)
        (coco-enc-class-body name))

  ;;; A CHARACTER C onto OUT as the reader reads text: UTF-8, a NUL C0 80.
  ;;; 0 for no room.
  (static) (inline)
  (func coco_text_put_cp ((coco_strbuf * out) (i64 c)) (out int)
        (if (== c 0)
            (return (and (coco_sb_putc out (cast char 192)) (coco_sb_putc out (cast char 128)))))
        (return (coco_utf8_put out c)))

  ;;; RAW'S N BYTES DECODED IN CLASS CLS onto OUT, as the reader reads text.
  ;;; Class 0 keeps the bytes as they are (a byte that is no UTF-8 is read
  ;;; as U+DC00 plus it, `coco_utf8_get'); 1 makes each byte its character;
  ;;; 2 and 3 read UTF-16, a surrogate pair one character and a lone
  ;;; surrogate U+FFFD; 4 four bytes least first, past U+10FFFF or a
  ;;; surrogate U+FFFD. What is left at the end that makes no unit is
  ;;; dropped. 1, or 2 when it wrote a NUL (the reader's `nul'); 0 for no
  ;;; room.
  (func coco_text_cook ((const char * raw) (size_t n) (int cls) (coco_strbuf * out)) (out int)
        (let ((const uchar * u . #'(cast (const uchar *) raw)) (size_t i . 0) (i64 c . 0) (int z . 1))
          (while (< i n)
            (cond
              ((== cls 0)
               (set c (cast i64 (nth i u)))
               (set i (+ i 1))
               (if (!= c 0)
                   (block (if (not (coco_sb_putc out (cast char c))) (return 0))
                          continue)))
              ((== cls 1) (set c (cast i64 (nth i u))) (set i (+ i 1)))
              ((< cls 4)
               (if (> (+ i 2) n) break)
               (set c (coco-u16-at u i cls))
               (set i (+ i 2))
               (if (and (>= c 55296) (<= c 57343))
                   (let ((i64 lo . -1))
                     (if (and (<= c 56319) (<= (+ i 2) n)) (set lo (coco-u16-at u i cls)))
                     (if (and (>= lo 56320) (<= lo 57343))
                         (block (set c (+ 65536 (+ (<< (- c 55296) 10) (- lo 56320))))
                                (set i (+ i 2)))
                       (set c 65533)))))
              (#t
               (if (> (+ i 4) n) break)
               (set c (bitor (bitor (cast i64 (nth i u)) (<< (cast i64 (nth (+ i 1) u)) 8))
                             (bitor (<< (cast i64 (nth (+ i 2) u)) 16) (<< (cast i64 (nth (+ i 3) u)) 24))))
               (set i (+ i 4))
               (if (or (> c 1114111) (and (>= c 55296) (<= c 57343))) (set c 65533))))
            (if (== c 0) (set z 2))
            (if (not (coco_text_put_cp out c)) (return 0)))
          (return z)))

  ;;; THE BYTES A TEXT WAS DECODED FROM: S, as `coco_text_cook' made it in
  ;;; class CLS, written back in that class onto OUT -- what a later
  ;;; `:- encoding(E)' decodes again in its own. Class 0 is S's bytes, a C0
  ;;; 80 a NUL; 1 a byte a character (each such a text holds is one); 2 and
  ;;; 3 UTF-16, a character past U+FFFF its two surrogates; 4 four bytes a
  ;;; character, least first. 0 for no room.
  (func coco_text_raw ((const char * s) (int cls) (coco_strbuf * out)) (out int)
        (let ((size_t n . #'(strlen s)) (size_t i . 0) (i64 c . 0) (int ok . 1))
          (while (and ok (< i n))
            (if (and (== (cast uchar (nth i s)) 192)
                     (and (< (+ i 1) n) (== (cast uchar (nth (+ i 1) s)) 128)))
                (block (set c 0) (set i (+ i 2)))
              (if (== cls 0)
                  (block (set c (cast i64 (cast uchar (nth i s)))) (set i (+ i 1)))
                (set c (coco_utf8_get s n (aof i)))))
            (cond
              ((< cls 2) (set ok (coco_sb_putc out (cast char (bitand c 255)))))
              ((< cls 4)
               (if (> c 65535)
                   (let ((i64 v . #'(- c 65536)))
                     (set ok (and (coco-u16-put out (+ 55296 (>> v 10)) cls)
                                  (coco-u16-put out (+ 56320 (bitand v 1023)) cls))))
                 (set ok (coco-u16-put out c cls))))
              (#t
               (set ok (and (and (coco_sb_putc out (cast char (bitand c 255)))
                                 (coco_sb_putc out (cast char (bitand (>> c 8) 255))))
                            (and (coco_sb_putc out (cast char (bitand (>> c 16) 255)))
                                 (coco_sb_putc out (cast char (bitand (>> c 24) 255)))))))))
          (return ok)))

  ;;; A SOURCE FILE'S TEXT, as swipl's load opens one: its bytes, malloc'd,
  ;;; as the reader reads text (`coco_text_cook'), or nil when it cannot be
  ;;; read. A BOM is taken off -- EF BB BF UTF-8's, FE FF UTF-16
  ;;; big-endian's, FF FE little-endian's -- and names the class the file
  ;;; is read in, else UTF-8. ASK is what the load asks (a machine's
  ;;; `lenc'): 0 nothing, a class plus one -- the file read in that class
  ;;; whatever its BOM said, as swipl sets a stream's encoding after the
  ;;; open took the BOM off -- 6 `bom', which reads nothing of a file that
  ;;; has none (swipl's: that load's set_stream/2 fails), and 7 `default',
  ;;; which reads nothing (swipl's '$set_encoding' fails on it). *CLS is
  ;;; set to the class the text was decoded from, and 16 more where the
  ;;; text holds a NUL the file held (C0 80, which only such a text's
  ;;; reader asks of a quoted item, `coco-lex-quoted-loop'). UTF-8 with no
  ;;; NUL in it is the file's bytes as they are, the BOM moved off: no copy,
  ;;; and what every start reads its libraries by.
  (func coco_source_text ((const char * path) (int ask) (int * cls)) (out char *)
        (let ((FILE * f . #'(fopen path "rb")) (char * buf . nil) (long n . 0)
              (size_t skip . 0) (int bc . -1) (int c . 0) (coco_strbuf b))
          (set (cof cls) 0)
          (if (== f nil) (return nil))
          (fseek f 0 SEEK_END)
          (set n (ftell f))
          (fseek f 0 SEEK_SET)
          (if (< n 0) (block (fclose f) (return nil)))
          (set buf (cast (char *) (malloc (+ (cast size_t n) 1))))
          (if (== buf nil) (block (fclose f) (return nil)))
          (if (and (> n 0) (!= (cast size_t n) (fread buf 1 (cast size_t n) f)))
              (block (free buf) (fclose f) (return nil)))
          (set (nth (cast size_t n) buf) (cast char 0))
          (fclose f)
          (let ((const uchar * u . #'(cast (const uchar *) buf)))
            (cond
              ((and (>= n 3) (and (== (nth 0 u) 239) (and (== (nth 1 u) 187) (== (nth 2 u) 191))))
               (set bc 0) (set skip 3))
              ((and (>= n 2) (and (== (nth 0 u) 254) (== (nth 1 u) 255))) (set bc 2) (set skip 2))
              ((and (>= n 2) (and (== (nth 0 u) 255) (== (nth 1 u) 254))) (set bc 3) (set skip 2))))
          (cond
            ((== ask 7) (set c -1))
            ((== ask 6) (set c (? (< bc 0) -1 bc)))
            ((> ask 0) (set c (- ask 1)))
            (#t (set c (? (< bc 0) 0 bc))))
          ;; `bom' and no BOM, or `default': nothing
          (if (< c 0) (block (set (nth 0 buf) (cast char 0)) (return buf)))
          (set (cof cls) c)
          (if (and (== c 0) (== nil (memchr (+ buf skip) 0 (- (cast size_t n) skip))))
              (block (if (> skip 0) (memmove buf (+ buf skip) (+ (- (cast size_t n) skip) 1)))
                     (return buf)))
          (coco_sb_init (aof b))
          (let ((int k . #'(coco_text_cook (+ buf skip) (- (cast size_t n) skip) c (aof b))))
            (if (or (not k) (and (== ($ b s) nil) (not (coco_sb_putc (aof b) (cast char 0)))))
                (block (coco_sb_free (aof b)) (free buf) (return nil)))
            (if (== k 2) (set (cof cls) (bitor c 16))))
          (free buf)
          (return ($ b s))))

  ;;; TEXT AS A LIST, IN CHARACTERS (1.13.0): S's N bytes decoded, each
  ;;; character its code point -- or, AS_CHARS 1, the one-character atom of
  ;;; it -- in front of TAIL (`[]', or a difference list's tail): what
  ;;; atom_codes/2, atom_chars/2 and their kin answer under `text_units =
  ;;; characters'. Decoded front to back into a scratch array FIRST, so S
  ;;; may point into the atom table that the atoms made after can move;
  ;;; consed from the end, as a list is built.
  (func coco_text_list ((coco_machine * m) (const char * s) (size_t n) (int as_chars) (size_t tail)) (out size_t)
        (let ((i64 * cps . nil) (size_t k . 0) (size_t i . 0)
              (size_t lst . tail))
          (if (== n 0) (return lst))
          (set cps (cast (i64 *) (malloc (* n (sizeof i64)))))
          (if (== cps nil) (block (set (-> m oom) 1) (return lst)))
          (while (< i n)
            (set (nth k cps) (coco_utf8_get s n (aof i)))
            (set k (+ k 1)))
          (while (> k 0)
            (set k (- k 1))
            (if as_chars
                (let ((char one [8]) (int len . #'(coco_utf8_enc one (nth k cps))))
                  (set (nth len one) (cast char 0))
                  (set lst (coco_cons m (coco_new_atom m one) lst)))
                (set lst (coco_cons m (coco_new_int m (nth k cps)) lst))))
          (free cps)
          (return lst)))

  ;;; How many characters S's N bytes are, as `coco_utf8_get' reads them.
  (func coco_utf8_count ((const char * s) (size_t n)) (out size_t)
        (let ((size_t i . 0) (size_t c . 0))
          (while (< i n)
            (if (< (cast uchar (nth i s)) 128)
                (set i (+ i 1))
                (coco_utf8_get s n (aof i)))
            (set c (+ c 1)))
          (return c)))

  ;;; The byte S's character K begins at -- N when K is the count -- and
  ;;; (size_t)-1 past that.
  (func coco_utf8_at ((const char * s) (size_t n) (size_t k)) (out size_t)
        (let ((size_t i . 0))
          (while (and (> k 0) (< i n))
            (if (< (cast uchar (nth i s)) 128)
                (set i (+ i 1))
                (coco_utf8_get s n (aof i)))
            (set k (- k 1)))
          (return (? (== k 0) i (cast size_t -1)))))

  ;;; The code point of S when S is ONE character, and -1 when it is none
  ;;; or more than one: a character, to char_code/2 and atom_chars/2.
  (func coco_utf8_one ((const char * s)) (out i64)
        (let ((size_t n . #'(strlen s)) (size_t i . 0) (i64 c . 0))
          (if (== n 0) (return -1))
          (set c (coco_utf8_get s n (aof i)))
          (return (? (== i n) c -1))))

  ;;; THE OTHER CASE OF A CODE (1.13.0; every code point since 3.30.0):
  ;;; towupper() (UP 1) or towlower() as glibc's C.UTF-8 answers them and so
  ;;; swipl on Linux, from lib/swipl-ctype.cicili's tables -- WRITTEN OUT
  ;;; rather than asked of the C library, because its table moves with its
  ;;; locale and a program's meaning must not. Anything with no other case
  ;;; answers itself. Through 3.29.0 the scripts a program here was thought
  ;;; to meet, by hand, and the rest unchanged.
  (coco-ct-emit-case coco_uc_case)

  ;;; A CODE'S CLASSES (3.30.0): what code_type/2 reads, from the same tables
  (coco-ct-emit-flags coco_ct_flags)

  ;;; A CODE'S CLASSES TO THE READER AND THE WRITER (3.35.0): what pl-read.c's
  ;;; tokeniser and pl-write.c's quoting ask of a code past ASCII
  (coco-ct-emit-read coco_rd_flags)

  ;;; S's N bytes on the end of O with every letter in the other case (UP 1
  ;;; the capitals), a character at a time: upcase_atom/2 and its kin under
  ;;; `text_units = characters'. 0 for no room.
  (func coco_text_case ((const char * s) (size_t n) (int up) (coco_strbuf * o)) (out int)
        (let ((size_t i . 0))
          (while (< i n)
            (if (not (coco_utf8_put o (coco_uc_case (coco_utf8_get s n (aof i)) up)))
                (return 0)))
          (return 1)))

  ;;; THE SUM, THE DIFFERENCE AND THE PRODUCT IN 64 BITS (2.0.0; the rule
  ;;; is with the declarations, which a function always inlined has none of)
  (static) (inline)
  (func coco_add_ovf ((i64 a) (i64 b) (i64 * r)) (out int)
        (return (code "__builtin_add_overflow(a, b, r)")))

  (static) (inline)
  (func coco_sub_ovf ((i64 a) (i64 b) (i64 * r)) (out int)
        (return (code "__builtin_sub_overflow(a, b, r)")))

  (static) (inline)
  (func coco_mul_ovf ((i64 a) (i64 b) (i64 * r)) (out int)
        (return (code "__builtin_mul_overflow(a, b, r)")))

  ;;; THE TWO SHIFTS BY ANY COUNT (1.14.0; the declaration has the rule and
  ;;; why C alone does not give it). A negative count is the other
  ;;; direction's work. The left one is `coco_lsh', which both call for it
  ;;; (2.0.0): A by K places, 0 <= K, OVF set when a bit would be lost.
  (static) (inline)
  (func coco_lsh ((i64 a) (i64 k) (int * ovf)) (out i64)
        (if (== a 0) (return 0))
        (if (> k 63) (block (set (cof ovf) 1) (return 0)))
        (let ((i64 r . #'(cast i64 (<< (cast u64 a) (cast u64 k)))))
          (if (!= (>> r k) a) (block (set (cof ovf) 1) (return 0)))
          (return r)))

  (static)
  (func coco_shift_right ((i64 a) (i64 n) (int * ovf)) (out i64)
        (if (< n 0)
            (block
             ;; the other direction, past what it can keep: only 0 survives
             (if (< n -63) (return (coco_lsh a 64 ovf)))
             (return (coco_lsh a (- 0 n) ovf))))
        (if (> n 63) (return (? (< a 0) -1 0)))
        (return (>> a n)))

  (static)
  (func coco_shift_left ((i64 a) (i64 n) (int * ovf)) (out i64)
        (if (< n 0)
            (block
             ;; the other direction, where an arithmetic shift ends
             (if (< n -63) (return (? (< a 0) -1 0)))
             (return (>> a (- 0 n)))))
        (return (coco_lsh a n ovf)))

  ;;; The widest 64-bit integer is 20 characters and a sign, so 32 is room
  ;;; with the terminator and no arithmetic to get wrong.
  (func coco_sb_put_i64 ((coco_strbuf * b) (i64 v)) (out int)
        (let ((char tmp [32]))
          (snprintf tmp (sizeof tmp) "%lld" (cast llong v))
          (return (coco_sb_put b tmp))))

  ;;; THE NEIGHBOUR OF THE ROUNDED FORM, at the same number of digits: TMP,
  ;;; [-]d.ddde+-X, moved one in its last digit towards V (DIR 1 up, -1
  ;;; down, so a negative TMP's digits move the other way) and kept if it
  ;;; reads back as V. A power of two has a gap below
  ;;; it half the width of the gap above, so the decimal nearest it can fall
  ;;; outside its interval while the next one up is inside: 0x1p-549 is
  ;;; 5.426657103235053e-166, SWI's 16 digits, which %.15e rounds to ...052,
  ;;; a different double. Without this the writer wrote 17 digits there (34
  ;;; of 21,000 doubles of a run, every one a power of two).
  (static)
  (func coco_float_nudge ((char * tmp) (size_t cap) (int dir) (double v)) (out int)
        (let ((char dg [24]) (int nd . 0) (int i . 0) (int neg . 0) (int ex . 0) (int k . 0) (int o . 0))
          (if (== (nth 0 tmp) 45) (block (set neg 1) (set i 1) (set dir (- 0 dir))))
          (while (!= (nth i tmp) 101)
            (if (!= (nth i tmp) 46) (block (set (nth nd dg) (nth i tmp)) (++ nd)))
            (++ i))
          (set ex (cast int (strtol (+ tmp (+ i 1)) nil 10)))
          (set k (- nd 1))
          (if (> dir 0)
              (block
                (while (and (>= k 0) (== (nth k dg) 57)) (set (nth k dg) 48) (-- k))
                (if (< k 0)
                    (block (set (nth 0 dg) 49) (set ex (+ ex 1)))
                    (set (nth k dg) (cast char (+ (nth k dg) 1)))))
              (block
                (while (and (>= k 0) (== (nth k dg) 48)) (set (nth k dg) 57) (-- k))
                (if (>= k 0) (set (nth k dg) (cast char (- (nth k dg) 1))))
                ;; 1.000e+X down is 9.999e+(X-1): below a power of ten the step is finer
                (if (== (nth 0 dg) 48)
                    (block
                      (for ((int j . 0)) (< j nd) ((++ j)) (set (nth j dg) 57))
                      (set ex (- ex 1))))))
          (if neg (block (set (nth o tmp) 45) (++ o)))
          (set (nth o tmp) (nth 0 dg)) (++ o)
          (if (> nd 1)
              (block
                (set (nth o tmp) 46) (++ o)
                (for ((int j . 1)) (< j nd) ((++ j)) (block (set (nth o tmp) (nth j dg)) (++ o)))))
          (snprintf (+ tmp o) (- cap (cast size_t o)) "e%d" ex)
          (return (== (strtod tmp nil) v))))

  ;;; A FLOAT IS WRITTEN AS SWI-PROLOG 9 WRITES IT (1.10.28): the fewest
  ;;; significant digits that read back as the same double, bit for bit,
  ;;; set out as its format_float sets them -- 0.30000000000000004 for
  ;;; 0.1+0.2, 1.0e+22, 1.0e-5, 1234567890123456.8, 100000000000000.0 --
  ;;; and an infinity 1.0Inf or -1.0Inf, a NaN 1.5NaN. Through 1.10.27 it
  ;;; was %.15g with a ".0" put back: 0.3 for 0.1+0.2, which reads back as
  ;;; another number, so a float did not survive the text of the store, a
  ;;; channel or term_to_atom/2; 1e+22 and 1e-05 where SWI writes 1.0e+22
  ;;; and 1.0e-5; and an infinity inf.0 (reported from cicili-lang). Only
  ;;; the journal wrote exactly (its `wexact', now gone): every write does.
  ;;;
  ;;; THE DIGITS. A normal double is told from its neighbours by 15
  ;;; significant digits -- half the step of a 15-digit decimal is wider
  ;;; than half an ulp -- so %.14e with its trailing zeros dropped IS the
  ;;; shortest form whenever one of 15 digits or fewer reads back, and 16,
  ;;; then 17, are tried when none does (17 always does). A subnormal holds
  ;;; fewer digits of its own: its search starts at one (5.0e-324 is the
  ;;; smallest). THE LAYOUT is SWI's: with DP where the point falls after
  ;;; the first digit (the exponent plus one), a point at or before the
  ;;; digits is 0.000ddd down to DP -3 and d.ddde-N below; a point inside
  ;;; them is written there; a point after them is the digits, their zeros
  ;;; and ".0" up to DP 15, d.ddde+N past it. 45 46 48 101 are '-', '.',
  ;;; '0' and 'e': Cicili's reader carries no character literal.
  (func coco_sb_put_double ((coco_strbuf * b) (double v)) (out int)
        (let ((char tmp [48]) (char out [64]) (char dig [24])
              (int nd . 0) (int ex . 0) (int p . 15) (int i . 0) (int o . 0) (int dp . 0))
          (if (!= v v) (return (coco_sb_put b "1.5NaN")))
          (if (!= (- v v) 0.0) (return (coco_sb_put b (? (< v 0.0) "-1.0Inf" "1.0Inf"))))
          ;; |v| by hand: a binary built from this file alone has no <math.h>
          (if (< (? (< v 0.0) (- v) v) 2.2250738585072014e-308) (set p 1))
          (while (< p 17)
            (snprintf tmp (sizeof tmp) "%.*e" (- p 1) v)
            (let ((double w . #'(strtod tmp nil)))
              (if (== w v) break)
              (if (coco_float_nudge tmp (sizeof tmp) (? (< w v) 1 -1) v) break))
            (set p (+ p 1)))
          (if (== p 17) (snprintf tmp (sizeof tmp) "%.16e" v))
          ;; [-]d[.ddd]e(+|-)XX: the sign, the digits without the point, the
          ;; exponent; then the trailing zeros off the digits
          (if (== (nth 0 tmp) 45) (block (set (nth o out) 45) (++ o) (++ i)))
          (while (!= (nth i tmp) 101)
            (if (!= (nth i tmp) 46) (block (set (nth nd dig) (nth i tmp)) (++ nd)))
            (++ i))
          (set ex (cast int (strtol (+ tmp (+ i 1)) nil 10)))
          (while (and (> nd 1) (== (nth (- nd 1) dig) 48)) (-- nd))
          (set dp (+ ex 1))
          (cond
            ((and (<= dp 0) (> dp -4))
             (block
               (set (nth o out) 48) (++ o) (set (nth o out) 46) (++ o)
               (for ((int k . 0)) (< k (- 0 dp)) ((++ k)) (block (set (nth o out) 48) (++ o)))
               (for ((int k . 0)) (< k nd) ((++ k)) (block (set (nth o out) (nth k dig)) (++ o)))))
            ((and (> dp 0) (> nd dp))
             (block
               (for ((int k . 0)) (< k dp) ((++ k)) (block (set (nth o out) (nth k dig)) (++ o)))
               (set (nth o out) 46) (++ o)
               (for ((int k . #'dp)) (< k nd) ((++ k)) (block (set (nth o out) (nth k dig)) (++ o)))))
            ((and (> dp 0) (<= dp 15))
             (block
               (for ((int k . 0)) (< k nd) ((++ k)) (block (set (nth o out) (nth k dig)) (++ o)))
               (for ((int k . #'nd)) (< k dp) ((++ k)) (block (set (nth o out) 48) (++ o)))
               (set (nth o out) 46) (++ o) (set (nth o out) 48) (++ o)))
            (#t
             (block
               (set (nth o out) (nth 0 dig)) (++ o) (set (nth o out) 46) (++ o)
               (if (> nd 1)
                   (for ((int k . 1)) (< k nd) ((++ k)) (block (set (nth o out) (nth k dig)) (++ o)))
                   (block (set (nth o out) 48) (++ o)))
               (set o (+ o (snprintf (+ out o) (- (sizeof out) (cast size_t o)) "e%+d" (- dp 1)))))))
          (set (nth o out) (cast char 0))
          (return (coco_sb_put b out))))

  ;;; ---- names --------------------------------------------------------

  ;;; Rehash into a table of twice the size. Called only when the table is half
  ;;; full, so the probe below stays short.
  (static)
  (func coco_atoms_rehash ((coco_machine * m)) (out int)
        (let ((size_t ncap . #'(* (-> m atom_bucket_cap) 2))
              (size_t * nb . #'(cast (size_t *) (calloc ncap (sizeof size_t)))))
          (if (== nb nil) (block (set (-> m oom) 1) (return 0)))
          (for ((size_t i . 0)) (< i (-> m atoms_len)) ((++ i))
            (let ((size_t j . #'(cast size_t (bitand ($ (nth i (-> m atoms)) hash)
                                                     (cast u64 (- ncap 1))))))
              (while (!= (nth j nb) 0)
                (set j (bitand (+ j 1) (- ncap 1))))
              (set (nth j nb) (+ i 1))))
          (free (-> m atom_buckets))
          (set (-> m atom_buckets) nb)
          (set (-> m atom_bucket_cap) ncap)
          (return 1)))

  ;;; THE NAME, UNDER HASH H: every intern's, and the atom `'[]'''s under
  ;;; the name's hash with its lowest bit turned (`coco_intern_tnil').
  (static) (inline)
  (func coco_intern_h ((coco_machine * m) (const char * name) (size_t len) (u64 h)) (out u64)
        ;; THE HIT IS LOCK-FREE (2.9.2). Most interns are of a name already
        ;; in the table -- the goal text read for every spawned task, a
        ;; repeated functor -- and each one took the world names mutex AND
        ;; PUBLISHED at the end, which moved the generation and made every
        ;; other machine resync for its next run. That pair was the light
        ;; lane's 3.6x. The probe reads the arrays this machine synced; while
        ;; the tables are shared a growth never frees an old array, so a
        ;; probe one generation behind is sound. A miss takes the lock,
        ;; syncs, and looks AGAIN: another thread may have appended the name
        ;; meanwhile (the double-checked lock the predicate table needed).
        (coco_tbl_sync m)
        (block
          (let ((size_t fj . #'(cast size_t (bitand h (cast u64 (- (-> m atom_bucket_cap) 1))))))
            (while (!= (nth fj (-> m atom_buckets)) 0)
              (let ((size_t fid . #'(- (nth fj (-> m atom_buckets)) 1)))
                (if (and (== ($ (nth fid (-> m atoms)) hash) h)
                         (and (== ($ (nth fid (-> m atoms)) len) len)
                              (== (memcmp ($ (nth fid (-> m atoms)) name) name len) 0)))
                    (return (cast u64 fid))))
              (set fj (bitand (+ fj 1) (- (-> m atom_bucket_cap) 1)))))
          (coco_tbl_begin m)
          (let ((size_t j . #'(cast size_t (bitand h (cast u64 (- (-> m atom_bucket_cap) 1))))))
            ;; probe again: an occupied slot whose hash and bytes both match
            ;; is the one
            (while (!= (nth j (-> m atom_buckets)) 0)
              (let ((size_t id . #'(- (nth j (-> m atom_buckets)) 1)))
                (if (and (== ($ (nth id (-> m atoms)) hash) h)
                         (and (== ($ (nth id (-> m atoms)) len) len)
                              (== (memcmp ($ (nth id (-> m atoms)) name) name len) 0)))
                    (block (coco_tbl_done m) (return (cast u64 id)))))
              (set j (bitand (+ j 1) (- (-> m atom_bucket_cap) 1))))
            ;; not there: append it
            (if (not (coco_tbl_grow m (cast (void **) (aof (-> m atoms)))
                              (aof (-> m atoms_cap)) (+ (-> m atoms_len) 1)
                              (sizeof coco_atom)))
                (block (coco_tbl_end m) (return 0)))
            (let ((char * copy . #'(cast (char *) (malloc (+ len 1)))))
              (if (== copy nil) (block (set (-> m oom) 1) (coco_tbl_end m) (return 0)))
              (memcpy copy name len)
              (set (nth len copy) (cast char 0))
              (let ((size_t id . #'(-> m atoms_len)))
                (set ($ (nth id (-> m atoms)) name) copy)
                (set ($ (nth id (-> m atoms)) len)  len)
                (set ($ (nth id (-> m atoms)) hash) h)
                (set (-> m atoms_len) (+ id 1))
                (set (nth j (-> m atom_buckets)) (+ id 1))
                ;; keep the table under half full, so probes stay short
                (if (>= (* (-> m atoms_len) 2) (-> m atom_bucket_cap))
                    (coco_atoms_rehash m))
                (coco_tbl_end m)
                (return (cast u64 id)))))))

  (func coco_intern_len ((coco_machine * m) (const char * name) (size_t len)) (out u64)
        (return (coco_intern_h m name len (coco_hash name len))))

  (func coco_intern ((coco_machine * m) (const char * name)) (out u64)
        (return (coco_intern_len m name (strlen name))))

  (func coco_atom_name ((coco_machine * m) (u64 id)) (out const char *)
        (if (>= (cast size_t id) (-> m atoms_len)) (return "<bad-atom>"))
        (return ($ (nth (cast size_t id) (-> m atoms)) name)))

  ;;; THE EMPTY LIST IS NO ATOM, AND `'[]'' IS NOT IT (3.0.0, swipl 7's).
  ;;; `[]' is the list's end, which atom/1 denies and the standard order
  ;;; puts before every atom; `'[]'' is the atom whose text is those two
  ;;; characters -- what a quoted `'[]'' reads as and what any text "[]" is
  ;;; made into (atom_codes(A, "[]"), format(atom(A), '~w', [[]])). Through
  ;;; 2.16 they were one atom, and `[] == '[]'' held. Both have the name
  ;;; "[]": the list's end is the table's entry for the name, as it always
  ;;; was, and the atom a second entry of the same two bytes, filed under
  ;;; the name's hash with its lowest bit turned, so no lookup of the name
  ;;; finds it; it is made the first time it is asked for, and a program
  ;;; that never names it interns what it always did. The two are told
  ;;; apart BY ID, never by name: a new test for the list's end asks
  ;;; `coco_is_nil' (or `coco_nil_id'), not strcmp with "[]".
  (func coco_nil_id ((coco_machine * m)) (out u64)
        (if (!= (-> m nilid1) 0) (return (- (-> m nilid1) 1)))
        (let ((u64 id . #'(coco_intern_len m "[]" 2)))
          (set (-> m nilid1) (+ id 1))
          (return id)))

  (func coco_intern_tnil ((coco_machine * m)) (out u64)
        (return (coco_intern_h m "[]" 2 (xor (coco_hash "[]" 2) 1))))

  (func coco_atom_is_tnil ((coco_machine * m) (u64 id)) (out int)
        (if (>= (cast size_t id) (-> m atoms_len)) (return 0))
        (let ((const char * s . #'($ (nth (cast size_t id) (-> m atoms)) name)))
          (return (and (== ($ (nth (cast size_t id) (-> m atoms)) len) 2)
                       (and (== (nth 0 s) (cast char 91))
                            (and (== (nth 1 s) (cast char 93))
                                 (!= id (coco_nil_id m))))))))

  (func coco_new_nil ((coco_machine * m)) (out size_t)
        (return (coco_push m (coco-cell ATOM (coco_nil_id m)))))

  ;;; Whether the cell at H (dereferenced) is the list's end: one word.
  (func coco_is_nil ((coco_machine * m) (size_t h)) (out int)
        (return (== (nth h (-> m heap)) (coco-cell ATOM (coco_nil_id m)))))

  ;;; A NAME AND AN ARITY AS ONE WORD. An atom id is small and sequential, so
  ;;; the multiply is what spreads it -- by the FNV prime the first-argument
  ;;; index uses, which fits a plain literal where FNV's offset basis does not
  ;;; (see `coco_hash') -- and the shift folds the high bits it spread down
  ;;; into the low ones a mask keeps.
  (func coco_name_arity_hash ((u64 name) (u32 arity)) (out u64)
        (let ((u64 h . #'(* (+ (* name 64) (cast u64 arity)) 1099511628211)))
          (return (xor h (>> h 29)))))

  ;;; The functor table at twice the size, or at 256 the first time. Every
  ;;; entry is put back from the functor array itself, which is the truth;
  ;;; the table is only how to find it.
  (static)
  (func coco_functors_rehash ((coco_machine * m)) (out int)
        (let ((size_t ncap . #'(? (== (-> m functor_bucket_cap) 0) 256
                                  (* (-> m functor_bucket_cap) 2)))
              (size_t * nb . #'(cast (size_t *) (calloc ncap (sizeof size_t)))))
          (if (== nb nil) (block (set (-> m oom) 1) (return 0)))
          (for ((size_t i . 0)) (< i (-> m functors_len)) ((++ i))
            (let ((size_t j . #'(cast size_t
                                      (bitand (coco_name_arity_hash ($ (nth i (-> m functors)) name)
                                                                    ($ (nth i (-> m functors)) arity))
                                              (cast u64 (- ncap 1))))))
              (while (!= (nth j nb) 0)
                (set j (bitand (+ j 1) (- ncap 1))))
              (set (nth j nb) (+ i 1))))
          (free (-> m functor_buckets))
          (set (-> m functor_buckets) nb)
          (set (-> m functor_bucket_cap) ncap)
          (return 1)))

  (func coco_functor_id ((coco_machine * m) (u64 name) (u32 arity)) (out u64)
        (coco_tbl_begin m)
        ;; HASHED. It was a scan, on the argument that a program has tens of
        ;; functors and not thousands -- and the reasoning library has two
        ;; thousand once it is loaded, so the scan was a quarter of every
        ;; instruction the translator ran, and every functor a library added
        ;; was paid for by every lookup after it (CLAUDE.md, 1.8.31 and
        ;; 1.8.32). The table is the atom table's shape -- open addressing, an
        ;; entry is its id plus one -- and it is kept under half full, which
        ;; is checked BEFORE the probe: so the probe ends at an empty slot even
        ;; when the rehash has failed for want of memory.
        (if (> (* (+ (-> m functors_len) 1) 2) (-> m functor_bucket_cap))
            (if (not (coco_functors_rehash m))
                (block (coco_tbl_end m) (return 0))))
        (coco_tupdate m)
        (let ((size_t mask . #'(- (-> m functor_bucket_cap) 1))
              (size_t j . 0))
          (set j (cast size_t (bitand (coco_name_arity_hash name arity) (cast u64 mask))))
          (while (!= (nth j (-> m functor_buckets)) 0)
            (let ((size_t id . #'(- (nth j (-> m functor_buckets)) 1)))
              (if (and (== ($ (nth id (-> m functors)) name) name)
                       (== ($ (nth id (-> m functors)) arity) arity))
                  (block (coco_tbl_end m) (return (cast u64 id)))))
            (set j (bitand (+ j 1) mask)))
          (if (not (coco_tbl_grow m (cast (void **) (aof (-> m functors)))
                            (aof (-> m functors_cap)) (+ (-> m functors_len) 1)
                            (sizeof coco_functor)))
              (block (coco_tbl_end m) (return 0)))
          (let ((size_t id . #'(-> m functors_len)))
            (set ($ (nth id (-> m functors)) name) name)
            (set ($ (nth id (-> m functors)) arity) arity)
            (set ($ (nth id (-> m functors)) dmod) -1)
            (set ($ (nth id (-> m functors)) dgen) 0)
            (set ($ (nth id (-> m functors)) bix) 0)
            (set ($ (nth id (-> m functors)) pst) nil)
            (set ($ (nth id (-> m functors)) pserial) 0)
            (set ($ (nth id (-> m functors)) pidx) 0)
            (set ($ (nth id (-> m functors)) fgen) 0)
            (set ($ (nth id (-> m functors)) ectx) 0)
            (set (-> m functors_len) (+ id 1))
            (set (nth j (-> m functor_buckets)) (+ id 1))
            (coco_tbl_end m)
            (return (cast u64 id)))))

  ;;; ---- heap ---------------------------------------------------------

  (func coco_push ((coco_machine * m) (u64 c)) (out size_t)
        (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                          (aof (-> m heap_cap)) (+ (-> m heap_len) 1)
                          (sizeof u64)))
            (return 0))
        (set (nth (-> m heap_len) (-> m heap)) c)
        (set (-> m heap_len) (+ (-> m heap_len) 1))
        (return (- (-> m heap_len) 1)))

  ;;; A fresh variable is a REF pointing at itself. Its index is not known
  ;;; until it has been pushed, so it is pushed as 0 and then written -- which
  ;;; is also why this cannot be a macro over `coco_push'.
  (func coco_new_var ((coco_machine * m)) (out size_t)
        (let ((size_t i . #'(coco_push m 0)))
          (set (nth i (-> m heap)) (coco-cell REF i))
          (return i)))

  (func coco_push_struct_raw ((coco_machine * m) (u64 c) (u32 n)) (out size_t)
        (let ((size_t h . #'(-> m heap_len)))
          (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                            (aof (-> m heap_cap)) (+ h (+ (cast size_t n) 1))
                            (sizeof u64)))
              (return 0))
          (set (nth h (-> m heap)) c)
          (set (-> m heap_len) (+ h (+ (cast size_t n) 1)))
          (return h)))

  (func coco_push_struct ((coco_machine * m) (u64 c) (u32 n)) (out size_t)
        (let ((size_t h . #'(-> m heap_len)))
          (if (not (coco_grow m (cast (void **) (aof (-> m heap)))
                            (aof (-> m heap_cap)) (+ h (+ (cast size_t n) 1))
                            (sizeof u64)))
              (return 0))
          (set (nth h (-> m heap)) c)
          (for ((size_t i . #'(+ h 1))) (<= i (+ h (cast size_t n))) ((++ i))
            (set (nth i (-> m heap)) (coco-cell REF i)))
          (set (-> m heap_len) (+ h (+ (cast size_t n) 1)))
          (return h)))

  ;;; AN ATOM OF THIS TEXT: "[]" is the atom `'[]'', as swipl's
  ;;; PL_new_atom("[]") is (3.0.0) -- the list's end is `coco_new_nil'.
  (func coco_new_atom ((coco_machine * m) (const char * name)) (out size_t)
        (if (and (== (nth 0 name) (cast char 91))
                 (and (== (nth 1 name) (cast char 93)) (== (nth 2 name) (cast char 0))))
            (return (coco_push m (coco-cell ATOM (coco_intern_tnil m)))))
        (return (coco_push m (coco-cell ATOM (coco_intern m name)))))

  (func coco_new_text_atom ((coco_machine * m) (const char * s) (size_t n)) (out size_t)
        (if (and (== n 2) (and (== (nth 0 s) (cast char 91)) (== (nth 1 s) (cast char 93))))
            (return (coco_push m (coco-cell ATOM (coco_intern_tnil m)))))
        (return (coco_push m (coco-cell ATOM (coco_intern_len m s n)))))

  ;;; An entry made: counted toward the next reclamation. At `treq' a
  ;;; collection is asked for, so a loop that makes floats or strings and
  ;;; little heap still reaches one -- but only once the entries made reach
  ;;; half the heap's length, the rule the reclamation waits for: a
  ;;; collection costs the heap, and lesson 46 paid 3 % for one asked when
  ;;; its heap was large and 65536 strings were made. `treq' moves on
  ;;; whether or not the collection is asked for, so the question is asked
  ;;; once per `tlimit' entries, not at every one.
  (static)
  (func coco_table_made ((coco_machine * m))
        (set (-> m tmade) (+ (-> m tmade) 1))
        (if (>= (-> m tmade) (-> m treq))
            (block
             (if (>= (-> m tmade) (>> (-> m heap_len) 1)) (set (-> m gc_next) 0))
             (set (-> m treq) (+ (-> m tmade) (-> m tlimit))))))

  ;;; A STRING CELL FROM BYTES. The bytes are COPIED: the caller's buffer is
  ;;; usually a scratch array on a C stack frame that is about to go, and a
  ;;; term that outlived its text would be the worst kind of bug to find.
  (func coco_new_string ((coco_machine * m) (const char * p) (size_t n)) (out size_t)
        (coco_tbl_begin m)
        (let ((char * copy) (size_t i))
          ;; ONE BYTE MORE THAN THE LENGTH, and it is not the length that uses
          ;; it: the extra NUL lets coco_string_text hand the bytes to C code
          ;; that wants a C string, for the strings that do not contain one.
          (set copy (cast (char *) (malloc (+ n 1))))
          (if (== copy nil) (block (set (-> m oom) 1) (coco_tbl_end m) (return 0)))
          (if (> n 0) (memcpy copy p n))
          (set (nth n copy) (cast char 0))
          (if (> (-> m nsfree) 0)
              (block
               (set (-> m nsfree) (- (-> m nsfree) 1))
               (set i (nth (-> m nsfree) (-> m sfree))))
            (block
             (if (not (coco_tbl_grow m (cast (void **) (aof (-> m strings)))
                               (aof (-> m strings_cap)) (+ (-> m strings_len) 1)
                               (sizeof coco_str)))
                 (block (free copy) (coco_tbl_end m) (return 0)))
             (set i (-> m strings_len))
             (set (-> m strings_len) (+ (-> m strings_len) 1))))
          (set ($ (nth i (-> m strings)) p) copy)
          (set ($ (nth i (-> m strings)) n) n)
          (coco_table_made m)
          (coco_tbl_end m)
          (return (coco_push m (coco-cell STR i)))))

  (func coco_is_string ((coco_machine * m) (size_t t)) (out int)
        (return (? (coco-tag-is STR (nth (coco_deref m t) (-> m heap))) 1 0)))

  ;;; The bytes and the length of a STRING cell. Fails (answers 0) for
  ;;; anything else, so a caller cannot read a float's payload as a pointer.
  (func coco_string_text ((coco_machine * m) (size_t t)
                          (const char ** p) (size_t * n))
        (out int)
        (let ((size_t d . #'(coco_deref m t)) (u64 c))
          (set c (nth d (-> m heap)))
          (if (not (coco-tag-is STR c)) (return 0))
          (let ((size_t i . #'(cast size_t (coco-payload c))))
            (set (cof p) ($ (nth i (-> m strings)) p))
            (set (cof n) ($ (nth i (-> m strings)) n))
            (return 1))))

  (func coco_new_float ((coco_machine * m) (double v)) (out size_t)
        (coco_tbl_begin m)
        (let ((size_t i))
          (if (> (-> m nffree) 0)
              (block
               (set (-> m nffree) (- (-> m nffree) 1))
               (set i (nth (-> m nffree) (-> m ffree))))
            (block
             (if (not (coco_tbl_grow m (cast (void **) (aof (-> m floats)))
                               (aof (-> m floats_cap)) (+ (-> m floats_len) 1)
                               (sizeof double)))
                 (block (coco_tbl_end m) (return 0)))
             (set i (-> m floats_len))
             (set (-> m floats_len) (+ (-> m floats_len) 1))))
          (set (nth i (-> m floats)) v)
          (coco_table_made m)
          (coco_tbl_end m)
          (return (coco_push m (coco-cell FLT i)))))

  ;;; AN ENTRY OF THE INTEGER TABLE (2.0.0) holding V, a free one first as
  ;;; a float takes its own; (size_t) -1 when the table cannot grow. The
  ;;; thaw fills the table this way, with no cell for each entry.
  (func coco_big_entry ((coco_machine * m) (i64 v)) (out size_t)
        (coco_tbl_begin m)
        (let ((size_t i))
          (if (> (-> m nbfree) 0)
              (block
               (set (-> m nbfree) (- (-> m nbfree) 1))
               (set i (nth (-> m nbfree) (-> m bfree))))
            (block
             (if (not (coco_tbl_grow m (cast (void **) (aof (-> m bigs)))
                               (aof (-> m bigs_cap)) (+ (-> m bigs_len) 1)
                               (sizeof i64)))
                 (block (coco_tbl_end m) (return (cast size_t -1))))
             (set i (-> m bigs_len))
             (set (-> m bigs_len) (+ (-> m bigs_len) 1))))
          (set (nth i (-> m bigs)) v)
          (coco_table_made m)
          (coco_tbl_end m)
          (return i)))

  ;;; AN INTEGER NO INT HOLDS, as a BIG cell (2.0.0). Out of line and weak,
  ;;; so that `coco_new_int' -- every integer the engine makes -- pays one
  ;;; test for it and keeps its push inline.
  (weak)
  (func coco_new_big ((coco_machine * m) (i64 v)) (out size_t)
        (let ((size_t i . #'(coco_big_entry m v)))
          (if (== i (cast size_t -1)) (return 0))
          (return (coco_push m (coco-cell BIG i)))))

  ;;; ANY 64-BIT INTEGER AS A TERM (2.0.0): in the cell when the 60 bits an
  ;;; INT keeps hold it, boxed otherwise -- canonical by range, which is
  ;;; what lets unification compare two INTs as words.
  (func coco_new_int ((coco_machine * m) (i64 v)) (out size_t)
        (if (coco-fits-cell v) (return (coco_push m (coco-int-cell v))))
        (return (coco_new_big m v)))

  ;;; THE VALUE OF AN INTEGER CELL C (2.0.0), of either kind: an INT's
  ;;; payload, or the entry a BIG names. C is one of the two.
  (static) (inline)
  (func coco_int_val ((coco_machine * m) (u64 c)) (out i64)
        (if (coco-tag-is INT c) (return (coco-signed-payload c)))
        (return (nth (cast size_t (coco-payload c)) (-> m bigs))))

  ;;; ---- rational numbers (2.5.0) ----------------------------------------
  ;;;
  ;;; N/D in lowest terms, D > 0, and D = 1 is never a RAT: SWI's canonical
  ;;; form, which is what makes `1r2 == 2r4' and what makes `1r1' the
  ;;; integer 1. Both fit 64 bits; a value past them fails here and the
  ;;; arithmetic raises `evaluation_error(int_overflow)' where SWI bignums.

  (static)
  (func coco_rat_gcd ((u64 a) (u64 b)) (out u64)
        (while (!= b 0)
          (let ((u64 t . b))
            (set b (% a b))
            (set a t)))
        (return a))

  ;;; N and D reduced in place. 0 when D is zero or a sign change would step
  ;;; outside 64 bits (only D = -2^63, or N = -2^63 under it).
  (static)
  (func coco_rat_reduce ((i64 * n) (i64 * d)) (out int)
        (if (== (cof d) 0) (return 0))
        (if (< (cof d) 0)
            (block
             (if (== (cof d) (- -9223372036854775807 1)) (return 0))
             (if (== (cof n) (- -9223372036854775807 1)) (return 0))
             (set (cof n) (- 0 (cof n)))
             (set (cof d) (- 0 (cof d)))))
        (let ((u64 a . #'(cast u64 (cof n)))
              (u64 b . #'(cast u64 (cof d)))
              (u64 g . 0))
          (if (< (cof n) 0) (set a (- 0 a)))
          (set g (coco_rat_gcd a b))
          (set (cof n) (/ (cof n) (cast i64 g)))
          (set (cof d) (/ (cof d) (cast i64 g)))
          (return 1)))

  ;;; AN ENTRY OF THE RATIONAL TABLE, a free one first as a float takes its
  ;;; own; (size_t) -1 when the table cannot grow.
  (func coco_rat_entry ((coco_machine * m) (i64 n) (i64 d)) (out size_t)
        (coco_tbl_begin m)
        (let ((size_t i))
          (if (> (-> m nrfree) 0)
              (block
               (set (-> m nrfree) (- (-> m nrfree) 1))
               (set i (nth (-> m nrfree) (-> m rfree))))
            (block
             (if (not (coco_tbl_grow m (cast (void **) (aof (-> m rats)))
                               (aof (-> m rats_cap)) (+ (-> m rats_len) 1)
                               (sizeof coco_rat)))
                 (block (coco_tbl_end m) (return (cast size_t -1))))
             (set i (-> m rats_len))
             (set (-> m rats_len) (+ (-> m rats_len) 1))))
          (set ($ (nth i (-> m rats)) n) n)
          (set ($ (nth i (-> m rats)) d) d)
          (coco_table_made m)
          (coco_tbl_end m)
          (return i)))

  ;;; N/D AS A TERM (2.5.0): an integer when the denominator is 1, else a
  ;;; RAT cell. Answers (size_t) -1 when the pair is not representable in 64
  ;;; bits or the table cannot grow -- 0 is a heap cell like any other -- and
  ;;; the caller raises (int_overflow or memory).
  (func coco_new_rat ((coco_machine * m) (i64 n) (i64 d)) (out size_t)
        (let ((i64 nn . n) (i64 dd . d))
          (if (not (coco_rat_reduce (aof nn) (aof dd)))
              (return (cast size_t -1)))
          (if (== dd 1) (return (coco_new_int m nn)))
          (let ((size_t i . #'(coco_rat_entry m nn dd)))
            (if (== i (cast size_t -1)) (return (cast size_t -1)))
            (return (coco_push m (coco-rat-cell i))))))

  ;;; THE NUMERATOR AND DENOMINATOR A RAT CELL NAMES.
  (static) (inline)
  (func coco_rat_nd ((coco_machine * m) (u64 c) (i64 * n) (i64 * d)) (out void)
        (let ((size_t i . #'(coco-rat-index c)))
          (set (cof n) ($ (nth i (-> m rats)) n))
          (set (cof d) ($ (nth i (-> m rats)) d))))

  ;;; TWO RAT CELLS ARE ONE TERM WHEN THEIR PAIRS ARE (reduced at the entry,
  ;;; so the pair IS the value, as a float's bits are its identity).
  (func coco_rat_eq ((coco_machine * m) (u64 ca) (u64 cb)) (out int)
        (let ((size_t ia . #'(coco-rat-index ca))
              (size_t ib . #'(coco-rat-index cb)))
          (return (? (and (== ($ (nth ia (-> m rats)) n) ($ (nth ib (-> m rats)) n))
                          (== ($ (nth ia (-> m rats)) d) ($ (nth ib (-> m rats)) d)))
                     1 0))))

  ;;; THE EXACT RATIONAL A DOUBLE IS (SWI's `rational/1'), by its bits and
  ;;; without <math.h>: value = mant * 2^E, E from the exponent field, the
  ;;; mantissa stripped of its trailing zeros, then shifted into N and D.
  ;;; 0 when N or D would not fit i64 (a NaN or an infinity included), which
  ;;; is where SWI bignums and the caller raises int_overflow, or falls back
  ;;; to comparing doubles.
  (static)
  (func coco_double_rat ((double x) (i64 * n) (i64 * d)) (out int)
        (let ((i64 bits . 0) (int neg . 0) (int ex . 0) (u64 man . 0)
              (i64 e2 . 0) (i64 nn . 0) (i64 dd . 1) (i64 lim . 9223372036854775807))
          (memcpy (aof bits) (aof x) (sizeof double))
          (set neg (? (< bits 0) 1 0))
          (set ex (cast int (bitand (>> (cast u64 bits) 52) 2047)))
          (set man (bitand (cast u64 bits) 4503599627370495))
          (if (== ex 2047) (return 0))
          (if (== ex 0)
              (block
               ;; subnormal: man * 2^-1074
               (if (== man 0) (block (set (cof n) 0) (set (cof d) 1) (return 1)))
               (set e2 -1074))
            (block
             ;; normal: (2^52 + man) * 2^(ex - 1075)
             (set man (+ man 4503599627370496))
             (set e2 (cast i64 (- ex 1075)))))
          ;; strip the trailing zeros, so N and D are coprime from here
          (while (and (> man 0) (== 0 (bitand man 1)))
            (set man (>> man 1))
            (set e2 (+ e2 1)))
          (if (>= e2 0)
              (block
               (if (> e2 62) (return 0))
               (if (> man (cast u64 (>> lim e2))) (return 0))
               (set nn (cast i64 (<< man (cast u64 e2))))
               (set dd 1))
            (block
             (if (> (- 0 e2) 62) (return 0))
             (set nn (cast i64 man))
             (set dd (cast i64 (<< (cast u64 1) (cast u64 (- 0 e2)))))))
          (if neg (set nn (- 0 nn)))
          (set (cof n) nn)
          (set (cof d) dd)
          (return 1)))

  ;;; A NUMBER CELL AS AN EXACT N/D: a RAT's pair, an integer over 1, or the
  ;;; exact value of a float. 0 for a float that is no number or one whose
  ;;; exact fraction exceeds i64.
  (static)
  (func coco_rat_side ((coco_machine * m) (u64 c) (i64 * n) (i64 * d)) (out int)
        (cond
          ((coco-rat-p c)
           (block (coco_rat_nd m c n d) (return 1)))
          ((coco-is-int c)
           (block (set (cof n) (coco_int_val m c)) (set (cof d) 1) (return 1)))
          ((coco-tag-is FLT c)
           (return (coco_double_rat (nth (cast size_t (coco-payload c)) (-> m floats)) n d)))
          (#t (return 0))))

  ;;; THE SIMPLEST RATIONAL NEAR A DOUBLE (SWI's `rationalize/1'), by its
  ;;; continued fraction; the convergent whose terms leave 64 bits is not
  ;;; taken, so an answer always fits. Answers 0 for a number that is no
  ;;; number, or whose integer part alone leaves 64 bits (SWI bignums).
  (static)
  (func coco_rat_approx ((double x) (i64 * n) (i64 * d)) (out int)
        (let ((int neg . #'(? (< x 0.0) 1 0))
              (double v . #'(? (< x 0.0) (- 0 x) x))
              (i128 lo . #'(- 0 (cast i128 9223372036854775807)))
              (i128 hi . #'(cast i128 9223372036854775807))
              (i128 h0 . 0) (i128 h1 . 1) (i128 k0 . 1) (i128 k1 . 0)
              (i128 h2 . 0) (i128 k2 . 0)
              (i64 a . 0) (int round . 0) (int done . 0))
          (if (or (!= v v) (>= v 9223372036854775807.0)) (return 0))
          ;; v is non-negative and below 2^63, so a cast truncates to the
          ;; floor; the engine test compiles this file alone, with no math.h
          (set a (cast i64 v))
          (while (and (not done) (< round 200))
            (set round (+ round 1))
            (set h2 (+ (* (cast i128 a) h1) h0))
            (set k2 (+ (* (cast i128 a) k1) k0))
            (if (or (< h2 lo) (> h2 hi))
                (set done 1)
              (if (or (< k2 0) (> k2 hi))
                  (set done 1)
                (block
                 (set h0 h1) (set h1 h2)
                 (set k0 k1) (set k1 k2)
                 (if (== v (cast double a))
                     (set done 1)
                   (block
                    (set v (/ 1.0 (- v (cast double a))))
                    (if (or (!= v v) (>= v 9223372036854775807.0))
                        (set done 1)
                      (set a (cast i64 v)))))))))
          ;; the last convergent that fit is h1/k1
          (if (or (== k1 0) (< h1 lo) (> h1 hi)) (return 0))
          (set (cof n) (? neg (- 0 (cast i64 h1)) (cast i64 h1)))
          (set (cof d) (cast i64 k1))
          (return 1)))

  (func coco_open_struct ((coco_machine * m) (const char * name) (u32 arity)) (out size_t)
        (let ((u64 f . #'(coco_functor_id m (coco_intern m name) arity)))
          (return (coco_push m (coco-cell FUN f)))))

  (func coco_set_arg ((coco_machine * m) (size_t slot) (size_t val))
        (set (nth slot (-> m heap)) (coco-cell REF val)))

  ;;; EVERY ARGUMENT IS DEREFERENCED AS IT IS STORED, and that one call is
  ;;; the difference between a linear interpreter and a quadratic one.
  ;;;
  ;;; An argument is kept as a REF cell pointing at the index it was given.
  ;;; Given an index that is ITSELF a REF -- which is what `coco_arg' hands
  ;;; back, every time -- the new cell points at a pointer, and the chain
  ;;; grows by one link for every structure built on the last one. The
  ;;; continuation is exactly that: `$k(Goal, Barrier, Rest)' built on the
  ;;; Rest taken out of the previous one, so a recursion 3000 deep left a
  ;;; REF chain 9000 long and `coco_deref' walked it on EVERY step.
  ;;;
  ;;; MEASURED, because it was invisible until counted: `between(1,3000,_),
  ;;; fail' spent 85% of its instructions in coco_deref, walking a chain
  ;;; whose longest was 8999 links, for 27 MILLION hops. With the deref
  ;;; here the longest is 1.
  ;;;
  ;;; IT IS SAFE BECAUSE BACKTRACKING TRUNCATES THE HEAP. The worry is a
  ;;; bound variable: deref stores what it is bound TO, and an undo would
  ;;; put the variable back while this cell still pointed at the value. But
  ;;; a cell built after a binding lives above the choice point's
  ;;; `heap_mark', and `coco_backtrack' sets `heap_len' back to that mark --
  ;;; so anything that could see the stale value has already been dropped.
  ;;; That is the same invariant the WAM builds on, and the reason it
  ;;; dereferences on the way into a structure too.
  ;;;
  ;;; An UNBOUND variable derefs to itself, so sharing is untouched: two
  ;;; arguments that were the same variable still are.
  (func coco_make ((coco_machine * m) (const char * name) (u32 n) (const size_t * args)) (out size_t)
        (let ((size_t h . #'(coco_open_struct m name n)))
          (for ((u32 i . 0)) (< i n) ((++ i))
            (coco_push m (coco-cell REF (coco_deref m (nth (cast size_t i) args)))))
          (return h)))

  (func coco_make1 ((coco_machine * m) (const char * name) (size_t a)) (out size_t)
        (let ((size_t h . #'(coco_open_struct m name 1)))
          (coco_push m (coco-cell REF (coco_deref m a)))
          (return h)))

  (func coco_make2 ((coco_machine * m) (const char * name) (size_t a) (size_t b)) (out size_t)
        (let ((size_t h . #'(coco_open_struct m name 2)))
          (coco_push m (coco-cell REF (coco_deref m a)))
          (coco_push m (coco-cell REF (coco_deref m b)))
          (return h)))

  ;;; The same by functor id: the header is pushed from the id, and the
  ;;; arguments exactly as `coco_make' pushes them -- dereferenced, which is
  ;;; the rule that keeps the continuation's chains one link long.
  (func coco_make_f ((coco_machine * m) (u64 fid) (u32 n) (const size_t * args)) (out size_t)
        (let ((size_t h . #'(coco_push m (coco-cell FUN fid))))
          (for ((u32 i . 0)) (< i n) ((++ i))
            (coco_push m (coco-cell REF (coco_deref m (nth (cast size_t i) args)))))
          (return h)))

  (func coco_make1_f ((coco_machine * m) (u64 fid) (size_t a)) (out size_t)
        (let ((size_t h . #'(coco_push m (coco-cell FUN fid))))
          (coco_push m (coco-cell REF (coco_deref m a)))
          (return h)))

  (func coco_make2_f ((coco_machine * m) (u64 fid) (size_t a) (size_t b)) (out size_t)
        (let ((size_t h . #'(coco_push m (coco-cell FUN fid))))
          (coco_push m (coco-cell REF (coco_deref m a)))
          (coco_push m (coco-cell REF (coco_deref m b)))
          (return h)))

  (func coco_new_atom_id ((coco_machine * m) (u64 id)) (out size_t)
        (return (coco_push m (coco-cell ATOM id))))

  ;;; THE LIST FUNCTOR BY ID. `coco_cons' built every cell by name, so a
  ;;; code list of N characters interned "." and probed the functor table N
  ;;; times: 2 % of the translator's lesson and 2.1 % of the linter, in
  ;;; `atom_codes/2', `read_file_to_codes/3', `=..' and `split_string/4'. An
  ;;; id kept only when nothing ran out of memory on the way, since a failed
  ;;; intern answers 0, which is somebody else's id.
  (func coco_cons_fid ((coco_machine * m)) (out u64)
        (if (== (-> m cons1) 0)
            (let ((u64 f . #'(coco_functor_id m (coco_intern m ".") 2)))
              (if (-> m oom) (return f))
              (set (-> m cons1) (+ f 1))))
        (return (- (-> m cons1) 1)))

  (func coco_cons ((coco_machine * m) (size_t h) (size_t t)) (out size_t)
        (return (coco_make2_f m (coco_cons_fid m) h t)))

  ;;; A list cell is a compound whose functor is `'.'/2' -- one comparison of
  ;;; ids, where each walk along a list (`memberchk/2', `length/2',
  ;;; `is_list/1', the writer) asked every cell's name with `strcmp'. Until
  ;;; the id is known it is learnt from the first cell met, so asking never
  ;;; interns anything.
  (func coco_is_cons ((coco_machine * m) (size_t t)) (out int)
        (let ((u64 c . #'(nth t (-> m heap))))
          (if (not (coco-tag-is FUN c)) (return 0))
          (if (!= (-> m cons1) 0) (return (? (== (coco-payload c) (- (-> m cons1) 1)) 1 0)))
          (if (and (== (coco_arity m t) 2)
                   (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) ".")))
              (block (set (-> m cons1) (+ (coco-payload c) 1))
                     (return 1)))
          (return 0)))

  ;;; ---- inspection ---------------------------------------------------

  ;;; Follow REF links to the cell that actually holds something. A variable
  ;;; that points at itself stops the walk, which is what makes "unbound" free.
  (func coco_deref ((coco_machine * m) (size_t t)) (out size_t)
        (while (coco-tag-is REF (nth t (-> m heap)))
          (let ((size_t next . #'(cast size_t (coco-payload (nth t (-> m heap))))))
            (if (== next t) (return t))
            (set t next)))
        (return t))

  (func coco_arity ((coco_machine * m) (size_t t)) (out u32)
        (let ((u64 c . #'(nth t (-> m heap))))
          (if (not (coco-tag-is FUN c)) (return 0))
          (return ($ (nth (cast size_t (coco-payload c)) (-> m functors)) arity))))

  ;;; The name of an atom or of a compound's functor -- the two things that can
  ;;; head a goal. Anything else answers with a name that cannot be interned by
  ;;; the reader, so a caller that forgets to check gets a mismatch rather than
  ;;; a wrong match.
  (func coco_name_of ((coco_machine * m) (size_t t)) (out u64)
        (let ((u64 c . #'(nth t (-> m heap))))
          (cond ((coco-tag-is ATOM c) (return (coco-payload c)))
                ((coco-tag-is FUN c)
                 (return ($ (nth (cast size_t (coco-payload c)) (-> m functors)) name)))
                (#t (return (cast u64 -1))))))

  ;;; The i'th argument cell of a compound. The caller derefs it; the cell
  ;;; itself is usually a REF pointing at wherever the argument really lives,
  ;;; because `coco_copy' fills arguments in after it has reserved their slots.
  (func coco_arg ((coco_machine * m) (size_t t) (u32 i)) (out size_t)
        (return (+ t (+ (cast size_t i) 1))))

  (func coco_is_callable ((coco_machine * m) (size_t t)) (out int)
        (let ((u64 c . #'(nth t (-> m heap))))
          (return (? (or (coco-tag-is ATOM c) (coco-tag-is FUN c)) 1 0))))

  ) ; impl-term

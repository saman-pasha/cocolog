;;; a bit: 1 built_in, 2 foreign, 4 transparent, 8 nodebug, 16
;;; noprofile, 32 iso, 64 ssu, 128 notrace, 256 non_terminal, 512
;;; public, 1024 dynamic, 2048 multifile, 4096 hidden from user (291
;;; rows: a carried library's own predicate user does not see), 8192 an
;;; export swipl's autoloader does not reach; a meta argument a

;;;; cocolog -- green threads: Go's go, yield and channels, on M:N workers
;;;; (cocolog 2.8.0).
;;;
;;;; WHY THIS IS NOT library(thread). A thread of library(thread) has its
;;;; own OS thread and runs at the same time as the others; a green thread
;;;; is a machine of its own, stepped by a worker, that gives way when it
;;;; yields, awaits, blocks on a channel or spends its 10,000-step quantum.
;;;; go/2 starts one, await/2 joins it, and channels carry terms between
;;;; them.
;;;
;;;; THE WORLD (2.8.0) IS M:N. `async_run/1,2' starts a world of N workers,
;;;; N the machine's online cores (2.9.3; GOMAXPROCS's rule, and
;;;; COCOLOG_GREEN_WORKERS overrides it): the caller's own thread is worker
;;;; 0 and N-1 pthreads are workers 1..N-1. ONE STORE (2.9.0): every worker
;;;; -- and so every task's
;;;; machine -- runs over the caller's own store and the caller's own
;;;; machine, whose name and value tables all the machines alias (2.8.1).
;;;; A task is pinned to the worker it was born on; a spawn copies nothing
;;;; but its goal; a write a task makes is seen by every other as soon as
;;;; it lands.
;;;;
;;;; A WRITE STOPS THE WORLD BEFORE IT LANDS (2.9.0). There is one store,
;;;; the one every reader walks, so a store mutation -- assertz and
;;;; asserta, retract, dynamic and abolish, nb_setval, and the metadata a
;;;; first call makes (a predicate created, a clause compiled, an
;;;; argument index built, a sweep) -- takes `coco_g_write_begin' FIRST:
;;;; every other worker acknowledges at its safe point (its loop's top, or
;;;; the wait inside a write of its own) and stops; the writer changes the
;;;; store with no lock held; `coco_g_write_end' releases the world. A
;;;; read takes no lock: a read runs only while no write is in flight.
;;;; `coco_frames_on' walks every machine the store lists, so a suspended
;;;; task's open call counts as an open call for the logical update view.
;;;; A write nested inside another's barrier (`coco_pred_dynamic' inside
;;;; `assertz''s) is covered by the outer one and ends nothing.
;;;;
;;;; THE QUANTUM IS THE ENGINE'S OWN STEP LIMIT (2.8.0). `max_steps' is
;;;; set to the task's step count plus the quantum; the limit's cold path
;;;; sees GREENQ and stops with GSTOP, the continuation flushed as a yield
;;;; flushes it, and the worker runs the next ready task and comes back.
;;;; A task may still hold a worker inside a foreign call.
;;;;
;;;; THE SCHEDULER. Each worker picks the next ready task pinned to it,
;;;; round robin from a per-worker cursor; a worker with nothing to do
;;;; waits on its own condition variable, signalled by a spawn, a finish,
;;;; a wake or the world's stop. The main task is id 0
;;;; on worker 0; when it ends the world stops and the host collects its
;;;; status. A deadlock is every task blocked and no main end.
;;;;
;;;; THE STATUS OF A THREAD is a text term `'$async'(ok, Goal)' for its
;;;; first solution, `'$async'(failed)', or `'$async'(error, Ball)'. A
;;;; waiter records the cell its status argument stands in; the waker
;;;; writes the status into that cell before the waiter resumes.
;;;;
;;;; THE LIMITS, stated where a reader meets them: 1024 threads and 64
;;;; channels a world; the world runs over the caller's own store (2.9.0;
;;;; a spawn copies nothing); a consult or load a task runs and a module's
;;;; own C state stay the worker's; a channel and a thread list are
;;;; shared under the world lock; a task that blocks on a channel closed
;;;; under it or on a thread that never ends is a deadlock; and a goal runs
;;;; in the machine's module, so a module-qualified goal is not transported
;;;; as one.

(IN-PACKAGE :cocolog)

;;;; ------------------------------------------------------------------
;;;; The C half, as a table
;;;; ------------------------------------------------------------------
(DEFPARAMETER *green-predicates*
  '(("$async_run"     2 coco_g_async_run)
    ("$async_go"      2 coco_g_async_go)
    ("$async_yield"   0 coco_g_async_yield)
    ("$async_await"   2 coco_g_async_await)
    ("$async_ready"   1 coco_g_async_ready)
    ("$async_channel" 2 coco_g_async_channel)
    ("$async_send"    3 coco_g_async_send)
    ("$async_recv"    2 coco_g_async_recv)
    ("$async_close"   1 coco_g_async_close)
    ("$async_workers" 1 coco_g_async_workers)
    ;; a test's foreign call: sleeps without reading the store
    ("$green_foreign_sleep" 1 coco_g_foreign_sleep)))

;;; The compiled-in module has no Prolog half of its own: library(async)
;;; is the clauses, a tier-2 file, and it calls the `$'-prefixed C.
(DEFPARAMETER *green-prolog* "")

;;; THE STATUSES THAT ARE ALWAYS THE SAME ARE NOBODY'S TO ALLOCATE (3.62.3),
;;; as a table: one array of literals (`coco_g_text_at'), each named here
;;; and taken by its name (`coco-g-text'). Through 3.62.2 each was a `strdup' at
;;; every use -- one a send, one a close, one a waiter woken -- and a
;;; `strdup' the allocator refuses is a nil, which a waiter was handed as
;;; no text at all: it ran on with its status cell unbound, library(async)
;;; read an unbound status as an answer, and under an address-space ceiling
;;; AN AWAIT OF A TASK THAT HAD FAILED SUCCEEDED (286 awaits of 900:
;;; test/async.pl, `ceiling'). `memory' is what a text that could not be
;;; made is replaced by, so a status is never nil; `awaited' is no status
;;; but a mark: the waiter reads its task's status where it stands
;;; (`coco_g_wake'). A text is told from one of these by its address
;;; (`coco_g_text_free').
(DEFPARAMETER *green-texts*
  '((failed      "'$async'(failed)")
    (closed      "'$async'(closed)")
    (sent        "'$async'(ok)")
    (send-closed "'$async'(error,error(permission_error(send,channel,closed),_))")
    (memory      "'$async'(error,error(resource_error(memory),_))")
    (c-stack     "'$async'(error,error(resource_error(c_stack),_))")
    (system      "'$async'(error,error(system_error,_))")
    (deadlock    "'$async'(error,error(resource_error(deadlock),_))")
    (awaited     "'$async'(awaited)")))

;; the array, as the body of the one function that holds it; how many it
;; holds; and one of them
(DEFMACRO coco-g-text-at-body (i)
  `(let ((static) (const char * texts [] . '{ ,@(MAPCAR #'CADR *green-texts*) }))
     (return (cast (char *) (nth ,i texts)))))

(DEFMACRO coco-g-text-count () (LENGTH *green-texts*))

(DEFMACRO coco-g-text (name)
  (LET ((at (POSITION name *green-texts* :KEY #'CAR)))
    (UNLESS at (ERROR "lib/green.cicili: no status named ~a" name))
    `(coco_g_text_at ,at)))

(generic decl-green
  ()

  ;; 1024 tasks and 64 channels a world; a worker a core, allocated.
  ;; a member's type is one token, so the two-step typedef: a char * is
  ;; coco_charp, and the ring is a coco_charp *.
  (typedef char * coco_charp)
  (typedef coco_charp * coco_strptr)

  (struct green_thread
    (member int           id)
    (member int           worker)      ; pinned at spawn
    (member int           state)       ; 0 ready, 1 blocked, 2 done, 3
                                       ; waiting inside a nested search
    (member int           block)       ; 0 none, 1 await, 2 send, 3 recv,
                                       ; 4 yield
    (member int           wait_on)     ; the awaited thread
    (member int           chan)        ; the channel blocked on
    (member char *        send_text)   ; a blocked sender's term, canonical
    (member size_t        resume_cell) ; where the status goes on resume
    (member char *        resume_text) ; the status, from the waker
    (member int           resume_msg)  ; ... or a message's term, to be
                                       ; answered as '$async'(ok, T)
    (member char *        status)      ; done: the status text
    (member char *        goal)        ; until the machine is made
    (member int           made)
    (member coco_machine * m)
    (member coco_engine *  e)
    (member coco_store *   st))

  (struct green_chan
    (member int    size)               ; 0 is a rendezvous
    (member int    closed)
    (member coco_strptr buf)           ; SIZE slots, a ring
    (member int    cap)
    (member int    head)
    (member int    count)
    ;; EVERY TASK OF A WORLD MAY WAIT ON ONE CHANNEL (3.62.1): a task waits
    ;; on one channel at most, so each list holds as many as a world holds
    ;; tasks and needs no bound. They held 64: the 65th waiter's id was
    ;; written over the count beside the array, the waiters were lost, and
    ;; the world called itself dead (test/async.pl, `waiters').
    (member int    senders [1024])
    (member int    nsenders)
    (member int    receivers [1024])
    (member int    nreceivers))

  ;; ONE WRITE AT A TIME. The writer names itself, the sequence keeps a
  ;; worker from acknowledging one write twice, NEED is how many acks this
  ;; write waits for (every other worker NOT away in a foreign call), and
  ;; ACKS counts them.
  (struct green_op
    (member int    writer)
    (member int    seq)
    (member int    need)
    (member int    acks))

  (struct green_worker
    (member int            id)
    (member void *         w)          ; its world
    (member coco_store *   st)
    (member coco_machine * base)       ; the tables every task aliases
    (member int            cur)        ; the task it is running, -1
    (member int            cursor)     ; the round-robin start
    (member int            applied_seq)
    ;; HOW MANY NON-STORE FOREIGN CALLS THIS WORKER IS INSIDE. A writer may
    ;; skip a worker with FOREIGN > 0; the call's end syncs with any write
    ;; still in flight before the worker reads the store again.
    (member int            foreign)
    ;; THIS WORKER HAS LEFT ITS LOOP (3.62.1): the world is ending and it
    ;; reads the store no more. Set under the world lock in the hold that
    ;; found no write in flight to acknowledge, so a write counts a worker
    ;; in its NEED only if that worker will acknowledge it.
    (member int            gone)
    ;; THE WRITE THAT COUNTED THIS WORKER, by its sequence (3.62.1): set
    ;; by the writer as it counts its NEED, and only that write takes this
    ;; worker's acknowledgement (`coco_g_ack').
    (member int            asked)
    ;; A WAKE GENERATION: every signal to this worker bumps it, and the
    ;; loop's cond wait refuses to sleep when it moved since the last
    ;; check -- a signal that arrives while the worker is between its pick
    ;; and its wait is then not lost.
    (member int            wgen)
    (member int            wseen)
    (member pthread_t      tid)
    (member pthread_cond_t wake))

  (struct green_world
    (member green_thread *    threads)
    (member int               nthreads)
    (member int               cap)
    (member green_chan *      chans)
    (member int               nchans)
    (member int               quantum)
    (member green_worker *    workers)
    (member int               nworkers)
    (member pthread_mutex_t   lock)
    (member pthread_cond_t    op_done)
    ;; A NESTED ENGINE CANNOT BE SUSPENDED (findall/3, forall/2,
    ;; aggregate_all/3, call_limited/3): its C stack is not part of the
    ;; machine. A blocking green builtin inside one therefore WAITS HERE,
    ;; running this worker's ready tasks itself, and returns with the
    ;; answer still in the same C frame. CHANGED wakes such a waiter on
    ;; any task event. Such a task is state 3 while it waits, and no
    ;; worker calls a world dead that holds one: the waiter asks itself
    ;; whether anything can still move (`coco_g_live').
    (member pthread_cond_t    changed)
    (member green_op *        op)
    ;; THE ONE WRITE'S RECORD IS THE WORLD'S OWN (3.62.3): `op' is nil or
    ;; points here. It was a `calloc' at every write, unread: a write made
    ;; where memory is short -- the store's put of a ball, an engine
    ;; raising resource_error(memory) -- wrote its writer's id through a
    ;; null (SIGSEGV under an address-space ceiling: test/async.pl,
    ;; `ceiling'). One write is in flight at a time, every reader of the
    ;; record holds the lock, and each tells one write from the next by its
    ;; sequence, never by its address.
    (member green_op          op_one)
    (member int               op_seq)
    ;; THE WORLD IS ENDING: the main task ended (its goal, or the deadlock
    ;; that ends it for it), or a task halted. Every worker leaves at its
    ;; next safe point, whatever else is ready (3.62.1).
    (member int               main_done)
    ;; A TASK HALTED (3.62.1): the process's halt, handed up to the engine
    ;; that called async_run/1,2 once the workers are joined.
    (member int               halt)
    (member int               halt_code)
    (member int               next_worker)
    (member coco_store *      host_st)
    (member coco_machine *    host)
    (member coco_engine *     host_e)
    ;; THE NAMES' MUTEX (2.8.1): every worker's base aliases the host's
    ;; atom, functor, string, float, big and rat tables, and the table
    ;; mutations take this lock. Since 2.9.0 there is ONE store as well.
    (member pthread_mutex_t   tbl_mx)
    ;; and the names' generation, the world's own (3.62.1)
    (member size_t            tbl_gen)
    ;; THE MACHINE LIST'S MUTEX (2.9.1). The one store lists every task's
    ;; machine for the frame walk (`st->machines'), and a link (a task
    ;; prepared on its worker, OUTSIDE the world lock) used to run beside
    ;; an unlink (a task finished, sometimes under it): a lost node, or a
    ;; freed machine's address linked back -- a cycle the walk spun in
    ;; under the world lock, or a freed read (the light lane's hang and
    ;; SIGSEGV, one run in twelve). The list has its own mutex, never held
    ;; across anything else, and the world lock is never taken under it.
    (member pthread_mutex_t   mmx))

  ;;; <pthread.h>'s, which Cicili's std does not declare
  (decl) (func pthread_attr_getstacksize ((const pthread_attr_t * attr) (size_t * stacksize)) (out int))

  (decl) (func coco_green_module () (out int))
  (decl) (func coco_g_async_run ((coco_engine * e) (size_t g)) (out int))
  (decl) (func coco_g_async_go ((coco_engine * e) (size_t g)) (out int))
  (decl) (func coco_g_async_yield ((coco_engine * e) (size_t g)) (out int))
  (decl) (func coco_g_async_await ((coco_engine * e) (size_t g)) (out int))
  (decl) (func coco_g_async_ready ((coco_engine * e) (size_t g)) (out int))
  (decl) (func coco_g_async_channel ((coco_engine * e) (size_t g)) (out int))
  (decl) (func coco_g_async_send ((coco_engine * e) (size_t g)) (out int))
  (decl) (func coco_g_async_recv ((coco_engine * e) (size_t g)) (out int))
  (decl) (func coco_g_async_close ((coco_engine * e) (size_t g)) (out int))
  (decl) (func coco_g_async_workers ((coco_engine * e) (size_t g)) (out int))
  ;; The pre-write barrier (2.9.0): a store write takes it before the call.
  (decl) (func coco_g_write_begin ((void * e)) (out int))
  (decl) (func coco_g_write_end () (out void))
  (decl) (func coco_g_write_end_cleanup ((int * began)) (out void))
  ;; A module's blocking C call that does NOT touch the store: the write
  ;; barrier may skip this worker while the call runs, and the call's end
  ;; waits for any write still in flight before the worker reads again.
  (decl) (func coco_g_foreign_begin ())
  (decl) (func coco_g_foreign_end ())
  (decl) (func coco_g_foreign_end_cleanup ((int * began)) (out void))

  ) ; decl-green


(generic impl-green
  ()

  ;; THE WORLD AND THE WORKER ARE PER OS THREAD. A task's builtins run on
  ;; its worker's thread; the barrier and the builtins read these.
  (thread-local) (var green_world * green_now)
  (thread-local) (var green_worker * green_me)
  (thread-local) (var int green_in_write . 0)

  ;;; ---- text and status -------------------------------------------------

  ;; the statuses nobody allocates (`*green-texts*'), and whether TEXT is
  ;; one of them; what else is a text is its holder's to free
  (static) (inline)
  (func coco_g_text_at ((int i)) (out char *)
        (coco-g-text-at-body i))

  (static)
  (func coco_g_text_const ((const char * text)) (out int)
        (for ((int i . 0)) (< i (coco-g-text-count)) ((++ i))
          (if (== text (coco_g_text_at i)) (return 1)))
        (return 0))

  (static)
  (func coco_g_text_free ((char * text))
        (if (and (!= text nil) (not (coco_g_text_const text))) (free text)))

  ;;; CANONICAL, so the reader on the other side needs no operator table:
  ;;; the writer's quoted, ignore_ops form (`'$async'(ok, f(a,b))'). A term
  ;;; too deep for the C stack to write (3.59.0) is no text: nil, WSHORT
  ;;; left for the caller to raise resource_error(c_stack)
  ;;; (`coco_g_no_text').
  ;;;
  ;;; NOR IS A TEXT THE BUFFER WAS REFUSED ROOM FOR (3.62.3). A put that is
  ;;; refused leaves the buffer as it was and the writer goes on, so the
  ;;; text came out short of a piece and was sent as it stood: a status
  ;;; that did not read, or one that read as another term. The thread's
  ;;; count of refusals says so (`coco_refusals'), and the copy can be
  ;;; refused too.
  (static)
  (func coco_g_write ((coco_machine * m) (size_t t)) (out char *)
        (let ((coco_strbuf b) (char * out . nil) (size_t r0 . #'(coco_refusals))
              ;; the count is read here, so the machine running on the
              ;; thread is not finished for it (`coco_refuse_take')
              (coco_machine * was . #'(coco_refuse_take)))
          (coco_sb_init (aof b))
          (coco_write_term m (aof b) t 1 1)
          (if (and (!= ($ b s) nil)
                   (and (not (-> m wshort)) (== (coco_refusals) r0)))
              (set out (strdup ($ b s))))
          (coco_sb_free (aof b))
          (coco_refuse_give was)
          (return out)))

  ;;; '$async'(KIND,T), or where T is too deep for the C stack to write
  ;;; (3.59.0) the error a task's await raises for it; nil where there was
  ;;; no memory for the text, which a status is never left as
  ;;; (`coco_g_finish')
  (static)
  (func coco_g_kind_text ((coco_machine * m) (const char * kind) (size_t t)) (out char *)
        (let ((coco_strbuf b) (char * out . nil) (size_t r0 . #'(coco_refusals))
              (coco_machine * was . #'(coco_refuse_take)))
          (coco_sb_init (aof b))
          (coco_sb_put (aof b) kind)
          (coco_write_term m (aof b) t 1 1)
          (coco_sb_put (aof b) ")")
          (if (coco_write_short m)
              (set out (coco-g-text c-stack))
            (if (and (!= ($ b s) nil) (== (coco_refusals) r0))
                (set out (strdup ($ b s)))))
          (coco_sb_free (aof b))
          (coco_refuse_give was)
          (return out)))

  (static)
  (func coco_g_ok_text ((coco_machine * m) (size_t goal)) (out char *)
        (return (coco_g_kind_text m "'$async'(ok," goal)))

  (static)
  (func coco_g_error_text ((coco_machine * m) (size_t ball)) (out char *)
        (return (coco_g_kind_text m "'$async'(error," ball)))

  ;;; What a task is handed for a text that did not read: the error its
  ;;; await, its receive or its start raises -- resource_error(c_stack)
  ;;; where the read ran short of C stack (3.60.0, `coco_read_short', as a
  ;;; write that ran short raises it, 3.59.0), resource_error(memory) where
  ;;; it was refused memory (3.62.3: REFUSED, the caller's own finding),
  ;;; else system_error. Asks the machine's word once.
  (static)
  (func coco_g_unread_text ((coco_machine * m) (int refused)) (out char *)
        (if (coco_read_short m) (return (coco-g-text c-stack)))
        (return (? refused (coco-g-text memory) (coco-g-text system))))

  ;;; WHETHER MEMORY WAS REFUSED SINCE R0, the thread's count then: the
  ;;; machine said so (`oom': an array of its own, or a name's copy), or
  ;;; the thread counted a refusal (`coco_refusals': a token's buffer, a
  ;;; variable not recorded). A term read across one is not the term its
  ;;; text says.
  (static)
  (func coco_g_refused ((coco_machine * m) (size_t r0)) (out int)
        (return (or (!= (-> m oom) 0) (!= (coco_refusals) r0))))

  ;;; Read TEXT into M and unify it with CELL: a status as it stands, and
  ;;; (MSG) a channel's message T as `'$async'(ok, T)', what its receive
  ;;; answers -- built here, where through 3.62.2 the receive read the
  ;;; message, wrote it again inside its status and read that. 1, or 0
  ;;; where the unify refuses, or -1 where nothing could be put in the
  ;;; cell.
  ;;;
  ;;; A TEXT THAT DOES NOT READ IS THE ERROR ITS READER RAISES, NEVER
  ;;; NOTHING (3.62.3): the status `coco_g_unread_text' names is read in its
  ;;; place. Through 3.62.2 that was done for a read short of C stack
  ;;; alone; a read refused memory, and a text that was none, answered 0,
  ;;; which no caller read, and the cell stayed unbound. Only when the
  ;;; error does not read either is the answer -1, and each caller ends
  ;;; what it was doing with resource_error(memory): a builtin raises it
  ;;; (`coco_g_answer'), and a task that cannot be handed its text ends
  ;;; with it for its status (`coco_g_run').
  (static)
  (func coco_g_resume ((coco_machine * m) (size_t cell) (const char * text) (int msg)) (out int)
        (let ((size_t t . 0)
              ;; THE WAITER'S CELL IS A HEAP INDEX held across a read that
              ;; may allocate and collect; unrooted, a collection moves it
              ;; and the status lands in the wrong cell -- a waiter that
              ;; sometimes reads "failed" instead of its ball (the rare
              ;; deadlock case), or writes into a reused cell.
              (size_t hold [1])
              (size_t * holdp . hold)
              (size_t nhold . 1)
              (int held . 0)
              (size_t r0 . #'(coco_refusals))
              (int ok . 0))
          (set (nth 0 hold) cell)
          (set held (coco_heap_root_push m (aof holdp) (aof nhold)))
          (if (!= text nil) (set ok (coco_read_term_from m text (aof t))))
          (if (coco_g_refused m r0) (set ok 0))
          (if (not ok)
              (let ((const char * why . #'(coco_g_unread_text m (coco_g_refused m r0))))
                (set msg 0)
                (set r0 (coco_refusals))
                (set ok (coco_read_term_from m why (aof t)))
                (if (coco_g_refused m r0) (set ok 0))))
          (if (and ok msg)
              (block (set t (coco_make2 m "$async" (coco_new_atom m "ok") t))
                     (if (-> m oom) (set ok 0))))
          (set cell (nth 0 hold))
          (if held (coco_heap_root_pop m))
          (if (not ok) (return -1))
          (return (coco_unify m cell t))))

  ;;; An error a caller can catch: error(cocolog_error(Sentence), _).
  (static)
  (func coco_g_raise ((coco_engine * e) (const char * msg)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (return (coco_raise e (coco_make1 m "cocolog_error"
                                             (coco_new_atom m msg))))))

  ;;; what a text that could not be written raises: resource_error(c_stack)
  ;;; where the write ran short of C stack (3.59.0, `coco_g_write'), else
  ;;; resource_error(memory) -- the buffer was refused room, or its copy
  ;;; (3.62.3; through 3.62.2 a sentence that called the term too wide,
  ;;; which was a guess at the one reason left)
  (static)
  (func coco_g_no_text ((coco_engine * e)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (if (coco_write_short m)
              (return (coco_raise e (coco_make1 m "resource_error" (coco_new_atom m "c_stack")))))
          (return (coco_mem_error e))))

  ;;; A BUILTIN'S OWN ANSWER: TEXT into its status cell SC (`coco_g_resume'),
  ;;; or resource_error(memory) where nothing could be put there.
  (static)
  (func coco_g_answer ((coco_engine * e) (size_t sc) (const char * text) (int msg)) (out int)
        (let ((int got . #'(coco_g_resume (-> e m) sc text msg)))
          (if (< got 0) (return (coco_mem_error e)))
          (return got)))

  ;;; ---- the world's stores ----------------------------------------------

  (static)
  (func coco_g_store_link ((green_world * wd) (coco_store * st) (coco_machine * m))
        (pthread_mutex_lock (aof (-> wd mmx)))
        (set (-> m st_next) (-> st machines))
        (set (-> st machines) (cast (void *) m))
        (pthread_mutex_unlock (aof (-> wd mmx))))

  (static)
  (func coco_g_store_unlink ((green_world * wd) (coco_store * st) (coco_machine * m))
        (pthread_mutex_lock (aof (-> wd mmx)))
        (let ((coco_machine * prev . nil)
              (coco_machine * cur . #'(cast (coco_machine *) (-> st machines))))
          (while (!= cur nil)
            (if (== cur m)
                (block
                 (if (== prev nil) (set (-> st machines) (-> m st_next))
                     (set (-> prev st_next) (-> m st_next)))
                 (pthread_mutex_unlock (aof (-> wd mmx)))
                 (return))
              (block (set prev cur)
                     (set cur (cast (coco_machine *) (-> cur st_next)))))))
        (pthread_mutex_unlock (aof (-> wd mmx))))

  ;;; ---- a task's machines -----------------------------------------------

  (static)
  (func coco_g_thread_free ((green_world * wd) (green_thread * t))
        (if (and (!= (-> t st) nil) (!= (-> t m) nil))
            (coco_g_store_unlink wd (-> t st) (-> t m)))
        (if (!= (-> t e) nil) (coco_engine_free (-> t e)))
        (if (!= (-> t m) nil) (coco_machine_free (-> t m)))
        (if (!= (-> t e) nil) (free (-> t e)))
        (if (!= (-> t m) nil) (free (-> t m)))
        (set (-> t m) nil) (set (-> t st) nil) (set (-> t e) nil))

  ;;; MAKE A TASK'S MACHINE on its worker's base and ask its goal. Runs on
  ;;; the task's own worker, outside the world lock: the base is that
  ;;; worker's alone, and the store is the world's one (2.9.0). 0 means the
  ;;; goal did not read; the status is set and the caller finishes the task.
  ;;;
  ;;; A TASK THERE IS NO MEMORY FOR ENDS WITH resource_error(memory) FOR
  ;;; ITS STATUS (3.62.3), whichever piece was refused: the machine, the
  ;;; engine, the machine's first cells (`coco_machine_init_alias', unasked
  ;;; through 3.62.2), or anything the read of its goal asked for
  ;;; (`coco_g_refused') -- a goal read across a refusal is not the goal
  ;;; its text says, and was run as it came out.
  (static)
  (func coco_g_prepare ((green_worker * w) (green_thread * t)) (out int)
        (let ((coco_machine * m . #'(cast (coco_machine *) (malloc (sizeof coco_machine))))
              (coco_engine * en . #'(cast (coco_engine *) (malloc (sizeof coco_engine)))))
          (if (or (or (== m nil) (== en nil))
                  (not (coco_machine_init_alias m (-> w base))))
              (block
               (if (!= m nil) (free m))
               (if (!= en nil) (free en))
               (set (-> t status) (coco-g-text memory))
               (set (-> t made) 1)
               (return 0)))
          (set (-> t m) m)
          (set (-> t e) en)
          (set (-> t st) (-> w st))
          (coco_engine_init en m (-> w st))
          (set (-> en gc) 1)
          (set (-> en greenq) 1)
          ;; THE STORE'S FRAME WALK FINDS A SUSPENDED TASK'S FRAMES FROM
          ;; KEEP_ENG; `eng' is the engine's while it runs only.
          (set (-> m keep_eng) (cast (void *) en))
          (coco_g_store_link (cast (green_world *) (-> w w)) (-> w st) m)
          (set (-> t made) 1)
          (let ((int ok . 1) (size_t r0 . #'(coco_refusals)))
            (if (and (!= (-> t goal) nil)
                     (not (coco_engine_ask_text en (-> t goal))))
                (set ok 0))
            (if (!= (-> t goal) nil) (free (-> t goal)))
            (set (-> t goal) nil)
            (if (or (not ok) (coco_g_refused m r0))
                (block
                 (set (-> t status) (coco_g_unread_text m (coco_g_refused m r0)))
                 (return 0))))
          (return 1)))

  ;;; ---- the world's shared state (the caller holds the lock) -------------

  (static)
  (func coco_g_poke ((green_worker * w))
        (let ((green_world * wd . #'(cast (green_world *) (-> w w))))
          (set (-> w wgen) (+ (-> w wgen) 1))
          (pthread_cond_signal (aof (-> w wake)))
          ;; a nested waiter is not a blocked task and has no worker signal
          ;; of its own to receive: it watches this one
          (pthread_cond_broadcast (aof (-> wd changed)))))

  ;;; THE WAITERS OF A CHANNEL, in the order they came. A task waits on one
  ;;; channel at most, so a list never holds more than the world's tasks.
  (static)
  (func coco_g_chan_remove_sender ((green_chan * c) (int at))
        (for ((int i . at)) (< i (- (-> c nsenders) 1)) ((++ i))
          (set (nth i (-> c senders)) (nth (+ i 1) (-> c senders))))
        (set (-> c nsenders) (- (-> c nsenders) 1)))

  (static)
  (func coco_g_chan_remove_receiver ((green_chan * c) (int at))
        (for ((int i . at)) (< i (- (-> c nreceivers) 1)) ((++ i))
          (set (nth i (-> c receivers)) (nth (+ i 1) (-> c receivers))))
        (set (-> c nreceivers) (- (-> c nreceivers) 1)))

  ;; a waiter that gave up leaves the list it stood in
  (static)
  (func coco_g_chan_drop ((green_chan * c) (int tid))
        (for ((int i . 0)) (< i (-> c nsenders)) ((++ i))
          (if (== (nth i (-> c senders)) tid)
              (block (coco_g_chan_remove_sender c i) (return))))
        (for ((int i . 0)) (< i (-> c nreceivers)) ((++ i))
          (if (== (nth i (-> c receivers)) tid)
              (block (coco_g_chan_remove_receiver c i) (return)))))

  ;;; A WAITER IS SERVED: TEXT is what its builtin resumes with. A blocked
  ;;; task (state 1) is ready again. ONE WAITING INSIDE A NESTED SEARCH
  ;;; (state 3) IS NOT MADE READY (3.62.1): its worker's thread is inside
  ;;; that wait and takes the text itself (`coco_g_wait_nested'). Made
  ;;; ready, it was any pick's to run -- and a deeper wait on the same
  ;;; worker's C stack picked it, ran its engine a second time under the
  ;;; call still open on it, finished it and freed its machine, which the
  ;;; first run then walked on (a SIGSEGV, three runs in three, on one
  ;;; worker: test/async.pl, `stacked').
  ;;;
  ;;; TEXT IS A STATUS, or (MSG) a channel's message, which the waiter
  ;;; answers as `'$async'(ok, T)' when it reads it (3.62.3,
  ;;; `coco_g_resume': through 3.62.2 the sender wrote its term a second
  ;;; time, inside that status, with the world's lock held).
  (static)
  (func coco_g_serve ((green_world * wd) (green_thread * t) (char * text) (int msg))
        (set (-> t resume_text) text)
        (set (-> t resume_msg) msg)
        (set (-> t block) 0)
        (set (-> t chan) -1)
        (if (== (-> t state) 1) (set (-> t state) 0))
        (coco_g_poke (aof (nth (-> t worker) (-> wd workers)))))

  ;;; THE WORLD ENDS (3.62.1): the main task ended, a task halted, or every
  ;;; task is blocked. Every worker is told, and each leaves at its next
  ;;; safe point -- its loop's top, after it has acknowledged a write in
  ;;; flight -- whatever is still ready: when the main task ends the world
  ;;; stops, as a Go program ends when main returns. Through 3.62.0 a
  ;;; worker went on running its ready tasks until none was left, and one
  ;;; that never ended on the main's own worker kept async_run/1 from
  ;;; returning.
  (static)
  (func coco_g_end ((green_world * wd))
        (set (-> wd main_done) 1)
        (for ((int i . 0)) (< i (-> wd nworkers)) ((++ i))
          (coco_g_poke (aof (nth i (-> wd workers))))))

  ;;; TASK TI HAS ENDED: its waiters are ready again. A WAITER IS HANDED A
  ;;; MARK, NOT A COPY (3.62.3): the status of a task that has ended is
  ;;; nobody's to change or free before the world's end, so the waiter
  ;;; reads it where it stands (`coco_g_run', by `wait_on', which is kept
  ;;; for it). Through 3.62.2 each waiter was given a `strdup' of the whole
  ;;; status -- the goal as instantiated, as long as it was -- made with the
  ;;; world's lock held, and one the allocator refused was a waiter woken
  ;;; with nothing.
  (static)
  (func coco_g_wake ((green_world * wd) (int ti))
        (for ((int i . 0)) (< i (-> wd nthreads)) ((++ i))
          (let ((green_thread * t . #'(aof (nth i (-> wd threads)))))
            (if (and (== (-> t state) 1) (== (-> t block) 1)
                     (== (-> t wait_on) ti))
                (block
                 (set (-> t resume_text) (coco-g-text awaited))
                 (set (-> t resume_msg) 0)
                 (set (-> t state) 0)
                 (set (-> t block) 0)
                 (let ((green_worker * tw . #'(aof (nth (-> t worker) (-> wd workers)))))
                   (coco_g_poke tw)))))))

  ;;; A TASK ENDS. A STATUS IS NEVER NIL (3.62.3): one there was no memory
  ;;; to write is resource_error(memory), which its awaiter raises -- as a
  ;;; nil it was no answer, and an await of it succeeded with nothing
  ;;; bound. NO TASK ENDS ON A CHANNEL'S LIST: one that waits there is
  ;;; blocked, and what ends a task is its own run -- a machine that is
  ;;; finished stops before its next step (`coco_oom'), so it reaches no
  ;;; receive after the mark, and a block on a quantum's last step is the
  ;;; block it is (`coco_limit_go'). Through 3.62.2 neither held, and a
  ;;; send that found such a task on the list was told its message was
  ;;; taken.
  (static)
  (func coco_g_finish ((green_world * wd) (green_thread * t) (char * status))
        (set (-> t status) (? (== status nil) (coco-g-text memory) status))
        (set (-> t state) 2)
        (set (-> t block) 0)
        (coco_g_thread_free wd t)
        (coco_g_wake wd (-> t id))
        (pthread_cond_broadcast (aof (-> wd changed)))
        (if (== (-> t id) 0) (coco_g_end wd)))

  ;;; EVERY TASK BLOCKED AND THE MAIN NOT ENDED: a deadlock. A task that
  ;;; is ready is somebody's next step; one that is running has a worker
  ;;; inside it and its state is still 0.
  (static)
  (func coco_g_deadlock ((green_world * wd))
        (if (== (-> wd main_done) 1) (return))
        (if (== (-> wd nthreads) 0) (return))
        (if (!= (-> wd op) nil) (return))
        ;; A NESTED WAIT (state 3) IS A RUNNING TASK, not a dead world: it
        ;; has its own loop and raises the deadlock itself if nothing can
        ;; move. Asked of the task's state, set under the lock by the
        ;; builtin that blocks; a counter the waiter raised only once it had
        ;; taken the lock again left a moment in which a waiter already
        ;; served was called dead (3.62.1).
        ;;
        ;; AND IT IS WOKEN TO LOOK (3.62.1). A nested waiter sleeps on
        ;; `changed' while anything else can still move; when the last such
        ;; task blocks or ends, this is where the world notices, and through
        ;; 3.62.0 it noticed and said nothing: the waiter slept on, every
        ;; worker idle, async_run/1 with them (a receive inside findall/3
        ;; that nobody answers, the main task blocking on it a moment
        ;; later: three runs in four, test/async.pl, `dead_nested').
        ;;
        ;; NOR IS A TASK BLOCKED WHILE ITS WORKER IS STILL INSIDE ITS RUN
        ;; (3.62.3). A builtin that blocks says so under the lock (state 1)
        ;; and gives the lock back; its worker's thread is then on its way
        ;; out of the engine, and takes the lock again in `coco_g_run'. A
        ;; worker with nothing to run that asked in that moment found every
        ;; task blocked, called the world dead and FINISHED THE MAIN TASK
        ;; UNDER ITS OWN WORKER: its machine and engine freed while that
        ;; thread was still returning through them, and the task finished a
        ;; second time when it arrived -- `failed' written over the
        ;; deadlock, so that async_run/1 of a world that was dead FAILED
        ;; where it raises (some 2 runs in 25 of a task that ends just as
        ;; the main blocks: test/async.pl, `dead_running'). Such a task is
        ;; its worker's still (`cur'); that worker asks again itself when
        ;; its run is back (`coco_g_run'), which is this call for the
        ;; worker that makes it.
        (let ((int nested . 0))
          (for ((int i . 0)) (< i (-> wd nthreads)) ((++ i))
            (let ((green_thread * t . #'(aof (nth i (-> wd threads)))))
              (if (== (-> t state) 0) (return))
              (if (== (-> t state) 3) (set nested 1))
              (if (== (-> t state) 1)
                  (let ((green_worker * tw . #'(aof (nth (-> t worker) (-> wd workers)))))
                    (if (and (== (-> tw cur) (-> t id)) (!= tw green_me))
                        (return))))))
          (if nested
              (block (pthread_cond_broadcast (aof (-> wd changed)))
                     (return))))
        (coco_g_finish wd (aof (nth 0 (-> wd threads))) (coco-g-text deadlock)))

  ;;; THE RUNNING TASK'S OWN TABLES, brought up to the root before its
  ;;; engine reads the store again. The scheduler does this at a quantum's
  ;;; start; inside one, a write this thread acknowledged, an inline task or
  ;;; a foreign call can have put names in the store that the task's
  ;;; machine has not seen. THE MAIN TASK'S MACHINE IS ITS OWN (3.62.1), as
  ;;; every task's is: for task 0 this synced the host's machine, the root
  ;;; itself and so nothing, and the main task came back from a foreign
  ;;; call reading another task's new atom as `<bad-atom>' (six runs in
  ;;; six: test/async.pl, `names').
  (static)
  (func coco_g_sync_here () (out void)
        (if (or (== green_now nil) (== green_me nil)) (return))
        (let ((int cur . #'(-> green_me cur)))
          (if (< cur 0) (return))
          (let ((green_thread * t . #'(aof (nth cur (-> green_now threads)))))
            (if (!= (-> t m) nil) (coco_tbl_sync (-> t m))))))

  ;;; ---- the pre-write barrier --------------------------------------------

  ;;; W HAS SEEN THE WRITE IN FLIGHT (the caller holds the lock; OP is not
  ;;; W's own and W has not seen it before). Answers the write's sequence,
  ;;; which the caller waits on: the op is the writer's to free.
  ;;;
  ;;; ONLY A WORKER THE WRITE COUNTED ACKNOWLEDGES IT (3.62.1). A worker
  ;;; inside a foreign call is left out of the write's NEED, and on its
  ;;; return it waits for the write to clear -- but through 3.62.0 it also
  ;;; added an acknowledgement, which the writer took for a counted
  ;;; worker's: with one worker counted and still running, the returning
  ;;; one made the count and THE WRITE BEGAN UNDER A TASK THAT HAD NOT
  ;;; STOPPED. That task read the store as it changed, and read what the
  ;;; write stored before its own tables knew the names (`<bad-atom>',
  ;;; twenty runs in twenty of a main task in and out of a foreign call
  ;;; beside a writer and a reader: test/async.pl, `foreign_ack').
  (static)
  (func coco_g_ack ((green_world * wd) (green_worker * w) (green_op * op)) (out int)
        (let ((int oseq . #'(-> op seq)))
          (set (-> w applied_seq) oseq)
          (if (== (-> w asked) oseq)
              (block
               (set (-> op acks) (+ (-> op acks) 1))
               (if (>= (-> op acks) (-> op need))
                   (pthread_cond_broadcast (aof (-> wd op_done))))))
          (return oseq)))

  ;;; THE PRE-WRITE BARRIER (2.9.0). A store write takes it BEFORE the
  ;;; store call: every other worker acknowledges at its safe point and
  ;;; WAITS; the writer changes the one shared store with no lock held;
  ;;; the end releases them. A nested write is already inside it and
  ;;; skips. The end is a let's `(defer () ...)', so a failed write or a
  ;;; raise inside it still releases the world.
  ;;;
  ;;; THE BARRIER HOLDS TO THE WORLD'S LAST WORKER (3.62.1). Through 3.62.0
  ;;; a write made as the world ended asked `main_done' WITHOUT THE LOCK
  ;;; and, finding it clear, published a write whose NEED counted workers
  ;;; that had left their loops a moment before -- the host among them,
  ;;; already in pthread_join -- so no acknowledgement came, the writer
  ;;; slept on `op_done' for ever and the join with it: async_run/1 never
  ;;; returned (3 runs in 40 of a channel and one child, 10 in 40 with
  ;;; library(thread) loaded: test/async.pl, `world_end'). A worker that
  ;;; has left says so under the lock (`gone'), in the hold that found
  ;;; nothing to acknowledge, and a write counts only the workers still in
  ;;; their loops; one made after the main task ended stops those as any
  ;;; other does, where it used to take no barrier at all.
  ;;;
  ;;; WHAT LANDED WHILE THIS THREAD WAITED IS READ WITH THE NAMES IT WAS
  ;;; WRITTEN WITH (3.62.1). A task that acknowledges another's write
  ;;; here goes on in the same quantum, and its machine's name and value
  ;;; tables were last synced when the quantum began: the atom the other
  ;;; task interned and then stored read as `<bad-atom>', its float and its
  ;;; big integer as another machine's stale array held them (a wrong
  ;;; number, one run in six a SIGSEGV: test/async.pl, `names'). The
  ;;; loop's own acknowledgement needs none: the next quantum syncs.
  (func coco_g_write_begin ((void * ev)) (out int)
        (if (or (== green_now nil) (== green_me nil)) (return 0))
        (if (!= green_in_write 0) (return 0))
        (let ((int acked . 0))
        (pthread_mutex_lock (aof (-> green_now lock)))
        (while (!= (-> green_now op) nil)
          ;; ACKNOWLEDGE WHAT IS IN FLIGHT BEFORE WAITING FOR IT TO CLEAR.
          ;; A task that is inside a store call can not reach the worker
          ;; loop's ack, and the op's writer may be waiting for exactly
          ;; this worker's acknowledgement -- the two-writer deadlock
          ;; test/async.pl found: worker 0 in the acks wait, worker 1's
          ;; task at this wait. Acking here is honest: this thread has not
          ;; touched the store and waits for the op to end before it does.
          (let ((green_op * opx . #'(-> green_now op)))
            (if (and (!= (-> opx writer) (-> green_me id))
                     (!= (-> green_me applied_seq) (-> opx seq)))
                (block
                 (set acked 1)
                 (coco_g_ack green_now green_me opx))))
          (pthread_cond_wait (aof (-> green_now op_done))
                             (aof (-> green_now lock))))
        (let ((green_op * op . #'(aof (-> green_now op_one))))
          (set (-> op writer) (-> green_me id))
          (set (-> green_now op_seq) (+ (-> green_now op_seq) 1))
          (set (-> op seq) (-> green_now op_seq))
          (set (-> op acks) 0)
          ;; A WORKER AWAY IN A NON-STORE FOREIGN CALL IS NOT ASKED: it
          ;; cannot reach a safe point, it is not reading the store, and
          ;; `coco_g_foreign_end' will acknowledge any write still in
          ;; flight before that worker reads the store again. NOR IS ONE
          ;; THAT HAS LEFT ITS LOOP (`gone'): it reads the store no more.
          (let ((int need . 0))
            (for ((int i . 0)) (< i (-> green_now nworkers)) ((++ i))
              (let ((green_worker * wi . #'(aof (nth i (-> green_now workers)))))
                (if (and (!= (-> wi id) (-> green_me id))
                         (and (== (-> wi foreign) 0) (== (-> wi gone) 0)))
                    (block (set (-> wi asked) (-> op seq))
                           (set need (+ need 1))))))
            (set (-> op need) need))
          (set (-> green_now op) op)
          (for ((int i . 0)) (< i (-> green_now nworkers)) ((++ i))
            (let ((green_worker * wi . #'(aof (nth i (-> green_now workers)))))
              (coco_g_poke wi)))
          (while (< (-> op acks) (-> op need))
            (pthread_cond_wait (aof (-> green_now op_done))
                               (aof (-> green_now lock))))
          (pthread_mutex_unlock (aof (-> green_now lock))))
        (if acked (coco_g_sync_here)))
        (set green_in_write 1)
        (return 1))

  (func coco_g_write_end () (out void)
        (if (== green_in_write 0) (return))
        (set green_in_write 0)
        (if (== green_now nil) (return))
        (pthread_mutex_lock (aof (-> green_now lock)))
        (if (!= (-> green_now op) nil)
            (block
             (set (-> green_now op) nil)
             (pthread_cond_broadcast (aof (-> green_now op_done)))))
        (pthread_mutex_unlock (aof (-> green_now lock))))

  ;;; THE CLEANUP-ATTRIBUTE FORM: bound with `(defer () ...)' on the
  ;;; barrier's let variable, the C runs it on EVERY exit from the scope,
  ;;; the early returns included; the plain `(defer () (forms))' form ran
  ;;; only at the block's normal end, and a failed store or a `return 1'
  ;;; left the world stopped (found by test/async.pl's first case).
  ;;;
  ;;; ONLY THE SCOPE THAT BECAME THE WRITER ENDS THE BARRIER. A store
  ;;; call nested inside another's barrier -- `coco_pred_dynamic' inside
  ;;; `assertz''s, a predicate's creation inside its put -- got `began' 0
  ;;; from `coco_g_write_begin' and used to call the end anyway: it freed
  ;;; the OUTER op, woke every worker, and the rest of the outer write ran
  ;;; beside other writers (six of 480 asserts lost, a whole predicate
  ;;; sometimes, found by a concurrent stress).
  (func coco_g_write_end_cleanup ((int * began)) (out void)
        (if (or (== began nil) (== (nth 0 began) 0)) (return))
        (coco_g_write_end))

  ;;; ---- the scheduler ---------------------------------------------------

  (static)
  (func coco_g_pick ((green_worker * w)) (out int)
        (let ((green_world * wd . #'(cast (green_world *) (-> w w))))
          (for ((int k . 1)) (<= k (-> wd nthreads)) ((++ k))
            (let ((int i . #'(% (+ (-> w cursor) k) (-> wd nthreads)))
                  (green_thread * t . #'(aof (nth i (-> wd threads)))))
              (if (and (== (-> t state) 0) (== (-> t worker) (-> w id)))
                  (block (set (-> w cursor) i) (return i)))))
          (return -1)))

  ;;; RUN ONE TASK FOR ONE QUANTUM. The engine's limit is not an error: the
  ;;; GREENQ path stopped it with GSTOP and its continuation is intact. On
  ;;; a real error the ball is the status; on a solution the goal as
  ;;; instantiated is. The world lock is TAKEN ONLY after the engine stops;
  ;;; the tasks run in parallel.
  (static)
  (func coco_g_run ((green_worker * w) (int ti))
        (let ((green_world * wd . #'(cast (green_world *) (-> w w)))
              (green_thread * t . #'(aof (nth ti (-> wd threads)))))
          (if (== (-> t made) 0)
              (if (not (coco_g_prepare w t))
                  (block
                   (pthread_mutex_lock (aof (-> wd lock)))
                   (coco_g_finish wd t (-> t status))
                   (pthread_mutex_unlock (aof (-> wd lock)))
                   (return))))
          (let ((coco_machine * m . #'(-> t m))
                (coco_engine * en . #'(-> t e)))
            (coco_tbl_sync m)
            (set (-> en max_steps) (+ (-> en steps) (-> wd quantum)))
            ;; WHAT THE TASK WAS WOKEN WITH GOES INTO ITS CELL: the status of
            ;; the task it awaited, read where that task left it (`awaited',
            ;; `coco_g_wake'), or the text a channel handed it.
            ;;
            ;; A TASK THAT CANNOT BE HANDED IT ENDS (3.62.3), its status
            ;; resource_error(memory). Through 3.62.2 the answer of the read
            ;; was not asked: the task ran on with the cell unbound, and
            ;; library(async) took an unbound status for an answer.
            (if (!= (-> t resume_text) nil)
                (let ((char * text . #'(-> t resume_text))
                      (int msg . #'(-> t resume_msg))
                      (int got . 0))
                  (set (-> t resume_text) nil)
                  (set (-> t resume_msg) 0)
                  (if (== text (coco-g-text awaited))
                      (block
                       (set got (coco_g_resume
                                 m (-> t resume_cell)
                                 ($ (nth (-> t wait_on) (-> wd threads)) status) 0))
                       (set (-> t wait_on) -1))
                    (block
                     (set got (coco_g_resume m (-> t resume_cell) text msg))
                     (coco_g_text_free text)))
                  (if (< got 0)
                      (block
                       (pthread_mutex_lock (aof (-> wd lock)))
                       (coco_g_finish wd t (coco-g-text memory))
                       (pthread_mutex_unlock (aof (-> wd lock)))
                       (return)))))
            (let ((int rc . #'(coco_engine_next en)))
              ;; a task's goal answers once: what it left is cut, a cleanup
              ;; run with `!' (3.1.0) -- before the world's lock, which a
              ;; cleanup's own goals may want
              (if (== rc 1) (coco_engine_cut en))
              (pthread_mutex_lock (aof (-> wd lock)))
              (cond
                  ;; A HALT IS THE PROCESS'S (3.62.1; swipl's halt/1 ends
                  ;; the process from whatever called Prolog, and 3.57.0's
                  ;; rule is that every starter of an engine hands one up).
                  ;; The world ends, and async_run/1,2 gives the halt to the
                  ;; engine that called it. Through 3.62.0 the task was read
                  ;; as failed and the program went on past its halt/1. A
                  ;; halt AFTER the world's end is a task abandoned inside a
                  ;; nested wait (`coco_g_abandon'), and nobody's halt.
                  ((== (-> en halted) 1)
                   (block
                    (if (== (-> wd main_done) 0)
                        (block (set (-> wd halt) 1)
                               (set (-> wd halt_code) (-> en halt_code))))
                    (set (-> en gstop) 0)
                    (coco_g_finish wd t (coco-g-text failed))
                    (coco_g_end wd)))
                  ;; A MACHINE THAT WAS REFUSED MEMORY OUTRIGHT IS FINISHED
                  ;; (`oom': a growth refused even as little as was needed,
                  ;; and whatever was built after it may be nonsense), and
                  ;; so is a run the engine ended for want of it. THE TASK
                  ;; ENDS WITH resource_error(memory), whatever its run
                  ;; answered (3.62.3): its awaiter raises that. Through
                  ;; 3.62.2 it was `system_error' where the run ended so,
                  ;; and where it answered, a status written from a heap
                  ;; that could not be trusted.
                  ((or (!= (-> m oom) 0)
                       (and (< rc 0)
                            (and (not (-> en has_ball))
                                 (== 0 (strncmp (-> en err) "out of memory" 13)))))
                   (block
                    (set (-> en gstop) 0)
                    (coco_g_finish wd t (coco-g-text memory))))
                  ;; THE QUANTUM'S STOP IS NOT AN ERROR: the limit path saw
                  ;; GREENQ and set GSTOP, and the engine reports it as its
                  ;; limit (-1). The continuation is intact; the task is
                  ;; ready.
                  ((== (-> en gstop) 1)
                   (block
                    (set (-> en gstop) 0)
                    (set (-> t state) 0)
                    (set (-> t block) 0)))
                  ((== rc 1)
                   (coco_g_finish wd t (coco_g_ok_text m (-> en query))))
                  ((== rc 0)
                   ;; A WAKER MAY HAVE GOT HERE BETWEEN THE BUILTIN'S
                   ;; UNLOCK AND THIS LOCK: it set resume_text, the state 0
                   ;; and the block 0. Leave the task ready for its next
                   ;; run (which applies the text); do NOT read the cleared
                   ;; block as a failed goal.
                   (if (!= (-> t resume_text) nil)
                       (set (-> t state) (-> t state))
                     (if (!= (-> t block) 0)
                         (block
                          (if (== (-> t block) 4)
                              (block (set (-> t state) 0) (set (-> t block) 0))
                            (block
                             (set (-> t state) 1)
                             ;; A BLOCK CAN LEAVE THE WORLD DEAD and no pick
                             ;; may find it: ask here too.
                             (coco_g_deadlock wd))))
                       (coco_g_finish wd t (coco-g-text failed)))))
                  (#t
                   (if (-> en has_ball)
                       (let ((coco_store * bst . #'(? (== (-> en ball_st) nil)
                                                      (-> t st)
                                                      (cast (coco_store *) (-> en ball_st))))
                             (size_t ball . #'(coco_store_read m bst (-> en ball_cell))))
                         (if (!= bst (-> t st))
                             (block (set (-> bst len) (-> en ball_mark))
                                    (coco_store_shrink_empty bst)))
                         (coco_g_finish wd t (coco_g_error_text m ball)))
                     (coco_g_finish wd t (coco-g-text system)))))
              (pthread_mutex_unlock (aof (-> wd lock)))))))

  ;;; ---- blocking inside a nested engine --------------------------------
  ;;;
  ;;; findall/3 (and forall/2, aggregate_all/3, call_limited/3, which are
  ;;; the same nested engine) cannot be suspended: its search lives on a
  ;;; C stack that a green yield does not carry. An `await' that blocked
  ;;; there used to return from the sub-engine as "no more solutions",
  ;; so the await failed and its answer was lost -- every task placed
  ;;; back on worker 0, the main's own, after the other workers had taken
  ;;; one each. The two helpers here wait INSIDE the builtin instead: the
  ;;; worker keeps its C frame, runs whatever is ready on its own queue,
  ;;; and returns the answer when it comes. The normal path is untouched;
  ;;; a task outside a nested engine still yields its worker.

  (static)
  (func coco_g_nested ((coco_engine * e)) (out int)
        (if (== (-> green_now host_e) e) (return 0))
        (let ((green_thread * t . #'(aof (nth (-> green_me cur)
                                              (-> green_now threads)))))
          (if (and (!= (-> t e) nil) (== (-> t e) e)) (return 0)))
        (return 1))

  ;;; WHETHER ANYTHING CAN STILL MOVE WITHOUT THE CALLER, a nested waiter
  ;;; on worker W: a task ready or running, or ANOTHER worker's nested
  ;;; waiter whose wait is over -- its text is there, or the task it awaits
  ;;; has ended -- and whose thread is about to wake (3.62.1; a waiter is
  ;;; state 3 until it returns, and counted as nothing it made the caller
  ;;; call the world dead in the moment between its answer and its
  ;;; waking). A nested waiter of the caller's OWN worker is below the
  ;;; caller on the one C stack, and moves only when the caller returns.
  (static)
  (func coco_g_live ((green_world * wd) (green_worker * w)) (out int)
        (for ((int i . 0)) (< i (-> wd nthreads)) ((++ i))
          (let ((green_thread * t . #'(aof (nth i (-> wd threads)))))
            (if (== (-> t state) 0) (return 1))
            (if (and (== (-> t state) 3) (!= (-> t worker) (-> w id)))
                (block
                 (if (!= (-> t resume_text) nil) (return 1))
                 (if (and (>= (-> t wait_on) 0)
                          (== ($ (nth (-> t wait_on) (-> wd threads)) state) 2))
                     (return 1))))))
        (return 0))

  ;; caller holds the world lock; returns with it held, having run one
  ;; ready task pinned to this worker, or 0 when there was none
  (static)
  (func coco_g_run_ready ((green_world * wd) (green_worker * w)
                          (int self_id) (coco_machine * mine)) (out int)
        (let ((int ti . #'(coco_g_pick w)))
          (if (< ti 0) (return 0))
          (set (-> w cur) ti)
          (pthread_mutex_unlock (aof (-> wd lock)))
          (coco_g_run w ti)
          ;; THE INLINE TASK MAY HAVE GROWN THE SHARED TABLES. The normal
          ;; scheduler syncs at the start of a quantum; this caller is
          ;; still inside its own, so it must sync here before its engine
          ;; reads a table again.
          (coco_tbl_sync mine)
          (pthread_mutex_lock (aof (-> wd lock)))
          (set (-> w cur) self_id)
          (return 1)))

  ;; ACKNOWLEDGE A WRITE IN FLIGHT while waiting in a nested engine. This
  ;; thread is not touching the store -- it is inside a builtin waiting for
  ;; another task -- so it is a safe point like the worker loop's. Without
  ;; this the writer waited for an ack the nested wait never sent, and the
  ;; two held each other (found by a channel inside findall on four
  ;; workers: the sender compiled a clause under the barrier, the main
  ;; waited for the sender).
  (static)
  (func coco_g_ack_wait ((green_world * wd) (green_worker * w)) (out int)
        (let ((green_op * op . #'(-> wd op)))
          (if (== op nil) (return 0))
          (if (or (== (-> op writer) (-> w id))
                  (== (-> w applied_seq) (-> op seq)))
              (return 0))
          (let ((int oseq . #'(coco_g_ack wd w op)))
            (while (and (!= (-> wd op) nil)
                        (== (-> (-> wd op) seq) oseq))
              (pthread_cond_wait (aof (-> wd op_done))
                                 (aof (-> wd lock))))
            (return 1))))

  ;;; THE FOREIGN-CALL HANDSHAKE (2.10.1). A module wraps a C call that may
  ;;; block and does NOT read or write the store -- raylib's EndDrawing is
  ;;; the first. A write need not wait for this worker: its count is
  ;;; excluded from the barrier's NEED. On return the counter drops and
  ;;; any write still in flight is waited for, so the worker does not read
  ;;; the store while it changes -- waited for, and acknowledged only if it
  ;;; counted this worker (`coco_g_ack': a write published while the call
  ;;; ran did not). A call that DOES touch the store must not use this
  ;;; pair.
  (func coco_g_foreign_begin () (out void)
        (if (== green_now nil) (return))
        (if (== green_me nil) (return))
        (coco_g_sync_here)
        ;; inside a store mutation the worker already holds the barrier
        (if (!= green_in_write 0) (return))
        (pthread_mutex_lock (aof (-> green_now lock)))
        ;; A WRITE ALREADY COUNTING THIS WORKER gets its ack before the
        ;; worker leaves for the call: the writer may have read FOREIGN as 0
        ;; a moment ago, and would otherwise wait for a worker that is now
        ;; asleep in a non-store call. The wait is the write's, not the call's.
        ;;
        ;; EVERY SUCH WRITE, NOT THE FIRST (3.62.1). The wait for one write
        ;; to clear gives the lock up, and the next writer in line publishes
        ;; in that moment, counting this worker, which had not said it was
        ;; away yet. Asked once, the worker left for its call with that
        ;; second write unanswered, and the writer waited for the call to
        ;; return: a stopped world for as long as a sleep lasts, and for
        ;; ever where the call waits for the writer -- a mutex_lock/1 of the
        ;; mutex the writer holds (ten runs in ten of three tasks:
        ;; test/async.pl, `foreign_begin').
        (let ((int more . 1))
          (while more
            (set more (coco_g_ack_wait green_now green_me))))
        (set (-> green_me foreign) (+ (-> green_me foreign) 1))
        (pthread_mutex_unlock (aof (-> green_now lock))))

  (func coco_g_foreign_end () (out void)
        (if (== green_now nil) (return))
        (if (== green_me nil) (return))
        (pthread_mutex_lock (aof (-> green_now lock)))
        (if (> (-> green_me foreign) 0)
            (block
             (set (-> green_me foreign) (- (-> green_me foreign) 1))
             (if (== (-> green_me foreign) 0)
                 (coco_g_ack_wait green_now green_me))))
        (pthread_mutex_unlock (aof (-> green_now lock)))
        (coco_g_sync_here))

  ;; the `(defer () ...)' form passes the address of the binding it is
  ;; attached to; this is for callers that want the end on every exit
  (func coco_g_foreign_end_cleanup ((int * began)) (out void)
        (coco_g_foreign_end))

  (static)
  (func coco_g_deadlock_error ((coco_engine * e)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (return (coco_raise e (coco_make1
                                 m "resource_error"
                                 (coco_new_atom m "deadlock"))))))

  ;;; A NESTED WAIT IS OVER (the caller holds the lock): answered, given
  ;;; up, or abandoned. A waiter that was not served LEAVES THE CHANNEL IT
  ;;; STOOD IN (3.62.1): left there, the next send found it, handed it the
  ;;; message nobody was waiting for and wrote it, at that task's next run,
  ;;; into the cell of a wait long over.
  (static)
  (func coco_g_wait_leave ((green_world * wd) (green_thread * self))
        (if (>= (-> self chan) 0)
            (coco_g_chan_drop (aof (nth (-> self chan) (-> wd chans))) (-> self id)))
        (if (!= (-> self send_text) nil)
            (block (free (-> self send_text)) (set (-> self send_text) nil)))
        (set (-> self state) 0)
        (set (-> self block) 0)
        (set (-> self chan) -1)
        (set (-> self wait_on) -1))

  ;;; THE WORLD ENDED UNDER A NESTED WAIT (3.62.1). The wait cannot be
  ;;; answered and the search around it cannot be suspended, so the task is
  ;;; stopped as a halt stops one: no catch/3 takes it, no cleanup runs,
  ;;; and each engine out to the task's own stops at its next step
  ;;; (`coco_halt_up'), whatever the search was in the middle of.
  ;;; `coco_g_run' reads a halt after the world's end as a task abandoned.
  ;;; Through 3.62.0 the waiter saw another task still marked ready -- one
  ;;; whose worker had already left -- and slept for ever, and async_run/1
  ;;; with it, in pthread_join (test/async.pl, `world_end').
  (static)
  (func coco_g_abandon ((coco_engine * e)) (out int)
        (set (-> e halted) 1)
        (set (-> e halt_code) 0)
        (return 1))

  ;;; THE TWO NESTED WAITS, one body: an await's (ID the awaited task, 0 or
  ;;; more) and a channel's (ID -1, the answer the text a sender, a
  ;;; receiver or a close leaves). The waiter is state 3 from its first
  ;;; line to its last and nobody else's to run.
  (static)
  (func coco_g_wait_nested ((coco_engine * e) (int id) (size_t sc)) (out int)
        (let ((green_world * wd . green_now)
              (green_worker * w . green_me)
              (int self_id . #'(-> w cur))
              (green_thread * self . nil)
              (int rc . 1))
          (pthread_mutex_lock (aof (-> wd lock)))
          (set self (aof (nth self_id (-> wd threads))))
          (set (-> self state) 3)
          (set (-> self wait_on) id)
          (while 1
            ;; answered: the awaited task ended, or the text is here. THE
            ;; TEXT IS READ WITH THE LOCK GIVEN BACK (3.62.3): a status
            ;; stands where its task left it until the world ends, and a
            ;; text handed over is this task's own.
            (let ((char * text . #'(? (>= id 0)
                                      (? (== ($ (nth id (-> wd threads)) state) 2)
                                         ($ (nth id (-> wd threads)) status) nil)
                                      (-> self resume_text))))
              (if (!= text nil)
                  (let ((int msg . #'(? (< id 0) (-> self resume_msg) 0)))
                   (if (< id 0)
                       (block (set (-> self resume_text) nil)
                              (set (-> self resume_msg) 0)))
                   (coco_g_wait_leave wd self)
                   (pthread_mutex_unlock (aof (-> wd lock)))
                   (set rc (coco_g_answer e sc text msg))
                   (if (< id 0) (coco_g_text_free text))
                   (return rc))))
            (if (!= (coco_g_ack_wait wd w) 0) (continue))
            (if (== (-> wd main_done) 1)
                (block
                 (coco_g_wait_leave wd self)
                 (pthread_mutex_unlock (aof (-> wd lock)))
                 (return (coco_g_abandon e))))
            ;; this worker's ready tasks are the waiter's to run: the
            ;; awaited one first
            (if (and (>= id 0)
                     (and (== ($ (nth id (-> wd threads)) state) 0)
                          (== ($ (nth id (-> wd threads)) worker) (-> w id))))
                (block
                 (set (-> w cur) id)
                 (pthread_mutex_unlock (aof (-> wd lock)))
                 (coco_g_run w id)
                 (coco_tbl_sync (-> e m))
                 (pthread_mutex_lock (aof (-> wd lock)))
                 (set (-> w cur) self_id)
                 continue))
            (if (!= (coco_g_run_ready wd w self_id (-> e m)) 0) (continue))
            (if (== (coco_g_live wd w) 0)
                (block
                 (coco_g_wait_leave wd self)
                 (pthread_mutex_unlock (aof (-> wd lock)))
                 ;; a write acknowledged in this wait: its names first
                 (coco_tbl_sync (-> e m))
                 (return (coco_g_deadlock_error e))))
            (pthread_cond_wait (aof (-> wd changed)) (aof (-> wd lock))))
          (return 1)))

  ;;; ONE WORKER'S LOOP: a write in flight first, then the world's end,
  ;;; then a task of its own, then sleep until somebody wakes it.
  ;;;
  ;;; THE ACKNOWLEDGEMENT COMES BEFORE THE END IS ASKED (3.62.1), and the
  ;;; worker says it has left (`gone') in the same hold of the lock: a
  ;;; write published before this worker looked is acknowledged, and one
  ;;; published after does not count it. The end is asked BEFORE the pick:
  ;;; the main task has ended, and what else is ready stays where it is.
  (static)
  (func coco_g_worker_loop ((green_worker * w))
        (let ((green_world * wd . #'(cast (green_world *) (-> w w))))
          (set green_me w)
          (set green_now wd)
          ;; the names' lock and generation are each thread's to know
          (coco_tbl_set (aof (-> wd tbl_mx)) (aof (-> wd tbl_gen)))
          (while 1
            (pthread_mutex_lock (aof (-> wd lock)))
            (let ((green_op * op . #'(-> wd op)))
              (if (and (!= op nil) (!= (-> op writer) (-> w id))
                       (!= (-> w applied_seq) (-> op seq)))
                  (block
                   ;; THE PRE-WRITE BARRIER: acknowledge and WAIT until the
                   ;; writer has finished its change to the one store.
                   ;; THE SEQUENCE IS TAKEN AS AN INT, never read again
                   ;; through the op pointer: the next write's record is at
                   ;; the same address (the world's one since 3.62.3; a
                   ;; calloc that handed the freed one's address back before
                   ;; it) -- a captured pointer then reads the NEW op's
                   ;; sequence, and the wait below (comparing that pointer
                   ;; with wd->op) sleeps through the new op instead of
                   ;; acknowledging it (the ABA that hung the light lane,
                   ;; found by the barrier's trace: seq 2 published, zero
                   ;; acks, every worker at the ack wait).
                   (let ((int oseq . #'(coco_g_ack wd w op)))
                     (while (and (!= (-> wd op) nil)
                                 (== (-> (-> wd op) seq) oseq))
                       (pthread_cond_wait (aof (-> wd op_done))
                                          (aof (-> wd lock)))))
                   (pthread_mutex_unlock (aof (-> wd lock)))
                   (continue))))
            (if (== (-> wd main_done) 1)
                (block (set (-> w gone) 1)
                       (pthread_mutex_unlock (aof (-> wd lock)))
                       (break)))
            (let ((int ti . #'(coco_g_pick w)))
              (if (>= ti 0)
                  (block
                   (set (-> w cur) ti)
                   (pthread_mutex_unlock (aof (-> wd lock)))
                   (coco_g_run w ti)
                   (pthread_mutex_lock (aof (-> wd lock)))
                   (set (-> w cur) -1)
                   (pthread_mutex_unlock (aof (-> wd lock)))
                   (continue))))
            ;; NOTHING OF THIS WORKER'S IS READY: the deadlock, if every
            ;; task is blocked and the main has not ended. Asked HERE, not
            ;; after each run: a run ends with a task ready or blocked, and
            ;; the world is only dead when no worker can find a task at all.
            ;; A world it calls dead is ending, and the loop's top leaves.
            (coco_g_deadlock wd)
            ;; A SIGNAL MAY HAVE ARRIVED SINCE THE PICK: do not sleep on it
            ;; -- the generation is under the lock. NEVER SLEEP WITH A WRITE
            ;; IN FLIGHT: the op may be published between the loop's check
            ;; and this wait, and its signal then targets a sleeping worker
            ;; that never acks (the light-lane hang).
            (if (and (== (-> wd main_done) 0)
                     (and (== (-> w wgen) (-> w wseen)) (== (-> wd op) nil)))
                (pthread_cond_wait (aof (-> w wake)) (aof (-> wd lock))))
            (set (-> w wseen) (-> w wgen))
            (pthread_mutex_unlock (aof (-> wd lock))))))

  (static)
  (func coco_g_worker_body ((void * arg)) (out void *)
        (coco_g_worker_loop (cast (green_worker *) arg))
        ;; this thread holds the world's names no more: the process counts
        ;; the threads that do (`coco_tbl_live'), and a count left behind
        ;; would have every later intern of the process ask its thread
        (coco_tbl_set nil nil)
        (return nil))

  ;;; ---- spawning --------------------------------------------------------

  (static)
  (func coco_g_spawn ((green_world * wd) (char * text)) (out int)
        (if (>= (-> wd nthreads) (-> wd cap)) (return -1))
        (let ((int id . #'(-> wd nthreads))
              (int target . #'(-> wd next_worker)))
          (set (-> wd next_worker) (% (+ target 1) (-> wd nworkers)))
          (let ((green_thread * t . #'(aof (nth id (-> wd threads)))))
            (memset t 0 (sizeof green_thread))
            (set (-> t id) id)
            (set (-> t worker) target)
            (set (-> t state) 0)
            (set (-> t wait_on) -1)
            (set (-> t chan) -1)
            (set (-> t goal) text)
            (set (-> wd nthreads) (+ (-> wd nthreads) 1))
            (let ((green_worker * tw . #'(aof (nth target (-> wd workers)))))
              (coco_g_poke tw))
            (return id))))

  ;;; ---- channels (the caller holds the world lock) ----------------------

  ;;; A NEW CHANNEL'S SLOT, -1 for a world with 64 already, or -2 for A
  ;;; BUFFER THERE IS NO MEMORY FOR (3.62.3), which is no channel: the
  ;;; `calloc' was not asked, and the first send put its text through the
  ;;; null. And a size past an int's is one of those: it was cut to an int,
  ;;; a negative one as often as not, which made a rendezvous of a channel
  ;;; asked for with room.
  (static)
  (func coco_g_chan_new ((green_world * wd) (i64 size)) (out int)
        (if (>= (-> wd nchans) 64) (return -1))
        (if (< size 0) (set size 0))
        (if (> size 2147483647) (return -2))
        (let ((green_chan * c . #'(aof (nth (-> wd nchans) (-> wd chans))))
              (coco_strptr buf . nil))
          (if (> size 0)
              (block
               (set buf (cast coco_strptr (calloc (cast size_t size) (sizeof (char *)))))
               (if (== buf nil) (return -2))))
          (memset c 0 (sizeof green_chan))
          (set (-> c size) (cast int size))
          (set (-> c cap) (cast int size))
          (set (-> c buf) buf)
          (set (-> wd nchans) (+ (-> wd nchans) 1))
          (return (- (-> wd nchans) 1))))

  (static)
  (func coco_g_chan_close ((green_world * wd) (green_chan * c))
        (set (-> c closed) 1)
        (for ((int i . 0)) (< i (-> c nsenders)) ((++ i))
          (let ((green_thread * t . #'(aof (nth (nth i (-> c senders)) (-> wd threads)))))
            (if (!= (-> t send_text) nil)
                (block (free (-> t send_text)) (set (-> t send_text) nil)))
            (coco_g_serve wd t (coco-g-text send-closed) 0)))
        (set (-> c nsenders) 0)
        (for ((int i . 0)) (< i (-> c nreceivers)) ((++ i))
          (coco_g_serve wd (aof (nth (nth i (-> c receivers)) (-> wd threads)))
                        (coco-g-text closed) 0))
        (set (-> c nreceivers) 0))

  ;;; A sender waiting on a full buffer takes the slot a receive freed.
  (static)
  (func coco_g_move_sender ((green_world * wd) (green_chan * c))
        (if (and (> (-> c nsenders) 0) (> (-> c cap) 0)
                 (< (-> c count) (-> c cap)))
            (block
             (let ((int si . #'(nth 0 (-> c senders))))
              (let ((green_thread * st . #'(aof (nth si (-> wd threads)))))
               (set (nth (% (+ (-> c head) (-> c count)) (-> c cap))
                         (-> c buf))
                    (-> st send_text))
               (set (-> c count) (+ (-> c count) 1))
               (set (-> st send_text) nil)
               (coco_g_serve wd st (coco-g-text sent) 0)))
             (coco_g_chan_remove_sender c 0))))

  ;;; ---- the builtins ----------------------------------------------------

  (static)
  (func coco_g_need ((coco_engine * e)) (out int)
        (if (== green_now nil)
            (return (coco_g_raise e "library(async): this needs async_run/1"))
          (return 1)))

  ;;; THE WORLD'S SIZE IS THE MACHINE'S (2.9.3): one worker a core, as Go's
  ;;; GOMAXPROCS defaults to NumCPU. `_SC_NPROCESSORS_ONLN' is a #define,
  ;;; invisible to Cicili, so it is spelled in the escape. The workers are
  ;;; allocated to the count (the task slots are not); COCOLOG_GREEN_WORKERS
  ;;; overrides it -- a benchmark arm, or a box whose affinity is narrower
  ;;; than its online cores. 256 is the ceiling: each worker is an OS thread
  ;;; and a condition variable, and past that the world buys no more cores.
  (static)
  (func coco_g_nworkers () (out int)
        (let ((const char * env . #'(getenv "COCOLOG_GREEN_WORKERS")))
          (if (!= env nil)
              (let ((llong n . #'(atoll env)))
                (if (> n 0)
                    (return (cast int (? (> n 256) 256 n)))))))
        (let ((long n . 0))
          (set n (code "sysconf(_SC_NPROCESSORS_ONLN)"))
          (if (< n 1) (set n 1))
          (if (> n 256) (set n 256))
          (return (cast int n))))

  ;;; async_workers/1 (2.15.0): THE WORLD'S SIZE, ASKED. Inside a world, the
  ;;; workers it has (every worker's thread holds its world in green_now,
  ;;; whatever COCOLOG_GREEN_WORKERS says since); outside one, the workers
  ;;; the next async_run/1 would start, by the rule above. A pool sized from
  ;;; the world asks this rather than working the rule out again
  ;;; (library(httpd)'s green mode, lesson 54's quantum).
  (func coco_g_async_workers ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (int n . #'(? (!= green_now nil) (-> green_now nworkers) (coco_g_nworkers))))
          (return (coco_unify m (coco_deref m (coco_arg m g 0))
                              (coco_new_int m (cast i64 n))))))

  (func coco_g_async_run ((coco_engine * e) (size_t g)) (out int)
        (if (!= green_now nil)
            (return (coco_g_raise e "library(async): async_run inside a green thread is not supported")))
        (let ((coco_machine * hm . #'(-> e m))
              (coco_store * hs . #'(-> e st))
              (size_t goal . #'(coco_deref hm (coco_arg hm g 0)))
              (size_t outc . #'(coco_deref hm (coco_arg hm g 1)))
              (char * gtext . #'(coco_g_write hm goal))
              (int nw . #'(coco_g_nworkers)))
          (if (== gtext nil) (return (coco_g_no_text e)))
          (let ((green_world * wd . #'(cast (green_world *)
                                           (calloc 1 (sizeof green_world))))
                (int got . 1))
            ;; A WORLD THERE IS NO MEMORY FOR IS NO WORLD (3.62.3): its four
            ;; blocks were not asked, and one refused was written through.
            (if (!= wd nil)
                (block
                 (set (-> wd threads) (cast (green_thread *)
                                            (calloc 1024 (sizeof green_thread))))
                 (set (-> wd chans) (cast (green_chan *)
                                          (calloc 64 (sizeof green_chan))))
                 (set (-> wd workers) (cast (green_worker *)
                                            (calloc nw (sizeof green_worker))))))
            (if (or (== wd nil)
                    (or (== (-> wd threads) nil)
                        (or (== (-> wd chans) nil) (== (-> wd workers) nil))))
                (block
                 (if (!= wd nil)
                     (block (free (cast (void *) (-> wd threads)))
                            (free (cast (void *) (-> wd chans)))
                            (free (cast (void *) (-> wd workers)))
                            (free wd)))
                 (free gtext)
                 (return (coco_mem_error e))))
            (set (-> wd cap) 1024)
            (set (-> wd quantum) 10000)
            (set (-> wd nworkers) nw)
            (set (-> wd host_st) hs)
            (set (-> wd host) hm)
            ;; the caller's own worker is 0; the first child goes to 1, so a
            ;; world of N spreads its children over the N-1 beside the host.
            ;; A world of ONE has no worker 1: the first child is worker 0's.
            (set (-> wd next_worker) (% 1 nw))
            (pthread_mutex_init (aof (-> wd lock)) nil)
            (pthread_cond_init (aof (-> wd op_done)) nil)
            (pthread_cond_init (aof (-> wd changed)) nil)
            (set (-> wd host_e) e)
            (pthread_mutex_init (aof (-> wd tbl_mx)) nil)
            (pthread_mutex_init (aof (-> wd mmx)) nil)
            ;; THE NAMES' LOCK IS THE WORLD'S THREADS' ALONE (3.62.1): each
            ;; of them is told (`coco_g_worker_loop'), and a thread that is
            ;; no part of this world -- a library(thread) thread beside it,
            ;; another world in another thread -- never takes it.
            (coco_tbl_set (aof (-> wd tbl_mx)) (aof (-> wd tbl_gen)))
            (for ((int i . 0)) (< i nw) ((++ i))
              (let ((green_worker * wi . #'(aof (nth i (-> wd workers)))))
                (set (-> wi id) i)
                (set (-> wi w) (cast (void *) wd))
                (set (-> wi cur) -1)
                (set (-> wi cursor) -1)
                (set (-> wi applied_seq) 0)
                (pthread_cond_init (aof (-> wi wake)) nil)))
            ;; ONE STORE (2.9.0): every worker is over the host's store and
            ;; the host's machine; its tasks alias the host's names there.
            (let ((green_worker * w0 . #'(aof (nth 0 (-> wd workers)))))
              (set (-> w0 st) hs)
              (set (-> w0 base) hm))
            (coco_g_store_link wd hs hm)
            (set (-> hm tshared) 1)
            ;; A WORKER'S C STACK IS NEVER UNDER 8 MB (3.60.1), what a
            ;; library(thread) thread is given: the system's default for a
            ;; thread otherwise -- RLIMIT_STACK's on Linux -- where macOS's
            ;; is 512 KB, and a task there could not write back an answer
            ;; some 10 000 levels deep that the main thread reads whole.
            ;;
            ;; THE WORLD IS AS WIDE AS THE THREADS IT WAS GIVEN (3.62.1): a
            ;; worker the system refuses (no memory for its stack, a thread
            ;; limit) ends the count there, before a task is pinned to
            ;; anybody. Unasked, a task was pinned to a worker that did not
            ;; exist and never ran, and the join waited on a thread that was
            ;; never made. The lock is held from the first thread to the
            ;; main task, so no worker meets a world with no task in it.
            (pthread_mutex_lock (aof (-> wd lock)))
            (let ((pthread_attr_t attr) (size_t ss . 0) (int made . 1))
              (pthread_attr_init (aof attr))
              (pthread_attr_getstacksize (aof attr) (aof ss))
              (if (< ss 8388608) (pthread_attr_setstacksize (aof attr) 8388608))
              (for ((int i . 1)) (< i nw) ((++ i))
                (let ((green_worker * wi . #'(aof (nth i (-> wd workers)))))
                  (set (-> wi st) hs)
                  (set (-> wi base) hm)
                  (if (!= 0 (pthread_create (aof (-> wi tid)) (aof attr) coco_g_worker_body
                                            (cast (void *) wi)))
                      break)
                  (set made (+ made 1))))
              (pthread_attr_destroy (aof attr))
              (set (-> wd nworkers) made)
              (set (-> wd next_worker) (% 1 made)))
            ;; the main task, id 0, on worker 0
            (let ((green_thread * mt . #'(aof (nth 0 (-> wd threads)))))
              (memset mt 0 (sizeof green_thread))
              (set (-> mt id) 0)
              (set (-> mt worker) 0)
              (set (-> mt state) 0)
              (set (-> mt wait_on) -1)
              (set (-> mt chan) -1)
              (set (-> mt goal) gtext)
              (set (-> wd nthreads) 1))
            (pthread_mutex_unlock (aof (-> wd lock)))
            ;; the host is worker 0
            (set green_now wd)
            (coco_g_worker_loop (aof (nth 0 (-> wd workers))))
            ;; THE WORLD HAS ENDED: every worker leaves at its next safe
            ;; point, a write in flight acknowledged first, and none counts
            ;; this thread any more (`gone').
            (for ((int i . 1)) (< i (-> wd nworkers)) ((++ i))
              (let ((green_worker * wi . #'(aof (nth i (-> wd workers)))))
                (pthread_join (-> wi tid) nil)))
            ;; the main task's status -- or the halt a task made, which is
            ;; this engine's now (`coco_halt_up''s rule). A STATUS THE
            ;; CALLER CANNOT BE HANDED IS RAISED (3.62.3), once the world is
            ;; taken down: unasked, async_run/2 came back with its answer
            ;; unbound.
            (if (-> wd halt)
                (block (set (-> e halted) 1)
                       (set (-> e halt_code) (-> wd halt_code)))
              (set got (coco_g_resume hm outc ($ (nth 0 (-> wd threads)) status) 0)))
            (set green_now nil)
            (set green_me nil)
            ;; free every task and the world
            (for ((int i . 0)) (< i (-> wd nthreads)) ((++ i))
              (let ((green_thread * t . #'(aof (nth i (-> wd threads)))))
                (coco_g_thread_free wd t)
                (coco_g_text_free (-> t status))
                (if (!= (-> t send_text) nil) (free (-> t send_text)))
                (coco_g_text_free (-> t resume_text))
                (if (!= (-> t goal) nil) (free (-> t goal)))))
            (for ((int i . 0)) (< i (-> wd nchans)) ((++ i))
              (let ((green_chan * c . #'(aof (nth i (-> wd chans)))))
                (if (!= (-> c buf) nil)
                    (block
                     (for ((int k . 0)) (< k (-> c count)) ((++ k))
                       (let ((int at . #'(% (+ (-> c head) k) (-> c cap))))
                         (if (!= (nth at (-> c buf)) nil)
                             (free (nth at (-> c buf))))))
                     (free (cast (void *) (-> c buf)))))))
            (coco_g_store_unlink wd hs hm)
            (set (-> hm tshared) 0)
            (for ((int i . 0)) (< i nw) ((++ i))
              (let ((green_worker * wi . #'(aof (nth i (-> wd workers)))))
                (pthread_cond_destroy (aof (-> wi wake)))))
            (coco_tbl_set nil nil)
            (pthread_cond_destroy (aof (-> wd op_done)))
            (pthread_cond_destroy (aof (-> wd changed)))
            (pthread_mutex_destroy (aof (-> wd lock)))
            (pthread_mutex_destroy (aof (-> wd tbl_mx)))
            (pthread_mutex_destroy (aof (-> wd mmx)))
            (free (cast (void *) (-> wd threads)))
            (free (cast (void *) (-> wd chans)))
            (free (cast (void *) (-> wd workers)))
            (free wd)
            (if (< got 0) (return (coco_mem_error e)))))
        (return 1))

  (func coco_g_async_go ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . #'(coco_g_need e)))
          (if (!= rc 1) (return rc)))
        (let ((coco_machine * m . #'(-> e m))
              (size_t goal . #'(coco_deref m (coco_arg m g 0)))
              (size_t idc . #'(coco_deref m (coco_arg m g 1))))
          (let ((char * gtext . #'(coco_g_write m goal)))
            (if (== gtext nil) (return (coco_g_no_text e)))
            (let ((green_world * wd . green_now) (int id . -1))
              (pthread_mutex_lock (aof (-> wd lock)))
              (set id (coco_g_spawn wd gtext))
              (pthread_mutex_unlock (aof (-> wd lock)))
              (if (< id 0)
                  (block (free gtext)
                         (return (coco_g_raise e "library(async): 1024 green threads already"))))
              (return (coco_unify m idc (coco_new_int m (cast i64 id))))))))

  (func coco_g_async_yield ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . #'(coco_g_need e)))
          (if (!= rc 1) (return rc)))
        ;; a nested engine cannot carry the yield; doing nothing is the
        ;; one honest answer, and it never loses an answer
        (if (coco_g_nested e) (return 1))
        (let ((green_world * wd . green_now))
          (pthread_mutex_lock (aof (-> wd lock)))
          (let ((green_thread * t . #'(aof (nth (-> green_me cur) (-> wd threads)))))
            (set (-> t block) 4)
            (set (-> e halted) 128))
          (pthread_mutex_unlock (aof (-> wd lock)))
          (return 1)))

  (func coco_g_foreign_sleep ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 ms . 0))
          (if (not (coco_m_int e (coco_m_arg e g 0) (aof ms)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
          (if (< ms 0) (set ms 0))
          (coco_g_foreign_begin)
          (usleep (cast useconds_t (* ms 1000)))
          (coco_g_foreign_end)
          (return 1)))

  (func coco_g_async_await ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . #'(coco_g_need e)))
          (if (!= rc 1) (return rc)))
        (let ((coco_machine * m . #'(-> e m))
              (i64 id . -1)
              (size_t sc . #'(coco_deref m (coco_arg m g 1))))
          (if (not (coco_m_int e (coco_deref m (coco_arg m g 0)) (aof id)))
              (return (coco_g_raise e "library(async): await/2 wants a thread id")))
          (let ((green_world * wd . green_now))
            (pthread_mutex_lock (aof (-> wd lock)))
            (if (or (< id 0) (>= id (-> wd nthreads)))
                (block (pthread_mutex_unlock (aof (-> wd lock)))
                       (return (coco_g_raise e "library(async): no such green thread")))
            (let ((green_thread * target . #'(aof (nth id (-> wd threads)))))
              (if (== (-> target state) 2)
                  ;; its status stands until the world ends: read with the
                  ;; lock given back, and the read's answer is the await's
                  ;; (3.62.3; unasked, an await that could not read its
                  ;; task's status succeeded with nothing bound)
                  (block
                   (pthread_mutex_unlock (aof (-> wd lock)))
                   (return (coco_g_answer e sc (-> target status) 0)))
                (if (coco_g_nested e)
                    (block
                     (pthread_mutex_unlock (aof (-> wd lock)))
                     (return (coco_g_wait_nested e (cast int id) sc)))
                  (let ((green_thread * t . #'(aof (nth (-> green_me cur)
                                                        (-> wd threads)))))
                    (set (-> t block) 1)
                    ;; THE STATE IS SET HERE, WITH THE BLOCK, UNDER THE LOCK: a
                    ;; target that finishes between this unlock and the run's
                    ;; rc-0 handler must find a waiter its wake can see. Set
                    ;; later, the wake missed it and the waiter slept on a
                    ;; done task -- the false deadlock light_green found.
                    (set (-> t state) 1)
                    (set (-> t wait_on) (cast int id))
                    (set (-> t resume_cell) sc)
                    (set (-> e halted) 128)
                    (pthread_mutex_unlock (aof (-> wd lock)))
                    (return 1)))))))))

  (func coco_g_async_ready ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . #'(coco_g_need e)))
          (if (!= rc 1) (return rc)))
        (let ((coco_machine * m . #'(-> e m)) (i64 id . -1) (int ready . 0))
          (if (not (coco_m_int e (coco_deref m (coco_arg m g 0)) (aof id)))
              (return 0))
          (let ((green_world * wd . green_now))
            (pthread_mutex_lock (aof (-> wd lock)))
            (if (and (>= id 0) (< id (-> wd nthreads)))
                (let ((green_thread * t . #'(aof (nth id (-> wd threads)))))
                  (set ready (? (== (-> t state) 2) 1 0))))
            (pthread_mutex_unlock (aof (-> wd lock))))
          (return ready)))

  ;;; A GREEN CHANNEL'S HANDLE IS ITS SLOT PLUS 1024 (2.9.4). library(thread)
  ;;; keeps its channels in a table of its own, 256 integer slots, and BOTH
  ;;; modules register channel_send/2, channel_recv/2,3 and channel_close/1:
  ;;; an integer handle from one is indistinguishable from the other's, and
  ;;; nothing in dispatch could tell them apart -- a green send could land in
  ;;; whatever thread channel held the same slot number. The thread module
  ;;; declines a channel that is not one of its own now (`:declines'), and
  ;;; that test needs handles it can tell apart: green's live above its
  ;;; table. ONE PLACE HERE converts, so the world's own code keeps using
  ;;; slots.
  (static)
  (func coco_g_chan_slot ((coco_engine * e) (size_t t)) (out int)
        (let ((i64 cid . -1))
          (if (not (coco_m_int e t (aof cid))) (return -1))
          (if (or (< cid 1024) (>= cid (+ 1024 (cast i64 (-> green_now nchans)))))
              (return -2))
          (return (cast int (- cid 1024)))))

  (func coco_g_async_channel ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . #'(coco_g_need e)))
          (if (!= rc 1) (return rc)))
        (let ((coco_machine * m . #'(-> e m)) (i64 n . 0) (int id . -1))
          (if (not (coco_m_int e (coco_deref m (coco_arg m g 0)) (aof n))) (set n 0))
          (let ((green_world * wd . green_now))
            (pthread_mutex_lock (aof (-> wd lock)))
            (set id (coco_g_chan_new wd n))
            (pthread_mutex_unlock (aof (-> wd lock))))
          (if (== id -2) (return (coco_mem_error e)))
          (if (< id 0) (return (coco_g_raise e "library(async): 64 channels already")))
          (return (coco_unify m (coco_deref m (coco_arg m g 1))
                              (coco_new_int m (+ 1024 (cast i64 id)))))))

  ;;; THE TERM'S TEXT IS WRITTEN BEFORE THE LOCK IS TAKEN, AND ONCE
  ;;; (3.62.3): it was written with the world's lock held, and written a
  ;;; second time, inside its status, for a receiver already waiting. A
  ;;; text there is no memory for is the send's own error, raised with
  ;;; nothing handed to anybody -- where the second write could fail after
  ;;; the first had not, and the receiver was served a nil. And the three
  ;;; answers a send gives at once are read from the statuses nobody
  ;;; allocates: each was a `strdup' never freed, one a send.
  (func coco_g_async_send ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . #'(coco_g_need e)))
          (if (!= rc 1) (return rc)))
        (let ((coco_machine * m . #'(-> e m)) (i64 cid . -1)
              (size_t term . #'(coco_deref m (coco_arg m g 1)))
              (size_t sc . #'(coco_deref m (coco_arg m g 2))))
          (let ((int slot . #'(coco_g_chan_slot e (coco_deref m (coco_arg m g 0)))))
            (if (== slot -1)
                (return (coco_g_raise e "library(async): channel_send/2 wants a channel")))
            (if (== slot -2)
                (return (coco_g_raise e "library(async): no such channel")))
            (set cid slot))
          (let ((green_world * wd . green_now)
                (char * text . #'(coco_g_write m term)))
            (if (== text nil) (return (coco_g_no_text e)))
            (pthread_mutex_lock (aof (-> wd lock)))
            (let ((green_chan * c . #'(aof (nth cid (-> wd chans)))))
              (if (== (-> c closed) 1)
                  (block (pthread_mutex_unlock (aof (-> wd lock)))
                         (free text)
                         (return (coco_g_answer e sc (coco-g-text send-closed) 0))))
              (if (> (-> c nreceivers) 0)
                  (block
                   (let ((int si . #'(nth 0 (-> c receivers))))
                    (coco_g_serve wd (aof (nth si (-> wd threads))) text 1))
                   (coco_g_chan_remove_receiver c 0)
                   (pthread_mutex_unlock (aof (-> wd lock)))
                   (return (coco_g_answer e sc (coco-g-text sent) 0))))
              (if (and (> (-> c cap) 0) (< (-> c count) (-> c cap)))
                  (block
                   (set (nth (% (+ (-> c head) (-> c count)) (-> c cap))
                             (-> c buf)) text)
                   (set (-> c count) (+ (-> c count) 1))
                   (pthread_mutex_unlock (aof (-> wd lock)))
                   (return (coco_g_answer e sc (coco-g-text sent) 0))))
              (let ((green_thread * t . #'(aof (nth (-> green_me cur)
                                                    (-> wd threads))))
                    (int nested . #'(coco_g_nested e)))
                (set (-> t block) 2)
                (set (-> t state) (? nested 3 1))
                (set (-> t chan) (cast int cid))
                (set (-> t send_text) text)
                ;; WHERE THE SEND'S STATUS GOES WHEN IT IS TAKEN (3.62.1).
                ;; Only the nested branch said, so a send that blocked the
                ;; plain way was answered into the cell of the task's LAST
                ;; wait -- or, a task that had not waited yet, into its
                ;; heap's first cell, which for a goal read from text is
                ;; the goal's first variable: a world whose main task
                ;; blocked in channel_send/2 came back with that variable
                ;; bound to `'$async'(ok)', and a send on a channel closed
                ;; under it answered nothing, which the library read as
                ;; sent (test/async.pl, `send_status').
                (set (-> t resume_cell) sc)
                (set (nth (-> c nsenders) (-> c senders)) (-> t id))
                (set (-> c nsenders) (+ (-> c nsenders) 1))
                (if nested
                    (block
                     (pthread_mutex_unlock (aof (-> wd lock)))
                     (return (coco_g_wait_nested e -1 sc)))
                  (block
                   (set (-> e halted) 128)
                   (pthread_mutex_unlock (aof (-> wd lock)))
                   (return 1))))))))

  ;;; A MESSAGE IS TAKEN UNDER THE LOCK AND READ WITH IT GIVEN BACK, ONCE
  ;;; (3.62.3): its text is this task's own from the moment it leaves the
  ;;; channel. It was read with the world's lock held, written again
  ;;; inside a status, and that read -- three passes over it, and the
  ;;; answer of the last not asked.
  (func coco_g_async_recv ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . #'(coco_g_need e)))
          (if (!= rc 1) (return rc)))
        (let ((coco_machine * m . #'(-> e m)) (i64 cid . -1)
              (size_t sc . #'(coco_deref m (coco_arg m g 1))))
          (let ((int slot . #'(coco_g_chan_slot e (coco_deref m (coco_arg m g 0)))))
            (if (== slot -1)
                (return (coco_g_raise e "library(async): channel_recv/2 wants a channel")))
            (if (== slot -2)
                (return (coco_g_raise e "library(async): no such channel")))
            (set cid slot))
          (let ((green_world * wd . green_now) (char * text . nil) (int taken . 0))
            (pthread_mutex_lock (aof (-> wd lock)))
            (let ((green_chan * c . #'(aof (nth cid (-> wd chans)))))
              (cond
                ((> (-> c count) 0)
                 (block
                  (set text (nth (-> c head) (-> c buf)))
                  (set taken 1)
                  (set (-> c head) (% (+ (-> c head) 1) (-> c cap)))
                  (set (-> c count) (- (-> c count) 1))
                  (coco_g_move_sender wd c)))
                ((> (-> c nsenders) 0)
                 (let ((green_thread * st . #'(aof (nth (nth 0 (-> c senders))
                                                        (-> wd threads)))))
                   (set text (-> st send_text))
                   (set taken 1)
                   (set (-> st send_text) nil)
                   (coco_g_serve wd st (coco-g-text sent) 0)
                   (coco_g_chan_remove_sender c 0)))
                ((== (-> c closed) 1) (set text nil))
                (#t
                 (block
                  (let ((green_thread * t . #'(aof (nth (-> green_me cur)
                                                        (-> wd threads))))
                        (int nested . #'(coco_g_nested e)))
                    (set (-> t block) 3)
                    (set (-> t state) (? nested 3 1))
                    (set (-> t chan) (cast int cid))
                    (set (-> t resume_cell) sc)
                    (set (nth (-> c nreceivers) (-> c receivers)) (-> t id))
                    (set (-> c nreceivers) (+ (-> c nreceivers) 1))
                    (if nested
                        (block
                         (pthread_mutex_unlock (aof (-> wd lock)))
                         (return (coco_g_wait_nested e -1 sc)))
                      (block
                       (set (-> e halted) 128)
                       (pthread_mutex_unlock (aof (-> wd lock)))
                       (return 1))))))))
            (pthread_mutex_unlock (aof (-> wd lock)))
            (if (not taken)
                (return (coco_g_answer e sc (coco-g-text closed) 0)))
            (let ((int rc . #'(coco_g_answer e sc text 1)))
              (free text)
              (return rc)))))

  (func coco_g_async_close ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . #'(coco_g_need e)))
          (if (!= rc 1) (return rc)))
        (let ((i64 cid . -1))
          (let ((int slot . #'(coco_g_chan_slot e (coco_deref (-> e m) (coco_arg (-> e m) g 0)))))
            (if (== slot -1)
                (return (coco_g_raise e "library(async): channel_close/1 wants a channel")))
            (if (== slot -2)
                (return (coco_g_raise e "library(async): no such channel")))
            (set cid slot))
          (let ((green_world * wd . green_now))
            (pthread_mutex_lock (aof (-> wd lock)))
            (coco_g_chan_close wd (aof (nth cid (-> wd chans))))
            (pthread_mutex_unlock (aof (-> wd lock)))
            (return 1))))
  (static) (coco-emit-module-dispatch coco_g_dispatch *green-predicates*)

  (coco-defmodule coco_green_module "green" coco_g_dispatch *green-prolog*)

  ) ; impl-green

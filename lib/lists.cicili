;;;; cocolog -- the Lists library, as a module
;;;
;;; SWI-Prolog's library(lists) -- all thirty-six exported predicates, read off
;;; a running SWI rather than off a memory of one -- plus the four SWI BUILTINS
;;; the library leans on that cocolog did not have: `length/2', `msort/2',
;;; `sort/2' and `sort/4'. Those four are not part of library(lists) in SWI and
;;; are marked as such below; they are here because half the library cannot be
;;; written without them and a test cannot compare against SWI without them
;;; either.
;;;
;;; IT IS THE MIRROR IMAGE OF lib/files.cicili. Files is seventeen predicates in
;;; C and five in Prolog, because a file system is a syscall away. Lists is
;;; thirty-odd in Prolog and nine in C, because a list predicate is a couple of
;;; clauses and because MOST OF THEM MUST BE NONDETERMINISTIC -- `member/2',
;;; `select/3', `append/3' and `permutation/2' each answer many times, and a
;;; module's C half cannot: it has no access to the choice stack, deliberately,
;;; so that no module can break the invariant cocolog's suspension depends on.
;;;
;;; That is not a limitation being worked around. A nondeterministic predicate
;;; belongs in the Coco half, where the ENGINE provides the choice points and a
;;; frozen machine can be thawed in another process and go on backtracking
;;; through it. Written in C it would work until the first `cocolog step'.
;;;
;;; WHAT THE C HALF IS FOR, then, is the things that are determinate and that C
;;; is genuinely better at: sorting by the standard order of terms, and the
;;; single-pass walks that Prolog would do with a recursion and a choice point
;;; per element. Most of those are reached through a `$'-prefixed primitive
;;; and wrapped in a clause, exactly as the Files module does it. length/2,
;;; nth0/3, nth1/3, last/2 and reverse/2 are rows of their own since 1.12.2,
;;; one step in every mode that answers once, and a mode that can answer
;;; again is declined (`:declines', `coco_m_decline') to the Coco half's
;;; clause of the same name -- so `length/2' is one step when the list is
;;; proper and still generative when it is not.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;;; ------------------------------------------------------------------
;;;; The C half
;;;; ------------------------------------------------------------------
(DEFPARAMETER *lists-predicates*
  '(("msort"      2 coco_l_msort)
    ("sort"       2 coco_l_sort)
    ("sort"       4 coco_l_sort4)
    ("$keysort"   2 coco_l_keysort)

    ;; ONE STEP for each mode that answers once (1.12.2), where a clause
    ;; around a walk below took 2 to 13; a mode that enumerates is
    ;; declined to the Coco half's clause of the same name
    ("length"     2 coco_l_length :declines)
    ("nth0"       3 coco_l_nth0_at :declines)
    ("nth1"       3 coco_l_nth1_at :declines)
    ("last"       2 coco_l_last :declines)
    ("reverse"    2 coco_l_reverse :declines)

    ("$len"       2 coco_l_len)
    ("$rev"       2 coco_l_rev)
    ("$nth0"      3 coco_l_nth0)
    ("memberchk"  2 coco_l_memberchk)

    ("$sum"       3 coco_l_sum)
    ("$maxl"      3 coco_l_maxl)
    ("$minl"      3 coco_l_minl)
    ("$numlist"   3 coco_l_numlist)))

;;;; ------------------------------------------------------------------
;;;; The Coco half
;;;; ------------------------------------------------------------------
;;; Joined with spaces: a Cicili string literal cannot carry a newline by
;;; either route -- see MODULES.md -- and Prolog does not mind, because a
;;; clause ends at its `.'. The commentary lives out here where a `%' cannot
;;; swallow the rest of the program for want of a line ending.
(DEFPARAMETER *lists-prolog*
  (FORMAT NIL "~{~A ~}"
          (LIST
           ;; swipl's library(lists) is a nodebug library: the tracer shows
           ;; a call a program's clause makes of one of these, and nothing
           ;; they call (3.27.0, the read's `nodbg')
           ":- set_prolog_flag(generate_debug_info, false)."
           ;; and max_member/3 and min_member/3 are its meta-predicates
           ;; (3.45.0): the order is said of the module the call is made in,
           ;; `user:(@<)', as a list no rule matches names it
           ":- meta_predicate max_member(2, -, +), min_member(2, -, +)."

           ;; ---- length/2 -------------------------------------------------
           ;; A SWI BUILTIN, not library(lists), and cocolog had none.
           ;; The C half answers every mode that answers once -- a proper
           ;; list, and a partial one with N bound (`length(L, 3)') -- and
           ;; declines a partial list with N unbound, which enumerates, to
           ;; this clause: the only call that reaches it (1.12.2). swipl's
           ;; (3.26.0, boot/init.pl): the list skipped to its tail, which
           ;; '$length3'/3 extends -- its name a determinism error says, as
           ;; swipl's. A tail that is N itself (`length(L, L)') is the C
           ;; half's, which fails it, as swipl's clause does
           "length(L, N) :- '$skip_list'(N0, L, T), '$length3'(T, N, N0)."
           "'$length3'([], N, N)."
           "'$length3'([_|L], N, N0) :- N1 is N0 + 1, '$length3'(L, N, N1)."

           ;; ---- append, member, and what is built on them ----------------
           "append([], L, L)."
           "append([H|T], L, [H|R]) :- append(T, L, R)."
           ;; append/2 checks its list of lists as swipl's must_be(list, L)
           ;; does (3.26.0): through 3.25.0 a partial one ran for ever
           "append(ListOfLists, List) :- must_be(list, ListOfLists), '$append2'(ListOfLists, List)."
           "'$append2'([], [])."
           "'$append2'([L|Ls], As) :- append(L, Ws, As), '$append2'(Ls, Ws)."

           ;; member/2 and select/3 as swipl writes them (3.22.0): the rest of
           ;; the list is the helper's FIRST argument, so the last element's
           ;; call, keyed on `[]', has one candidate and leaves no choice
           ;; point -- `$, member(X, [1])' is det, as swipl's. A determinism
           ;; error names the helper as swipl does, lists:member_/3
           ;; (*frame-contexts*)
           "member(X, [H|T]) :- '$member_'(T, X, H)."
           "'$member_'(_, X, X)."
           "'$member_'([H|T], X, _) :- '$member_'(T, X, H)."

           ;; ---- select and its relatives ---------------------------------
           "select(X, [H|T], R) :- '$select3_'(T, H, X, R)."
           "'$select3_'(T, H, H, T)."
           "'$select3_'([H2|T], H, X, [H|R]) :- '$select3_'(T, H2, X, R)."
           ;; select/4 and selectchk/3 as swipl writes them (3.26.0): the
           ;; list first in select/4's helper, which a determinism error names
           ;; as swipl's does, lists:select4_/4; selectchk/3 commits to the
           ;; FIRST element that matches and only then asks the rest, so
           ;; `selectchk(X, [a, b], [a])' fails, where through 3.25.0 it went
           ;; on to X = b
           "select(X, XList, Y, YList) :- '$select4_'(XList, X, Y, YList)."
           "'$select4_'([X|List], X, Y, [Y|List])."
           "'$select4_'([X0|XList], X, Y, [X0|YList]) :- '$select4_'(XList, X, Y, YList)."
           "selectchk(Elem, List, Rest) :- select(Elem, List, Rest0), !, Rest = Rest0."
           "selectchk(X, L, Y, R) :- select(X, L, Y, R), !."
           ;; THE SET PREDICATES ARE SWIPL'S SINGLE-SIDED RULES (3.42.1): a
           ;; first list no rule matches -- no list, an unbound one, the end
           ;; of a partial one -- raises existence_error(matching_rule,
           ;; lists:subtract(Tail, D, R)) at the tail it reached, where
           ;; through 3.42.0 it failed, and an unbound list was enumerated
           ;; (`subtract(L, [a], R)' gave L = [] and more)
           "subtract([], _, R) => R = []."
           "subtract([E|T], D, R) => ( memberchk(E, D) -> subtract(T, D, R) ; R = [E|R1], subtract(T, D, R1) )."
           "intersection([], _, Set) => Set = []."
           "intersection([X|T], L, Intersect) => ( memberchk(X, L) -> Intersect = [X|R], intersection(T, L, R) ; intersection(T, L, Intersect) )."
           "union([], L0, L) => L = L0."
           "union([H|T], L, Union) => ( memberchk(H, L) -> union(T, L, Union) ; Union = [H|R], union(T, L, R) )."
           "subset([], _) => true."
           "subset([E|R], Set) => memberchk(E, Set), subset(R, Set)."

           ;; SWI deletes every element that COULD unify without binding
           ;; anything: `\\+ Elem \\= X'. Plain unification would bind a
           ;; variable in the list and delete the rest of it with it.
           "delete([], _, [])."
           "delete([H|T], X, R) :- \\+ H \\= X, !, delete(T, X, R)."
           "delete([H|T], X, [H|R]) :- delete(T, X, R)."

           ;; ---- position -------------------------------------------------
           ;; nth0/3 and nth1/3 are determinate when the index is bound --
           ;; the C half, in one step -- and enumerate when it is not: the
           ;; C half declines that call to these clauses (1.12.2), swipl's
           ;; (3.22.0): the rest of the list first, so the last element's
           ;; answer leaves no choice point, and a determinism error names
           ;; lists:nth_gen/5
           "nth0(N, L, E) :- L = [H|T], '$nth_gen'(T, E, H, 0, N)."
           "nth1(N, L, E) :- L = [H|T], '$nth_gen'(T, E, H, 1, N)."
           "'$nth_gen'(_, E, E, B, B)."
           "'$nth_gen'([H|T], E, _, N, B) :- M is N + 1, '$nth_gen'(T, E, H, M, B)."
           ;; nth0/4 and nth1/4 as swipl writes them (3.26.0): an unbound
           ;; index generates, a bound one is must_be/2's -- nonneg,
           ;; positive_integer -- and found by a walk that cuts, so
           ;; `nth0(1, [a, b, c], E, R)' leaves no choice point and
           ;; `nth0(a, L, E, R)' raises type_error(nonneg, a); through 3.25.0
           ;; the first left one and the second failed. The helpers a
           ;; determinism error names are swipl's, lists:generate_nth/5 and
           ;; lists:find_nth0/4
           "nth0(V, In, Element, Rest) :- var(V), !, '$generate_nth'(0, V, In, Element, Rest)."
           "nth0(V, In, Element, Rest) :- must_be(nonneg, V), '$find_nth0'(V, In, Element, Rest)."
           "nth1(V, In, Element, Rest) :- var(V), !, '$generate_nth'(1, V, In, Element, Rest)."
           "nth1(V, In, Element, Rest) :- must_be(positive_integer, V), succ(V0, V), '$find_nth0'(V0, In, Element, Rest)."
           "'$generate_nth'(I, I, [Head|Rest], Head, Rest)."
           "'$generate_nth'(I, IN, [H|List], El, [H|Rest]) :- I1 is I + 1, '$generate_nth'(I1, IN, List, El, Rest)."
           "'$find_nth0'(0, [Head|Rest], Head, Rest) :- !."
           "'$find_nth0'(N, [Head|Rest0], Elem, [Head|Rest]) :- M is N - 1, '$find_nth0'(M, Rest0, Elem, Rest)."

           ;; ---- last/2 ---------------------------------------------------
           ;; swipl's clauses (3.0.1). The C half answers a proper list in
           ;; one step and declines a partial list -- an unbound List among
           ;; them -- to this clause, the only call that reaches it, which
           ;; enumerates as swipl's does, the shortest list first: `[X]',
           ;; then `[_, X]', and for `[a|T]' T = [], then T = [X]. Nothing
           ;; is checked here: the C half asked once, and the helper the
           ;; recursion comes back to tests nothing, so each answer after
           ;; the first is one step (as between/3's helper's are).
           ;; Through 3.0.0 last/2 was the C half's alone, and a partial
           ;; list failed
           "last([X|Xs], L) :- '$last_gen'(Xs, X, L)."
           "'$last_gen'([], L, L)."
           "'$last_gen'([X|Xs], _, L) :- '$last_gen'(Xs, X, L)."
           "nextto(X, Y, [X,Y|_])."
           "nextto(X, Y, [_|T]) :- nextto(X, Y, T)."
           ;; prefix/2 is swipl's own recursion (3.26.0), which a determinism
           ;; error names, lists:prefix/2; through 3.25.0 it was append/3's
           "prefix([], _)."
           "prefix([E|T0], [E|T]) :- prefix(T0, T)."

           ;; ---- shape ----------------------------------------------------
           ;; a proper list is reversed by the C half in one step; anything
           ;; it declines -- a partial list, which enumerates -- comes here,
           ;; to swipl's clauses (3.26.0): the second list bounds the walk,
           ;; so `reverse(L, [1, 2])' answers once and ends, where through
           ;; 3.25.0 it searched for ever after its answer. Its helper is
           ;; swipl's reverse/4 under a name of cocolog's (*frame-contexts*)
           "reverse(Xs, Ys) :- '$reverse4'(Xs, Ys, [], Ys)."
           "'$reverse4'([], [], Ys, Ys)."
           "'$reverse4'([X|Xs], [_|Bound], Rs, Ys) :- '$reverse4'(Xs, Bound, [X|Rs], Ys)."
           ;; proper_length/2, permutation/2 as swipl writes them (3.26.0):
           ;; permutation/2 refuses a term that is no list, as swipl's
           ;; must_be(list, L), where through 3.25.0 it failed
           "proper_length(List, Length) :- '$skip_list'(Length0, List, Tail), Tail == [], Length = Length0."
           "same_length([], [])."
           "same_length([_|T], [_|R]) :- same_length(T, R)."
           "permutation(Xs, Ys) :- '$skip_list'(Xlen, Xs, XTail), '$skip_list'(Ylen, Ys, YTail),"
           "  ( XTail == [], YTail == [] -> Xlen == Ylen"
           "  ; var(XTail), YTail == [] -> length(Xs, Ylen)"
           "  ; XTail == [], var(YTail) -> length(Ys, Xlen)"
           "  ; var(XTail), var(YTail) -> length(Xs, Len), length(Ys, Len)"
           "  ; must_be(list, Xs), must_be(list, Ys) ), '$perm'(Xs, Ys)."
           "'$perm'([], [])."
           "'$perm'(L, [H|T]) :- select(H, L, R), '$perm'(R, T)."

           "flatten(L, F) :- '$flatten'(L, [], F0), !, F = F0."
           "'$flatten'(V, T, [V|T]) :- var(V), !."
           "'$flatten'([], T, T) :- !."
           "'$flatten'([H|R], T, F) :- !, '$flatten'(R, T, F0), '$flatten'(H, F0, F)."
           "'$flatten'(A, T, [A|T])."

           ;; ---- sets -----------------------------------------------------
           ;; list_to_set/2 keeps the FIRST of each group and the original
           ;; order, which is not what sorting would give: swipl's clauses
           ;; (3.26.0), each element numbered, sorted by itself with its
           ;; duplicates kept in order, the first of each kept and the rest
           ;; put back in order -- n log n, where 3.25.0's walk asked every
           ;; element of the ones kept before it. is_set/1 is swipl's too:
           ;; a proper list whose sort/2 drops nothing
           "list_to_set(List, Set) :- must_be(list, List), '$number_list'(List, 1, Numbered),"
           "  sort(1, @=<, Numbered, ONum), '$remove_dup_keys'(ONum, NumSet),"
           "  sort(2, @=<, NumSet, ONumSet), pairs_keys(ONumSet, Set)."
           "'$number_list'([], _, [])."
           "'$number_list'([H|T0], N, [H-N|T]) :- N1 is N + 1, '$number_list'(T0, N1, T)."
           "'$remove_dup_keys'([], [])."
           "'$remove_dup_keys'([H|T0], [H|T]) :- H = V-_, '$remove_same_key'(T0, V, T1), '$remove_dup_keys'(T1, T)."
           "'$remove_same_key'([V1-_|T0], V, T) :- V1 == V, !, '$remove_same_key'(T0, V, T)."
           "'$remove_same_key'(L, _, L)."
           "is_set(Set) :- '$skip_list'(Len, Set, Tail), Tail == [], sort(Set, Sorted), length(Sorted, Len)."

           ;; run-length pairs: [a,a,b] becomes [a-2, b-1], as swipl writes
           ;; it (3.26.0), clump/2 and ccount/5 under cocolog's names
           "clumped(Items, Counts) :- '$clump'(Items, Counts)."
           "'$clump'([], [])."
           "'$clump'([H|T0], [H-C|T]) :- '$ccount'(T0, H, T1, 1, C), '$clump'(T1, T)."
           "'$ccount'([H|T0], E, T, C0, C) :- E == H, !, C1 is C0 + 1, '$ccount'(T0, E, T, C1, C)."
           "'$ccount'(List, _, List, C, C)."

           ;; ---- arithmetic over a list -----------------------------------
           "sum_list(L, S) :- '$sum'(L, 0, S)."
           ;; sumlist/2 (2.16.0), the old name swipl still autoloads from
           ;; library(backcomp), whose one clause this is
           "sumlist(L, S) :- sum_list(L, S)."
           ;; swipl's single-sided rules (3.42.1): a list that is none raises
           ;; existence_error(matching_rule, lists:max_list(L, M)), and the
           ;; walks raise it at a tail that is none, lists:max_list(T, M0,
           ;; M); through 3.42.0 each failed
           "max_list([H|T], M) => '$maxl'(T, H, M)."
           "max_list([], _) => fail."
           "min_list([H|T], M) => '$minl'(T, H, M)."
           "min_list([], _) => fail."
           ;; ONE CLAUSE (3.0.0): '$numlist'/3 checks L and H as swipl's
           ;; must_be(integer, X) does and fails for L > H. A first clause
           ;; `numlist(L, H, []) :- L > H, !, fail' stood here through 2.16,
           ;; its test a guard of the clause; its 3.0.0 form asked a C
           ;; helper there, which cost every call a backtrack
           "numlist(L, H, R) :- '$numlist'(L, H, R)."

           ;; ---- the standard order over a list ---------------------------
           ;; max_member/2 and min_member/2 use the STANDARD ORDER of terms and
           ;; not arithmetic, so `max_member(M, [1, a])' is `a'. The four are
           ;; swipl 9.0.4's single-sided rules (3.26.1): a list no rule
           ;; matches -- unbound, partial or no list -- is
           ;; existence_error(matching_rule, lists:max_member(_, _)), and the
           ;; /3 forms ask the order as swipl's do, call(P, H, Max0) keeping
           ;; Max0 and call(P, Min0, H) keeping Min0, so of two elements the
           ;; order ties the one kept is swipl's. Through 3.26.0 the /3
           ;; forms asked call(P, Max0, H) and took H, and the /2 forms
           ;; sorted the list
           "max_member(Max, [H|T]) => '$max_member_'(T, H, Max)."
           "max_member(_, []) => fail."
           "'$max_member_'([], Max0, Max) => Max = Max0."
           "'$max_member_'([H|T], Max0, Max) => ( H @=< Max0 -> '$max_member_'(T, Max0, Max) ; '$max_member_'(T, H, Max) )."
           "min_member(Min, [H|T]) => '$min_member_'(T, H, Min)."
           "min_member(_, []) => fail."
           "'$min_member_'([], Min0, Min) => Min = Min0."
           "'$min_member_'([H|T], Min0, Min) => ( H @>= Min0 -> '$min_member_'(T, Min0, Min) ; '$min_member_'(T, H, Min) )."
           "max_member(Pred, Max, [H|T]) => '$max_member_'(T, Pred, H, Max)."
           "max_member(_, _, []) => fail."
           "'$max_member_'([], _, Max0, Max) => Max = Max0."
           "'$max_member_'([H|T], Pred, Max0, Max) => ( call(Pred, H, Max0) -> '$max_member_'(T, Pred, Max0, Max) ; '$max_member_'(T, Pred, H, Max) )."
           "min_member(Pred, Min, [H|T]) => '$min_member_'(T, Pred, H, Min)."
           "min_member(_, _, []) => fail."
           "'$min_member_'([], _, Min0, Min) => Min = Min0."
           "'$min_member_'([H|T], Pred, Min0, Min) => ( call(Pred, Min0, H) -> '$min_member_'(T, Pred, Min0, Min) ; '$min_member_'(T, Pred, H, Min) )."

           ;; ---- memory management ---------------------------------------
           ;;
           ;; NOT SWI'S LISTS LIBRARY, and could not be: it exists
           ;; because of how THIS engine reclaims. The heap is truncated only
           ;; by backtracking -- success frees nothing, and a term below the
           ;; current choice point cannot be freed at all, so a predicate
           ;; that "frees a list you hand it" is unimplementable and this one
           ;; does not pretend to be it. `free_list(Build, Use)' runs
           ;; `call(Build, L)' to make the list and `call(Use, L)' to consume
           ;; it INSIDE a double negation: on the way out both negations
           ;; backtrack, and the heap comes back to where it stood -- the
           ;; list, and everything else built inside, is reclaimed. Measured:
           ;; thirty rounds of a 200000-element list peak at ONE list's
           ;; memory; the same rounds bound in an accumulator peak at thirty.
           ;;
           ;; THE PRICE IS THE POINT: no binding survives. What Use learns
           ;; must leave through a side channel that survives backtracking --
           ;; write it, file it (write_file_from_codes/2), assert it small.
           ;; A result that must come back as a BINDING does not belong in a
           ;; freed scope.
           "free_list(Build, Use) :- \\+ \\+ ( call(Build, L), call(Use, L) ).")))

(generic decl-lists
  ()

  ;;; Registers the module. A target calls this after `coco_module_init'.
  (decl) (func coco_lists_module () (out int))

  ) ; decl-lists

;;; A LIST TOO LONG FOR THE STACK LIMIT is `coco-l-too-long', beside the
;;; limit's other macro in lib/term.cicili since 3.62.2, where the files
;;; module asks it too.

(generic impl-lists
  ()

  ;;; ---- sorting --------------------------------------------------------

  ;;; The standard order of terms, through `coco_compare', which is the same
  ;;; comparison `compare/3', `@<' and the clause store already use -- so a
  ;;; sorted list here and a `@<' test in a program cannot disagree.
  ;;;
  ;;; qsort(3) is not stable and SWI's msort/2 is; but msort/2 orders by the
  ;;; standard order alone, under which two elements that compare equal are
  ;;; indistinguishable, so stability is unobservable. `sort/4' is another
  ;;; matter -- there the KEY is compared and the rest of the term is not --
  ;;; and that one is sorted with an insertion pass instead.
  ;;; RUNG 191.14 (from CivV): THREAD-LOCAL, and it has to be. The array
  ;;; qsort is handed holds HEAP INDICES, not pointers, and this variable is
  ;;; the only thing that says which machine those indices belong to. As a
  ;;; file-scope static it was one slot for the whole process, so two threads
  ;;; sorting at once had the second overwrite the first's machine and the
  ;;; first's comparator then indexed a foreign heap.
  ;;;
  ;;; Reproduced through library(cowork) itself: 2000 sorting jobs on a
  ;;; four-worker crew while the main thread sorted 1500 times -- SIGSEGV,
  ;;; three runs of three. With a thin overlap it comes back clean every
  ;;; time, which is why a light test does not find it. CivV sorts three
  ;;; times a frame in its renderer and about twenty times an AI turn, so a
  ;;; crew doing game work overlaps the drawing thread by construction.
  ;;;
  ;;; `(thread-local)' emits `__thread', which takes a trivially destroyed
  ;;; type -- a bare pointer qualifies, as x509's and tls's buffers do. It
  ;;; replaces `(static)' rather than joining it because no attribute in this
  ;;; tree is stacked and the emitter has never been asked to.
  (thread-local) (var coco_machine * coco_l_sort_machine)

  (static)
  (func coco_l_cmp ((const void * a) (const void * b)) (out int)
        (return (coco_compare coco_l_sort_machine
                            (cof (cast (const size_t *) a))
                            (cof (cast (const size_t *) b)))))

  ;;; Shared by msort/2 and sort/2: the only difference is whether elements
  ;;; that compare equal are kept. A sort that drops them takes a list that
  ;;; is its own tail as the set of its elements, as SWI's does (1.10.19;
  ;;; through 1.10.18 the walk went round it for ever); msort/2 raises.
  (static)
  ;;; WHAT IS NO LIST TO A SORT, as swipl's sorts raise it (3.0.0): a
  ;;; partial list is an instantiation_error, anything else type_error(list,
  ;;; L). Through 2.16 both were the type error. A list that is its own
  ;;; tail ends the walk at the heap's length, and is no list.
  (static)
  (func coco_l_not_list ((coco_engine * e) (size_t l)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t t . 0) (size_t budget . 0))
          (set t (coco_deref m l))
          (set budget (-> m heap_len))
          (while (and (coco_is_cons m t) (> budget 0))
            (set budget (- budget 1))
            (set t (coco_deref m (coco_arg m t 1))))
          (if (coco-tag-is REF (nth t (-> m heap)))
              (return (coco_m_instantiation_error e)))
          (return (coco_m_type_error e "list" l))))

  (func coco_l_sort_common ((coco_engine * e) (size_t g) (int dedup)) (out int)
        (let ((size_t * v . nil) (size_t n . 0) (size_t out . 0))
          (if (not (coco_m_list_array e (coco_m_arg e g 0) (aof v) (aof n)))
              (if (not (and dedup (coco_list_cycle_items (coco_m_machine e) (coco_m_arg e g 0)
                                                         (aof v) (aof n))))
                  (return (coco_l_not_list e (coco_m_arg e g 0)))))
          (set coco_l_sort_machine (coco_m_machine e))
          (qsort v n (sizeof size_t) coco_l_cmp)
          (if dedup
              (let ((size_t k . 0))
                (for ((size_t i . 0)) (< i n) ((++ i))
                  (if (or (== k 0)
                          (!= 0 (coco_compare (coco_m_machine e)
                                            (nth (- k 1) v) (nth i v))))
                      (block (set (nth k v) (nth i v)) (set k (+ k 1)))))
                (set n k)))
          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 1) out))))

  (func coco_l_msort ((coco_engine * e) (size_t g)) (out int)
        (return (coco_l_sort_common e g 0)))

  (func coco_l_sort ((coco_engine * e) (size_t g)) (out int)
        (return (coco_l_sort_common e g 1)))

  ;;; THE KEY OF T BY PATH (3.50.0): the argument PATH[0] of T, then the
  ;;; argument PATH[1] of that, NP steps -- T itself for none. The steps
  ;;; were checked on every element before the sort (`coco_l_sort_by').
  (static)
  (func coco_l_key ((coco_engine * e) (size_t t) (i64 * path) (int np)) (out size_t)
        (let ((coco_machine * m . #'(coco_m_machine e)))
          (for ((int i . 0)) (< i np) ((++ i))
            (set t (coco_arg m (coco_deref m t) (cast u32 (- (nth i path) 1)))))
          (return t)))

  ;;; ONE KEY OF sort/4, swipl's get_key_arg_ex(): 1 with a positive
  ;;; integer in *K, or 0 where ZERO_OK; 1 and -1 for an atom, a dict key
  ;;; (`[]' among them, an atom to swipl's C); 0 and
  ;;; domain_error(not_less_than_one, T) raised for any other integer (*RC
  ;;; its answer); -1 for anything else. A positive integer past swipl
  ;;; 9.0.4's tagged ones (its max_tagged_integer on 64 bits, 2^56 - 1) is
  ;;; 0 with *RC 0, a failure and no error, as swipl's returns FALSE there.
  (static)
  (func coco_l_key_arg ((coco_engine * e) (size_t t) (int zero_ok) (i64 * k) (int * rc)) (out int)
        (if (coco_m_int e t k)
            (block (if (> (cof k) 72057594037927935) (block (set (cof rc) 0) (return 0)))
                   (if (or (> (cof k) 0) (and zero_ok (== (cof k) 0))) (return 1))
                   (set (cof rc) (coco_m_domain_error e "not_less_than_one" t))
                   (return 0)))
        (if (coco_m_is_atom e t) (block (set (cof k) -1) (return 1)))
        (return -1))

  ;;; THE SORT OF sort/4 BY ITS KEY PATH (3.50.0): the list, then each
  ;;; element's every step, then a sort -- DESCENDING for @> and @>=, KEEP
  ;;; the duplicates for @=< and @>=. STABLE, as qsort is not: two terms
  ;;; with equal keys and different bodies are distinguishable, so the
  ;;; order they arrived in is observable and SWI keeps it.
  (static)
  (func coco_l_sort_by ((coco_engine * e) (size_t g) (i64 * path) (int np)
                        (int descending) (int keep)) (out int)
        (let ((size_t * v . nil) (size_t n . 0) (size_t out . 0))
          ;; an order that drops duplicates takes a list that is its own
          ;; tail as its elements, as sort/2 does (1.10.19)
          (if (not (coco_m_list_array e (coco_m_arg e g 2) (aof v) (aof n)))
              (if (not (and (not keep) (coco_list_cycle_items (coco_m_machine e) (coco_m_arg e g 2)
                                                              (aof v) (aof n))))
                  (return (coco_l_not_list e (coco_m_arg e g 2)))))

          ;; each element has each step's argument, swipl's extract_key(): a
          ;; compound, of that arity at least -- type_error(compound, E), then
          ;; the three-argument existence_error(argument, K, E) -- or, by a
          ;; dict key, a dict; E the term the path has reached
          (let ((coco_machine * m . #'(coco_m_machine e)))
            (for ((size_t i . 0)) (< i n) ((++ i))
              (let ((size_t t . #'(nth i v)))
                (for ((int s . 0)) (< s np) ((++ s))
                  (set t (coco_deref m t))
                  (cond
                    ((not (coco-tag-is FUN (nth t (-> m heap))))
                     (block (free v) (return (coco_m_type_error e "compound" t))))
                    ((< (nth s path) 0)
                     (block (free v) (return (coco_m_type_error e "dict" t))))
                    ((> (nth s path) (cast i64 (coco_arity m t)))
                     (let ((size_t args [3]))
                       (set (nth 0 args) (coco_new_atom m "argument"))
                       (set (nth 1 args) (coco_new_int m (nth s path)))
                       (set (nth 2 args) t)
                       (free v)
                       (return (coco_m_raise e (coco_make m "existence_error" 3 args)))))
                    (#t (set t (coco_arg m t (cast u32 (- (nth s path) 1))))))))))

          ;; a STABLE merge sort, bottom-up. This was an insertion sort,
          ;; "n is small in every use this has" -- and keysort/2 is this
          ;; at key 1, which the tagger's judge put a table of
          ;; thirty-five thousand words through: 10.6 s where msort/2 took
          ;; 0.02, and a process that tagged one sentence paid 42 s before
          ;; its first answer. Equal keys keep their arrival order, which
          ;; bagof/3 needs: the left run wins a tie.
          (if (> n 1)
            (let ((size_t * tmp . #'(cast (size_t *) (malloc (* n (sizeof size_t)))))
                  (size_t * src . v) (size_t * dst . nil))
              (if (== tmp nil) (block (free v) (return (coco_m_resource_error e "memory"))))
              (set dst tmp)
              (for ((size_t width . 1)) (< width n) ((set width (* width 2)))
                (for ((size_t lo . 0)) (< lo n) ((set lo (+ lo (* width 2))))
                  (let ((size_t mid . #'(+ lo width)) (size_t hi . #'(+ lo (* width 2)))
                        (size_t i . lo) (size_t j . 0) (size_t k . lo))
                    (if (> mid n) (set mid n))
                    (if (> hi n) (set hi n))
                    (set j mid)
                    (while (< k hi)
                      (let ((int take_left . 0))
                        (if (>= j hi)
                            (set take_left 1)
                            (if (>= i mid)
                                (set take_left 0)
                                (let ((int c . #'(coco_compare (coco_m_machine e)
                                                             (coco_l_key e (nth i src) path np)
                                                             (coco_l_key e (nth j src) path np))))
                                  (if descending (set c (- 0 c)))
                                  (set take_left (<= c 0)))))
                        (if take_left
                            (block (set (nth k dst) (nth i src)) (set i (+ i 1)))
                            (block (set (nth k dst) (nth j src)) (set j (+ j 1))))
                        (set k (+ k 1))))))
                (let ((size_t * t . src)) (set src dst) (set dst t)))
              (if (!= src v)
                  (for ((size_t i . 0)) (< i n) ((++ i)) (set (nth i v) (nth i src))))
              (free tmp)))

          (if (not keep)
              (let ((size_t k . 0))
                (for ((size_t i . 0)) (< i n) ((++ i))
                  (if (or (== k 0)
                          (!= 0 (coco_compare (coco_m_machine e)
                                            (coco_l_key e (nth (- k 1) v) path np)
                                            (coco_l_key e (nth i v) path np))))
                      (block (set (nth k v) (nth i v)) (set k (+ k 1)))))
                (set n k)))

          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 3) out))))


  ;;; `sort(+Key, +Order, +List, -Sorted)'. Key 0 is the whole term; Key N is
  ;;; the Nth argument of it, and a list of keys a path into it. Order is one
  ;;; of @< @=< @> @>=, or since 3.50.0 one of < =< > >=, swipl's other names
  ;;; for them -- the ones with the `=' keep duplicates and the ones without
  ;;; remove them, which is the rule that catches everybody out and is
  ;;; exactly SWI's.
  ;;;
  ;;; THE KEY, THE ORDER, THE LIST, THE ELEMENTS, in swipl's order and with
  ;;; its errors (3.0.0): an integer under 0 is domain_error(not_less_than_one,
  ;;; K); an atom is a dict key, and as there are no dicts here only the
  ;;; empty list sorts by one. Through 2.16 the key was type_error(integer,
  ;;; K) and an element without the argument sorted by itself. A PROPER LIST
  ;;; OF KEYS IS A PATH (3.50.0, swipl's sort/4): the key of f(g(1, b)) by
  ;;; [1, 2] is b, each step a positive integer or an atom -- 0 or a negative
  ;;; one domain_error(not_less_than_one, K), anything else a failure with no
  ;;; error, as swipl's returns FALSE -- and any other key type_error(sort_key,
  ;;; K), an unbound one instantiation_error. Through 3.49.1 a list was
  ;;; type_error(sort_key, L). The order is an atom as PL_get_atom_ex() reads
  ;;; one, anything else type_error(atom, O) (3.50.0; through 3.49.1
  ;;; domain_error(order, O)).
  (func coco_l_sort4 ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 key . 0) (const char * order . nil) (int rc . 0)
              (i64 one [1]) (i64 * path . one) (int np . 0)
              (size_t o . #'(coco_m_arg e g 1)))
          (let ((int kr . #'(coco_l_key_arg e (coco_m_arg e g 0) 1 (aof key) (aof rc))))
            (cond
              ((== kr 0) (return rc))
              ((== kr 1) (block (set (nth 0 one) key) (set np (? (== key 0) 0 1))))
              (#t
               (let ((size_t * ks . nil) (size_t nk . 0))
                 (if (not (coco_m_list_array e (coco_m_arg e g 0) (aof ks) (aof nk)))
                     (return (coco_m_type_error e "sort_key" (coco_m_arg e g 0))))
                 (if (> nk 1)
                     (block
                       (set path (cast (i64 *) (malloc (* nk (sizeof i64)))))
                       (if (== path nil)
                           (block (free ks) (return (coco_m_resource_error e "memory"))))))
                 (for ((size_t i . 0)) (< i nk) ((++ i))
                   (let ((int sr . #'(coco_l_key_arg e (nth i ks) 0 (aof key) (aof rc))))
                     (if (!= sr 1)
                         (block (free ks) (if (!= path one) (free path))
                                (return (? (== sr 0) rc 0))))
                     (set (nth i path) key)))
                 (set np (cast int nk))
                 (free ks)))))
          (if (not (coco_m_is_var e o)) (set order (coco_m_atom e o)))
          (cond
            ((coco_m_is_var e o) (set rc (coco_m_instantiation_error e)))
            ((== order nil) (set rc (coco_m_type_error e "atom" o)))
            ((or (== 0 (strcmp order "@<")) (== 0 (strcmp order "<")))
             (set rc (coco_l_sort_by e g path np 0 0)))
            ((or (== 0 (strcmp order "@=<")) (== 0 (strcmp order "=<")))
             (set rc (coco_l_sort_by e g path np 0 1)))
            ((or (== 0 (strcmp order "@>")) (== 0 (strcmp order ">")))
             (set rc (coco_l_sort_by e g path np 1 0)))
            ((or (== 0 (strcmp order "@>=")) (== 0 (strcmp order ">=")))
             (set rc (coco_l_sort_by e g path np 1 1)))
            (#t (set rc (coco_m_domain_error e "order" o))))
          (if (!= path one) (free path))
          (return rc)))

  ;;; keysort/2's body (3.0.0): sort/4 at key 1 with @=<, after swipl's
  ;;; checks -- the list's errors are keysort/2's, by the helper's row, and
  ;;; an element that is no pair type_error(pair, E), or an unbound one
  ;;; instantiation_error, named bare as swipl names them. Through 2.16
  ;;; keysort/2 was sort/4: the context said sort/4, and `keysort([a], L)'
  ;;; answered [a].
  (func coco_l_keysort ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t * v . nil) (size_t n . 0) (size_t args [4]))
          (if (not (coco_m_list_array e (coco_m_arg e g 0) (aof v) (aof n)))
              (return (coco_l_not_list e (coco_m_arg e g 0))))
          (for ((size_t i . 0)) (< i n) ((++ i))
            (let ((size_t t . #'(coco_deref m (nth i v))))
              (if (coco-tag-is REF (nth t (-> m heap)))
                  (block (free v)
                         (return (coco_m_raise_pi e (coco_new_atom m "instantiation_error")
                                                  "" "keysort" 2))))
              (if (not (and (coco-tag-is FUN (nth t (-> m heap)))
                            (and (== (coco_arity m t) 2)
                                 (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) "-")))))
                  (block (free v)
                         (return (coco_m_raise_pi e (coco_make2 m "type_error"
                                                                (coco_new_atom m "pair") t)
                                                  "" "keysort" 2))))))
          (free v)
          (set (nth 0 args) (coco_new_int m 1))
          (set (nth 1 args) (coco_new_atom m "@=<"))
          (set (nth 2 args) (coco_m_arg e g 0))
          (set (nth 3 args) (coco_m_arg e g 1))
          (return (coco_l_sort4 e (coco_make m "sort" 4 args)))))

  ;;; ---- the determinate walks ------------------------------------------

  ;;; Only for a PROPER list. A partial one is not an error here -- it is the
  ;;; signal that the clause above should try the generative path instead.
  ;;; A list that is its own tail is neither, and SWI's length/2 raises
  ;;; `type_error(list, L)' over one, asked for its length or not (1.10.19:
  ;;; the generative path went round it for ever).
  (func coco_l_len ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t n . 0))
          (if (not (coco_m_list_length e (coco_m_arg e g 0) (aof n)))
              (block
               (if (coco_list_cyclic (coco_m_machine e) (coco_m_arg e g 0))
                   (return (coco_m_type_error e "list" (coco_m_arg e g 0))))
               (return 0)))
          (return (coco_m_unify_int e (coco_m_arg e g 1) (cast i64 n)))))

  (func coco_l_rev ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t * v . nil) (size_t n . 0) (size_t out . 0))
          (if (not (coco_m_list_array e (coco_m_arg e g 0) (aof v) (aof n))) (return 0))
          (for ((size_t i . 0)) (< i (/ n 2)) ((++ i))
            (let ((size_t tmp . #'(nth i v)))
              (set (nth i v) (nth (- (- n 1) i) v))
              (set (nth (- (- n 1) i) v) tmp)))
          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 1) out))))

  ;;; The index is already known to be a non-negative integer -- the clause
  ;;; that calls this checked -- so out of range is a plain failure.
  (func coco_l_nth0 ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (i64 want . 0) (size_t p))
          (if (not (coco_m_int e (coco_m_arg e g 0) (aof want))) (return 0))
          (if (< want 0) (return 0))
          (set p (coco_m_arg e g 1))
          (while (> want 0)
            (set p (coco_deref m p))
            (if (not (coco_is_cons m p)) (return 0))
            (set p (coco_arg m p 1))
            (set want (- want 1)))
          (set p (coco_deref m p))
          (if (not (coco_is_cons m p)) (return 0))
          (return (coco_m_unify e (coco_m_arg e g 2) (coco_arg m p 0)))))

  ;;; UNIFIES, and keeps the first that works -- `memberchk(X, [a,b])' binds X
  ;;; to a. Every attempt that fails is wound back, because a builtin that
  ;;; fails is not a choice point and the engine winds nothing back for it.
  ;;; A LIST THAT IS ITS OWN TAIL ends the walk once it has met more cells
  ;;; than the heap holds, with SWI's `type_error(list, L)' (1.10.19: it
  ;;; went round for ever); an element found before that is found, as SWI's.
  ;;; The count is the machine's (`lbudget'), and the loop reads one machine:
  ;;; through the SDK's mark, unify and undo, which each read `e->m' again,
  ;;; it held two, and the count left one of them on the stack (+12 % of its
  ;;; own cost, a local count; +1.7 % in the machine).
  ;;;
  ;;; WHERE THE WALK ENDS WITH NOTHING FOUND (3.0.0, swipl's '$memberchk'/3
  ;;; and the clause over it): the list's end fails; an unbound tail is
  ;;; bound to [X|_], so memberchk(a, L) is L = [a|_] and memberchk(a, [b|T])
  ;;; T = [a|_]; anything else is type_error(list, Tail), the tail the walk
  ;;; stopped at -- memberchk(a, [b|c]) names `c', memberchk(a, foo) `foo',
  ;;; and `'[]'' is one, being no list's end. Through 2.16.1 the three
  ;;; failed. Out of line: only the end of a walk that found nothing comes
  ;;; here, and the loop keeps what it had.
  (weak)
  (func coco_l_memberchk_end ((coco_engine * e) (size_t x) (size_t p)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)))
          (if (coco_is_nil m p) (return 0))
          (if (coco-tag-is REF (nth p (-> m heap)))
              (let ((size_t cell . #'(coco_cons m x (coco_new_var m))))
                (return (coco_m_unify e p cell))))
          (return (coco_m_type_error e "list" p))))

  (func coco_l_memberchk ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t x . #'(coco_m_arg e g 0))
              (size_t p . #'(coco_m_arg e g 1)))
          (set (-> m lbudget) (-> m heap_len))
          (while 1
            (set p (coco_deref m p))
            (if (not (coco_is_cons m p)) (return (coco_l_memberchk_end e x p)))
            (if (== (-- (-> m lbudget)) 0) (return (coco_m_type_error e "list" (coco_m_arg e g 1))))
            (let ((size_t mark . #'(-> m trail_len)))
              (if (coco_unify m x (coco_arg m p 0)) (return 1))
              (coco_undo_to m mark))
            (set p (coco_arg m p 1)))
          (return 0)))

  ;;; ---- the arithmetic walks ---------------------------------------------
  ;;;
  ;;; `sum_list/2', `max_list/2', `min_list/2' and `numlist/3' keep the
  ;;; clauses they always had and lose the PROLOG ACCUMULATORS under them:
  ;;; `'$sum'/3' and the rest were two clauses each, recursing once per
  ;;; element. Measured on a 200-element list, the same walk costs about
  ;;; 1.5us an element in Prolog and about 20ns in C -- `memberchk/2' answers
  ;;; in 4us where the same predicate written in Prolog takes 311, and
  ;;; `sum_list/2' took 230.
  ;;;
  ;;; THEY WALK THE CONS CELLS, as `memberchk' above does, rather than
  ;;; materialising the list into an array the way `$rev' must: a sum has no
  ;;; reason to allocate a second copy of what it is adding up. THE TAIL IS
  ;;; ASKED WHERE THE WALK ENDS (3.42.1), as swipl's single-sided rules ask
  ;;; it: [] ends it, and anything else -- no list, unbound, the end of a
  ;;; partial list -- raises existence_error(matching_rule, lists:NAME(Tail,
  ;;; Acc, Out)) after the elements before it were folded (`coco_l_no_rule').
  ;;; Through 3.42.0 a length call in front of each failed for any list but
  ;;; a proper one, before it read an element. A list that is its own tail
  ;;; still fails, past as many steps as the heap has cells, where swipl's
  ;;; rules walk it for ever.

  ;;; existence_error(matching_rule, lists:NAME(TAIL, ACC, OUT)), named
  ;;; lists:NAME/3 as swipl's rule names it; answers the raise's answer
  (static)
  (func coco_l_no_rule ((coco_engine * e) (const char * name) (size_t tail) (size_t acc)
                        (size_t out)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (size_t args [3]))
          (set (nth 0 args) tail)
          (set (nth 1 args) acc)
          (set (nth 2 args) out)
          (return (coco_m_raise_pi e (coco_make2 m "existence_error" (coco_new_atom m "matching_rule")
                                                 (coco_make2 m ":" (coco_new_atom m "lists")
                                                             (coco_make m name 3 args)))
                                   "lists" name 3))))

  ;;; A number as EITHER an integer or a float, which is what `is' would have
  ;;; made of it. Answers 0 for anything else, and every caller raises.
  (static)
  (func coco_l_num ((coco_engine * e) (size_t t) (i64 * iv) (double * dv) (int * isf)) (out int)
        (if (coco_m_int e t iv) (block (set (cof isf) 0) (return 1)))
        (if (coco_m_float e t dv) (block (set (cof isf) 1) (return 1)))
        (return 0))

  ;;; A FLOAT THE WALK MADE IS A NUMBER, OR WHAT THE FLAGS LET IT BE (2.2.0,
  ;;; 2.2.2), as `is/2' makes it: 1 when *D stands (`coco_float_verdict' in
  ;;; lib/solve-arith.cicili, swipl's check_float(), which makes a NaN SWI's one
  ;;; NaN), else the raise's answer through the module seam.
  (static)
  (func coco_l_float_ok ((coco_engine * e) (double * d)) (out int)
        (let ((const char * w . #'(coco_float_verdict (coco_m_machine e) d)))
          (if (== w nil) (return 1))
          (return (coco_m_evaluation_error e w))))

  ;;; One step along a list: the head and the tail, or 0 when this is not a
  ;;; cons cell. The same question `memberchk' asks.
  (static)
  (func coco_l_step ((coco_machine * m) (size_t p) (size_t * head) (size_t * tail)) (out int)
        (let ((size_t d . #'(coco_deref m p)))
          (if (not (coco_is_cons m d)) (return 0))
          (set (cof head) (coco_arg m d 0))
          (set (cof tail) (coco_arg m d 1))
          (return 1)))

  ;;; THE STEP OF SWI'S OWN CLAUSE, for an element that is no plain integer
  ;;; or float (2.15.1): OP(A, B) -- `+', `max' or `min' -- made and
  ;;; evaluated as is/2 evaluates it, its value a new number cell in *OUT.
  ;;; So an expression is evaluated (`sum_list([1+1, 2], S)' is 4), a
  ;;; rational is exact, and an atom or an unbound element raises is/2's own
  ;;; error (type_error(evaluable, a/0), instantiation_error). Through
  ;;; 2.15.0 every walk here and aggregate_all/3's three took plain numbers
  ;;; alone and raised for anything else, rationals among them. Answers 1, or
  ;;; the raise's answer. A plain number never comes here: the walks keep
  ;;; their own C for it, which is the clause's arithmetic without the term.
  (func coco_l_eval2 ((coco_engine * e) (const char * op) (size_t a) (size_t b)
                      (size_t * out)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t t . #'(coco_make2 m op a b))
              (int isf . 0) (i64 iv . 0) (double fv . 0.0)
              (int rc . #'(coco_arith_top e t (aof isf) (aof iv) (aof fv))))
          (if (!= rc 1)
              (return (? (== rc 3) (coco_type_error e "expression" t) rc)))
          (let ((size_t r . #'(? (== isf 2) (coco_new_rat m (-> m arith_n) (-> m arith_d))
                                 (? (== isf 1) (coco_new_float m fv) (coco_new_int m iv)))))
            (if (== r (cast size_t -1)) (return (coco_int_overflow e)))
            (set (cof out) r)
            (return 1))))

  ;;; `'$sum'(List, Acc, Sum)'. An integer accumulator stays an integer until
  ;;; a float arrives, which is what `B is A + H' did one clause at a time,
  ;;; and a float sum that is no finite number raises at the element that
  ;;; made it, as that `is/2' does (2.2.0; through 2.1.2 the NaN or the
  ;;; infinity was the sum). The first element that is no plain number -- an
  ;;; expression, a rational, an atom, a variable -- and every one after it
  ;;; is SWI's `Sum1 is Sum0 + X' itself (`coco_l_eval2', 2.15.1), the sum so
  ;;; far made a number cell for it: `tm' says the walk has gone that way.
  (func coco_l_sum ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t p . #'(coco_m_arg e g 0)) (size_t n . 0)
              (size_t lim . #'(-> m heap_len))
              (i64 ai . 0) (double ad . 0.0) (int af . 0)
              (int tm . 0) (size_t acc . 0)
              (size_t h . 0) (size_t t . 0))
          (if (not (coco_l_num e (coco_m_arg e g 1) (aof ai) (aof ad) (aof af))) (return 0))
          (while (coco_l_step m p (aof h) (aof t))
            ;; a list that is its own tail: past the heap's cells, no tree
            (set n (+ n 1))
            (if (> n lim) (return 0))
            (let ((i64 ei . 0) (double ed . 0.0) (int ef . 0))
              (if (or tm (not (coco_l_num e h (aof ei) (aof ed) (aof ef))))
                  (let ((int rc . 0))
                    (if (not tm)
                        (block (set acc (? af (coco_m_new_float e ad) (coco_m_new_int e ai)))
                               (set tm 1)))
                    (set rc (coco_l_eval2 e "+" acc h (aof acc)))
                    (if (!= rc 1) (return rc)))
                (block
                 (if ef
                     (block (if (not af) (block (set ad (cast double ai)) (set af 1)))
                            (set ad (+ ad ed)))
                   (if af (set ad (+ ad (cast double ei)))
                     ;; past 64 bits int_overflow, as `B is A + H' raises (2.0.0)
                     (if (coco_add_ovf ai ei (aof ai))
                         (return (coco_m_evaluation_error e "int_overflow")))))
                 (if af (let ((int rc . #'(coco_l_float_ok e (aof ad)))) (if (!= rc 1) (return rc)))))))
            (set p t))
          ;; a tail that is no [] is no rule's (3.42.1), the sum so far named
          (if (not (coco_is_nil m (coco_deref m p)))
              (return (coco_l_no_rule e "sum_list" (coco_deref m p)
                                      (? tm acc (? af (coco_m_new_float e ad) (coco_m_new_int e ai)))
                                      (coco_m_arg e g 2))))
          (if tm (return (coco_m_unify e (coco_m_arg e g 2) acc)))
          (if af (return (coco_m_unify e (coco_m_arg e g 2) (coco_m_new_float e ad))))
          (return (coco_m_unify e (coco_m_arg e g 2) (coco_m_new_int e ai)))))

  ;;; `'$maxl'' and `'$minl'' answer the ELEMENT and not a number of their
  ;;; own -- `max_list([1, 2.0], M)' is 2.0, because the clause they replace
  ;;; bound B to H rather than to its value. Each step is SWI's
  ;;; `Max1 is max(H, Max0)', H first (2.1.2, `coco_num_pick', which always
  ;;; answers one of the two): a NaN is passed over, -0.0 is the smaller
  ;;; zero, of an integer and a float that are equal the float, and two
  ;;; integers are compared as integers -- casting a pair of them to double
  ;;; loses the distinction above 2^53, the trap `compare/3' carried
  ;;; through 1.15.0. Through 2.1.1 the first of two equal ones was kept,
  ;;; and a NaN stopped the walk where it stood. Of two equal floats H is
  ;;; checked, as that `is/2' checks it (2.2.0; under the flags 2.2.2, so
  ;;; two equal infinities raise float_overflow but under float_overflow
  ;;; `infinity'); the first element is taken as it is, as SWI's is, and
  ;;; is no `max/2' of its own -- `max_list([a], M)' is a, and through
  ;;; 2.15.0 it raised. A step where either side is no plain number is SWI's
  ;;; `Max1 is max(H, Max0)' itself (`coco_l_eval2', 2.15.1): an expression
  ;;; evaluated, a rational exact, an atom raising is/2's error; `bn' says
  ;;; whether BEST is a plain number the C can pick against.
  (static)
  (func coco_l_extreme ((coco_engine * e) (size_t g) (int want)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t p . #'(coco_m_arg e g 0)) (size_t n . 0)
              (size_t lim . #'(-> m heap_len))
              (size_t best . #'(coco_m_arg e g 1))
              (size_t h . 0) (size_t t . 0)
              (i64 bi . 0) (double bd . 0.0) (int bf . 0) (int bn . 0))
          (set bn (coco_l_num e best (aof bi) (aof bd) (aof bf)))
          (while (coco_l_step m p (aof h) (aof t))
            ;; a list that is its own tail: past the heap's cells, no tree
            (set n (+ n 1))
            (if (> n lim) (return 0))
            (let ((i64 hi . 0) (double hd . 0.0) (int hf . 0))
              (if (and bn (coco_l_num e h (aof hi) (aof hd) (aof hf)))
                  (let ((int b . #'(coco_num_pick want hf hi hd bf bi bd)))
                    (if (== b 2)
                        (let ((int rc . #'(coco_l_float_ok e (aof hd))))
                          (if (!= rc 1) (return rc))
                          (set b 0)))
                    (if (== b 0) (block (set best h) (set bi hi) (set bd hd) (set bf hf))))
                (let ((int rc . #'(coco_l_eval2 e (? (> want 0) "max" "min") h best (aof best))))
                  (if (!= rc 1) (return rc))
                  (set bn (coco_l_num e best (aof bi) (aof bd) (aof bf))))))
            (set p t))
          ;; a tail that is no [] is no rule's (3.42.1), the best so far named
          (if (not (coco_is_nil m (coco_deref m p)))
              (return (coco_l_no_rule e (? (> want 0) "max_list" "min_list") (coco_deref m p)
                                      best (coco_m_arg e g 2))))
          (return (coco_m_unify e (coco_m_arg e g 2) best))))

  (func coco_l_maxl ((coco_engine * e) (size_t g)) (out int)
        (return (coco_l_extreme e g 1)))

  (func coco_l_minl ((coco_engine * e) (size_t g)) (out int)
        (return (coco_l_extreme e g -1)))

  ;;; `'$numlist'(Low, High, List)'. THE FLOAT CASE USED TO HANG: the clauses
  ;;; were `'$numlist'(H, H, [H])' and a step of one, so `numlist(1, 3.0, X)'
  ;;; never met its base case and counted upward for ever. An integer is
  ;;; required here and anything else is type_error(integer, X), with no
  ;;; context, as swipl's must_be(integer, X) raises it (3.0.0; through 2.16
  ;;; `numlist(a, 1, L)' was >/2's type_error(evaluable, a/0)); L > H fails.
  (func coco_l_numlist ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 lo . 0) (i64 hi . 0))
          (if (not (coco_m_int e (coco_m_arg e g 0) (aof lo)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
          (if (not (coco_m_int e (coco_m_arg e g 1) (aof hi)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 1))))
          (if (> lo hi) (return 0))
          ;; the count in u64 (2.0.0): `hi - lo' of the two ends of 64 bits
          ;; is past an i64. A list past the stack limit raises before its
          ;; array is asked for (3.42.3), and an array refused raises
          ;; resource_error(memory): through 3.42.2 numlist(1, 10^12, L)
          ;; failed, its malloc(3) refused
          (if (coco-l-too-long (coco_m_machine e) (- (cast u64 hi) (cast u64 lo)))
              (return (coco_m_resource_error e "stack")))
          (let ((size_t cnt . #'(cast size_t (+ (- (cast u64 hi) (cast u64 lo)) 1)))
                (size_t * v . nil) (size_t out . 0))
            ;; with no limit: a count past what an array's bytes can say --
            ;; 2^64 wraps to 0 -- is memory no machine has
            (if (or (== cnt 0) (> cnt (/ (cast size_t -1) (sizeof size_t))))
                (return (coco_m_resource_error e "memory")))
            (set v (cast (size_t *) (malloc (* cnt (sizeof size_t)))))
            (if (== v nil) (return (coco_m_resource_error e "memory")))
            (for ((size_t k . 0)) (< k cnt) ((++ k))
              (set (nth k v) (coco_m_new_int e (+ lo (cast i64 k)))))
            (set out (coco_m_list e v cnt))
            (free v)
            (return (coco_m_unify e (coco_m_arg e g 2) out)))))

  ;;; ---- one step for the modes that answer once (1.12.2) ----------------
  ;;;
  ;;; length/2, nth0/3, nth1/3, last/2 and reverse/2 were each a clause
  ;;; around one of the walks above: length/2 four steps (the clause, the
  ;;; walk, the cut, the `='), nth1/3 six, reverse/2 four, last/2 two -- a
  ;;; step a builtin is in SWI. Each is now a row of its own, and a mode
  ;;; that ENUMERATES is declined (`coco_m_decline', the `:declines' row) to
  ;;; the clause of the same name in the Coco half, which nothing else
  ;;; reaches. Every answer is the clauses' -- a failure where SWI raises
  ;;; included -- but where they went on for ever, and but last/2 of a
  ;;; partial list, which its clause failed and swipl's enumerates: since
  ;;; 3.0.1 its row declines that too, to swipl's clause.

  ;;; What a list argument is, in one walk: 1 a proper list of N cells, 2 a
  ;;; partial one -- N cells, then the unbound TAIL --, 0 neither (`foo',
  ;;; `[a|foo]'), and -1 a list that is its own tail: a cell of a list is
  ;;; three of the heap, so a walk past the heap's length has come round.
  (static)
  (func coco_l_walk ((coco_machine * m) (size_t l) (size_t * n) (size_t * tail)) (out int)
        (let ((size_t k . 0) (size_t p . l) (size_t lim . #'(-> m heap_len)))
          (while 1
            (set p (coco_deref m p))
            (if (not (coco_is_cons m p)) break)
            (set k (+ k 1))
            (if (> k lim) (return -1))
            (set p (coco_arg m p 1)))
          (set (cof n) k)
          (set (cof tail) p)
          (if (coco-tag-is REF (nth p (-> m heap))) (return 2))
          (if (not (coco-tag-is ATOM (nth p (-> m heap)))) (return 0))
          (if (not (-> m ids_ready)) (coco_ids_fill m))
          (return (? (== (coco_name_of m p) (coco-id m "[]")) 1 0))))

  ;;; `length(?List, ?N)'. A proper list's length, whatever N is; a partial
  ;;; list and an integer N bind the tail to the cells still wanted, made
  ;;; front to back as the clause's head made them (so the first is the
  ;;; oldest variable), and a prefix longer than N -- or N below 0 -- fails,
  ;;; where `length([a,b,c|T], 2)' went round the clauses for ever; so did a
  ;;; partial list and N bound to anything else (`length(L, a)'), which no
  ;;; list has, and N the tail itself (`length([a|T], T)'), which SWI fails.
  ;;; A partial list and N unbound enumerate: declined. WHAT IS WRONG IS
  ;;; RAISED, as swipl's length/2 raises it (3.0.0), N first: a bound N
  ;;; that is no integer is type_error(integer, N) and one below 0
  ;;; domain_error(not_less_than_zero, N), whatever the list is; then a list
  ;;; that is no list -- `foo', `[a|foo]', `'[]'', or one that is its own
  ;;; tail -- type_error(list, L). Through 2.16.1 all but the last failed.
  (func coco_l_length ((coco_engine * e) (size_t g) (int * found)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t l . #'(coco_m_arg e g 0)) (size_t nn . #'(coco_m_arg e g 1))
              (size_t k . 0) (size_t tail . 0) (i64 want . 0) (int kind . 0))
          (if (not (coco_m_is_var e nn))
              (block
               (if (not (coco_m_int e nn (aof want)))
                   (return (coco_m_type_error e "integer" nn)))
               (if (< want 0)
                   (return (coco_m_domain_error e "not_less_than_zero" nn)))))
          (set kind (coco_l_walk m l (aof k) (aof tail)))
          (if (== kind 1) (return (coco_m_unify_int e nn (cast i64 k))))
          (if (!= kind 2) (return (coco_m_type_error e "list" l)))
          (if (not (coco_m_is_var e nn))
              (block
               (if (< want (cast i64 k)) (return 0))
               (if (== want (cast i64 k)) (return (coco_m_unify e tail (coco_m_nil e))))
               ;; cells past the stack limit raise before one is built
               ;; (3.42.3), as swipl's: `length(L, 1000000000000)' built
               ;; for minutes until memory ran out
               (if (coco-l-too-long m (- want (cast i64 k)))
                   (return (coco_m_resource_error e "stack")))
               (let ((u64 cf . #'(coco_cons_fid m)) (size_t first . 0) (size_t prev . 0)
                     (size_t h . 0) (size_t end . 0))
                 (for ((i64 i . #'(cast i64 k))) (< i want) ((++ i))
                   (set h (coco_push_struct m (coco-cell FUN cf) 2))
                   (if (== h 0) (return 0))
                   (if (== i (cast i64 k))
                       (set first h)
                       (set (nth (+ prev 2) (-> m heap)) (coco-cell REF h)))
                   (set prev h))
                 (set end (coco_m_nil e))
                 (if (== end 0) (return 0))
                 (set (nth (+ prev 2) (-> m heap)) (coco-cell REF end))
                 (return (coco_m_unify e tail first)))))
          (if (== nn tail) (return 0))
          (coco_m_decline e)
          (set (cof found) 0)
          (return 0)))

  ;;; `nth0(?N, ?List, ?Elem)' and `nth1/3' with the index given: the
  ;;; element by '$nth0''s walk; an index below the base fails, one that is
  ;;; no integer raises, and a list that ends before the index -- `[]',
  ;;; `foo' -- fails. A WALK THAT MEETS AN UNBOUND TAIL BINDS IT (3.42.3), as
  ;;; swipl's '$seek_list'/4 and nth0_det/3 bind it, once: to the cells the
  ;;; walk had still to pass, fresh, and the element's, then a fresh tail --
  ;;; `nth0(1, L, a)' is L = [_, a|_], where through 3.42.2 the call failed.
  ;;; Cells the stack limit cannot hold raise before one is built
  ;;; (`coco-l-too-long'). An unbound index enumerates: declined.
  (static)
  (func coco_l_nth_at ((coco_engine * e) (size_t g) (int * found) (i64 base)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t ix . #'(coco_m_arg e g 0)) (i64 want . 0) (size_t p . 0))
          (if (coco_m_is_var e ix)
              (block (coco_m_decline e) (set (cof found) 0) (return 0)))
          ;; an index that is no integer is swipl's must_be(integer, I)
          ;; (3.0.0; through 2.16 the call failed)
          (if (not (coco_m_int e ix (aof want))) (return (coco_m_type_error e "integer" ix)))
          (if (< want base) (return 0))
          (set want (- want base))
          ;; the old loop, its `return 0' a break: the walk a proper list
          ;; takes is the instructions it was
          (set p (coco_m_arg e g 1))
          (while (> want 0)
            (set p (coco_deref m p))
            (if (not (coco_is_cons m p)) break)
            (set p (coco_arg m p 1))
            (set want (- want 1)))
          (set p (coco_deref m p))
          (if (coco_is_cons m p) (return (coco_m_unify e (coco_m_arg e g 2) (coco_arg m p 0))))
          (if (not (coco_m_is_var e p)) (return 0))
          (if (coco-l-too-long m want) (return (coco_m_resource_error e "stack")))
          ;; WANT cells, then the element's, each linked by its tail
          (let ((u64 cf . #'(coco_cons_fid m)) (size_t first . 0) (size_t prev . 0)
                (size_t h . 0))
            (for ((i64 i . 0)) (<= i want) ((++ i))
              (set h (coco_push_struct m (coco-cell FUN cf) 2))
              (if (== h 0) (return 0))
              (if (== i 0)
                  (set first h)
                  (set (nth (+ prev 2) (-> m heap)) (coco-cell REF h)))
              (set prev h))
            (set (nth (+ prev 1) (-> m heap)) (coco-cell REF (coco_deref m (coco_m_arg e g 2))))
            (return (coco_m_unify e p first)))))

  (func coco_l_nth0_at ((coco_engine * e) (size_t g) (int * found)) (out int)
        (return (coco_l_nth_at e g found 0)))

  (func coco_l_nth1_at ((coco_engine * e) (size_t g) (int * found)) (out int)
        (return (coco_l_nth_at e g found 1)))

  ;;; `reverse(?List, ?Reversed)': a proper list's elements consed as they
  ;;; are walked, which is its reverse. A partial list enumerates and a list
  ;;; that is its own tail went to the clause too: both declined, as they
  ;;; were; anything else (`foo') fails, as the clause did.
  (func coco_l_reverse ((coco_engine * e) (size_t g) (int * found)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t l . #'(coco_m_arg e g 0)) (size_t k . 0) (size_t tail . 0)
              (int kind . 0))
          (set kind (coco_l_walk m l (aof k) (aof tail)))
          (if (== kind 0) (return 0))
          (if (!= kind 1)
              (block (coco_m_decline e) (set (cof found) 0) (return 0)))
          (let ((size_t r . #'(coco_m_nil e)) (size_t p . l))
            (for ((size_t i . 0)) (< i k) ((++ i))
              (set p (coco_deref m p))
              (set r (coco_cons m (coco_arg m p 0) r))
              (set p (coco_arg m p 1)))
            (return (coco_m_unify e (coco_m_arg e g 1) r)))))

  ;;; `last(?List, ?Last)': a proper list's last element, in one walk that
  ;;; keeps the last cell it passed. The empty list and what is no list --
  ;;; `foo', `[a|foo]', `'[]'' -- fail, as swipl's clause does, raising
  ;;; nothing, and so does a list that is its own tail, which swipl's walks
  ;;; for ever. A PARTIAL LIST ENUMERATES, an unbound List among them
  ;;; (3.0.1): `last(L, X)' is L = [X], then [_, X], ..., and
  ;;; `last([a|T], X)' T = [] with X = a, then T = [X], ... -- declined to
  ;;; the clause. Through 3.0.0 the row was '$last''s walk, which failed
  ;;; there, and '$last'/2, which nothing had called since 1.12.2, went
  ;;; with it.
  (func coco_l_last ((coco_engine * e) (size_t g) (int * found)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t p . #'(coco_m_arg e g 0)) (size_t cell . 0)
              (size_t k . 0) (size_t lim . #'(-> m heap_len)))
          (while 1
            (set p (coco_deref m p))
            (if (not (coco_is_cons m p)) break)
            (set k (+ k 1))
            (if (> k lim) (return 0))
            (set cell p)
            (set p (coco_arg m p 1)))
          (if (coco-tag-is REF (nth p (-> m heap)))
              (block (coco_m_decline e) (set (cof found) 0) (return 0)))
          (if (or (== k 0) (not (coco_is_nil m p))) (return 0))
          (return (coco_m_unify e (coco_m_arg e g 1) (coco_arg m cell 0)))))

  ;;; ---- the module -----------------------------------------------------

  (static) (coco-emit-module-dispatch coco_l_dispatch *lists-predicates*)

  (coco-defmodule coco_lists_module "lists" coco_l_dispatch *lists-prolog*)

  ) ; impl-lists

;;;; cocolog -- the Lists library, as a module
;;;
;;; SWI-Prolog's library(lists) -- all thirty-six exported predicates, read off
;;; a running SWI rather than off a memory of one -- plus the four SWI BUILTINS
;;; the library leans on that cocolog did not have: `length/2', `msort/2',
;;; `sort/2' and `sort/4'. Those four are not part of library(lists) in SWI and
;;; are marked as such below; they are here because half the library cannot be
;;; written without them and a test cannot compare against SWI without them
;;; either.
;;;
;;; IT IS THE MIRROR IMAGE OF lib/files.cicili. Files is seventeen predicates in
;;; C and five in Prolog, because a file system is a syscall away. Lists is
;;; thirty-odd in Prolog and nine in C, because a list predicate is a couple of
;;; clauses and because MOST OF THEM MUST BE NONDETERMINISTIC -- `member/2',
;;; `select/3', `append/3' and `permutation/2' each answer many times, and a
;;; module's C half cannot: it has no access to the choice stack, deliberately,
;;; so that no module can break the invariant cocolog's suspension depends on.
;;;
;;; That is not a limitation being worked around. A nondeterministic predicate
;;; belongs in the Coco half, where the ENGINE provides the choice points and a
;;; frozen machine can be thawed in another process and go on backtracking
;;; through it. Written in C it would work until the first `cocolog step'.
;;;
;;; WHAT THE C HALF IS FOR, then, is the things that are determinate and that C
;;; is genuinely better at: sorting by the standard order of terms, and the
;;; single-pass walks that Prolog would do with a recursion and a choice point
;;; per element. Most of those are reached through a `$'-prefixed primitive
;;; and wrapped in a clause, exactly as the Files module does it. length/2,
;;; nth0/3, nth1/3, last/2 and reverse/2 are rows of their own since 1.12.2,
;;; one step in every mode that answers once, and a mode that can answer
;;; again is declined (`:declines', `coco_m_decline') to the Coco half's
;;; clause of the same name -- so `length/2' is one step when the list is
;;; proper and still generative when it is not.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;;; ------------------------------------------------------------------
;;;; The C half
;;;; ------------------------------------------------------------------
(DEFPARAMETER *lists-predicates*
  '(("msort"      2 coco_l_msort)
    ("sort"       2 coco_l_sort)
    ("sort"       4 coco_l_sort4)

    ;; ONE STEP for each mode that answers once (1.12.2), where a clause
    ;; around a walk below took 2 to 13; a mode that enumerates is
    ;; declined to the Coco half's clause of the same name
    ("length"     2 coco_l_length :declines)
    ("nth0"       3 coco_l_nth0_at :declines)
    ("nth1"       3 coco_l_nth1_at :declines)
    ("last"       2 coco_l_last)
    ("reverse"    2 coco_l_reverse :declines)

    ("$len"       2 coco_l_len)
    ("$rev"       2 coco_l_rev)
    ("$nth0"      3 coco_l_nth0)
    ("memberchk"  2 coco_l_memberchk)

    ("$sum"       3 coco_l_sum)
    ("$maxl"      3 coco_l_maxl)
    ("$minl"      3 coco_l_minl)
    ("$numlist"   3 coco_l_numlist)
    ("$last"      2 coco_l_last)))

;;;; ------------------------------------------------------------------
;;;; The Coco half
;;;; ------------------------------------------------------------------
;;; Joined with spaces: a Cicili string literal cannot carry a newline by
;;; either route -- see MODULES.md -- and Prolog does not mind, because a
;;; clause ends at its `.'. The commentary lives out here where a `%' cannot
;;; swallow the rest of the program for want of a line ending.
(DEFPARAMETER *lists-prolog*
  (FORMAT NIL "~{~A ~}"
          (LIST

           ;; ---- length/2 -------------------------------------------------
           ;; A SWI BUILTIN, not library(lists), and cocolog had none.
           ;; The C half answers every mode that answers once -- a proper
           ;; list, and a partial one with N bound (`length(L, 3)') -- and
           ;; declines a partial list with N unbound, which enumerates, to
           ;; this clause: the only call that reaches it (1.12.2).
           "length(L, N) :- '$len_gen'(L, 0, N)."
           "'$len_gen'([], N, N)."
           "'$len_gen'([_|T], A, N) :- B is A + 1, '$len_gen'(T, B, N)."

           ;; ---- append, member, and what is built on them ----------------
           "append([], L, L)."
           "append([H|T], L, [H|R]) :- append(T, L, R)."
           "append(ListOfLists, List) :- '$append2'(ListOfLists, List)."
           "'$append2'([], [])."
           "'$append2'([L|Ls], As) :- append(L, Ws, As), '$append2'(Ls, Ws)."

           "member(X, [X|_])."
           "member(X, [_|T]) :- member(X, T)."

           ;; ---- select and its relatives ---------------------------------
           "select(X, [X|T], T)."
           "select(X, [H|T], [H|R]) :- select(X, T, R)."
           "select(X, [X|T], Y, [Y|T])."
           "select(X, [H|T], Y, [H|R]) :- select(X, T, Y, R)."
           "selectchk(X, L, R) :- select(X, L, R), !."
           "selectchk(X, L, Y, R) :- select(X, L, Y, R), !."
           "subtract([], _, [])."
           "subtract([H|T], L, R) :- memberchk(H, L), !, subtract(T, L, R)."
           "subtract([H|T], L, [H|R]) :- subtract(T, L, R)."
           "intersection([], _, [])."
           "intersection([H|T], L, [H|R]) :- memberchk(H, L), !, intersection(T, L, R)."
           "intersection([_|T], L, R) :- intersection(T, L, R)."
           "union([], L, L)."
           "union([H|T], L, R) :- memberchk(H, L), !, union(T, L, R)."
           "union([H|T], L, [H|R]) :- union(T, L, R)."
           "subset([], _)."
           "subset([H|T], L) :- memberchk(H, L), subset(T, L)."

           ;; SWI deletes every element that COULD unify without binding
           ;; anything: `\\+ Elem \\= X'. Plain unification would bind a
           ;; variable in the list and delete the rest of it with it.
           "delete([], _, [])."
           "delete([H|T], X, R) :- \\+ H \\= X, !, delete(T, X, R)."
           "delete([H|T], X, [H|R]) :- delete(T, X, R)."

           ;; ---- position -------------------------------------------------
           ;; nth0/3 and nth1/3 are determinate when the index is bound --
           ;; the C half, in one step -- and enumerate when it is not: the
           ;; C half declines that call to these clauses (1.12.2).
           "nth0(N, L, E) :- '$nth_gen'(L, 0, N, E)."
           "nth1(N, L, E) :- '$nth_gen'(L, 1, N, E)."
           "'$nth_gen'([H|_], B, B, H)."
           "'$nth_gen'([_|T], B, N, E) :- C is B + 1, '$nth_gen'(T, C, N, E)."
           "nth0(N, L, E, R) :- integer(N), !, N >= 0, '$nth_sel'(L, 0, N, E, R)."
           "nth0(N, L, E, R) :- '$nth_sel'(L, 0, N, E, R)."
           "nth1(N, L, E, R) :- integer(N), !, N >= 1, '$nth_sel'(L, 1, N, E, R)."
           "nth1(N, L, E, R) :- '$nth_sel'(L, 1, N, E, R)."
           "'$nth_sel'([H|T], B, B, H, T)."
           "'$nth_sel'([H|T], B, N, E, [H|R]) :- C is B + 1, '$nth_sel'(T, C, N, E, R)."

           ;; last/2 is the C half's alone (1.12.2): it never enumerated
           "nextto(X, Y, [X,Y|_])."
           "nextto(X, Y, [_|T]) :- nextto(X, Y, T)."
           "prefix(P, L) :- append(P, _, L)."

           ;; ---- shape ----------------------------------------------------
           ;; a proper list is reversed by the C half in one step; anything
           ;; it declines -- a partial list, which enumerates -- comes here
           "reverse(L, R) :- '$rev_gen'(L, [], R)."
           "'$rev_gen'([], A, A)."
           "'$rev_gen'([H|T], A, R) :- '$rev_gen'(T, [H|A], R)."
           "proper_length(L, N) :- is_list(L), '$len'(L, N)."
           "same_length([], [])."
           "same_length([_|T], [_|R]) :- same_length(T, R)."
           "permutation(Xs, Ys) :- same_length(Xs, Ys), '$perm'(Xs, Ys)."
           "'$perm'([], [])."
           "'$perm'(L, [H|T]) :- select(H, L, R), '$perm'(R, T)."

           "flatten(L, F) :- '$flatten'(L, [], F0), !, F = F0."
           "'$flatten'(V, T, [V|T]) :- var(V), !."
           "'$flatten'([], T, T) :- !."
           "'$flatten'([H|R], T, F) :- !, '$flatten'(R, T, F0), '$flatten'(H, F0, F)."
           "'$flatten'(A, T, [A|T])."

           ;; ---- sets -----------------------------------------------------
           ;; list_to_set/2 keeps the FIRST of each group and the original
           ;; order, which is not what sorting would give.
           "list_to_set(L, S) :- '$l2s'(L, [], S)."
           "'$l2s'([], _, [])."
           "'$l2s'([H|T], Seen, R) :- '$mem_eq'(H, Seen), !, '$l2s'(T, Seen, R)."
           "'$l2s'([H|T], Seen, [H|R]) :- '$l2s'(T, [H|Seen], R)."
           "'$mem_eq'(X, [Y|_]) :- X == Y, !."
           "'$mem_eq'(X, [_|T]) :- '$mem_eq'(X, T)."
           "is_set(L) :- is_list(L), list_to_set(L, S), '$len'(S, N), '$len'(L, N)."

           ;; run-length pairs: [a,a,b] becomes [a-2, b-1]
           "clumped([], [])."
           "clumped([H|T], [H-N|R]) :- '$clump'(T, H, 1, N, Rest), clumped(Rest, R)."
           "'$clump'([H|T], X, A, N, Rest) :- H == X, !, B is A + 1, '$clump'(T, X, B, N, Rest)."
           "'$clump'(L, _, N, N, L)."

           ;; ---- arithmetic over a list -----------------------------------
           "sum_list(L, S) :- '$sum'(L, 0, S)."
           "max_list([H|T], M) :- '$maxl'(T, H, M)."
           "min_list([H|T], M) :- '$minl'(T, H, M)."
           "numlist(L, H, []) :- L > H, !, fail."
           "numlist(L, H, R) :- '$numlist'(L, H, R)."

           ;; ---- the standard order over a list ---------------------------
           ;; max_member/2 and min_member/2 use the STANDARD ORDER of terms and
           ;; not arithmetic, so `max_member(M, [1, a])' is `a'.
           "max_member(M, L) :- '$len'(L, N), N > 0, msort(L, S), last(S, M)."
           "min_member(M, [H|T]) :- msort([H|T], [M|_])."
           ;; the /3 forms take a comparison predicate, which is what call/N in
           ;; the engine exists for
           "max_member(P, M, [H|T]) :- '$max_by'(T, P, H, M)."
           "'$max_by'([], _, A, A)."
           "'$max_by'([H|T], P, A, M) :- (call(P, A, H) -> B = H ; B = A), '$max_by'(T, P, B, M)."
           "min_member(P, M, [H|T]) :- '$min_by'(T, P, H, M)."
           "'$min_by'([], _, A, A)."
           "'$min_by'([H|T], P, A, M) :- (call(P, H, A) -> B = H ; B = A), '$min_by'(T, P, B, M)."

           ;; ---- two of library(ordsets) ---------------------------------
           ;;
           ;; NOT SWI'S LISTS LIBRARY. They are here because SWI's
           ;; `library(dcg/high_order)' imports them and they are the only two
           ;; of ordsets it uses -- a whole module for two predicates that a
           ;; sorted-merge writes in six clauses would be ceremony. MODULES.md
           ;; records where they really belong.
           ;;
           ;; An ORDERED SET is a sorted list without duplicates, so both walk
           ;; the two lists once and compare, rather than searching.
           "ord_intersection([], _, [])."
           "ord_intersection([_|_], [], [])."
           "ord_intersection([A|As], [B|Bs], R) :- compare(O, A, B),"
           "    '$ord_int'(O, A, As, B, Bs, R)."
           "'$ord_int'(=, A, As, _, Bs, [A|R]) :- ord_intersection(As, Bs, R)."
           "'$ord_int'(<, _, As, B, Bs, R) :- ord_intersection(As, [B|Bs], R)."
           "'$ord_int'(>, A, As, _, Bs, R) :- ord_intersection([A|As], Bs, R)."

           "ord_subtract([], _, [])."
           "ord_subtract([A|As], [], [A|As])."
           "ord_subtract([A|As], [B|Bs], R) :- compare(O, A, B),"
           "    '$ord_sub'(O, A, As, B, Bs, R)."
           "'$ord_sub'(=, _, As, _, Bs, R) :- ord_subtract(As, Bs, R)."
           "'$ord_sub'(<, A, As, B, Bs, [A|R]) :- ord_subtract(As, [B|Bs], R)."
           "'$ord_sub'(>, A, As, _, Bs, R) :- ord_subtract([A|As], Bs, R)."

           ;; ---- memory management ---------------------------------------
           ;;
           ;; NOT SWI'S LISTS LIBRARY EITHER, and could not be: it exists
           ;; because of how THIS engine reclaims. The heap is truncated only
           ;; by backtracking -- success frees nothing, and a term below the
           ;; current choice point cannot be freed at all, so a predicate
           ;; that "frees a list you hand it" is unimplementable and this one
           ;; does not pretend to be it. `free_list(Build, Use)' runs
           ;; `call(Build, L)' to make the list and `call(Use, L)' to consume
           ;; it INSIDE a double negation: on the way out both negations
           ;; backtrack, and the heap comes back to where it stood -- the
           ;; list, and everything else built inside, is reclaimed. Measured:
           ;; thirty rounds of a 200000-element list peak at ONE list's
           ;; memory; the same rounds bound in an accumulator peak at thirty.
           ;;
           ;; THE PRICE IS THE POINT: no binding survives. What Use learns
           ;; must leave through a side channel that survives backtracking --
           ;; write it, file it (write_file_from_codes/2), assert it small.
           ;; A result that must come back as a BINDING does not belong in a
           ;; freed scope.
           "free_list(Build, Use) :- \\+ \\+ ( call(Build, L), call(Use, L) ).")))

(generic decl-lists
  ()

  ;;; Registers the module. A target calls this after `coco_module_init'.
  (decl) (func coco_lists_module () (out int))

  ) ; decl-lists


(generic impl-lists
  ()

  ;;; ---- sorting --------------------------------------------------------

  ;;; The standard order of terms, through `coco_compare', which is the same
  ;;; comparison `compare/3', `@<' and the clause store already use -- so a
  ;;; sorted list here and a `@<' test in a program cannot disagree.
  ;;;
  ;;; qsort(3) is not stable and SWI's msort/2 is; but msort/2 orders by the
  ;;; standard order alone, under which two elements that compare equal are
  ;;; indistinguishable, so stability is unobservable. `sort/4' is another
  ;;; matter -- there the KEY is compared and the rest of the term is not --
  ;;; and that one is sorted with an insertion pass instead.
  ;;; RUNG 191.14 (from CivV): THREAD-LOCAL, and it has to be. The array
  ;;; qsort is handed holds HEAP INDICES, not pointers, and this variable is
  ;;; the only thing that says which machine those indices belong to. As a
  ;;; file-scope static it was one slot for the whole process, so two threads
  ;;; sorting at once had the second overwrite the first's machine and the
  ;;; first's comparator then indexed a foreign heap.
  ;;;
  ;;; Reproduced through library(cowork) itself: 2000 sorting jobs on a
  ;;; four-worker crew while the main thread sorted 1500 times -- SIGSEGV,
  ;;; three runs of three. With a thin overlap it comes back clean every
  ;;; time, which is why a light test does not find it. CivV sorts three
  ;;; times a frame in its renderer and about twenty times an AI turn, so a
  ;;; crew doing game work overlaps the drawing thread by construction.
  ;;;
  ;;; `(thread-local)' emits `__thread', which takes a trivially destroyed
  ;;; type -- a bare pointer qualifies, as x509's and tls's buffers do. It
  ;;; replaces `(static)' rather than joining it because no attribute in this
  ;;; tree is stacked and the emitter has never been asked to.
  (thread-local) (var coco_machine * coco_l_sort_machine)

  (static)
  (func coco_l_cmp ((const void * a) (const void * b)) (out int)
        (return (coco_compare coco_l_sort_machine
                            (cof (cast (const size_t *) a))
                            (cof (cast (const size_t *) b)))))

  ;;; Shared by msort/2 and sort/2: the only difference is whether elements
  ;;; that compare equal are kept. A sort that drops them takes a list that
  ;;; is its own tail as the set of its elements, as SWI's does (1.10.19;
  ;;; through 1.10.18 the walk went round it for ever); msort/2 raises.
  (static)
  (func coco_l_sort_common ((coco_engine * e) (size_t g) (int dedup)) (out int)
        (let ((size_t * v . nil) (size_t n . 0) (size_t out . 0))
          (if (not (coco_m_list_array e (coco_m_arg e g 0) (aof v) (aof n)))
              (if (not (and dedup (coco_list_cycle_items (coco_m_machine e) (coco_m_arg e g 0)
                                                         (aof v) (aof n))))
                  (return (coco_m_type_error e "list" (coco_m_arg e g 0)))))
          (set coco_l_sort_machine (coco_m_machine e))
          (qsort v n (sizeof size_t) coco_l_cmp)
          (if dedup
              (let ((size_t k . 0))
                (for ((size_t i . 0)) (< i n) ((++ i))
                  (if (or (== k 0)
                          (!= 0 (coco_compare (coco_m_machine e)
                                            (nth (- k 1) v) (nth i v))))
                      (block (set (nth k v) (nth i v)) (set k (+ k 1)))))
                (set n k)))
          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 1) out))))

  (func coco_l_msort ((coco_engine * e) (size_t g)) (out int)
        (return (coco_l_sort_common e g 0)))

  (func coco_l_sort ((coco_engine * e) (size_t g)) (out int)
        (return (coco_l_sort_common e g 1)))

  ;;; `sort(+Key, +Order, +List, -Sorted)'. Key 0 is the whole term; Key N is
  ;;; the Nth argument of it. Order is one of @< @=< @> @>= -- the two with the
  ;;; `=' keep duplicates and the two without remove them, which is the rule
  ;;; that catches everybody out and is exactly SWI's.
  ;;;
  ;;; INSERTION AND NOT qsort, because this one has to be STABLE: two terms
  ;;; with equal keys and different bodies are distinguishable, so the order
  ;;; they arrived in is observable and SWI keeps it.
  (static)
  (func coco_l_key ((coco_engine * e) (size_t t) (i64 k)) (out size_t)
        (let ((coco_machine * m . #'(coco_m_machine e)))
          (if (== k 0) (return t))
          (set t (coco_deref m t))
          (if (not (coco_is_callable m t)) (return t))
          (if (> (cast u32 k) (coco_arity m t)) (return t))
          (return (coco_arg m t (cast u32 (- k 1))))))

  (func coco_l_sort4 ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 key . 0) (const char * order)
              (size_t * v . nil) (size_t n . 0) (size_t out . 0)
              (int descending . 0) (int keep . 0))

          (if (not (coco_m_int e (coco_m_arg e g 0) (aof key)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
          (if (< key 0) (return (coco_m_domain_error e "not_less_than_zero" (coco_m_arg e g 0))))
          (set order (coco_m_atom e (coco_m_arg e g 1)))
          (if (== order nil)
              (return (coco_m_domain_error e "order" (coco_m_arg e g 1))))
          (cond
            ((== 0 (strcmp order "@<"))  (block (set descending 0) (set keep 0)))
            ((== 0 (strcmp order "@=<")) (block (set descending 0) (set keep 1)))
            ((== 0 (strcmp order "@>"))  (block (set descending 1) (set keep 0)))
            ((== 0 (strcmp order "@>=")) (block (set descending 1) (set keep 1)))
            (#t (return (coco_m_domain_error e "order" (coco_m_arg e g 1)))))

          ;; an order that drops duplicates takes a list that is its own
          ;; tail as its elements, as sort/2 does (1.10.19)
          (if (not (coco_m_list_array e (coco_m_arg e g 2) (aof v) (aof n)))
              (if (not (and (not keep) (coco_list_cycle_items (coco_m_machine e) (coco_m_arg e g 2)
                                                              (aof v) (aof n))))
                  (return (coco_m_type_error e "list" (coco_m_arg e g 2)))))

          ;; a STABLE merge sort, bottom-up. This was an insertion sort,
          ;; "n is small in every use this has" -- and keysort/2 is this
          ;; at key 1, which the reasoning tagger's judge put a table of
          ;; thirty-five thousand words through: 10.6 s where msort/2 took
          ;; 0.02, and a process that tagged one sentence paid 42 s before
          ;; its first answer. Equal keys keep their arrival order, which
          ;; bagof/3 needs: the left run wins a tie.
          (if (> n 1)
            (let ((size_t * tmp . #'(cast (size_t *) (malloc (* n (sizeof size_t)))))
                  (size_t * src . v) (size_t * dst . nil))
              (if (== tmp nil) (block (free v) (return (coco_m_resource_error e "memory"))))
              (set dst tmp)
              (for ((size_t width . 1)) (< width n) ((set width (* width 2)))
                (for ((size_t lo . 0)) (< lo n) ((set lo (+ lo (* width 2))))
                  (let ((size_t mid . #'(+ lo width)) (size_t hi . #'(+ lo (* width 2)))
                        (size_t i . lo) (size_t j . 0) (size_t k . lo))
                    (if (> mid n) (set mid n))
                    (if (> hi n) (set hi n))
                    (set j mid)
                    (while (< k hi)
                      (let ((int take_left . 0))
                        (if (>= j hi)
                            (set take_left 1)
                            (if (>= i mid)
                                (set take_left 0)
                                (let ((int c . #'(coco_compare (coco_m_machine e)
                                                             (coco_l_key e (nth i src) key)
                                                             (coco_l_key e (nth j src) key))))
                                  (if descending (set c (- 0 c)))
                                  (set take_left (<= c 0)))))
                        (if take_left
                            (block (set (nth k dst) (nth i src)) (set i (+ i 1)))
                            (block (set (nth k dst) (nth j src)) (set j (+ j 1))))
                        (set k (+ k 1))))))
                (let ((size_t * t . src)) (set src dst) (set dst t)))
              (if (!= src v)
                  (for ((size_t i . 0)) (< i n) ((++ i)) (set (nth i v) (nth i src))))
              (free tmp)))

          (if (not keep)
              (let ((size_t k . 0))
                (for ((size_t i . 0)) (< i n) ((++ i))
                  (if (or (== k 0)
                          (!= 0 (coco_compare (coco_m_machine e)
                                            (coco_l_key e (nth (- k 1) v) key)
                                            (coco_l_key e (nth i v) key))))
                      (block (set (nth k v) (nth i v)) (set k (+ k 1)))))
                (set n k)))

          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 3) out))))

  ;;; ---- the determinate walks ------------------------------------------

  ;;; Only for a PROPER list. A partial one is not an error here -- it is the
  ;;; signal that the clause above should try the generative path instead.
  ;;; A list that is its own tail is neither, and SWI's length/2 raises
  ;;; `type_error(list, L)' over one, asked for its length or not (1.10.19:
  ;;; the generative path went round it for ever).
  (func coco_l_len ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t n . 0))
          (if (not (coco_m_list_length e (coco_m_arg e g 0) (aof n)))
              (block
               (if (coco_list_cyclic (coco_m_machine e) (coco_m_arg e g 0))
                   (return (coco_m_type_error e "list" (coco_m_arg e g 0))))
               (return 0)))
          (return (coco_m_unify_int e (coco_m_arg e g 1) (cast i64 n)))))

  (func coco_l_rev ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t * v . nil) (size_t n . 0) (size_t out . 0))
          (if (not (coco_m_list_array e (coco_m_arg e g 0) (aof v) (aof n))) (return 0))
          (for ((size_t i . 0)) (< i (/ n 2)) ((++ i))
            (let ((size_t tmp . #'(nth i v)))
              (set (nth i v) (nth (- (- n 1) i) v))
              (set (nth (- (- n 1) i) v) tmp)))
          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 1) out))))

  ;;; The index is already known to be a non-negative integer -- the clause
  ;;; that calls this checked -- so out of range is a plain failure.
  (func coco_l_nth0 ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (i64 want . 0) (size_t p))
          (if (not (coco_m_int e (coco_m_arg e g 0) (aof want))) (return 0))
          (if (< want 0) (return 0))
          (set p (coco_m_arg e g 1))
          (while (> want 0)
            (set p (coco_deref m p))
            (if (not (coco_is_cons m p)) (return 0))
            (set p (coco_arg m p 1))
            (set want (- want 1)))
          (set p (coco_deref m p))
          (if (not (coco_is_cons m p)) (return 0))
          (return (coco_m_unify e (coco_m_arg e g 2) (coco_arg m p 0)))))

  ;;; UNIFIES, and keeps the first that works -- `memberchk(X, [a,b])' binds X
  ;;; to a. Every attempt that fails is wound back, because a builtin that
  ;;; fails is not a choice point and the engine winds nothing back for it.
  ;;; A LIST THAT IS ITS OWN TAIL ends the walk once it has met more cells
  ;;; than the heap holds, with SWI's `type_error(list, L)' (1.10.19: it
  ;;; went round for ever); an element found before that is found, as SWI's.
  ;;; The count is the machine's (`lbudget'), and the loop reads one machine:
  ;;; through the SDK's mark, unify and undo, which each read `e->m' again,
  ;;; it held two, and the count left one of them on the stack (+12 % of its
  ;;; own cost, a local count; +1.7 % in the machine).
  (func coco_l_memberchk ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t x . #'(coco_m_arg e g 0))
              (size_t p . #'(coco_m_arg e g 1)))
          (set (-> m lbudget) (-> m heap_len))
          (while 1
            (set p (coco_deref m p))
            (if (not (coco_is_cons m p)) (return 0))
            (if (== (-- (-> m lbudget)) 0) (return (coco_m_type_error e "list" (coco_m_arg e g 1))))
            (let ((size_t mark . #'(-> m trail_len)))
              (if (coco_unify m x (coco_arg m p 0)) (return 1))
              (coco_undo_to m mark))
            (set p (coco_arg m p 1)))
          (return 0)))

  ;;; ---- the arithmetic walks ---------------------------------------------
  ;;;
  ;;; `sum_list/2', `max_list/2', `min_list/2', `numlist/3' and `last/2' keep
  ;;; the clauses they always had and lose the PROLOG ACCUMULATORS under
  ;;; them: `'$sum'/3' and the rest were two clauses each, recursing once per
  ;;; element. Measured on a 200-element list, the same walk costs about
  ;;; 1.5us an element in Prolog and about 20ns in C -- `memberchk/2' answers
  ;;; in 4us where the same predicate written in Prolog takes 311, and
  ;;; `sum_list/2' took 230.
  ;;;
  ;;; THEY WALK THE CONS CELLS, as `memberchk' above does, rather than
  ;;; materialising the list into an array the way `$rev' must: a sum has no
  ;;; reason to allocate a second copy of what it is adding up. The length
  ;;; call in front of each is the PROPER-LIST CHECK -- `sum_list(foo, X)'
  ;;; fails rather than answering 0, which is what the `'$sum'([], A, A)'
  ;;; clause used to enforce by needing a real nil at the end.

  ;;; A number as EITHER an integer or a float, which is what `is' would have
  ;;; made of it. Answers 0 for anything else, and every caller raises.
  (static)
  (func coco_l_num ((coco_engine * e) (size_t t) (i64 * iv) (double * dv) (int * isf)) (out int)
        (if (coco_m_int e t iv) (block (set (cof isf) 0) (return 1)))
        (if (coco_m_float e t dv) (block (set (cof isf) 1) (return 1)))
        (return 0))

  ;;; A FLOAT THE WALK MADE IS A NUMBER, OR WHAT THE FLAGS LET IT BE (2.2.0,
  ;;; 2.2.2), as `is/2' makes it: 1 when *D stands (`coco_float_verdict' in
  ;;; lib/solve.cicili, swipl's check_float(), which makes a NaN SWI's one
  ;;; NaN), else the raise's answer through the module seam.
  (static)
  (func coco_l_float_ok ((coco_engine * e) (double * d)) (out int)
        (let ((const char * w . #'(coco_float_verdict (coco_m_machine e) d)))
          (if (== w nil) (return 1))
          (return (coco_m_evaluation_error e w))))

  ;;; One step along a list: the head and the tail, or 0 when this is not a
  ;;; cons cell. The same question `memberchk' asks.
  (static)
  (func coco_l_step ((coco_machine * m) (size_t p) (size_t * head) (size_t * tail)) (out int)
        (let ((size_t d . #'(coco_deref m p)))
          (if (not (coco_is_cons m d)) (return 0))
          (set (cof head) (coco_arg m d 0))
          (set (cof tail) (coco_arg m d 1))
          (return 1)))

  ;;; `'$sum'(List, Acc, Sum)'. An integer accumulator stays an integer until
  ;;; a float arrives, which is what `B is A + H' did one clause at a time,
  ;;; and a float sum that is no finite number raises at the element that
  ;;; made it, as that `is/2' does (2.2.0; through 2.1.2 the NaN or the
  ;;; infinity was the sum).
  (func coco_l_sum ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t p . #'(coco_m_arg e g 0)) (size_t n . 0)
              (i64 ai . 0) (double ad . 0.0) (int af . 0)
              (size_t h . 0) (size_t t . 0))
          (if (not (coco_m_list_length e (coco_m_arg e g 0) (aof n))) (return 0))
          (if (not (coco_l_num e (coco_m_arg e g 1) (aof ai) (aof ad) (aof af))) (return 0))
          (while (coco_l_step m p (aof h) (aof t))
            (let ((i64 ei . 0) (double ed . 0.0) (int ef . 0))
              (if (not (coco_l_num e h (aof ei) (aof ed) (aof ef)))
                  (return (coco_m_type_error e "evaluable" h)))
              (if ef
                  (block (if (not af) (block (set ad (cast double ai)) (set af 1)))
                         (set ad (+ ad ed)))
                (if af (set ad (+ ad (cast double ei)))
                  ;; past 64 bits int_overflow, as `B is A + H' raises (2.0.0)
                  (if (coco_add_ovf ai ei (aof ai))
                      (return (coco_m_evaluation_error e "int_overflow")))))
              (if af (let ((int rc . #'(coco_l_float_ok e (aof ad)))) (if (!= rc 1) (return rc)))))
            (set p t))
          (if af (return (coco_m_unify e (coco_m_arg e g 2) (coco_m_new_float e ad))))
          (return (coco_m_unify e (coco_m_arg e g 2) (coco_m_new_int e ai)))))

  ;;; `'$maxl'' and `'$minl'' answer the ELEMENT and not a number of their
  ;;; own -- `max_list([1, 2.0], M)' is 2.0, because the clause they replace
  ;;; bound B to H rather than to its value. Each step is SWI's
  ;;; `Max1 is max(H, Max0)', H first (2.1.2, `coco_num_pick', which always
  ;;; answers one of the two): a NaN is passed over, -0.0 is the smaller
  ;;; zero, of an integer and a float that are equal the float, and two
  ;;; integers are compared as integers -- casting a pair of them to double
  ;;; loses the distinction above 2^53, the trap `compare/3' carried
  ;;; through 1.15.0. Through 2.1.1 the first of two equal ones was kept,
  ;;; and a NaN stopped the walk where it stood. Of two equal floats H is
  ;;; checked, as that `is/2' checks it (2.2.0; under the flags 2.2.2, so
  ;;; two equal infinities raise float_overflow but under float_overflow
  ;;; `infinity'); the first element is taken as it is, as SWI's is, and
  ;;; is no `max/2' of its own.
  (static)
  (func coco_l_extreme ((coco_engine * e) (size_t g) (int want)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t p . #'(coco_m_arg e g 0)) (size_t n . 0)
              (size_t best . #'(coco_m_arg e g 1))
              (size_t h . 0) (size_t t . 0)
              (i64 bi . 0) (double bd . 0.0) (int bf . 0))
          (if (not (coco_m_list_length e (coco_m_arg e g 0) (aof n))) (return 0))
          (if (not (coco_l_num e best (aof bi) (aof bd) (aof bf)))
              (return (coco_m_type_error e "evaluable" best)))
          (while (coco_l_step m p (aof h) (aof t))
            (let ((i64 hi . 0) (double hd . 0.0) (int hf . 0))
              (if (not (coco_l_num e h (aof hi) (aof hd) (aof hf)))
                  (return (coco_m_type_error e "evaluable" h)))
              (let ((int b . #'(coco_num_pick want hf hi hd bf bi bd)))
                (if (== b 2)
                    (let ((int rc . #'(coco_l_float_ok e (aof hd))))
                      (if (!= rc 1) (return rc))
                      (set b 0)))
                (if (== b 0) (block (set best h) (set bi hi) (set bd hd) (set bf hf)))))
            (set p t))
          (return (coco_m_unify e (coco_m_arg e g 2) best))))

  (func coco_l_maxl ((coco_engine * e) (size_t g)) (out int)
        (return (coco_l_extreme e g 1)))

  (func coco_l_minl ((coco_engine * e) (size_t g)) (out int)
        (return (coco_l_extreme e g -1)))

  ;;; `'$numlist'(Low, High, List)'. THE FLOAT CASE USED TO HANG: the clauses
  ;;; were `'$numlist'(H, H, [H])' and a step of one, so `numlist(1, 3.0, X)'
  ;;; never met its base case and counted upward for ever. An integer is
  ;;; required here and anything else is a type_error naming itself.
  (func coco_l_numlist ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 lo . 0) (i64 hi . 0))
          (if (not (coco_m_int e (coco_m_arg e g 0) (aof lo)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
          (if (not (coco_m_int e (coco_m_arg e g 1) (aof hi)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 1))))
          (if (> lo hi) (return 0))
          ;; the count in u64 (2.0.0): `hi - lo' of the two ends of 64 bits
          ;; is past an i64, and a list that long is no memory's anyway
          (let ((size_t cnt . #'(cast size_t (+ (- (cast u64 hi) (cast u64 lo)) 1)))
                (size_t * v . nil) (size_t out . 0))
            (set v (cast (size_t *) (malloc (* cnt (sizeof size_t)))))
            (if (== v nil) (return 0))
            (for ((size_t k . 0)) (< k cnt) ((++ k))
              (set (nth k v) (coco_m_new_int e (+ lo (cast i64 k)))))
            (set out (coco_m_list e v cnt))
            (free v)
            (return (coco_m_unify e (coco_m_arg e g 2) out)))))

  ;;; `'$last'(List, Last)'. Fails on the empty list and on anything that is
  ;;; not a proper one, which is what the two clauses did.
  (func coco_l_last ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t p . #'(coco_m_arg e g 0)) (size_t n . 0)
              (size_t h . 0) (size_t t . 0) (size_t best . 0) (int any . 0))
          (if (not (coco_m_list_length e (coco_m_arg e g 0) (aof n))) (return 0))
          (while (coco_l_step m p (aof h) (aof t))
            (set best h) (set any 1) (set p t))
          (if (not any) (return 0))
          (return (coco_m_unify e (coco_m_arg e g 1) best))))

  ;;; ---- one step for the modes that answer once (1.12.2) ----------------
  ;;;
  ;;; length/2, nth0/3, nth1/3, last/2 and reverse/2 were each a clause
  ;;; around one of the walks above: length/2 four steps (the clause, the
  ;;; walk, the cut, the `='), nth1/3 six, reverse/2 four, last/2 two -- a
  ;;; step a builtin is in SWI. Each is now a row of its own, and a mode
  ;;; that ENUMERATES is declined (`coco_m_decline', the `:declines' row) to
  ;;; the clause of the same name in the Coco half, which nothing else
  ;;; reaches. Every answer is the clauses' -- a failure where SWI raises
  ;;; included -- but where they went on for ever.

  ;;; What a list argument is, in one walk: 1 a proper list of N cells, 2 a
  ;;; partial one -- N cells, then the unbound TAIL --, 0 neither (`foo',
  ;;; `[a|foo]'), and -1 a list that is its own tail: a cell of a list is
  ;;; three of the heap, so a walk past the heap's length has come round.
  (static)
  (func coco_l_walk ((coco_machine * m) (size_t l) (size_t * n) (size_t * tail)) (out int)
        (let ((size_t k . 0) (size_t p . l) (size_t lim . #'(-> m heap_len)))
          (while 1
            (set p (coco_deref m p))
            (if (not (coco_is_cons m p)) break)
            (set k (+ k 1))
            (if (> k lim) (return -1))
            (set p (coco_arg m p 1)))
          (set (cof n) k)
          (set (cof tail) p)
          (if (coco-tag-is REF (nth p (-> m heap))) (return 2))
          (if (not (coco-tag-is ATOM (nth p (-> m heap)))) (return 0))
          (if (not (-> m ids_ready)) (coco_ids_fill m))
          (return (? (== (coco_name_of m p) (coco-id m "[]")) 1 0))))

  ;;; `length(?List, ?N)'. A proper list's length, whatever N is; a partial
  ;;; list and an integer N bind the tail to the cells still wanted, made
  ;;; front to back as the clause's head made them (so the first is the
  ;;; oldest variable), and a prefix longer than N -- or N below 0 -- fails,
  ;;; where `length([a,b,c|T], 2)' went round the clauses for ever; so did a
  ;;; partial list and N bound to anything else (`length(L, a)'), which no
  ;;; list has, and N the tail itself (`length([a|T], T)'), which SWI fails.
  ;;; A partial list and N unbound enumerate: declined. A list that is its
  ;;; own tail is SWI's type_error(list, L), and `foo' or `[a|foo]' has no
  ;;; length, as the clauses said.
  (func coco_l_length ((coco_engine * e) (size_t g) (int * found)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t l . #'(coco_m_arg e g 0)) (size_t nn . #'(coco_m_arg e g 1))
              (size_t k . 0) (size_t tail . 0) (i64 want . 0) (int kind . 0))
          (set kind (coco_l_walk m l (aof k) (aof tail)))
          (if (== kind 1) (return (coco_m_unify_int e nn (cast i64 k))))
          (if (== kind -1) (return (coco_m_type_error e "list" l)))
          (if (== kind 0) (return 0))
          (if (coco_m_int e nn (aof want))
              (block
               (if (< want (cast i64 k)) (return 0))
               (if (== want (cast i64 k)) (return (coco_m_unify e tail (coco_m_nil e))))
               (let ((u64 cf . #'(coco_cons_fid m)) (size_t first . 0) (size_t prev . 0)
                     (size_t h . 0) (size_t end . 0))
                 (for ((i64 i . #'(cast i64 k))) (< i want) ((++ i))
                   (set h (coco_push_struct m (coco-cell FUN cf) 2))
                   (if (== h 0) (return 0))
                   (if (== i (cast i64 k))
                       (set first h)
                       (set (nth (+ prev 2) (-> m heap)) (coco-cell REF h)))
                   (set prev h))
                 (set end (coco_m_nil e))
                 (if (== end 0) (return 0))
                 (set (nth (+ prev 2) (-> m heap)) (coco-cell REF end))
                 (return (coco_m_unify e tail first)))))
          (if (not (coco_m_is_var e nn)) (return 0))
          (if (== nn tail) (return 0))
          (coco_m_decline e)
          (set (cof found) 0)
          (return 0)))

  ;;; `nth0(?N, ?List, ?Elem)' and `nth1/3' with the index given: the
  ;;; element by '$nth0''s walk; an index below the base or past the end
  ;;; fails, and so does one bound to anything but an integer (the clauses'
  ;;; `integer(N)' and `var(N)' both said no). An unbound index enumerates:
  ;;; declined.
  (static)
  (func coco_l_nth_at ((coco_engine * e) (size_t g) (int * found) (i64 base)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t ix . #'(coco_m_arg e g 0)) (i64 want . 0) (size_t p . 0))
          (if (coco_m_is_var e ix)
              (block (coco_m_decline e) (set (cof found) 0) (return 0)))
          (if (not (coco_m_int e ix (aof want))) (return 0))
          (if (< want base) (return 0))
          (set want (- want base))
          (set p (coco_m_arg e g 1))
          (while (> want 0)
            (set p (coco_deref m p))
            (if (not (coco_is_cons m p)) (return 0))
            (set p (coco_arg m p 1))
            (set want (- want 1)))
          (set p (coco_deref m p))
          (if (not (coco_is_cons m p)) (return 0))
          (return (coco_m_unify e (coco_m_arg e g 2) (coco_arg m p 0)))))

  (func coco_l_nth0_at ((coco_engine * e) (size_t g) (int * found)) (out int)
        (return (coco_l_nth_at e g found 0)))

  (func coco_l_nth1_at ((coco_engine * e) (size_t g) (int * found)) (out int)
        (return (coco_l_nth_at e g found 1)))

  ;;; `reverse(?List, ?Reversed)': a proper list's elements consed as they
  ;;; are walked, which is its reverse. A partial list enumerates and a list
  ;;; that is its own tail went to the clause too: both declined, as they
  ;;; were; anything else (`foo') fails, as the clause did.
  (func coco_l_reverse ((coco_engine * e) (size_t g) (int * found)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t l . #'(coco_m_arg e g 0)) (size_t k . 0) (size_t tail . 0)
              (int kind . 0))
          (set kind (coco_l_walk m l (aof k) (aof tail)))
          (if (== kind 0) (return 0))
          (if (!= kind 1)
              (block (coco_m_decline e) (set (cof found) 0) (return 0)))
          (let ((size_t r . #'(coco_m_nil e)) (size_t p . l))
            (for ((size_t i . 0)) (< i k) ((++ i))
              (set p (coco_deref m p))
              (set r (coco_cons m (coco_arg m p 0) r))
              (set p (coco_arg m p 1)))
            (return (coco_m_unify e (coco_m_arg e g 1) r)))))

  ;;; ---- the module -----------------------------------------------------

  (static) (coco-emit-module-dispatch coco_l_dispatch *lists-predicates*)

  (coco-defmodule coco_lists_module "lists" coco_l_dispatch *lists-prolog*)

  ) ; impl-lists

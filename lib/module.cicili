;;;; cocolog -- modules: the bridge between C and Coco
;;;
;;; A MODULE IS A PIECE OF COCOLOG WRITTEN BY SOMEBODY ELSE. It carries two
;;; halves and either may be empty:
;;;
;;;   THE C HALF   predicates implemented in Cicili, for the things Prolog
;;;                cannot reach on its own -- a syscall, a clock, a socket.
;;;   THE COCO HALF  ordinary clauses, as text, consulted into the session when
;;;                the module loads. Everything that is more clearly said in
;;;                Prolog belongs here, and most of a library usually does.
;;;
;;; WHY IT IS A SEAM AND NOT A LIST. solve.cicili holds two null function
;;; pointers and consults them; this file fills them in. A cocolog built
;;; without a single module is the cocolog that existed before this file, byte
;;; for byte, because the hooks stay null and the engine's dispatch is one
;;; extra null check. That is the same arrangement kb.cicili uses for the
;;; knowledge base, and for the same reason: the engine should not know how
;;; many modules there are, or that there is such a thing as a module.
;;;
;;; WHERE A MODULE'S PREDICATES SIT IN THE ORDER. A goal is tried as
;;;
;;;   1. a control construct  (`,', `;', `->', `\+', `call', `!')
;;;   2. a core builtin       (*builtins* in solve.cicili)
;;;   3. a MODULE predicate   (here)
;;;   4. the knowledge base
;;;
;;; so a module can add to the language but cannot quietly redefine `=' or
;;; `is' underneath a program that was written before it was installed. It CAN
;;; be shadowed by a clause in the knowledge base -- no: it cannot, because 4
;;; comes after 3. A program that wants to override a module predicate has to
;;; not load the module.
;;;
;;; THE RULES A MODULE PREDICATE MUST OBEY, and they are not style:
;;;
;;;   IT IS DETERMINISTIC. It answers 1 (once), 0, -1, or 2, and never makes a
;;;   choice point -- it has no access to the choice stack, deliberately, so
;;;   that no module can break the invariant the engine's suspension depends
;;;   on. A predicate that wants to answer several times returns a LIST and
;;;   lets a clause in the Coco half take the list apart, which is also what
;;;   makes it work after a machine has been frozen and thawed elsewhere.
;;;
;;;   IT LEAVES NOTHING BEHIND WHEN IT FAILS. Bindings made on the way to
;;;   discovering that the answer is 0 must be undone: take `coco_m_mark' first
;;;   and `coco_m_undo' back to it. The engine only winds the trail back at a
;;;   choice point, and a builtin that fails is not one.
;;;
;;;   IT DOES NOT KEEP A TERM INDEX ACROSS A CALL. The heap moves. Indices are
;;;   good for the length of one call and no longer, which is also why a module
;;;   has no per-session state of its own: state that a frozen machine cannot
;;;   carry with it is state that comes back wrong somewhere else.
;;;
;;; WHAT A MODULE CANNOT DO, and these are the honest limits: define an
;;; operator (the reader's table is fixed at build time), leave a choice point,
;;; or see the choice stack. The first is a real gap; the other two are the
;;; price of being suspendable.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;;; ------------------------------------------------------------------
;;;; The macro a module author writes
;;;; ------------------------------------------------------------------

;;; Emits the dispatcher for one module's C predicates, grouped by arity, so a
;;; goal of arity 3 is never compared against a predicate of arity 1. This is
;;; `coco-emit-builtin-dispatch' in solve.cicili, one module along: same shape,
;;; same reason. FOUND says whether the name belonged to this module at all,
;;; which is what lets the engine fall through to the knowledge base.
(DEFMACRO coco-emit-module-dispatch (fname table)
  (LET* ((rows (SYMBOL-VALUE table))
         (arities (SORT (REMOVE-DUPLICATES (MAPCAR #'SECOND rows)) #'<)))
    `(func ,fname ((coco_engine * e) (const char * name) (u32 arity)
                   (size_t g) (int * found)) (out int)
       (set (cof found) 1)
       (cond
         ,@(MAPCAR
            (LAMBDA (n)
              `((== arity ,n)
                (cond
                  ,@(MAPCAR (LAMBDA (row) `((== 0 (strcmp name ,(FIRST row)))
                                            (return (,(THIRD row) e g))))
                            (REMOVE-IF-NOT (LAMBDA (r) (= (SECOND r) n)) rows))
                  (#t (set (cof found) 0) (return 0)))))
            arities)
         (#t (set (cof found) 0) (return 0))))))

;;; The whole of a module, from one form: the registration function a target
;;; calls. Positional and not keyword arguments, because a macro does not
;;; evaluate what it is given -- a `:prolog *files-prolog*' would splice the
;;; SYMBOL and Cicili would go looking for a C name of that spelling. Here the
;;; two data arguments are resolved with SYMBOL-VALUE at expansion time, so a
;;; DEFPARAMETER holding the text is what you pass and its contents is what is
;;; emitted.
;;;
;;;   (coco-defmodule coco_files_module "files" coco_f_dispatch *files-prolog*)
;;;
;;; DISPATCH may be `nil' for a module that is only clauses, PROLOG omitted for
;;; one that is only C, and INIT omitted in the usual case of no set-up.
;;;
;;; THE LAMBDA-LIST MARKERS ARE UPPERCASE -- `&OPTIONAL', not `&optional'.
;;; Cicili's reader preserves case, so a lowercase one is the symbol `|&rest|'
;;; and not `COMMON-LISP:&REST', and the macro is then called with the wrong
;;; arity in a way whose error message names neither.
(DEFMACRO coco-defmodule (fname name dispatch &OPTIONAL prolog init)
  (FLET ((datum (x) (COND ((NULL x) 'nil)
                          ((AND (SYMBOLP x) (BOUNDP x)) (SYMBOL-VALUE x))
                          (T x))))
    `(func ,fname () (out int)
       (return (coco_module_register ,name
                                   ,(OR dispatch 'nil)
                                   ,(datum prolog)
                                   ,(OR init 'nil))))))


;;; Binds a module predicate's arguments, dereferenced, by position:
;;;
;;;   (coco-mod-args e g ((path 0) (mode 1))
;;;     ...path and mode are size_t term indices...)
;;;
;;; It is sugar for a `let' of `coco_m_arg' calls and saves nothing but the
;;; repetition -- which is the repetition every single predicate in a module
;;; starts with, so it is worth a macro.
(DEFMACRO coco-mod-args (e g bindings &REST body)
  `(let ,(MAPCAR (LAMBDA (b) `(size_t ,(FIRST b) . #'(coco_m_arg ,e ,g ,(SECOND b))))
                 bindings)
     ,@body))


(generic decl-module
  ()

  ;;; What a module is, from the engine's side. Both function pointers may be
  ;;; null: a module that is only clauses has no `dispatch', and most have no
  ;;; `init'.
  (struct coco_module
    (member const char * name)
    ;; the C half. Answers 1/0/-1 like any builtin, and sets FOUND to 0 if the
    ;; name and arity were not this module's.
    (member func dispatch ((coco_engine * e) (const char * name) (u32 arity)
                           (size_t g) (int * found)) (out int))
    ;; the Coco half: clauses as text, consulted once per session
    (member const char * prolog)
    ;; run once per session, before the Coco half is consulted
    (member func init ((coco_engine * e)) (out int)))

  ;;; Empties the registry and fills in solve.cicili's two hooks. A target that
  ;;; wants modules calls this once and then registers each one.
  (decl) (func coco_module_init ())

  ;;; Adds one, by its pieces rather than by a descriptor the caller has to
  ;;; find storage for. DISPATCH may be null for a module that is only clauses,
  ;;; PROLOG null for one that is only C, INIT null for the usual case -- but
  ;;; not both of the first two, which would be a module that does nothing.
  ;;;
  ;;; Answers 0 if it is out of memory or the module is empty; a target should
  ;;; treat that as a build error rather than ignore it.
  (decl) (func coco_module_register ((const char * name)
                                   (func dispatch ((coco_engine * e) (const char * nm)
                                                   (u32 arity) (size_t g)
                                                   (int * found)) (out int))
                                   (const char * prolog)
                                   (func init ((coco_engine * e)) (out int))) (out int))

  ;;; Drops the registry. For a test that builds several; a program that
  ;;; registers once at start-up need never call it.
  (decl) (func coco_module_free ())

  (decl) (func coco_module_count () (out size_t))
  (decl) (func coco_module_at ((size_t i)) (out const coco_module *))

  ;;; A registered module by its name, or null. What `use_module' asks first:
  ;;; a library that is already in the registry -- linked into the build or
  ;;; loaded earlier -- needs no file found for it.
  (decl) (func coco_module_find ((const char * name)) (out const coco_module *))

  ;;; The Coco half of every module not yet in this store, consulted in --
  ;;; public because `use_module' as a GOAL registers a module mid-query and
  ;;; cannot wait for the next query's start to consult its clauses. E may be
  ;;; null when no engine exists yet (a directive during a bare consult); a
  ;;; module whose `init' needs the engine is then deferred to the ask-time
  ;;; call, which runs this again.
  (decl) (func coco_module_load ((coco_store * st) (coco_machine * m)
                                 (coco_engine * e)) (out int))

  ;;; ---- the API a module's C half is written against ----------------------

  ;;; Argument I of the goal, dereferenced. Good for the length of this call.
  (decl) (func coco_m_arg ((coco_engine * e) (size_t g) (u32 i)) (out size_t))
  (decl) (func coco_m_machine ((coco_engine * e)) (out coco_machine *))

  ;;; The trail, for a predicate that has to leave nothing behind when it
  ;;; fails. Take the mark before the first unification, undo to it on the way
  ;;; out with 0.
  (decl) (func coco_m_mark ((coco_engine * e)) (out size_t))
  (decl) (func coco_m_undo ((coco_engine * e) (size_t mark)))

  ;;; ---- reading arguments ----

  (decl) (func coco_m_is_var ((coco_engine * e) (size_t t)) (out int))
  (decl) (func coco_m_is_atom ((coco_engine * e) (size_t t)) (out int))

  ;;; An atom's name, or null if T is not an atom. The pointer is into the
  ;;; machine's atom table and stays valid as long as the machine does.
  (decl) (func coco_m_atom ((coco_engine * e) (size_t t)) (out const char *))

  (decl) (func coco_m_int ((coco_engine * e) (size_t t) (i64 * out)) (out int))
  (decl) (func coco_m_float ((coco_engine * e) (size_t t) (double * out)) (out int))

  ;;; T AS TEXT, which is the one a module reaching outside the process needs:
  ;;; an atom, an integer, or a list of character codes all become the obvious
  ;;; string. The code-list case is not politeness -- cocolog reads "abc" as a
  ;;; code list, so without it every double-quoted file name in a program would
  ;;; be a type error.
  ;;;
  ;;; Answers 0 if T is none of those or does not fit in CAP.
  (decl) (func coco_m_text ((coco_engine * e) (size_t t) (char * buf) (size_t cap)) (out int))

  ;;; ---- tensors: the store's vector rows, for the torch module ----
  ;;;
  ;;; Thin passes over the store's tensor hooks (kb.cicili): put one piece,
  ;;; read one piece back, forget a name. Each answers 0 when the
  ;;; arrangement has no tensor storage -- the hook is null -- and the
  ;;; caller falls back to clause chunks, which is the whole contract.

  (decl) (func coco_m_tensor_put ((coco_engine * e) (const char * name)
                                  (i64 seq) (const double * v) (u32 n)) (out int))
  (decl) (func coco_m_tensor_row ((coco_engine * e) (const char * name)
                                  (i64 seq) (double * out) (u32 cap)
                                  (u32 * n)) (out int))
  (decl) (func coco_m_tensor_forget ((coco_engine * e)
                                     (const char * name)) (out int))

  ;;; ---- writing answers ----

  (decl) (func coco_m_unify ((coco_engine * e) (size_t t) (size_t u)) (out int))
  (decl) (func coco_m_unify_atom ((coco_engine * e) (size_t t) (const char * s)) (out int))
  (decl) (func coco_m_unify_string ((coco_engine * e) (size_t t) (const char * s)
                                    (size_t n)) (out int))
  (decl) (func coco_m_unify_int ((coco_engine * e) (size_t t) (i64 v)) (out int))
  (decl) (func coco_m_unify_float ((coco_engine * e) (size_t t) (double v)) (out int))

  ;;; MAKING a term, as against reading or unifying one. The family had
  ;;; `coco_m_nil' and `coco_m_cons' to build a list with and NOTHING to
  ;;; put in it: `coco_m_int' READS an integer out of a term, and
  ;;; `coco_m_unify_int' binds one into a term that already exists. An
  ;;; in-tree module reached past the seam for `coco_new_int'; an
  ;;; out-of-tree one cannot, so library(curl) could not answer a list of
  ;;; BYTES at all -- which is every response body that is not text.
  (decl) (func coco_m_new_int ((coco_engine * e) (i64 v)) (out size_t))

  ;;; ---- a term that has to leave this machine ---------------------------
  ;;;
  ;;; T AS TEXT, ON THE HEAP, and its inverse. Everything else in this API
  ;;; hands a module an index into ONE machine's heap; these two are for a
  ;;; module that has to move a term somewhere that index means nothing --
  ;;; another THREAD, a socket, a file, a queue.
  ;;;
  ;;; THE FORM IS THE CANONICAL ONE, which is the same form the database
  ;;; stores clauses in: quoted, so an atom that needs quotes reads back,
  ;;; and operators IGNORED, so `rule(a ===> b)' writes as
  ;;; `rule(===>(a,b))' and does not depend on the reader having the same
  ;;; operator table. That last part is the whole reason this is not just
  ;;; `coco_write_term': a thread that had not run the same `op/3'
  ;;; directives would otherwise read a different term than was sent.
  ;;;
  ;;; A COPY IS THE POINT, not a cost to apologise for. Two machines cannot
  ;;; share a heap cell, so a term crossing between them is copied whatever
  ;;; the mechanism; text is the copy this interpreter already trusts,
  ;;; because it is what freeze/thaw and every backend already use.
  ;;;
  ;;; The caller FREES what `coco_m_term_text' answers. Null when the term
  ;;; will not write; 0 from `coco_m_read_term' when the text will not read.
  (decl) (func coco_m_term_text ((coco_engine * e) (size_t t)) (out char *))
  (decl) (func coco_m_read_term ((coco_engine * e) (const char * src)) (out size_t))

  ;;; ---- a goal on a machine of its own ---------------------------------
  ;;;
  ;;; SRC -- a goal in canonical text -- proved on a FRESH machine, store
  ;;; and engine, and then all three thrown away. Answers 1 (succeeded), 0
  ;;; (failed) or -1 (raised, with ERR filled in).
  ;;;
  ;;; IT IS HERE BECAUSE A MODULE CANNOT WRITE IT. `coco_engine' is an
  ;;; opaque struct to anything built against lib/sdk.cicili -- deliberately
  ;;; -- so a module cannot declare one, let alone stack-allocate the three
  ;;; a proof needs. The engine's lifetime belongs to the interpreter; what
  ;;; belongs to library(thread) is pthreads and queues, and this is the
  ;;; line between them.
  ;;;
  ;;; SHARE-NOTHING, WHICH IS THE `swarm' COMMAND'S SHAPE ALREADY. Every
  ;;; swarm worker gets its own machine and its own connection and they
  ;;; meet only in the database; a thread started here gets the first half
  ;;; of that. It sees every REGISTERED module -- the linked-in ones and
  ;;; anything `use_module' loaded before it started -- because the module
  ;;; registry is process-wide and a fresh store consults all of it on the
  ;;; first goal. It does NOT see the parent's asserted clauses, and it has
  ;;; NO database connection: `db' is thread-local and null on a new
  ;;; thread, so the store's hooks are unset and this is a `--local' proof
  ;;; whatever the parent was.
  ;;;
  ;;; SO REGISTER YOUR MODULES BEFORE YOU SPAWN. `coco_module_register'
  ;;; writes the process-wide registry; a `use_module' racing a thread that
  ;;; is reading it is the one unguarded thing here, and it is unguarded
  ;;; because loading libraries at start-up is what every program does.
  (decl) (func coco_m_run_isolated ((const char * src) (char * err)
                                  (size_t errlen)) (out int))

  ;;; ---- and the knowledge base it runs against -------------------------
  ;;;
  ;;; THE HOOK THAT GIVES A THREAD A DATABASE. `coco_m_run_isolated' makes
  ;;; a machine, a store and an engine, and until this pair existed the
  ;;; store had no hooks: a thread was a `--local' proof whatever the
  ;;; parent was, so a page served from a worker could not read a clause
  ;;; anybody else had written.
  ;;;
  ;;; IT IS A HOOK BECAUSE THE ANSWER LIVES UPSTAIRS. Which arrangement
  ;;; this process is in -- local, a socket, Zeytun, an embedded store --
  ;;; is `opts' in the composition root, and so is the code that opens a
  ;;; connection and attaches the store's five hooks to it. This layer
  ;;; cannot know any of that and should not; it can call back into
  ;;; whoever does, which is exactly what `coco_extern_install' already
  ;;; does for a module's clauses.
  ;;;
  ;;; ONE CONNECTION PER THREAD, which is the `swarm' command's rule and
  ;;; the only one that works: `db' is thread-local, a Zigurat connection
  ;;; is not shareable, and two threads through one socket is the wedge
  ;;; STATUS.md spent a day on. OPEN answers 0 to mean "no database in
  ;;; this arrangement", which is not a failure -- `--local' says it every
  ;;; time -- and fills CTX with whatever CLOSE will need.
  ;;;
  ;;; CLOSE IS TOLD WHETHER THE PROOF WORKED, because a connection that
  ;;; wrote and then failed must roll back rather than commit: half of a
  ;;; failed goal's assertions is not a state anybody asked for.
  (decl) (func coco_m_kb_install
               ((func open ((coco_machine * m) (coco_store * st)
                            (void ** ctx)) (out int))
                (func close ((void * ctx) (int ok)))))
  (decl) (func coco_m_new_float ((coco_engine * e) (double v)) (out size_t))
  (decl) (func coco_m_new_atom ((coco_engine * e) (const char * s)) (out size_t))

  (decl) (func coco_m_nil ((coco_engine * e)) (out size_t))
  (decl) (func coco_m_cons ((coco_engine * e) (size_t h) (size_t t)) (out size_t))

  ;;; A list of atoms, built from the END so that the result comes out in the
  ;;; order the array is in.
  (decl) (func coco_m_atom_list ((coco_engine * e) (char ** v) (size_t n)) (out size_t))

  ;;; A list of TERMS the caller is already holding, same order, same reason.
  (decl) (func coco_m_list ((coco_engine * e) (const size_t * items) (size_t n))
               (out size_t))

  ;;; How long a list is, or 0 if T is not a proper one -- a partial list
  ;;; ending in a variable and an improper one ending in anything else are both
  ;;; refused, because a module predicate that walked either would answer about
  ;;; a list that is not there yet.
  (decl) (func coco_m_list_length ((coco_engine * e) (size_t t) (size_t * out)) (out int))

  ;;; A proper list as an ARRAY of term indices, which is what a C half wants
  ;;; when it has to see the whole list at once -- sorting, mostly. The array
  ;;; is malloc'd and the caller frees it; the indices in it are the list's own
  ;;; elements and are good for the length of the call, like every other index.
  ;;;
  ;;; Answers 0 for anything that is not a proper list, and for an empty one
  ;;; answers 1 with a null array and a count of 0.
  (decl) (func coco_m_list_array ((coco_engine * e) (size_t t) (size_t ** out)
                                (size_t * n)) (out int))

  ;;; ---- giving up --------------------------------------------------------
  ;;;
  ;;; ALL FIVE THROW, and they throw the term SWI throws: `error(Formal, _)',
  ;;; with Formal one of `type_error(Type, Culprit)', `instantiation_error',
  ;;; `domain_error(Domain, Culprit)' or `existence_error(Kind, What)'. A
  ;;; program can therefore write the portable
  ;;;
  ;;;   catch(Goal, error(type_error(T, V), _), Recovery)
  ;;;
  ;;; and have it mean the same thing here as there. They used to fill in the
  ;;; engine's `err' and stop the query, which is why cocolog FAILED wherever
  ;;; SWI threw and why the shared tests had to stay off those paths.
  ;;;
  ;;; THE SECOND ARGUMENT OF `error' IS LEFT UNBOUND. SWI puts a
  ;;; `context(Module:Name/Arity, Message)' there, and no two systems agree on
  ;;; its contents -- matching on `error(Formal, _)' is what portable code
  ;;; does and is all that can be compared.
  ;;;
  ;;; EACH ANSWERS WHAT ITS CALLER SHOULD RETURN: 2 when a `catch/3' took the
  ;;; ball -- the engine is then already pointed at the recovery goal and 2 is
  ;;; how a builtin says "leave my continuation alone" -- and -1 when nothing
  ;;; caught it, `err' saying so. A predicate still writes
  ;;; `(return (coco_m_type_error e "list" t))' and does not care which happened.
  (decl) (func coco_m_type_error ((coco_engine * e) (const char * type)
                                (size_t culprit)) (out int))
  (decl) (func coco_m_instantiation_error ((coco_engine * e)) (out int))
  (decl) (func coco_m_domain_error ((coco_engine * e) (const char * domain)
                                  (size_t culprit)) (out int))
  (decl) (func coco_m_existence_error ((coco_engine * e) (const char * kind)
                                     (size_t what)) (out int))

  ;;; For what SWI has no error for and cocolog does: a condition of this
  ;;; implementation's own. It throws `error(cocolog_error(Atom), _)', so it is
  ;;; catchable like the rest and cannot be mistaken for a standard one.
  (decl) (func coco_m_error ((coco_engine * e) (const char * what)
                           (const char * detail)) (out int))

  ) ; decl-module


(generic impl-module
  ()

  ;; The registry. Grown by doubling like every other array in cocolog rather
  ;; than fixed at some number nobody can justify, and holding the descriptors
  ;; BY VALUE so that a module does not have to find somewhere to keep its own.
  (static) (var coco_module * coco_modules)
  (static) (var size_t coco_nmodules)
  (static) (var size_t coco_modcap)

  ;;; ---- the two hooks solve.cicili left --------------------------------

  ;;; Every registered module in turn, until one claims the name. First
  ;;; registered wins a collision, which makes the order in the target the
  ;;; order of precedence and is the only sensible rule when two modules
  ;;; disagree.
  (static)
  (func coco_module_call ((coco_engine * e) (const char * name) (u32 arity)
                        (size_t g) (int * found)) (out int)
        (set (cof found) 0)
        (for ((size_t i . 0)) (< i coco_nmodules) ((++ i))
          (let ((coco_module * mod . #'(aof (nth i coco_modules))))
            (if (!= (-> mod dispatch) nil)
                (let ((int mine . 0)
                      (int rc . #'((-> mod dispatch) e name arity g (aof mine))))
                  (if mine (block (set (cof found) 1) (return rc)))))))
        (return 0))

  ;;; The Coco half of every module NOT YET IN THIS STORE, consulted in.
  ;;; Called by the engine when a query starts, and guarded by a count on the
  ;;; STORE rather than a flag here: a store that has been reset -- which is
  ;;; what thawing a machine does -- has lost the clauses and has to be given
  ;;; them again, and the count going back to zero is exactly that fact. The
  ;;; walk starts AT the store's count rather than at zero, because a module
  ;;; can now register mid-session (`use_module') and the ones before it are
  ;;; already consulted -- loading them again would double every answer.
  ;;;
  ;;; THE HOOKS ARE MUTED WHILE IT RUNS. A module's clauses belong to the
  ;;; build, not to the knowledge base: written through, they would be saved
  ;;; into the shared database, come back on every fetch, and be listed as the
  ;;; user's own -- and a second interpreter would then have two copies.
  (func coco_module_load ((coco_store * st) (coco_machine * m) (coco_engine * e)) (out int)
        (if (== coco_nmodules 0) (return 1))
        (if (>= (-> st libs) coco_nmodules) (return 1))
        (let ((char err [256]) (int ok . 1))
          (coco_store_mute st)
          (for ((size_t i . #'(-> st libs))) (< i coco_nmodules) ((++ i))
            (let ((coco_module * mod . #'(aof (nth i coco_modules))))
              (if (and ok (!= (-> mod init) nil))
                  (block
                   ;; an init that needs the engine waits for one: leave the
                   ;; store's count where it is so the ask-time call retries
                   (if (== e nil) (block (set ok 2) break))
                   (if (not ((-> mod init) e)) (set ok 0))))
              (if (and (== ok 1) (!= (-> mod prolog) nil))
                  (if (< (coco_consult st m (-> mod prolog) err (sizeof err)) 0)
                      (set ok 0)))
              (if (== ok 1) (set (-> st libs) (+ i 1)))))
          (coco_store_unmute st)
          (return (? (== ok 0) 0 1))))

  ;;; ---- the registry ---------------------------------------------------

  (func coco_module_init ()
        (set coco_nmodules 0)
        (coco_extern_install coco_module_call coco_module_load))

  (func coco_module_free ()
        (free coco_modules)
        (set coco_modules nil)
        (set coco_nmodules 0)
        (set coco_modcap 0))

  (func coco_module_register ((const char * name)
                            (func dispatch ((coco_engine * e) (const char * nm)
                                            (u32 arity) (size_t g) (int * found))
                                  (out int))
                            (const char * prolog)
                            (func init ((coco_engine * e)) (out int))) (out int)
        (if (== name nil) (return 0))
        (if (and (== dispatch nil) (== prolog nil)) (return 0))
        (if (>= coco_nmodules coco_modcap)
            (let ((size_t ncap . #'(? (== coco_modcap 0) 8 (* coco_modcap 2)))
                  (coco_module * nb))
              (set nb (cast (coco_module *)
                            (realloc coco_modules (* ncap (sizeof coco_module)))))
              (if (== nb nil) (return 0))
              (set coco_modules nb)
              (set coco_modcap ncap)))
        (let ((coco_module * slot . #'(aof (nth coco_nmodules coco_modules))))
          (memset slot 0 (sizeof coco_module))
          (set (-> slot name) name)
          (set (-> slot dispatch) dispatch)
          (set (-> slot prolog) prolog)
          (set (-> slot init) init))
        (set coco_nmodules (+ coco_nmodules 1))
        (return 1))

  (func coco_module_count () (out size_t) (return coco_nmodules))

  (func coco_module_at ((size_t i)) (out const coco_module *)
        (if (>= i coco_nmodules) (return nil))
        (return (aof (nth i coco_modules))))

  (func coco_module_find ((const char * name)) (out const coco_module *)
        (if (== name nil) (return nil))
        (for ((size_t i . 0)) (< i coco_nmodules) ((++ i))
          (if (== 0 (strcmp name ($ (nth i coco_modules) name)))
              (return (aof (nth i coco_modules)))))
        (return nil))

  ;;; ---- the author's API -----------------------------------------------

  (func coco_m_arg ((coco_engine * e) (size_t g) (u32 i)) (out size_t)
        (return (coco_deref (-> e m) (coco_arg (-> e m) g i))))

  (func coco_m_machine ((coco_engine * e)) (out coco_machine *) (return (-> e m)))

  (func coco_m_tensor_put ((coco_engine * e) (const char * name) (i64 seq)
                         (const double * v) (u32 n)) (out int)
        (let ((coco_store * st . #'(-> e st)))
          (if (== (-> st tensor_put) nil) (return 0))
          (return ((-> st tensor_put) st (-> st ctx) name seq v n))))

  (func coco_m_tensor_row ((coco_engine * e) (const char * name) (i64 seq)
                         (double * out) (u32 cap) (u32 * n)) (out int)
        (let ((coco_store * st . #'(-> e st)))
          (if (== (-> st tensor_row) nil) (return 0))
          (return ((-> st tensor_row) st (-> st ctx) name seq out cap n))))

  (func coco_m_tensor_forget ((coco_engine * e) (const char * name)) (out int)
        (let ((coco_store * st . #'(-> e st)))
          (if (== (-> st tensor_forget) nil) (return 0))
          (return ((-> st tensor_forget) st (-> st ctx) name))))

  (func coco_m_mark ((coco_engine * e)) (out size_t) (return ($ (cof (-> e m)) trail_len)))
  (func coco_m_undo ((coco_engine * e) (size_t mark)) (coco_undo_to (-> e m) mark))

  ;;; ALL FOUR OF THESE DEREFERENCE FIRST, and it is not defensiveness. A term
  ;;; index reaches a module from two places: `coco_m_arg', which dereferences,
  ;;; and the elements of a list from `coco_m_list_array', which are argument
  ;;; SLOTS and so are very often a REF pointing at the value. A module author
  ;;; cannot be expected to know which of the two they are holding, and the one
  ;;; that does not dereference reads a REF as "not a number" and sends the
  ;;; caller down its type-error path for a perfectly good integer.
  (func coco_m_is_var ((coco_engine * e) (size_t t)) (out int)
        (set t (coco_deref (-> e m) t))
        (return (? (coco-tag-is REF (nth t ($ (cof (-> e m)) heap))) 1 0)))

  (func coco_m_is_atom ((coco_engine * e) (size_t t)) (out int)
        (set t (coco_deref (-> e m) t))
        (return (? (coco-tag-is ATOM (nth t ($ (cof (-> e m)) heap))) 1 0)))

  (func coco_m_atom ((coco_engine * e) (size_t t)) (out const char *)
        (set t (coco_deref (-> e m) t))
        (if (not (coco_m_is_atom e t)) (return nil))
        (return (coco_atom_name (-> e m) (coco_name_of (-> e m) t))))

  (func coco_m_int ((coco_engine * e) (size_t t) (i64 * out)) (out int)
        (set t (coco_deref (-> e m) t))
        (if (not (coco-tag-is INT (nth t ($ (cof (-> e m)) heap)))) (return 0))
        (set (cof out) (coco-signed-payload (nth t ($ (cof (-> e m)) heap))))
        (return 1))

  ;;; An integer is a float too, which is what every arithmetic reader in the
  ;;; system already assumes: `size_file(F, 0)' should match a file of length
  ;;; zero whether the program wrote 0 or 0.0.
  (func coco_m_float ((coco_engine * e) (size_t t) (double * out)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (i64 iv . 0))
          (set t (coco_deref m t))
          (if (coco_m_int e t (aof iv))
              (block (set (cof out) (cast double iv)) (return 1)))
          (let ((u64 c . #'(nth t ($ (cof m) heap))))
            (if (not (coco-tag-is FLT c)) (return 0))
            (set (cof out) (nth (cast size_t (coco-payload c)) ($ (cof m) floats)))
            (return 1))))

  ;;; An atom, an integer, or a list of codes. Anything else is 0 and the
  ;;; caller decides whether that is a type error or a reason to fail.
  (func coco_m_text ((coco_engine * e) (size_t t) (char * buf) (size_t cap)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (i64 iv . 0))
          (if (== cap 0) (return 0))
          (set t (coco_deref m t))

          ;; A STRING IS TEXT, and putting it HERE rather than in format/2 is
          ;; the whole point: coco_m_text/4 is the module API's "the text of
          ;; this term", so every caller -- format/1,2,3, atom_length/2,
          ;; atom_number/2, every module that asks for a name -- takes a
          ;; string the moment this does. Under `double_quotes = string' the
          ;; format string of every format/2 in a file IS a string, so a flag
          ;; that could be set and then made format unusable would not be a
          ;; feature.
          ;;
          ;; A STRING WITH A NUL IN IT IS REFUSED HERE, not truncated: this
          ;; hands back a C string and the buffer cannot carry one. That is
          ;; the honest edge of the seam -- string_codes/2 is the way to read
          ;; such a string, and it does not go through here.
          (let ((const char * sp . nil) (size_t sn . 0))
            (if (coco_string_text m t (aof sp) (aof sn))
                (block
                 (if (>= sn cap) (return 0))
                 (for ((size_t i . 0)) (< i sn) ((++ i))
                      (if (== (nth i sp) (cast char 0)) (return 0)))
                 (memcpy buf sp sn)
                 (set (nth sn buf) (cast char 0))
                 (return 1))))

          (if (coco_m_is_atom e t)
              (let ((const char * s . #'(coco_atom_name m (coco_name_of m t))))
                (if (>= (strlen s) cap) (return 0))
                (snprintf buf cap "%s" s)
                (return 1)))

          (if (coco_m_int e t (aof iv))
              (block (snprintf buf cap "%lld" (cast llong iv)) (return 1)))

          ;; a list of character codes -- what "abc" reads as
          (let ((size_t n . 0) (size_t p . t))
            (while 1
              (set p (coco_deref m p))
              ;; AN ATOM ENDS THE WALK OR FAILS IT; ANYTHING ELSE FALLS
              ;; THROUGH to the cons checks below. Written as an if/else --
              ;; `(if atom (if nil break) (return 0))' -- the else took every
              ;; cons cell straight out of the function, so this loop only ever
              ;; ran for the empty list and the code-list case the comment above
              ;; describes was unreachable. `format("abc", [])' found it: a
              ;; double-quoted format string is a code list, and it was rejected
              ;; as not text.
              (if (coco_m_is_atom e p)
                  (block
                   (if (== 0 (strcmp (coco_atom_name m (coco_name_of m p)) "[]")) break)
                   (return 0)))
              (if (not (coco_is_callable m p)) (return 0))
              (if (!= (coco_arity m p) 2) (return 0))
              (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m p)) ".")) (return 0))
              ;; A CODE OR A ONE-CHARACTER ATOM, because `double_quotes' has
              ;; four values and TWO of them make a list. Under `chars' the
              ;; format string of every format/2 in the file is [f,o,o] and
              ;; refusing it here would make the flag unusable -- which is
              ;; how this was found: `set_prolog_flag(double_quotes, chars)'
              ;; then `format("answer(~w)~n", [X])' raised type_error(text)
              ;; naming a list whose elements are plainly characters.
              (let ((size_t h . #'(coco_deref m (coco_arg m p 0))) (i64 c . 0))
                (if (not (coco_m_int e h (aof c)))
                    (block
                     (if (not (coco_m_is_atom e h)) (return 0))
                     (let ((const char * cs . #'(coco_atom_name m (coco_name_of m h))))
                       (if (!= (strlen cs) 1) (return 0))
                       (set c (cast i64 (bitand (cast int (nth 0 cs)) 255))))))
                (if (or (< c 1) (> c 255)) (return 0))
                (if (>= (+ n 1) cap) (return 0))
                (set (nth n buf) (cast char c))
                (set n (+ n 1)))
              (set p (coco_arg m p 1)))
            ;; an empty list is the empty string, not a failure: `atom_codes(X, [])'
            (set (nth n buf) (cast char 0))
            (return 1))))

  (func coco_m_term_text ((coco_engine * e) (size_t t)) (out char *)
        (let ((coco_strbuf b) (char * out . nil))
          (coco_sb_init (aof b))
          (if (not (coco_write_canonical (-> e m) (aof b) t))
              (block (coco_sb_free (aof b)) (return nil)))
          (if (!= ($ b s) nil)
              (block
               (set out (cast (char *) (malloc (+ ($ b len) 1))))
               (if (!= out nil)
                   (block (memcpy out ($ b s) ($ b len))
                          (set (nth ($ b len) out) (cast char 0))))))
          (coco_sb_free (aof b))
          (return out)))

  (func coco_m_read_term ((coco_engine * e) (const char * src)) (out size_t)
        (let ((size_t t . 0))
          (if (== src nil) (return 0))
          (if (not (coco_read_term_from (-> e m) src (aof t))) (return 0))
          (return t)))

  ;;; Filled in by the composition root; null until it is, which is what
  ;;; every out-of-tree embedder and every test binary leaves them.
  (static) (var func coco_m_kb_open ((coco_machine * m) (coco_store * st)
                                     (void ** ctx)) (out int) . nil)
  (static) (var func coco_m_kb_close ((void * ctx) (int ok)) . nil)

  (func coco_m_kb_install
        ((func open ((coco_machine * m) (coco_store * st) (void ** ctx)) (out int))
         (func close ((void * ctx) (int ok))))
        (set coco_m_kb_open open)
        (set coco_m_kb_close close))

  (func coco_m_run_isolated ((const char * src) (char * err) (size_t errlen)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_engine e)
              (size_t g . 0) (int rc . 0) (int out . 0) (void * kb . nil))
          (if (!= err nil) (set (nth 0 err) (cast char 0)))
          (if (== src nil) (return -1))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_engine_init (aof e) (aof m) (aof st))
          ;; THE CONNECTION BEFORE THE GOAL, so the store's hooks are in
          ;; place before the first clause is looked for -- a fetch that
          ;; happened before the attach would cache "no such predicate"
          ;; and the attach would come too late to matter.
          (if (!= coco_m_kb_open nil)
              (coco_m_kb_open (aof m) (aof st) (aof kb)))
          (if (not (coco_read_term_from (aof m) src (aof g)))
              (block
               (if (!= err nil) (snprintf err errlen "the goal would not read"))
               (set out -1))
            (block
             (coco_engine_ask (aof e) g)
             ;; THE FIRST SOLUTION AND NO MORE. A thread is not a query: it
             ;; runs a goal for its effect, and backtracking into it after it
             ;; has succeeded is not a thing anyone can ask for from outside.
             (set rc (coco_engine_next (aof e)))
             (if (== rc 1) (set out 1))
             (if (== rc 0) (set out 0))
             (if (== rc -1)
                 (block (if (!= err nil) (snprintf err errlen "%s" ($ e err)))
                        (set out -1)))))
          ;; COMMIT OR ROLL BACK BEFORE THE STORE GOES, and tell it which:
          ;; `out' is 1 only when the goal actually proved.
          (if (!= coco_m_kb_close nil)
              (coco_m_kb_close kb (? (== out 1) 1 0)))
          (coco_engine_free (aof e))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return out)))

  (func coco_m_unify ((coco_engine * e) (size_t t) (size_t u)) (out int)
        (return (? (coco_unify (-> e m) t u) 1 0)))

  (func coco_m_unify_atom ((coco_engine * e) (size_t t) (const char * s)) (out int)
        (return (coco_m_unify e t (coco_new_atom (-> e m) s))))

  ;;; TAKES A LENGTH, where the atom one does not, and that is the whole
  ;;; difference between the two types: an atom is a NUL-terminated name and
  ;;; a string is N bytes, zeros included.
  (func coco_m_unify_string ((coco_engine * e) (size_t t) (const char * s)
                             (size_t n)) (out int)
        (return (coco_m_unify e t (coco_new_string (-> e m) s n))))

  (func coco_m_unify_int ((coco_engine * e) (size_t t) (i64 v)) (out int)
        (return (coco_m_unify e t (coco_new_int (-> e m) v))))

  (func coco_m_unify_float ((coco_engine * e) (size_t t) (double v)) (out int)
        (return (coco_m_unify e t (coco_new_float (-> e m) v))))

  (func coco_m_new_int ((coco_engine * e) (i64 v)) (out size_t)
        (return (coco_new_int (-> e m) v)))
  (func coco_m_new_float ((coco_engine * e) (double v)) (out size_t)
        (return (coco_new_float (-> e m) v)))
  (func coco_m_new_atom ((coco_engine * e) (const char * s)) (out size_t)
        (return (coco_new_atom (-> e m) s)))

  (func coco_m_nil ((coco_engine * e)) (out size_t) (return (coco_new_atom (-> e m) "[]")))

  (func coco_m_cons ((coco_engine * e) (size_t h) (size_t t)) (out size_t)
        (return (coco_cons (-> e m) h t)))

  (func coco_m_atom_list ((coco_engine * e) (char ** v) (size_t n)) (out size_t)
        (let ((size_t lst . #'(coco_m_nil e)))
          (for ((size_t i . n)) (> i 0) ((-- i))
            (set lst (coco_cons (-> e m) (coco_new_atom (-> e m) (nth (- i 1) v)) lst)))
          (return lst)))

  (func coco_m_list ((coco_engine * e) (const size_t * items) (size_t n)) (out size_t)
        (let ((size_t lst . #'(coco_m_nil e)))
          (for ((size_t i . n)) (> i 0) ((-- i))
            (set lst (coco_cons (-> e m) (nth (- i 1) items) lst)))
          (return lst)))

  ;;; Walks the spine once. `[]' is the atom that ends a list; anything else
  ;;; that is not `.'/2 -- a variable, an atom, a number, another compound --
  ;;; means this is not a proper list and the answer is 0 rather than a guess.
  (func coco_m_list_length ((coco_engine * e) (size_t t) (size_t * out)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (size_t n . 0) (size_t p . t))
          (while 1
            (set p (coco_deref m p))
            (if (coco_m_is_atom e p)
                (if (== 0 (strcmp (coco_atom_name m (coco_name_of m p)) "[]"))
                    (block (set (cof out) n) (return 1))
                  (return 0)))
            (if (not (coco_is_callable m p)) (return 0))
            (if (!= (coco_arity m p) 2) (return 0))
            (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m p)) ".")) (return 0))
            (set n (+ n 1))
            (set p (coco_arg m p 1))))
        (return 0))

  (func coco_m_list_array ((coco_engine * e) (size_t t) (size_t ** out) (size_t * n))
        (out int)
        (let ((coco_machine * m . #'(-> e m)) (size_t len . 0))
          (set (cof out) nil)
          (set (cof n) 0)
          (if (not (coco_m_list_length e t (aof len))) (return 0))
          (if (== len 0) (return 1))
          (let ((size_t * v . #'(cast (size_t *) (malloc (* len (sizeof size_t)))))
                (size_t p . t))
            (if (== v nil) (return 0))
            (for ((size_t i . 0)) (< i len) ((++ i))
              (set p (coco_deref m p))
              ;; dereferenced, so what the caller gets is the VALUE and not the
              ;; argument slot pointing at it
              (set (nth i v) (coco_deref m (coco_arg m p 0)))
              (set p (coco_arg m p 1)))
            (set (cof out) v)
            (set (cof n) len)
            (return 1))))

  ;;; `error(Formal, _)' and then throw it. The context variable is fresh, so
  ;;; the caller's `catch' pattern `error(F, _)' matches whatever it holds.
  (static)
  (func coco_m_raise ((coco_engine * e) (size_t formal)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t ball . #'(coco_make2 m "error" formal (coco_new_var m))))
          ;; 2 and not 1: the engine must be told that the continuation is
          ;; already set, or it puts the caller's back and the recovery goal
          ;; never runs. See the dispatch in solve.cicili.
          (return (? (coco_m_thrown e ball) 2 -1))))

  (func coco_m_type_error ((coco_engine * e) (const char * type) (size_t culprit))
        (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (return (coco_m_raise e (coco_make2 m "type_error"
                                          (coco_new_atom m type) culprit)))))

  (func coco_m_instantiation_error ((coco_engine * e)) (out int)
        (return (coco_m_raise e (coco_new_atom (-> e m) "instantiation_error"))))

  (func coco_m_domain_error ((coco_engine * e) (const char * domain) (size_t culprit))
        (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (return (coco_m_raise e (coco_make2 m "domain_error"
                                          (coco_new_atom m domain) culprit)))))

  (func coco_m_existence_error ((coco_engine * e) (const char * kind) (size_t what))
        (out int)
        (let ((coco_machine * m . #'(-> e m)))
          (return (coco_m_raise e (coco_make2 m "existence_error"
                                          (coco_new_atom m kind) what)))))

  (func coco_m_error ((coco_engine * e) (const char * what) (const char * detail)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (char msg [192]))
          (if (== detail nil)
              (snprintf msg (sizeof msg) "%s" what)
            (snprintf msg (sizeof msg) "%s: %s" what detail))
          (return (coco_m_raise e (coco_make1 m "cocolog_error" (coco_new_atom m msg))))))

  ) ; impl-module

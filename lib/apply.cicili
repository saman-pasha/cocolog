;;;; cocolog -- the Apply library, as a module
;;;
;;; SWI-Prolog's library(apply): all seventeen exported predicates, read off a
;;; running SWI rather than off a memory of one.
;;;
;;; IT HAS NO C HALF AT ALL, and that is the point of it. Every one of these is
;;; a goal applied to the elements of a list -- `call(Goal, X)' and nothing
;;; else -- so every one of them is two or three clauses and belongs in the
;;; Coco half. A module that is only clauses is a module the seam already
;;; supports: `coco-defmodule' takes `nil' for the dispatcher.
;;;
;;; WHAT IT NEEDED FROM THE ENGINE WAS call/N, which the Lists library added
;;; for `max_member/3'. Without it not one predicate here could be written.
;;;
;;; THEY ARE AS NONDETERMINISTIC AS WHAT THEY ARE GIVEN. `maplist(member, Xs,
;;; Yss)' backtracks, because `member/2' does; `maplist(succ, [1,2], L)' does
;;; not, because `succ/2' does not. That falls out of their being clauses and
;;; could not have been had in C.
;;;
;;; AND NO MORE (3.23.0): each is swipl's own clauses, the list FIRST in a
;;; helper and the goal after it, so a call with the list given is keyed on
;;; `[]' or `[_|_]' and has one candidate, and no element leaves a choice
;;; point -- `$, maplist(atom, [a, b])' is deterministic, as swipl's. Through
;;; 3.22.0 they wrote the goal first, which the index cannot tell apart, and
;;; every element left one. A helper is named as swipl names its own in what
;;; goes wrong in its body (*frame-contexts*: apply:maplist_/2). With the
;;; first list unbound and another one given, swipl's index on that other
;;; list leaves none; cocolog's builds such an index from eight clauses up,
;;; and the last element leaves one (COMPAT.md).

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

(DEFPARAMETER *apply-prolog*
  (FORMAT NIL "~{~A ~}"
          (LIST

           ;; ---- maplist/2..5 ---------------------------------------------
           ;; Each arity is written out rather than built on a general one,
           ;; which is what SWI does too: the lists have to be walked in step,
           ;; and a version that took a list of lists would have to build a
           ;; term per element to call with. The lists come first in the
           ;; helper, as swipl's maplist_/2..5 take them, so the first one
           ;; keys the call (3.23.0).
           "maplist(G, L) :- '$maplist_'(L, G)."
           "'$maplist_'([], _)."
           "'$maplist_'([X|Xs], G) :- call(G, X), '$maplist_'(Xs, G)."
           "maplist(G, L1, L2) :- '$maplist_'(L1, L2, G)."
           "'$maplist_'([], [], _)."
           "'$maplist_'([X|Xs], [Y|Ys], G) :- call(G, X, Y), '$maplist_'(Xs, Ys, G)."
           "maplist(G, L1, L2, L3) :- '$maplist_'(L1, L2, L3, G)."
           "'$maplist_'([], [], [], _)."
           "'$maplist_'([X|Xs], [Y|Ys], [Z|Zs], G) :- call(G, X, Y, Z), '$maplist_'(Xs, Ys, Zs, G)."
           "maplist(G, L1, L2, L3, L4) :- '$maplist_'(L1, L2, L3, L4, G)."
           "'$maplist_'([], [], [], [], _)."
           "'$maplist_'([X|Xs], [Y|Ys], [Z|Zs], [W|Ws], G) :- call(G, X, Y, Z, W), '$maplist_'(Xs, Ys, Zs, Ws, G)."

           ;; ---- foldl/4..7 -----------------------------------------------
           ;; The accumulator travels as the last two arguments, so the goal is
           ;; called as call(G, Element, In, Out).
           "foldl(G, L, A0, A) :- '$foldl'(L, G, A0, A)."
           "'$foldl'([], _, A, A)."
           "'$foldl'([X|Xs], G, A0, A) :- call(G, X, A0, A1), '$foldl'(Xs, G, A1, A)."
           "foldl(G, L1, L2, A0, A) :- '$foldl2'(L1, L2, G, A0, A)."
           "'$foldl2'([], [], _, A, A)."
           "'$foldl2'([X|Xs], [Y|Ys], G, A0, A) :- call(G, X, Y, A0, A1), '$foldl2'(Xs, Ys, G, A1, A)."
           "foldl(G, L1, L2, L3, A0, A) :- '$foldl3'(L1, L2, L3, G, A0, A)."
           "'$foldl3'([], [], [], _, A, A)."
           "'$foldl3'([X|Xs], [Y|Ys], [Z|Zs], G, A0, A) :- call(G, X, Y, Z, A0, A1), '$foldl3'(Xs, Ys, Zs, G, A1, A)."
           "foldl(G, L1, L2, L3, L4, A0, A) :- '$foldl4'(L1, L2, L3, L4, G, A0, A)."
           "'$foldl4'([], [], [], [], _, A, A)."
           "'$foldl4'([X|Xs], [Y|Ys], [Z|Zs], [W|Ws], G, A0, A) :- call(G, X, Y, Z, W, A0, A1), '$foldl4'(Xs, Ys, Zs, Ws, G, A1, A)."

           ;; ---- scanl/4..7 -----------------------------------------------
           ;; Like foldl, but it answers every intermediate accumulator and not
           ;; only the last -- so the result is ONE LONGER than the input, the
           ;; first element being the initial value.
           "scanl(G, L, A0, [A0|As]) :- '$scanl'(L, G, A0, As)."
           "'$scanl'([], _, _, [])."
           "'$scanl'([X|Xs], G, A0, [A1|As]) :- call(G, X, A0, A1), '$scanl'(Xs, G, A1, As)."
           "scanl(G, L1, L2, A0, [A0|As]) :- '$scanl2'(L1, L2, G, A0, As)."
           "'$scanl2'([], [], _, _, [])."
           "'$scanl2'([X|Xs], [Y|Ys], G, A0, [A1|As]) :- call(G, X, Y, A0, A1), '$scanl2'(Xs, Ys, G, A1, As)."
           "scanl(G, L1, L2, L3, A0, [A0|As]) :- '$scanl3'(L1, L2, L3, G, A0, As)."
           "'$scanl3'([], [], [], _, _, [])."
           "'$scanl3'([X|Xs], [Y|Ys], [Z|Zs], G, A0, [A1|As]) :- call(G, X, Y, Z, A0, A1), '$scanl3'(Xs, Ys, Zs, G, A1, As)."
           "scanl(G, L1, L2, L3, L4, A0, [A0|As]) :- '$scanl4'(L1, L2, L3, L4, G, A0, As)."
           "'$scanl4'([], [], [], [], _, _, [])."
           "'$scanl4'([X|Xs], [Y|Ys], [Z|Zs], [W|Ws], G, A0, [A1|As]) :- call(G, X, Y, Z, W, A0, A1), '$scanl4'(Xs, Ys, Zs, Ws, G, A1, As)."

           ;; ---- filtering ------------------------------------------------
           ;; The if-then-else in each clause is what makes these SEMIDET in
           ;; the goal: `include' asks whether the goal succeeds, not how many
           ;; ways. The list first in the helper, as swipl's include_/3,
           ;; exclude_/3 and partition_/4 (3.23.0).
           "include(G, L, R) :- '$include_'(L, G, R)."
           "'$include_'([], _, [])."
           "'$include_'([X|Xs], G, R) :- ( call(G, X) -> R = [X|R1] ; R = R1 ), '$include_'(Xs, G, R1)."
           "exclude(G, L, R) :- '$exclude_'(L, G, R)."
           "'$exclude_'([], _, [])."
           "'$exclude_'([X|Xs], G, R) :- ( call(G, X) -> R = R1 ; R = [X|R1] ), '$exclude_'(Xs, G, R1)."
           "partition(G, L, I, E) :- '$partition_'(L, G, I, E)."
           "'$partition_'([], _, [], [])."
           "'$partition_'([X|Xs], G, I, E) :- ( call(G, X) -> I = [X|I1], '$partition_'(Xs, G, I1, E) ; E = [X|E1], '$partition_'(Xs, G, I, E1) )."

           ;; partition/5 sorts into three by a comparison, and the goal is
           ;; called as call(G, X, Order) answering <, = or >: swipl's
           ;; partition_/5 and partition_/7, the order the second's key. An
           ;; unbound order is taken as `<', once (the cut); any other is
           ;; must_be/2's type_error(oneof([<,=,>]), O), where through 3.22.0
           ;; the first failed and the second answered three times.
           "partition(G, L, Ls, Es, Gs) :- '$partition_'(L, G, Ls, Es, Gs)."
           "'$partition_'([], _, [], [], [])."
           "'$partition_'([X|Xs], G, L, E, R) :- call(G, X, O), '$partition_'(O, X, G, Xs, L, E, R)."
           "'$partition_'(<, X, G, Xs, L, E, R) :- !, L = [X|L1], '$partition_'(Xs, G, L1, E, R)."
           "'$partition_'(=, X, G, Xs, L, E, R) :- !, E = [X|E1], '$partition_'(Xs, G, L, E1, R)."
           "'$partition_'(>, X, G, Xs, L, E, R) :- !, R = [X|R1], '$partition_'(Xs, G, L, E, R1)."
           "'$partition_'(O, _, _, _, _, _, _) :- must_be(oneof([<,=,>]), O)."

           ;; convlist/3 is maplist and include at once: the goal may fail, and
           ;; an element it fails on is dropped rather than failing the whole.
           ;; swipl's convlist_/3, the input list first.
           "convlist(G, L, R) :- '$convlist_'(L, R, G)."
           "'$convlist_'([], [], _)."
           "'$convlist_'([X|Xs], R, G) :- ( call(G, X, Y) -> R = [Y|R1], '$convlist_'(Xs, R1, G) ; '$convlist_'(Xs, R, G) )."

           ;; ---- apply/2, the old spelling of call/N -----------------------
           ;; DEPRECATED IN SWI AND PRESENT THERE, which is the whole reason
           ;; it is here: a program that COMPUTES its argument list cannot
           ;; write `call(G, A, B)' -- it does not know how many there are --
           ;; and `apply' is the name every Prolog book gives to that. Univ,
           ;; append, univ, call: the deprecation is about style, not about
           ;; the thing not working. swipl's own clauses (boot/apply.pl), the
           ;; module its meta-argument is qualified with taken off by
           ;; strip_module/3 (3.23.0): what is no goal is
           ;; type_error(callable, G), and an unbound one instantiation_error,
           ;; where through 3.22.0 univ raised type_error(atom, G) and its
           ;; own; a qualified goal is called in its module, where univ made
           ;; it `:'/3; and an unknown procedure is '$apply':apply/2's.
           "apply(G0, Extra) :- strip_module(G0, M, G1), ( atom(G1) -> compound_name_arguments(G, G1, Extra) ; compound(G1) -> compound_name_arguments(G1, N, A0), append(A0, Extra, A), compound_name_arguments(G, N, A) ; must_be(callable, G1) ), call(M:G).")))

(generic decl-apply
  ()

  (decl) (func coco_apply_module () (out int))

  ) ; decl-apply


(generic impl-apply
  ()

  ;;; No dispatcher: there is no C half. `coco-defmodule' takes `nil' for it, and
  ;;; the seam has carried a clauses-only module since test/module.cicili
  ;;; proved it.
  (coco-defmodule coco_apply_module "apply" nil *apply-prolog*)

  ) ; impl-apply

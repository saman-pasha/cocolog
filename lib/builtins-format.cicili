;;;; cocolog -- format/1,2,3, with_output_to/2 and character classification
;;;
;;; A PIECE OF THE BUILTINS MODULE, split out of lib/builtins.cicili for size
;;; (2.16.1, where that file had reached 4 053 lines). The three pieces are ONE
;;; translation unit, emitted in this order by cocolog.cicili: builtins,
;;; builtins-format, builtins-db. So a function here calls only what an
;;; earlier piece defined or `decl-builtins' declared, exactly as when they
;;; were one file. lib/builtins.cicili keeps the module's table of rows and its
;;; Prolog half; lib/builtins-db.cicili ends with the dispatcher the table is
;;; emitted into, which is why it comes last.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;; WRITE_TERM/2'S OPTIONS, swipl 9.0.4's pl-write.c table (3.55.0): a name
;;; and the kind it is checked as, 1 a boolean, 2 an integer, 3 an atom, 4
;;; spacing, 5 variable_names, 6 any term. An option's row is found once,
;;; by `coco_wt_opt' -- a cond on the name's first byte, then a strcmp a row
;;; of that byte's -- which the check and the write each ask an option, and
;;; `(coco-wt-opt "quoted")' is a row's number, as `(cc-op ...)' is an
;;; opcode's. Through 3.54.0 the write compared an option with every name
;;; it applies, 13 strcmp an option, which 3.55.0's four names would have
;;; made 17. The commonest rows stand first in their byte's group.
(DEFPARAMETER *wt-options*
  '(("quoted" 1) ("ignore_ops" 6) ("numbervars" 1) ("portray" 1) ("portray_goal" 6)
    ("portrayed" 1) ("max_depth" 2) ("priority" 2) ("spacing" 4) ("variable_names" 5)
    ("fullstop" 1) ("nl" 1) ("dotlists" 1) ("no_lists" 1) ("character_escapes" 1)
    ("character_escapes_unicode" 1) ("quote_non_ascii" 1) ("brace_terms" 1) ("cycles" 1)
    ("partial" 1) ("module" 3) ("back_quotes" 3) ("attributes" 3) ("blobs" 3)))

(DEFUN coco-wt-opt-number (name)
  (LET ((i (POSITION name *wt-options* :KEY #'FIRST :TEST #'STRING=)))
    (UNLESS i (ERROR "cocolog: no write_term option ~S" name))
    (1+ i)))

(DEFMACRO coco-wt-opt (name) (coco-wt-opt-number name))

;;; The bodies of the two functions made of the table: NM's row, 0 for a
;;; name swipl has not, and a row's kind, 0 for no row
(DEFMACRO coco-wt-opt-body (nm)
  (LET* ((lead (LAMBDA (s) (CHAR-CODE (CHAR s 0))))
         (leads (SORT (REMOVE-DUPLICATES (MAPCAR (LAMBDA (row) (FUNCALL lead (FIRST row)))
                                                 *wt-options*))
                      #'<)))
    `(let ((int lead0 . #'(bitand (cast int (nth 0 ,nm)) 255)))
       (cond
         ,@(MAPCAR
            (LAMBDA (k)
              `((== lead0 ,k)
                (cond
                  ,@(LOOP FOR row IN *wt-options* FOR i FROM 1
                          WHEN (= (FUNCALL lead (FIRST row)) k)
                          COLLECT `((== 0 (strcmp ,nm ,(FIRST row))) (return ,i)))
                  (#t (return 0)))))
            leads)
         (#t (return 0))))))

(DEFMACRO coco-wt-kind-body (id)
  `(switch ,id
     ,@(LOOP FOR row IN *wt-options* FOR i FROM 1
             COLLECT `(case ,i (return ,(SECOND row))))
     (default (return 0))))

;;; FORMAT'S OWN TEXT WALKED (3.33.0): what was put in S since `cdone', up
;;; to TO, by pl-fmt.c's update_column() -- `coco_col_walk' mode 0, a tab
;;; to (COL + 1) | 7. `~a', `~s', `~c', the numbers and the format's
;;; characters are walked so
(DEFMACRO coco-fmt-own (cs s to)
  `(block (set (-> ,cs col) (coco_col_walk ,s (-> ,cs cdone) ,to (-> ,cs col) 0))
          (set (-> ,cs cdone) ,to)))

;;; WHETHER A WRITER WROTE TO THE STREAM (3.33.0), swipl's
;;; prepare_sub_format(): no fill point held, and the stream's linepos
;;; (`slp', what was put in S up to TO, walked as a stream counts, a tab to
;;; the next eighth) the column WC0. WDIRECT is set to it
(DEFMACRO coco-fmt-direct (cs s to wc0 wdirect)
  `(block (set (-> ,cs slp) (coco_col_walk ,s (-> ,cs bdone) ,to (-> ,cs slp) 1))
          (set (-> ,cs bdone) ,to)
          (set ,wdirect (== (-> ,cs slp) ,wc0))))

;;; THE COLUMN AFTER A WRITER'S TEXT (3.33.0), swipl's end_sub_format(): of
;;; the text FROM to TO in S, the column WC0 before it -- where the writer
;;; wrote to the stream (WDIRECT) the stream's linepos after it, else WC0
;;; and the linepos the text reaches from 0, a newline in it no reset
(DEFMACRO coco-fmt-wcol (s from to wc0 wdirect)
  `(? ,wdirect
      (coco_col_walk ,s ,from ,to ,wc0 1)
      (+ ,wc0 (coco_col_walk ,s ,from ,to 0 1))))

;;; FORMAT'S COLUMN BROUGHT UP TO THE TEXT IN HAND (3.33.0), what was put
;;; in O walked as format's own text -- asked where the column is: a fill
;;; point, a stop, `~N' and a writer. The first ask walks what the format
;;; put out before it (`coco_fmt_catchup'): until then nothing is walked
;;; (`on' 0) and a writer notes where its text stands
(DEFMACRO coco-fmt-now (cs o)
  `(block (if (not (-> ,cs on)) (coco_fmt_catchup ,cs ,o))
          (coco-fmt-own ,cs (-> ,o s) (-> ,o len))))

;;; A WRITER'S COLUMN (3.33.0), as swipl's sub-formats reckon it: FORM puts
;;; a term in O, and the column after it is the writer's (`coco-fmt-wcol'),
;;; the stream's linepos asked where no fill point is held
;;; (`coco-fmt-direct'). Before the first ask of the column (`on' 0) the
;;; writer notes where its text begins and ends in B, eight writers at
;;; most, and the ninth asks
(DEFMACRO coco-fmt-writer (cs b o form)
  `(let ((i64 wc0 . 0) (size_t wfrom . 0) (int wdirect . 0))
     (if (and (not (-> ,cs on)) (>= (-> ,cs nw) 8)) (coco_fmt_catchup ,cs ,o))
     (set wfrom (-> ,o len))
     (if (-> ,cs on)
         (block (coco-fmt-now ,cs ,o)
                (set wc0 (-> ,cs col))
                (if (== (-> ,cs rn) 0) (coco-fmt-direct ,cs (-> ,b s) (-> ,b len) wc0 wdirect))))
     ,form
     (if (-> ,cs on)
         (block (set (-> ,cs col) (coco-fmt-wcol (-> ,o s) wfrom (-> ,o len) wc0 wdirect))
                (set (-> ,cs cdone) (-> ,o len)))
         (block (set (nth (-> ,cs nw) (-> ,cs wbeg)) wfrom)
                (set (nth (-> ,cs nw) (-> ,cs wend)) (-> ,o len))
                (set (-> ,cs nw) (+ (-> ,cs nw) 1))))))

(generic impl-builtins-format
  ()

  ;;; ---- write_term/2's options -------------------------------------------
  ;;;
  ;;; THE OPTIONS ARE CHECKED AS SWIPL'S ARE (3.0.0, pl-write.c's table and
  ;;; scan_options()), before anything is written, each error named for
  ;;; write_term/2: the list unbound or partial instantiation_error, no list
  ;;; type_error(list, Opts); an element unbound instantiation_error, one
  ;;; that is neither Name(Value) nor Name = Value -- a bare name of a
  ;;; boolean option is Name(true) -- type_error(option, X); an option of a
  ;;; name swipl has and a value of the wrong type type_error(bool, V),
  ;;; type_error(integer, V), type_error(atom, V), domain_error(spacing, V),
  ;;; and variable_names/1 a proper list of Name = V, Name an atom that is a
  ;;; variable's name (type_error(list, L), type_error(variable_assignment,
  ;;; X), type_error(atom, N), domain_error(variable_name, N)). An option of
  ;;; a name swipl has not is read past, as swipl's is. Through 2.16 every
  ;;; option was read past but the four below, and those only as Name(true).

  ;;; An option's row of `*wt-options*' by its NAME, 0 for a name swipl
  ;;; has not, and the kind swipl gives the row: 1 boolean, 2 integer, 3
  ;;; atom, 4 spacing, 5 variable_names, 6 any term, 0 none of its own.
  (static)
  (func coco_wt_opt ((const char * nm)) (out int)
        (coco-wt-opt-body nm))

  (static)
  (func coco_wt_id_kind ((int id)) (out int)
        (coco-wt-kind-body id))

  (static)
  (func coco_wt_kind ((const char * nm)) (out int)
        (return (coco_wt_id_kind (coco_wt_opt nm))))

  ;;; Whether V is a boolean as swipl's PL_get_bool reads one; 1 true, 0
  ;;; false, -1 neither: true, on and the integer 1, false, off and 0 (the
  ;;; integers since 3.53.0, `quoted(1)'; through 3.52.0 type_error(bool, 1)).
  (static)
  (func coco_wt_truth ((coco_engine * e) (size_t v)) (out int)
        (let ((const char * s . #'(coco_m_atom e v)) (i64 iv . 0))
          (if (and (== s nil) (coco_m_int e v (aof iv)))
              (return (? (== iv 1) 1 (? (== iv 0) 0 -1))))
          (if (== s nil) (return -1))
          (if (or (== 0 (strcmp s "true")) (== 0 (strcmp s "on"))) (return 1))
          (if (or (== 0 (strcmp s "false")) (== 0 (strcmp s "off"))) (return 0))
          (return -1)))

  ;;; Whether S is a variable's name: an upper-case letter or `_' first, then
  ;;; letters, digits and `_' (a byte past ASCII is taken, as a letter).
  (static)
  (func coco_wt_varname ((const char * s)) (out int)
        (let ((int c . #'(bitand (cast int (nth 0 s)) 255)))
          (if (not (or (and (>= c 65) (<= c 90)) (or (== c 95) (>= c 128)))) (return 0))
          (for ((size_t i . 1)) (!= (nth i s) (cast char 0)) ((++ i))
            (set c (bitand (cast int (nth i s)) 255))
            (if (not (or (and (>= c 65) (<= c 90)) (or (and (>= c 97) (<= c 122))
                     (or (and (>= c 48) (<= c 57)) (or (== c 95) (>= c 128))))))
                (return 0)))
          (return 1)))

  ;;; variable_names(L)'s list, checked.
  (static)
  (func coco_wt_check_names ((coco_engine * e) (size_t l)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t t . #'(coco_deref m l)) (size_t budget . #'(-> m heap_len)))
          (while (and (coco_is_cons m t) (> budget 0))
            (let ((size_t p . #'(coco_deref m (coco_arg m t 0))))
              (if (coco_m_is_var e p) (return (coco_m_instantiation_error e)))
              (if (not (and (coco-tag-is FUN (nth p (-> m heap)))
                            (and (== (coco_arity m p) 2)
                                 (== 0 (strcmp (coco_atom_name m (coco_name_of m p)) "=")))))
                  (return (coco_m_type_error e "variable_assignment" p)))
              (let ((size_t nm . #'(coco_deref m (coco_arg m p 0))))
                (if (coco_m_is_var e nm) (return (coco_m_instantiation_error e)))
                (if (not (coco_m_is_atom e nm)) (return (coco_m_type_error e "atom" nm)))
                (if (not (coco_wt_varname (coco_m_atom e nm)))
                    (return (coco_m_domain_error e "variable_name" nm)))))
            (set budget (- budget 1))
            (set t (coco_deref m (coco_arg m t 1))))
          (if (coco_is_nil m t) (return 1))
          (if (coco_m_is_var e t) (return (coco_m_instantiation_error e)))
          (return (coco_m_type_error e "list" (coco_deref m l)))))

  ;;; One option's name and value: Name(V), Name = V, or a bare boolean name
  ;;; (V unset, SIZE_MAX: cell 0 is a cell). Answers 1, or 0 for none of
  ;;; the three.
  (static)
  (func coco_wt_parse ((coco_engine * e) (size_t o) (const char ** nm) (size_t * v)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)))
          (set (cof v) (cast size_t -1))
          (set o (coco_deref m o))
          (if (coco-tag-is FUN (nth o (-> m heap)))
              (let ((const char * f . #'(coco_atom_name m (coco_name_of m o))) (u32 ar . #'(coco_arity m o)))
                (if (== ar 1)
                    (block (set (cof nm) f) (set (cof v) (coco_deref m (coco_arg m o 0))) (return 1)))
                (if (and (== ar 2) (== 0 (strcmp f "=")))
                    (let ((size_t k . #'(coco_deref m (coco_arg m o 0))))
                      (if (coco_m_is_atom e k)
                          (block (set (cof nm) (coco_m_atom e k))
                                 (set (cof v) (coco_deref m (coco_arg m o 1)))
                                 (return 1)))))))
          (if (and (coco_m_is_atom e o) (== (coco_wt_kind (coco_m_atom e o)) 1))
              (block (set (cof nm) (coco_m_atom e o)) (return 1)))
          (return 0)))

  ;;; The same, raising: unbound instantiation_error, none of the three
  ;;; type_error(option, O).
  (static)
  (func coco_wt_option ((coco_engine * e) (size_t o) (const char ** nm) (size_t * v)) (out int)
        (if (coco_m_is_var e o) (return (coco_m_instantiation_error e)))
        (if (coco_wt_parse e o nm v) (return 1))
        (return (coco_m_type_error e "option" o)))

  ;;; The options checked, as the head of this section says, and then the
  ;;; term TM under cycles(false) (3.55.0, swipl's PL_WRT_NO_CYCLES; through
  ;;; 3.54.0 checked and read past): a cyclic one is domain_error(cyclic_term,
  ;;; TM), raised before a character is written, whatever the depth limit --
  ;;; swipl asks PL_is_acyclic() of the whole term once its options are read.
  (static)
  (func coco_wt_check ((coco_engine * e) (size_t opts) (size_t tm)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t t . #'(coco_deref m opts)) (size_t budget . #'(-> m heap_len)) (int r . 0)
              (int cycles . 1))
          (while (and (coco_is_cons m t) (> budget 0))
            (let ((const char * nm . nil) (size_t v . 0) (int k . 0) (int id . 0))
              (set r (coco_wt_option e (coco_deref m (coco_arg m t 0)) (aof nm) (aof v)))
              (if (!= r 1) (return r))
              (set id (coco_wt_opt nm))
              (set k (coco_wt_id_kind id))
              ;; the last cycles(B) said stands, as every option's does
              (if (== id (coco-wt-opt "cycles"))
                  (set cycles (or (== v (cast size_t -1)) (== (coco_wt_truth e v) 1))))
              (if (and (!= v (cast size_t -1)) (and (!= k 0) (!= k 6)))
                  (block
                    (if (coco_m_is_var e v) (return (coco_m_instantiation_error e)))
                    (if (and (== k 1) (< (coco_wt_truth e v) 0)) (return (coco_m_type_error e "bool" v)))
                    ;; an int's range (3.49.0, swipl's OPT_INT): max_depth(D)
                    ;; and priority(P) past it are representation_error(int)
                    (if (== k 2)
                        (let ((i64 iv . 0))
                          (if (not (coco_m_int e v (aof iv))) (return (coco_m_type_error e "integer" v)))
                          (if (or (< iv -2147483648) (> iv 2147483647))
                              (return (coco_m_raise e (coco_make1 m "representation_error"
                                                                  (coco_new_atom m "int")))))))
                    (if (and (or (== k 3) (== k 4)) (not (coco_m_is_atom e v)))
                        (return (coco_m_type_error e "atom" v)))
                    (if (and (== k 4) (and (!= 0 (strcmp (coco_m_atom e v) "standard"))
                                           (!= 0 (strcmp (coco_m_atom e v) "next_argument"))))
                        (return (coco_m_domain_error e "spacing" v)))
                    (if (== k 5)
                        (block (set r (coco_wt_check_names e v)) (if (!= r 1) (return r)))))))
            (set budget (- budget 1))
            (set t (coco_deref m (coco_arg m t 1))))
          (if (coco_is_nil m t)
              (return (? (or cycles (coco_acyclic m tm)) 1
                         (coco_m_domain_error e "cyclic_term" (coco_deref m tm)))))
          (if (coco_m_is_var e t) (return (coco_m_instantiation_error e)))
          (return (coco_m_type_error e "list" (coco_deref m opts)))))

  ;;; Whether the program has a clause for portray/1 (3.54.0): swipl asks
  ;;; it only then, its user:portray/1 being dynamic with none, so print/1
  ;;; of a program with none writes as writeq/1 and calls nothing. The name
  ;;; is the machine's own, interned once (`*functor-names*')
  (static)
  (func coco_portray_defined ((coco_engine * e)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (coco_store * st . #'(-> e st))
              (size_t pi . 0))
          (if (== coco_portray_hook nil) (return 0))
          (set pi (coco_pred_find st ($ (nth (coco-fid m "portray" 1) (-> m functors)) name) 1))
          (if (>= pi (-> st npreds)) (return 0))
          (return (> (coco_pred_count st pi) ($ (nth pi (-> st preds)) ntomb)))))

  ;;; T written into B as OPTS say, for write_term/2 (lib/builtins-db.cicili)
  ;;; and format's `~W' (3.0.0). `quoted(true)', `ignore_ops(true)',
  ;;; `numbervars(true)' and `variable_names(['X'=V, ...])' are the ones the
  ;;; writer has -- variable_names since 1.10.6: each named variable still
  ;;; unbound is written as its name, where through 1.10.5 the option was
  ;;; read past and every variable came out `_G' and a number; numbervars
  ;;; since 2.2.5, `'$VAR'(N)' as the variable it names, and quoted with
  ;;; swipl's character escapes since then too (`'don\'t''). Anything else
  ;;; in the list is ignored rather than refused, because an option a writer
  ;;; does not implement is not a reason to fail a program. AN OPTION SAID
  ;;; TWICE IS ITS LAST (3.47.0, swipl's scan_options()): `[quoted(true),
  ;;; quoted(false)]' writes unquoted and the second variable_names/1 names
  ;;; the variables; through 3.46.0 a boolean was on if any said true, and
  ;;; the first variable_names/1 named them. fullstop(true), nl(true),
  ;;; dotlists(true) and no_lists(true) are swipl's since 3.53.0
  ;;; (`coco_write_fullstop', `coco_write_list_dots'), and portray(true) and
  ;;; portray_goal(G) since 3.54.0, each implying numbervars(true) unless
  ;;; numbervars(B) is given: the write asks portray/1 of its terms while it
  ;;; has a clause, or G, through call/3 (`coco_portray_call'). And since
  ;;; 3.55.0, swipl's: character_escapes(false), the quoted text as it is
  ;;; but its quote doubled and its backslash `\\' (256 without 16:
  ;;; `'a<LF>b'', `'it''s'', `"say ""hi"""'); character_escapes_unicode(false),
  ;;; a character escaped by its code `\x1\' (no 64; `\u0001' with it);
  ;;; quote_non_ascii(true), a name past U+00FF quoted (32768: `'∀'', never
  ;;; `é'); and brace_terms(false), a curly term `{}(T)' (128). A cycle's
  ;;; factors are S_1, S_2, ... under numbervars alone, as swipl binds them
  ;;; to `'$VAR'('S_1')' only then (`coco_write_cyclic'); through 3.54.0
  ;;; under every write_term/2.
  (static)
  (func coco_wt_put ((coco_engine * e) (coco_strbuf * b) (size_t t) (size_t opts)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t * v . nil) (size_t n . 0)
              (int quoted . 0) (int ignore_ops . 0) (int numbervars . 0) (int nvset . 0)
              (int portray . 0) (size_t pgoal . 0) (int asks . 0)
              (int fullstop . 0) (int nl . 0) (int dotlists . 0) (int nolists . 0)
              (int escapes . 1) (int unicode . 1) (int nonascii . 0) (int braces . 1)
              (int spacing . 0) (i64 prio . -1) (i64 maxd . 0) (size_t vno . #'(cast size_t -1))
              (size_t * nv . nil) (size_t nn . 0) (size_t k . 0)
              (size_t * cells . nil) (u64 * names . nil))
          (if (coco_m_list_array e opts (aof v) (aof n))
              (for ((size_t i . 0)) (< i n) ((++ i))
                (let ((size_t o . #'(coco_deref m (nth i v)))
                      (const char * nm . nil) (size_t ov . 0))
                  ;; Name(V), Name = V or a bare boolean name, as the check
                  ;; reads it, and true or on for true (3.0.0)
                  (if (== 1 (coco_wt_parse e o (aof nm) (aof ov)))
                      (let ((int on . #'(? (== ov (cast size_t -1)) 1
                                           (? (== (coco_wt_truth e ov) 1) 1 0)))
                            (int given . #'(!= ov (cast size_t -1))))
                        ;; the option's row, found once (3.55.0)
                        (switch (coco_wt_opt nm)
                          (case (coco-wt-opt "quoted") (set quoted on) break)
                          (case (coco-wt-opt "ignore_ops") (set ignore_ops on) break)
                          (case (coco-wt-opt "numbervars") (set numbervars on) (set nvset 1) break)
                          ;; portray(B) and portray_goal(G) (3.54.0, swipl's;
                          ;; through 3.53.0 checked and read past), and
                          ;; portrayed(B), portray(B) by another name, the
                          ;; last of the two said standing (3.55.0, swipl's
                          ;; `portrayed' in pl_write_term3())
                          (case (coco-wt-opt "portray") (set portray on) break)
                          (case (coco-wt-opt "portrayed") (set portray on) break)
                          (case (coco-wt-opt "portray_goal") (if given (set pgoal ov)) break)
                          ;; fullstop(B), nl(B), dotlists(B) and no_lists(B)
                          ;; (3.53.0, swipl's; through 3.52.0 checked and read
                          ;; past)
                          (case (coco-wt-opt "fullstop") (set fullstop on) break)
                          (case (coco-wt-opt "nl") (set nl on) break)
                          (case (coco-wt-opt "dotlists") (set dotlists on) break)
                          (case (coco-wt-opt "no_lists") (set nolists on) break)
                          ;; character_escapes(B), character_escapes_unicode(B),
                          ;; quote_non_ascii(B) and brace_terms(B) (3.55.0,
                          ;; swipl's; through 3.54.0 checked and read past)
                          (case (coco-wt-opt "character_escapes") (set escapes on) break)
                          (case (coco-wt-opt "character_escapes_unicode") (set unicode on) break)
                          (case (coco-wt-opt "quote_non_ascii") (set nonascii on) break)
                          (case (coco-wt-opt "brace_terms") (set braces on) break)
                          ;; spacing(next_argument) and priority(P) (3.19.0,
                          ;; swipl's; through 3.18.0 checked and read past)
                          (case (coco-wt-opt "spacing")
                            (if given
                                (set spacing (? (and (coco_m_is_atom e ov)
                                                     (== 0 (strcmp (coco_m_atom e ov) "next_argument"))) 1 0)))
                            break)
                          (case (coco-wt-opt "priority")
                            (if (and given (not (coco_m_int e ov (aof prio)))) (set prio -1))
                            break)
                          ;; max_depth(D) (3.49.0, swipl's; through 3.48.3
                          ;; checked and read past), 0 no limit
                          (case (coco-wt-opt "max_depth")
                            (if (and given (not (coco_m_int e ov (aof maxd)))) (set maxd 0))
                            break)
                          (case (coco-wt-opt "variable_names") (if given (set vno ov)) break)
                          (default break)))))))
          (free v)
          ;; the variable names the last variable_names/1 gave, each
          ;; `Name = V' of an atom and a variable still unbound
          (if (and (!= vno (cast size_t -1)) (coco_m_list_array e vno (aof nv) (aof nn)))
              (block
               (set cells (cast (size_t *) (malloc (* (+ nn 1) (sizeof size_t)))))
               (set names (cast (u64 *) (malloc (* (+ nn 1) (sizeof u64)))))
               (if (and (!= cells nil) (!= names nil))
                   (for ((size_t j . 0)) (< j nn) ((++ j))
                     (let ((size_t p . #'(coco_deref m (nth j nv))))
                       (if (and (and (coco_is_callable m p) (== 2 (coco_arity m p)))
                                (== 0 (strcmp (coco_atom_name m (coco_name_of m p)) "=")))
                           (let ((size_t nmc . #'(coco_deref m (coco_arg m p 0)))
                                 (size_t vc . #'(coco_deref m (coco_arg m p 1))))
                             (if (and (coco_m_is_atom e nmc)
                                      (coco-tag-is REF (nth vc (-> m heap))))
                                 (block (set (nth k cells) vc)
                                        (set (nth k names) (coco_name_of m nmc))
                                        (set k (+ k 1)))))))))
               (free nv)))
          (if (and (!= cells nil) (!= names nil))
              (block (set (-> m wcells) cells) (set (-> m wnames) names) (set (-> m nwnames) k)))
          ;; quoted(true) writes a character to escape as swipl's
          ;; write_term/2 does, `\u0001' (64, character_escapes_unicode)
          (if (and (>= prio 0) (<= prio 1200)) (set (-> m wprec) (+ (cast int prio) 1)))
          ;; a depth limit is the machine's WMAX and the mode's 1024, which
          ;; the writer tests before it reads WMAX
          (set (-> m wmax) maxd)
          ;; portray_goal(G) is portray(true) calling G, and either is
          ;; numbervars(true) where numbervars(B) is not said (3.54.0)
          (if (!= pgoal 0) (set portray 1))
          (if (and portray (not nvset)) (set numbervars 1))
          (set asks (or (!= pgoal 0) (and portray (coco_portray_defined e))))
          ;; quoted: swipl's escapes in their unicode form (81), or with
          ;; neither the text as it is (257); quote_non_ascii's 32768
          (let ((int mode . #'(bitor (? quoted (? escapes (? unicode 81 17) 257) 0)
                                 (bitor (? (and quoted nonascii) 32768 0)
                                 (bitor (? ignore_ops 2 0) (bitor (? braces 0 128)
                                 (bitor (? numbervars 8 0) (bitor (? spacing 512 0)
                                 (bitor (? (!= maxd 0) 1024 0)
                                 (bitor (? dotlists 2048 0) (? nolists 4096 0)))))))))))
            ;; a cycle's factors named S_1, ... under numbervars alone
            (if asks
                (block (set (-> m wpgoal) pgoal) (set (-> m wpopts) opts)
                       (coco_write_portrayed m b t (bitor mode 8192) numbervars)
                       (set (-> m wpgoal) 0) (set (-> m wpopts) 0))
              (coco_write_mode m b t mode numbervars)))
          ;; and the full stop after it and the newline, as swipl's
          ;; pl_write_term3() puts them (3.53.0), unless a portray goal
          ;; stopped the write
          (if (== (-> m wpstate) 0)
              (if fullstop (coco_write_fullstop b nl)
                (if nl (coco_sb_putc b (cast char 10)))))
          (set (-> m wprec) 0)
          (set (-> m wmax) 0)
          (set (-> m wcells) nil) (set (-> m wnames) nil) (set (-> m nwnames) 0)
          (free cells) (free names)
          (return 1)))

  ;;; ---- format/1,2,3 ---------------------------------------------------
  ;;;
  ;;; WHY IT IS HERE AT ALL: SWI's `library(dcg/basics)' generates numbers with
  ;;; `format(codes(H,T), '~d', [I])' -- four calls, and without them half that
  ;;; library only works in the parsing direction. It is also the predicate a
  ;;; Prolog program reaches for more than any other, so its absence was a hole
  ;;; whoever found it next would have fallen into.
  ;;;
  ;;; THE DIRECTIVES ARE SWIPL'S (3.0.0, its pl-fmt.c): a directive's numeric
  ;;; argument is digits, `*' (the next argument, an integer of 0 or more) or
  ;;; a backquote and a character (`~t''s fill), then an optional `:' (the
  ;;; locale's, which cocolog has none of and reads past), then the
  ;;; directive. `~d', `~D', `~I', `~r', `~R' and the floats' five EVALUATE
  ;;; their argument, as is/2 does (`~d' of 1+2 is 3), and an error is
  ;;; swipl's term: format('not enough arguments'), format('too many
  ;;; arguments'), format_argument_type(D, A), existence_error(format_character,
  ;;; C), domain_error(radix, N). Through 2.16.1 each was cocolog_error with
  ;;; a sentence of its own, an argument left over was ignored, and `~d' took
  ;;; a plain integer alone.
  ;;;
  ;;; THE COLUMN DIRECTIVES ARE SWIPL'S (3.33.0, pl-fmt.c's format_state;
  ;;; `coco_fmt_cols' below): `~t' a fill point, `~N|' a column stop at N and
  ;;; `~N+' one N past the last stop. Through 3.32.0 each was refused with
  ;;; cocolog_error(`format/2: cocolog has no column directives').
  ;;;
  ;;; `~@' IS SWIPL'S (3.34.0): its argument called once, its output put
  ;;; in where the directive stands (`coco_out_capture_run'). Through 3.33.0
  ;;; it was refused with cocolog_error(`format/2: cocolog has no ~@
  ;;; directive'), the last directive of swipl's that was.

  ;;; One argument at a time. Answers 0 when there are none left, which every
  ;;; caller turns into format('not enough arguments').
  (static)
  (func coco_fmt_arg ((const size_t * items) (size_t n) (size_t * i) (size_t * out))
        (out int)
        (if (>= (cof i) n) (return 0))
        (set (cof out) (nth (cof i) items))
        (set (cof i) (+ (cof i) 1))
        (return 1))

  ;;; A number in BASE, into BUF. Bases 2..36, digits lower or upper case.
  (static)
  (func coco_fmt_radix ((i64 v) (int base) (int upper) (char * buf) (size_t cap))
        (let ((char tmp [80]) (size_t n . 0) (int neg . 0) (u64 u)
              (const char * lo . "0123456789abcdefghijklmnopqrstuvwxyz")
              (const char * up . "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"))
          ;; the magnitude in u64: the least integer's, 2^63, has no i64
          (if (< v 0) (block (set neg 1) (set u (- (cast u64 0) (cast u64 v)))) (set u (cast u64 v)))
          (if (== u 0) (block (set (nth n tmp) (cast char 48)) (set n 1)))
          (while (> u 0)
            (set (nth n tmp) (nth (cast size_t (% u (cast u64 base))) (? upper up lo)))
            (set n (+ n 1))
            (set u (/ u (cast u64 base))))
          (let ((size_t k . 0))
            (if neg (block (if (< k (- cap 1)) (block (set (nth k buf) (cast char 45))
                                                      (set k (+ k 1))))))
            (while (> n 0)
              (set n (- n 1))
              (if (< k (- cap 1)) (block (set (nth k buf) (nth n tmp)) (set k (+ k 1)))))
            (set (nth k buf) (cast char 0)))))

  ;;; AN INTEGER AS `~d', `~D' AND `~I' WRITE IT (3.0.0, swipl's
  ;;; formatInteger()): its sign; the digits before a point PLACES digits
  ;;; from the right -- `~2d' of 1234 is `12.34', of 7 `0.07' -- in groups of
  ;;; GROUP from the right with SEP between them (`~D' threes and a comma,
  ;;; `~I' its argument or three and an underscore, `~d' none); then the
  ;;; point and the PLACES digits. Through 2.16.1 `~ND' wrote no point.
  (static)
  (func coco_fmt_int ((coco_strbuf * b) (i64 v) (long places) (int group) (int sep)) (out int)
        (let ((char all [80]) (char * digits . all) (size_t len . 0)
              (int neg . #'(? (< v 0) 1 0)) (size_t z . 0) (size_t dlen . 0)
              (size_t ilen . 0) (size_t pl . 0))
          ;; written with its sign and the sign stepped over: the least
          ;; integer has no negation to write (2.0.0)
          (coco_fmt_radix v 10 0 all (sizeof all))
          (if neg (set digits (+ all 1)))
          (set len (strlen digits))
          (set pl (? (> places 0) (cast size_t places) 0))
          ;; fewer digits than places: zeros in front, one of them before
          ;; the point -- `~4d' of 7 is `0.0007'
          (if (and (> pl 0) (<= len pl)) (set z (- (+ pl 1) len)))
          (set dlen (+ z len))
          (set ilen (- dlen pl))
          (if neg (if (not (coco_sb_putc b (cast char 45))) (return 0)))
          (for ((size_t i . 0)) (< i dlen) ((++ i))
            (if (and (== i ilen) (> pl 0))
                (if (not (coco_sb_putc b (cast char 46))) (return 0)))
            (if (and (and (> group 0) (> i 0))
                     (and (< i ilen) (== 0 (% (- ilen i) (cast size_t group)))))
                (if (not (coco_sb_putc b (cast char sep))) (return 0)))
            (if (not (coco_sb_putc b (? (< i z) (cast char 48) (nth (- i z) digits))))
                (return 0)))
          (return 1)))

  ;;; WHAT WENT WRONG, set when `coco_fmt_build' answers 0 (3.0.0), and
  ;;; raised by `coco_fmt_raise' once what was built before it is out:
  ;;;   1 format(MESSAGE), the message in ERR -- swipl's FMT_ERROR
  ;;;   2 format_argument_type(D, A), D in *FDIR and A in *FBAD -- FMT_ARG
  ;;;   3 existence_error(format_character, C), the character's atom in *FBAD
  ;;;   4 domain_error(radix, N), N's cell in *FBAD
  ;;;   5 an error the evaluation of an argument raised, its answer in *FDIR
  ;;;   6 a refused buffer: resource_error(memory)
  ;;;   8 representation_error(code_point): `~c' of a code past U+10FFFF
  ;;;   9 the goal of `~@' failed: the format fails (3.34.0)
  ;;;  10 the goal of `~@' threw: its ball, in the `coco_fmt_ball', raised
  ;;;     again (3.34.0)
  ;;;  11 the goal of `~@' ended the run with no ball (3.34.0)
  ;;;  12 its output could not be captured: cocolog_error(ERR), as
  ;;;     with_output_to/2's (3.34.0)
  ;;; Through 3.33.0, 7 was a directive cocolog did not lay out: `~t', `~|',
  ;;; `~+' and at last `~@'.
  (static)
  (func coco_fmt_fail ((char * err) (size_t errlen) (int * fkind) (int kind) (const char * msg))
        (out int)
        (snprintf err errlen "%s" msg)
        (set (cof fkind) kind)
        (return 0))

  ;;; The argument of a numeric directive EVALUATED, as swipl's
  ;;; valueExpression() evaluates it (3.0.0): 1 with the value in *ISF (0 an
  ;;; integer in *IV, 1 a float in *FV, 2 a rational, its pair in the
  ;;; machine), or the raise's answer -- `a' raises type_error(evaluable,
  ;;; a/0), an unbound argument instantiation_error, as is/2 does.
  (static)
  (func coco_fmt_eval ((coco_engine * e) (size_t a) (int * isf) (i64 * iv) (double * fv))
        (out int)
        (let ((int rc . #'(coco_arith e a isf iv fv 0)))
          (if (== rc 3) (return (coco_type_error e "expression" a)))
          (return rc)))

  ;;; The character at S (of N bytes) as an atom, for a directive no format
  ;;; has: one character under `text_units = characters', one byte under
  ;;; bytes; the end of the text is the empty atom, an atom being a C string
  ;;; where swipl's is '\u0000'.
  (static)
  (func coco_fmt_char_atom ((coco_machine * m) (const char * s) (size_t n)) (out size_t)
        (let ((char one [8]) (size_t at . 0) (int k . 1))
          (if (== n 0) (return (coco_new_atom m "")))
          (if (-> m text_chars)
              (block (set k (coco_utf8_enc one (coco_utf8_get s n (aof at))))
                     (if (== k 0) (block (set (nth 0 one) (nth 0 s)) (set k 1))))
              (set (nth 0 one) (nth 0 s)))
          (set (nth k one) (cast char 0))
          (return (coco_new_atom m one))))

  ;;; `~e', `~E', `~f', `~g' and `~G' of the double V, PLACES digits, through
  ;;; printf as swipl's formatFloat() writes a double: of any length (through
  ;;; 2.16.1 a buffer of 128 bytes cut `~f' of 1e300 short).
  (static)
  (func coco_fmt_float ((coco_strbuf * b) (double v) (long places) (char d)) (out int)
        (let ((char spec [24]) (int need . 0) (char * tmp . nil))
          (snprintf spec (sizeof spec) "%%.%ld%c" places d)
          (set need (snprintf nil 0 spec v))
          (if (< need 0) (return 0))
          (set tmp (cast (char *) (malloc (+ (cast size_t need) 1))))
          (if (== tmp nil) (return 0))
          (snprintf tmp (+ (cast size_t need) 1) spec v)
          (let ((int ok . #'(coco_sb_put_len b tmp (cast size_t need))))
            (free tmp)
            (return ok))))

  ;;; FORMAT'S COLUMNS (3.33.0), swipl's format_state (pl-fmt.c): the
  ;;; column the format reckons, `col', and how far into the text in hand
  ;;; it is reckoned, `cdone' -- by format's own rule, a tab to (COL + 1) |
  ;;; 7, at each use (`coco-fmt-now'); the column the sink stands at,
  ;;; `slp', its stream's linepos, and how far into what was put out,
  ;;; `bdone'; the last column stop, `stop'; and the segment held since a
  ;;; fill point, `pb', with its fill points -- where in it, the character
  ;;; and how many -- `rn' of them, a hundred at most (MAXRUBBER). `chars'
  ;;; is the machine's text_units, a fill character's encoding. `on' says
  ;;; the column is walked; until the format first asks it, it is not, and
  ;;; the writers' texts -- `nw' of them, where each begins and ends in the
  ;;; sink's buffer -- are all the first ask needs to walk it as it would
  ;;; have been walked (`coco_fmt_catchup').
  (struct coco_fmt_cols
    (member i64 col)
    (member size_t cdone)
    (member i64 slp)
    (member size_t bdone)
    (member i64 stop)
    (member int rn)
    (member int chars)
    (member int on)
    (member int nw)
    (member coco_strbuf pb)
    (member size_t wbeg [8])
    (member size_t wend [8])
    (member size_t where [100])
    (member i64 pad [100])
    (member i64 size [100]))

  ;;; the held segment, at any exit of the format
  (func coco_fmt_cols_free ((coco_fmt_cols * p)) (out void)
        (coco_sb_free (aof (-> p pb))))

  ;;; THE COLUMN WALKED AT ITS FIRST ASK (3.33.0): over what the format put
  ;;; in B before it, as each piece would have been walked as it was put
  ;;; out -- format's own text by its rule, each writer's by the writer's
  ;;; (`coco-fmt-writer', the stream's linepos `slp' beside it) -- and from
  ;;; here on as it is put out. No fill point stood before the first ask,
  ;;; so the writers' texts are all there is to know. A format of a line of
  ;;; 44 characters and a `~w', which asks no column, costs 3.32.0's and 94
  ;;; instructions so; walked at every format, the column cost it 1 336,
  ;;; and a scan of the format for the directives that ask it 417
  (static)
  (func coco_fmt_catchup ((coco_fmt_cols * cs) (coco_strbuf * b)) (out void)
        (let ((i64 wc0 . 0) (int wdirect . 0))
          (for ((int k . 0)) (< k (-> cs nw)) ((++ k))
            (let ((size_t wb . #'(nth k (-> cs wbeg))) (size_t we . #'(nth k (-> cs wend))))
              (coco-fmt-own cs (-> b s) wb)
              (set wc0 (-> cs col))
              (coco-fmt-direct cs (-> b s) wb wc0 wdirect)
              (set (-> cs col) (coco-fmt-wcol (-> b s) wb we wc0 wdirect))
              (set (-> cs cdone) we)))
          (set (-> cs on) 1)))

  ;;; THE SEGMENT PUT OUT (3.33.0), pl-fmt.c's emit_rubber(): its text into
  ;;; B with each fill point's characters where it stood, and the segment
  ;;; and its fill points cleared. Answers 0 where memory was refused.
  (static)
  (func coco_fmt_emit ((coco_fmt_cols * cs) (coco_strbuf * b)) (out int)
        (let ((size_t last . 0) (char u [8]) (int ul . 0)
              (const char * t . #'($ (-> cs pb) s)))
          (for ((int k . 0)) (< k (-> cs rn)) ((++ k))
            (let ((size_t at . #'(nth k (-> cs where))))
              (if (> at last)
                  (if (not (coco_sb_put_len b (+ t last) (- at last))) (return 0)))
              (set last at)
              (if (-> cs chars)
                  (set ul (coco_utf8_enc u (nth k (-> cs pad))))
                  (block (set (nth 0 u) (cast char (nth k (-> cs pad)))) (set ul 1)))
              (for ((i64 j . 0)) (< j (nth k (-> cs size))) ((++ j))
                (if (not (coco_sb_put_len b u (cast size_t ul))) (return 0)))))
          (if (> ($ (-> cs pb) len) last)
              (if (not (coco_sb_put_len b (+ t last) (- ($ (-> cs pb) len) last))) (return 0)))
          (coco_sb_reset (aof (-> cs pb)))
          (set (-> cs rn) 0)
          (return 1)))

  ;;; A COLUMN STOP (3.33.0), `~N|' or `~N+' as swipl's: at column N --
  ;;; `~|' alone the column the text has reached -- or N past the last stop,
  ;;; `~+' alone eight. The room between the column and the stop is shared
  ;;; among the segment's fill points (pl-fmt.c's distribute_rubber()):
  ;;; alike, and what is left one each from the middle out -- the middle,
  ;;; the one after it, two before, three after -- a place outside the
  ;;; segment taking none, as swipl's drops it; a stop with no fill point
  ;;; fills after the text. The segment is put out and the column is the
  ;;; stop whatever the text reached: text past it overflows, nothing cut
  ;;; and nothing added. With `:' (COLON) a stop the text has passed begins
  ;;; a new line filled to it, with the last fill point's character -- the
  ;;; second pass. *OP, where the text goes, is B again. Answers 0 where
  ;;; memory was refused.
  (static)
  (func coco_fmt_stop ((coco_fmt_cols * cs) (coco_strbuf * b) (coco_strbuf ** op)
                       (int plus) (int have) (i64 num) (int colon)) (out int)
        (let ((coco_strbuf * o . #'(cof op)) (i64 stop . 0) (i64 re . 0))
          (coco-fmt-now cs o)
          (set stop (? have num (? plus 8 (-> cs col))))
          (if plus (set stop (+ (-> cs stop) stop)))
          (if (and colon (< stop (-> cs col)))
              (set re (? (> (-> cs rn) 0) (nth (- (-> cs rn) 1) (-> cs pad)) 32)))
          (if (== (-> cs rn) 0)
              (block (set (nth 0 (-> cs where)) 0) (set (nth 0 (-> cs pad)) 32) (set (-> cs rn) 1)))
          (for ((int pass . 0)) (< pass (? (> re 0) 2 1)) ((++ pass))
            (let ((i64 space . #'(- stop (? pass 0 (-> cs col)))) (int rn . #'(-> cs rn)))
              (if pass
                  (block (if (not (coco_sb_putc b (cast char 10))) (return 0))
                         (set (nth 0 (-> cs where)) 0) (set (nth 0 (-> cs pad)) re)
                         (set rn 1) (set (-> cs rn) 1)))
              (for ((int k . 0)) (< k rn) ((++ k))
                (set (nth k (-> cs size)) (? (> space 0) (/ space (cast i64 rn)) 0)))
              (if (> space 0)
                  (for ((i64 k . 0)) (< k (- space (* (/ space (cast i64 rn)) (cast i64 rn)))) ((++ k))
                    (let ((i64 at . #'(+ (cast i64 (/ rn 2)) (? (% k 2) k (- 0 k)))))
                      (if (and (>= at 0) (< at (cast i64 rn)))
                          (set (nth at (-> cs size)) (+ (nth at (-> cs size)) 1))))))
              (if (not (coco_fmt_emit cs b)) (return 0))))
          (set (-> cs col) stop)
          (set (-> cs stop) stop)
          (set (-> cs cdone) (-> b len))
          (set (cof op) b)
          (return 1)))

  ;;; A BALL A CAPTURED GOAL THREW (3.34.0), kept for the caller to raise
  ;;; again once its own work is done: its cell and size, the store it was
  ;;; put in (nil for the machine's), and that store's length before it.
  (struct coco_fmt_ball
    (member size_t cell)
    (member size_t size)
    (member void * st)
    (member size_t mark))

  ;;; ... RAISED AGAIN, in the caller's engine, where the catch frames are:
  ;;; 2 a catch took it (the continuation is the recovery goal), -1 none.
  ;;; The inner throw's backtrace, written from inside the goal out, is the
  ;;; one kept (`btkeep').
  (static)
  (func coco_fmt_rethrow ((coco_engine * e) (coco_fmt_ball * bl)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (coco_store * bst . #'(? (== (-> bl st) nil) st (cast (coco_store *) (-> bl st)))))
          (if (== bst st) (set (-> st dead) (+ (-> st dead) (-> bl size))))
          (set (-> m btkeep) 1)
          (let ((int caught . #'(? (coco_m_thrown e (coco_store_read m bst (-> bl cell))) 2 -1)))
            (if (!= bst st)
                (block (set (-> bst len) (-> bl mark))
                       (coco_store_shrink_empty bst)))
            (return caught))))

  ;;; A GOAL RUN ONCE WITH ITS OUTPUT CAPTURED (3.34.0, with_output_to/2's
  ;;; and `~@''s, which through 3.33.0 was with_output_to/2's alone).
  ;;;
  ;;; THE REDIRECTION IS AT THE FILE DESCRIPTOR, not at a `FILE *' this code
  ;;; passes around: cocolog writes with `printf', `fputs' and `fputc' to the
  ;;; literal `stdout' in some seventy places, and threading a stream through
  ;;; all of them is the tidier design and a much larger change. So fd 1 is
  ;;; pointed at a `tmpfile' for the duration and put back afterwards -- a
  ;;; temporary file and not a pipe: a pipe holds 64K, and a goal that
  ;;; printed more would block for ever with nobody reading. The capture's
  ;;; column is its own, from 0, and the console's comes back with fd 1.
  ;;;
  ;;; THE GOAL RUNS IN A NESTED ENGINE and so cannot be suspended, the limit
  ;;; findall/3 has for the same reason: a builtin cannot hand a
  ;;; continuation back to the engine that called it. Its limits, its trace
  ;;; and its clock are the caller's, as findall/3's are; its root is
  ;;; '$c_call_prolog'/0, the frame swipl's C runs it from, which an unknown
  ;;; procedure there names. HOLD names NHOLD cells the caller reads after
  ;;; it, told to the collector, which may then run; with none it does not.
  ;;; KEEP keeps the goal's bindings (with_output_to/2's once/1); else the
  ;;; machine is put back where it stood (`~@''s, swipl's
  ;;; PL_rewind_foreign_frame()). NODEBUG runs it untraced (3.54.0, a
  ;;; portray goal's, swipl's PL_Q_NODEBUG).
  ;;;
  ;;; Answers 1, the goal succeeded; 0, it failed; 2, it threw, the ball in
  ;;; BL for the caller to raise again; -1, the run ended with no ball; 3,
  ;;; the capture went wrong, *WHY saying how; 4, memory was refused.
  ;;; Whatever the goal wrote -- before it failed or threw too -- is put in
  ;;; OUT, and fd 1 is the console's again whatever the answer.
  (static)
  (func coco_out_capture_run ((coco_engine * e) (size_t goal) (size_t * hold) (size_t nhold)
                              (int keep) (int nodebug) (coco_strbuf * out) (coco_fmt_ball * bl)
                              (const char ** why)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (coco_engine sub)
              (FILE * tmp . nil) (int saved . -1) (int rc . 0) (int ans . 0) (i64 colsaved . 0)
              (size_t tmark . #'($ (cof m) trail_len))
              (size_t hmark . #'($ (cof m) heap_len)))
          (set tmp (tmpfile))
          (if (== tmp nil) (block (set (cof why) "cannot open a temporary file") (return 3)))
          (fflush stdout)
          (set saved (dup 1))
          (if (< saved 0)
              (block (fclose tmp) (set (cof why) "cannot save stdout") (return 3)))
          (if (< (dup2 (fileno tmp) 1) 0)
              (block (close saved) (fclose tmp) (set (cof why) "cannot redirect stdout") (return 3)))
          (set colsaved (coco_out_capture_begin))

          (coco_engine_init (aof sub) m st)
          ;; narrowed after the ask, which leaves the limits alone, so that a
          ;; clock by predicate can name the first goal (1.15.0)
          (coco_engine_ask (aof sub) goal)
          (set ($ sub rootn) 4)
          (coco_limit_narrow e (aof sub))
          ;; the trace follows the proof inside, depth and all (1.10.17),
          ;; but for NODEBUG's goal, a portray goal's (3.54.0), which swipl
          ;; runs with PL_Q_NODEBUG and the tracer never shows
          (if (not nodebug)
              (block (set ($ sub trace) (-> e trace))
                     (set ($ sub trace_depth) (-> e trace_depth))
                     (set ($ sub trace_goal) (-> e trace_goal))
                     (coco_trace_inner e (aof sub) 1))
            ;; a new engine traces as the process does (`coco_trace_default')
            (set ($ sub trace) 0))
          ;; the marks the machine is wound back to go with the inner
          ;; engine, where the collector keeps them true (1.9.4)
          (let ((size_t * holdp . hold) (size_t nh . nhold) (int held . 0))
            (if (> nhold 0) (set held (coco_heap_root_push m (aof holdp) (aof nh))))
            (set ($ sub ptrail) tmark)
            (set ($ sub pheap) hmark)
            (set ($ sub gc) (? (and held (-> e gc)) 1 0))
            (let ((size_t gsaved . #'(coco_gc_nested_begin m hmark)))
              (set rc (coco_engine_next (aof sub)))
              (coco_gc_nested_end m gsaved))
            (if held (coco_heap_root_pop m)))
          ;; a window's clock: the time from here is the caller's (1.13.3)
          (if (-> e tclock) (coco_clock_back e))
          (set (-> e steps) (+ (-> e steps) ($ sub steps)))
          (set (-> e frees) (+ (-> e frees) ($ sub frees)))
          (set ans (? (== rc 1) 1 (? (== rc 0) 0 -1)))
          ;; THE BALL, read before `coco_engine_free' memsets the engine: a
          ;; sub-engine has a choice stack of its own, so a throw inside finds
          ;; no catch there, and is raised again by the caller (1.2.12)
          (if (== rc -1)
              (block (snprintf (-> e err) 512 "%s" ($ sub err))
                     (if ($ sub has_ball)
                         (block (set ans 2)
                                (set (-> bl cell) ($ sub ball_cell))
                                (set (-> bl size) ($ sub ball_size))
                                (set (-> bl st) ($ sub ball_st))
                                (set (-> bl mark) ($ sub ball_mark))))))
          ;; one solution, and what the goal left is cut while the output is
          ;; still captured: a cleanup's output goes in the text (3.1.0)
          (if (== rc 1) (coco_engine_cut (aof sub)))
          (set tmark ($ sub ptrail))
          (set hmark ($ sub pheap))
          (coco_engine_free (aof sub))

          ;; PUT STDOUT BACK BEFORE ANYTHING ELSE, whatever happened: an early
          ;; return from here on would leave the process writing into a file
          ;; nobody will ever read
          (fflush stdout)
          (dup2 saved 1)
          (close saved)
          (coco_out_capture_end colsaved)

          (if (not keep)
              (block (coco_undo_to m tmark)
                     (set ($ (cof m) heap_len) hmark)))

          ;; read back whole, its length asked first: read a chunk at a time,
          ;; the read that finds the end cost with_output_to/2 a call of
          ;; read(2) and 108 instructions more. An empty buffer is made to
          ;; the text's measure, the spare byte `coco_sb_room' keeps with it,
          ;; as 3.33.0's was: realloc(3) of nothing is malloc(3) and 26
          ;; instructions more
          (fflush tmp)
          (fseek tmp 0 SEEK_END)
          (let ((long len . #'(ftell tmp)))
            (if (> len 0)
                (block (if (== (-> out cap) 0)
                           (block (set (-> out s) (cast (char *) (malloc (+ (cast size_t len) 2))))
                                  (if (!= (-> out s) nil) (set (-> out cap) (+ (cast size_t len) 2)))))
                       (if (not (coco_sb_room out (cast size_t len)))
                           (block (fclose tmp) (return 4)))
                       (rewind tmp)
                       (if (!= (fread (+ (-> out s) (-> out len)) 1 (cast size_t len) tmp)
                               (cast size_t len))
                           (block (fclose tmp) (set (cof why) "cannot read back the output")
                                  (return 3)))
                       (set (-> out len) (+ (-> out len) (cast size_t len)))
                       (set (nth (-> out len) (-> out s)) (cast char 0)))))
          (fclose tmp)
          (return ans)))

  ;;; ---- the portray hook -------------------------------------------------
  ;;;
  ;;; PORTRAY/1 AND PORTRAY_GOAL(G) AS SWIPL'S WRITER ASKS THEM (3.54.0,
  ;;; pl-write.c's callPortray()), installed as the writer's
  ;;; `coco_portray_hook' and asked of each term but a variable of a write
  ;;; in mode 8192, the term first (`coco_write_ask'). The goal is
  ;;; portray(T), or call(G, T, Opts) with Opts the write's options less
  ;;; every priority(_) and priority(PREC) after them, PREC the priority T
  ;;; stands at; it runs once, untraced, its output captured as
  ;;; with_output_to/2's is (`coco_out_capture_run'), its bindings undone and
  ;;; its other work kept, and the collector off: the writer holds cells
  ;;; across it. The writer's own state is put aside for the goal's writes
  ;;; and back after, so that their variable names, their depth limit and
  ;;; their priority are their own and the write's stay its own. What the
  ;;; goal wrote goes on B whatever its answer -- 1 it portrayed T, 0 it
  ;;; failed, -1 it threw or ended the run: the write stops where its text
  ;;; ends, and the ball is kept on the machine for the builtin
  ;;; (`coco_portray_take'). A goal's text at B's start is the first token
  ;;; there (`wpfirst'), with no space before it, as none goes before a
  ;;; write of swipl's.

  ;;; call/3's options: the write's but priority(_), then priority(PREC)
  (static)
  (func coco_portray_opts ((coco_engine * e) (size_t opts) (int prec)) (out size_t)
        (let ((coco_machine * m . #'(coco_m_machine e)) (size_t * v . nil) (size_t n . 0)
              (size_t l . #'(coco_cons m (coco_make1 m "priority" (coco_new_int m (cast i64 prec)))
                                       (coco_new_nil m))))
          (if (coco_m_list_array e opts (aof v) (aof n))
              (while (> n 0)
                (set n (- n 1))
                (let ((size_t o . #'(coco_deref m (nth n v))))
                  (if (not (and (and (coco_is_callable m o) (== (coco_arity m o) 1))
                                (== 0 (strcmp (coco_atom_name m (coco_name_of m o)) "priority"))))
                      (set l (coco_cons m o l))))))
          (free v)
          (return l)))

  (static)
  (func coco_portray_call ((coco_machine * m) (coco_strbuf * b) (size_t t) (int prec)) (out int)
        (let ((coco_engine * e . #'(cast (coco_engine *) (-> m eng))))
          (if (== e nil) (return 0))
          ;; no deeper than swipl's MAX_PORTRAY_NESTING, 100: past it the
          ;; innermost write raises resource_error(portray_nesting)
          (if (>= (-> m wpnest) 100)
              (block (set (-> m wpstate) 4) (set (-> m wpstop) 1)
                     (set (-> m wpcutbuf) (cast (void *) b)) (set (-> m wpcut) (-> b len))
                     (return -1)))
          (let ((size_t mark . #'(-> m heap_len)) (size_t goal . 0) (size_t args [3])
                (coco_strbuf out) (coco_fmt_ball bl) (const char * why . "") (int rc . 0)
                (u32 sdeep . #'(-> m wdeep)) (int scyc . #'(-> m wcyc)) (int sprec . #'(-> m wprec))
                (i64 smax . #'(-> m wmax)) (size_t * scells . #'(-> m wcells))
                (u64 * snames . #'(-> m wnames)) (size_t snw . #'(-> m nwnames))
                (void * scanon . #'(-> m wcanon)) (void * sfirst . #'(-> m wpfirst))
                (size_t sgoal . #'(-> m wpgoal)) (size_t sopts . #'(-> m wpopts)))
            (if (!= sgoal 0)
                (block (set (nth 0 args) sgoal) (set (nth 1 args) t)
                       (set (nth 2 args) (coco_portray_opts e sopts prec))
                       (set goal (coco_make m "call" 3 args)))
              (set goal (coco_make1 m "portray" t)))
            (set (-> m wdeep) 1024) (set (-> m wcyc) 0) (set (-> m wprec) 0) (set (-> m wmax) 0)
            (set (-> m wcells) nil) (set (-> m wnames) nil) (set (-> m nwnames) 0)
            (set (-> m wcanon) nil) (set (-> m wpfirst) nil) (set (-> m wpgoal) 0) (set (-> m wpopts) 0)
            (coco_sb_init (aof out))
            (set (-> m wpnest) (+ (-> m wpnest) 1))
            (set rc (coco_out_capture_run e goal nil 0 0 1 (aof out) (aof bl) (aof why)))
            (set (-> m wpnest) (- (-> m wpnest) 1))
            (set (-> m wdeep) sdeep) (set (-> m wcyc) scyc) (set (-> m wprec) sprec) (set (-> m wmax) smax)
            (set (-> m wcells) scells) (set (-> m wnames) snames) (set (-> m nwnames) snw)
            (set (-> m wcanon) scanon) (set (-> m wpfirst) sfirst) (set (-> m wpgoal) sgoal)
            (set (-> m wpopts) sopts)
            ;; the goal's own cells: the capture wound the heap back to where
            ;; it began, which is above them
            (if (<= mark (-> m heap_len)) (set (-> m heap_len) mark))
            (if (and (!= ($ out s) nil) (> ($ out len) 0))
                (block (if (== (-> b len) 0) (set (-> m wpfirst) (cast (void *) b)))
                       ;; no gap before it where a goal that failed left its
                       ;; text (3.55.0)
                       (if (and (== (-> m wpgapb) (cast (void *) b)) (== (-> m wpgapq) (-> b len)))
                           (set (-> m wpgapb) nil))
                       (coco_sb_put_len b ($ out s) ($ out len))))
            (coco_sb_free (aof out))
            (if (== rc 1) (return 1))
            (if (== rc 0) (return 0))
            ;; it threw (1), ended the run with no ball (2), or no capture
            ;; could be made (3): the write stops here
            (set (-> m wpstate) (? (== rc 2) 1 (? (== rc -1) 2 3)))
            (if (== rc 2)
                (block (set (-> m wpb_cell) ($ bl cell)) (set (-> m wpb_size) ($ bl size))
                       (set (-> m wpb_st) ($ bl st)) (set (-> m wpb_mark) ($ bl mark))))
            (set (-> m wpstop) 1)
            (set (-> m wpcutbuf) (cast (void *) b))
            (set (-> m wpcut) (-> b len))
            (return -1))))

  ;;; What a portrayed write left for its builtin (3.54.0): 0 nothing, 1 a
  ;;; ball (moved to BL, for `coco_fmt_rethrow'), 2 the run ended, 3 no
  ;;; capture could be made, 4 the goals nested too deep; the machine's
  ;;; state cleared
  (static)
  (func coco_portray_take ((coco_machine * m) (coco_fmt_ball * bl)) (out int)
        (let ((int s . #'(-> m wpstate)))
          (if (== s 1)
              (block (set (-> bl cell) (-> m wpb_cell)) (set (-> bl size) (-> m wpb_size))
                     (set (-> bl st) (-> m wpb_st)) (set (-> bl mark) (-> m wpb_mark))))
          (set (-> m wpstate) 0)
          (return s)))

  ;;; ... AND FORMAT'S END FOR IT (3.54.0): a ball raised again as a `~@'
  ;;; goal's is (kind 10), a run that ended as one that ended (11), and no
  ;;; capture as no capture (12), each with what came before put out
  (static)
  (func coco_fmt_portray_fail ((coco_machine * m) (coco_fmt_ball * ball) (char * err)
                               (size_t errlen) (int * fkind)) (out int)
        (let ((int s . #'(coco_portray_take m ball)))
          (return (coco_fmt_fail err errlen fkind (? (== s 1) 10 (? (== s 2) 11 (? (== s 4) 13 12)))
                                 (? (== s 3) "cannot capture a portray goal's output" "")))))

  ;;; ... AND A WRITE BUILTIN'S, print/1's and write_term/2's (3.54.0), once
  ;;; it has put out what came before: the ball raised again in its engine,
  ;;; where the catch frames are, a run that ended ended
  (static)
  (func coco_portray_after ((coco_engine * e)) (out int)
        (let ((coco_fmt_ball bl) (int s . #'(coco_portray_take (coco_m_machine e) (aof bl))))
          (if (== s 0) (return 1))
          (if (== s 1) (return (coco_fmt_rethrow e (aof bl))))
          (if (== s 2) (return -1))
          (if (== s 4) (return (coco_m_resource_error e "portray_nesting")))
          (return (coco_m_error e "print/1" "cannot capture a portray goal's output"))))

  ;;; THE TRACER'S TEXT OF A GOAL (3.54.0, swipl's debugger, which writes a
  ;;; frame's goal with `~p'), installed as the engine's
  ;;; `coco_trace_text_hook': print/1's, portray/1 asked where the program
  ;;; has a clause for it, its goals untraced as print/1's are. A portray
  ;;; goal that threw cuts the line where it threw, as swipl's port line is
  ;;; cut, and its ball is given back unraised, where swipl's goes up into
  ;;; the program at a later port (COMPAT.md)
  (func coco_b_trace_text ((coco_engine * e) (coco_strbuf * b) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (coco_fmt_ball bl))
          (if (not (coco_portray_defined e)) (return (coco_write_print m b g)))
          (coco_write_portrayed m b g 8281 1)
          (if (== (coco_portray_take m (aof bl)) 1)
              (let ((coco_store * st . #'(-> e st))
                    (coco_store * bst . #'(? (== ($ bl st) nil) st (cast (coco_store *) ($ bl st)))))
                (if (== bst st)
                    (set (-> st dead) (+ (-> st dead) ($ bl size)))
                  (block (set (-> bst len) ($ bl mark))
                         (coco_store_shrink_empty bst)))))
          (return 1)))

  ;;; Builds the whole of one format into B. Answers 1, or 0 with what went
  ;;; wrong in *FKIND (above) -- so that every way of going wrong is reported
  ;;; the same way whichever of the three arities was called. START is the
  ;;; column the sink stands at before anything is built (3.33.0; through
  ;;; 3.32.0 whether a line was open there, 2.16.0): `~N' writes a newline
  ;;; only where the column is not 0, and the column stops reckon from it.
  ;;; The text goes to O: B, or the segment held since a fill point. BALL
  ;;; keeps what a `~@' goal threw (kind 10).
  (static)
  (func coco_fmt_build ((coco_engine * e) (const char * f) (const size_t * items)
                        (size_t n) (coco_strbuf * b) (char * err) (size_t errlen) (i64 start)
                        (int * fkind) (int * fdir) (size_t * fbad) (coco_fmt_ball * ball))
        (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (size_t ai . 0) (size_t i . 0)
              (size_t flen . #'(strlen f))
              ;; its scalars and its segment set, and its fill points and
              ;; writers read only below `rn' and `nw': zeroed whole, its
              ;; 2 600 bytes cost every format a memset
              (defer () coco_fmt_cols_free) (coco_fmt_cols cs0)
              (coco_fmt_cols * cs . #'(aof cs0)) (coco_strbuf * o . b))
          (coco_sb_init (aof (-> cs pb)))
          (set (-> cs rn) 0)
          (set (-> cs stop) 0)
          (set (-> cs col) start)
          (set (-> cs slp) start)
          (set (-> cs bdone) (-> b len))
          (set (-> cs cdone) (-> b len))
          (set (-> cs chars) (-> m text_chars))
          (set (-> cs on) 0)
          (set (-> cs nw) 0)
          (while (< i flen)
            ;; 126 is `~'
            (if (!= (nth i f) 126)
                (block (if (not (coco_sb_putc o (nth i f)))
                           (return (coco_fmt_fail err errlen fkind 6 "")))
                       (set i (+ i 1))
                       continue))
            (set i (+ i 1))
            (let ((long num . 0) (int have . 0) (int colon . 0) (char d))
              (cond
                ;; 42 `*': the count is the next argument, an integer of 0 or
                ;; more that a C int holds (swipl's PL_get_integer())
                ((== (nth i f) 42)
                 (let ((size_t a . 0) (i64 v . 0))
                   (if (not (coco_fmt_arg items n (aof ai) (aof a)))
                       (return (coco_fmt_fail err errlen fkind 1 "not enough arguments")))
                   (if (or (or (not (coco_m_int e a (aof v))) (< v 0)) (> v 2147483647))
                       (return (coco_fmt_fail err errlen fkind 1
                                              "no or negative integer for `*' argument")))
                   (set num (cast long v)) (set have 1) (set i (+ i 1))))
                ;; 96 the backquote: the next character is the argument, a fill
                ((and (== (nth i f) 96) (< (+ i 1) flen))
                 (let ((size_t at . #'(+ i 1)))
                   (set num (cast long (? (-> m text_chars)
                                          (coco_utf8_get f flen (aof at))
                                          (bitand (cast long (nth at f)) 255))))
                   (if (not (-> m text_chars)) (set at (+ at 1)))
                   (set have 1) (set i at)))
                ;; digits, held to a C int as swipl's are (3.33.0)
                (#t
                 (while (and (>= (nth i f) 48) (<= (nth i f) 57))
                   (set num (+ (* num 10) (cast long (- (nth i f) 48))))
                   (if (> num 2147483647)
                       (return (coco_fmt_fail err errlen fkind 1 "argument overflow")))
                   (set have 1)
                   (set i (+ i 1)))))
              ;; 58 `:': the locale's, which cocolog has none of, and a
              ;; column stop's new line (3.33.0)
              (if (== (nth i f) 58) (block (set colon 1) (set i (+ i 1))))
              (set d (nth i f))
              (if (== d 0)
                  (block (set (cof fbad) (coco_new_atom m ""))
                         (return (coco_fmt_fail err errlen fkind 3 ""))))
              (set i (+ i 1))

              ;; 126 `~~', 110 `~n', 105 `~i'
              (if (== d 126)
                  (block (coco_sb_putc o (cast char 126)) continue))
              (if (== d 110)
                  (block (for ((long k . 0)) (< k (? have num 1)) ((++ k))
                           (coco_sb_putc o (cast char 10)))
                         continue))
              ;; 78 `~N' (2.16.0): its count of newlines, one fewer at
              ;; column 0 -- swipl's, whose `format("~Na~N~Nb~n")' is `a', a
              ;; newline, `b' and a newline, and whose column is format's
              ;; own (3.33.0): after a return, or a stop the text passed
              ;; back to 0, no newline. Through 3.32.0 the last character
              ;; written was asked, a newline or not
              (if (== d 78)
                  (let ((long k . #'(? have num 1)))
                    (coco-fmt-now cs o)
                    (if (== (-> cs col) 0) (set k (- k 1)))
                    (while (> k 0)
                      (coco_sb_putc o (cast char 10))
                      (set k (- k 1)))
                    continue))
              (if (== d 105)
                  (let ((size_t a . 0))
                    (if (not (coco_fmt_arg items n (aof ai) (aof a)))
                        (return (coco_fmt_fail err errlen fkind 1 "not enough arguments")))
                    continue))
              ;; 116 `~t' (3.33.0): a fill point where the text stands, its
              ;; character the argument -- digits, `*' or a backquote's -- or
              ;; a space; the first holds what follows as a segment
              (if (== d 116)
                  (block
                    (if (>= (-> cs rn) 100)
                        (return (coco_fmt_fail err errlen fkind 1 "Too many tab stops")))
                    (if (== (-> cs rn) 0)
                        (block (coco-fmt-now cs o)
                               (set o (aof (-> cs pb)))
                               (set (-> cs cdone) 0)))
                    (set (nth (-> cs rn) (-> cs where)) (-> o len))
                    (set (nth (-> cs rn) (-> cs pad)) (? have num 32))
                    (set (nth (-> cs rn) (-> cs size)) 0)
                    (set (-> cs rn) (+ (-> cs rn) 1))
                    continue))
              ;; 124 `~|', 43 `~+' (3.33.0): a column stop
              (if (or (== d 124) (== d 43))
                  (block
                    (if (not (coco_fmt_stop cs b (aof o) (== d 43) have num colon))
                        (return (coco_fmt_fail err errlen fkind 6 "")))
                    continue))
              ;; 64 `~@' (3.34.0): the next argument called once, as swipl's
              ;; -- its output put in where the directive stands, a writer's
              ;; (prepare_sub_format() and end_sub_format()), its bindings
              ;; undone (PL_rewind_foreign_frame()); its failure fails the
              ;; format and its ball is raised again, each once the text
              ;; before it is out (`coco_fmt_do'). What it wrote before it
              ;; failed or threw stays where it went to the stream, and is
              ;; dropped where it went to a string: where a fill point was
              ;; held, or the column was not the stream's
              (if (== d 64)
                  (let ((size_t a . 0) (int grc . 0) (i64 wc0 . 0) (size_t wfrom . 0)
                        (int wdirect . 0) (const char * why . ""))
                    (if (not (coco_fmt_arg items n (aof ai) (aof a)))
                        (return (coco_fmt_fail err errlen fkind 1 "not enough arguments")))
                    ;; a goal that is no goal is the format's own error,
                    ;; named by the arity called as swipl's names it, and
                    ;; the goal the one swipl's C calls (3.44.0,
                    ;; `coco_c_root'), whose construct's raise is its own
                    (let ((size_t r . #'(coco_c_root m a)) (size_t fm . 0)
                          (const char * op . nil) (u32 opn . 0) (int f . 0))
                      (set f (coco_c_root_fault m a r (aof fm) (aof op) (aof opn)))
                      (if (== f 1)
                          (block (set (cof fdir) (coco_m_raise e fm))
                                 (return (coco_fmt_fail err errlen fkind 5 ""))))
                      (if (== f 2)
                          (block (set (cof fdir) (coco_m_raise_pi e fm "system" op opn))
                                 (return (coco_fmt_fail err errlen fkind 5 ""))))
                      (set a r))
                    (coco-fmt-now cs o)
                    (set wc0 (-> cs col))
                    (set wfrom (-> o len))
                    (if (== (-> cs rn) 0) (coco-fmt-direct cs (-> b s) (-> b len) wc0 wdirect))
                    (set grc (coco_out_capture_run e a nil 0 0 0 o ball (aof why)))
                    (if (== grc 1)
                        (block (set (-> cs col) (coco-fmt-wcol (-> o s) wfrom (-> o len) wc0 wdirect))
                               (set (-> cs cdone) (-> o len))
                               continue))
                    (if (== grc 3) (return (coco_fmt_fail err errlen fkind 12 why)))
                    (if (== grc 4) (return (coco_fmt_fail err errlen fkind 6 "")))
                    (if (not wdirect)
                        (block (set (-> o len) wfrom)
                               (if (!= (-> o s) nil) (set (nth wfrom (-> o s)) (cast char 0)))))
                    (return (coco_fmt_fail err errlen fkind (? (== grc 0) 9 (? (== grc 2) 10 11)) ""))))
              ;; 87 `~W': write_term/2 of two arguments
              (if (== d 87)
                  (let ((size_t a . 0) (size_t opts . 0))
                    (if (< (- n ai) 2)
                        (return (coco_fmt_fail err errlen fkind 1 "not enough arguments")))
                    (coco_fmt_arg items n (aof ai) (aof a))
                    (coco_fmt_arg items n (aof ai) (aof opts))
                    ;; the options checked as write_term/2 checks them, the
                    ;; raise format/3's (3.0.0): `~W' of [quoted(maybe)] is
                    ;; type_error(bool, maybe), an open list instantiation_error,
                    ;; and a cyclic term under cycles(false) domain_error(cyclic_term,
                    ;; T), the text before it put out (3.55.0)
                    (let ((int rc . #'(coco_wt_check e opts a)))
                      (if (!= rc 1)
                          (block (set (cof fdir) rc)
                                 (return (coco_fmt_fail err errlen fkind 5 "")))))
                    (coco-fmt-writer cs b o (coco_wt_put e o a opts))
                    (if (-> m wpstate) (return (coco_fmt_portray_fail m ball err errlen fkind)))
                    continue))

              ;; a directive no format has, by its whole character, refused
              ;; before an argument is taken for it, as swipl's switch is
              (if (== nil (strchr "wqpkascdDIrReEfgG" (cast int d)))
                  (block (set (cof fbad) (coco_fmt_char_atom m (+ f (- i 1)) (- flen (- i 1))))
                         (return (coco_fmt_fail err errlen fkind 3 ""))))

              ;; everything below takes an argument
              (let ((size_t a . 0))
                (if (not (coco_fmt_arg items n (aof ai) (aof a)))
                    (return (coco_fmt_fail err errlen fkind 1 "not enough arguments")))

                ;; 119 `~w', 113 `~q', 112 `~p' -- print/1's, quoted and with
                ;; numbervars, as swipl's `~p' calls print/1 (2.2.4; through
                ;; 2.2.3 it was `~w'); `~w' and `~q' are write/1's and
                ;; writeq/1's, numbervars and all (2.2.5); 107 `~k'
                ;; write_canonical/1's (3.0.0), its names and all (3.1.0);
                ;; each a writer's column (`coco-fmt-writer', 3.33.0)
                ;; `~p' asks portray/1 while the program has a clause for it
                ;; (3.54.0), as swipl's print/1 does, and a portray goal's
                ;; throw ends the format as a `~@' goal's does
                (if (== d 112)
                    (block (coco-fmt-writer cs b o (? (coco_portray_defined e)
                                                      (coco_write_portrayed m o a 8281 1)
                                                      (coco_write_print m o a)))
                           (if (-> m wpstate) (return (coco_fmt_portray_fail m ball err errlen fkind)))
                           continue))
                (if (or (== d 119) (== d 113))
                    (block (coco-fmt-writer cs b o (coco_write_mode m o a (? (== d 113) 25 8) 1))
                           continue))
                (if (== d 107)
                    (block (coco-fmt-writer cs b o (coco_write_canon m o a)) continue))

                ;; 97 `~a', 115 `~s' -- text of any length, read as swipl's
                ;; pl-fmt.c reads it (3.0.0, `coco_tx_get'): `~a' with
                ;; CVT_ATOMIC, `~s' with CVT_LIST|CVT_STRING and then as an
                ;; atom, and anything else format_argument_type(D, A) --
                ;; through 2.16.1 `~s' took a list of codes and characters
                ;; mixed, and both raised `wants text'. `~Ns' writes the first
                ;; N characters (3.0.0). A text with a NUL in it is refused
                ;; too: the sink is a C string.
                (if (or (== d 97) (== d 115))
                    (let ((coco_strbuf tb) (size_t tl . 0))
                      (if (or (not (coco_tx_get e a (? (== d 97) 7 13) (aof tb)))
                              (!= nil (memchr (coco_tx_s (aof tb)) 0 ($ tb len))))
                          (block (coco_sb_free (aof tb))
                                 (set (cof fdir) (cast int d)) (set (cof fbad) a)
                                 (return (coco_fmt_fail err errlen fkind 2 ""))))
                      (set tl ($ tb len))
                      (if (and (== d 115) have)
                          (let ((size_t at . 0) (long k . 0))
                            (while (and (< at tl) (< k num))
                              (if (-> m text_chars)
                                  (coco_utf8_get (coco_tx_s (aof tb)) tl (aof at))
                                  (set at (+ at 1)))
                              (set k (+ k 1)))
                            (set tl at)))
                      (coco_sb_put_len o (coco_tx_s (aof tb)) tl)
                      (coco_sb_free (aof tb))
                      continue))

                ;; 99 `~c' -- a code, NUM times: a byte, or under
                ;; `text_units = characters' a code point's UTF-8 (1.13.0);
                ;; anything but an integer of 0 or more is
                ;; format_argument_type(c, A), and a code past the last
                ;; representation_error(code_point) (3.0.0, swipl's)
                (if (== d 99)
                    (let ((i64 v . 0) (char u [4]) (int ul . 1))
                      (if (or (not (coco_m_int e a (aof v))) (< v 0))
                          (block (set (cof fdir) (cast int d)) (set (cof fbad) a)
                                 (return (coco_fmt_fail err errlen fkind 2 ""))))
                      (if (> v 1114111) (return (coco_fmt_fail err errlen fkind 8 "")))
                      (if (-> m text_chars)
                          (block (set ul (coco_utf8_enc u v))
                                 (if (== ul 0)
                                     (return (coco_fmt_fail err errlen fkind 8 ""))))
                          (set (nth 0 u) (cast char v)))
                      (for ((long k . 0)) (< k (? have num 1)) ((++ k))
                        (coco_sb_put_len o u (cast size_t ul)))
                      continue))

                ;; 100 `~d', 68 `~D', 73 `~I', 114 `~r', 82 `~R': an integer,
                ;; evaluated -- an expression whose value is no integer is
                ;; format_argument_type(D, A), `~d' of 1.5 or of 1r2
                (if (or (or (or (== d 100) (== d 68)) (or (== d 73) (== d 114))) (== d 82))
                    (let ((int isf . 0) (i64 v . 0) (double fv . 0.0)
                          (int rc . #'(coco_fmt_eval e a (aof isf) (aof v) (aof fv))))
                      (if (!= rc 1)
                          (block (set (cof fdir) rc)
                                 (return (coco_fmt_fail err errlen fkind 5 ""))))
                      (if (!= isf 0)
                          (block (set (cof fdir) (cast int d)) (set (cof fbad) a)
                                 (return (coco_fmt_fail err errlen fkind 2 ""))))
                      (cond
                        ((== d 100) (coco_fmt_int o v (? have num 0) 0 0))
                        ;; 44 `,'
                        ((== d 68) (coco_fmt_int o v (? have num 0) 3 44))
                        ;; 95 `_'
                        ((== d 73) (coco_fmt_int o v 0 (cast int (? have num 3)) 95))
                        ;; `~r' and `~R': NUM is the base, 8 by default
                        (#t
                         (let ((char buf [80]) (long base . #'(? have num 8)))
                           (if (or (< base 2) (> base 36))
                               (block (set (cof fbad) (coco_new_int m (cast i64 base)))
                                      (return (coco_fmt_fail err errlen fkind 4 ""))))
                           (coco_fmt_radix v (cast int base) (? (== d 82) 1 0) buf (sizeof buf))
                           (coco_sb_put o buf))))
                      continue))

                ;; 101 `~e', 69 `~E', 102 `~f', 103 `~g', 71 `~G': a number,
                ;; evaluated, written as a double
                (if (or (or (or (== d 101) (== d 69)) (or (== d 102) (== d 103))) (== d 71))
                    (let ((int isf . 0) (i64 iv . 0) (double v . 0.0)
                          (int rc . #'(coco_fmt_eval e a (aof isf) (aof iv) (aof v))))
                      (if (!= rc 1)
                          (block (set (cof fdir) rc)
                                 (return (coco_fmt_fail err errlen fkind 5 ""))))
                      (if (== isf 0) (set v (cast double iv)))
                      (if (== isf 2)
                          (set v (/ (cast double (-> m arith_n)) (cast double (-> m arith_d)))))
                      (if (not (coco_fmt_float o v (? have num 6) d))
                          (return (coco_fmt_fail err errlen fkind 6 "")))
                      continue)))))
          ;; a segment no stop closed is put out as it stands, its fill
          ;; points empty, before an argument left over is refused
          (if (> (-> cs rn) 0)
              (if (not (coco_fmt_emit cs b))
                  (return (coco_fmt_fail err errlen fkind 6 ""))))
          ;; an argument no directive took
          (if (< ai n)
              (return (coco_fmt_fail err errlen fkind 1 "too many arguments")))
          (return 1)))

  ;;; What went wrong in a format (`coco_fmt_fail''s kinds) raised.
  (static)
  (func coco_fmt_raise ((coco_engine * e) (int kind) (int dir) (size_t bad) (const char * err))
        (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (char dn [2]))
          (set (nth 0 dn) (cast char dir))
          (set (nth 1 dn) (cast char 0))
          (if (== kind 1)
              (return (coco_m_raise e (coco_make1 m "format" (coco_new_atom m err)))))
          (if (== kind 2)
              (return (coco_m_raise e (coco_make2 m "format_argument_type"
                                                  (coco_new_atom m dn) bad))))
          ;; an unknown directive names `format/2', bare, whichever arity
          ;; raised it, as swipl's does
          (if (== kind 3)
              (return (coco_m_raise_pi e (coco_make2 m "existence_error"
                                                     (coco_new_atom m "format_character") bad)
                                       "" "format" 2)))
          (if (== kind 4) (return (coco_m_domain_error e "radix" bad)))
          (if (== kind 5) (return dir))
          (if (== kind 6) (return (coco_m_resource_error e "memory")))
          (if (== kind 8)
              (return (coco_m_raise e (coco_make1 m "representation_error"
                                                  (coco_new_atom m "code_point")))))
          (if (== kind 12) (return (coco_m_error e "format/2" err)))
          ;; portray goals nested past swipl's limit (3.54.0)
          (if (== kind 13) (return (coco_m_resource_error e "portray_nesting")))
          (return (coco_m_error e err nil))))

  ;;; The arguments, as an array. `format("~w", foo)' is legal and means one
  ;;; argument, so anything that is not a proper list is taken for a single
  ;;; term -- SWI's rule, and the reason `format("~w", [1,2])' means two
  ;;; arguments while `format("~w", [[1,2]])' means one.
  (static)
  (func coco_fmt_args ((coco_engine * e) (size_t t) (size_t ** items) (size_t * n)
                       (size_t * one)) (out int)
        (if (coco_m_list_array e t items n) (return 1))
        (set (nth 0 one) t)
        (set (cof items) one)
        (set (cof n) 1)
        (return 0))          ; 0 means "do not free it"

  ;;; SINK CHECKED BEFORE ANYTHING IS DONE (3.0.0), as swipl's format/3 and
  ;;; with_output_to/2 check it: unbound instantiation_error; a stream a
  ;;; module owns (library(stream)'s alias or '$stream'(N), asked as `~N'
  ;;; asks, `coco_m_sink_column_call') or user_output or user_error taken; any
  ;;; other atom existence_error(stream, S); atom(_), string(_) and codes
  ;;; and chars of one or two arguments taken; user_input
  ;;; permission_error(output, stream, user_input) (3.16.0); anything else
  ;;; type_error(output, S). Through 2.16 only the delivery asked, after the
  ;;; work, and named each domain_error(output_sink, S).
  (static)
  (func coco_sink_check ((coco_engine * e) (size_t sink)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (size_t d . 0))
          (if (== sink (cast size_t -1)) (return 1))
          (set d (coco_deref m sink))
          (if (coco-tag-is REF (nth d (-> m heap))) (return (coco_m_instantiation_error e)))
          (if (>= (coco_m_sink_column_call e d) 0) (return 1))
          (if (coco-tag-is ATOM (nth d (-> m heap)))
              (let ((const char * nm . #'(coco_atom_name m (coco_name_of m d))))
                (if (or (== 0 (strcmp nm "user_output")) (== 0 (strcmp nm "user_error")))
                    (return 1))
                ;; a stream that takes no output (3.16.0, swipl's)
                (if (== 0 (strcmp nm "user_input"))
                    (return (coco_m_permission_error e "output" "stream" d)))
                (return (coco_m_existence_error e "stream" d))))
          (if (coco-tag-is FUN (nth d (-> m heap)))
              (let ((const char * nm . #'(coco_atom_name m (coco_name_of m d)))
                    (u32 ar . #'(coco_arity m d)))
                (if (and (== ar 1) (or (== 0 (strcmp nm "atom")) (== 0 (strcmp nm "string"))))
                    (return 1))
                (if (and (or (== ar 1) (== ar 2))
                         (or (== 0 (strcmp nm "codes")) (== 0 (strcmp nm "chars"))))
                    (return 1))))
          (return (coco_m_type_error e "output" d))))

  ;;; WHETHER SINK IS A TERM TO UNIFY (3.34.0): atom(A), string(S), and codes
  ;;; and chars of one or two arguments, as `coco_sink_check' took them --
  ;;; where everything else is a stream, the console's among them.
  (static)
  (func coco_fmt_term_sink ((coco_engine * e) (size_t sink)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (size_t d . 0))
          (if (== sink (cast size_t -1)) (return 0))
          (set d (coco_deref m sink))
          (if (not (coco-tag-is FUN (nth d (-> m heap)))) (return 0))
          (let ((const char * nm . #'(coco_atom_name m (coco_name_of m d))))
            (return (or (or (== 0 (strcmp nm "atom")) (== 0 (strcmp nm "string")))
                        (or (== 0 (strcmp nm "codes")) (== 0 (strcmp nm "chars"))))))))

  ;;; Puts TEXT where SINK says. SINK is `(cast size_t -1)' for stdout -- what
  ;;; format/1,2 pass -- and otherwise one of the
  ;;; forms `format/3' and `with_output_to/2' share -- a stream by name, or a
  ;;; term to unify with the text.
  ;;;
  ;;; `codes(H, T)' and `chars(H, T)' ask for a DIFFERENCE list: H is the text
  ;;; followed by T, not by `[]'. That is what makes the four `format/3' calls
  ;;; in SWI's dcg/basics work as grammar bodies -- each appends to whatever is
  ;;; still to come, which is exactly what a DCG body has to do.
  ;;;
  ;;; A SINK A MODULE OWNS IS ASKED ABOUT FIRST: library(stream) installs a
  ;;; hook (`coco_m_sink_install') and takes '$stream'(N), a stream's alias,
  ;;; and user_output while a file is the current output. It answers 0 for
  ;;; everything else, so with no module loaded nothing below has moved.
  (static)
  (func coco_sink_deliver ((coco_engine * e) (size_t sink) (const char * out)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)))
          ;; STDOUT IS SIZE_MAX, AND WAS 0 UNTIL 1.8.34 -- but 0 is a heap cell
          ;; like any other, the first term the reader built, so a query whose
          ;; first term was its sink atom (`format(nosuch_sink, x, [])') took
          ;; this path and printed where it should have raised, and an alias
          ;; there would have gone to stdout. No cell index reaches SIZE_MAX.
          (if (== sink (cast size_t -1)) (block (coco_out_puts stdout out) (return 1)))
          (let ((int hooked . #'(coco_m_sink_call e sink out (strlen out))))
            (if (!= hooked 0) (return hooked)))

          (let ((size_t d . #'(coco_deref m sink)))
            (if (not (coco_is_callable m d))
                (return (coco_m_domain_error e "output_sink" sink)))

            ;; a stream by name
            (if (== (coco_arity m d) 0)
                (let ((const char * nm . #'(coco_atom_name m (coco_name_of m d))))
                  (if (== 0 (strcmp nm "user_output")) (block (coco_out_puts stdout out) (return 1)))
                  (if (== 0 (strcmp nm "user_error")) (block (coco_out_puts stderr out) (return 1)))
                  (return (coco_m_domain_error e "output_sink" sink))))

            (let ((const char * nm . #'(coco_atom_name m (coco_name_of m d)))
                  (u32 ar . #'(coco_arity m d))
                  (int as_chars . 0) (int as_atom . 0) (int as_string . 0))
              (if (== 0 (strcmp nm "atom")) (set as_atom 1))
              (if (== 0 (strcmp nm "chars")) (set as_chars 1))
              ;; `string(S)' IS A SINK NOW, and it was a domain_error for as
              ;; long as there was no string type to put anything in. SWI's
              ;; `format(string(S), ...)' is the ordinary way to build one, so
              ;; leaving it refused would have meant a type you can make with
              ;; twelve predicates and cannot format into.
              (if (== 0 (strcmp nm "string")) (set as_string 1))
              (if (and (and (not as_atom) (not as_chars))
                       (and (not as_string) (!= 0 (strcmp nm "codes"))))
                  (return (coco_m_domain_error e "output_sink" sink)))
              (if (or (< ar 1) (> ar 2))
                  (return (coco_m_domain_error e "output_sink" sink)))
              ;; `atom(A, B)' is not a thing -- only the LIST sinks take a
              ;; tail, because a difference list is the only one of the four
              ;; that has anywhere to put it.
              (if (and (or as_atom as_string) (== ar 2))
                  (return (coco_m_domain_error e "output_sink" sink)))

              (if as_atom
                  (return (? (coco_m_unify_atom e (coco_arg m d 0) out) 1 0)))
              (if as_string
                  (return (? (coco_m_unify_string e (coco_arg m d 0) out (strlen out)) 1 0)))

              (let ((size_t tail . #'(? (== ar 2) (coco_arg m d 1) (coco_m_nil e)))
                    (size_t acc) (size_t len . #'(strlen out)))
                ;; characters under `text_units = characters' (1.13.0)
                (if (-> m text_chars)
                    (return (? (coco_m_unify e (coco_arg m d 0)
                                             (coco_text_list m out len as_chars tail))
                               1 0)))
                (set acc tail)
                (while (> len 0)
                  (set len (- len 1))
                  (let ((size_t c . #'(? as_chars
                                         (coco_fmt_one_char e (nth len out))
                                         (coco_new_int m (cast i64 (bitand (cast int (nth len out)) 255))))))
                    (set acc (coco_m_cons e c acc))))
                (return (? (coco_m_unify e (coco_arg m d 0) acc) 1 0)))))))

  ;;; THE COLUMN SINK STANDS AT (3.33.0; 2.16.0 whether a line was open
  ;;; there), where `~N' and the column stops begin, as swipl's begin at the
  ;;; stream's linepos: stdout's and stderr's the console's
  ;;; (`coco_out_column', a capture's own), a module's sink as the module
  ;;; answers (`coco_m_sink_column_call': library(stream)'s files), and a
  ;;; term sink -- atom(A), codes(C), ... -- 0, as swipl begins each of
  ;;; those at column 0. A sink that is no sink is format's to refuse.
  (static)
  (func coco_fmt_start ((coco_engine * e) (size_t sink)) (out i64)
        (let ((coco_machine * m . #'(coco_m_machine e)) (size_t d . 0) (int h . 0))
          (if (== sink (cast size_t -1)) (return (coco_out_column stdout)))
          (set h (coco_m_sink_column_call e sink))
          (if (>= h 0) (return (cast i64 h)))
          (set d (coco_deref m sink))
          (if (and (coco_is_callable m d) (== (coco_arity m d) 0))
              (let ((const char * nm . #'(coco_atom_name m (coco_name_of m d))))
                (if (== 0 (strcmp nm "user_output")) (return (coco_out_column stdout)))
                (if (== 0 (strcmp nm "user_error")) (return (coco_out_column stderr)))))
          (return 0)))

  ;;; Shared by all three arities. SINK is `(cast size_t -1)' for stdout.
  (static)
  (func coco_fmt_do ((coco_engine * e) (size_t sink) (size_t fmt) (size_t argt))
        (out int)
        (let ((coco_strbuf fb) (char err [192])
              (coco_strbuf b) (size_t * items . nil) (size_t n . 0)
              (size_t one [1]) (int owned . 0) (int ok . 0)
              (int fkind . 0) (int fdir . 0) (size_t fbad . 0) (coco_fmt_ball ball)
              (int sk . #'(coco_sink_check e sink)))

          (if (!= sk 1) (return sk))
          ;; the format itself is text of any length, as swipl reads it
          ;; (3.0.0): an atom, a string or a list of codes or of characters,
          ;; and anything else -- a number, a list of the two mixed --
          ;; type_error(text, F). Both are named `format/3', bare, whichever
          ;; arity raised them: swipl's format/1,2 are format/3 over the
          ;; current output, and its PL_error() names the predicate.
          (if (coco_m_is_var e fmt)
              (return (coco_m_raise_pi e (coco_new_atom (coco_m_machine e) "instantiation_error")
                                       "" "format" 3)))
          (if (not (coco_tx_get e fmt 13 (aof fb)))
              (let ((coco_machine * m . #'(coco_m_machine e)))
                (return (coco_m_raise_pi e (coco_make2 m "type_error" (coco_new_atom m "text") fmt)
                                         "" "format" 3))))

          (set owned (coco_fmt_args e argt (aof items) (aof n) one))
          (coco_sb_init (aof b))
          (set (nth 0 err) (cast char 0))
          (set ok (coco_fmt_build e (coco_tx_s (aof fb)) items n (aof b) err (sizeof err)
                                  (coco_fmt_start e sink) (aof fkind) (aof fdir) (aof fbad)
                                  (aof ball)))
          (coco_sb_free (aof fb))
          (if owned (free items))

          ;; WHAT WAS FORMATTED BEFORE THE ERROR STILL COMES OUT, when the
          ;; sink is a stream. SWI formats straight to the stream and so emits
          ;; everything up to the directive that failed; this builds a buffer
          ;; first, so it has to put the buffer out by hand to behave the same.
          ;; `format("~w ~w", [one])' prints `one ' and then raises, in both,
          ;; to any stream -- user_output, user_error, a library(stream) one
          ;; -- and before a `~@' goal's failure as before its ball (3.34.0;
          ;; through 3.33.0 to format/1,2's console alone). A term sink gets
          ;; nothing: there is no half-built atom to unify.
          (if (not ok)
              (block
               (if (not (coco_fmt_term_sink e sink))
                   (let ((int drc . #'(coco_sink_deliver e sink (? (== ($ b s) nil) "" ($ b s)))))
                     (if (!= drc 1) (block (coco_sb_free (aof b)) (return drc)))))
               (coco_sb_free (aof b))
               (if (== fkind 9) (return 0))
               (if (== fkind 10) (return (coco_fmt_rethrow e (aof ball))))
               (if (== fkind 11) (return -1))
               (return (coco_fmt_raise e fkind fdir fbad err))))

          (let ((int rc . #'(coco_sink_deliver e sink (? (== ($ b s) nil) "" ($ b s)))))
            (coco_sb_free (aof b))
            (return rc))))

  ;;; ---- with_output_to/2 -----------------------------------------------
  ;;;
  ;;; `with_output_to(codes(H, T), write(F))' -- SWI's dcg/basics uses exactly
  ;;; that, once, to render a float. It is also the general answer to "what did
  ;;; this goal print", which nothing else here can ask. The goal runs with
  ;;; its output captured (`coco_out_capture_run', which `~@' shares since
  ;;; 3.34.0), the sink told to the collector, and its text delivered.
  ;;;
  ;;; It is `once/1' and not a generator: the FIRST solution is kept, with its
  ;;; bindings, and the goal is not re-entered. SWI's is semi-deterministic too.
  ;;; A goal that fails fails it, and a ball is raised again here, in the
  ;;; outer engine, once stdout is the console's again -- through 1.2.12 a
  ;;; throw inside ended the query, and the two arms of the test were once
  ;;; the wrong way round, so that `with_output_to(codes(C), fail)' threw the
  ;;; store's cell 0, the first clause of library(files)'s Prolog half.
  (func coco_b_with_output_to ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t goal . #'(coco_m_arg e g 1))
              (size_t hold [1]) (coco_strbuf tb) (coco_fmt_ball ball)
              (const char * why . "") (int rc . 0))
          (set (nth 0 hold) (coco_m_arg e g 0))
          ;; the sink, then the goal, as swipl's (3.0.0): a goal that is no
          ;; goal is this predicate's error, not the inner engine's
          ;; '<meta-call>'/1
          (let ((int sk . #'(coco_sink_check e (nth 0 hold))))
            (if (!= sk 1) (return sk)))
          ;; the goal swipl's C calls (3.44.0, `coco_c_root'): a goal that is
          ;; no goal, its qualifiers off, this predicate's error, and one a
          ;; control construct's predicate raises before it runs that one's
          (let ((size_t r . #'(coco_c_root (coco_m_machine e) goal)) (size_t fm . 0)
                (const char * op . nil) (u32 opn . 0) (int f . 0))
            (set f (coco_c_root_fault (coco_m_machine e) goal r (aof fm) (aof op) (aof opn)))
            (if (== f 1) (return (coco_m_raise_pi e fm "system" "with_output_to" 2)))
            (if (== f 2) (return (coco_m_raise_pi e fm "system" op opn)))
            (set goal r))
          (coco_sb_init (aof tb))
          (set rc (coco_out_capture_run e goal hold 1 1 0 (aof tb) (aof ball) (aof why)))
          (if (!= rc 1)
              (block (coco_sb_free (aof tb))
                     (if (== rc 2) (return (coco_fmt_rethrow e (aof ball))))
                     (if (== rc 3) (return (coco_m_error e "with_output_to/2" why)))
                     (if (== rc 4) (return (coco_m_resource_error e "memory")))
                     (if (== rc -1) (return -1))
                     (return 0)))
          (let ((int out . #'(coco_sink_deliver e (nth 0 hold) (? (== ($ tb s) nil) "" ($ tb s)))))
            (coco_sb_free (aof tb))
            (return out))))

  ;;; `flush_output/0' -- SWI'S, AND IT WAS MISSING. cocolog writes to the
  ;;; literal stdout, which the C library buffers by LINE at a terminal and
  ;;; by BLOCK everywhere else. So a program that prints a marker and then
  ;;; blocks -- a server saying it is listening, a long job saying where it
  ;;; has got to -- prints nothing at all when its output is a pipe or a
  ;;; file, and everything at once when it finally exits.
  ;;;
  ;;; FOUND BY WRITING test/tls.sh. The server printed READY, the harness
  ;;; waited for READY to appear in the log, and the log stayed empty until
  ;;; the server gave up and exited -- at which point the whole transcript
  ;;; arrived, correct and far too late. Interactively it had always
  ;;; worked, because a terminal is line buffered.
  ;;;
  ;;; No argument, because there is one output. When cocolog grows a stream
  ;;; layer this becomes `flush_output/1' with this as its default.
  (func coco_b_flush ((coco_engine * e) (size_t g)) (out int)
        (fflush stdout)
        (return 1))

  (func coco_b_format1 ((coco_engine * e) (size_t g)) (out int)
        (return (coco_fmt_do e (cast size_t -1) (coco_m_arg e g 0) (coco_m_nil e))))

  (func coco_b_format2 ((coco_engine * e) (size_t g)) (out int)
        (return (coco_fmt_do e (cast size_t -1) (coco_m_arg e g 0) (coco_m_arg e g 1))))

  (func coco_b_format3 ((coco_engine * e) (size_t g)) (out int)
        (return (coco_fmt_do e (coco_m_arg e g 0) (coco_m_arg e g 1) (coco_m_arg e g 2))))

  (func coco_b_upcase ((coco_engine * e) (size_t g)) (out int) (return (coco_b_case e g 1)))
  (func coco_b_downcase ((coco_engine * e) (size_t g)) (out int) (return (coco_b_case e g 0)))

  ;;; Both directions: a term written out, or an atom read back in -- of any
  ;;; length (it was a buffer of 8192 bytes through 1.10.5). WHICH WAY IS
  ;;; THE TEXT'S, as SWI decides it (2.15.1): a bound text is read and the
  ;;; term it reads unified with the first argument, whatever that holds, so
  ;;; `term_to_atom(answer(K, E), 'answer(cost,24.0)')' binds K and E and
  ;;; `term_to_atom(f(a), 'f( a )')' is true; an unbound one is written from
  ;;; the term, an unbound term too (its variable's name). Through 2.15.0 a
  ;;; bound TERM was written and the two texts compared, so both of those
  ;;; failed, and two unbound arguments raised type_error(text, _). The
  ;;; text is read as swipl reads it (3.0.0, `coco_tx_term_text'): any text
  ;;; by CVT_ALL and its errors -- term_to_atom(T, 12) is 12 -- one term,
  ;;; layout alone `end_of_file', and a text that reads as no term swipl's
  ;;; syntax_error(operator_expected) or (end_of_clause), where through
  ;;; 2.16.1 it was cocolog_error(`term_to_atom/2 cannot read: ...').
  (func coco_b_term_to_atom ((coco_engine * e) (size_t g)) (out int)
        (return (coco_tx_term_text e g 0)))

  ;;; THE TEXT OF AN ATOMIC T WHERE IT LIVES (3.0.0), for the C halves of
  ;;; sub_atom/5, which '$sub_text_length'/7 has read already: an atom's
  ;;; name or a string's bytes in place, with their length in *N, and a
  ;;; number's writing on B -- which the caller frees, in every case. No
  ;;; copy of an atom or a string: `sub_atom/5''s bound-Sub path asks about
  ;;; every prefix of a long atom (2.12.0). Answers 0 for anything else.
  ;;; Through 2.16.1 anything but an atom went through a buffer of 64
  ;;; bytes, and a string longer than that was type_error(atom, S).
  (static)
  (func coco_b_atomic_text ((coco_engine * e) (size_t t) (coco_strbuf * b)
                            (const char ** s) (size_t * n)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t d . #'(coco_deref m t)))
          (coco_sb_init b)
          (if (and (coco-tag-is ATOM (nth d (-> m heap))) (not (coco_is_nil m d)))
              (block (set (cof s) (coco_atom_name m (coco_name_of m d)))
                     (if (!= n nil) (set (cof n) (strlen (cof s))))
                     (return 1)))
          (let ((size_t sn . 0))
            (if (coco_string_text m d s (aof sn))
                (block (if (!= n nil) (set (cof n) sn)) (return 1))))
          (if (not (coco_tx_get e d 2 b)) (return 0))
          (set (cof s) (coco_tx_s b))
          (if (!= n nil) (set (cof n) ($ (cof b) len)))
          (return 1)))

  ;;; The byte length of the text `atom_length/2' measured in characters.
  ;;;
  ;;; It is asked once per `sub_atom/5' call, before the candidate loop; the
  ;;; candidate loop used to ask `strlen' for every prefix.
  (func coco_b_atom_byte_length ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf b) (const char * s . nil) (size_t n . 0))
          (if (not (coco_b_atomic_text e (coco_m_arg e g 0) (aof b) (aof s) (aof n)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (coco_sb_free (aof b))
          (return (coco_m_unify_int e (coco_m_arg e g 1) (cast i64 n)))))

  ;;; THE POSITIONS A BOUND SUBSTRING OCCUPIES, in one scan. `sub_atom/5''s
  ;;; first clause used to call the single-substring builtin once per B;
  ;;; besides the byte length, every failed candidate bound Aft and had to
  ;;; undo it, and at 100 KB that was seconds. The scan returns the
  ;;; character offsets, ascending, as a list; the Coco half enumerates it.
  ;;; The substring is any atomic text since 3.0.0, as swipl's is: through
  ;;; 2.16.1 a number or a string there found nothing.
  ;;;
  ;;; B is in characters under `text_units = characters', as atom_length/2
  ;;; and sub_atom/5 are. The byte scan only starts a match on a UTF-8 lead
  ;;; byte (or ASCII), so it cannot land inside a character.
  (func coco_b_sub_atom_positions ((coco_engine * e) (size_t g)) (out int)
        (let ((const char * s . nil) (const char * sub . nil)
              (coco_strbuf sb) (coco_strbuf ub)
              (i64 nbytes . 0) (size_t n . 0) (size_t sl . 0)
              (size_t * pos . nil) (size_t np . 0)
              (size_t p . 0) (size_t bchar . 0) (int chars . 0))
          (if (not (coco_m_int e (coco_m_arg e g 2) (aof nbytes))) (return 0))
          (if (< nbytes 0) (return 0))
          (set n (cast size_t nbytes))
          (if (not (coco_b_atomic_text e (coco_m_arg e g 1) (aof ub) (aof sub) (aof sl)))
              (return 0))
          (if (not (coco_b_atomic_text e (coco_m_arg e g 0) (aof sb) (aof s) nil))
              (block (coco_sb_free (aof ub))
                     (return (coco_m_type_error e "atom" (coco_m_arg e g 0)))))
          (set chars (-> (coco_m_machine e) text_chars))
          (set pos (cast (size_t *) (malloc (* (+ n 1) (sizeof size_t)))))
          (if (== pos nil)
              (block (coco_sb_free (aof sb)) (coco_sb_free (aof ub)) (return 0)))
          (while (<= p n)
            (if (and (<= (+ p sl) n)
                     (or (not chars)
                         (!= 128 (bitand (cast int (nth p s)) 192)))
                     (== 0 (memcmp (+ s p) sub sl)))
                (block
                 (set (nth np pos) (? chars bchar p))
                 (set np (+ np 1))))
            (if (and chars (< p n)
                     (!= 128 (bitand (cast int (nth p s)) 192)))
                (set bchar (+ bchar 1)))
            (set p (+ p 1)))
          (coco_sb_free (aof sb)) (coco_sb_free (aof ub))
          ;; A PLACE GIVEN (3.25.0) keeps that one alone, so the clause's
          ;; walk of what comes back is a check that leaves no choice point,
          ;; as swipl's sub_atom/5 leaves none
          (let ((i64 bv . 0))
            (if (coco_m_int e (coco_m_arg e g 3) (aof bv))
                (let ((size_t k . 0))
                  (for ((size_t i . 0)) (< i np) ((++ i))
                    (if (== (cast i64 (nth i pos)) bv)
                        (block (set (nth k pos) (nth i pos)) (set k (+ k 1)))))
                  (set np k))))
          (let ((size_t lst . #'(coco_m_nil e)))
            (for ((size_t i . np)) (> i 0) ((-- i))
              (set lst (coco_m_cons e (coco_m_new_int e (cast i64 (nth (- i 1) pos))) lst)))
            (free pos)
            (return (coco_m_unify e (coco_m_arg e g 4) lst)))))

  ;;; One substring, at a known place and length. The enumeration is in the
  ;;; Coco half, where the engine can make the choice points.
  ;;; THIS HAD A 4096-BYTE CLIFF and reported it as the wrong error entirely.
  ;;; Two fixed buffers and a `coco_m_text' that answers 0 for "does not fit"
  ;;; exactly as it does for "not text at all" -- so `sub_atom' on an atom of
  ;;; 4096 characters raised `type_error(atom, <the atom>)', which is a
  ;;; diagnosis pointing at the one thing that was not wrong. 4095 worked.
  ;;;
  ;;; Found by library(httpd) reading a 5000-byte response back, which is the
  ;;; ordinary size of a web page and not an exotic input at all.
  ;;;
  ;;; THE ATOM IS NOW READ WHERE IT LIVES. `coco_b_atomic_text' hands back
  ;;; the pointer into the atom table, so the common case copies NOTHING
  ;;; before the substring itself -- which is both the fix and faster than
  ;;; what it replaces. Only the substring is allocated, and only for as
  ;;; long as it takes to intern it.
  ;;;
  ;;; ORDER MATTERS ON THE NEXT FOUR LINES: the integers are read BEFORE the
  ;;; pointer is taken, because anything that allocates can move the atom
  ;;; table under it. Nothing between the pointer and the `memcpy' does.
  ;;;
  ;;; THE BYTE LENGTH COMES FROM THE CALLER (2.12.0). `sub_atom/5''s bound-Sub
  ;;; path asks about every prefix of a long atom; a `strlen' here made that
  ;;; search O(n^2) -- 0.09 s at 10 KB, 0.84 s at 40 KB and 5.5 s at 100 KB
  ;;; on 2.11.6, where splitting with `atomic_list_concat/3' was flat. The
  ;;; Coco half asks once with `$atom_byte_length'/2 and passes NB here.
  (func coco_b_sub_atom_at ((coco_engine * e) (size_t g)) (out int)
        (let ((const char * s . nil) (const char * sub . nil) (coco_strbuf sb) (char * out . nil)
              (i64 before . 0) (i64 len . 0) (size_t n . 0) (int rc . 1) (i64 aft . 0)
              (i64 nbytes . 0))
          (if (not (coco_m_int e (coco_m_arg e g 1) (aof before))) (return 0))
          (if (not (coco_m_int e (coco_m_arg e g 2) (aof len))) (return 0))
          (if (not (coco_m_int e (coco_m_arg e g 5) (aof nbytes))) (return 0))
          (if (or (< before 0) (< len 0) (< nbytes 0)) (return 0))
          (if (not (coco_b_atomic_text e (coco_m_arg e g 0) (aof sb) (aof s) nil))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (set n (cast size_t nbytes))
          ;; UNDER `text_units = characters' (1.13.0) BEFORE and LEN count
          ;; characters: they become the bytes they cover, and what is after
          ;; is counted in characters again -- sub_atom('dár', 1, 1, A, S)
          ;; is A = 1, S = 'á' where bytes cut á in half
          (if (-> (coco_m_machine e) text_chars)
              (let ((size_t b0 . #'(coco_utf8_at s n (cast size_t before))) (size_t bl . 0))
                (if (== b0 (cast size_t -1)) (block (coco_sb_free (aof sb)) (return 0)))
                (set bl (coco_utf8_at (+ s b0) (- n b0) (cast size_t len)))
                (if (== bl (cast size_t -1)) (block (coco_sb_free (aof sb)) (return 0)))
                (set aft (cast i64 (coco_utf8_count (+ s (+ b0 bl)) (- n (+ b0 bl)))))
                (set before (cast i64 b0))
                (set len (cast i64 bl)))
              (block
               (if (> (cast size_t (+ before len)) n) (block (coco_sb_free (aof sb)) (return 0)))
               (set aft (cast i64 (- n (cast size_t (+ before len)))))))
          ;; A BOUND SUBSTRING IS A TEST, NOT A TERM TO BUILD. The first
          ;; clause of sub_atom/5 asks about every prefix of a long atom;
          ;; allocating and unifying a candidate there made a failed search
          ;; O(n^2) even after the byte length stopped being strlen'd. A
          ;; memcmp, with no mark, allocation or undo, is the ordinary case.
          (set sub (coco_m_atom e (coco_m_arg e g 4)))
          (if (!= sub nil)
              (if (or (!= (strlen sub) (cast size_t len))
                      (!= 0 (memcmp (+ s before) sub (cast size_t len))))
                  (block (coco_sb_free (aof sb)) (return 0))))
          (set out (cast (char *) (malloc (+ (cast size_t len) 1))))
          (if (== out nil) (block (coco_sb_free (aof sb)) (return 0)))
          (memcpy out (+ s before) (cast size_t len))
          (set (nth len out) (cast char 0))
          (coco_sb_free (aof sb))
          (let ((size_t mark . #'(coco_m_mark e)))
            (if (not (coco_m_unify_int e (coco_m_arg e g 3) aft))
                (block (coco_m_undo e mark) (set rc 0)))
            (if (and rc (not (coco_m_unify_atom e (coco_m_arg e g 4) out)))
                (block (coco_m_undo e mark) (set rc 0))))
          (free out)
          (return rc)))

  ;;; `$atom_split(Atom, Sep, Parts)': the split alone, its separator read
  ;;; as atomic_list_concat/3 reads one.
  (func coco_b_atom_split ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf sep) (int r . 0) (size_t st . #'(coco_m_arg e g 1)))
          (if (coco_m_is_var e st) (return (coco_m_instantiation_error e)))
          (if (not (coco_tx_get e st 7 (aof sep))) (return (coco_m_type_error e "text" st)))
          (if (== ($ sep len) 0)
              (block (coco_sb_free (aof sep)) (return (coco_m_domain_error e "non_empty_atom" st))))
          (set r (coco_tx_split e (coco_m_arg e g 0) (aof sep) (coco_m_arg e g 2)))
          (coco_sb_free (aof sep))
          (return r)))

  ;;; ATOMIC_LIST_CONCAT(+List, ?Atom) and (?List, +Sep, ?Atom), swipl's
  ;;; atomic_list_concat() (3.0.0), in one step each (1.12.2): the
  ;;; separator ST (-1 for none) read with CVT_ATOMIC, else type_error(text,
  ;;; Sep) -- an unbound one instantiation_error -- and each element so, an
  ;;; unbound one instantiation_error and anything else type_error(text, E):
  ;;; `[]', a list of codes and a compound among them (through 2.16.1
  ;;; type_error(atomic, E), and a list of codes was text). A proper list is
  ;;; joined and unified with AT, as an atom (atomic_list_concat([a,b], -,
  ;;; "a-b") is false); a tail that is no list is type_error(list, T), T
  ;;; that tail. With a separator an unbound element or tail SPLITS
  ;;; (`coco_tx_split', lib/solve-text.cicili, which atomics_to_string/3
  ;;; shares since 3.50.0): `atomic_list_concat([A,B], -, 'x-y')', the
  ;;; shape a caller writes when it knows how many parts it wants, and
  ;;; atomic_list_concat(L, -, 'x-y'); without one it is instantiation_error,
  ;;; and an empty separator domain_error(non_empty_atom, ''). A list that
  ;;; is its own tail is no list (1.10.19), past the heap's length.
  (static)
  (func coco_b_join ((coco_engine * e) (size_t lt) (size_t st) (size_t at)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_strbuf sep) (coco_strbuf one) (coco_strbuf out)
              (size_t lst . lt) (int first . 1) (int split . 0) (int rc . 0))
          (coco_sb_init (aof sep))
          (if (!= st (cast size_t -1))
              (block
                (if (coco_m_is_var e st) (return (coco_m_instantiation_error e)))
                (if (not (coco_tx_get e st 7 (aof sep)))
                    (return (coco_m_type_error e "text" st)))))
          (coco_sb_init (aof out))
          (set (-> m lbudget) (-> m heap_len))
          (while 1
            (set lst (coco_deref m lst))
            (if (coco-tag-is REF (nth lst (-> m heap))) (block (set split 1) break))
            (if (coco_is_nil m lst) break)
            (if (or (not (coco_is_cons m lst)) (== (-- (-> m lbudget)) 0))
                (block (set rc (coco_m_type_error e "list" lst)) (set split 2) break))
            (let ((size_t h . #'(coco_deref m (coco_arg m lst 0))))
              (if (coco_tx_get e h 7 (aof one))
                  (block (if (not first) (coco_sb_put_len (aof out) (coco_tx_s (aof sep)) ($ sep len)))
                         (coco_sb_put_len (aof out) (coco_tx_s (aof one)) ($ one len))
                         (coco_sb_free (aof one))
                         (set first 0))
                  (block
                    (if (coco-tag-is REF (nth h (-> m heap))) (block (set split 1) break))
                    (set rc (coco_m_type_error e "text" h))
                    (set split 2)
                    break)))
            (set lst (coco_arg m lst 1)))
          (if (== split 2) (block (coco_sb_free (aof sep)) (coco_sb_free (aof out)) (return rc)))
          (if (== split 0)
              (block (coco_sb_free (aof sep))
                     (set rc (coco_m_unify_atom e at (coco_tx_s (aof out))))
                     (coco_sb_free (aof out))
                     (return rc)))
          (coco_sb_free (aof out))
          (if (== st (cast size_t -1)) (return (coco_m_instantiation_error e)))
          (if (== ($ sep len) 0)
              (block (coco_sb_free (aof sep)) (return (coco_m_domain_error e "non_empty_atom" st))))
          (set rc (coco_tx_split e at (aof sep) lt))
          (coco_sb_free (aof sep))
          (return rc)))

  (func coco_b_atom_join ((coco_engine * e) (size_t g)) (out int)
        (return (coco_b_join e (coco_m_arg e g 0) (coco_m_arg e g 1) (coco_m_arg e g 2))))

  (func coco_b_alc2 ((coco_engine * e) (size_t g)) (out int)
        (return (coco_b_join e (coco_m_arg e g 0) (cast size_t -1) (coco_m_arg e g 1))))

  (func coco_b_alc3 ((coco_engine * e) (size_t g)) (out int)
        (return (coco_b_join e (coco_m_arg e g 0) (coco_m_arg e g 1) (coco_m_arg e g 2))))

  ) ; impl-builtins-format

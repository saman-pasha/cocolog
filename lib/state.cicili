;;;; cocolog -- freezing a machine, and thawing it again
;;;
;;; THIS FILE IS SHORT BECAUSE OF DECISIONS MADE ELSEWHERE. A machine is a heap
;;; of 64-bit cells, a trail of indices, an array of choice-point frames whose
;;; every field is an integer, and three interning tables. There is no graph to
;;; walk, no pointer to relocate and no C stack to reconstruct -- so freezing is
;;; printing six arrays and thawing is reading them back. If terms were made of
;;; malloc'd nodes and the engine recursed in C, this file could not exist at
;;; all; that is what term.cicili and solve.cicili are paying for.
;;;
;;; THE FORMAT IS ASCII, and deliberately. It goes into a Text column, travels
;;; through an HTTP page, and gets looked at by a person trying to work out why
;;; a machine will not resume. Atom names are hex-encoded so that a name
;;; holding a space, a newline or a NUL cannot break the framing; everything
;;; else is already a number.
;;;
;;; WHAT IS *NOT* IN IT: the knowledge base. A frozen machine is a suspended
;;; computation, not a copy of the database it was reading -- the database is
;;; the shared thing, and shipping a copy of it inside every suspended machine
;;; would defeat the point of sharing it. So thawing is two steps and the order
;;; matters:
;;;
;;;   1. thaw the machine, which rebuilds the atom table exactly as it was
;;;   2. load the knowledge base, whose clauses intern against that table
;;;
;;; Interning is by name, so a name the machine already has keeps the id it had
;;; and a new one is appended. Do it the other way round and the store's cells
;;; would refer to atom ids the thawed heap does not agree with.
;;;
;;; WHAT A RESUMED MACHINE ASSUMES ABOUT THE DATABASE. A choice point that was
;;; part way through a predicate remembers the predicate by NAME and arity --
;;; not by its index in the store, which depends on the order predicates were
;;; first mentioned -- and, counted among the predicate's LIVE clauses, the
;;; next clause to try and how many it may try (`C' and `L'): a running call
;;; keeps ISO's logical update view (lib/kb.cicili), a clause retracted under
;;; it dead in place and one asserted past its end, and the knowledge base a
;;; thaw reloads holds only the live. So resuming requires the predicate to
;;; still have its live clauses in the order it had them; another machine
;;; retracting one from underneath a suspended machine makes it resume at the
;;; wrong one. The machine records no revision of the database, on purpose:
;;; the database is shared, other machines may change it while this one is
;;; frozen, and a resume runs on it as it is. An embedded store nobody else
;;; uses resumes where it stopped, but for one thing a run never frozen does:
;;; a clause retracted AHEAD of an open call is gone from the store, so the
;;; thawed call does not meet it.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)


(generic decl-state
  ()

  ;;; A cursor over the frozen text. Everything is read through this, so a
  ;;; truncated or corrupt blob fails in one place rather than in twenty.
  (struct coco_scan
    (member const char * s)
    (member size_t       pos)
    (member size_t       len)
    (member int          bad))

  ;;; Writes the whole of E -- machine and engine -- into B.
  (decl) (func coco_freeze ((coco_engine * e) (coco_strbuf * b)) (out int))

  ;;; Reads one back. M and ST are reset; E is pointed at them. Answers 1, or 0
  ;;; with a message in E's `err'.
  ;;;
  ;;; The store is emptied but NOT filled: load the knowledge base after this,
  ;;; in that order, for the reason given at the head of the file.
  (decl) (func coco_thaw ((coco_engine * e) (coco_machine * m) (coco_store * st)
                        (const char * text)) (out int))

  ) ; decl-state


(generic impl-state
  ()

  ;;; ---- writing -----------------------------------------------------------

  (static)
  (func coco_sb_put_hex ((coco_strbuf * b) (u64 v)) (out int)
        (let ((char tmp [24]))
          (snprintf tmp (sizeof tmp) "%llx" (cast ullong v))
          (return (coco_sb_put b tmp))))

  (static)
  (func coco_sb_put_sz ((coco_strbuf * b) (size_t v)) (out int)
        (let ((char tmp [24]))
          (snprintf tmp (sizeof tmp) "%llu" (cast ullong v))
          (return (coco_sb_put b tmp))))

  ;;; A name as hex digits. Two per byte, no length prefix needed -- the token
  ;;; ends at the next space, and an empty name is the empty token, which is
  ;;; why the length is written beside it.
  (static)
  (func coco_sb_put_name ((coco_strbuf * b) (const char * s) (size_t n)) (out int)
        (coco_sb_put_sz b n)
        (coco_sb_putc b (cast char 32))
        (for ((size_t i . 0)) (< i n) ((++ i))
          (let ((char tmp [4]))
            (snprintf tmp (sizeof tmp) "%02x" (cast uint (cast uchar (nth i s))))
            (coco_sb_put b tmp)))
        (return 1))

  (static)
  (func coco_freeze_image ((coco_engine * e) (coco_strbuf * b)) (out int)
        (let ((coco_machine * m . #'(-> e m)))
          ;; THE FORMAT'S VERSION (2, since the four-bit tag of 2.5.0): the
          ;; heap below is a run of raw cell words, so the layout is part of
          ;; the format. A format-1 blob is upgraded as it is read
          ;; (`coco_thaw_upgrade').
          (coco_sb_put b "cocolog 2\n")

          (coco_sb_put b "A ") (coco_sb_put_sz b (-> m atoms_len)) (coco_sb_putc b (cast char 10))
          ;; THE ATOM `'[]'' IS MARKED ` q' (3.0.0): it shares its name with
          ;; the list's end, and interned by its name it would be that one --
          ;; and every id after it one off
          (for ((size_t i . 0)) (< i (-> m atoms_len)) ((++ i))
            (coco_sb_put_name b ($ (nth i (-> m atoms)) name) ($ (nth i (-> m atoms)) len))
            (if (coco_atom_is_tnil m (cast u64 i)) (coco_sb_put b " q"))
            (coco_sb_putc b (cast char 10)))

          (coco_sb_put b "F ") (coco_sb_put_sz b (-> m functors_len)) (coco_sb_putc b (cast char 10))
          (for ((size_t i . 0)) (< i (-> m functors_len)) ((++ i))
            (coco_sb_put_sz b (cast size_t ($ (nth i (-> m functors)) name)))
            (coco_sb_putc b (cast char 32))
            (coco_sb_put_sz b (cast size_t ($ (nth i (-> m functors)) arity)))
            (coco_sb_putc b (cast char 10)))

          ;; %.17g always reads back bit for bit, which is all a machine that
          ;; resumes needs: the same double it held before (the writer's
          ;; shortest form, since 1.10.28, would do too, at more cost)
          (coco_sb_put b "D ") (coco_sb_put_sz b (-> m floats_len)) (coco_sb_putc b (cast char 10))
          (for ((size_t i . 0)) (< i (-> m floats_len)) ((++ i))
            (let ((char tmp [40]))
              (snprintf tmp (sizeof tmp) "%.17g" (nth i (-> m floats)))
              (coco_sb_put b tmp)
              (coco_sb_putc b (cast char 10))))

          (coco_sb_put b "H ") (coco_sb_put_sz b (-> m heap_len)) (coco_sb_putc b (cast char 10))
          (for ((size_t i . 0)) (< i (-> m heap_len)) ((++ i))
            (coco_sb_put_hex b (nth i (-> m heap)))
            (coco_sb_putc b (cast char (? (== 15 (% i 16)) 10 32))))
          (coco_sb_putc b (cast char 10))

          (coco_sb_put b "T ") (coco_sb_put_sz b (-> m trail_len)) (coco_sb_putc b (cast char 10))
          (for ((size_t i . 0)) (< i (-> m trail_len)) ((++ i))
            (coco_sb_put_sz b (nth i (-> m trail)))
            (coco_sb_putc b (cast char (? (== 15 (% i 16)) 10 32))))
          (coco_sb_putc b (cast char 10))

          (coco_sb_put b "E ")
          (coco_sb_put_sz b (-> e goals))    (coco_sb_putc b (cast char 32))
          (coco_sb_put_sz b (-> e query))    (coco_sb_putc b (cast char 32))
          (coco_sb_put_sz b (cast size_t (-> e steps)))     (coco_sb_putc b (cast char 32))
          (coco_sb_put_sz b (cast size_t (-> e max_steps))) (coco_sb_putc b (cast char 32))
          (coco_sb_put_sz b (cast size_t (-> e resume)))    (coco_sb_putc b (cast char 32))
          (coco_sb_put_sz b (cast size_t (-> e halted)))    (coco_sb_putc b (cast char 10))

          ;; A choice point names its predicate rather than pointing at it: the
          ;; index depends on the order predicates were first mentioned, which
          ;; is not something a machine coming back somewhere else can rely on.
          (coco_sb_put b "C ") (coco_sb_put_sz b (-> e nchoices)) (coco_sb_putc b (cast char 10))
          (for ((size_t i . 0)) (< i (-> e nchoices)) ((++ i))
            (let ((coco_choice * c . #'(aof (nth i (-> e choices))))
                  (u64 pname . 0) (u32 parity . 0))
              (if (== (-> c kind) COCO_CH_CLAUSE)
                  (block (set pname ($ (nth (-> c pred) ($ (cof (-> e st)) preds)) name))
                         (set parity ($ (nth (-> c pred) ($ (cof (-> e st)) preds)) arity))))
              (coco_sb_put_sz b (cast size_t (-> c kind)))       (coco_sb_putc b (cast char 32))
              (coco_sb_put_sz b (-> c goals))                    (coco_sb_putc b (cast char 32))
              (coco_sb_put_sz b (-> c trail_mark))               (coco_sb_putc b (cast char 32))
              (coco_sb_put_sz b (-> c heap_mark))                (coco_sb_putc b (cast char 32))
              (coco_sb_put_sz b (-> c call))                     (coco_sb_putc b (cast char 32))
              ;; a clause frame's next clause by its ordinal among the LIVE
              ;; clauses: the knowledge base a thaw reloads holds none of
              ;; the dead the frame kept open (the logical update view,
              ;; lib/kb.cicili), and the call goes on where it stood in it
              (coco_sb_put_sz b (? (== (-> c kind) COCO_CH_CLAUSE)
                                   (coco_pred_live_before
                                    (aof (nth (-> c pred) ($ (cof (-> e st)) preds)))
                                    (-> c clause_ix))
                                   (-> c clause_ix)))
              (coco_sb_putc b (cast char 32))
              (coco_sb_put_sz b (-> c barrier))                  (coco_sb_putc b (cast char 32))
              (coco_sb_put_sz b (cast size_t parity))            (coco_sb_putc b (cast char 32))
              (if (== (-> c kind) COCO_CH_CLAUSE)
                  (coco_sb_put_name b (coco_atom_name m pname)
                                  (strlen (coco_atom_name m pname)))
                (coco_sb_put b "0 "))
              (coco_sb_putc b (cast char 10))))

          ;; THE OPERATORS A PROGRAM DECLARED, and this is not a nicety. A
          ;; machine's clauses live in the database as TEXT and are parsed on
          ;; the way back in, so a clause that uses a declared operator cannot
          ;; be read at all unless the declaration comes back with the machine.
          ;;
          ;; It is written LAST, so that a blob made before this section
          ;; existed still reads: the reader stops when the text runs out.
          (coco_sb_put b "O ") (coco_sb_put_sz b (coco_op_dyn_count))
          (coco_sb_putc b (cast char 10))
          (for ((size_t i . 0)) (< i (coco_op_dyn_count)) ((++ i))
            (let ((const char * nm . nil) (int prec . 0) (int type . 0) (int kind . 0))
              (if (coco_op_dyn_at i (aof nm) (aof prec) (aof type) (aof kind))
                  (block
                   (coco_sb_put_sz b (cast size_t prec)) (coco_sb_putc b (cast char 32))
                   (coco_sb_put_sz b (cast size_t type)) (coco_sb_putc b (cast char 32))
                   (coco_sb_put_sz b (cast size_t kind)) (coco_sb_putc b (cast char 32))
                   (coco_sb_put_name b nm (strlen nm))
                   (coco_sb_putc b (cast char 10))))))

          ;; THE STEPS THAT WERE NO INFERENCE (1.12.2): `true' and `=/2', and
          ;; the limit in inferences a turn set -- after the operators, so a
          ;; blob from an older build still reads, as having none
          (coco_sb_put b "I ")
          (coco_sb_put_sz b (cast size_t (-> e frees)))   (coco_sb_putc b (cast char 32))
          (coco_sb_put_sz b (cast size_t (-> e max_inf))) (coco_sb_putc b (cast char 10))

          ;; WHAT ITS TEXT BUILTINS COUNT IN (1.13.0): the codes on its heap
          ;; were made in those units, so the machine goes on in them in
          ;; whatever process thaws it. Last, as `I' is.
          (coco_sb_put b "U ")
          (coco_sb_put_sz b (cast size_t (-> m text_chars))) (coco_sb_putc b (cast char 10))

          ;; THE INTEGERS PAST 60 BITS (2.0.0): the table a BIG cell names,
          ;; every entry in order -- a free one too -- so the heap's cells
          ;; name what they named; each its 64 bits in hex. Last, as `U' is.
          (coco_sb_put b "B ") (coco_sb_put_sz b (-> m bigs_len)) (coco_sb_putc b (cast char 10))
          (for ((size_t i . 0)) (< i (-> m bigs_len)) ((++ i))
            (coco_sb_put_hex b (cast u64 (nth i (-> m bigs))))
            (coco_sb_putc b (cast char 10)))

          ;; THE RATIONAL NUMBERS (2.5.0): the table a RAT cell names, every
          ;; entry in order -- a free one too -- as their two 64-bit halves
          ;; in hex, so the heap's cells name what they named. Last, as `B'
          ;; is, and before `N' as both are.
          (coco_sb_put b "R ") (coco_sb_put_sz b (-> m rats_len)) (coco_sb_putc b (cast char 10))
          (for ((size_t i . 0)) (< i (-> m rats_len)) ((++ i))
            (coco_sb_put_hex b (cast u64 ($ (nth i (-> m rats)) n)))
            (coco_sb_putc b (cast char 32))
            (coco_sb_put_hex b (cast u64 ($ (nth i (-> m rats)) d)))
            (coco_sb_putc b (cast char 10)))

          ;; WHAT A FLOAT THAT IS NO NUMBER BECOMES (2.2.2): the four float
          ;; flags' bits, so the machine reckons as it did in whatever
          ;; process thaws it. Last, as `B' is; `N', since `F' is the
          ;; functors'.
          (coco_sb_put b "N ")
          (coco_sb_put_sz b (cast size_t (-> m fflags))) (coco_sb_putc b (cast char 10))

          ;; HOW FAR EACH CALL OPEN OVER A PREDICATE MAY GO (the logical
          ;; update view): the live clauses before the end it began with, as
          ;; its next clause is written among the live in `C' -- so a thawed
          ;; call does not meet the clauses it asserted itself, which the
          ;; knowledge base it reloads holds -- in the order of the frames,
          ;; 0 for a frame that is no call's, and 4294967295 for one whose
          ;; end a thaw had not settled yet. Last, as `N' is.
          (coco_sb_put b "L ") (coco_sb_put_sz b (-> e nchoices)) (coco_sb_putc b (cast char 10))
          (for ((size_t i . 0)) (< i (-> e nchoices)) ((++ i))
            (let ((coco_choice * c . #'(aof (nth i (-> e choices)))))
              (coco_sb_put_sz b (? (!= (-> c kind) COCO_CH_CLAUSE) 0
                                   (? (== (-> c cend) 4294967295) 4294967295
                                      (coco_pred_live_before
                                       (aof (nth (-> c pred) ($ (cof (-> e st)) preds)))
                                       (cast size_t (-> c cend))))))
              (coco_sb_putc b (cast char (? (== 15 (% i 16)) 10 32)))))
          (coco_sb_putc b (cast char 10))

          (return (? (== ($ (cof b) s) nil) 0 1))))

  ;;; THE IMAGE IS WRITTEN FROM A MACHINE THAT REACHES NO ENVIRONMENT
  ;;; (Stage 5): `coco_engine_materialize' builds every body's later goals
  ;;; the way entering the clause built them through 1.9.2, the image is
  ;;; written, and the heap is wound back so the live machine keeps its own.
  ;;; The format is the one it was, and a thawed machine is all frames;
  ;;; what environments the heap still holds are cells nothing names.
  (func coco_freeze ((coco_engine * e) (coco_strbuf * b)) (out int)
        (let ((coco_kmat sv) (int rc . 0))
          (if (not (coco_engine_materialize e (aof sv))) (return 0))
          (set rc (coco_freeze_image e b))
          (coco_engine_materialize_undo e (aof sv))
          (return rc)))

  ;;; ---- reading ------------------------------------------------------------

  ;;; The value of one hex digit, or -1. Answers int rather than a flag plus a
  ;;; value because -1 is not a digit and cannot be mistaken for one.
  (static)
  (func coco_hexval ((char ch)) (out int)
        (let ((int c . #'(cast int (cast uchar ch))))
          (if (and (>= c 48) (<= c 57)) (return (- c 48)))
          (if (and (>= c 97) (<= c 102)) (return (+ 10 (- c 97))))
          (if (and (>= c 65) (<= c 70)) (return (+ 10 (- c 65))))
          (return -1)))

  (static)
  (func coco_scan_space ((coco_scan * z))
        (while (and (< (-> z pos) (-> z len))
                    (or (== (nth (-> z pos) (-> z s)) (cast char 32))
                        (or (== (nth (-> z pos) (-> z s)) (cast char 10))
                            (or (== (nth (-> z pos) (-> z s)) (cast char 13))
                                (== (nth (-> z pos) (-> z s)) (cast char 9))))))
          (set (-> z pos) (+ (-> z pos) 1))))

  (static)
  (func coco_scan_u64 ((coco_scan * z) (int base)) (out u64)
        (coco_scan_space z)
        (let ((u64 v . 0) (int any . 0))
          (while (< (-> z pos) (-> z len))
            (let ((int ch . #'(cast int (cast uchar (nth (-> z pos) (-> z s)))))
                  (int d . -1))
              (cond ((and (>= ch 48) (<= ch 57)) (set d (- ch 48)))
                    ((and (>= ch 97) (<= ch 102)) (set d (+ 10 (- ch 97))))
                    ((and (>= ch 65) (<= ch 70)) (set d (+ 10 (- ch 65)))))
              (if (or (== d -1) (>= d base)) break)
              (set v (+ (* v (cast u64 base)) (cast u64 d)))
              (set any 1)
              (set (-> z pos) (+ (-> z pos) 1))))
          (if (not any) (set (-> z bad) 1))
          (return v)))

  ;;; The next token must be exactly this word. Used for the section letters,
  ;;; so a blob whose sections are out of order is rejected rather than read as
  ;;; something else.
  (static)
  (func coco_scan_word ((coco_scan * z) (const char * w)) (out int)
        (coco_scan_space z)
        (let ((size_t n . #'(strlen w)))
          (if (> (+ (-> z pos) n) (-> z len)) (block (set (-> z bad) 1) (return 0)))
          (if (!= 0 (strncmp (+ (-> z s) (-> z pos)) w n))
              (block (set (-> z bad) 1) (return 0)))
          (set (-> z pos) (+ (-> z pos) n))
          (return 1)))

  ;;; Whether the next thing is this section, WITHOUT failing if it is not.
  ;;; `coco_scan_word' marks the blob bad on a mismatch, which is right for a
  ;;; section that must be there and wrong for one that a machine frozen by an
  ;;; older build simply does not have.
  (static)
  (func coco_scan_section ((coco_scan * z) (int tag)) (out int)
        (coco_scan_space z)
        (if (>= (-> z pos) (-> z len)) (return 0))
        (if (!= (bitand (cast int (nth (-> z pos) (-> z s))) 255) tag) (return 0))
        (set (-> z pos) (+ (-> z pos) 1))
        (return 1))

  (static)
  (func coco_scan_double ((coco_scan * z)) (out double)
        (coco_scan_space z)
        (let ((char * end . nil)
              (double v . #'(strtod (+ (-> z s) (-> z pos)) (aof end))))
          (if (== end (+ (-> z s) (-> z pos))) (block (set (-> z bad) 1) (return 0.0)))
          (set (-> z pos) (cast size_t (- end (-> z s))))
          (return v)))

  ;;; A hex-encoded name into B. The length comes first, so an empty name is
  ;;; read as an empty name rather than as a missing token.
  (static)
  (func coco_scan_name ((coco_scan * z) (coco_strbuf * b)) (out int)
        (coco_sb_reset b)
        (let ((size_t n . #'(cast size_t (coco_scan_u64 z 10))))
          (if (-> z bad) (return 0))
          (coco_scan_space z)
          (for ((size_t i . 0)) (< i n) ((++ i))
            (if (> (+ (-> z pos) 2) (-> z len)) (block (set (-> z bad) 1) (return 0)))
            (let ((int hi) (int lo))
              (set hi (coco_hexval (nth (-> z pos) (-> z s))))
              (set lo (coco_hexval (nth (+ (-> z pos) 1) (-> z s))))
              (if (or (< hi 0) (< lo 0)) (block (set (-> z bad) 1) (return 0)))
              (coco_sb_putc b (cast char (+ (* hi 16) lo)))
              (set (-> z pos) (+ (-> z pos) 2))))
          (return 1)))

  ;;; THE HEAP OF A THREE-BIT-TAG MACHINE, UPGRADED IN PLACE (2.5.0). A
  ;;; format-1 cell's tag is its old tag number and its payload is read at
  ;;; bit 3; the new word puts the same payload at bit 4. An INT the 60-bit
  ;;; payload no longer holds is boxed, and a BIG that set payload bit 60
  ;;; (cell bit 63) was the old encoding's rational. The B and R sections
  ;;; are already read when this runs, so a boxed entry appends behind them
  ;;; and every old index still names what it named.
  (static)
  (func coco_thaw_upgrade ((coco_machine * m)) (out int)
        (for ((size_t i . 0)) (< i (-> m heap_len)) ((++ i))
          (let ((u64 w . #'(nth i (-> m heap)))
                (u64 tag . 0) (u64 p . 0) (u64 nw . 0))
            (set tag (bitand w 7))
            (set p (>> w 3))
            (cond
              ((== tag 2)
               (let ((i64 v . #'(>> (cast i64 w) 3)))
                 (if (coco-fits-cell v)
                     (set nw (coco-int-cell v))
                   (let ((size_t k . #'(coco_big_entry m v)))
                     (if (== k (cast size_t -1)) (return 0))
                     (set nw (coco-cell BIG k))))))
              ((== tag 7)
               (if (== 0 (bitand p (<< (cast u64 1) 60)))
                   (set nw (coco-cell BIG p))
                 (set nw (coco-rat-cell (bitand p (- (<< (cast u64 1) 60) 1))))))
              ;; no table or heap of either era holds 2^60 entries
              ((> p 1152921504606846975) (return 0))
              (#t (set nw (bitor (<< p 4) tag))))
            (set (nth i (-> m heap)) nw)))
        (return 1))

  (func coco_thaw ((coco_engine * e) (coco_machine * m) (coco_store * st) (const char * text)) (out int)
        (let ((coco_scan z) (coco_strbuf nm) (int ok . 1) (int ver . 0))
          (memset (aof z) 0 (sizeof coco_scan))
          (set ($ z s) text)
          (set ($ z len) (strlen text))
          (coco_sb_init (aof nm))

          ;; the machine is rebuilt from nothing, so the atom ids in the frozen
          ;; heap mean what they meant
          (coco_machine_free m)
          (coco_machine_init m)

          ;; THE STORE'S BACKEND SURVIVES THE RESET. Emptying the store is the
          ;; point -- the clauses are reloaded rather than carried in the blob
          ;; -- but the hooks that say WHERE from are not part of its contents,
          ;; and they have to be in place before the choice points are put back:
          ;; restoring one asks the store for its predicate, and a predicate
          ;; with no backend behind it stays empty. The machine came back
          ;; holding its choice points and then proved nothing.
          (coco_store_reset st)
          ;; and a read of one that fails is said at the end (2.11.1)
          (set (nth 0 (-> st fetch_err)) (cast char 0))

          ;; the engine is rebuilt too, keeping what its HOST decided: whether
          ;; the heap collector may run under it (see `gc' on the engine)
          (let ((int gc . #'(-> e gc)))
            (coco_engine_free e)
            (coco_engine_init e m st)
            (set (-> e gc) gc))

          (if (not (coco_scan_word (aof z) "cocolog")) (set ok 0))
          (if ok (set ver (cast int (coco_scan_u64 (aof z) 10))))
          ;; 1 is the three-bit-tag layout of every build through 2.4.1 and
          ;; is upgraded below; 2 is this one
          (if (and ok (and (!= ver 1) (!= ver 2))) (set ok 0))

          ;; ---- atoms, in order, so ids are preserved ----
          (if ok (coco_scan_word (aof z) "A"))
          (let ((size_t na . #'(cast size_t (coco_scan_u64 (aof z) 10))))
            (for ((size_t i . 0)) (and ok (< i na)) ((++ i))
              (if (not (coco_scan_name (aof z) (aof nm))) (block (set ok 0) break))
              (if (coco_scan_section (aof z) (coco-ch "q"))
                  (coco_intern_tnil m)
                  (coco_intern_len m (? (== ($ nm s) nil) "" ($ nm s)) ($ nm len)))))

          ;; ---- functors ----
          (if ok (coco_scan_word (aof z) "F"))
          (let ((size_t nf . #'(cast size_t (coco_scan_u64 (aof z) 10))))
            (for ((size_t i . 0)) (and ok (< i nf)) ((++ i))
              (let ((u64 name . #'(coco_scan_u64 (aof z) 10))
                    (u64 ar . #'(coco_scan_u64 (aof z) 10)))
                (coco_functor_id m name (cast u32 ar)))))

          ;; ---- floats ----
          (if ok (coco_scan_word (aof z) "D"))
          (let ((size_t nd . #'(cast size_t (coco_scan_u64 (aof z) 10))))
            (for ((size_t i . 0)) (and ok (< i nd)) ((++ i))
              (coco_new_float m (coco_scan_double (aof z)))))
          ;; coco_new_float pushed a cell per float; the heap below replaces the
          ;; whole array anyway, so those cells are about to be overwritten
          (set (-> m heap_len) 0)
          ;; and so are the ground globals the machine kept (1.12.1): read
          ;; again, they are copied again
          (coco_gcache_drop m 0)

          ;; ---- the heap ----
          (if ok (coco_scan_word (aof z) "H"))
          (let ((size_t nh . #'(cast size_t (coco_scan_u64 (aof z) 10))))
            (for ((size_t i . 0)) (and ok (< i nh)) ((++ i))
              (coco_push m (coco_scan_u64 (aof z) 16))))

          ;; ---- the trail ----
          (if ok (coco_scan_word (aof z) "T"))
          (let ((size_t nt . #'(cast size_t (coco_scan_u64 (aof z) 10))))
            (for ((size_t i . 0)) (and ok (< i nt)) ((++ i))
              (coco_trail_push m (cast size_t (coco_scan_u64 (aof z) 10)))))

          ;; ---- the engine ----
          (if ok (coco_scan_word (aof z) "E"))
          (set (-> e goals)     (cast size_t (coco_scan_u64 (aof z) 10)))
          (set (-> e query)     (cast size_t (coco_scan_u64 (aof z) 10)))
          (set (-> e steps)     (coco_scan_u64 (aof z) 10))
          (set (-> e max_steps) (coco_scan_u64 (aof z) 10))
          (set (-> e resume)    (cast int (coco_scan_u64 (aof z) 10)))
          (set (-> e halted)    (cast int (coco_scan_u64 (aof z) 10)))

          ;; ---- the choice points ----
          (if ok (coco_scan_word (aof z) "C"))
          (let ((size_t nc . #'(cast size_t (coco_scan_u64 (aof z) 10))))
            (for ((size_t i . 0)) (and ok (< i nc)) ((++ i))
              (let ((int kind . #'(cast int (coco_scan_u64 (aof z) 10)))
                    (size_t goals . #'(cast size_t (coco_scan_u64 (aof z) 10)))
                    (size_t tmark . #'(cast size_t (coco_scan_u64 (aof z) 10)))
                    (size_t hmark . #'(cast size_t (coco_scan_u64 (aof z) 10)))
                    (size_t call . #'(cast size_t (coco_scan_u64 (aof z) 10)))
                    (size_t cix . #'(cast size_t (coco_scan_u64 (aof z) 10)))
                    (size_t barrier . #'(cast size_t (coco_scan_u64 (aof z) 10)))
                    (u32 parity . #'(cast u32 (coco_scan_u64 (aof z) 10))))
                (if (not (coco_scan_name (aof z) (aof nm))) (block (set ok 0) break))
                (if (not (coco_choice_restore e kind goals tmark hmark call cix barrier
                                            (? (== ($ nm s) nil) "" ($ nm s)) parity))
                    (block (set ok 0) break)))))

          ;; ---- the operators, if this blob carries any ------------------
          ;;
          ;; OPTIONAL, because a machine frozen before this section existed has
          ;; none and must still read. `coco_scan_section' answers 0 at the end
          ;; of the text, and that is not an error -- it is an older blob.
          (if (and ok (not ($ z bad)))
              (if (coco_scan_section (aof z) 79)          ; `O'
                  (let ((size_t nops . #'(coco_scan_u64 (aof z) 10)))
                    ;; a thawed machine's table is ITS table and not this
                    ;; process's: whatever was declared here before is gone
                    (coco_op_dyn_clear)
                    (for ((size_t i . 0)) (and ok (< i nops)) ((++ i))
                      (let ((int prec . #'(cast int (coco_scan_u64 (aof z) 10)))
                            (int type . #'(cast int (coco_scan_u64 (aof z) 10)))
                            (int kind . #'(cast int (coco_scan_u64 (aof z) 10))))
                        (if (not (coco_scan_name (aof z) (aof nm))) (block (set ok 0) break))
                        (if (not (coco_op_define (? (== ($ nm s) nil) "" ($ nm s))
                                               prec type kind))
                            (block (set ok 0) break)))))))

          ;; ---- the steps that were no inference (1.12.2), if it has them --
          (if (and ok (not ($ z bad)))
              (if (coco_scan_section (aof z) 73)          ; `I'
                  (block (set (-> e frees) (coco_scan_u64 (aof z) 10))
                         (set (-> e max_inf) (coco_scan_u64 (aof z) 10)))))

          ;; ---- the text units (1.13.0), if it has them; bytes before, so a
          ;; machine frozen in bytes goes on in them whatever this process's
          ;; default (characters since 2.0.0) ----
          (if (and ok (not ($ z bad)))
              (block
               (set (-> m text_chars) 0)
               (if (coco_scan_section (aof z) 85)          ; `U'
                   (set (-> m text_chars) (? (!= 0 (coco_scan_u64 (aof z) 10)) 1 0)))))

          ;; ---- the integers past 60 bits (2.0.0), if it has any: appended
          ;; in order to the table `coco_machine_init' left empty, so entry I
          ;; is entry I again ----
          (if (and ok (not ($ z bad)))
              (if (coco_scan_section (aof z) 66)          ; `B'
                  (let ((size_t nb . #'(cast size_t (coco_scan_u64 (aof z) 10))))
                    (for ((size_t i . 0)) (and ok (< i nb)) ((++ i))
                      (if (== (coco_big_entry m (cast i64 (coco_scan_u64 (aof z) 16))) (cast size_t -1))
                          (block (set ok 0) break))))))

          ;; ---- the rational numbers (2.5.0), if it has any: appended in
          ;; order to the table `coco_machine_init' left empty, as `B' is ----
          (if (and ok (not ($ z bad)))
              (if (coco_scan_section (aof z) 82)          ; `R'
                  (let ((size_t nr . #'(cast size_t (coco_scan_u64 (aof z) 10))))
                    (for ((size_t i . 0)) (and ok (< i nr)) ((++ i))
                      (let ((i64 nn . #'(cast i64 (coco_scan_u64 (aof z) 16)))
                            (i64 dd . #'(cast i64 (coco_scan_u64 (aof z) 16))))
                        (if (== (coco_rat_entry m nn dd) (cast size_t -1))
                            (block (set ok 0) break)))))))

          ;; ---- a three-bit-tag heap (format 1), upgraded once B and R are
          ;; in place so the indices it names are the entries read ----
          (if (and ok (== ver 1))
              (if (not (coco_thaw_upgrade m)) (set ok 0)))

          ;; ---- the float flags (2.2.2), if it has them; swipl's defaults
          ;; before, which every machine frozen until then reckoned by ----
          (if (and ok (not ($ z bad)))
              (block
               (set (-> m fflags) 0)
               (if (coco_scan_section (aof z) 78)          ; `N'
                   (set (-> m fflags) (bitand (cast int (coco_scan_u64 (aof z) 10)) 15)))))

          ;; ---- how far each open call may go (the logical update view), if
          ;; it says: the end among the clauses the knowledge base will hold.
          ;; A frame it does not settle keeps the mark `coco_choice_restore'
          ;; left, and is given what that knowledge base holds when the run
          ;; starts (`coco_frames_bound'), as a blob from before has each ----
          (if (and ok (not ($ z bad)))
              (if (coco_scan_section (aof z) 76)          ; `L'
                  (let ((size_t nl . #'(cast size_t (coco_scan_u64 (aof z) 10))))
                    (for ((size_t i . 0)) (and ok (< i nl)) ((++ i))
                      (let ((u64 v . #'(coco_scan_u64 (aof z) 10)))
                        (if (and (< i (-> e nchoices))
                                 (== ($ (nth i (-> e choices)) kind) COCO_CH_CLAUSE)
                                 (< v 4294967295))
                            (set ($ (nth i (-> e choices)) cend) (cast u32 v))))))))

          (coco_sb_free (aof nm))
          ;; AN OPEN CALL WHOSE PREDICATE COULD NOT BE READ BACK (2.11.1):
          ;; its frame names positions in a clause list the knowledge base
          ;; did not hand over, so the machine is not resumed on it
          (if (and (not ok) (!= (nth 0 (-> st fetch_err)) (cast char 0)))
              (block (snprintf (-> e err) 512
                               "the frozen machine's open calls could not be read back: %s"
                               (-> st fetch_err))
                     (return 0)))
          (if (or (not ok) ($ z bad))
              (block (snprintf (-> e err) 192
                               "the frozen machine could not be read (at offset %llu)"
                               (cast ullong ($ z pos)))
                     (return 0)))
          (return 1)))

  ) ; impl-state

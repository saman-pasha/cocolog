;;;; cocolog -- writing, the environment, the clause database, global
;;;; variables, operators, halting, and the builtins module's dispatcher
;;;
;;; A PIECE OF THE BUILTINS MODULE, split out of lib/builtins.cicili for size
;;; (2.16.1, where that file had reached 4 053 lines). The three pieces are ONE
;;; translation unit, emitted in this order by cocolog.cicili: builtins,
;;; builtins-format, builtins-db. So a function here calls only what an
;;; earlier piece defined or `decl-builtins' declared, exactly as when they
;;; were one file. lib/builtins.cicili keeps the module's table of rows and its
;;; Prolog half; lib/builtins-db.cicili ends with the dispatcher the table is
;;; emitted into, which is why it comes last.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;; One property more in predicate_property/2's list V (3.41.0,
;;; `coco_b_pred_props')
(DEFMACRO coco-pp-add (atom)
  `(block (set (nth n v) (coco_new_atom m ,atom)) (++ n)))

(generic impl-builtins-db
  ()

  ;;; ---- writing ----------------------------------------------------------

  ;;; writeq/1, swipl's (2.2.5): quoted, numbervars and character escapes
  ;;; (25: `'$VAR'(1)' is `B', `'don''t'' is `'don\'t''). Through 2.2.4
  ;;; quoted alone, and `'$VAR'(1)' and `'don''t'' came out as they read.
  (func coco_b_writeq ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_mode (coco_m_machine e) (aof b) (coco_m_arg e g 0) 25 1)
          (if (!= ($ b s) nil) (coco_out_puts stdout ($ b s)))
          (coco_sb_free (aof b))
          (return 1)))

  ;;; `write_term(Term, Options)', its options read by `coco_wt_put' in
  ;;; lib/builtins-format.cicili, which format's `~W' shares (3.0.0).
  (func coco_b_write_term ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf b) (int r . #'(coco_wt_check e (coco_m_arg e g 1))))
          (if (!= r 1) (return r))
          (coco_sb_init (aof b))
          (coco_wt_put e (aof b) (coco_m_arg e g 0) (coco_m_arg e g 1))
          (if (!= ($ b s) nil) (coco_out_puts stdout ($ b s)))
          (coco_sb_free (aof b))
          (return 1)))

  ;;; ---- the environment --------------------------------------------------
  ;;;
  ;;; SWI's `getenv/2', `setenv/2' and `unsetenv/1'. getenv FAILS for a
  ;;; name that is not set rather than throwing -- "is this set" is an
  ;;; ordinary question with an ordinary no, and a program that wants an
  ;;; error can write `( getenv(X, V) -> true ; throw(...) )'.
  ;;;
  ;;; This is the one channel by which a value reaches a program WITHOUT
  ;;; passing through the knowledge base, which is why it is worth having
  ;;; and not only convenience: a consulted file becomes clauses, and
  ;;; clauses become rows. A secret that must not become a row -- a
  ;;; node's signing key, a token -- has nowhere else to arrive from.
  ;;; source_location(-File, -Line) (2.16.0), swipl's: the file and the line
  ;;; of the directive a load is running, the file by its absolute path, and
  ;;; a failure anywhere else -- in the program, and in an initialization/1
  ;;; goal run after its file was read. print_message/2 asks it for an
  ;;; error's and a warning's location line. The path is swipl's (3.4.0):
  ;;; `.' and `..' folded away and no link resolved (`coco_f_normalise'),
  ;;; the name the load's own reports give; through 3.3.0 `realpath'.
  (func coco_b_source_location ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (char full [4096]))
          (if (== (-> m sloc_file) nil) (return 0))
          (if (not (coco_f_normalise (-> m sloc_file) full (sizeof full)))
              (snprintf full (sizeof full) "%s" (-> m sloc_file)))
          (if (not (coco_m_unify_atom e (coco_m_arg e g 0) full)) (return 0))
          (return (coco_m_unify_int e (coco_m_arg e g 1) (cast i64 (-> m sloc_line))))))

  ;;; '$load_context'(+Key, -Value) (3.14.0), prolog_load_context/2's C
  ;;; half: `file', the file being read (an included one itself), and
  ;;; `source', the file the load reads (an included file's includer), each
  ;;; by its absolute path as source_location/2 gives it, and
  ;;; `term_position', '$stream_position'(Char, Line, LinePos, Byte) of the
  ;;; term in hand's first character, swipl's -- each failing where no load
  ;;; is reading, as swipl's do
  (func coco_b_load_context ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t k . #'(coco_deref m (coco_m_arg e g 0)))
              (const char * kn . nil) (const char * f . nil) (char full [4096]))
          (if (not (coco_is_callable m k)) (return 0))
          (if (!= (coco_arity m k) 0) (return 0))
          (set kn (coco_atom_name m (coco_name_of m k)))
          (cond
            ((== 0 (strcmp kn "file")) (set f (-> m sloc_file)))
            ((== 0 (strcmp kn "source")) (set f (-> m sloc_src))))
          (if (!= f nil)
              (block
               (if (not (coco_f_normalise f full (sizeof full)))
                   (snprintf full (sizeof full) "%s" f))
               (return (coco_m_unify_atom e (coco_m_arg e g 1) full))))
          (if (and (== 0 (strcmp kn "term_position")) (!= (-> m sloc_text) nil))
              ;; characters and the line's characters counted over the
              ;; text to the term's first byte: a byte that is no UTF-8
              ;; continuation starts a character
              (let ((const char * s . #'(-> m sloc_text)) (size_t off . #'(-> m sloc_off))
                    (i64 ch . 0) (i64 col . 0) (size_t i . 0) (size_t pa [4]) (int c . 0))
                (while (< i off)
                  (set c (bitand (cast int (nth i s)) 255))
                  (if (!= (bitand c 192) 128)
                      (block (set ch (+ ch 1))
                             (set col (? (== c 10) 0 (+ col 1)))))
                  (set i (+ i 1)))
                (set (nth 0 pa) (coco_new_int m ch))
                (set (nth 1 pa) (coco_new_int m (cast i64 (-> m sloc_line))))
                (set (nth 2 pa) (coco_new_int m col))
                (set (nth 3 pa) (coco_new_int m (cast i64 off)))
                (return (? (coco_m_unify e (coco_m_arg e g 1)
                                         (coco_make m "$stream_position" 4 pa)) 1 0))))
          (return 0)))

  ;;; A NAME AND A VALUE ARE SWIPL'S CVT_ALL TEXT (3.0.0, `coco_tx_get'):
  ;;; an atom, a number, a string, a list of codes or of characters, and
  ;;; anything else swipl's error, type_error(text, T); through 2.16
  ;;; type_error(atom, T), a list of characters refused and a float too.
  (func coco_b_getenv ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf nb) (int r . #'(coco_tx_get e (coco_m_arg e g 0) 31 (aof nb))))
          (if (!= r 1) (return r))
          (let ((const char * v . #'(getenv (coco_tx_s (aof nb)))))
            (coco_sb_free (aof nb))
            (if (== v nil) (return 0))
            (return (coco_m_unify_atom e (coco_m_arg e g 1) v)))))

  (func coco_b_setenv ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf nb) (coco_strbuf vb) (int r . 0))
          (set r (coco_tx_get e (coco_m_arg e g 0) 31 (aof nb)))
          (if (!= r 1) (return r))
          (set r (coco_tx_get e (coco_m_arg e g 1) 31 (aof vb)))
          (if (!= r 1) (block (coco_sb_free (aof nb)) (return r)))
          (set r (? (== 0 (setenv (coco_tx_s (aof nb)) (coco_tx_s (aof vb)) 1)) 1 0))
          (coco_sb_free (aof nb))
          (coco_sb_free (aof vb))
          (return r)))

  (func coco_b_unsetenv ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf nb) (int r . #'(coco_tx_get e (coco_m_arg e g 0) 31 (aof nb))))
          (if (!= r 1) (return r))
          (unsetenv (coco_tx_s (aof nb)))
          (coco_sb_free (aof nb))
          (return 1)))

  ;;; TAB EVALUATES ITS ARGUMENT (3.0.0), as swipl's
  ;;; PL_eval_expression_to_int64(): `tab(1+1)' writes two, `tab(a)' is
  ;;; type_error(evaluable, a/0), and an answer that is no integer
  ;;; type_error(integer_expression, E) of the expression. Through 2.16 the
  ;;; argument had to be an integer, type_error(integer, E).
  (func coco_b_tab ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 n . 0) (int isf . 0) (double fv . 0.0)
              (int rc . #'(coco_arith e (coco_m_arg e g 0) (aof isf) (aof n) (aof fv) 0)))
          (if (== rc 3) (return (coco_type_error e "expression" (coco_m_arg e g 0))))
          (if (!= rc 1) (return rc))
          (if (!= isf 0)
              (return (coco_m_type_error e "integer_expression" (coco_m_arg e g 0))))
          (for ((i64 i . 0)) (< i n) ((++ i)) (coco_out_putc stdout 32))
          (return 1)))

  ;;; ---- the clause database ----------------------------------------------

  ;;; '$unbind_template'(T) (3.19.0, swipl's), which aggregate.pl's foreach/2
  ;;; asks after each goal it proves: every argument of the compound T is
  ;;; unbound again and stays T's. An argument that names an older cell names
  ;;; the variable it was made from (`=..' writes each argument dereferenced),
  ;;; which is unbound; one that names a newer one was the variable itself,
  ;;; bound since, and is unbound in place -- so a constant a clause's body
  ;;; wrote, which stands after the template too, is unbound where swipl's
  ;;; raises. swipl's unbinds the argument cells as they are. Through
  ;;; 3.18.0 there was none, and foreach/2 raised.
  (func coco_b_unbind_template ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t t . #'(coco_deref (coco_m_machine e) (coco_m_arg e g 0))))
          (if (not (coco-tag-is FUN (nth t (-> m heap)))) (return 1))
          (let ((u32 n . #'(coco_arity m t)))
            ;; an argument that never was a variable is no template, swipl's
            ;; type_error(template, T), asked of every argument first: one in
            ;; its own cell, or one naming an older cell that holds a value
            ;; and was no variable (=../2 makes each argument name its cell)
            (for ((u32 i . 0)) (< i n) ((++ i))
              (let ((size_t s . #'(+ t (+ (cast size_t i) 1))) (u64 c . 0))
                (set c (nth s (-> m heap)))
                (if (not (coco-tag-is REF c)) (return (coco_m_type_error e "template" t)))
                (if (and (< (cast size_t (coco-payload c)) s)
                         (not (coco-tag-is REF (nth (cast size_t (coco-payload c)) (-> m heap)))))
                    (return (coco_m_type_error e "template" t)))))
            (for ((u32 i . 0)) (< i n) ((++ i))
              (let ((size_t s . #'(+ t (+ (cast size_t i) 1))) (u64 c . 0))
                (set c (nth s (-> m heap)))
                (if (coco-tag-is REF c)
                    (let ((size_t x . #'(cast size_t (coco-payload c))))
                      (if (< x s)
                          (set (nth x (-> m heap)) (coco-cell REF x))
                          (set (nth s (-> m heap)) (coco-cell REF s))))))))
          (return 1)))

  ;;; '$skip_list'(Length, List, Tail) (3.19.0, swipl's, which ordsets.pl
  ;;; asks): the list cells of List skipped and what stands after them, a
  ;;; cycle walked by swipl's own rule -- Brent's, the slow cell moved at
  ;;; each power of two -- so a cyclic list counts and ends where swipl's does
  (func coco_b_skip_list ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t l . #'(coco_deref (coco_m_machine e) (coco_m_arg e g 1)))
              (size_t s . 0) (i64 len . 0) (size_t mark . #'(coco_m_mark e)))
          (set s l)
          (if (coco_is_cons m l)
              (let ((i64 power . 1) (i64 lam . 0) (int more . 1))
                (while more
                  (if (== power lam) (block (set s l) (set power (* power 2)) (set lam 0)))
                  (set lam (+ lam 1))
                  (set len (+ len 1))
                  (set l (coco_deref m (coco_arg m l 1)))
                  (if (or (not (coco_is_cons m l)) (== l s)) (set more 0)))))
          (if (not (coco_m_unify_int e (coco_m_arg e g 0) len)) (return 0))
          (if (not (coco_m_unify e (coco_m_arg e g 2) l))
              (block (coco_m_undo e mark) (return 0)))
          (return 1)))

  ;;; Every predicate the store DEFINES, as Name/Arity: one with a clause, or
  ;;; one declared dynamic (an assert declares it too), discontiguous or
  ;;; multifile (3.1.0), as SWI counts them.
  ;;; The table holds more -- a call, or `clause/2', makes an entry for a
  ;;; name it looks up, and a call to it still raises `existence_error' --
  ;;; and those are left out, as are the library's own predicates:
  ;;; `current_predicate/1' is about the program. The program's own files
  ;;; are the program's (`own', 1.10.28): `-s FILE', ensure_loaded/1 and
  ;;; use_module/1 of a path load them as modules, and through 1.10.27 their
  ;;; predicates were left out with the library's.
  (func coco_b_predicates ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t * v . nil) (size_t n . 0) (size_t cap . 0) (size_t out))
          (coco_store_warm st)
          (for ((size_t i . 0)) (< i ($ (cof st) npreds)) ((++ i))
            (if (and (or (not ($ (nth i ($ (cof st) preds)) library))
                         ($ (nth i ($ (cof st) preds)) own))
                     (or (> (coco_pred_live (aof (nth i ($ (cof st) preds)))) 0)
                         ($ (nth i ($ (cof st) preds)) dynamic)
                         ($ (nth i ($ (cof st) preds)) declared)))
                (block
                 (if (>= n cap)
                     (let ((size_t ncap . #'(? (== cap 0) 16 (* cap 2)))
                           (size_t * nb))
                       (set nb (cast (size_t *) (realloc v (* ncap (sizeof size_t)))))
                       (if (== nb nil) break)
                       (set v nb)
                       (set cap ncap)))
                 (set (nth n v)
                      (coco_make2 m "/"
                                (coco_new_atom_id m ($ (nth i ($ (cof st) preds)) name))
                                (coco_new_int m (cast i64 ($ (nth i ($ (cof st) preds)) arity)))))
                 (set n (+ n 1)))))
          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 0) out))))

  (coco-emit-claims coco_b_tier1_claims *builtins-predicates* *lists-predicates*
                    *files-predicates* *dcg-predicates* *library-predicates*
                    *zigurat-predicates*)
  (coco-emit-claims coco_b_construct_claims *callable-constructs*)
  (coco-emit-claims coco_b_green_claims *green-predicates*)
  ;; swipl's properties of a system or library predicate (3.41.0)
  (coco-emit-swipl-props coco_swipl_props)

  ;;; WHAT THE TRACER TAKES FOR THE SYSTEM'S C (3.27.0, installed as
  ;;; `coco_sysclaims_hook'): the rows above and green's, library(async)'s C
  ;;; half -- what swipl's system defines in C, whose call the printer hides
  ;;; where a library's clause makes it. Not the load's claims: a program
  ;;; file's clause for a green name is no take-over
  (func coco_b_system_claims ((const char * name) (u32 arity)) (out int)
        (return (or (coco_b_tier1_claims name arity)
                    (coco_b_green_claims name arity))))

  ;;; WHAT A LOAD ASKS OF A PROGRAM FILE'S CLAUSE (3.1.0, installed as
  ;;; `coco_claims_hook'): whether a compiled-in module or a construct
  ;;; implements its name and arity, for `coco_claim_kind' to refuse an ISO
  ;;; one and take any other over.
  (func coco_b_claims ((const char * name) (u32 arity)) (out int)
        (return (or (coco_b_tier1_claims name arity)
                    (coco_b_construct_claims name arity))))

  ;;; ---- what an unknown procedure is near: swipl's dwim (3.3.0) ----------
  ;;;
  ;;; AN UNKNOWN PROCEDURE'S MESSAGE NAMES THE PREDICATES OF A LIKE NAME, as
  ;;; swipl's does: `However, there are definitions for:' and a line each
  ;;; (boot/messages.pl's unknown_proc_msg//1). Which ones is swipl's rule,
  ;;; read off its source (boot/dwim.pl and pl-dwim.c, 9.0.4):
  ;;;
  ;;;   - the goal's own predicate, where there is one, and nothing else:
  ;;;     an atom's is Name/0, so `nl/3' is answered `nl/0', never `nl/1',
  ;;;     and a compound's its own, so `foo(x)/1' is answered `foo/1'
  ;;;     (dwim_predicate_list/2's first clause);
  ;;;   - else every defined predicate whose name dwim-matches the goal's,
  ;;;     whatever its arity: the system's first, then the program's, each by arity and
  ;;;     then by name, and never a `$' name.
  ;;;
  ;;; The system's are swipl's (lib/swipl-system.cicili, 662 names) that
  ;;; cocolog defines too: a construct, a row of the engine or of a
  ;;; compiled-in module, or a library's clauses. So append/3 and maplist/3,
  ;;; which swipl keeps in its libraries and lists only once their autoload
  ;;; has run, are not among them. The program's are what
  ;;; current_predicate/1 answers, from the predicates the store holds.

  ;;; THE MATCH, pl-dwim.c's dwimMatch. Past the names' common start, with
  ;;; the rests at most five apart in length and each name at least three
  ;;; long: one character differs, or two next to each other are swapped,
  ;;; or one is inserted. Or, over the whole names, the sub-words are
  ;;; separated differently (`aB', `a_b', `ab'), or two sub-words next to
  ;;; each other are swapped (`exists_file', `file_exists'). A byte past
  ;;; 127 is neither small nor capital; swipl's table knows Latin-1's, which
  ;;; it keeps such a name in.
  (static) (inline)
  (func coco_dwim_small ((int c)) (out int) (return (and (>= c 97) (<= c 122))))

  (static) (inline)
  (func coco_dwim_capital ((int c)) (out int) (return (and (>= c 65) (<= c 90))))

  (static) (inline)
  (func coco_dwim_lower ((int c)) (out int) (return (? (coco_dwim_capital c) (+ c 32) c)))

  (static) (inline)
  (func coco_dwim_at ((const char * s) (size_t i)) (out int)
        (return (cast int (cast uchar (nth i s)))))

  ;; oneTypo: the rests, of one length, differ in their first character
  (static)
  (func coco_dwim_typo ((const char * s1) (const char * s2)) (out int)
        (return (or (== (nth 1 s1) (cast char 0)) (== 0 (strcmp (+ s1 1) (+ s2 1))))))

  ;; twoTransposed: the rests begin with the same two characters, swapped
  (static)
  (func coco_dwim_swapped ((const char * s1) (const char * s2)) (out int)
        (return (and (!= (nth 1 s1) (cast char 0))
                     (and (== (nth 0 s1) (nth 1 s2)) (== (nth 1 s1) (nth 0 s2)))
                     (or (== (nth 2 s1) (cast char 0)) (== 0 (strcmp (+ s1 2) (+ s2 2)))))))

  ;; differentSeparated: the same first character, then the same characters
  ;; with a `_' passed over and a capital after a small letter read small
  (static)
  (func coco_dwim_separated ((const char * s1) (const char * s2)) (out int)
        (let ((size_t i . 0) (size_t j . 0) (int c1 . 0) (int c2 . 0))
          (if (or (!= (nth 0 s1) (nth 0 s2)) (== (nth 0 s1) (cast char 0))) (return 0))
          (set i 1)
          (set j 1)
          (set c1 (coco_dwim_at s1 i))
          (set c2 (coco_dwim_at s2 j))
          (while (and (!= c1 0) (== c1 c2))
            (set i (+ i 1))
            (set c1 (coco_dwim_at s1 i))
            (if (== c1 (coco-ch "_"))
                (block (set i (+ i 1)) (set c1 (coco_dwim_at s1 i)))
              (if (and (coco_dwim_small (coco_dwim_at s1 (- i 1))) (coco_dwim_capital c1))
                  (set c1 (coco_dwim_lower c1))))
            (set j (+ j 1))
            (set c2 (coco_dwim_at s2 j))
            (if (== c2 (coco-ch "_"))
                (block (set j (+ j 1)) (set c2 (coco_dwim_at s2 j)))
              (if (and (coco_dwim_small (coco_dwim_at s2 (- j 1))) (coco_dwim_capital c2))
                  (set c2 (coco_dwim_lower c2)))))
          (return (and (== c1 0) (== c2 0)))))

  ;; subWord: the sub-word S begins, read small at its start, into STORE
  ;; (cut at CAP); where the next begins, past a `_' that ends this one
  (static)
  (func coco_dwim_subword ((const char * s) (char * store) (size_t cap)) (out const char *)
        (let ((size_t k . 0) (size_t i . 1))
          (set (nth 0 store) (cast char (coco_dwim_lower (coco_dwim_at s 0))))
          (set k 1)
          (while 1
            (if (== (nth i s) (cast char 0))
                (block (set (nth k store) (cast char 0)) (return (+ s i))))
            (if (== (coco_dwim_at s i) (coco-ch "_"))
                (block (set (nth k store) (cast char 0)) (return (+ s (+ i 1)))))
            (if (and (coco_dwim_small (coco_dwim_at s (- i 1))) (coco_dwim_capital (coco_dwim_at s i)))
                (block (set (nth k store) (cast char 0)) (return (+ s i))))
            (if (< (+ k 1) cap)
                (block (set (nth k store) (nth i s)) (set k (+ k 1))))
            (set i (+ i 1)))))

  ;; subwordsTransposed: sub-word by sub-word the same, but for one pair
  ;; next to each other that is swapped
  (static)
  (func coco_dwim_words_swapped ((const char * s1) (const char * s2)) (out int)
        (let ((char a1 [256]) (char b1 [256]) (char a2 [256]) (char b2 [256]))
          (while (and (!= (nth 0 s1) (cast char 0)) (!= (nth 0 s2) (cast char 0)))
            (set s1 (coco_dwim_subword s1 a1 (sizeof a1)))
            (set s2 (coco_dwim_subword s2 a2 (sizeof a2)))
            (if (!= 0 (strcmp a1 a2))
                (block
                  (if (or (== (nth 0 s1) (cast char 0)) (== (nth 0 s2) (cast char 0))) (return 0))
                  (set s1 (coco_dwim_subword s1 b1 (sizeof b1)))
                  (set s2 (coco_dwim_subword s2 b2 (sizeof b2)))
                  (if (or (!= 0 (strcmp a1 b2)) (!= 0 (strcmp b1 a2))) (return 0)))))
          (return (and (== (nth 0 s1) (cast char 0)) (== (nth 0 s2) (cast char 0))))))

  (static)
  (func coco_dwim_match ((const char * str1) (const char * str2)) (out int)
        (let ((const char * s1 . nil) (const char * s2 . nil) (size_t cl . 0)
              (size_t l1 . 0) (size_t l2 . 0))
          (set s1 str1)
          (set s2 str2)
          (while (and (!= (nth 0 s1) (cast char 0)) (== (nth 0 s1) (nth 0 s2)))
            (set s1 (+ s1 1))
            (set s2 (+ s2 1))
            (set cl (+ cl 1)))
          (set l1 (strlen s1))
          (set l2 (strlen s2))
          (if (or (> l1 (+ l2 5)) (> l2 (+ l1 5))) (return 0))
          (if (and (== l1 0) (== l2 0)) (return 1))
          (if (or (< (+ cl l1) 3) (< (+ cl l2) 3)) (return 0))
          (if (and (== l1 l2) (coco_dwim_typo s1 s2)) (return 1))
          (if (and (== l1 l2) (coco_dwim_swapped s1 s2)) (return 1))
          (if (or (and (== l2 (+ l1 1)) (== 0 (strcmp s1 (+ s2 1))))
                  (and (== l1 (+ l2 1)) (== 0 (strcmp s2 (+ s1 1)))))
              (return 1))
          (if (coco_dwim_separated str1 str2) (return 1))
          (return (coco_dwim_words_swapped str1 str2))))

  ;;; ONE PREDICATE NEAR THE NAME, and the list being made of them
  (struct coco_dwim_hit
    (member const char * name)
    (member u32 arity)
    (member int sys))

  (struct coco_dwim_acc
    (member coco_machine * m)
    (member coco_store * st)
    (member const char * q)
    (member coco_dwim_hit * v)
    (member size_t n)
    (member size_t cap)
    ;; the arity of the goal Q names: its own predicate is asked first
    (member u32 zar))

  ;; a growth refused leaves the list as it is: a shorter list, never a
  ;; wrong one
  (static)
  (func coco_dwim_add ((coco_dwim_acc * a) (const char * name) (u32 arity) (int sys))
        (if (>= (-> a n) (-> a cap))
            (let ((size_t ncap . #'(? (== (-> a cap) 0) 16 (* (-> a cap) 2)))
                  (coco_dwim_hit * grown . nil))
              (set grown (cast (coco_dwim_hit *) (realloc (-> a v) (* ncap (sizeof coco_dwim_hit)))))
              (if (== grown nil) (return))
              (set (-> a v) grown)
              (set (-> a cap) ncap)))
        (set ($ (nth (-> a n) (-> a v)) name) name)
        (set ($ (nth (-> a n) (-> a v)) arity) arity)
        (set ($ (nth (-> a n) (-> a v)) sys) sys)
        (set (-> a n) (+ (-> a n) 1)))

  ;; the atom NAME is, plus one, or 0 where no atom has the name -- and
  ;; then no predicate does. A probe of the table as `coco_intern_h' makes
  ;; one, appending nothing.
  (static)
  (func coco_dwim_atom ((coco_machine * m) (const char * name)) (out u64)
        (let ((size_t len . #'(strlen name)) (u64 h . #'(coco_hash name len)) (size_t j . 0))
          (coco_tbl_sync m)
          (set j (cast size_t (bitand h (cast u64 (- (-> m atom_bucket_cap) 1)))))
          (while (!= (nth j (-> m atom_buckets)) 0)
            (let ((size_t id . #'(- (nth j (-> m atom_buckets)) 1)))
              (if (and (== ($ (nth id (-> m atoms)) hash) h)
                       (and (== ($ (nth id (-> m atoms)) len) len)
                            (== (memcmp ($ (nth id (-> m atoms)) name) name len) 0)))
                  (return (+ (cast u64 id) 1))))
            (set j (bitand (+ j 1) (- (-> m atom_bucket_cap) 1))))
          (return 0)))

  ;; a predicate of the store that is defined, as current_predicate/1 counts
  ;; one -- a clause, or a declaration -- and the program's own unless LIB
  (static)
  (func coco_dwim_defined ((coco_pred * p) (int lib)) (out int)
        (return (and (or lib (or (not (-> p library)) (-> p own)))
                     (or (> (coco_pred_live p) 0) (or (-> p dynamic) (-> p declared))))))

  ;; whether cocolog defines NAME/ARITY: a construct, a row of a compiled-in
  ;; module or of the engine, or a predicate of the store, a library's too
  (static)
  (func coco_dwim_has ((coco_dwim_acc * a) (const char * name) (u32 arity)) (out int)
        (if (or (coco_b_construct_claims name arity) (coco_b_tier1_claims name arity)) (return 1))
        (let ((u64 id1 . #'(coco_dwim_atom (-> a m) name)) (size_t pi . 0))
          (if (== id1 0) (return 0))
          (if (>= (coco_builtin_index (-> a m) (- id1 1) arity) 0) (return 1))
          (if (== (-> a st) nil) (return 0))
          (set pi (coco_pred_find (-> a st) (- id1 1) arity))
          (if (>= pi (-> (-> a st) npreds)) (return 0))
          (return (coco_dwim_defined (aof (nth pi (-> (-> a st) preds))) 1))))

  ;; one of swipl's system predicates, kept when its name is near and
  ;; cocolog defines it
  (static)
  (func coco_dwim_offer ((coco_dwim_acc * a) (const char * name) (u32 arity))
        (if (and (coco_dwim_match (-> a q) name) (coco_dwim_has a name arity))
            (coco_dwim_add a name arity 1)))

  (static) (coco-emit-dwim-system coco_dwim_system)

  ;; the program's predicates whose names are near
  (static)
  (func coco_dwim_program ((coco_dwim_acc * a))
        (let ((coco_store * st . #'(-> a st)))
          (if (== st nil) (return))
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (let ((coco_pred * p . #'(aof (nth i (-> st preds))))
                  (const char * name . nil))
              (if (coco_dwim_defined p 0)
                  (block
                    (set name (coco_atom_name (-> a m) (-> p name)))
                    (if (and (!= (nth 0 name) (coco-ch "$")) (coco_dwim_match (-> a q) name))
                        (coco_dwim_add a name (-> p arity) 0))))))))

  ;; the system's before the program's, each by arity, then by name: the
  ;; standard order of the `M:Head' terms swipl's setof/3 collects
  (static)
  (func coco_dwim_cmp ((const void * x) (const void * y)) (out int)
        (let ((const coco_dwim_hit * a . #'(cast (const coco_dwim_hit *) x))
              (const coco_dwim_hit * b . #'(cast (const coco_dwim_hit *) y)))
          (if (!= (-> a sys) (-> b sys)) (return (? (-> a sys) -1 1)))
          (if (!= (-> a arity) (-> b arity)) (return (? (< (-> a arity) (-> b arity)) -1 1)))
          (return (strcmp (-> a name) (-> b name)))))

  ;; THE LIST, in swipl's order, into A, whose V the caller frees
  (static)
  (func coco_dwim_collect ((coco_dwim_acc * a))
        (if (coco_dwim_has a (-> a q) (-> a zar))
            (block (coco_dwim_add a (-> a q) (-> a zar) 0) (return)))
        (coco_dwim_system a)
        (coco_dwim_program a)
        (if (> (-> a n) 1)
            (qsort (-> a v) (-> a n) (sizeof coco_dwim_hit) coco_dwim_cmp)))

  ;; Name/Arity, as a term
  (static)
  (func coco_dwim_pi ((coco_machine * m) (coco_dwim_hit * h)) (out size_t)
        (return (coco_make2 m "/" (coco_new_atom m (-> h name))
                            (coco_new_int m (cast i64 (-> h arity))))))

  ;;; THE LINES AN UNKNOWN PROCEDURE'S MESSAGE ENDS ON, as the engine writes
  ;;; it (installed as `coco_dwim_hook', for lib/solve-control.cicili's
  ;;; `coco_error_text'): none where nothing is near the name NID, of the
  ;;; goal of ZAR arguments.
  (func coco_b_dwim_text ((coco_machine * m) (coco_store * st) (u64 nid) (u32 zar)
                          (coco_strbuf * b))
        (let ((coco_dwim_acc a . '{ nil nil nil nil 0 0 0 }))
          (set ($ a m) m)
          (set ($ a zar) zar)
          (set ($ a st) st)
          (set ($ a q) (coco_atom_name m nid))
          (coco_dwim_collect (aof a))
          (if (> ($ a n) 0)
              (block
                (coco_sb_put b "\n  However, there are definitions for:")
                (for ((size_t i . 0)) (< i ($ a n)) ((++ i))
                  (coco_sb_put b "\n        ")
                  (coco_write_term m b (coco_dwim_pi m (aof (nth i ($ a v)))) 1 0))))
          (free ($ a v))))

  ;;; '$dwim_predicates'(Head, PIs): the same list for print_message/2's
  ;;; `'$pm_unknown_proc'//1', Name/Arity terms in swipl's order, of the goal
  ;;; HEAD names -- an atom or a compound; anything else fails.
  (func coco_b_dwim_predicates ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (u32 zar . 0)
              (const char * q . #'(coco_m_functor e (coco_m_arg e g 0) (aof zar)))
              (coco_dwim_acc a . '{ nil nil nil nil 0 0 0 })
              (size_t * v . nil) (size_t out . 0))
          (if (== q nil) (return 0))
          (set ($ a m) m)
          (set ($ a zar) zar)
          (set ($ a st) (-> e st))
          (set ($ a q) q)
          (coco_dwim_collect (aof a))
          (set v (cast (size_t *) (malloc (* (+ ($ a n) 1) (sizeof size_t)))))
          (if (== v nil)
              (block (free ($ a v)) (return (coco_m_resource_error e "memory"))))
          (for ((size_t i . 0)) (< i ($ a n)) ((++ i))
            (set (nth i v) (coco_dwim_pi m (aof (nth i ($ a v))))))
          (set out (coco_m_list e v ($ a n)))
          (free v)
          (free ($ a v))
          (return (coco_m_unify e (coco_m_arg e g 1) out))))

  ;;; ---- predicate_property/2 (1.10.28; swipl 9.0.4's since 3.41.0) --------
  ;;;
  ;;; '$pred_props'(Head, Props): the properties of the predicate Head names,
  ;;; in the order swipl's boot/syspred.pl lists them ('$predicate_property'/2),
  ;;; or a failure where nothing defines it or Head is no callable term, as
  ;;; swipl's. Module:Head names Head: there is one namespace.
  ;;;
  ;;; A PREDICATE OF THE SYSTEM'S OR A LIBRARY'S -- a construct, a C row of
  ;;; the engine or of a compiled-in module, or a library's clauses the
  ;;; program gave none of its own -- answers what swipl answers of it, from
  ;;; lib/swipl-props.cicili's table (`coco_swipl_props'): built_in,
  ;;; imported_from(M), transparent, meta_predicate(Spec), notrace, nodebug,
  ;;; noprofile, ssu and iso. What describes how swipl
  ;;; stores one is none of cocolog's: its file/1 and line_count/1, size/1,
  ;;; last_modified_generation/1, indexed/1. FOREIGN is cocolog's own: what
  ;;; clause/2 refuses to show and listing/1 writes as `%   Foreign:' -- a
  ;;; construct, a C row, a library's clauses where swipl writes the
  ;;; predicate in C (`coco_det_foreign_name') -- has no clauses to count;
  ;;; the rest is interpreted, with its counts.
  ;;;
  ;;; ONE THE TABLE HAS NO ROW FOR -- the program's own, or cocolog's --
  ;;; answers what its file and its declarations said: built_in for a
  ;;; construct or a C row, public, non_terminal, dynamic or static,
  ;;; volatile, thread_local, multifile, discontiguous, imported_from(M) for
  ;;; a module/2 file's, transparent (module_transparent/1, or a meta argument
  ;;; a module is given to), meta_predicate(Spec) (`pmeta'), file(F) and
  ;;; line_count(L) of its first clause a file read (`pfile', `pline'),
  ;;; nodebug for a construct, a C row or one read under generate_debug_info
  ;;; false, its counts, ssu for a single-sided one. A module loaded from a
  ;;; `.so' is not answered: its dispatcher is all that knows its names, and
  ;;; asking it is calling it.

  ;;; META_PREDICATE(Spec)'s Spec: NID of the arguments SPEC writes, a
  ;;; character each (a digit, `/' for `//', or the atom of the character)
  (static)
  (func coco_b_meta_term ((coco_machine * m) (u64 nid) (const char * spec)) (out size_t)
        (let ((size_t k . #'(strlen spec)) (size_t * a . nil) (size_t t . 0))
          ;; a head of no arguments, `meta_predicate zero' (3.46.0)
          (if (== k 0) (return (coco_new_atom_id m nid)))
          (set a (cast (size_t *) (malloc (* (+ k 1) (sizeof size_t)))))
          (if (== a nil) (return (coco_new_atom_id m nid)))
          (for ((size_t i . 0)) (< i k) ((++ i))
            (let ((int ch . #'(cast int (nth i spec))) (char one [2]))
              (cond
                ((and (>= ch 48) (<= ch 57)) (set (nth i a) (coco_new_int m (cast i64 (- ch 48)))))
                ((== ch 47) (set (nth i a) (coco_new_atom m "//")))
                (#t (block (set (nth 0 one) (cast char ch)) (set (nth 1 one) (cast char 0))
                           (set (nth i a) (coco_new_atom m one)))))))
          (set t (coco_make m (coco_atom_name m nid) (cast u32 k) a))
          (free a)
          (return t)))

  ;;; Whether a meta argument of SPEC is one a module is given to: a digit,
  ;;; `:', `^' or `//', the declaration making the predicate transparent
  (static)
  (func coco_b_meta_module ((const char * spec)) (out int)
        (if (== spec nil) (return 0))
        (for ((size_t i . 0)) (!= (nth i spec) (cast char 0)) ((++ i))
          (let ((int ch . #'(cast int (nth i spec))))
            (if (or (and (>= ch 48) (<= ch 57)) (or (== ch 58) (or (== ch 94) (== ch 47))))
                (return 1))))
        (return 0))

  ;;; WHETHER THE PROGRAM GAVE P A CLAUSE OF ITS OWN: a live one no module's
  ;;; read put there (`muted' 0) -- consulted or asserted beside a library's
  (static)
  (func coco_pred_prog_clause ((coco_pred * p)) (out int)
        (if (== (-> p muted) nil) (return 0))
        (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
          (if (and (not (coco_pred_dead p i)) (== (nth i (-> p muted)) 0)) (return 1)))
        (return 0))

  ;;; WHAT USER DOES NOT SEE OF A LIBRARY'S PREDICATE (3.48.0), the row's
  ;;; FL (its flags) of NAME/ARITY: a carried library's own predicate (4096:
  ;;; a helper, `sandbox:safe_meta/2'), and an export swipl's autoloader
  ;;; does not reach (8192: library(dcg/basics)'s and (dcg/high_order)'s)
  ;;; the program has not loaded. Neither where the program gave it a
  ;;; clause of its own (PROG).
  (static)
  (func coco_pp_unseen ((int fl) (int prog) (const char * impl) (const char * name) (u32 ar)) (out int)
        (if prog (return 0))
        (if (bitand fl 4096) (return 1))
        (if (not (bitand fl 8192)) (return 0))
        (return (not (coco_imp_has_locked impl name ar))))

  (func coco_b_pred_props ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t h . #'(coco_m_arg e g 0))
              (size_t v [32]) (size_t n . 0) (u64 nid . 0) (u32 ar . 0)
              (int c . 0) (int con . 0) (int sys . 0) (int fgn . 0) (int sw . 0) (int fl . 0)
              (const char * imp . "") (const char * impl . "") (const char * spec . "")
              (coco_pred * p . nil) (size_t rules . 0) (size_t lasts . 0) (size_t live . 0))
          (if (coco_is_compound2 m h ":") (set h (coco_deref m (coco_arg m h 1))))
          (if (coco_m_is_var e h) (return (coco_m_instantiation_error e)))
          ;; no callable term names a predicate: swipl's fails (3.41.0;
          ;; through 3.40.0 type_error(callable, H))
          (if (not (coco_is_callable m h)) (return 0))
          (set nid (coco_name_of m h))
          (set ar (coco_arity m h))
          (set c (or (>= (coco_builtin_index m nid ar) 0)
                     (coco_b_tier1_claims (coco_atom_name m nid) ar)))
          (set con (coco_b_construct_claims (coco_atom_name m nid) ar))
          ;; one a program file took over is the program's (3.1.0)
          (if (coco_pred_taken st nid ar) (block (set c 0) (set con 0)))
          (if (or c con)
              (block (set sys 1) (set fgn 1))
            (let ((size_t pi . #'(coco_pred_intern st nid ar)))
              (if (>= pi ($ (cof st) npreds)) (return 0))
              (if (not (coco_pred_ensure st pi)) (return (coco_fetch_error e)))
              (set p (aof (nth pi ($ (cof st) preds))))
              (if (and (== (coco_pred_live p) 0) (not (-> p dynamic)) (not (-> p declared)))
                  (return 0))
              (let ((size_t mark . #'($ (cof m) heap_len)) (u64 tid . #'(coco_intern m "true")))
                ;; a rule is a clause whose body is not `true'; the predicate
                ;; read through its index each time round, as after. A
                ;; clause retracted while a call on it is open is none of
                ;; them.
                (for ((size_t i . 0)) (< i ($ (nth pi ($ (cof st) preds)) nclauses)) ((++ i))
                  (if (coco_pred_dead (aof (nth pi ($ (cof st) preds))) i) continue)
                  (let ((size_t t . #'(coco_store_get m st (nth i ($ (nth pi ($ (cof st) preds)) clauses))))
                        (size_t ch . 0) (size_t cb . 0))
                    (coco_clause_parts m t (aof ch) (aof cb))
                    ;; a single-sided predicate's last clause is none of them (3.19.0)
                    (if (and (!= cb 0) (== (coco_ssu_body m cb) (cast size_t -1)))
                        (block (set lasts (+ lasts 1)) (set cb 0)))
                    (if (and (!= cb 0)
                             (not (and (coco-tag-is ATOM (nth (coco_deref m cb) (-> m heap)))
                                       (== (coco_name_of m (coco_deref m cb)) tid))))
                        (set rules (+ rules 1)))
                    (set (-> m heap_len) mark))))
              ;; the store may have moved under the reads: read P again
              (set p (aof (nth pi ($ (cof st) preds))))
              (set live (coco_pred_live p))
              (set sys (and (-> p library) (not (-> p own))))
              (set fgn (and sys (coco_det_foreign_name (coco_atom_name m nid) ar)))))
          (if sys
              (block
                (set sw (coco_swipl_props (coco_atom_name m nid) ar (aof imp) (aof impl) (aof spec)))
                (if sw (set fl (- sw 1)))))
          ;; what user does not see is no predicate of user's (3.48.0)
          (if (and sw (!= p nil)
                   (coco_pp_unseen fl (coco_pred_prog_clause p) impl (coco_atom_name m nid) ar))
              (return 0))
          ;; swipl's order
          (if (not fgn) (coco-pp-add "interpreted"))
          (coco-pp-add "visible")
          (if (? sw (bitand fl 1) (or c con)) (coco-pp-add "built_in"))
          (if (and (!= p nil) (bitand (-> p pattrs) 1)) (coco-pp-add "public"))
          ;; a library's grammar rules too: swipl's non-terminals of the
          ;; system and the libraries are those of the two DCG libraries,
          ;; which cocolog reads from swipl's own files
          (if (and (!= p nil) (bitand (-> p pattrs) 16)) (coco-pp-add "non_terminal"))
          (if fgn (coco-pp-add "foreign"))
          (coco-pp-add (? (and (!= p nil) (-> p dynamic)) "dynamic" "static"))
          (if (!= p nil)
              (block
                (if (bitand (-> p pattrs) 2) (coco-pp-add "volatile"))
                (if (bitand (-> p pattrs) 8) (coco-pp-add "thread_local"))
                (if (bitand (-> p declared) 2) (coco-pp-add "multifile"))
                (if (bitand (-> p declared) 1) (coco-pp-add "discontiguous"))))
          ;; the module it is imported from: the table's, or a module/2 read's
          (if (and sw (!= (nth 0 imp) (cast char 0)))
              (block (set (nth n v) (coco_make1 m "imported_from" (coco_new_atom m imp))) (++ n))
            (if (and (not sw) (!= p nil) (!= (-> p pmod) 0))
                (block (set (nth n v) (coco_make1 m "imported_from" (coco_new_atom_id m (- (-> p pmod) 1))))
                       (++ n))))
          ;; what the table says, else what the declarations said
          (if (? sw (bitand fl 4)
                 (and (!= p nil) (or (bitand (-> p pattrs) 4) (coco_b_meta_module (-> p pmeta)))))
              (coco-pp-add "transparent"))
          (if (and sw (!= (nth 0 spec) (cast char 0)))
              (block (set (nth n v) (coco_make1 m "meta_predicate" (coco_b_meta_term m nid spec))) (++ n))
            (if (and (not sw) (!= p nil) (!= (-> p pmeta) nil))
                (block (set (nth n v) (coco_make1 m "meta_predicate" (coco_b_meta_term m nid (-> p pmeta))))
                       (++ n))))
          ;; where its first clause a file read stands: none for a library
          ;; compiled into cocolog, whose text was read from no file
          (if (and (!= p nil) (!= (-> p pfile) 0))
              (block
                (set (nth n v) (coco_make1 m "file" (coco_new_atom_id m (- (-> p pfile) 1)))) (++ n)
                (set (nth n v) (coco_make1 m "line_count" (coco_new_int m (cast i64 (-> p pline))))) (++ n)))
          (if (bitand fl 128) (coco-pp-add "notrace"))
          (if (? sw (bitand fl 8) (or c con (and (!= p nil) (bitand (-> p pattrs) 32))))
              (coco-pp-add "nodebug"))
          ;; swipl counts the clauses of a predicate that has some, and of
          ;; one declared dynamic; what is foreign has none
          (if (and (not fgn) (!= p nil) (or (> live 0) (-> p dynamic)))
              (block
                (set (nth n v) (coco_make1 m "number_of_clauses" (coco_new_int m (cast i64 (- live lasts))))) (++ n)
                (set (nth n v) (coco_make1 m "number_of_rules" (coco_new_int m (cast i64 rules)))) (++ n)))
          (if (bitand fl 16) (coco-pp-add "noprofile"))
          (if (? sw (bitand fl 64) (> lasts 0)) (coco-pp-add "ssu"))
          ;; every ISO predicate is swipl's, so the table says which
          (if (and sw (bitand fl 32)) (coco-pp-add "iso"))
          (coco-pp-add "defined")
          (return (coco_m_unify e (coco_m_arg e g 1) (coco_m_list e v n)))))

  ;;; '$pred_impl'(Head, Module), implementation_module(M) of
  ;;; predicate_property/2 (3.41.0, swipl's property_predicate/2): the
  ;;; module that defines it. The program's own is user's, or a module/2
  ;;; read's; the system's and a library's the table's, else the system's,
  ;;; or a module/2 read's for a library's clauses; a name nothing defines
  ;;; is user's, where the head was looked for.
  (func coco_b_pred_impl ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t h . #'(coco_m_arg e g 0))
              (u64 nid . 0) (u32 ar . 0) (int sys . 0) (int sw . 0) (u64 pm . 0) (int prog . 0)
              (const char * imp . "") (const char * impl . "") (const char * spec . ""))
          (while (coco_is_compound2 m h ":") (set h (coco_deref m (coco_arg m h 1))))
          (if (not (coco_is_callable m h)) (return 0))
          (set nid (coco_name_of m h))
          (set ar (coco_arity m h))
          (set sys (or (>= (coco_builtin_index m nid ar) 0)
                       (or (coco_b_tier1_claims (coco_atom_name m nid) ar)
                           (coco_b_construct_claims (coco_atom_name m nid) ar))))
          (if (coco_pred_taken st nid ar) (set sys 0))
          (if (not sys)
              (let ((size_t pi . #'(coco_pred_intern st nid ar)))
                (if (< pi ($ (cof st) npreds))
                    (block
                      (if (not (coco_pred_ensure st pi)) (return (coco_fetch_error e)))
                      (let ((coco_pred * p . #'(aof (nth pi ($ (cof st) preds)))))
                        (if (or (> (coco_pred_live p) 0) (or (-> p dynamic) (-> p declared)))
                            (block (set pm (-> p pmod))
                                   (set prog (coco_pred_prog_clause p))
                                   (set sys (? (and (-> p library) (not (-> p own))) 2 3)))))))))
          (if (or (== sys 1) (== sys 2))
              (set sw (coco_swipl_props (coco_atom_name m nid) ar (aof imp) (aof impl) (aof spec))))
          ;; what user does not see of a library's is user's, where it was
          ;; looked for, as of a name nothing defines (3.48.0)
          (if (and (== sys 2) sw
                   (coco_pp_unseen (- sw 1) prog impl (coco_atom_name m nid) ar))
              (set sys 0))
          (let ((const char * mod . "user"))
            (cond
              ((or (== sys 1) (== sys 2))
               (if (and sw (!= (nth 0 impl) (cast char 0)))
                   (set mod impl)
                 (set mod (? (!= pm 0) (coco_atom_name m (- pm 1)) "system"))))
              ((and (== sys 3) (!= pm 0)) (set mod (coco_atom_name m (- pm 1))))
              (#t (block)))
            (return (coco_m_unify e (coco_m_arg e g 1) (coco_new_atom m mod))))))

  ;;; ---- abolish/1,2 (3.36.0, swipl 9.0.4's pl_abolish) -------------------
  ;;;
  ;;; THE PREDICATE GOES, ITS DECLARATIONS WITH IT: every clause, and then
  ;;; what was declared of it, dynamic among them (`coco_pred_undeclare'),
  ;;; so a call of it raises existence_error as of one never defined,
  ;;; current_predicate/1 names it no more and predicate_property/2 answers
  ;;; nothing for it -- a static predicate of a file's too, as swipl's when
  ;;; its `iso' flag is false. An ISO predicate, the 158 swipl locks
  ;;; (`*iso-predicates*'), is permission_error(modify, static_procedure,
  ;;; PI), redefined or not, and a thread_local one
  ;;; permission_error(modify, thread_local_procedure, PI); any other
  ;;; system predicate is none of the program's, which abolish leaves as it
  ;;; is (format/2 answers on). A LIBRARY'S PREDICATE KEEPS THE LIBRARY'S
  ;;; CLAUSES: abolish of member/2 takes away the clauses the program gave
  ;;; it alone, as swipl's takes away user's definition or import and
  ;;; lists:member/2 answers again. One a program file took over stays taken
  ;;; (`taken'), and its call raises, as swipl's user definition is then
  ;;; undefined and the system's is not called. Through 3.35.0 every clause
  ;;; went, a library's too (member/2 failed for good after it), a dynamic
  ;;; declaration stayed, so a call failed, an ISO predicate and a negative
  ;;; arity were taken in silence, a qualified spec was refused and
  ;;; abolish/2 did not exist.

  ;;; SPEC WITH ITS QUALIFIERS TAKEN OFF, as swipl's PL_strip_module: each
  ;;; `M:' whose M is an atom; an unbound or other M stops it, and the spec
  ;;; is then no predicate indicator.
  (func coco_abolish_strip ((coco_engine * e) (size_t s)) (out size_t)
        (let ((coco_machine * m . #'(coco_m_machine e)))
          (set s (coco_deref m s))
          (while (and (coco_is_compound2 m s ":")
                      (coco_m_is_atom e (coco_deref m (coco_arg m s 0))))
            (set s (coco_deref m (coco_arg m s 1))))
          (return s)))

  ;;; NAME AND ARITY ASKED IN swipl's ORDER -- the name first, an atom; then
  ;;; the arity, an integer, one an int holds (representation_error(int):
  ;;; pl-proc.c's get_arity() reads it with PL_get_integer_ex()), 0 or
  ;;; more -- and the predicate abolished; either unbound is an
  ;;; instantiation error, as a type error of a variable is
  ;;; (`coco_m_type_error'). swipl's 1024 arguments a procedure may have
  ;;; (representation_error(max_procedure_arity)) are no limit here, where
  ;;; a predicate takes any arity a clause gives it (COMPAT.md).
  (func coco_abolish_pi ((coco_engine * e) (size_t nm) (size_t ar)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (i64 arity . 0))
          (set nm (coco_deref m nm))
          (set ar (coco_deref m ar))
          (if (not (coco_m_is_atom e nm)) (return (coco_m_type_error e "atom" nm)))
          (if (not (coco-is-int (nth ar (-> m heap)))) (return (coco_m_type_error e "integer" ar)))
          (set arity (coco_int_val m (nth ar (-> m heap))))
          (if (or (> arity 2147483647) (< arity -2147483648))
              (return (coco_m_raise e (coco_make1 m "representation_error" (coco_new_atom m "int")))))
          (if (< arity 0) (return (coco_m_domain_error e "not_less_than_zero" ar)))
          (if (coco_iso_predicate (coco_atom_name m (coco_name_of m nm)) (cast u32 arity))
              (return (coco_m_permission_error e "modify" "static_procedure"
                                               (coco_make2 m "/" nm ar))))
          (with-green-write e
           (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m nm) (cast u32 arity)))
                 (int lib . 0))
            (if (>= pi ($ (cof st) npreds)) (return 1))
            (if (bitand ($ (nth pi ($ (cof st) preds)) pattrs) 8)
                (return (coco_m_permission_error e "modify" "thread_local_procedure"
                                                 (coco_make2 m "/" nm ar))))
            ;; unread, the rows it would leave in the database are not
            ;; known, and rewriting the predicate empty would take them
            (if (not (coco_pred_ensure st pi)) (return (coco_fetch_error e)))
            (set lib (and ($ (nth pi ($ (cof st) preds)) library)
                          (not ($ (nth pi ($ (cof st) preds)) own))))
            ;; the clauses go as a reconsult takes a file's, in one walk:
            ;; with a call open on the predicate each dies where it stands
            ;; for that call to try still (the logical update view), and the
            ;; backend hears once, if a clause it holds went
            (coco_pred_forget_where st m pi 0 (? lib 3 4))
            (coco_store_maybe_compact st m)
            (if lib (return 1))
            (if (< (coco_pred_undeclare st pi) 0)
                (return (coco_m_error_msg e "resource_error" "knowledge_base" nil
                                          (cast size_t -1) (-> st write_err))))
            (return 1)))))

  ;;; abolish(Spec): Name/Arity under any atom's qualifiers
  ;;; (`coco_abolish_strip'); unbound an instantiation error, and a term of
  ;;; any other shape type_error(predicate_indicator, T), Name//Arity among
  ;;; them.
  (func coco_b_abolish ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t spec . #'(coco_abolish_strip e (coco_m_arg e g 0))))
          (if (not (coco_is_compound2 m spec "/"))
              (return (coco_m_type_error e "predicate_indicator" spec)))
          (return (coco_abolish_pi e (coco_arg m spec 0) (coco_arg m spec 1)))))

  ;;; abolish(Name, Arity), swipl's: the name under any atom's qualifiers,
  ;;; `abolish(user:p, 1)'.
  (func coco_b_abolish2 ((coco_engine * e) (size_t g)) (out int)
        (return (coco_abolish_pi e (coco_abolish_strip e (coco_m_arg e g 0)) (coco_m_arg e g 1))))

  ;;; ---- global variables -------------------------------------------------
  ;;;
  ;;; `nb_' and `b_' are the same thing here. SWI's differ on backtracking --
  ;;; a `b_setval' is undone and an `nb_setval' is not -- and undoing one would
  ;;; need a trail entry that is not a variable binding, which the trail
  ;;; carries only for a heap cell (setarg/3's value entry, 1.12.0): a global
  ;;; lives in the store. They are documented as the non-backtrackable pair.
  ;;;
  ;;; THE VALUE GOES IN THE STORE, not the heap: a global that a query set has
  ;;; to survive the query's heap being wound back, and the store is the only
  ;;; thing here that does not shrink.

  ;;; AND THE TABLE IS THE STORE'S, which is `coco_global' and the three
  ;;; members beside `cells' in lib/kb.cicili -- that header carries the
  ;;; whole argument. In one line: an entry holds an index into ONE store's
  ;;; cells, so a table shared between stores hands one store's index to
  ;;; another, and `run_isolated/2' -- a fresh store -- read garbage or
  ;;; segfaulted. Globals are therefore per-store, which is the semantics a
  ;;; fresh machine should have anyway.
  ;;;
  ;;; NOTHING HERE IS FILE-SCOPE ANY MORE, and that is the point: a static
  ;;; table is appended to by every thread at once, and eight of them
  ;;; writing 800 globals each aborted the process on its `realloc'.

  ;;; ---- clauses that stay in this machine ---------------------------------
  ;;;
  ;;; MUTING IS WHAT A MODULE'S CLAUSES ALREADY GET, and there was no way to
  ;;; ask for it from Prolog. `coco_store_mute' stops the write-through hooks
  ;;; firing, so an `assertz' lands in this machine's store and nowhere else
  ;;; -- which is exactly what a module's clauses need, "they belong to the
  ;;; BUILD and not to the knowledge base", and exactly what a WORKER's
  ;;; snapshot needs for the same reason.
  ;;;
  ;;; Reported from CivV: `library(cowork)' told a two-worker crew four
  ;;; clauses under `--embed' and EIGHT rows landed in the knowledge base,
  ;;; one copy per worker. Transient turn state, written to the user's
  ;;; database, once per worker. And it deadlocked past a handful of clauses,
  ;;; because both workers wanted the embedded store while the caller sat
  ;;; waiting for them.
  ;;;
  ;;; THE RAW PAIR IS `$'-PREFIXED ON PURPOSE. A mute that somebody forgets
  ;;; to undo silently drops every later write, so the public form is
  ;;; `with_local_clauses/1', which unmutes on success, on failure and on the
  ;;; way out of a throw. It is a COUNTER underneath, so it nests.
  (func coco_b_store_mute ((coco_engine * e) (size_t g)) (out int)
        (coco_store_mute (-> e st))
        (return 1))

  (func coco_b_store_unmute ((coco_engine * e) (size_t g)) (out int)
        (coco_store_unmute (-> e st))
        (return 1))

  ;;; A GLOBAL BY NAME (1.9.4), through the store's hash of them
  ;;; (`gbuckets'): an open table of an entry's index plus one, kept under
  ;;; half full and probed in a line from the name's hash. Through 1.9.3
  ;;; every read and every write scanned from the first global made, and
  ;;; the translator keeps one per word it has looked up -- its lesson made
  ;;; 1 710 and read them 3.7 million times. Answers the index, or -1.
  (static)
  (func coco_global_find ((coco_store * st) (u64 name)) (out i64)
        (if (== (-> st gbucket_cap) 0) (return -1))
        (let ((size_t mask . #'(- (-> st gbucket_cap) 1))
              (size_t j . #'(cast size_t (bitand (coco_name_arity_hash name 0) (cast u64 mask)))))
          (while 1
            (let ((size_t v . #'(nth j (-> st gbuckets))))
              (if (== v 0) (return -1))
              (if (== ($ (nth (- v 1) (-> st globals)) name) name) (return (cast i64 (- v 1))))
              (set j (bitand (+ j 1) mask))))
          (return -1)))

  ;;; Entry I into the hash: the first empty slot on its name's line
  (static)
  (func coco_global_place ((coco_store * st) (size_t i))
        (let ((size_t mask . #'(- (-> st gbucket_cap) 1))
              (size_t j . #'(cast size_t (bitand (coco_name_arity_hash ($ (nth i (-> st globals)) name) 0)
                                                (cast u64 mask)))))
          (while (!= (nth j (-> st gbuckets)) 0)
            (set j (bitand (+ j 1) mask)))
          (set (nth j (-> st gbuckets)) (+ i 1))))

  ;;; A NEW ENTRY I, the table doubled first when one more would put it
  ;;; over half full: every entry below I is put back from the array
  ;;; itself, which is the truth -- the table is only how to find it.
  ;;; 0 when it would not grow.
  (static)
  (func coco_global_hash ((coco_store * st) (size_t i)) (out int)
        (if (> (* (+ i 1) 2) (-> st gbucket_cap))
            (let ((size_t ncap . #'(? (== (-> st gbucket_cap) 0) 16 (* (-> st gbucket_cap) 2)))
                  (size_t * nb . nil))
              (while (> (* (+ i 1) 2) ncap) (set ncap (* ncap 2)))
              (set nb (cast (size_t *) (calloc ncap (sizeof size_t))))
              (if (== nb nil) (return 0))
              (free (-> st gbuckets))
              (set (-> st gbuckets) nb)
              (set (-> st gbucket_cap) ncap)
              (for ((size_t k . 0)) (< k i) ((++ k))
                (coco_global_place st k))))
        (coco_global_place st i)
        (return 1))

  (func coco_b_setval ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t k . #'(coco_m_arg e g 0)))
          (if (not (coco_m_is_atom e k)) (return (coco_m_type_error e "atom" k)))
          (with-green-write e
          (let ((coco_store * st . #'(-> e st))
                (u64 name . #'(coco_name_of m k))
                (size_t cell . #'(coco_store_put (-> e st) m (coco_m_arg e g 1)))
                ;; whether a machine may keep the value and hand it out
                ;; shared (1.12.1, `coco_b_global_term'): the put met no
                ;; variable. A cyclic value goes in as its factors, which
                ;; have, and is copied at every read.
                (int ground . #'(== (-> st put_vars) 0))
                (i64 at . #'(coco_global_find st name)))
            (set (-> st gver) (+ (-> st gver) 1))
            (if (>= at 0)
                (let ((size_t i . #'(cast size_t at)))
                  ;; the old value is an orphan now, and its size was kept
                  (set (-> st dead) (+ (-> st dead) ($ (nth i (-> st globals)) size)))
                  (set ($ (nth i (-> st globals)) cell) cell)
                  (set ($ (nth i (-> st globals)) size) (- (-> st len) cell))
                  (set ($ (nth i (-> st globals)) ver) (-> st gver))
                  (set ($ (nth i (-> st globals)) ground) ground)
                  (coco_store_maybe_compact st m)
                  (return 1)))
            (if (>= (-> st nglobals) (-> st gcap))
                (let ((size_t ncap . #'(? (== (-> st gcap) 0) 8 (* (-> st gcap) 2)))
                      (coco_global * nb))
                  (set nb (cast (coco_global *)
                                (realloc (-> st globals) (* ncap (sizeof coco_global)))))
                  (if (== nb nil) (return 0))
                  (set (-> st globals) nb)
                  (set (-> st gcap) ncap)))
            (set ($ (nth (-> st nglobals) (-> st globals)) name) name)
            (set ($ (nth (-> st nglobals) (-> st globals)) cell) cell)
            (set ($ (nth (-> st nglobals) (-> st globals)) size) (- (-> st len) cell))
            (set ($ (nth (-> st nglobals) (-> st globals)) ver) (-> st gver))
            (set ($ (nth (-> st nglobals) (-> st globals)) ground) ground)
            (if (not (coco_global_hash st (-> st nglobals))) (return 0))
            (set (-> st nglobals) (+ (-> st nglobals) 1))
            (coco_store_maybe_compact st m)
            (return 1)))))

  ;;; A GLOBAL'S VALUE ON THE HEAP (1.12.1). Every read copies the value
  ;;; as its block (`coco_store_read_block'): through 1.12.0 a read walked
  ;;; it a cell at a time, 98 us for a list of 3 000 entries against 26
  ;;; now, and the translator's reads (one per word it looks up) were 12 %
  ;;; of its instructions. A GROUND value is then kept by the machine
  ;;; (`gcache', a root of the collector, by the global's index and
  ;;; version, for the store whose serial it names) and handed out shared,
  ;;; as SWI hands out its globals: nothing can bind a ground term, and a
  ;;; setarg/3 or nb_setarg/3 on it changes the global (setarg/3's until
  ;;; backtracking takes it back), which nb_setval/2 replaces. It is kept
  ;;; FOR AS LONG AS IT LIVES: its sentinel on the trail (`coco-trail-tag')
  ;;; is undone when backtracking, or the end of a nested search, goes back
  ;;; past the copy and takes its cells, and a read that finds the sentinel
  ;;; gone from where it was put (`coco_gcache_ok') copies again.
  ;;; Nothing else that winds the heap back can reach it: the positions a
  ;;; host winds back to (a consult's after a directive) are raised over it
  ;;; here, and every other wind-back undoes the trail with it or runs no
  ;;; goal. Raising EVERY mark instead, as SWI freezes its global stack at
  ;;; nb_setval/2, kept what backtracking had always given back, and the
  ;;; translator's case ran 12 % slower for twice the collections (16 to
  ;;; 34). nb_setarg/3 on a copy pins it (`coco_gcache_pin'), and its
  ;;; write lasts as SWI's. A value with a variable in it is a fresh copy
  ;;; at every read -- each read's variables its own, where SWI shares them
  ;;; too -- and so is an atom or a number, a cell to copy.
  (static)
  (func coco_b_global_term ((coco_engine * e) (size_t i)) (out size_t)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t cell . #'($ (nth i (-> st globals)) cell))
              (size_t size . #'($ (nth i (-> st globals)) size))
              (u64 ver . #'($ (nth i (-> st globals)) ver))
              (size_t h0 . 0) (size_t r . 0) (u64 sn . 0) (size_t tp . 0))
          (if (not ($ (nth i (-> st globals)) ground)) (return (coco_store_read_block m st cell size)))
          (if (!= (-> m gcache_ss) (-> st serial)) (coco_gcache_drop m (-> st serial)))
          (if (and (< i (-> m gcache_cap)) (== ($ (nth i (-> m gcache)) ver) ver)
                   (coco_gcache_ok m i))
              (return ($ (nth i (-> m gcache)) root)))
          (set h0 (-> m heap_len))
          (set r (coco_deref m (coco_store_read_block m st cell size)))
          (if (or (-> m oom) (not (coco-tag-is FUN (nth r (-> m heap))))) (return r))
          ;; no room to keep it, or to say where it was made (a sentinel
          ;; holds an index under 2^23 - 1): handed out as a copy, as it
          ;; always was
          (if (or (>= (+ i 1) (- (<< (cast size_t 1) 23) 1)) (not (coco_gcache_room m i))) (return r))
          (set sn (bitand (+ (-> m gfills) 1) (- (<< (cast u64 1) 23) 1)))
          (if (== sn 0) (set sn 1))
          (set tp (-> m trail_len))
          (if (not (coco_trail_sent m sn i)) (return r))
          (set (-> m gfills) sn)
          (coco_heap_raise_positions m 0 (-> m heap_len))
          (set ($ (nth i (-> m gcache)) ver) ver)
          (set ($ (nth i (-> m gcache)) root) r)
          (set ($ (nth i (-> m gcache)) serial) sn)
          (set ($ (nth i (-> m gcache)) tpos) tp)
          (set ($ (nth i (-> m gcache)) lo) h0)
          (set ($ (nth i (-> m gcache)) hi) (-> m heap_len))
          (set ($ (nth i (-> m gcache)) pinned) 0)
          (if (or (< h0 (-> m gspan_lo)) (>= (-> m gspan_lo) (-> m gspan_hi)))
              (set (-> m gspan_lo) h0))
          (if (> (-> m heap_len) (-> m gspan_hi)) (set (-> m gspan_hi) (-> m heap_len)))
          (return r)))

  (func coco_b_getval ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t k . #'(coco_m_arg e g 0)))
          (if (not (coco_m_is_atom e k)) (return (coco_m_type_error e "atom" k)))
          (let ((coco_store * st . #'(-> e st))
                (i64 at . #'(coco_global_find st (coco_name_of m k))))
            (if (>= at 0)
                (return (coco_m_unify e (coco_m_arg e g 1) (coco_b_global_term e (cast size_t at)))))
            (return (coco_m_existence_error e "variable" (coco_m_arg e g 0))))))

  ;;; `nb_current(?Key, ?Value)' (1.12.0): the global's value, read as
  ;;; nb_getval/2 reads it, or a FAILURE where there is no global of that
  ;;; name -- where nb_getval/2 raises, so a program asks whether there is
  ;;; one in one step rather than three (`catch/3', the read, its exit). A
  ;;; key bound to anything but an atom is SWI's type_error(atom, K). An
  ;;; unbound key ENUMERATES, which no C predicate here does (every builtin
  ;;; is deterministic): this one declines the goal (`coco_m_decline', the
  ;;; `:declines' row) and it goes on to this module's clause, which walks
  ;;; '$nb_keys'/1 -- the globals in the order they were made.
  (func coco_b_nb_current ((coco_engine * e) (size_t g) (int * found)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t k . #'(coco_m_arg e g 0)))
          (if (coco_m_is_var e k)
              (block (coco_m_decline e) (set (cof found) 0) (return 0)))
          (if (not (coco_m_is_atom e k)) (return (coco_m_type_error e "atom" k)))
          (let ((coco_store * st . #'(-> e st))
                (i64 at . #'(coco_global_find st (coco_name_of m k))))
            (if (< at 0) (return 0))
            (return (coco_m_unify e (coco_m_arg e g 1) (coco_b_global_term e (cast size_t at)))))))

  ;;; `'$nb_keys'(-Keys)': every global's name, in the order made
  (func coco_b_nb_keys ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t l . #'(coco_m_nil e))
              (size_t i . #'(-> st nglobals)))
          (while (> i 0)
            (set i (- i 1))
            (set l (coco_m_cons e (coco_new_atom_id m ($ (nth i (-> st globals)) name)) l)))
          (return (coco_m_unify e (coco_m_arg e g 0) l))))

  ;;; `prewarm(-Count)' asks the backend, once, about every predicate a MODULE
  ;;; owns and remembers the ones it has no rows for, so that the fresh store
  ;;; every `run_isolated/2' proof gets need not ask again. Count is how many
  ;;; joined the table on this call -- 0 on a second call, and 0 under
  ;;; `--local', where there is no backend to ask.
  ;;;
  ;;; CALL IT BEFORE YOU SPAWN. The table is process-wide and unguarded, the
  ;;; same contract `use_module' has and for the same reason: a lock here would
  ;;; sit under the first call of every predicate of every proof in the
  ;;; process. `library(httpd)' calls it in `httpd_serve/3' before the pool
  ;;; starts.
  ;;;
  ;;; AND IT PAYS ONLY WHERE THE FETCHES RECUR, which is narrower than it
  ;;; sounds and was measured the hard way. The call itself asks about every
  ;;; library predicate the process has -- 437 of them with the tier-1
  ;;; libraries loaded -- so it costs ~51 ms up front and earns it back at 51
  ;;; fetches a request. An httpd pool repays that in about nine requests,
  ;;; because a fresh store per REQUEST asks again every time.
  ;;;
  ;;; `library(cowork)' IS NOT THAT SHAPE AND DELIBERATELY DOES NOT CALL IT. A
  ;;; crew worker's store lives as long as the worker and is filled lazily, so
  ;;; it asks only about the predicates its own jobs call, once -- about
  ;;; fifteen a worker, measured. Pre-warming a crew therefore buys 437 fetches
  ;;; to save perhaps 180, and it measured 4-6x WORSE at every crew size
  ;;; tried: a crew of four went 13 ms to 51, a crew of twelve 21 ms to 65,
  ;;; with one real job each. The rule is the fetches RECURRING, not the
  ;;; threads existing.
  ;;;
  ;;; WHAT IT COSTS IF YOU ARE WRONG is in `coco_store_prewarm' in lib/kb.cicili:
  ;;; a predicate a MODULE defines, written into the knowledge base by another
  ;;; process after this call, is not seen by this one. The program's own
  ;;; predicates are untouched and are fetched per request as they always were.
  (func coco_b_prewarm ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t n . #'(coco_store_prewarm (-> e st) (coco_m_machine e))))
          (return (coco_m_unify e (coco_m_arg e g 0)
                                  (coco_m_new_int e (cast i64 n))))))

  ;;; `garbage_collect/0' compacts the store -- see `coco_store_compact' in
  ;;; lib/kb.cicili for what that reclaims and when it happens unasked. It
  ;;; always succeeds, and it is allowed anywhere a goal is: inside a
  ;;; findall's goal or a directive the roots those hold move with the rest.
  ;;;
  ;;; AND IT ASKS FOR A HEAP COLLECTION at the next step boundary, because a
  ;;; builtin is the one place a collection cannot run -- this call's own
  ;;; frame holds the goal. The request is a threshold of 0 (`gc_next' on
  ;;; the machine). Where the collector may not run (a host that did not
  ;;; turn it on, a search whose starter told the collector nothing of its
  ;;; own frame) the request waits for a step where it may. See
  ;;; `coco_heap_gc' in lib/solve.cicili.
  (func coco_b_garbage_collect ((coco_engine * e) (size_t g)) (out int)
        (coco_store_compact (-> e st) (coco_m_machine e))
        (set (-> (coco_m_machine e) gc_next) 0)
        (return 1))

  ;;; `statistics/2', the keys a program can act on. SWI's names where SWI
  ;;; has the number -- `cputime' in seconds as a float, `inferences',
  ;;; `globalused' and `trailused' in bytes, `atoms' and `functors' as
  ;;; counts -- and `store_used' for what SWI has no word for: the bytes the
  ;;; store's cell array holds, live and orphaned alike, which is the number
  ;;; that `garbage_collect/0' brings down. Any other key is a
  ;;; `domain_error(statistics_key, K)'.
  ;;;
  ;;; AND THE CAPS BESIDE THE LENGTHS (1.2.14): `store_cap', `globalcap' and
  ;;; `trailcap' are what the process HOLDS where the three `used' keys are
  ;;; what the program put there, plus `choicepoints', `strings' and
  ;;; `compactions'. A length answers what you asked and can still leave you
  ;;; looking at the wrong number: CivV read `store_used' at 28 MB inside a
  ;;; window whose footprint was 13.2 GB. An array that doubles sits at up to
  ;;; twice its contents, and only the cap says so.
  ;;;
  ;;; AND `heap_collections' (1.8.36): how many times `coco_heap_gc' has run
  ;;; on this machine -- `compactions' is the store's count, this the heap's.
  ;;; Zero is the honest answer under a host that never turned it on.
  (func coco_b_statistics ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (coco_store * st . #'(-> e st))
              (size_t k . #'(coco_deref (coco_m_machine e) (coco_m_arg e g 0)))
              (size_t out . #'(coco_m_arg e g 1))
              (i64 v . 0))
          (if (not (coco_m_is_atom e k)) (return (coco_m_type_error e "atom" k)))
          (let ((const char * key . #'(coco_atom_name m (coco_name_of m k))))
            (cond
              ((== 0 (strcmp key "cputime"))
               ;; CLOCKS_PER_SEC is a macro Cicili cannot see; POSIX fixes it
               ;; at one million, on this platform and the other one
               (return (coco_m_unify e out (coco_m_new_float
                                             e (/ (cast double (clock)) 1000000.0)))))
              ;; the steps less those that are no inference -- `true' and
              ;; `=/2' (1.12.2), as SWI counts
              ((== 0 (strcmp key "inferences")) (set v (cast i64 (- (-> e steps) (-> e frees)))))
              ((== 0 (strcmp key "globalused")) (set v (cast i64 (* (-> m heap_len) 8))))
              ((== 0 (strcmp key "trailused"))  (set v (cast i64 (* (-> m trail_len) 8))))
              ((== 0 (strcmp key "atoms"))      (set v (cast i64 (-> m atoms_len))))
              ((== 0 (strcmp key "functors"))   (set v (cast i64 (-> m functors_len))))
              ((== 0 (strcmp key "store_used")) (set v (cast i64 (* (-> st len) 8))))
              ;; THE CAPS, NOT ONLY THE LENGTHS, because the length is what a
              ;; program put there and the CAP is what the process is holding
              ;; -- and an array that doubles sits at up to twice its contents
              ;; between one compaction and the next. CivV read `store_used' at
              ;; 28 MB inside a window whose footprint was 13.2 GB; the length
              ;; was telling the truth and was not the question.
              ((== 0 (strcmp key "store_cap"))  (set v (cast i64 (* (-> st cap) 8))))
              ((== 0 (strcmp key "globalcap"))  (set v (cast i64 (* (-> m heap_cap) 8))))
              ((== 0 (strcmp key "trailcap"))   (set v (cast i64 (* (-> m trail_cap) 8))))
              ((== 0 (strcmp key "choicepoints")) (set v (cast i64 (-> e nchoices))))
              ((== 0 (strcmp key "compactions")) (set v (cast i64 (-> st ncompacts))))
              ;; the HEAP's collections, where `compactions' is the store's
              ((== 0 (strcmp key "heap_collections")) (set v (cast i64 (-> m gc_count))))
              ((== 0 (strcmp key "strings"))    (set v (cast i64 (-> m strings_len))))
              (#t (return (coco_m_domain_error e "statistics_key" k))))
            (return (coco_m_unify e out (coco_m_new_int e v))))))

  ;;; ---- operators --------------------------------------------------------

  (static)
  (func coco_b_typename ((int type)) (out const char *)
        (if (== type COCO_XFX) (return "xfx"))
        (if (== type COCO_XFY) (return "xfy"))
        (if (== type COCO_YFX) (return "yfx"))
        (if (== type COCO_FY)  (return "fy"))
        (return "fx"))

  ;;; One name of op/3, defined as it is met, swipl's checks: an atom,
  ;;; never `,' and `|' only as an infix of priority 0 or past 1000; of any
  ;;; length (3.34.1), so the table refuses one only when memory is refused.
  (static)
  (func coco_b_op_name ((coco_engine * e) (size_t n) (i64 prec) (int type) (int kind))
        (out int)
        (let ((const char * one . nil))
          (if (coco_m_is_var e n) (return (coco_m_instantiation_error e)))
          (set one (coco_m_atom e n))
          (if (== one nil) (return (coco_m_type_error e "atom" n)))
          (if (== 0 (strcmp one ","))
              (return (coco_m_permission_error e "modify" "operator" n)))
          (if (and (== 0 (strcmp one "|"))
                   (or (!= kind 0) (and (!= prec 0) (< prec 1001))))
              (return (coco_m_permission_error e "create" "operator" n)))
          (if (not (coco_op_define one (cast int prec) type kind))
              (return (coco_m_resource_error e "memory")))
          (return 1)))

  ;;; `op(+Priority, +Type, +Name)', swipl's checks in its order (3.0.0): the
  ;;; type an atom, the priority an integer of 0 to 1200, the type a specifier,
  ;;; then each name in turn (`coco_b_op_name'), defined as it is met, and a
  ;;; list of them ending in [] (unbound, instantiation_error; anything else
  ;;; type_error(list, End)). Name is a list of names in every real
  ;;; operator declaration; [] is none. Priority 0 takes the operator away. A
  ;;; postfix type (xf, yf) is no specifier here: the reader has none.
  (func coco_b_op ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (i64 prec . 0) (int type . 0) (int kind . 0) (int rc . 0)
              (const char * ts . nil)
              (size_t p . #'(coco_m_arg e g 0)) (size_t ty . #'(coco_m_arg e g 1))
              (size_t nm . #'(coco_deref m (coco_m_arg e g 2)))
              (size_t budget . #'(-> m heap_len)))

          (if (coco_m_is_var e ty) (return (coco_m_instantiation_error e)))
          (set ts (coco_m_atom e ty))
          (if (== ts nil) (return (coco_m_type_error e "atom" ty)))
          (if (coco_m_is_var e p) (return (coco_m_instantiation_error e)))
          (if (not (coco_m_int e p (aof prec)))
              (return (coco_m_type_error e "integer" p)))
          (if (or (< prec 0) (> prec 1200))
              (return (coco_m_domain_error e "operator_priority" p)))
          (if (not (coco_op_type_of ts (aof type) (aof kind)))
              (return (coco_m_domain_error e "operator_specifier" ty)))

          (if (coco_m_is_var e nm) (return (coco_m_instantiation_error e)))
          (if (and (coco_m_is_atom e nm) (not (coco_is_nil m nm)))
              (return (coco_b_op_name e nm prec type kind)))
          (while (and (coco_is_cons m nm) (> budget 0))
            (set rc (coco_b_op_name e (coco_deref m (coco_arg m nm 0)) prec type kind))
            (if (!= rc 1) (return rc))
            (set budget (- budget 1))
            (set nm (coco_deref m (coco_arg m nm 1))))
          (if (coco_is_nil m nm) (return 1))
          (if (coco_m_is_var e nm) (return (coco_m_instantiation_error e)))
          (return (coco_m_type_error e "list" nm))))

  ;;; `'$cn_check'(C, N, A, Which)': compound_name_arity/3 (Which 0) and
  ;;; compound_name_arguments/3 (1) of a C that is no compound, swipl's
  ;;; checks in its order, each error named for the predicate (3.0.0): C
  ;;; bound type_error(compound, C); the name unbound instantiation_error,
  ;;; no atom type_error(atom, N); the arity an integer of 0 or more, or the
  ;;; arguments a proper list.
  (func coco_b_cn_check ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t c . #'(coco_m_arg e g 0)) (size_t nm . #'(coco_m_arg e g 1))
              (size_t a . #'(coco_m_arg e g 2)) (i64 which . 0) (i64 n . 0)
              (const char * pred . "compound_name_arity"))
          (coco_m_int e (coco_m_arg e g 3) (aof which))
          (if which (set pred "compound_name_arguments"))
          (if (not (coco_m_is_var e c))
              (return (coco_m_raise_pi e (coco_make2 m "type_error" (coco_new_atom m "compound") c)
                                       "system" pred 3)))
          (if (coco_m_is_var e nm)
              (return (coco_m_raise_pi e (coco_new_atom m "instantiation_error") "system" pred 3)))
          (if (not (coco_m_is_atom e nm))
              (return (coco_m_raise_pi e (coco_make2 m "type_error" (coco_new_atom m "atom") nm)
                                       "system" pred 3)))
          (if (== which 0)
              (block
               (if (coco_m_is_var e a)
                   (return (coco_m_raise_pi e (coco_new_atom m "instantiation_error") "system" pred 3)))
               (if (not (coco_m_int e a (aof n)))
                   (return (coco_m_raise_pi e (coco_make2 m "type_error" (coco_new_atom m "integer") a)
                                            "system" pred 3)))
               (if (< n 0)
                   (return (coco_m_raise_pi e (coco_make2 m "domain_error"
                                                          (coco_new_atom m "not_less_than_zero") a)
                                            "system" pred 3)))
               (return 1)))
          ;; the arguments: a proper list, a partial one instantiation_error
          (let ((size_t t . #'(coco_deref m a)) (size_t budget . #'(-> m heap_len)))
            (while (and (coco_is_cons m t) (> budget 0))
              (set budget (- budget 1))
              (set t (coco_deref m (coco_arg m t 1))))
            (if (coco-tag-is REF (nth t (-> m heap)))
                (return (coco_m_raise_pi e (coco_new_atom m "instantiation_error") "system" pred 3)))
            (if (not (coco_is_nil m t))
                (return (coco_m_raise_pi e (coco_make2 m "type_error" (coco_new_atom m "list") a)
                                         "system" pred 3))))
          (return 1)))

  ;;; `'$compound'(C, N, X, Which)' (3.12.0): compound_name_arity/3 (Which
  ;;; 0, X the arity) and compound_name_arguments/3 (1, X the arguments) of
  ;;; any compound, swipl 7's `f()' among them: C taken apart, or made from
  ;;; the name and X '$cn_check'/4 checked. functor/3 and =../2 refuse a
  ;;; compound of no arguments, and through 3.11.0 these two went through
  ;;; them, so none could be made.
  (func coco_b_compound ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t c . #'(coco_deref m (coco_m_arg e g 0)))
              (size_t nm . #'(coco_deref m (coco_m_arg e g 1)))
              (size_t x . #'(coco_deref m (coco_m_arg e g 2)))
              (i64 which . 0) (size_t h . 0) (u32 n . 0))
          (coco_m_int e (coco_m_arg e g 3) (aof which))
          (if (coco-tag-is FUN (nth c (-> m heap)))
              (block
               (set n (coco_arity m c))
               (if (not (coco_unify m nm (coco_new_atom_id m (coco_name_of m c)))) (return 0))
               (if (== which 0) (return (? (coco_unify m x (coco_new_int m (cast i64 n))) 1 0)))
               (let ((size_t lst . #'(coco_new_nil m)) (u32 j . n))
                 (while (> j 0)
                   (set j (- j 1))
                   (set lst (coco_cons m (coco_arg m c j) lst)))
                 (return (? (coco_unify m x lst) 1 0)))))
          (if (== which 0)
              (let ((i64 k . 0))
                (coco_m_int e x (aof k))
                (if (> k 4294967295) (return (coco_representation_error e "max_arity")))
                (set n (cast u32 k))
                (set h (coco_push m (coco-cell FUN (coco_functor_id m (coco_name_of m nm) n))))
                (for ((u32 i . 0)) (< i n) ((++ i)) (coco_new_var m)))
            ;; the arguments, a proper list '$cn_check'/4 walked
            (let ((size_t t . x))
              (while (coco_is_cons m t)
                (set n (+ n 1))
                (set t (coco_deref m (coco_arg m t 1))))
              (set h (coco_push m (coco-cell FUN (coco_functor_id m (coco_name_of m nm) n))))
              (set t x)
              (while (coco_is_cons m t)
                (coco_push m (coco-cell REF (coco_deref m (coco_arg m t 0))))
                (set t (coco_deref m (coco_arg m t 1))))))
          (return (? (coco_unify m c h) 1 0))))

  ;;; '$op_spec'(P, T, N), current_op/3's checks, swipl's in its order
  ;;; (3.0.0): N unbound or an atom (type_error(atom, N)), P unbound or an
  ;;; integer (type_error(integer, P)) of 1 to 1200 (0 since 3.47.0: an
  ;;; operator a priority of 0 removes is no operator)
  ;;; (domain_error(operator_priority, P)), T unbound or an atom
  ;;; (type_error(atom, T)) that is a specifier, the postfix two among them
  ;;; (domain_error(operator_specifier, T)). Through 2.16 none was asked:
  ;;; a wrong one failed.
  (func coco_b_op_spec ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t p . #'(coco_m_arg e g 0)) (size_t t . #'(coco_m_arg e g 1))
              (size_t n . #'(coco_m_arg e g 2)) (i64 v . 0) (const char * ts . nil))
          (if (and (not (coco_m_is_var e n)) (not (coco_m_is_atom e n)))
              (return (coco_m_type_error e "atom" n)))
          (if (not (coco_m_is_var e p))
              (block (if (not (coco_m_int e p (aof v))) (return (coco_m_type_error e "integer" p)))
                     (if (or (< v 1) (> v 1200))
                         (return (coco_m_domain_error e "operator_priority" p)))))
          (if (not (coco_m_is_var e t))
              (block (set ts (coco_m_atom e t))
                     (if (== ts nil) (return (coco_m_type_error e "atom" t)))
                     (if (not (or (== 0 (strcmp ts "xfx"))
                                  (or (== 0 (strcmp ts "xfy"))
                                      (or (== 0 (strcmp ts "yfx"))
                                          (or (== 0 (strcmp ts "fy"))
                                              (or (== 0 (strcmp ts "fx"))
                                                  (or (== 0 (strcmp ts "xf"))
                                                      (== 0 (strcmp ts "yf")))))))))
                         (return (coco_m_domain_error e "operator_specifier" t)))))
          (return 1)))

  ;;; '$cp_spec'(Spec, PI), current_predicate/1's checks, swipl's (3.0.0):
  ;;; Spec unbound, or Name/Arity with Name unbound or an atom and Arity
  ;;; unbound or an integer of 0 to 2^31 - 1, PI that; M:Spec with M
  ;;; unbound (bound to `user', the one module there is) or an atom, PI
  ;;; Spec's; anything else type_error(predicate_indicator, Spec), a
  ;;; negative arity domain_error(not_less_than_zero, A), a module
  ;;; type_error(atom, M). Through 2.16 none was asked: any other term
  ;;; failed. THE TYPE ERROR NAMES THE SPEC AS IT CAME (3.31.0, swipl's),
  ;;; its qualifiers and an unbound module unbound: the modules are bound
  ;;; only once the spec is known good, where through 3.30.0 they were
  ;;; bound first and the error named what was under them, and an arity
  ;;; past 2^31 - 1 was a spec.
  (func coco_b_cp_spec ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t s0 . #'(coco_deref m (coco_m_arg e g 0)))
              (size_t s . s0) (i64 a . 0))
          (while (coco_is_compound2 m s ":")
            (let ((size_t md . #'(coco_deref m (coco_arg m s 0))))
              (if (and (not (coco_m_is_var e md)) (not (coco_m_is_atom e md)))
                  (return (coco_m_type_error e "atom" md)))
              (set s (coco_deref m (coco_arg m s 1)))))
          (if (not (coco_m_is_var e s))
              (block
                (if (not (coco_is_compound2 m s "/"))
                    (return (coco_m_type_error e "predicate_indicator" s0)))
                (let ((size_t n . #'(coco_deref m (coco_arg m s 0)))
                      (size_t ar . #'(coco_deref m (coco_arg m s 1))))
                  (if (and (not (coco_m_is_var e n)) (not (coco_m_is_atom e n)))
                      (return (coco_m_type_error e "predicate_indicator" s0)))
                  (if (not (coco_m_is_var e ar))
                      (block (if (not (coco_m_int e ar (aof a)))
                                 (return (coco_m_type_error e "predicate_indicator" s0)))
                             (if (< a 0)
                                 (return (coco_m_domain_error e "not_less_than_zero" ar)))
                             (if (> a 2147483647)
                                 (return (coco_m_type_error e "predicate_indicator" s0))))))))
          (set s s0)
          (while (coco_is_compound2 m s ":")
            (let ((size_t md . #'(coco_deref m (coco_arg m s 0))))
              (if (coco_m_is_var e md)
                  (if (not (coco_m_unify e md (coco_new_atom m "user"))) (return 0)))
              (set s (coco_deref m (coco_arg m s 1)))))
          (return (coco_m_unify e (coco_m_arg e g 1) s))))

  ;;; '$cp_defined'(Name/Arity), current_predicate/1 named whole (3.31.0),
  ;;; after '$cp_spec'/2 made it an atom and an integer: a predicate of the
  ;;; system's, or one the program defines (`coco_pred_current'), as
  ;;; swipl's answers for module system's through user's import of it --
  ;;; atom_length/2, call/1, format/2 -- where through 3.30.0 the clause
  ;;; looked the name up in the list of the program's alone, which it made
  ;;; at every call.
  (func coco_b_cp_defined ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t s . #'(coco_deref m (coco_m_arg e g 0))) (i64 a . 0))
          (if (not (coco_m_int e (coco_arg m s 1) (aof a))) (return 0))
          (return (coco_pred_current (-> e st) m (coco_name_of m (coco_deref m (coco_arg m s 0)))
                                     (cast u32 a)))))

  ;;; ---- what the program imported (3.42.0) --------------------------------
  ;;;
  ;;; current_predicate/1 NAMED WHOLE asks of user's module, as swipl's: a
  ;;; predicate of swipl's system is user's through its import of system,
  ;;; and a library module's export is user's once the program imported
  ;;; it -- append/3 is none until a load names library(lists), whose
  ;;; module swipl has not even read before that. cocolog's libraries are
  ;;; always there, so what the program imported is kept apart: each load
  ;;; of library(Name) its read or its goal makes -- use_module/1,2,
  ;;; ensure_loaded/1, autoload/2's list -- and each head predicate_property/2
  ;;; names, which swipl's define_or_generate/1 autoloads. A row: the
  ;;; module, by swipl's name for it (lists, dcg_basics, prolog_listing), and
  ;;; what was imported of it: all (0), one name (1), all but the names its
  ;;; group lists (2), a name so listed (3). Noted before the load, as the
  ;;; goal is read nowhere after it. Process-wide, as swipl's module user
  ;;; is, and as the module registry is.
  (struct coco_imp
    (member char * mod)
    (member char * name)
    (member u32 arity)
    (member int kind)
    (member size_t grp))

  (static) (var coco_imp * cp_imps)
  (static) (var size_t cp_nimps)
  (static) (var size_t cp_capimps)
  (static) (var size_t cp_grps)
  ;; THE LIST'S LOCK (3.42.2), held by each reader and writer of the four
  ;; above: a library(thread) thread, or a green world's worker, loads with
  ;; a machine of its own, and each load notes its import here. Through
  ;; 3.42.1 two loads at once grew the array and freed it twice
  ;; (test/cowork.pl's workers: `double free or corruption' on GitHub's
  ;; Linux runner)
  (static) (var pthread_mutex_t cp_imp_mx . PTHREAD_MUTEX_INITIALIZER)

  ;; a row added; a growth refused adds none -- one import fewer, never a
  ;; wrong one
  (static)
  (func coco_imp_add ((const char * mod) (const char * name) (u32 arity) (int kind) (size_t grp))
        (if (>= cp_nimps cp_capimps)
            (let ((size_t cap . #'(? (== cp_capimps 0) 16 (* cp_capimps 2)))
                  (coco_imp * grown . #'(cast (coco_imp *) (realloc cp_imps (* cap (sizeof coco_imp))))))
              (if (== grown nil) (return))
              (set cp_imps grown)
              (set cp_capimps cap)))
        (let ((char * md . #'(strdup mod)) (char * nm . nil))
          (if (!= name nil) (set nm (strdup name)))
          (if (or (== md nil) (and (!= name nil) (== nm nil)))
              (block (free md) (free nm) (return)))
          (set ($ (nth cp_nimps cp_imps) mod) md)
          (set ($ (nth cp_nimps cp_imps) name) nm)
          (set ($ (nth cp_nimps cp_imps) arity) arity)
          (set ($ (nth cp_nimps cp_imps) kind) kind)
          (set ($ (nth cp_nimps cp_imps) grp) grp)
          (set cp_nimps (+ cp_nimps 1))))

  ;; the module of library(Name), by swipl's name for it: dcg/basics is
  ;; dcg_basics, listing prolog_listing, any other its name; 0 for a spec
  ;; that names no library
  (static)
  (func coco_imp_module ((coco_machine * m) (size_t spec) (char * out) (size_t cap)) (out int)
        (set spec (coco_deref m spec))
        (if (not (and (coco_is_callable m spec) (== (coco_arity m spec) 1)
                      (== 0 (strcmp (coco_atom_name m (coco_name_of m spec)) "library"))))
            (return 0))
        (let ((coco_strbuf b) (int ok . 0))
          (coco_sb_init (aof b))
          (coco_write_term m (aof b) (coco_deref m (coco_arg m spec 0)) 0 0)
          (if (!= ($ b s) nil)
              (block
                (cond ((== 0 (strcmp ($ b s) "dcg/basics")) (snprintf out cap "dcg_basics"))
                      ((== 0 (strcmp ($ b s) "dcg/high_order")) (snprintf out cap "dcg_high_order"))
                      ((== 0 (strcmp ($ b s) "listing")) (snprintf out cap "prolog_listing"))
                      (#t (snprintf out cap "%s" ($ b s))))
                (set ok 1)))
          (coco_sb_free (aof b))
          (return ok)))

  ;; each Name/Arity and Name//Arity of the list L, a row of KIND; what is
  ;; no indicator -- `PI as Name', which cocolog cannot rename -- none
  (static)
  (func coco_imp_pis ((coco_machine * m) (const char * mod) (size_t l) (int kind) (size_t grp))
        (set l (coco_deref m l))
        (while (coco_is_cons m l)
          (let ((size_t x . #'(coco_deref m (coco_arg m l 0))))
            (if (or (coco_is_compound2 m x "/") (coco_is_compound2 m x "//"))
                (let ((size_t nm . #'(coco_deref m (coco_arg m x 0)))
                      (size_t ar . #'(coco_deref m (coco_arg m x 1))))
                  (if (and (coco-tag-is ATOM (nth nm (-> m heap))) (coco-is-int (nth ar (-> m heap))))
                      (let ((i64 a . #'(coco_int_val m (nth ar (-> m heap)))))
                        (if (coco_is_compound2 m x "//") (set a (+ a 2)))
                        (if (and (>= a 0) (<= a 2147483647))
                            (coco_imp_add mod (coco_atom_name m (coco_name_of m nm)) (cast u32 a) kind grp))))))
            (set l (coco_deref m (coco_arg m l 1))))))

  (func coco_imp_note ((coco_machine * m) (size_t spec) (size_t imports) (int kind))
        (let ((char mod [256]) (size_t grp . 0))
          (if (coco_imp_module m spec mod (sizeof mod))
              (block
                (pthread_mutex_lock (aof cp_imp_mx))
                (set cp_grps (+ cp_grps 1))
                (set grp cp_grps)
                (set imports (coco_deref m imports))
                (cond
                  ((== kind 0) (coco_imp_add mod nil 0 0 grp))
                  ;; except(List): all of it but those
                  ((and (== kind 1) (coco_is_callable m imports) (== (coco_arity m imports) 1)
                        (== 0 (strcmp (coco_atom_name m (coco_name_of m imports)) "except")))
                   (block (coco_imp_add mod nil 0 2 grp)
                          (coco_imp_pis m mod (coco_arg m imports 0) 3 grp)))
                  (#t (coco_imp_pis m mod imports 1 grp)))
                (pthread_mutex_unlock (aof cp_imp_mx))))))

  ;; whether NAME/ARITY is in the list group GRP excepted
  (static)
  (func coco_imp_excepted ((size_t grp) (const char * name) (u32 arity)) (out int)
        (for ((size_t i . 0)) (< i cp_nimps) ((++ i))
          (if (and (== ($ (nth i cp_imps) grp) grp) (== ($ (nth i cp_imps) kind) 3)
                   (== ($ (nth i cp_imps) arity) arity) (== 0 (strcmp ($ (nth i cp_imps) name) name)))
              (return 1)))
        (return 0))

  ;; whether the program imported NAME/ARITY of library module MOD
  (static)
  (func coco_imp_has ((const char * mod) (const char * name) (u32 arity)) (out int)
        (for ((size_t i . 0)) (< i cp_nimps) ((++ i))
          (let ((coco_imp * r . #'(aof (nth i cp_imps))))
            (if (== 0 (strcmp (-> r mod) mod))
                (cond
                  ((== (-> r kind) 0) (return 1))
                  ((== (-> r kind) 1)
                   (if (and (== (-> r arity) arity) (== 0 (strcmp (-> r name) name))) (return 1)))
                  ((== (-> r kind) 2)
                   (if (not (coco_imp_excepted (-> r grp) name arity)) (return 1)))
                  (#t (block))))))
        (return 0))

  ;; the same, the table's lock held around it: predicate_property/2's
  (static)
  (func coco_imp_has_locked ((const char * mod) (const char * name) (u32 arity)) (out int)
        (let ((int r . 0))
          (pthread_mutex_lock (aof cp_imp_mx))
          (set r (coco_imp_has mod name arity))
          (pthread_mutex_unlock (aof cp_imp_mx))
          (return r)))

  ;;; current_predicate/1's answer of NAME/ARITY the system or a library
  ;;; defines (3.42.0, installed as `coco_cp_hook'): a predicate of swipl's
  ;;; system -- module system's or a `$' module's, whether cocolog writes it
  ;;; in C or as a library's clauses (between/3, sub_atom/5, bagof/3) -- is
  ;;; user's, and so is a hook swipl declares in user (3.48.0: a library's
  ;;; file_search_path/2 and prolog_file_type/2); a carried library's own
  ;;; predicate user does not see (a helper) none; any other module's once
  ;;; the program imported it; one the table has no row for -- cocolog's
  ;;; own -- what a construct or a C row of it says (CROW), as through
  ;;; 3.41.0.
  (func coco_b_cp_current ((const char * name) (u32 n) (int crow)) (out int)
        (let ((const char * imp . "") (const char * impl . "") (const char * spec . "")
              (int sw . #'(coco_swipl_props name n (aof imp) (aof impl) (aof spec))))
          (if (not sw) (return crow))
          (if (bitand (- sw 1) 4096) (return 0))
          (if (or (== 0 (strcmp impl "system")) (== 0 (strcmp impl "user"))
                  (== (nth 0 impl) (cast char 36)))
              (return 1))
          (let ((int r . 0))
            (pthread_mutex_lock (aof cp_imp_mx))
            (set r (coco_imp_has impl name n))
            (pthread_mutex_unlock (aof cp_imp_mx))
            (return r))))

  ;;; '$pp_autoload'(Head), predicate_property/2's of a head it names
  ;;; (3.42.0): a library module's export is the program's from now on, as
  ;;; swipl's define_or_generate/1 autoloads it into the module asked --
  ;;; user's, the head unqualified or qualified user: or system: last, and no
  ;;; other module's (lists:nth0(_, _, _) leaves nth0/3 none of user's).
  ;;; Not what swipl's autoloader does not reach: a library's helper,
  ;;; library(dcg/basics)'s exports (3.48.0). Always true.
  (func coco_b_pp_autoload ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t h . #'(coco_deref m (coco_m_arg e g 0))) (int ours . 1))
          (while (coco_is_compound2 m h ":")
            (let ((size_t md . #'(coco_deref m (coco_arg m h 0))))
              (set ours (and (coco-tag-is ATOM (nth md (-> m heap)))
                             (or (== 0 (strcmp (coco_atom_name m (coco_name_of m md)) "user"))
                                 (== 0 (strcmp (coco_atom_name m (coco_name_of m md)) "system")))))
              (set h (coco_deref m (coco_arg m h 1)))))
          (if (and ours (coco_is_callable m h))
              (let ((const char * imp . "") (const char * impl . "") (const char * spec . "")
                    (const char * name . #'(coco_atom_name m (coco_name_of m h)))
                    (u32 ar . #'(coco_arity m h))
                    (int sw . #'(coco_swipl_props name ar (aof imp) (aof impl) (aof spec))))
                ;; once: a loop of predicate_property/2 adds no row
                (if (and sw (not (bitand (- sw 1) 12288))
                         (!= 0 (strcmp impl "system")) (!= (nth 0 impl) (cast char 36)))
                    (block (pthread_mutex_lock (aof cp_imp_mx))
                           (if (not (coco_imp_has impl name ar))
                               (block (set cp_grps (+ cp_grps 1))
                                      (coco_imp_add impl name ar 1 cp_grps)))
                           (pthread_mutex_unlock (aof cp_imp_mx))))))
          (return 1)))

  ;;; '$ops'(P, T, N, L): THE OPERATORS current_op(P, T, N) CAN ANSWER, as
  ;;; `op(Priority, Type, Name)': those its bound arguments name and no
  ;;; other (3.25.0), so that the clause's member of them leaves no choice
  ;;; point at the last, as swipl's current_op/3 leaves none (through 3.24.0
  ;;; the whole table, walked by a member that left one at every answer).
  ;;; The DECLARED ones first and the built-in ones after, a built-in left out
  ;;; where a declaration of the same name and kind has hidden it -- what the
  ;;; reader would do, not two tables stuck together -- and of a NAME given,
  ;;; each table's prefix definition before its infix one, swipl's order
  ;;; (`-' is 200 fy, then 500 yfx); of none, the tables' own order.
  (func coco_b_ops ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t * v . nil) (size_t n . 0) (size_t cap . 0) (size_t out)
              (size_t pa . #'(coco_m_arg e g 0)) (size_t ta . #'(coco_m_arg e g 1))
              (size_t na . #'(coco_m_arg e g 2))
              (i64 pf . -1) (const char * tf . nil) (const char * nf . nil))
          (if (not (coco_m_is_var e pa))
              (if (not (coco_m_int e pa (aof pf))) (set pf -2)))
          (if (not (coco_m_is_var e ta)) (set tf (coco_m_atom e ta)))
          (if (not (coco_m_is_var e na)) (set nf (coco_m_atom e na)))
          (if (!= nf nil)
              (block
               (coco_b_ops_push e (aof v) (aof n) (aof cap) 1 1 nf pf tf)
               (coco_b_ops_push e (aof v) (aof n) (aof cap) 1 0 nf pf tf)
               (coco_b_ops_push e (aof v) (aof n) (aof cap) 0 1 nf pf tf)
               (coco_b_ops_push e (aof v) (aof n) (aof cap) 0 0 nf pf tf))
              (block
               (coco_b_ops_push e (aof v) (aof n) (aof cap) 1 -1 nf pf tf)
               (coco_b_ops_push e (aof v) (aof n) (aof cap) 0 -1 nf pf tf)))
          (set out (coco_m_list e v n))
          (free v)
          (return (coco_m_unify e (coco_m_arg e g 3) out))))

  ;;; DECLARED when `dyn', built-in otherwise, of the kind KF (1 prefix, 0
  ;;; infix, -1 either), named NF, of the priority PF and the type TF where
  ;;; those are given (nil, or -1, for none). Pulled out because the loops are
  ;;; the same but for which table they read and whether they skip.
  (static)
  (func coco_b_ops_push ((coco_engine * e) (size_t ** v) (size_t * n) (size_t * cap)
                       (int dyn) (int kf) (const char * nf) (i64 pf) (const char * tf))
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t total . #'(? dyn (coco_op_dyn_count) (coco_op_static_count))))
          (for ((size_t i . 0)) (< i total) ((++ i))
            (let ((const char * name . nil) (int prec . 0)
                  (int type . 0) (int kind . 0))
              (if (not (? dyn (coco_op_dyn_at i (aof name) (aof prec) (aof type) (aof kind))
                          (coco_op_static_at i (aof name) (aof prec) (aof type) (aof kind))))
                  continue)
              ;; a declaration with priority 0 is not an operator, and a
              ;; built-in that one has hidden is not one either
              (if (== prec 0) continue)
              (if (and (>= kf 0) (!= kind kf)) continue)
              (if (and (!= nf nil) (!= 0 (strcmp name nf))) continue)
              (if (and (!= pf -1) (!= (cast i64 prec) pf)) continue)
              (if (and (!= tf nil) (!= 0 (strcmp (coco_b_typename type) tf))) continue)
              (if (not dyn)
                  (let ((int dp . 0) (int dt . 0))
                    (if (>= (coco_op_dyn_lookup_pub name kind (aof dp) (aof dt)) 0)
                        continue)))
              (if (>= (cof n) (cof cap))
                  (let ((size_t ncap . #'(? (== (cof cap) 0) 64 (* (cof cap) 2)))
                        (size_t * nb))
                    (set nb (cast (size_t *) (realloc (cof v) (* ncap (sizeof size_t)))))
                    (if (== nb nil) (return))
                    (set (cof v) nb)
                    (set (cof cap) ncap)))
              (let ((size_t args [3]))
                (set (nth 0 args) (coco_new_int m (cast i64 prec)))
                (set (nth 1 args) (coco_new_atom m (coco_b_typename type)))
                (set (nth 2 args) (coco_new_atom m name))
                (set (nth (cof n) (cof v)) (coco_make m "op" 3 args)))
              (set (cof n) (+ (cof n) 1))))))

  ;;; ---- halting ----------------------------------------------------------

  ;;; the code an integer, as swipl's: an unbound one instantiation_error,
  ;;; anything else type_error(integer, C) (3.0.0; through 2.16 `halt(a)'
  ;;; halted with status 0)
  (func coco_b_halt1 ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 code . 0))
          (if (not (coco_m_int e (coco_m_arg e g 0) (aof code)))
              (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
          (set (-> e halted) 1)
          (set (-> e halt_code) (cast int code))
          (return 1)))

  ;;; ---- a sort the aggregation needs -------------------------------------

  ;;; RUNG 191.14 (from CivV): THREAD-LOCAL, and it has to be. The array
  ;;; qsort is handed holds HEAP INDICES, not pointers, and this variable is
  ;;; the only thing that says which machine those indices belong to. As a
  ;;; file-scope static it was one slot for the whole process, so two threads
  ;;; sorting at once had the second overwrite the first's machine and the
  ;;; first's comparator then indexed a foreign heap.
  ;;;
  ;;; Reproduced through library(cowork) itself: 2000 sorting jobs on a
  ;;; four-worker crew while the main thread sorted 1500 times -- SIGSEGV,
  ;;; three runs of three. With a thin overlap it comes back clean every
  ;;; time, which is why a light test does not find it. CivV sorts three
  ;;; times a frame in its renderer and about twenty times an AI turn, so a
  ;;; crew doing game work overlaps the drawing thread by construction.
  ;;;
  ;;; `(thread-local)' emits `__thread', which takes a trivially destroyed
  ;;; type -- a bare pointer qualifies, as x509's and tls's buffers do. It
  ;;; replaces `(static)' rather than joining it because no attribute in this
  ;;; tree is stacked and the emitter has never been asked to.
  (thread-local) (var coco_machine * coco_b_sort_machine)

  (static)
  (func coco_b_sort_cmp ((const void * a) (const void * b)) (out int)
        (return (coco_compare coco_b_sort_machine
                            (cof (cast (const size_t *) a))
                            (cof (cast (const size_t *) b)))))

  (static)
  (func coco_b_sort_terms ((coco_machine * m) (size_t * v) (size_t n))
        (set coco_b_sort_machine m)
        (qsort v n (sizeof size_t) coco_b_sort_cmp))

  ;;; ---- the module -------------------------------------------------------

  (static) (coco-emit-module-dispatch coco_b_dispatch *builtins-predicates*)

  (coco-defmodule coco_builtins_module "builtins" coco_b_dispatch *builtins-prolog*)

  ) ; impl-builtins-db

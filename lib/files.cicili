;;;; cocolog -- the Files library, as a module
;;;
;;; SWI-Prolog's file-system predicates (its manual section "Files"), written
;;; against lib/module.cicili. It is the worked example of what a module is
;;; for: the things that need a syscall are in the C half, the things that are
;;; clearer as clauses are in the Coco half, and a program cannot tell which is
;;; which.
;;;
;;; IT IS WRITTEN TO MATCH SWI AND NOT TO RESEMBLE IT. Every edge below was
;;; read off a running SWI-Prolog 9 rather than guessed, because the ones that
;;; matter are exactly the ones nobody guesses right:
;;;
;;;   file_base_name('/a/b/', X)         X = b        -- trailing slash first
;;;   file_directory_name('/a/b/', X)    X = '/a'
;;;   file_directory_name(abc, X)        X = '.'
;;;   file_directory_name('/abc', X)     X = '/'
;;;   file_name_extension(B, E, 'a.b.c') B = 'a.b', E = c
;;;   file_name_extension(B, E, noext)   B = noext, E = ''
;;;   file_name_extension(B, E, '/a/b.d/c')   E = ''  -- a dot in a DIRECTORY
;;;                                                      is not an extension
;;;   file_name_extension(x, '.md', F)   F = 'x.md'   -- a dotted Ext is taken
;;;   working_directory(W, W)            W ends in '/'
;;;   directory_files/2                  includes '.' and '..'
;;;   access_file(missing, none)         true
;;;   absolute_file_name/2               normalises '.' and '..', does NOT
;;;                                      require the file to exist, does NOT
;;;                                      resolve symbolic links
;;;
;;; test/files/*.pl are run against BOTH systems and their output compared, so
;;; these are checked rather than asserted.
;;;
;;; ITS ERRORS ARE SWI'S: `delete_file/1' on a file that is not there is
;;; existence_error(file, F), with swipl's context, and so on through the
;;; table (through 2.x a failure here was false where SWI raised).
;;;
;;; NOT IMPLEMENTED, and why: `tmp_file_stream/3' and everything else that
;;; hands back a stream, because the streams are library(stream)'s, which
;;; this module does not load. absolute_file_name/3 is here since 3.1.0:
;;; swipl's own clauses, ported into the Coco half below, over the /2 form's
;;; C ('$absolute_file_name'/2) and the file tests.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;;; ------------------------------------------------------------------
;;;; The C half, as a table
;;;; ------------------------------------------------------------------
;;; Read by `coco-emit-module-dispatch' to build the dispatcher, exactly as
;;; *builtins* is read in solve.cicili. Adding a predicate is a line here and a
;;; function below, and the two cannot drift apart.
;;;
;;; The three `$'-prefixed ones are not part of the library's surface: they are
;;; the primitives the Coco half is built from, named so that a program that
;;; calls them knows it is reaching under something.
(DEFPARAMETER *files-predicates*
  '(("exists_file"           1 coco_f_exists_file)
    ("exists_directory"      1 coco_f_exists_directory)
    ("access_file"           2 coco_f_access_file)
    ("size_file"             2 coco_f_size_file)
    ("time_file"             2 coco_f_time_file)
    ("get_time"              1 coco_f_get_time)
    ("read_file_to_codes"    2 coco_f_read_file_to_codes)
    ("write_file_from_codes" 2 coco_f_write_file_from_codes)
    ("append_file_from_codes" 2 coco_f_append_file_from_codes)

    ("delete_file"           1 coco_f_delete_file)
    ("rename_file"           2 coco_f_rename_file)
    ("make_directory"        1 coco_f_make_directory)
    ("delete_directory"      1 coco_f_delete_directory)

    ("directory_files"       2 coco_f_directory_files)
    ("expand_file_name"      2 coco_f_expand_file_name)
    ("$absolute_file_name"   2 coco_f_absolute_file_name)
    ("same_file"             2 coco_f_same_file)
    ("read_link"             3 coco_f_read_link)
    ("tmp_file"              2 coco_f_tmp_file)
    ("working_directory"     2 coco_f_working_directory)
    ("is_absolute_file_name" 1 coco_f_is_absolute)

    ("$path_base"            2 coco_f_path_base)
    ("$path_dir"             2 coco_f_path_dir)
    ("$ext_split"            3 coco_f_ext_split)
    ("$ext_join"             3 coco_f_ext_join)))

;;;; ------------------------------------------------------------------
;;;; The Coco half
;;;; ------------------------------------------------------------------
;;; Joined with real `\n' escapes rather than written as one long string,
;;; because a Cicili string literal is RAW -- it reaches C untouched, so a
;;; newline in the source would be a newline inside a C string literal, which
;;; does not compile. The joining happens at macro-expansion time and costs
;;; nothing at run time.
;;; A CICILI STRING LITERAL CANNOT CARRY A NEWLINE. Written as a real newline
;;; it lands unescaped inside a C string literal, which does not compile;
;;; written as `\n' it is emitted as an escaped backslash and arrives at the
;;; reader as the two characters. So the clauses are joined with a SPACE, which
;;; Prolog does not mind at all -- a clause ends at its `.', not at a line
;;; ending -- and the commentary that would have been `%' lines lives out here
;;; instead, where it is not in a string and cannot swallow the rest of the
;;; program the way a `%' with no newline after it would.
(DEFPARAMETER *files-prolog*
  (FORMAT NIL "~{~A ~}"
          (LIST
           ;; the two halves of one split (`coco_f_split'), so they cannot
           ;; disagree, each its own C half so that an error names the
           ;; predicate it was raised in (3.0.0)
           "file_base_name(Path, Base) :- '$path_base'(Path, Base)."
           "file_directory_name(Path, Dir) :- '$path_dir'(Path, Dir)."

           ;; Splitting when the whole name is known, joining when it is not.
           ;; The cut is what makes the splitting mode deterministic, which
           ;; every builtin in cocolog has to be.
           "file_name_extension(Base, Ext, File) :- nonvar(File), !, '$ext_split'(File, Base, Ext)."
           "file_name_extension(Base, Ext, File) :- '$ext_join'(Base, Ext, File)."

           ;; On a POSIX system a Prolog file name and an operating-system one
           ;; are the same thing, in both directions.
           "prolog_to_os_filename(F, F)."

           ;; mkdir -p, and the reason the Coco half exists: it is a recursion
           ;; over the C half, and it reads as one. `Parent \== Dir' is what
           ;; stops it at the root, where the directory of `/' is `/'.
           "make_directory_path(Dir) :- exists_directory(Dir), !."
           "make_directory_path(Dir) :- file_directory_name(Dir, Parent), Parent \\== Dir, make_directory_path(Parent), make_directory(Dir)."

           ;; ---- absolute_file_name/2,3 and the search paths (3.1.0) -----
           ;;
           ;; SWIPL'S OWN CLAUSES, PORTED: boot/init.pl's absolute_file_name/3
           ;; and its helpers, and boot/syspred.pl's /2, each under a
           ;; `'$afn_' name, with what the name's C (`'$absolute_file_name'/2',
           ;; below) and the file tests answer. Through 3.0.0 /3 did not
           ;; exist, and /2 was the C alone, which knew `library(X)' as the
           ;; library path's first directory and no other alias.
           ;;
           ;; THE OPTIONS ARE SWIPL'S, AND SO ARE ITS QUIRKS, read off 9.0.4:
           ;; extensions, file_type, access (one mode or a list), solutions,
           ;; file_errors, expand and relative_to; an option it does not know
           ;; is ignored. Its options become a DICT at the first
           ;; '$select_option'/3 -- here `'$afn_d'(Pairs)' -- and that is
           ;; observable: a key given twice is duplicate_key(K), an element
           ;; that is no key-value is type_error('key-value', E), and once the
           ;; options are a dict a failed search names no condition, only
           ;; existence_error(source_sink, Spec) -- with `access(read)' and
           ;; no file_type, the regular-file condition is merged in, and so
           ;; it is a dict. A relative name is tried against the directory of
           ;; the file being loaded first (source_location/2), then the
           ;; working directory. A list of codes or characters is text, as
           ;; the C reads it, where swipl's "..." is a string.
           "absolute_file_name(Name, Abs) :- '$afn_atomic'(Name), !, '$absolute_file_name'(Name, Abs)."
           "absolute_file_name(Term, Abs) :- '$afn_chk'(Term, [''], [access(read)], true, File), !, '$absolute_file_name'(File, Abs)."
           "absolute_file_name(Term, Abs) :- '$afn_chk'(Term, [''], [], true, File), !, '$absolute_file_name'(File, Abs)."
           "absolute_file_name(Spec, Options, Path) :- '$afn_is_options'(Options), \\+ '$afn_is_options'(Path), !,"
           "    absolute_file_name(Spec, Path, Options)."
           "absolute_file_name(Spec, Path, Options) :- '$afn_must_be'(options, Options),"
           "    ( '$afn_select'(extensions(Exts), Options, Options1) -> '$afn_must_be'(list, Exts)"
           "    ; '$afn_option'(file_type(Type), Options) -> '$afn_must_be'(atom, Type), '$afn_type_exts'(Type, Exts), Options1 = Options"
           "    ; Options1 = Options, Exts = [''] ),"
           "    '$afn_canon_exts'(Exts, Extensions),"
           "    ( ( nonvar(Type) ; '$afn_option'(access(none), Options, none) ) -> Options2 = Options1"
           "    ; '$afn_merge'([file_type-regular], Options1, Options2) ),"
           "    ( '$afn_select'(solutions(Sols), Options2, Options3) -> '$afn_must_be'(oneof(atom, solutions, [first, all]), Sols)"
           "    ; Sols = first, Options3 = Options2 ),"
           "    ( '$afn_select'(file_errors(Errs), Options3, Options4) -> '$afn_must_be'(oneof(atom, file_errors, [error, fail]), Errs)"
           "    ; Errs = error, Options4 = Options3 ),"
           ;; expand(false) expands too: the option's presence is swipl's test
           "    ( '$afn_atomic'(Spec), '$afn_select'(expand(Expand), Options4, Options5), '$afn_must_be'(boolean, Expand)"
           "      -> expand_file_name(Spec, List), member(Spec1, List)"
           "    ; Spec1 = Spec, Options5 = Options4 ),"
           "    ( Sols == first"
           "      -> ( '$afn_chk'(Spec1, Extensions, Options5, true, Path) -> !"
           "         ; Errs == fail -> fail"
           "         ; findall(P, '$afn_chk'(Spec1, Extensions, [access(exist)], false, P), Cands),"
           "           '$afn_error'(Spec, Cands, Options5) )"
           "    ; '$afn_chk'(Spec1, Extensions, Options5, false, Path) )."
           "'$afn_atomic'(N) :- atomic(N), !."
           "'$afn_atomic'(N) :- is_list(N), N = [C|_], ( integer(C) -> true ; atom(C) ), catch(atom_codes(_, N), _, fail)."
           "'$afn_is_options'(L) :- is_list(L), ( L == [] -> true ; L = [H|_], '$afn_is_option'(H) )."
           "'$afn_is_option'(V) :- var(V), !, fail."
           "'$afn_is_option'(F) :- functor(F, _, 1), !."
           "'$afn_is_option'(_ = _)."
           ;; '$option'/2,3, '$select_option'/3 and '$merge_options'/3 over a
           ;; list or the dict
           "'$afn_option'(O, D) :- nonvar(D), D = '$afn_d'(Ps), !, functor(O, K, 1), arg(1, O, V), memberchk(K-V0, Ps), V = V0."
           "'$afn_option'(O, L) :- memberchk(O, L)."
           "'$afn_option'(T, Os, Def) :- arg(1, T, V), functor(T, K, 1),"
           "    ( nonvar(Os), Os = '$afn_d'(Ps) -> ( memberchk(K-V0, Ps) -> V = V0 ; V = Def )"
           "    ; functor(G, K, 1), arg(1, G, V0), ( memberchk(G, Os) -> V = V0 ; V = Def ) )."
           "'$afn_select'(O, Os, '$afn_d'(Rest)) :- '$afn_dict'(Os, Ps), functor(O, K, 1), arg(1, O, V), selectchk(K-V0, Ps, Rest), V = V0."
           "'$afn_merge'(New, Old, '$afn_d'(Ps)) :- '$afn_dict'(Old, Ps0), '$afn_put'(New, Ps0, Ps)."
           "'$afn_put'([], Ps, Ps)."
           "'$afn_put'([K-V|T], Ps0, Ps) :- ( selectchk(K-_, Ps0, Ps1) -> true ; Ps1 = Ps0 ), append(Ps1, [K-V], Ps2), '$afn_put'(T, Ps2, Ps)."
           ;; a list made a dict as swipl's select_dict/3 makes one: each
           ;; element K(V), K=V, K-V or K:V, K an atom or an integer
           "'$afn_dict'(D, Ps) :- nonvar(D), D = '$afn_d'(Ps), !."
           "'$afn_dict'(L, Ps) :- '$afn_pairs'(L, [], Ps)."
           "'$afn_pairs'([], Acc, Ps) :- reverse(Acc, Ps)."
           "'$afn_pairs'([O|Os], Acc, Ps) :-"
           "    ( '$afn_kv'(O, K, V)"
           "      -> ( var(K) -> throw(error(instantiation_error, context(system:select_dict/3, _)))"
           "         ; \\+ atom(K), \\+ integer(K) -> throw(error(type_error('dict-key', K), context(system:select_dict/3, _)))"
           "         ; memberchk(K-_, Acc) -> throw(error(duplicate_key(K), context(system:select_dict/3, _)))"
           "         ; '$afn_pairs'(Os, [K-V|Acc], Ps) )"
           "    ; var(O) -> throw(error(instantiation_error, context(system:select_dict/3, _)))"
           "    ; throw(error(type_error('key-value', O), context(system:select_dict/3, _))) )."
           "'$afn_kv'(O, _, _) :- var(O), !, fail."
           "'$afn_kv'(K = V, K, V) :- !."
           "'$afn_kv'(K - V, K, V) :- !."
           "'$afn_kv'(K : V, K, V) :- !."
           "'$afn_kv'(O, K, V) :- compound(O), functor(O, K, 1), arg(1, O, V)."
           ;; swipl's '$must_be'/2: a list that is none names its tail
           "'$afn_must_be'(list, X) :- !, '$afn_tail'(X, 0, T), ( T == [] -> true ; '$afn_type_error'(list, T) )."
           "'$afn_must_be'(options, X) :- !, ( '$afn_is_options'(X) -> true ; '$afn_type_error'(options, X) )."
           "'$afn_must_be'(atom, X) :- !, ( atom(X) -> true ; '$afn_type_error'(atom, X) )."
           "'$afn_must_be'(oneof(T, D, L), X) :- !, '$afn_must_be'(T, X), ( memberchk(X, L) -> true ; throw(error(domain_error(D, X), _)) )."
           "'$afn_must_be'(boolean, X) :- ( ( X == true ; X == false ) -> true ; '$afn_type_error'(boolean, X) )."
           "'$afn_type_error'(_, V) :- var(V), !, throw(error(instantiation_error, _))."
           "'$afn_type_error'(T, V) :- throw(error(type_error(T, V), _))."
           "'$afn_tail'(L, N, T) :- ( N < 1000000, nonvar(L), L = [_|R] -> N1 is N + 1, '$afn_tail'(R, N1, T) ; T = L )."
           ;; a file type's extensions are prolog_file_type/2's, a program's
           ;; own clauses of it among them, and then none
           "'$afn_type_exts'(source, Exts) :- !, '$afn_type_exts'(prolog, Exts)."
           "'$afn_type_exts'(Type, Exts) :- findall(Ext, prolog_file_type(Ext, Type), Exts0),"
           "    ( Exts0 == [], \\+ '$afn_no_ext'(Type) -> throw(error(domain_error(file_type, Type), _)) ; true ),"
           "    append(Exts0, [''], Exts)."
           "'$afn_no_ext'(txt)."
           "'$afn_no_ext'(executable)."
           "'$afn_no_ext'(directory)."
           "'$afn_no_ext'(regular)."
           "'$afn_canon_exts'([], []) :- !."
           "'$afn_canon_exts'([H|T], [CH|CT]) :- !, '$afn_must_be'(atom, H), '$afn_canon_ext'(H, CH), '$afn_canon_exts'(T, CT)."
           "'$afn_canon_exts'(E, [CE]) :- '$afn_canon_ext'(E, CE)."
           "'$afn_canon_ext'('', '') :- !."
           "'$afn_canon_ext'(D, D) :- sub_atom(D, 0, 1, _, '.'), !."
           "'$afn_canon_ext'(A, D) :- atom_concat('.', A, D)."
           ;; '$chk_file'/5: an alias, a path of segments, an absolute name,
           ;; a name relative to the file being loaded, then to the working
           ;; directory; CACHE is swipl's, here whether the alias's
           ;; expansions are all made first
           "'$afn_chk'(Spec, _, _, _, _) :- \\+ ground(Spec), !, throw(error(instantiation_error, _))."
           "'$afn_chk'(Spec, Exts, Cond, Cache, Full) :- compound(Spec), functor(Spec, _, 1), !, '$afn_alias'(Spec, Exts, Cond, Cache, Full)."
           "'$afn_chk'(Segs, Exts, Cond, Cache, Full) :- \\+ atomic(Segs), !, '$afn_seg_atom'(Segs, Atom), '$afn_chk'(Atom, Exts, Cond, Cache, Full)."
           "'$afn_chk'(File, Exts, Cond, _, Full) :- is_absolute_file_name(File), !,"
           "    '$afn_extend'(File, Exts, Ext), '$afn_conds'(Cond, Ext), '$absolute_file_name'(Ext, Full)."
           "'$afn_chk'(File, Exts, Cond, _, Full) :- '$afn_relative_to'(Cond, source, Dir), atomic_list_concat([Dir, /, File], Abs),"
           "    '$afn_extend'(Abs, Exts, Ext), '$afn_conds'(Cond, Ext), !, '$absolute_file_name'(Ext, Full)."
           "'$afn_chk'(File, Exts, Cond, _, Full) :- '$afn_extend'(File, Exts, Ext), '$afn_conds'(Cond, Ext), '$absolute_file_name'(Ext, Full)."
           "'$afn_seg_atom'(A, A) :- atomic(A), !."
           "'$afn_seg_atom'(L, A) :- '$afn_atomic'(L), !, atom_codes(A, L)."
           "'$afn_seg_atom'(S, A) :- '$afn_segs'(S, L, []), !, atomic_list_concat(L, /, A)."
           "'$afn_segs'(A/B, H, T) :- '$afn_segs'(A, H, T0), '$afn_segs'(B, T0, T)."
           "'$afn_segs'(A, [A|T], T) :- atomic(A)."
           "'$afn_relative_to'(Conds, Default, Dir) :-"
           "    ( '$afn_option'(relative_to(FileOrDir), Conds)"
           "      *-> ( exists_directory(FileOrDir) -> Dir = FileOrDir"
           "          ; atom_concat(Dir, /, FileOrDir) -> true"
           "          ; file_directory_name(FileOrDir, Dir) )"
           "    ; Default == cwd -> working_directory(Dir, Dir)"
           "    ; Default == source -> source_location(ContextFile, _), file_directory_name(ContextFile, Dir) )."
           "'$afn_alias'(Spec, Exts, Cond, true, Full) :- !, findall(Exp, expand_file_search_path(Spec, Exp), Exps),"
           "    member(Expanded, Exps), '$afn_extend'(Expanded, Exts, File), '$afn_conds'(Cond, File), '$absolute_file_name'(File, Full)."
           "'$afn_alias'(Spec, Exts, Cond, false, Full) :- expand_file_search_path(Spec, Expanded),"
           "    '$afn_extend'(Expanded, Exts, File), '$afn_conds'(Cond, File), '$absolute_file_name'(File, Full)."
           ;; swipl's expand_file_search_path/2: an alias sixteen deep is a
           ;; loop_error naming the aliases it went through
           "expand_file_search_path(Spec, Expanded) :-"
           "    catch('$afn_expand'(Spec, Expanded, 0, []), loop(Used), throw(error(loop_error(Spec), file_search(Used))))."
           "'$afn_expand'(Spec, Expanded, N, Used) :- functor(Spec, Alias, 1), !, file_search_path(Alias, Exp0),"
           "    NN is N + 1, ( NN > 16 -> throw(loop(Used)) ; true ),"
           "    '$afn_expand'(Exp0, Exp1, NN, [Alias=Exp0|Used]),"
           "    arg(1, Spec, Segments), '$afn_seg_atom'(Segments, File), '$afn_make_path'(Exp1, File, Expanded)."
           "'$afn_expand'(Spec, Path, _, _) :- '$afn_seg_atom'(Spec, Path)."
           "'$afn_make_path'(Dir, '.', Dir) :- !."
           "'$afn_make_path'(Dir, File, Path) :- atom_concat(_, /, Dir), !, atom_concat(Dir, File, Path)."
           "'$afn_make_path'(Dir, File, Path) :- atomic_list_concat([Dir, /, File], Path)."
           "'$afn_extend'(File, Exts, FileEx) :- '$afn_with_exts'(Exts, File, Fs), list_to_set(Fs, Set), member(FileEx, Set)."
           "'$afn_with_exts'([], _, [])."
           "'$afn_with_exts'([E|Es], F, [FE|FEs]) :- file_name_extension(F, E, FE), '$afn_with_exts'(Es, F, FEs)."
           ;; the conditions a name must meet, of a list or of the dict
           "'$afn_conds'(L, File) :- is_list(L), !, \\+ ( member(C, L), '$afn_is_cond'(C), \\+ '$afn_cond'(C, File) )."
           "'$afn_conds'('$afn_d'(Ps), File) :- \\+ ( member(K-V, Ps), C =.. [K, V], '$afn_is_cond'(C), \\+ '$afn_cond'(C, File) )."
           "'$afn_is_cond'(exists)."
           "'$afn_is_cond'(file_type(_))."
           "'$afn_is_cond'(access(_))."
           "'$afn_cond'(file_type(directory), File) :- !, exists_directory(File)."
           "'$afn_cond'(file_type(_), File) :- !, \\+ exists_directory(File)."
           "'$afn_cond'(access(As), File) :- !, \\+ ( '$afn_one_or_member'(A, As), \\+ access_file(File, A) )."
           "'$afn_one_or_member'(E, L) :- is_list(L), !, member(E, L)."
           "'$afn_one_or_member'(E, E)."
           ;; a failed search's error: the first candidate that exists and a
           ;; condition it fails, of a LIST of conditions -- a dict has no
           ;; member/2, as swipl's '$member'/2 meets none -- else no file
           "'$afn_error'(Spec, Cands, Conds) :- member(F, Cands), member(C, Conds), '$afn_is_cond'(C),"
           "    '$afn_file_error'(C, Spec, F, E, Comment), !, throw(error(E, context(_, Comment)))."
           "'$afn_error'(Spec, _, _) :- throw(error(existence_error(source_sink, Spec), _))."
           "'$afn_file_error'(file_type(directory), Spec, File, existence_error(directory, Spec), not_a_directory(File)) :- \\+ exists_directory(File), !."
           "'$afn_file_error'(file_type(_), Spec, File, existence_error(file, Spec), directory(File)) :- exists_directory(File), !."
           "'$afn_file_error'(access(OneOrList), Spec, File, permission_error(A, source_sink, Spec), _) :-"
           "    '$afn_one_or_member'(A, OneOrList), \\+ access_file(File, A)."

           ;; THE SEARCH PATHS, swipl's file_search_path/2 and
           ;; prolog_file_type/2, which a program extends with clauses of its
           ;; own: `library' is library_directory/1's (none, until a program
           ;; adds them) and then cocolog's library path in use_module/1's
           ;; order ('$library_dirs'/1, lib/library.cicili), `foreign' the
           ;; same, where the .so modules are, `swi' the binary's directory
           ;; and `path' $PATH. The Prolog files are pl, prolog and qlf and an
           ;; executable a .so, cocolog's modules on Linux and macOS alike
           ;; (swipl's is .dylib on a Mac). The two are multifile, as
           ;; swipl's are: a program's clauses join these.
           ":- dynamic(library_directory/1)."
           ":- multifile(file_search_path/2)."
           ":- multifile(prolog_file_type/2)."
           "file_search_path(library, Dir) :- library_directory(Dir)."
           "file_search_path(swi, Home) :- current_prolog_flag(executable, E), file_directory_name(E, Home)."
           "file_search_path(library, Dir) :- '$library_dirs'(Ds), member(Dir, Ds)."
           "file_search_path(foreign, Dir) :- '$library_dirs'(Ds), member(Dir, Ds)."
           "file_search_path(path, Dir) :- getenv('PATH', Path), atomic_list_concat(Dirs, :, Path), member(Dir, Dirs)."
           "prolog_file_type(pl, prolog)."
           "prolog_file_type(prolog, prolog)."
           "prolog_file_type(qlf, prolog)."
           "prolog_file_type(qlf, qlf)."
           "prolog_file_type(so, executable).")))

(generic decl-files
  ()

  ;;; Cicili has no `struct X' in type position -- a type is a name -- so the
  ;;; two POSIX structs are given one. `stat_t' is what lib/std/c/posix
  ;;; declares (`stat' would collide with the function), and both spellings are
  ;;; the documented `@define' form from doc/lib-std-c.md. `DIR' needs none: it
  ;;; is already a typedef in the header.
  (@define (code "stat_t struct stat"))
  (@define (code "dirent struct dirent"))
  ;;; `struct timeval' likewise -- std's posix/sys-time declares the members
  ;;; under `timeval', so that is the one name that reaches them
  (@define (code "timeval struct timeval"))

  ;;; Registers the module. A target calls this after `coco_module_init'.
  (decl) (func coco_files_module () (out int))

  ;;; A file's time_file/2 -- when it was last written, in seconds since the
  ;;; epoch to the nanosecond (2.12.2) -- into *T: 1, or 0 for a path stat(2)
  ;;; cannot read. load_files/2's `if(changed)' compares it (2.13.0).
  (decl) (func coco_file_mtime ((const char * path) (double * t)) (out int))

  ) ; decl-files


(generic impl-files
  ()

  ;;; PATH_MAX is not portable enough to rely on and not generous enough to be
  ;;; safe where it is defined, so every buffer here is an explicit 4096 and
  ;;; every read of one is bounded by `sizeof' of the buffer it is filling --
  ;;; the capacity travels with the buffer rather than as a constant the two
  ;;; could stop agreeing about.

  ;;; ---- reading a path argument ----------------------------------------

  ;;; Argument I of the goal as a path. Answers 1, or 0 having filled in the
  ;;; engine's error -- so a caller writes
  ;;;
  ;;;   (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
  ;;;
  ;;; and the -1 carries the message. An unbound argument is an instantiation
  ;;; error and not a failure, which is what SWI does and what a program
  ;;; debugging itself needs.
  ;;; RC CARRIES WHAT THE CALLER SHOULD RETURN when this fails, because the
  ;;; error is now a THROW: if some `catch/3' took it the builtin must answer 1
  ;;; and let the engine run the recovery goal, and if none did it must answer
  ;;; -1. A plain 0 would be a silent failure in the first case, which is the
  ;;; opposite of what the program asked for.
  ;;;
  ;;; THE TEXT IS READ AS SWIPL'S PL_get_file_name() READS IT (3.0.0,
  ;;; `coco_tx_get'): an atom, a string, a list of codes or of characters,
  ;;; `[]' the empty name -- and a number never, type_error(text, N), as
  ;;; any other term is; an element of a list that is no code or no
  ;;; character is type_error(character_code, X) or type_error(character, X).
  ;;; ALL is swipl's CVT_ALL, what the name predicates and tmp_file/2 read:
  ;;; a number is its digits there. Through 2.16 a number was its digits
  ;;; everywhere, a list of characters no text, and anything else
  ;;; type_error(atom, T).
  (static)
  (func coco_f_path_as ((coco_engine * e) (size_t g) (u32 i) (char * out) (size_t cap)
                      (int * rc) (int all))
        (out int)
        (let ((coco_strbuf b)
              (int r . #'(coco_tx_get e (coco_m_arg e g i) (? all 31 29) (aof b))))
          (if (!= r 1) (block (set (cof rc) r) (return 0)))
          (if (>= ($ b len) cap)
              (block (coco_sb_free (aof b))
                     (set (cof rc) (coco_m_error e "the path will not fit" nil))
                     (return 0)))
          (memcpy out (coco_tx_s (aof b)) ($ b len))
          (set (nth ($ b len) out) (cast char 0))
          (coco_sb_free (aof b))
          (return 1)))

  (static)
  (func coco_f_path ((coco_engine * e) (size_t g) (u32 i) (char * out) (size_t cap)
                   (int * rc))
        (out int)
        (return (coco_f_path_as e g i out cap rc 0)))

  ;;; ---- existence and access -------------------------------------------

  (static)
  (func coco_f_stat_is ((const char * path) (int want_dir)) (out int)
        (let ((stat_t sb))
          (if (!= 0 (stat path (aof sb))) (return 0))
          (if want_dir (return (? (S_ISDIR ($ sb st_mode)) 1 0)))
          (return (? (S_ISREG ($ sb st_mode)) 1 0))))

  (func coco_f_exists_file ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          (return (coco_f_stat_is p 0))))

  (func coco_f_exists_directory ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          (return (coco_f_stat_is p 1))))

  ;;; The mode's errors, swipl's: named bare (`access_file/2', where the
  ;;; file's are `system:access_file/2').
  (static)
  (func coco_f_mode_error ((coco_engine * e) (size_t ball)) (out int)
        (return (coco_m_raise_pi e ball "" "access_file" 2)))

  ;;; Whether a file that is not there could be written: its directory can.
  (static)
  (func coco_f_creatable ((const char * p)) (out int)
        (let ((char dir [4096]) (char * slash . nil))
          (snprintf dir (sizeof dir) "%s" p)
          (set slash (strrchr dir 47))
          (if (== slash nil) (return (? (== 0 (access "." W_OK)) 1 0)))
          (if (== slash dir) (return (? (== 0 (access "/" W_OK)) 1 0)))
          (set (nth 0 slash) (cast char 0))
          (return (? (== 0 (access dir W_OK)) 1 0))))

  ;;; SWI's modes. `none' is true of anything, including a file that is not
  ;;; there -- it asks for no access and gets it. `append' is `write', and
  ;;; `search' is `execute' spelt for directories. SWI'S ORDER AND WORDS
  ;;; (3.0.0): the mode unbound or no atom first, then the file, then the
  ;;; mode's domain, `io_mode' (it was `access_mode', and an unbound mode
  ;;; its domain_error); and a file that is not there can be written when
  ;;; its directory can, as swipl's AccessFile() answers (it said no).
  (func coco_f_access_file ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (int rc . 0) (char p [4096]) (const char * mode . nil)
              (size_t md . #'(coco_deref m (coco_m_arg e g 1))))
          (if (coco_m_is_var e md)
              (return (coco_f_mode_error e (coco_new_atom m "instantiation_error"))))
          (set mode (coco_m_atom e md))
          (if (== mode nil)
              (return (coco_f_mode_error e (coco_make2 m "type_error" (coco_new_atom m "atom") md))))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          (if (== 0 (strcmp mode "none"))    (return 1))
          (if (== 0 (strcmp mode "exist"))   (return (? (== 0 (access p F_OK)) 1 0)))
          (if (== 0 (strcmp mode "read"))    (return (? (== 0 (access p R_OK)) 1 0)))
          (if (or (== 0 (strcmp mode "write")) (== 0 (strcmp mode "append")))
              (block (if (== 0 (access p F_OK)) (return (? (== 0 (access p W_OK)) 1 0)))
                     (return (coco_f_creatable p))))
          (if (or (== 0 (strcmp mode "execute")) (== 0 (strcmp mode "search")))
              (return (? (== 0 (access p X_OK)) 1 0)))
          (return (coco_f_mode_error e (coco_make2 m "domain_error" (coco_new_atom m "io_mode") md)))))

  ;;; A CALL THE SYSTEM REFUSED RAISES (3.0.0; through 2.16 the predicate
  ;;; failed), as swipl's ERR_FILE_OPERATION makes its error of ERR:
  ;;; permission_error(ACTION, TYPE, F) for EACCES, ETXTBSY, EROFS and
  ;;; ENOTEMPTY (EAGAIN's action is `lock'), resource_error(max_files) for
  ;;; EMFILE and ENFILE, and existence_error(TYPE, F) for anything else --
  ;;; ENOENT, ENOTDIR, EEXIST, EISDIR. The context names NAME/ARITY in MOD,
  ;;; or bare for MOD "", and its message is strerror's text when MSG is 1,
  ;;; as swipl's MSG_ERRNO is, else unbound.
  (func coco_f_os_error ((coco_engine * e) (int err) (const char * action)
                         (const char * type) (size_t file) (const char * mod)
                         (const char * name) (u32 arity) (int msg)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t formal . 0) (size_t ctx . 0) (size_t args [3]))
          (cond
            ((or (or (== err EACCES) (== err ETXTBSY))
                 (or (or (== err EROFS) (== err ENOTEMPTY)) (== err EAGAIN)))
             (set (nth 0 args) (coco_new_atom m (? (== err EAGAIN) "lock" action)))
             (set (nth 1 args) (coco_new_atom m type))
             (set (nth 2 args) file)
             (set formal (coco_make m "permission_error" 3 args)))
            ((or (== err EMFILE) (== err ENFILE))
             (set formal (coco_make1 m "resource_error" (coco_new_atom m "max_files"))))
            (#t (set formal (coco_make2 m "existence_error" (coco_new_atom m type) file))))
          (set ctx (coco_ectx_pi m mod (coco_new_atom m name) arity
                                 (? msg (coco_new_atom m (strerror err)) (coco_new_var m))))
          (return (? (coco_m_thrown e (coco_make2 m "error" formal ctx)) 2 -1))))

  ;;; swipl names size_file/2 bare for the system's refusal
  (func coco_f_size_file ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]) (stat_t sb))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          (if (!= 0 (stat p (aof sb)))
              (let ((int er . errno))
                (return (coco_f_os_error e er "size" "file" (coco_m_arg e g 0)
                                         "" "size_file" 2 1))))
          (return (coco_m_unify_int e (coco_m_arg e g 1) (cast i64 ($ sb st_size))))))

  ;;; A FLOAT, because SWI's is a float and a program comparing two of them
  ;;; would otherwise get a different answer on each system.
  ;;;
  ;;; TO THE NANOSECOND (2.12.2). It was `st_mtime', whole seconds, so two
  ;;; writes inside one second had the same time and a tool asking which
  ;;; file is newer -- a build's "is the output stale", cicilang's -- got
  ;;; "neither". swipl 9.0.4 answers tv_sec + tv_nsec / 1e9 of `st_mtim',
  ;;; and this is that sum, to the last digit on this box's probes.
  ;;; Darwin names the field `st_mtimespec' and has no `st_mtim', which is
  ;;; the one member swipl's configure looks for: swipl there answers whole
  ;;; seconds, and this the nanoseconds still (Cicili 3.3.0 declares both).
  (func coco_file_mtime ((const char * path) (double * t)) (out int)
        (let ((stat_t sb))
          (if (!= 0 (stat path (aof sb))) (return 0))
          (@ifdef (code "__APPLE__"))
          (set (cof t) (+ (cast double ($ sb st_mtimespec tv_sec))
                          (/ (cast double ($ sb st_mtimespec tv_nsec)) 1000000000.0)))
          (@else)
          (set (cof t) (+ (cast double ($ sb st_mtim tv_sec))
                          (/ (cast double ($ sb st_mtim tv_nsec)) 1000000000.0)))
          (@endif)
          (return 1)))

  (func coco_f_time_file ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]) (double t . 0.0))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          ;; a file that is not there, as swipl's PL_FILE_EXIST asks it
          (if (not (coco_file_mtime p (aof t)))
              (return (coco_f_os_error e ENOENT "time" "file" (coco_m_arg e g 0)
                                       "system" "time_file" 2 0)))
          (return (coco_m_unify_float e (coco_m_arg e g 1) t))))

  ;;; `get_time/1' -- THE WALL CLOCK, WHICH WAS SIMPLY NOT THERE. Nothing
  ;;; in cocolog could ask what time it is: `time_file/2' answered when a
  ;;; file was last written and that was the whole of it, so a program that
  ;;; wanted to stamp a row, expire a session or set a certificate's
  ;;; validity window had nowhere to get the number from.
  ;;;
  ;;; A FLOAT OF SECONDS SINCE THE EPOCH, which is SWI's shape and the one
  ;;; `time_file/2' already answers in -- so the two compare without a
  ;;; conversion, and `X is Now - Modified' is a number of seconds.
  ;;;
  ;;; IT IS IN library(files) RATHER THAN library(builtins), which is a
  ;;; judgement and not an obvious one. The argument: `<time.h>' is already
  ;;; included here for `time_file/2', the answer has the same type and the
  ;;; same units, and a reader looking for "how do I get a timestamp" looks
  ;;; where timestamps already are. Both are tier 1, so nothing about the
  ;;; choice reaches a caller.
  ;;;
  ;;; MICROSECONDS, NOT WHOLE SECONDS. It was `time(NULL)' cast to a
  ;;; double, which answers 1788540000.0 and, a moment later, the same
  ;;; number: two reads inside one second are equal, and a program timing
  ;;; anything shorter than a second measures 0 or 1000 ms and nothing in
  ;;; between. test/thread.pl found it -- "one thread 2000ms, four threads
  ;;; 1000ms" -- when it stopped timing whole processes and timed the
  ;;; threads. gettimeofday is SWI's resolution and every libc has it.
  (func coco_f_get_time ((coco_engine * e) (size_t g)) (out int)
        (let ((timeval tv))
          (gettimeofday (aof tv) nil)
          (return (coco_m_unify_float e (coco_m_arg e g 0)
                                      (+ (cast double ($ tv tv_sec))
                                         (/ (cast double ($ tv tv_usec)) 1000000.0))))))

  ;;; THE ONLY WAY TO READ A FILE'S BYTES, and until this existed there was
  ;;; none: `consult' reads Prolog source in C and hands a program nothing,
  ;;; so a static file could not be served by clauses at all.
  ;;;
  ;;; CODES, NOT AN ATOM, for the reason library(http) parses codes: an atom
  ;;; in cocolog is a C string and stops at the first NUL, so an atom-shaped
  ;;; read would truncate every PNG at its header. A file is bytes.
  ;;;
  ;;; THE CEILING IS REAL AND IT FAILS RATHER THAN TRUNCATING. 16 MiB, the
  ;;; same as tcp_read's, because the two are read by the same kind of
  ;;; program for the same kind of reason. A quiet truncation would be a
  ;;; corrupted download that looks like a successful one; failing says the
  ;;; file is too big to serve this way, which is true. A caller that wants
  ;;; to know BEFORE reading has size_file/2, and library(httpd) uses it.
  ;;;
  ;;; A DIRECTORY IS NOT A FILE. Opening one succeeds on Linux and read(2)
  ;;; then answers EISDIR, so the stat is not belt-and-braces: without it
  ;;; `read_file_to_codes('/tmp', X)' would fail with errno set and look
  ;;; like a missing file.
  (func coco_f_read_file_to_codes ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]) (stat_t sb) (int fd)
              (size_t want . 0) (size_t got . 0) (ssize_t n . 0)
              (size_t lst) (char * buf . nil))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          (if (!= 0 (stat p (aof sb))) (return 0))
          (if (not (S_ISREG ($ sb st_mode))) (return 0))
          (if (> ($ sb st_size) 16777216) (return 0))
          (set want (cast size_t ($ sb st_size)))
          (set fd (open p O_RDONLY))
          (if (< fd 0) (return 0))
          ;; An EMPTY file is the empty list and not a failure -- a zero-byte
          ;; page is a page, and malloc(0) may answer null, which the check
          ;; below would read as being out of memory.
          (if (== want 0)
              (block (close fd)
                     (return (coco_m_unify e (coco_m_arg e g 1) (coco_m_nil e)))))
          (set buf (cast (char *) (malloc want)))
          (if (== buf nil) (block (close fd) (return 0)))
          ;; READ IN A LOOP, because one read(2) is not obliged to answer with
          ;; everything even from a regular file -- a signal is enough to cut
          ;; it short, and a short read here would be a truncated file served
          ;; with a confident 200.
          (while (< got want)
            (set n (read fd (+ buf got) (- want got)))
            (if (and (< n 0) (== errno EINTR)) continue)
            (if (<= n 0) break)
            (set got (+ got (cast size_t n))))
          (close fd)
          ;; SHORT IS A FAILURE, not a shorter answer. The file changed under
          ;; us, or the read broke; either way what is in the buffer is not
          ;; the file the stat described.
          (if (< got want) (block (free buf) (return 0)))
          ;; A CHARACTER A CODE under `text_units = characters' (1.13.0), its
          ;; code point, as atom_codes/2 answers there and SWI reads a text
          ;; file; a byte that is no UTF-8 is U+DC00 plus the byte, and
          ;; write_file_from_codes/2 writes it back as that byte, so a binary
          ;; file still goes round unchanged
          (if (-> (-> e m) text_chars)
              (block (set lst (coco_text_list (-> e m) buf got 0 (coco_m_nil e)))
                     (free buf)
                     (return (coco_m_unify e (coco_m_arg e g 1) lst))))
          ;; built back to front, as tcp_read builds its own
          ;; MASKED TO 0..255, and that is not decoration. `char' is SIGNED
          ;; on x86-64, so byte 0xFF read straight out of the buffer is -1,
          ;; and a PNG would come back as a list with negative codes in it --
          ;; which atom_codes would then refuse and length/2 would not. The
          ;; mask is also why this needs no `ubyte_t': a type is one token in
          ;; Cicili, files.cicili is imported BEFORE tcp.cicili, and one
          ;; `bitand' is cheaper than a second typedef of the same name.
          (set lst (coco_m_nil e))
          (for ((size_t i . got)) (> i 0) ((-- i))
               (set lst (coco_m_cons e
                                     (coco_new_int (-> e m)
                                                   (cast i64 (bitand
                                                     (cast int (nth (- i 1) buf))
                                                     255)))
                                     lst)))
          (free buf)
          (return (coco_m_unify e (coco_m_arg e g 1) lst))))

  ;;; ---- writing --------------------------------------------------------
  ;;;
  ;;; THE COUNTERPART TO read_file_to_codes/2, and the reason it exists: a
  ;;; cocolog script had NO WAY TO WRITE A FILE. There is no open/3 and no
  ;;; tell/1, so every caller that wanted one reached for a shell -- `echo
  ;;; >', `printf >', `: >', `cp' -- which is a process, a quoting problem
  ;;; and a lost error for what is one write(2). CivV's suite alone carried
  ;;; nine such escapes.
  ;;;
  ;;; Takes an ATOM or a list of codes, the same pair tcp_write/2 takes and
  ;;; for the same reason: a caller with a literal should not have to convert
  ;;; it, and a caller holding bytes should not have to lose them. Bytes are
  ;;; masked to 0..255 so a code list that came back from
  ;;; read_file_to_codes/2 round-trips -- copying a PNG is
  ;;; read_file_to_codes/2 then this, and nothing in between.
  (static)
  (func coco_f_write_bytes ((coco_engine * e) (size_t g) (int flags)) (out int)
        (let ((int rc . 0) (char p [4096]) (int fd) (size_t t) (size_t n . 0)
              (char * buf . nil) (size_t off . 0) (ssize_t w . 0)
              (size_t * items . nil) (int as_list . 0))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          (set t (coco_m_arg e g 1))
          (if (coco_m_is_var e t) (return (coco_m_instantiation_error e)))
          ;; THE LIST IS ASKED ABOUT FIRST, and that order is a bug this
          ;; nearly shipped. `[]' IS AN ATOM here as well as a list -- atom([])
          ;; and is_list([]) are both true -- so an atom-first branch asked
          ;; coco_m_text for its name and wrote the two characters `[' and `]'
          ;; into the file. A caller asking for the `: > f' of the shell got a
          ;; two-byte file, and nothing downstream could tell: "[]" reads back
          ;; as a perfectly good list of two codes.
          ;;
          ;; Asking coco_m_list_length/3 first settles it without needing to
          ;; know how nil is represented: a list answers its length (0 for the
          ;; empty one), and an atom is not a list, so `hello' falls through to
          ;; the branch that writes its name.
          (if (coco_m_list_length e t (aof n))
              (block
                (set as_list 1)
                ;; A CODE POINT A CODE under `text_units = characters'
                ;; (1.13.0), written as its UTF-8 -- U+DC80..U+DCFF, what
                ;; read_file_to_codes/2 made of a byte that was no UTF-8, as
                ;; that byte
                (if (and (> n 0) (-> (-> e m) text_chars))
                    (let ((size_t at . 0))
                      (set buf (cast (char *) (malloc (+ (* n 4) 1))))
                      (if (== buf nil) (return 0))
                      (if (not (coco_m_list_array e t (aof items) (aof n)))
                          (block (free buf) (return 0)))
                      (for ((size_t i . 0)) (< i n) ((++ i))
                           (let ((i64 v . 0) (int k . 0))
                             (if (not (coco_m_int e (nth i items) (aof v)))
                                 (block (let ((size_t bad . #'(nth i items)))
                                          (free buf) (free items)
                                          (return (coco_m_type_error e "integer" bad)))))
                             (set k (coco_utf8_enc (+ buf at) v))
                             (if (== k 0)
                                 (block (let ((size_t bad . #'(nth i items)))
                                          (free buf) (free items)
                                          (return (coco_m_type_error e "character_code" bad)))))
                             (set at (+ at (cast size_t k)))))
                      (free items)
                      (set n at)
                      (set items nil)))
                (if (and (> n 0) (== buf nil))
                    (block
                      (set buf (cast (char *) (malloc (+ n 1))))
                      (if (== buf nil) (return 0))
                      (if (not (coco_m_list_array e t (aof items) (aof n)))
                          (block (free buf) (return 0)))
                      (for ((size_t i . 0)) (< i n) ((++ i))
                           (let ((i64 v . 0))
                             (if (not (coco_m_int e (nth i items) (aof v)))
                                 ;; THE OFFENDING TERM IS TAKEN BEFORE THE FREE.
                                 ;; Written the other way round -- free items,
                                 ;; then read (nth i items) to name it in the
                                 ;; error -- this is a use-after-free, and it
                                 ;; SEGFAULTS rather than raising:
                                 ;; `write_file_from_codes(F, [foo])' killed the
                                 ;; process. tcp_write/2 in modules/tcp was
                                 ;; written that way round -- this function was
                                 ;; copied from it -- and has since been fixed
                                 ;; the same way.
                                 ;;
                                 ;; `. #'(nth i items)' AND NOT `. (nth i items)':
                                 ;; a dotted pair whose cdr is a list IS that
                                 ;; list -- `(a . (b c))' reads as `(a b c)' --
                                 ;; so the plain form loses the dot and Cicili
                                 ;; answers "is not of type SEQUENCE" with no
                                 ;; file and no line.
                                 (block (let ((size_t bad . #'(nth i items)))
                                          (free buf) (free items)
                                          (return (coco_m_type_error e "integer" bad)))))
                             (set (nth i buf) (cast char (bitand v 255)))))
                      (free items)))))
          ;; NOT `(> n 0)': a list_length that FAILED leaves n at 0, so a
          ;; length test here would skip the atom branch for every atom.
          (if (not as_list)
              (block
                (let ((char txt [65536]))
                  (if (not (coco_m_text e t txt (sizeof txt)))
                      (return (coco_m_type_error e "atom" t)))
                  (set n (strlen txt))
                  (set buf (cast (char *) (malloc (+ n 1))))
                  (if (== buf nil) (return 0))
                  (memcpy buf txt n))))
          ;; 420 IS OCTAL 0644. The Lisp reader takes `0644' as DECIMAL 644,
          ;; which is octal 1204 -- a file its owner could not read back --
          ;; the same trap make_directory/1 fell into above, written out
          ;; here so the next author does not have to rediscover it.
          (set fd (open p flags 420))
          (if (< fd 0) (block (free buf) (return 0)))
          ;; WRITE IN A LOOP: write(2) is not obliged to take everything, and
          ;; a short write reported as success is a truncated file that looks
          ;; like a good one.
          (while (< off n)
            (set w (write fd (+ buf off) (- n off)))
            (if (and (< w 0) (== errno EINTR)) continue)
            (if (< w 0) (block (close fd) (free buf) (return 0)))
            (set off (+ off (cast size_t w))))
          (close fd)
          (free buf)
          (return 1)))

  ;;; The file is the codes, whatever it held before. An empty list TRUNCATES
  ;;; rather than failing -- `: > f' has a caller, and a zero-byte file is a
  ;;; file.
  (func coco_f_write_file_from_codes ((coco_engine * e) (size_t g)) (out int)
        (return (coco_f_write_bytes e g (bitor O_WRONLY (bitor O_CREAT O_TRUNC)))))

  ;;; ...and the `>>' of the pair.
  (func coco_f_append_file_from_codes ((coco_engine * e) (size_t g)) (out int)
        (return (coco_f_write_bytes e g (bitor O_WRONLY (bitor O_CREAT O_APPEND)))))

  ;;; ---- changing things ------------------------------------------------

  ;;; remove(3), as swipl's: an empty directory goes too, and a full one is
  ;;; permission_error(delete, file, F)
  (func coco_f_delete_file ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          (if (== 0 (remove p)) (return 1))
          (let ((int er . errno))
            (return (coco_f_os_error e er "delete" "file" (coco_m_arg e g 0)
                                     "system" "delete_file" 1 1)))))

  ;;; a file onto itself is swipl's permission_error(rename, file, Old),
  ;;; `same file', before anything moves; rename_file/2 is named bare
  (func coco_f_rename_file ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char a [4096]) (char b [4096]) (stat_t sa) (stat_t sb))
          (if (not (coco_f_path e g 0 a (sizeof a) (aof rc))) (return rc))
          (if (not (coco_f_path e g 1 b (sizeof b) (aof rc))) (return rc))
          (if (or (== 0 (strcmp a b))
                  (and (and (== 0 (stat a (aof sa))) (== 0 (stat b (aof sb))))
                       (and (== ($ sa st_dev) ($ sb st_dev)) (== ($ sa st_ino) ($ sb st_ino)))))
              (let ((coco_machine * m . #'(coco_m_machine e)) (size_t args [3]))
                (set (nth 0 args) (coco_new_atom m "rename"))
                (set (nth 1 args) (coco_new_atom m "file"))
                (set (nth 2 args) (coco_m_arg e g 0))
                (return (? (coco_m_thrown e (coco_make2 m "error" (coco_make m "permission_error" 3 args)
                                                       (coco_ectx_pi m "" (coco_new_atom m "rename_file") 2
                                                                     (coco_new_atom m "same file"))))
                           2 -1))))
          (if (== 0 (rename a b)) (return 1))
          (let ((int er . errno))
            (return (coco_f_os_error e er "rename" "file" (coco_m_arg e g 0)
                                     "" "rename_file" 2 1)))))

  (func coco_f_make_directory ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          ;; 511 IS OCTAL 0777. The Lisp reader takes `0777' as DECIMAL 777,
          ;; which is octal 1411 -- a directory nobody could write into or
          ;; search -- found when make_directory('sub/deep') failed on macOS
          ;; and took the fs conformance case and the tensors store with it.
          (if (== 0 (mkdir p 511)) (return 1))
          (let ((int er . errno))
            (return (coco_f_os_error e er "create" "directory" (coco_m_arg e g 0)
                                     "system" "make_directory" 1 1)))))

  (func coco_f_delete_directory ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          (if (== 0 (rmdir p)) (return 1))
          (let ((int er . errno))
            (return (coco_f_os_error e er "delete" "directory" (coco_m_arg e g 0)
                                     "system" "delete_directory" 1 1)))))

  ;;; ---- listing --------------------------------------------------------

  ;;; EVERY entry, `.' and `..' included, because that is what SWI answers and
  ;;; a program that filters them is portable while one that does not is
  ;;; surprised on exactly one system. The order is the order the directory
  ;;; gives them, which is also SWI's -- a program that needs an order sorts.
  (func coco_f_directory_files ((coco_engine * e) (size_t g)) (out int)
        (let ((char p [4096]) (DIR * d) (char ** names . nil)
              (size_t n . 0) (size_t cap . 0) (int rc . 0))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          ;; a name that is not there is existence_error(file, D), as swipl's
          ;; PL_FILE_EXIST asks it; one that is no directory, the open's
          (if (!= 0 (access p F_OK))
              (return (coco_f_os_error e ENOENT "open" "file" (coco_m_arg e g 0)
                                       "system" "directory_files" 2 0)))
          (set d (opendir p))
          (if (== d nil)
              (let ((int er . errno))
                (return (coco_f_os_error e er "open" "directory" (coco_m_arg e g 0)
                                         "system" "directory_files" 2 1))))
          (while 1
            (let ((dirent * ent . #'(readdir d)))
              (if (== ent nil) break)
              (if (>= n cap)
                  (let ((size_t ncap . #'(? (== cap 0) 16 (* cap 2)))
                        (char ** nb))
                    (set nb (cast (char **) (realloc names (* ncap (sizeof (char *))))))
                    (if (== nb nil) break)
                    (set names nb)
                    (set cap ncap)))
              (set (nth n names) (strdup (-> ent d_name)))
              (if (== (nth n names) nil) break)
              (set n (+ n 1))))
          (closedir d)
          (set rc (coco_m_unify e (coco_m_arg e g 1) (coco_m_atom_list e names n)))
          (for ((size_t i . 0)) (< i n) ((++ i)) (free (nth i names)))
          (free names)
          (return rc)))

  ;;; glob(3), which sorts by default -- and SWI's answer is sorted too, so the
  ;;; default is what matches. No match is the EMPTY LIST and not a failure,
  ;;; which is the one thing about this predicate everybody gets wrong.
  ;;; GLOB GOES THROUGH THE RAW-C ESCAPE, which is the one place in cocolog
  ;;; that does. `lib/std/c/posix' declares no `glob', and declaring it here
  ;;; would emit a second prototype that conflicts with the header's -- the
  ;;; same for `glob_t', whose typedef cannot be repeated. `(code ...)' is
  ;;; Cicili's documented way of saying "this is C, pass it through", and four
  ;;; lines of it is cheaper than a hand-written matcher that would have to get
  ;;; brace expansion and multi-component patterns right to match SWI.
  ;;;
  ;;; A NAME WITH NO WILDCARD IS ITSELF (3.0.0), its `~' expanded, whether
  ;;; or not the file is there -- swipl's expand_file_name(nofile, L) is
  ;;; [nofile], where this answered [] -- and `{a,b}' is a wildcard, as
  ;;; swipl's is (GLOB_BRACE). The name is CVT_ALL text: a number is its
  ;;; digits.
  ;;; A character of a variable's name in `$NAME': a letter, a digit or `_'
  (static)
  (func coco_f_name_char ((char c)) (out int)
        (let ((int k . #'(bitand (cast int c) 255)))
          (return (or (and (>= k 48) (<= k 57))
                      (or (and (>= k 65) (<= k 90))
                          (or (and (>= k 97) (<= k 122)) (== k 95)))))))

  (static)
  (func coco_f_has_wild ((const char * p)) (out int)
        (for ((size_t i . 0)) (!= (nth i p) (cast char 0)) ((++ i))
          ;; `*' 42, `?' 63, `[' 91, `{' 123
          (let ((int c . #'(cast int (nth i p))))
            (if (or (== c 42) (or (== c 63) (or (== c 91) (== c 123)))) (return 1))))
        (return 0))

  ;;; THE NAME'S `~' AND `$VAR' ARE EXPANDED FIRST (3.1.0, swipl's
  ;;; expandVars()): `~' or `~user' before the first `/' is that home, and
  ;;; `$NAME' -- letters, digits and `_' -- the variable's value, a `$'
  ;;; before anything else itself; an unknown user is existence_error(user,
  ;;; U) and an unset variable existence_error(variable, NAME), as swipl
  ;;; raises them. Through 3.0.0 a `$' was text and `~nouser' itself.
  ;;; Answers 1 with OUT written, else the raise's answer.
  (static)
  (func coco_f_expand_vars ((coco_engine * e) (const char * p) (char * out) (size_t cap))
        (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (size_t i . 0) (size_t o . 0))
          (set (nth 0 out) (cast char 0))
          (if (== (nth 0 p) (cast char 126))
              (let ((char head [4096]) (size_t h . 0))
                (while (and (!= (nth h p) (cast char 0)) (!= (nth h p) (cast char 47)))
                  (if (< h 4095) (set (nth h head) (nth h p)))
                  (set h (+ h 1)))
                (set (nth (? (< h 4095) h 4095) head) (cast char 0))
                ;; `~' alone is $HOME, else the password file's; `~user' that
                ;; user's home whether or not it is there, as swipl's
                ;; getpwnam(): `<pwd.h>' is no Cicili std header, so through
                ;; the raw-C escape, as glob is
                (let ((const char * home . nil))
                  (if (== (nth 1 head) (cast char 0))
                      (block (set home (getenv "HOME"))
                             (if (== home nil)
                                 (set home (code "(getpwuid(getuid()) ? getpwuid(getuid())->pw_dir : NULL)"))))
                    (set home (code "(getpwnam(head + 1) ? getpwnam(head + 1)->pw_dir : NULL)")))
                  (if (== home nil)
                      (return (coco_m_existence_error e "user" (coco_new_atom m (+ head 1)))))
                  (snprintf out cap "%s" home)
                  (set o (strlen out)))
                (set i h)))
          (while (!= (nth i p) (cast char 0))
            (let ((char c . #'(nth i p)))
              (if (and (== c (cast char 36)) (coco_f_name_char (nth (+ i 1) p)))
                  (let ((char name [256]) (size_t k . 0) (const char * val . nil))
                    (set i (+ i 1))
                    (while (coco_f_name_char (nth i p))
                      (if (< k 255) (block (set (nth k name) (nth i p)) (set k (+ k 1))))
                      (set i (+ i 1)))
                    (set (nth k name) (cast char 0))
                    (set val (getenv name))
                    (if (== val nil)
                        (return (coco_m_existence_error e "variable" (coco_new_atom m name))))
                    (while (!= (nth 0 val) (cast char 0))
                      (if (>= (+ o 1) cap) (return (coco_m_error e "the path will not fit" p)))
                      (set (nth o out) (nth 0 val))
                      (set o (+ o 1))
                      (set val (+ val 1))))
                (block
                 (if (>= (+ o 1) cap) (return (coco_m_error e "the path will not fit" p)))
                 (set (nth o out) c)
                 (set o (+ o 1))
                 (set i (+ i 1))))))
          (set (nth o out) (cast char 0))
          (return 1)))

  (func coco_f_expand_file_name ((coco_engine * e) (size_t g)) (out int)
        (let ((char p [4096]) (char raw [4096]) (int rc . 0) (int gr . 0)
              (size_t n . 0) (char ** v . nil))
          (if (not (coco_f_path_as e g 0 raw (sizeof raw) (aof rc) 1)) (return rc))
          (set rc (coco_f_expand_vars e raw p (sizeof p)))
          (if (!= rc 1) (return rc))
          (if (not (coco_f_has_wild p))
              (let ((char * one . p))
                (return (coco_m_unify e (coco_m_arg e g 1) (coco_m_atom_list e (aof one) 1)))))
          (code "glob_t gl; memset(&gl, 0, sizeof gl);")
          (set gr (code "glob(p, GLOB_BRACE, NULL, &gl)"))
          (if (== gr 0)
              (block (set n (code "gl.gl_pathc"))
                     (set v (code "gl.gl_pathv"))))
          ;; No match is the EMPTY LIST and not a failure, which is the one
          ;; thing about this predicate everybody gets wrong. Any other error
          ;; is an error.
          (if (and (!= gr 0) (!= gr (code "GLOB_NOMATCH")))
              (block (code "globfree(&gl);")
                     (return (coco_m_error e "expand_file_name failed on" p))))
          (set rc (coco_m_unify e (coco_m_arg e g 1) (coco_m_atom_list e v n)))
          (code "globfree(&gl);")
          (return rc)))

  ;;; ---- names ----------------------------------------------------------

  ;;; `/' is 47 and `.' is 46. Cicili has no character literal -- see
  ;;; CLAUDE.md -- so the codes are written out with the character named.

  (static)
  (func coco_f_is_abs ((const char * p)) (out int)
        (return (? (== (nth 0 p) (cast char 47)) 1 0)))

  (func coco_f_is_absolute ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          (return (coco_f_is_abs p))))

  ;;; NORMALISED, NOT RESOLVED. `.' and `..' are folded away and a relative
  ;;; name is taken against the working directory, but symbolic links are left
  ;;; alone and the file need not exist -- all three of which are SWI's
  ;;; behaviour and none of which is `realpath(3)'.
  (static)
  (func coco_f_normalise ((const char * in) (char * out) (size_t cap)) (out int)
        (let ((char work [8192]) (size_t len . 0))
          (if (coco_f_is_abs in)
              (block (if (>= (strlen in) (sizeof work)) (return 0))
                     (snprintf work (sizeof work) "%s" in))
            (let ((char cwd [4096]))
              (if (== nil (getcwd cwd (sizeof cwd))) (return 0))
              (if (>= (+ (strlen cwd) (strlen in) 2) (sizeof work)) (return 0))
              (snprintf work (sizeof work) "%s/%s" cwd in)))

          ;; walk the components, keeping a stack of where each begins in OUT
          (let ((size_t starts [512]) (size_t depth . 0) (char * p . work))
            (set (nth 0 out) (cast char 47))   ; a leading `/'
            (set len 1)
            (while (!= (cast char 0) (nth 0 p))
              (if (== (nth 0 p) (cast char 47)) (block (set p (+ p 1)) continue))
              (let ((char * q . #'(strchr p 47))
                    (size_t seg . 0))
                (set seg (? (== q nil) (strlen p) (cast size_t (- q p))))
                (cond
                  ;; `.' -- nothing at all
                  ((and (== seg 1) (== (nth 0 p) (cast char 46))) (block))
                  ;; `..' -- back one component, unless already at the root
                  ((and (== seg 2) (and (== (nth 0 p) (cast char 46))
                                        (== (nth 1 p) (cast char 46))))
                   (if (> depth 0)
                       (block (set depth (- depth 1))
                              (set len (nth depth starts)))))
                  (#t
                   (block
                    (if (>= depth 512) (return 0))
                    (if (>= (+ len seg 2) cap) (return 0))
                    (set (nth depth starts) len)
                    (set depth (+ depth 1))
                    ;; a separator before every component but the first
                    (if (> len 1) (block (set (nth len out) (cast char 47))
                                         (set len (+ len 1))))
                    (memcpy (+ out len) p seg)
                    (set len (+ len seg)))))
                (if (== q nil) break)
                (set p (+ q 1))))
            ;; A NAME THAT ENDS IN `/' KEEPS IT (3.1.0, swipl's): `a/' is
            ;; `/cwd/a/', `a/../' the working directory and its slash, and
            ;; `a/b/.' `/cwd/a/b' -- a name that ends in a component ends
            ;; there. The root is `/' either way. Through 3.0.0 every
            ;; trailing slash was folded away.
            (let ((size_t wl . #'(strlen work)))
              (if (and (> len 1) (and (> wl 0) (== (nth (- wl 1) work) (cast char 47))))
                  (block (if (>= (+ len 2) cap) (return 0))
                         (set (nth len out) (cast char 47))
                         (set len (+ len 1)))))
            (set (nth len out) (cast char 0))
            (return 1))))

  ;;; An alias's path written out on B: atomic, or `A/B' of such; 1, 0 for
  ;;; a path that is none, -1 for one unbound
  (static)
  (func coco_f_alias_path ((coco_engine * e) (size_t t) (coco_strbuf * b) (int depth)) (out int)
        (let ((coco_machine * m . #'(coco_m_machine e)) (coco_strbuf w) (int r . 0))
          (set t (coco_deref m t))
          (if (coco_m_is_var e t) (return -1))
          (if (> depth 256) (return 0))
          (if (coco_is_compound2 m t "/")
              (block (set r (coco_f_alias_path e (coco_arg m t 0) b (+ depth 1)))
                     (if (!= r 1) (return r))
                     (coco_sb_putc b (cast char 47))
                     (return (coco_f_alias_path e (coco_arg m t 1) b (+ depth 1)))))
          (if (coco-tag-is FUN (nth t (-> m heap))) (return 0))
          (if (!= 1 (coco_tx_get e t 7 (aof w))) (return 0))
          (coco_sb_put b (coco_tx_s (aof w)))
          (coco_sb_free (aof w))
          (return 1)))

  ;;; An unbound spec is swipl's instantiation_error with no context (its
  ;;; must_be/2 raises it in Prolog, before '$absolute_file_name'/2, which
  ;;; names the text's errors: the row, 3.0.0).
  ;;; AN ALIAS(PATH) SPEC is swipl's file search path (3.0.0; through 2.16
  ;;; every compound was type_error(text, Spec)): `library' is the first
  ;;; directory of cocolog's library path, $COCOLOG_LIBRARY's first, else
  ;;; ./library, with PATH after it, which no file need hold (swipl's /2
  ;;; asks no access); any other alias, which no file_search_path/2 names
  ;;; here, fails, as an alias swipl does not know does, and so do a PATH
  ;;; that is no atomic or `A/B' and any other compound but a list of codes
  ;;; or characters (swipl's fail too: a list is no alias to it, and is
  ;;; text here, where "..." reads as codes). PATH unbound is the
  ;;; instantiation_error, with no context.
  (func coco_f_absolute_file_name ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]) (char abs [4096])
              (coco_machine * m . #'(coco_m_machine e))
              (size_t sp . #'(coco_deref m (coco_m_arg e g 0))))
          (if (coco_m_is_var e sp)
              (return (? (coco_m_thrown e (coco_make2 m "error" (coco_new_atom m "instantiation_error")
                                                      (coco_new_var m)))
                         2 -1)))
          (if (and (coco-tag-is FUN (nth sp (-> m heap))) (not (coco_is_cons m sp)))
              (let ((coco_strbuf b) (int r . 0) (const char * lib . #'(getenv "COCOLOG_LIBRARY")))
                (if (or (!= (coco_arity m sp) 1)
                        (!= 0 (strcmp (coco_atom_name m (coco_name_of m sp)) "library")))
                    (return 0))
                (coco_sb_init (aof b))
                (if (and (!= lib nil) (and (!= (nth 0 lib) (cast char 0))
                                           (!= (nth 0 lib) (cast char 58))))
                    (let ((size_t i . 0))
                      (while (and (!= (nth i lib) (cast char 0)) (!= (nth i lib) (cast char 58)))
                        (coco_sb_putc (aof b) (nth i lib))
                        (set i (+ i 1))))
                  (coco_sb_put (aof b) "library"))
                (coco_sb_putc (aof b) (cast char 47))
                (set r (coco_f_alias_path e (coco_arg m sp 0) (aof b) 0))
                (if (== r -1)
                    (block (coco_sb_free (aof b))
                           (return (? (coco_m_thrown e (coco_make2 m "error"
                                                                   (coco_new_atom m "instantiation_error")
                                                                   (coco_new_var m)))
                                      2 -1))))
                (if (or (== r 0) (>= ($ b len) (sizeof p)))
                    (block (coco_sb_free (aof b)) (return 0)))
                (snprintf p (sizeof p) "%s" (coco_tx_s (aof b)))
                (coco_sb_free (aof b))
                (if (not (coco_f_normalise p abs (sizeof abs)))
                    (return (coco_m_error e "the path will not fit" p)))
                (return (coco_m_unify_atom e (coco_m_arg e g 1) abs))))
          ;; a list that is no text fails, as every list does in swipl's
          (if (coco_is_cons m sp)
              (let ((coco_strbuf w))
                (if (!= 1 (coco_tx_get e sp 15 (aof w))) (return 0))
                (coco_sb_free (aof w))))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          (if (not (coco_f_normalise p abs (sizeof abs)))
              (return (coco_m_error e "the path will not fit" p)))
          (return (coco_m_unify_atom e (coco_m_arg e g 1) abs))))

  ;;; The directory and the base name of a path, in one walk, because the two
  ;;; library predicates want opposite halves of it and two walks could
  ;;; disagree. P is cut up; DIR and BASE hold 4096 bytes each.
  ;;;
  ;;;   '/a/b/c' -> '/a/b' and c        '/a/b/' -> '/a'  and b
  ;;;   'abc'    -> '.'    and abc      '/'     -> '/'   and '/'
  (static)
  (func coco_f_split ((char * p) (char * dir) (char * base))
        (let ((size_t len))
          (set len (strlen p))

          ;; a bare root is its own directory and its own base name
          (if (and (== len 1) (== (nth 0 p) (cast char 47)))
              (block (snprintf dir 4096 "/")
                     (snprintf base 4096 "/"))
            (block
             ;; trailing slashes first: '/a/b/' is about b, not about ''
             (while (and (> len 1) (== (nth (- len 1) p) (cast char 47)))
               (set len (- len 1)))
             (set (nth len p) (cast char 0))
             (let ((char * slash . #'(strrchr p 47)))
               (cond
                 ((== slash nil)
                  (block (snprintf dir 4096 ".")
                         (snprintf base 4096 "%s" p)))
                 ((== slash p)
                  ;; '/abc': the directory is the root itself
                  (block (snprintf dir 4096 "/")
                         (snprintf base 4096 "%s" (+ slash 1))))
                 (#t
                  (block (set (nth 0 slash) (cast char 0))
                         (snprintf dir 4096 "%s" p)
                         (snprintf base 4096 "%s" (+ slash 1))))))))))

  ;;; '$path_base'(Path, Base) and '$path_dir'(Path, Dir), the C halves of
  ;;; file_base_name/2 and file_directory_name/2 (3.0.0; one '$path_split'/3
  ;;; through 2.16, whose errors named no predicate), Path CVT_ALL text.
  (func coco_f_path_base ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]) (char dir [4096]) (char base [4096]))
          (if (not (coco_f_path_as e g 0 p (sizeof p) (aof rc) 1)) (return rc))
          (coco_f_split p dir base)
          (return (coco_m_unify_atom e (coco_m_arg e g 1) base))))

  (func coco_f_path_dir ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]) (char dir [4096]) (char base [4096]))
          (if (not (coco_f_path_as e g 0 p (sizeof p) (aof rc) 1)) (return rc))
          (coco_f_split p dir base)
          (return (coco_m_unify_atom e (coco_m_arg e g 1) dir))))

  ;;; A dot in a DIRECTORY component is not an extension: '/a/b.d/c' has none.
  ;;;
  ;;; A LEADING DOT IS ONE, THOUGH. SWI splits '.bashrc' into the empty base
  ;;; name and the extension `bashrc', which is not what a person would say and
  ;;; is what the shared test measured -- the first version of this function
  ;;; had the intuitive rule, and test/files/names.pl caught it against a real
  ;;; SWI in the first run. The rule is simply: the last dot that is after the
  ;;; last slash, wherever it sits.
  ;;;
  ;;; THE NAME IS CVT_ALL TEXT, AND ONE WITH NO EXTENSION IS ITS OWN BASE
  ;;; NAME AS IT CAME (3.0.0, swipl's): file_name_extension(B, E, "abc") is
  ;;; B = "abc", and of 1 B = 1, where both were atoms.
  (func coco_f_ext_split ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]) (char * dot) (char * slash))
          (if (not (coco_f_path_as e g 0 p (sizeof p) (aof rc) 1)) (return rc))
          (set dot (strrchr p 46))
          (set slash (strrchr p 47))
          (if (or (== dot nil)
                  (and (!= slash nil) (< dot slash)))
              ;; no extension: the base name is the whole thing and Ext is ''
              (let ((size_t mark . #'(coco_m_mark e)))
                (if (not (coco_m_unify e (coco_m_arg e g 1) (coco_m_arg e g 0)))
                    (block (coco_m_undo e mark) (return 0)))
                (if (not (coco_m_unify_atom e (coco_m_arg e g 2) ""))
                    (block (coco_m_undo e mark) (return 0)))
                (return 1)))
          (let ((size_t mark . #'(coco_m_mark e)) (char ext [4096]) (char want [4096]))
            (snprintf ext (sizeof ext) "%s" (+ dot 1))
            (set (nth 0 dot) (cast char 0))
            ;; A BOUND EXT IS COMPARED WITHOUT ITS DOT (3.1.0, swipl's):
            ;; file_name_extension(B, '.pl', 'a.pl') is B = a, where the
            ;; unification of `pl' with `.pl' failed
            (if (not (coco_m_is_var e (coco_m_arg e g 2)))
                (block
                 (if (not (coco_f_path_as e g 2 want (sizeof want) (aof rc) 1)) (return rc))
                 (if (!= 0 (strcmp ext (+ want (? (== (nth 0 want) (cast char 46)) 1 0))))
                     (return 0))
                 (return (coco_m_unify_atom e (coco_m_arg e g 1) p))))
            (if (not (coco_m_unify_atom e (coco_m_arg e g 1) p))
                (block (coco_m_undo e mark) (return 0)))
            (if (not (coco_m_unify_atom e (coco_m_arg e g 2) ext))
                (block (coco_m_undo e mark) (return 0)))
            (return 1))))

  ;;; Joining. An Ext written with its dot already on is taken as it is, which
  ;;; is what SWI does: file_name_extension(x, '.md', F) gives 'x.md' and not
  ;;; 'x..md'. An empty Ext adds no dot, and nor does `.'. A BASE THAT HAS THE
  ;;; EXTENSION ALREADY IS THE NAME (3.1.0, swipl's): file_name_extension(
  ;;; 'a.pl', pl, F) is F = 'a.pl', where this answered 'a.pl.pl' -- the
  ;;; extension the last dot after the last `/' begins, a dot that does not
  ;;; begin the base's last component (`.pl' and `x/.pl' have none, so
  ;;; their `pl' is added), and compared as it is written.
  (func coco_f_ext_join ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char base [4096]) (char ext [4096]) (char out [4096])
              (const char * x . nil) (size_t i . 0))
          (if (not (coco_f_path_as e g 0 base (sizeof base) (aof rc) 1)) (return rc))
          (if (not (coco_f_path_as e g 1 ext (sizeof ext) (aof rc) 1)) (return rc))
          (set x (+ ext (? (== (nth 0 ext) (cast char 46)) 1 0)))
          (if (== (cast char 0) (nth 0 x))
              (return (coco_m_unify_atom e (coco_m_arg e g 2) base)))
          (set i (strlen base))
          (while (and (> i 0) (and (!= (nth (- i 1) base) (cast char 46))
                                   (!= (nth (- i 1) base) (cast char 47))))
            (set i (- i 1)))
          ;; I is one past the dot or the slash it stopped at, or 0
          (if (and (> i 1) (and (== (nth (- i 1) base) (cast char 46))
                                (and (!= (nth (- i 2) base) (cast char 47))
                                     (== 0 (strcmp (+ base i) x)))))
              (return (coco_m_unify_atom e (coco_m_arg e g 2) base)))
          (snprintf out (sizeof out) "%s.%s" base x)
          (return (coco_m_unify_atom e (coco_m_arg e g 2) out))))

  ;;; ---- identity, links, temporaries, the working directory -------------

  ;;; The same file and not merely the same name: device and inode, through
  ;;; `stat' and so through any symbolic link.
  (func coco_f_same_file ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char a [4096]) (char b [4096]) (stat_t sa) (stat_t sb))
          (if (not (coco_f_path e g 0 a (sizeof a) (aof rc))) (return rc))
          (if (not (coco_f_path e g 1 b (sizeof b) (aof rc))) (return rc))
          (if (!= 0 (stat a (aof sa))) (return 0))
          (if (!= 0 (stat b (aof sb))) (return 0))
          (return (? (and (== ($ sa st_dev) ($ sb st_dev))
                          (== ($ sa st_ino) ($ sb st_ino))) 1 0))))

  ;;; SWI answers both the raw link text and the fully resolved target.
  (func coco_f_read_link ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char p [4096]) (char raw [4096]) (char full [4096]) (ssize_t n))
          (if (not (coco_f_path e g 0 p (sizeof p) (aof rc))) (return rc))
          (set n (readlink p raw (- (sizeof raw) 1)))
          (if (< n 0) (return 0))
          (set (nth n raw) (cast char 0))
          ;; `realpath' is in <stdlib.h>, but not in the std POSIX
          ;; declarations; it is declared beside this module.
          (if (== nil (realpath p full)) (return 0))
          (let ((size_t mark . #'(coco_m_mark e)))
            (if (not (coco_m_unify_atom e (coco_m_arg e g 1) raw))
                (block (coco_m_undo e mark) (return 0)))
            (if (not (coco_m_unify_atom e (coco_m_arg e g 2) full))
                (block (coco_m_undo e mark) (return 0))))
          (return 1)))

  ;;; Enough to tell two temporary names apart within one process. Not a
  ;;; guarantee of uniqueness against another process -- the pid in the name is
  ;;; that -- and not a security claim: SWI's tmp_file/2 makes neither either.
  (static)
  (func coco_f_tmp_seq () (out long)
        (static) (var long seq)
        (set seq (+ seq 1))
        (return seq))

  ;;; A name nothing is using yet, in the system's temporary directory. It is
  ;;; a NAME and not a file: SWI's tmp_file/2 does not create one either, and
  ;;; the caller is the one that knows what to put there.
  (func coco_f_tmp_file ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char base [4096]) (char out [4096]) (const char * dir))
          (if (not (coco_f_path_as e g 0 base (sizeof base) (aof rc) 1)) (return rc))
          (set dir (getenv "TMPDIR"))
          (if (== dir nil) (set dir "/tmp"))
          (snprintf out (sizeof out) "%s/coco_%s_%d_%ld" dir base
                    (cast int (getpid)) (cast long (coco_f_tmp_seq)))
          (return (coco_m_unify_atom e (coco_m_arg e g 1) out)))) 

  ;;; SWI answers the working directory WITH A TRAILING SLASH, then changes to
  ;;; New. `working_directory(W, W)' therefore reads it and puts it back, which
  ;;; is the idiom for asking where you are.
  (func coco_f_working_directory ((coco_engine * e) (size_t g)) (out int)
        (let ((int rc . 0) (char cwd [4096]) (char with [4096]) (char dest [4096]))
          (if (== nil (getcwd cwd (sizeof cwd)))
              (return (coco_m_error e "cannot read the working directory" nil)))
          (let ((size_t len . #'(strlen cwd)))
            (if (and (> len 0) (== (nth (- len 1) cwd) (cast char 47)))
                (snprintf with (sizeof with) "%s" cwd)
              (snprintf with (sizeof with) "%s/" cwd)))
          (if (not (coco_m_unify_atom e (coco_m_arg e g 0) with)) (return 0))
          ;; New may have become bound by that unification -- that is exactly
          ;; what `working_directory(W, W)' does -- so it is read afterwards.
          ;; The local is `dest' and not `new' because `new' is one of Cicili's
          ;; own macros and a variable of that name is read as a call to it.
          (if (not (coco_f_path e g 1 dest (sizeof dest) (aof rc))) (return rc))
          ;; refused, swipl's '$chdir'/1 raises, with no message
          (if (!= 0 (chdir dest))
              (let ((int er . errno))
                (return (coco_f_os_error e er "chdir" "directory" (coco_m_arg e g 1)
                                         "system" "$chdir" 1 0))))
          (return 1)))

  ;;; ---- the module -----------------------------------------------------

  ;;; The dispatcher, from the table at the top of this file, and the
  ;;; registration function a target calls. Two macro calls and no hand-written
  ;;; glue: everything that could fall out of step with the table is generated
  ;;; from it.
  (static) (coco-emit-module-dispatch coco_f_dispatch *files-predicates*)

  (coco-defmodule coco_files_module "files" coco_f_dispatch *files-prolog*)

  ) ; impl-files

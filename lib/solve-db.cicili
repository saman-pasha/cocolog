;;;; cocolog -- output, the database, listing, and the builtin dispatcher
;;;
;;; A PIECE OF THE ENGINE, split out of lib/solve.cicili for size (2.16.1,
;;; where that file had reached 11 076 lines). The eight pieces are ONE
;;; translation unit, emitted in this order by cocolog.cicili and by the test
;;; binaries that link the engine: solve, solve-journal, solve-control,
;;; solve-gc, solve-loop, solve-arith, solve-text, solve-db. So a function
;;; here calls only what an earlier piece defined or `decl-solve' declared,
;;; as when they were one file; a new piece goes into that list in its place.
;;; lib/solve.cicili keeps the builtin table, the engine's vocabulary and
;;; every declaration: a new builtin's row goes there, its function in the
;;; piece it belongs to.
;;;
;;; THIS PIECE COMES LAST because it ends with the dispatcher: the table's
;;; rows name functions in every piece before it.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

(generic impl-solve-db
  ()

  ;;; ---- output ----

  (func coco_bi_write ((coco_engine * e) (size_t g)) (out int)
        (coco_print_term (-> e m) stdout (coco_arg (-> e m) g 0))
        (return 1))

  ;;; print/1 (2.2.4), swipl's: quoted, with numbervars and (2.2.5) its
  ;;; character escapes (`coco_write_print'). Through 2.2.3 it was write/1,
  ;;; and `print('a b')' read back as two words.
  (func coco_bi_print ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_print (-> e m) (aof b) (coco_arg (-> e m) g 0))
          (if (!= ($ b s) nil) (coco_out_puts stdout ($ b s)))
          (coco_sb_free (aof b))
          (return 1)))

  (func coco_bi_writeln ((coco_engine * e) (size_t g)) (out int)
        (coco_print_term (-> e m) stdout (coco_arg (-> e m) g 0))
        (coco_out_putc stdout 10)
        (return 1))

  ;;; write_canonical/1: quoted, with swipl's character escapes (2.2.5:
  ;;; `'don\'t''), no numbervars -- swipl's writes `'$VAR'(1)' as it is --
  ;;; and since 3.1.0 no operators and its variables `_' and `A', `B', ...
  ;;; (`coco_write_canon')
  (func coco_bi_write_canonical ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_canon (-> e m) (aof b) (coco_arg (-> e m) g 0))
          (if (!= ($ b s) nil) (coco_out_puts stdout ($ b s)))
          (coco_sb_free (aof b))
          (return 1)))

  (func coco_bi_nl ((coco_engine * e) (size_t g)) (out int)
        (coco_out_putc stdout 10)
        (return 1))

  ;;; ---- the database ----

  ;;; ASSERTING INTO A PREDICATE IS WHAT MAKES IT DYNAMIC, which is SWI's rule
  ;;; and the one that makes `existence_error' safe to raise at all. Without it,
  ;;; asserting a fact and retracting it again would leave a predicate that is
  ;;; neither defined nor declared, and the next call to it would raise where
  ;;; every other Prolog quietly fails.
  ;;;
  ;;; Only the GOAL marks. `coco_consult' asserts through the same function, and
  ;;; marking there would make every consulted predicate dynamic and put a
  ;;; `:- dynamic' line above all of them in `listing'.

  ;;; WHAT NO CLAUSE CAN DEFINE: a control construct -- true, fail, false,
  ;;; !, `,', `;', `->', `*->', `\+', call/N, catch/3, throw/1. The loop runs
  ;;; each before it looks at the store, a clause given to one never runs,
  ;;; and nobody keeps data under one; `assertz((a, b))' is a slip, and SWI
  ;;; refuses it: permission_error(modify, static_procedure, Name/Arity).
  ;;; A CORE BUILTIN'S NAME IS NOT REFUSED, where SWI refuses it: the store
  ;;; is a database of terms as well as a program, and what is kept there may
  ;;; share a builtin's name -- library(reasoning) keeps a lesson's word
  ;;; classes as facts, `number(dos)' among them, and reads them with
  ;;; clause/2, which a call to number/1 never reaches. Nor is a module's
  ;;; predicate refused: a module may decline a goal and send it on.
  (static)
  (func coco_static_pred ((coco_machine * m) (u64 nid) (u32 n)) (out int)
        (if (not (-> m ids_ready)) (return 0))
        (if (not (coco_is_construct m nid)) (return 0))
        (if (== n 0)
            (return (or (or (== nid (coco-id m "true")) (== nid (coco-id m "fail")))
                        (or (== nid (coco-id m "false")) (== nid (coco-id m "!"))))))
        (if (== n 1)
            (return (or (or (== nid (coco-id m "\\+")) (== nid (coco-id m "throw")))
                        (== nid (coco-id m "call")))))
        (if (== n 2)
            (if (or (or (== nid (coco-id m ",")) (== nid (coco-id m ";")))
                    (or (== nid (coco-id m "->")) (== nid (coco-id m "*->"))))
                (return 1)))
        (if (and (== n 3) (== nid (coco-id m "catch"))) (return 1))
        ;; call/N is a construct at every arity
        (return (== nid (coco-id m "call"))))

  ;;; A BODY HOLDS ONLY GOALS: a number or a string where a goal stands --
  ;;; under `,', `;', `->', `*->' or `\+' as well as alone -- is none, and
  ;;; SWI refuses the clause with type_error(callable, Body). A variable is
  ;;; call/1 of whatever it is bound to when the clause runs, as ISO has it.
  ;;; BUDGET is the control terms it may walk before it answers -1, and the
  ;;; caller asks whether the body is cyclic (1.10.19): `B = (a, B)' went
  ;;; down its right side for ever, `B = (B, a)' recursed until the C stack
  ;;; ran out.
  (static)
  (func coco_body_callable ((coco_machine * m) (size_t b) (size_t * budget)) (out int)
        (while 1
          (set b (coco_deref m b))
          (if (coco-tag-is REF (nth b (-> m heap))) (return 1))
          (if (not (coco_is_callable m b)) (return 0))
          (let ((u64 nid . #'(coco_name_of m b)) (u32 n . #'(coco_arity m b)))
            (if (== (cof budget) 0) (return -1))
            (set (cof budget) (- (cof budget) 1))
            (if (and (== n 1) (== nid (coco-id m "\\+")))
                (block (set b (coco_arg m b 0)) continue))
            (if (not (and (== n 2) (or (or (== nid (coco-id m ",")) (== nid (coco-id m ";")))
                                         (or (== nid (coco-id m "->")) (== nid (coco-id m "*->")))
                                         (== nid (coco-id m "|")))))
                (return 1))
            (let ((int r . #'(coco_body_callable m (coco_arg m b 0) budget)))
              (if (!= r 1) (return r)))
            (set b (coco_arg m b 1))))
        (return 1))

  ;;; `representation_error(cyclic_term)', what SWI's assert raises over a
  ;;; cyclic clause (1.10.19)
  (static)
  (func coco_cyclic_error ((coco_engine * e)) (out int)
        (return (coco_raise e (coco_make1 (-> e m) "representation_error"
                                          (coco_new_atom (-> e m) "cyclic_term")))))

  ;;; WHAT assert AND retract REFUSE, as SWI does: a clause or a head that is
  ;;; unbound is an instantiation error, a head that is not callable a type
  ;;; error, a head no clause can define (`coco_static_pred') a permission
  ;;; error, and -- asserting -- a body that is not goals a type error naming
  ;;; the whole body. Through 1.10.5 the first three made assert and retract
  ;;; FAIL, and `assertz((foo :- 3))' stored the clause. Answers 0 when the
  ;;; clause may go on, else what the raise answered.
  (static)
  (func coco_clause_check ((coco_engine * e) (size_t c) (int asserting)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t head) (size_t body . 0) (int rule . 0))
          (set c (coco_deref m c))
          (if (coco-tag-is REF (nth c (-> m heap))) (return (coco_instantiation_error e)))
          (set head c)
          (if (and (coco-tag-is FUN (nth c (-> m heap))) (== (coco_arity m c) 2))
              (if (== (coco_name_of m c) (coco-id m ":-"))
                  (block (set head (coco_deref m (coco_arg m c 0)))
                         (set body (coco_arg m c 1))
                         (set rule 1))))
          (if (coco-tag-is REF (nth head (-> m heap))) (return (coco_instantiation_error e)))
          (if (not (coco_is_callable m head)) (return (coco_type_error e "callable" head)))
          (if (coco_static_pred m (coco_name_of m head) (coco_arity m head))
              (return (coco_permission_error e "modify" "static_procedure"
                                             (coco_indicator m (coco_name_of m head)
                                                             (coco_arity m head)))))
          ;; 4096 control terms: a body past that is asked whether it is
          ;; cyclic, and walked again with no budget when it is not
          (if (and asserting rule)
              (let ((size_t budget . 4096)
                    (int bc . #'(coco_body_callable m body (aof budget))))
                (if (== bc -1)
                    (block
                     (if (!= 1 (coco_acyclic m body)) (return (coco_cyclic_error e)))
                     (set budget (cast size_t -1))
                     (set bc (coco_body_callable m body (aof budget)))))
                (if (== bc 0)
                    (return (coco_type_error e "callable" (coco_deref m body))))))
          (return 0)))

  (static)
  (func coco_assert_goal ((coco_engine * e) (size_t g) (int at_end)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t c . #'(coco_deref m (coco_arg m g 0)))
              (size_t head)
              (int bad . #'(coco_clause_check e c 1)))
          (if (!= bad 0) (return bad))
          (set head c)
          ;; a rule marks the predicate its HEAD names, not `:-'/2
          (if (and (coco_is_callable m c) (== (coco_arity m c) 2))
              (if (== 0 (strcmp (coco_atom_name m (coco_name_of m c)) ":-"))
                  (set head (coco_deref m (coco_arg m c 0)))))
          ;; A REFUSAL THE STORE CAN EXPLAIN IS AN EXCEPTION, not a failure.
          ;; `coco_assert' runs below the engine and has no ball to throw, so
          ;; it leaves a sentence behind instead -- today, a clause too long
          ;; for a row. `resource_error/1' is ISO's shape and catchable, which
          ;; is the whole point: the alternative was a commit that took every
          ;; other clause of the transaction with it. A cyclic clause is told
          ;; by the count of cycles put moving (`coco_assert_from').
          (with-green-write e
            (let ((size_t cp . #'(-> m cyc_puts)))
              (if (not (coco_assert (-> e st) m c at_end))
                  (block
                   (if (!= cp (-> m cyc_puts)) (return (coco_cyclic_error e)))
                   ;; the predicate could not be read first, and a write over
                   ;; what was read would have rewritten it without the rest
                   ;; (2.11.1): `coco_assert_from' left the reason
                   (if (!= (nth 0 ($ (cof (-> e st)) fetch_err)) (cast char 0))
                       (return (coco_fetch_error e)))
                   (if (!= (nth 0 ($ (cof (-> e st)) assert_err)) (cast char 0))
                       (return (coco_raise e (coco_make1 m "resource_error"
                                                         (coco_new_atom m "clause_length")))))
                   (return 0))))
            (if (coco_is_callable m head)
                (coco_pred_dynamic (-> e st) (coco_name_of m head) (coco_arity m head)))
            (coco_store_maybe_compact (-> e st) m)
            (return 1))))

  (func coco_bi_asserta ((coco_engine * e) (size_t g)) (out int)
        (return (coco_assert_goal e g 0)))

  (func coco_bi_assertz ((coco_engine * e) (size_t g)) (out int)
        (return (coco_assert_goal e g 1)))

  (func coco_bi_retract ((coco_engine * e) (size_t g)) (out int)
        (let ((int bad . #'(coco_clause_check e (coco_arg (-> e m) g 0) 0)))
          (if (!= bad 0) (return bad)))
        (with-green-write e
          (let ((int ok . #'(coco_retract (-> e st) (-> e m) (coco_arg (-> e m) g 0))))
            ;; -1: the predicate could not be read, and nothing was taken
            (if (< ok 0) (return (coco_fetch_error e)))
            (coco_store_maybe_compact (-> e st) (-> e m))
            (return (? ok 1 0)))))

  ;;; A PART OF A DECLARATION'S SPEC THAT IS NONE (3.1.0): FORMAL raised as
  ;;; swipl 9.0.4 raises it, NAME/ARITY the frame its raise names
  ;;; (compound_name_arity/3 for an indicator's parts,
  ;;; '$set_predicate_attribute'/3 for an ISO predicate), NAME nil for no
  ;;; context at all. The raise's answer.
  (static)
  (func coco_decl_bad ((coco_engine * e) (size_t formal) (const char * name) (u32 arity)) (out int)
        (if (== name nil) (return (coco_raise e formal)))
        (return (coco_raise_named e formal "system" name arity)))

  ;;; ONE INDICATOR THE WALK DECLARES, through the green world's write
  ;;; barrier: 1, or memory's error, or a backend that refused it
  ;;; resource_error(knowledge_base) in the context KIND/1 with the
  ;;; backend's sentence (3.0.3's).
  (static)
  (func coco_decl_put ((coco_engine * e) (int kind) (u64 nid) (u32 n)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (coco_store * st . #'(-> e st)) (int ok . 1))
          (with-green-write e
            (set (nth 0 (-> st write_err)) (cast char 0))
            (set ok (coco_decl_pi st m nid n kind)))
          (if (== ok 1) (return 1))
          (if (== ok 0) (return (coco_mem_error e)))
          (return (coco_raise_ctx e (coco_make1 m "resource_error" (coco_new_atom m "knowledge_base"))
                                  (coco_ectx_pi m "system" (coco_new_atom m (coco_decl_kind kind)) 1
                                                (coco_new_atom m (-> st write_err)))))))

  ;;; A GRAMMAR RULE'S ARITY, `A + 2' evaluated as swipl's '$pi_head'/2
  ;;; evaluates it: is/2's own errors, named by that frame (the goal in
  ;;; flight is made '$pi_head'(Spec, _) for the evaluation), and a value
  ;;; that is no integer type_error(integer, V) from compound_name_arity/3.
  ;;; 1 with the arity in OUT, or the raise's answer.
  (static)
  (func coco_decl_dcg_arity ((coco_engine * e) (size_t spec) (size_t ar) (i64 * out)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t was . #'(-> e kcall))
              (int isf . 0) (i64 iv . 0) (double fv . 0.0) (int rc . 0) (size_t v . 0))
          (set (-> e kcall) (coco_make2 m "$pi_head" spec (coco_new_var m)))
          (set rc (coco_arith e (coco_make2 m "+" ar (coco_new_int m 2)) (aof isf) (aof iv) (aof fv) 0))
          (if (== rc 3) (set rc (coco_type_error e "expression" ar)))
          (set (-> e kcall) was)
          (if (!= rc 1) (return rc))
          (if (== isf 0) (block (set (cof out) iv) (return 1)))
          (set v (? (== isf 2) (coco_new_rat m (-> m arith_n) (-> m arith_d)) (coco_new_float m fv)))
          (return (coco_decl_bad e (coco_make2 m "type_error" (coco_new_atom m "integer") v)
                                 "compound_name_arity" 3))))

  ;;; WHETHER NID/N HAS CLAUSES AND IS NO thread_local/1 ONE YET (3.2.0),
  ;;; which thread_local/1 refuses: the clauses the process holds of it.
  (static)
  (func coco_decl_has_clauses ((coco_engine * e) (u64 nid) (u32 n)) (out int)
        (let ((coco_store * st . #'(-> e st))
              (size_t pi . #'(coco_pred_find (-> e st) nid n)))
          (if (>= pi (-> st npreds)) (return 0))
          (if (bitand ($ (nth pi (-> st preds)) pattrs) 8) (return 0))
          (return (> (coco_pred_live (aof (nth pi (-> st preds)))) 0))))

  ;;; A DECLARATION'S SPEC WALKED (3.1.0): dynamic/1's, discontiguous/1's
  ;;; and multifile/1's -- KIND 0, 1, 2 -- as swipl 9.0.4 walks it, a list
  ;;; or a conjunction part by part and `M:S' as S, each Name/Arity or
  ;;; Name//Arity checked and then declared IN TURN, so the parts before a
  ;;; bad one stay declared: `dynamic([a/1, b])' declares a/1 and raises
  ;;; for b, where through 3.0.4 the whole spec was checked first and
  ;;; nothing declared. A part that is none raises, in swipl's words and
  ;;; frames: a variable uninstantiation_error(Part), anything else that is
  ;;; no indicator type_error(predicate_indicator, Part), both with no
  ;;; context; a grammar rule's arity is evaluated first
  ;;; (`coco_decl_dcg_arity'); the name and the arity compound_name_arity/3's
  ;;; errors, or, for an arity of 0, the same errors with no context
  ;;; (swipl's '$head_name_arity'/3 raises those itself); an arity past
  ;;; 255, cocolog's ceiling, representation_error(max_arity); and one of
  ;;; swipl's ISO predicates (`*iso-predicates*', a control construct among
  ;;; them) permission_error(modify, static_procedure, Name/Arity) from
  ;;; '$set_predicate_attribute'/3, as swipl refuses to declare one. 1, or
  ;;; the raise's answer. A directive walks a spec that is not plain part by
  ;;; part through this, reporting each raise ('$decl_directive'/2).
  (func coco_decl_walk ((coco_engine * e) (size_t spec) (int kind)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (int r . 1))
          (set spec (coco_deref m spec))
          (if (coco-tag-is REF (nth spec (-> m heap)))
              (return (coco_decl_bad e (coco_make1 m "uninstantiation_error" spec) nil 0)))
          (if (or (coco_is_compound2 m spec ",") (coco_is_cons m spec))
              (block (set r (coco_decl_walk e (coco_arg m spec 0) kind))
                     (if (!= r 1) (return r))
                     (return (coco_decl_walk e (coco_arg m spec 1) kind))))
          (if (coco_is_nil m spec) (return 1))
          (if (coco_is_compound2 m spec ":")
              (return (coco_decl_walk e (coco_arg m spec 1) kind)))
          (if (and (not (coco_is_compound2 m spec "/")) (not (coco_is_compound2 m spec "//")))
              (return (coco_decl_bad e (coco_make2 m "type_error"
                                                   (coco_new_atom m "predicate_indicator") spec)
                                     nil 0)))
          (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
                (size_t ar . #'(coco_deref m (coco_arg m spec 1)))
                (int dcg . #'(coco_is_compound2 m spec "//"))
                (int known . 0)
                (i64 n . 0)
                (const char * where . "compound_name_arity"))
            ;; a grammar rule's arity, when it is given: evaluated first
            (if (and dcg (not (coco-tag-is REF (nth ar (-> m heap)))))
                (block
                  (set r (coco_decl_dcg_arity e spec ar (aof n)))
                  (if (!= r 1) (return r))
                  (set known 1)))
            (if (and (not known) (coco-is-int (nth ar (-> m heap))))
                (block (set n (coco_int_val m (nth ar (-> m heap)))) (set known 1)))
            ;; an arity of 0 names nothing but the name: no context
            (if (and known (== n 0)) (set where nil))
            (if (or (coco-tag-is REF (nth nm (-> m heap))) (coco-tag-is REF (nth ar (-> m heap))))
                (return (coco_decl_bad e (coco_new_atom m "instantiation_error") where 3)))
            (if (not (coco-tag-is ATOM (nth nm (-> m heap))))
                (return (coco_decl_bad e (coco_make2 m "type_error" (coco_new_atom m "atom") nm) where 3)))
            (if (not known)
                (return (coco_decl_bad e (coco_make2 m "type_error" (coco_new_atom m "integer") ar)
                                       "compound_name_arity" 3)))
            (if (< n 0)
                (return (coco_decl_bad e (coco_make2 m "domain_error" (coco_new_atom m "not_less_than_zero")
                                                     (coco_new_int m n))
                                       "compound_name_arity" 3)))
            (if (> n 255)
                (return (coco_decl_bad e (coco_make1 m "representation_error"
                                                     (coco_new_atom m "max_arity"))
                                       nil 0)))
            ;; and thread_local/1 of a predicate that has clauses and is
            ;; not thread_local already, as swipl refuses it (3.2.0)
            (if (or (coco_iso_predicate (coco_atom_name m (coco_name_of m nm)) (cast u32 n))
                    (and (== kind 6) (coco_decl_has_clauses e (coco_name_of m nm) (cast u32 n))))
                (let ((size_t args [3]))
                  (set (nth 0 args) (coco_new_atom m "modify"))
                  (set (nth 1 args) (coco_new_atom m "static_procedure"))
                  (set (nth 2 args) (coco_make2 m "/" nm (coco_new_int m n)))
                  (return (coco_decl_bad e (coco_make m "permission_error" 3 args)
                                         "$set_predicate_attribute" 3))))
            (return (coco_decl_put e kind (coco_name_of m nm) (cast u32 n))))))

  ;;; dynamic/1, discontiguous/1 and multifile/1 as goals -- what the
  ;;; directives are (`coco_directive', lib/kb-pred.cicili): one walk,
  ;;; reached two ways. Through 3.0.4 discontiguous/1 and multifile/1 kept
  ;;; nothing, and a refusal was the whole spec's.
  (func coco_bi_dynamic ((coco_engine * e) (size_t g)) (out int)
        (return (coco_decl_walk e (coco_arg (-> e m) g 0) 0)))

  (func coco_bi_discontiguous ((coco_engine * e) (size_t g)) (out int)
        (return (coco_decl_walk e (coco_arg (-> e m) g 0) 1)))

  (func coco_bi_multifile ((coco_engine * e) (size_t g)) (out int)
        (return (coco_decl_walk e (coco_arg (-> e m) g 0) 2)))

  ;;; '$declare'(Kind, Spec): public/1, volatile/1, module_transparent/1
  ;;; and thread_local/1 (3.2.0, swipl's), KIND 3 to 6 of the same walk --
  ;;; clauses of the Prolog half call it. The first three are an attribute
  ;;; predicate_property/2 tells, and no definition, so a call of a
  ;;; predicate they named and nothing else defined raises existence_error
  ;;; as swipl's does; thread_local/1 is dynamic/1 as well, which every
  ;;; dynamic predicate is here -- a thread has a store of its own. Its
  ;;; refusals name no predicate, as swipl's (no row in *error-contexts*),
  ;;; but the permission error's '$set_predicate_attribute'/3.
  (func coco_bi_declare ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t k . #'(coco_deref m (coco_arg m g 0)))
              (i64 kind . 0))
          (if (not (coco-is-int (nth k (-> m heap)))) (return 0))
          (set kind (coco_int_val m (nth k (-> m heap))))
          (if (or (< kind 3) (> kind 6)) (return 0))
          (return (coco_decl_walk e (coco_arg m g 1) (cast int kind)))))

  ;;; redefine_system_predicate(+Head) (3.1.0, swipl's): a clause a program
  ;;; file gives Head's predicate takes it over from the system's, an ISO
  ;;; one's too (`redef', `coco_assert_from'), where without this it is
  ;;; refused; the system's runs until that clause comes. M:Head is Head; a
  ;;; name nothing implements, or a construct but not/1 and ignore/1, is
  ;;; left as it is; a Head that is unbound, or no goal, swipl's error.
  (func coco_bi_redefine_system ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t h . #'(coco_deref (-> e m) (coco_arg (-> e m) g 0))))
          (while (coco_is_compound2 m h ":") (set h (coco_deref m (coco_arg m h 1))))
          (if (not (coco_is_callable m h)) (return (coco_type_error e "callable" h)))
          (let ((u64 nid . #'(coco_name_of m h)) (u32 n . #'(coco_arity m h)))
            (if (and (== (coco_claim_kind m nid n) 2) (not (coco_is_construct m nid)))
                (let ((size_t pi . #'(coco_pred_make st nid n)))
                  (if (< pi (-> st npreds)) (set ($ (nth pi (-> st preds)) redef) 1))))
            (return 1))))

  ;;; `'$decl_report'(Kind, Ball)' (3.1.0): what a directive's part raised,
  ;;; reported where the directive stands in swipl's two lines, `Kind/1: '
  ;;; before the message whatever frame the raise named, as swipl's
  ;;; '$pattr_directive' prints it. Always true: the directive goes on.
  (func coco_bi_decl_report ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t k . #'(coco_deref m (coco_arg m g 0)))
              (size_t b . #'(coco_deref m (coco_arg m g 1)))
              (char text [1024]))
          (if (and (coco_is_compound2 m b "error") (coco-tag-is ATOM (nth k (-> m heap))))
              (block
                ;; swipl's module_transparent/1 reports as transparent/1,
                ;; the attribute's own name (3.2.0)
                (if (== 0 (strcmp (coco_atom_name m (coco_name_of m k)) "module_transparent"))
                    (set k (coco_new_atom m "transparent")))
                (set b (coco_make2 m "error" (coco_arg m b 0)
                                   (coco_ectx_pi m "system" k 1 (coco_new_var m))))))
          (coco_error_text m (-> e st) b text (sizeof text))
          (coco_load_message "ERROR" (-> m sloc_file) (-> m sloc_line) text)
          (return 1)))

  ;;; A NO-OP FOR A BINARY THAT LINKS THE ENGINE WITHOUT THE GREEN MODULE
  ;;; (2.8.0): test/solve.cicili and test/shared.cicili have no
  ;;; lib/green.cicili, and Darwin's -undefined,dynamic_lookup would make
  ;;; every write hook a jump to address 0 (found by the 2.8.0 suite, both
  ;;; binaries a SIGSEGV). cocolog.cicili compiles with -DCOCO_GREEN and
  ;;; gets the green module's definition instead.
  (@ifndef (code "COCO_GREEN"))
  (func coco_g_write_begin ((void * e)) (out int) (return 0))
  (func coco_g_write_end () (return))
  (func coco_g_write_end_cleanup ((int * began)) (return))
  (@endif)

  ;;; ---- listing ------------------------------------------------------------

  ;;; One predicate, written so that it reads back. A `:- dynamic' line first if
  ;;; it is one, then a clause per line, then a blank line.
  ;;;
  ;;; IT ASKS THE BACKEND FIRST. A predicate whose clauses are still in the
  ;;; database has an empty list here until somebody calls it, and a `listing'
  ;;; that showed nothing for a predicate that plainly has clauses would be
  ;;; worse than no listing at all.
  ;;; Answers whether it printed anything: a predicate that is neither declared
  ;;; nor has any clauses is one this store merely has a name for -- interned by
  ;;; a call that failed, or left behind by retracting the last clause of
  ;;; something never declared -- and listing a blank line for it says nothing.
  ;;; A predicate that could not be read answers -1, with the reason on the
  ;;; store for the caller to raise (2.11.1).
  (static)
  (func coco_listing_pred ((coco_engine * e) (size_t pi)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (coco_strbuf b))
          (if (not (coco_pred_ensure st pi)) (return -1))
          (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
                (const char * nm . #'(coco_atom_name m ($ (nth pi (-> st preds)) name)))
                (int dyn . #'($ (nth pi (-> st preds)) dynamic))
                (int dcl . #'($ (nth pi (-> st preds)) declared)))

            (if (and (not dyn) (not dcl) (== (coco_pred_live p) 0)) (return 0))

            ;; THE DECLARATIONS FIRST, one line each and a blank line after
            ;; them, as swipl's listing writes them: dynamic, then multifile
            ;; (3.1.0); a discontiguous declaration it never writes
            (if dyn
                (block (printf ":- dynamic %s/%u.\n" nm
                               (cast unsigned ($ (nth pi (-> st preds)) arity)))
                       (coco_out_note stdout "\n" 1)))
            (if (bitand dcl 2)
                (block (printf ":- multifile %s/%u.\n" nm
                               (cast unsigned ($ (nth pi (-> st preds)) arity)))
                       (coco_out_note stdout "\n" 1)))
            (if (or dyn (bitand dcl 2)) (coco_out_puts stdout "\n"))

            (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
              ;; a clause retracted under a call still open is gone
              (if (coco_pred_dead p i) continue)
              (let ((size_t mark . #'(-> m heap_len))
                    (size_t t . #'(coco_store_get m st (nth i (-> p clauses)))))
                (coco_sb_init (aof b))
                ;; quoted, so an atom that needs them gets them and the line can
                ;; be pasted back into a file
                (coco_write_term m (aof b) t 1 0)
                (if (!= ($ b s) nil) (fputs ($ b s) stdout))
                (coco_out_puts stdout ".\n")
                (coco_sb_free (aof b))
                ;; the clause was copied on to the heap only to be written
                (set (-> m heap_len) mark)))
            ;; the blank line separates predicates: after the clauses, and
            ;; after a declared predicate's blank line when it has none, as
            ;; swipl writes it (through 3.0.4 one blank line in all there)
            (coco_out_puts stdout "\n")
            (return 1))))

  ;;; `listing' with no argument is the PROGRAM, not everything reachable. A
  ;;; module's clauses are in the same store -- that is what makes them
  ;;; callable -- but a person asking what they have written does not want the
  ;;; Files library back, any more than SWI's `listing' hands back library(lists).
  ;;; `listing(Name)' still shows them: asking for one by name is asking about
  ;;; that one specifically. A file the program loaded by its path is the
  ;;; program's (`own', 1.10.28): `-s FILE' listed nothing of FILE.
  (func coco_bi_listing_all ((coco_engine * e) (size_t g)) (out int)
        (coco_store_warm (-> e st))
        ;; `npreds' is read each time round rather than once: `coco_pred_ensure'
        ;; inside the listing can intern predicates the clauses it fetches
        ;; mention, and the loop should reach those too.
        (for ((size_t i . 0)) (< i ($ (cof (-> e st)) npreds)) ((++ i))
          (if (or (not ($ (nth i ($ (cof (-> e st)) preds)) library))
                  ($ (nth i ($ (cof (-> e st)) preds)) own))
              (if (< (coco_listing_pred e i) 0) (return (coco_fetch_error e)))))
        (return 1))

  ;;; `listing(Name)' lists every arity of that name; `listing(Name/Arity)' the
  ;;; one. Both are what other Prologs do, and a program that knows only the
  ;;; name of what it asserted should not have to count its arguments.
  (func coco_bi_listing ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t spec . #'(coco_a e g 0))
              (int shown . 0))

          ;; ASKED BEFORE ANYTHING IS DECIDED, for either shape of argument.
          ;; What the backend holds is not only which predicates there are but
          ;; which of them were DECLARED, and a `listing(counter/1)' that found
          ;; the clauses and missed the `:- dynamic' line would be quietly
          ;; wrong in a way that reads back as a different program.
          (coco_store_warm st)

          (if (coco_is_compound2 m spec "/")
              (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
                    (size_t ar . #'(coco_deref m (coco_arg m spec 1))))
                (if (not (coco-tag-is ATOM (nth nm (-> m heap))))
                    (return (coco_fail_err e "listing/1 needs a name")))
                (if (not (coco-tag-is INT (nth ar (-> m heap))))
                    (return (coco_fail_err e "listing/1 needs an arity")))
                ;; interned rather than merely looked up: a predicate this
                ;; interpreter has not called yet is not in the store, and
                ;; `listing' of it should say what the knowledge base holds
                ;; rather than what this process happens to have reached.
                (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m nm)
                                                     (cast u32 (coco-signed-payload
                                                                (nth ar (-> m heap)))))))
                  (if (>= pi (-> st npreds)) (return 0))
                  (let ((int shown1 . #'(coco_listing_pred e pi)))
                    (if (< shown1 0) (return (coco_fetch_error e)))
                    (return shown1)))))

          (if (not (coco-tag-is ATOM (nth spec (-> m heap))))
              (return (coco_fail_err e "listing/1 needs a name or Name/Arity")))

          ;; By name: every arity of it. The store has no index from a name to
          ;; its arities, so this is a walk -- over what warming put there.
          (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
            (if (== ($ (nth i (-> st preds)) name) (coco_name_of m spec))
                (let ((int one . #'(coco_listing_pred e i)))
                  (if (< one 0) (return (coco_fetch_error e)))
                  (if one (set shown 1)))))
          (return shown)))

  (func coco_bi_halt ((coco_engine * e) (size_t g)) (out int)
        (set (-> e halted) 1)
        (return 1))

  ;;; `vacuum_kb' and `vacuum_kb(Live)': the reclaim pass, from inside a
  ;;; program. The store's `vacuum' hook is the whole permission model -- a
  ;;; backend that can vacuum installs it, and the composition root clears it
  ;;; again unless the operator said `--vacuum' -- so a null hook here is a
  ;;; refusal, not an absence: permission_error, with the goal itself as the
  ;;; culprit. Deliberately NOT a quiet success on a local store, because a
  ;;; program that believes it vacuumed and did not is the exact confusion
  ;;; the loud cuda refusal exists to prevent one seam over.
  ;;;
  ;;; Live is the count of live rows left behind -- run it twice and the
  ;;; second answer being the same is what says there was nothing left.
  (func coco_bi_vacuum_kb ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_store * st . #'(-> e st))
              (i64 live . 0))
          (if (== (-> st vacuum) nil)
              (return (coco_permission_error e "vacuum" "knowledge_base" g)))
          (if (not ((-> st vacuum) st (-> st ctx) (aof live)))
              (return (coco_fail_err e "vacuum_kb: the backend refused the pass")))
          (if (== 0 (coco_arity (-> e m) g)) (return 1))
          (return (? (coco_unify (-> e m) (coco_arg (-> e m) g 0)
                                 (coco_new_int (-> e m) live)) 1 0))))

  (func coco_choice_restore ((coco_engine * e) (int kind) (size_t goals)
                           (size_t trail_mark) (size_t heap_mark) (size_t call)
                           (size_t clause_ix) (size_t barrier)
                           (const char * pred_name) (u32 pred_arity)) (out int)
        (if (not (coco_eng_grow e (+ (-> e nchoices) 1))) (return 0))
        ;; the shadow frame ZEROED, which is what the tracer's comment has
        ;; always said a thawed frame gets -- the realloc that makes room for
        ;; it does not zero, and the heap collector reads its goal as a root
        (memset (aof (nth (-> e nchoices) (-> e tchoices))) 0 (sizeof coco_tchoice))
        (let ((coco_choice * c . #'(aof (nth (-> e nchoices) (-> e choices)))))
          (memset c 0 (sizeof coco_choice))
          (set (-> c kind) kind)
          (set (-> c goals) goals)
          (set (-> c trail_mark) trail_mark)
          (set (-> c heap_mark) heap_mark)
          (set (-> c call) call)
          (set (-> c clause_ix) clause_ix)
          (set (-> c barrier) barrier)
          (if (== kind COCO_CH_CLAUSE)
              (let ((size_t pi . #'(coco_pred_intern (-> e st)
                                                   (coco_intern (-> e m) pred_name)
                                                   pred_arity)))
                (if (>= pi ($ (cof (-> e st)) npreds)) (return 0))
                ;; ask the backend for this predicate NOW rather than when the
                ;; frame is next tried: `clause_ix' is a position in its clause
                ;; list, and a list that has not been fetched yet is empty --
                ;; and one whose read failed is no list at all: the thaw
                ;; refuses, saying why (`coco_thaw', 2.11.1)
                (if (not (coco_pred_ensure (-> e st) pi)) (return 0))
                (set (-> c pred) pi)
                ;; A RESUMED CALL RUNS ON THE KNOWLEDGE BASE AS IT IS (the
                ;; owner's design, README.md's `What is stored, and how'), and
                ;; how far it may go there is the blob's `L' section: the live
                ;; clauses before the end it began with (lib/state.cicili).
                ;; A blob without one leaves the end unsettled here, and the
                ;; run binds it to the clauses there are once it has loaded
                ;; the modules' own clauses back (`coco_frames_bound'): a
                ;; library predicate is empty until then.
                (set (-> c cend) 4294967295)
                (set (-> e cunbound) 1)
                (set ($ (nth pi ($ (cof (-> e st)) preds)) framed) 1)))
          (set (-> e nchoices) (+ (-> e nchoices) 1))
          ;; a setup_call_cleanup/3 frame is counted again (3.1.0): the heap
          ;; it names is the thawed one, read before the frames
          (if (and (== kind COCO_CH_GOAL) (< call ($ (cof (-> e m)) heap_len))
                   (coco_scc_at e (- (-> e nchoices) 1) (coco_intern (-> e m) "$scc_fail")))
              (set (-> e ncleanup) (+ (-> e ncleanup) 1)))
          (return 1)))

  ;;; THE FRAMES OPEN ON PREDICATE PI of ST -- see the declaration in
  ;;; lib/kb.cicili. A clause frame or a clocked one (a clause frame a
  ;;; window's clock marked); a spent one tries nothing more, and a frame of
  ;;; any other kind keeps something else in `pred' and `clause_ix'. The
  ;;; engines of the chain are every one a program can still fail back
  ;;; into: no builtin leaves a choice point behind, so a nested engine is
  ;;; on the chain for as long as it has frames anybody may try, and a
  ;;; host's engine waiting for its next answer runs no goal meanwhile.
  ;;; Each engine is read from the top, where a loop's own frame is.
  (func coco_frames_on ((coco_machine * m) (coco_store * st) (size_t pi)
                        (int act) (u32 era) (size_t at)) (out size_t)
        (if (or (== m nil) (>= pi (-> st npreds))) (return 0))
        (if (not ($ (nth pi (-> st preds)) framed)) (return 0))
        ;; N is the answer, the frames open (or ACT 3's that see AT), and
        ;; OPEN every one open, which says whether the next walk is needed
        (let ((size_t n . 0) (size_t open . 0)
              (coco_machine * mm . #'(cast (coco_machine *) (-> st machines))))
          ;; ONE MACHINE'S FRAMES, OR EVERY MACHINE THE STORE LISTS (2.7.0):
          ;; a green world links the host and every green thread's machine,
          ;; so a suspended thread's open call counts as an open call.
          (if (== mm nil) (set mm m))
          (while (!= mm nil)
            (let ((coco_engine * e . #'(cast (coco_engine *) (-> mm eng))))
              (if (== e nil) (set e (cast (coco_engine *) (-> mm keep_eng))))
              (while (!= e nil)
                (if (== (-> e st) st)
                    (let ((size_t i . #'(-> e nchoices)))
                      (while (> i 0)
                        (set i (- i 1))
                        (let ((coco_choice * c . #'(aof (nth i (-> e choices)))))
                          (if (and (or (== (-> c kind) COCO_CH_CLAUSE) (== (-> c kind) COCO_CH_CLOCKED))
                                   (== (-> c pred) pi))
                              (block
                               (set open (+ open 1))
                               (cond
                                 ((== act 0) (return open))
                                 ;; a death it lives through, the first it has
                                 ((== act 1)
                                  (set n open)
                                  (if (== (-> c fera) 0) (set (-> c fera) era)))
                                 ;; a clause at AT inside what it has still to
                                 ;; try, which no move of it can keep from it.
                                 ;; A thawed frame not bounded yet ends nowhere
                                 ;; it could keep, and is not counted
                                 ((== act 3)
                                  (if (and (< (-> c clause_ix) at) (!= (-> c cend) 4294967295)
                                           (> (cast size_t (-> c cend)) at))
                                      (set n (+ n 1))))
                                 (#t
                                  (set n open)
                                  (if (>= (-> c clause_ix) at)
                                      (block
                                       (set (-> c clause_ix) (+ (-> c clause_ix) 1))
                                       ;; a thawed frame not bounded yet stays so
                                       (if (!= (-> c cend) 4294967295)
                                           (set (-> c cend) (+ (-> c cend) 1)))))))))))))
                (set e (cast (coco_engine *) (-> e outer)))))
            (set mm (cast (coco_machine *) (-> mm st_next))))
          ;; none open: no walk until a frame is pushed on it again
          (if (== open 0) (set ($ (nth pi (-> st preds)) framed) 0))
          (return n)))

  ;;; The dispatcher comes last because it names every builtin above it, and a
  ;;; call needs the definition to have been seen.
  (coco-emit-id-fill)

  (coco-emit-builtin-dispatch)
  (coco-emit-builtin-index)
  (coco-emit-iso-predicate)

  ;;; THE ROW A FUNCTOR KEEPS (`bix', 3.1.0): K + 2 for the builtin of row
  ;;; K, and 1 for none -- or for one a program file took over
  ;;; (`coco_pred_taken'; ISO only after redefine_system_predicate/1): swipl
  ;;; calls a user file's definition of a system predicate in its place.
  ;;; Asked once per functor, by the step and by the compiler of a body's
  ;;; later goals (`cc_uplace'), and moved after only by
  ;;; `coco_pred_take_over'.
  (func coco_bix_fill ((coco_machine * m) (coco_store * st) (u64 nid) (u32 n)) (out u32)
        (let ((int row . #'(coco_builtin_index m nid n)))
          (if (< row 0) (return 1))
          (if (coco_pred_taken st nid n) (return 1))
          (return (cast u32 (+ row 2)))))

  ;;; A PROGRAM FILE TAKES PI OVER (3.1.0, `coco_assert_from', for a name
  ;;; `coco_claim_kind' answered 1): the predicate is called from now on,
  ;;; ahead of the builtin it is named after. A functor that already kept
  ;;; the builtin's row keeps none (a body compiled against the row hands
  ;;; its goal over when it finds the row gone, `coco_env_place'), and one
  ;;; a module claimed for this generation of the registry is asked again:
  ;;; the generation moves on, and the module walk passes a taken name by
  ;;; (`coco_m_taken'). An atom has no functor: the step asks the store of
  ;;; an atom goal. A construct's name -- not/1, ignore/1 -- and an ISO
  ;;; one (redefine_system_predicate/1) have every clause compiled again
  ;;; (`coco_code_forget_all'), as a body compiled before runs the construct
  ;;; or the guard in place.
  (func coco_pred_take_over ((coco_store * st) (coco_machine * m) (size_t pi) (size_t head))
        (set ($ (nth pi (-> st preds)) taken) 1)
        (set (-> st ntaken) (+ (-> st ntaken) 1))
        ;; the library's own clauses of it are the library's module's in
        ;; swipl, which the program's definition does not see
        (coco_pred_forget_muted st m pi)
        (set head (coco_deref m head))
        (if (coco-tag-is FUN (nth head (-> m heap)))
            (let ((coco_functor * f . #'(aof (nth (cast size_t (coco-payload (nth head (-> m heap))))
                                                  (-> m functors)))))
              (if (>= (-> f bix) 2) (set (-> f bix) 1))
              (if (and (== (-> f dgen) coco_extern_generation) (>= (-> f dmod) 0))
                  (set coco_extern_generation (+ coco_extern_generation 1)))
              (if (or (coco_is_construct m (-> f name))
                      (coco_iso_predicate (coco_atom_name m (-> f name)) (-> f arity)))
                  (coco_code_forget_all st))))
        ;; and the libraries' calls of it stay the builtin's, as a swipl
        ;; library module's do (`coco_sys_library', `coco_colon')
        (coco_sys_library st m))

  ;;; Whether the module walk passes NAME/ARITY by (3.1.0): a program file
  ;;; took it over -- unless `system:G' asked for the module's own
  ;;; (`systake', `coco_colon').
  (func coco_m_taken ((coco_engine * e) (const char * name) (u32 arity)) (out int)
        (if (== (-> (-> e st) ntaken) 0) (return 0))
        (if (-> e systake) (return 0))
        (return (coco_pred_taken (-> e st) (coco_intern (-> e m) name) arity)))

  ;;; THE NAMES THE ENVIRONMENT'S COMPILER TELLS A CONSTRUCT BY (Stage 6),
  ;;; from the vocabulary interned once per machine (lib/kb.cicili asks):
  ;;; NAMES[0 .. 13] the atoms `;', `->', `*->', `\+', `not', `once',
  ;;; `ignore', `,', `true', `fail', `false', `!', `$true' and `$fail', and
  ;;; FCUT the functor `'$cut'/1'. 0, with nothing written, before the
  ;;; vocabulary is interned. Interned at every compile instead, they cost
  ;;; each clause 1 300 instructions.
  (func coco_unit_names ((coco_machine * m) (u64 * names) (u64 * fcut)) (out int)
        (if (not (-> m ids_ready)) (return 0))
        (set (nth 0 names) (coco-id m ";"))
        (set (nth 1 names) (coco-id m "->"))
        (set (nth 2 names) (coco-id m "*->"))
        (set (nth 3 names) (coco-id m "\\+"))
        (set (nth 4 names) (coco-id m "not"))
        (set (nth 5 names) (coco-id m "once"))
        (set (nth 6 names) (coco-id m "ignore"))
        (set (nth 7 names) (coco-id m ","))
        (set (nth 8 names) (coco-id m "true"))
        (set (nth 9 names) (coco-id m "fail"))
        (set (nth 10 names) (coco-id m "false"))
        (set (nth 11 names) (coco-id m "!"))
        (set (nth 12 names) (coco-id m "$true"))
        (set (nth 13 names) (coco-id m "$fail"))
        (set (cof fcut) (coco-fid m "$cut" 1))
        (return 1))
  (coco-emit-builtin-call)

  ) ; impl-solve-db

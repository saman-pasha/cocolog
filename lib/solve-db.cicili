;;;; cocolog -- output, the database, listing, and the builtin dispatcher
;;;
;;; A PIECE OF THE ENGINE, split out of lib/solve.cicili for size (2.16.1,
;;; where that file had reached 11 076 lines). The eight pieces are ONE
;;; translation unit, emitted in this order by cocolog.cicili and by the test
;;; binaries that link the engine: solve, solve-journal, solve-control,
;;; solve-gc, solve-loop, solve-arith, solve-text, solve-db. So a function
;;; here calls only what an earlier piece defined or `decl-solve' declared,
;;; as when they were one file; a new piece goes into that list in its place.
;;; lib/solve.cicili keeps the builtin table, the engine's vocabulary and
;;; every declaration: a new builtin's row goes there, its function in the
;;; piece it belongs to.
;;;
;;; THIS PIECE COMES LAST because it ends with the dispatcher: the table's
;;; rows name functions in every piece before it.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

(generic impl-solve-db
  ()

  ;;; ---- output ----

  (func coco_bi_write ((coco_engine * e) (size_t g)) (out int)
        (coco_print_term (-> e m) stdout (coco_arg (-> e m) g 0))
        (return 1))

  ;;; THE PRINT/1 THAT ASKS PORTRAY/1 (3.54.0), filled in by the builtins
  ;;; module (`coco_b_print' in lib/builtins-db.cicili): with none, in a
  ;;; binary with no such module, print/1 writes as below
  (static) (var func coco_print_hook ((coco_engine * e) (size_t g)) (out int))

  (func coco_print_install ((func h ((coco_engine * e) (size_t g)) (out int)))
        (set coco_print_hook h))

  ;;; print/1 (2.2.4), swipl's: quoted, with numbervars and (2.2.5) its
  ;;; character escapes (`coco_write_print'). Through 2.2.3 it was write/1,
  ;;; and `print('a b')' read back as two words.
  (func coco_bi_print ((coco_engine * e) (size_t g)) (out int)
        (if (!= coco_print_hook nil) (return (coco_print_hook e g)))
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_print (-> e m) (aof b) (coco_arg (-> e m) g 0))
          (if (!= ($ b s) nil) (coco_out_puts stdout ($ b s)))
          (coco_sb_free (aof b))
          (return 1)))

  (func coco_bi_writeln ((coco_engine * e) (size_t g)) (out int)
        (coco_print_term (-> e m) stdout (coco_arg (-> e m) g 0))
        (coco_out_putc stdout 10)
        (return 1))

  ;;; write_canonical/1: quoted, with swipl's character escapes (2.2.5:
  ;;; `'don\'t''), no numbervars -- swipl's writes `'$VAR'(1)' as it is --
  ;;; and since 3.1.0 no operators and its variables `_' and `A', `B', ...
  ;;; (`coco_write_canon')
  (func coco_bi_write_canonical ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_canon (-> e m) (aof b) (coco_arg (-> e m) g 0))
          (if (!= ($ b s) nil) (coco_out_puts stdout ($ b s)))
          (coco_sb_free (aof b))
          (return 1)))

  (func coco_bi_nl ((coco_engine * e) (size_t g)) (out int)
        (coco_out_putc stdout 10)
        (return 1))

  ;;; ---- the database ----

  ;;; ASSERTING INTO A PREDICATE IS WHAT MAKES IT DYNAMIC, which is SWI's rule
  ;;; and the one that makes `existence_error' safe to raise at all. Without it,
  ;;; asserting a fact and retracting it again would leave a predicate that is
  ;;; neither defined nor declared, and the next call to it would raise where
  ;;; every other Prolog quietly fails.
  ;;;
  ;;; Only the GOAL marks. `coco_consult' asserts through the same function, and
  ;;; marking there would make every consulted predicate dynamic and put a
  ;;; `:- dynamic' line above all of them in `listing'.

  ;;; WHAT NO CLAUSE CAN DEFINE: a control construct -- true, fail, false,
  ;;; !, `,', `;', `->', `*->', `\+', call/N, catch/3, throw/1. The loop runs
  ;;; each before it looks at the store, a clause given to one never runs,
  ;;; and nobody keeps data under one; `assertz((a, b))' is a slip, and SWI
  ;;; refuses it: permission_error(modify, static_procedure, Name/Arity).
  ;;; A CORE BUILTIN'S NAME IS NOT REFUSED, where SWI refuses it: the store
  ;;; is a database of terms as well as a program, and what is kept there may
  ;;; share a builtin's name -- library(reasoning) keeps a lesson's word
  ;;; classes as facts, `number(dos)' among them, and reads them with
  ;;; clause/2, which a call to number/1 never reaches. Nor is a module's
  ;;; predicate refused: a module may decline a goal and send it on.
  (static)
  (func coco_static_pred ((coco_machine * m) (u64 nid) (u32 n)) (out int)
        (if (not (-> m ids_ready)) (return 0))
        (if (not (coco_is_construct m nid)) (return 0))
        (if (== n 0)
            (return (or (or (== nid (coco-id m "true")) (== nid (coco-id m "fail")))
                        (or (== nid (coco-id m "false")) (== nid (coco-id m "!"))))))
        (if (== n 1)
            (return (or (or (== nid (coco-id m "\\+")) (== nid (coco-id m "throw")))
                        (== nid (coco-id m "call")))))
        (if (== n 2)
            (if (or (or (== nid (coco-id m ",")) (== nid (coco-id m ";")))
                    (or (== nid (coco-id m "->")) (== nid (coco-id m "*->"))))
                (return 1)))
        (if (and (== n 3) (== nid (coco-id m "catch"))) (return 1))
        ;; call/N is a construct at every arity
        (return (== nid (coco-id m "call"))))

  ;;; A BODY HOLDS ONLY GOALS: a number, a string or (3.19.2) the list's
  ;;; end where a goal stands -- under `,', `;', `->', `*->' or `\+' as
  ;;; well as alone -- is none, and
  ;;; SWI refuses the clause with type_error(callable, Body). A variable is
  ;;; call/1 of whatever it is bound to when the clause runs, as ISO has it.
  ;;; BUDGET is the control terms it may walk before it answers -1, and the
  ;;; caller asks whether the body is cyclic (1.10.19): `B = (a, B)' went
  ;;; down its right side for ever, `B = (B, a)' recursed until the C stack
  ;;; ran out. The right arms wait on a worklist and the left is taken
  ;;; first, as the recursion took it (3.15.1): `assertz((p :- B))' with B
  ;;; nested 200 000 deep on its left recursed that deep, past the 8 MB C
  ;;; stack of GitHub's Apple silicon Mac (6 MB here). -2 is no memory.
  ;;; `M:G' is G, and an M that is neither an atom nor a variable answers 2
  ;;; with M in MOD (3.19.2, swipl's; through 3.19.1 `M:G' was a goal). FV
  ;;; is set where a variable stands for a goal or a module (3.19.3), and
  ;;; the clause is then asked by `coco_fresh_fault'.
  (static)
  (func coco_body_callable ((coco_machine * m) (size_t b) (size_t * budget) (size_t * mod) (int * fv))
        (out int)
        (let ((size_t * wl . nil) (size_t wlen . 0) (size_t wcap . 0) (int r . 1))
          (while 1
            (set b (coco_deref m b))
            (if (coco-tag-is REF (nth b (-> m heap))) (set (cof fv) 1))
            (if (not (coco-tag-is REF (nth b (-> m heap))))
                (let ((u64 nid . 0) (u32 n . 0))
                  (if (or (not (coco_is_callable m b)) (coco_is_nil m b)) (block (set r 0) break))
                  (set nid (coco_name_of m b))
                  (set n (coco_arity m b))
                  (if (== (cof budget) 0) (block (set r -1) break))
                  (set (cof budget) (- (cof budget) 1))
                  ;; `$(G)' and G@M are control too (3.20.0), G@M's module
                  ;; asked before its goal, as M:G's is
                  (if (and (== n 1) (or (== nid (coco-id m "\\+")) (== nid (coco-id m "$"))))
                      (block (set b (coco_arg m b 0)) continue))
                  (if (and (== n 2) (or (== nid (coco-id m ":")) (== nid (coco-id m "@"))))
                      (let ((int at . #'(== nid (coco-id m "@"))) (size_t q . 0))
                        (set q (coco_deref m (coco_arg m b (? at 1 0))))
                        (if (coco-tag-is REF (nth q (-> m heap))) (set (cof fv) 1))
                        (if (not (or (coco-tag-is REF (nth q (-> m heap)))
                                     (and (coco-tag-is ATOM (nth q (-> m heap))) (not (coco_is_nil m q)))))
                            (block (set (cof mod) q) (set r 2) break))
                        (set b (coco_arg m b (? at 0 1)))
                        continue))
                  (if (and (== n 2) (or (or (== nid (coco-id m ",")) (== nid (coco-id m ";")))
                                          (or (== nid (coco-id m "->")) (== nid (coco-id m "*->")))
                                          (== nid (coco-id m "|"))))
                      (block
                       (if (not (coco_cells_push (aof wl) (aof wlen) (aof wcap) (coco_arg m b 1)))
                           (block (set r -2) break))
                       (set b (coco_arg m b 0))
                       continue))))
            ;; a goal, or a variable: the next arm that waits
            (if (== wlen 0) break)
            (set wlen (- wlen 1))
            (set b (nth wlen wl)))
          (free wl)
          (return r)))

  ;;; `representation_error(cyclic_term)', what SWI's assert raises over a
  ;;; cyclic clause (1.10.19)
  (static)
  (func coco_cyclic_error ((coco_engine * e)) (out int)
        (return (coco_raise e (coco_make1 (-> e m) "representation_error"
                                          (coco_new_atom (-> e m) "cyclic_term")))))

  ;;; WHAT assert AND retract REFUSE, as SWI does: a clause or a head that is
  ;;; unbound is an instantiation error, a head that is not callable a type
  ;;; error, a head no clause can define (`coco_static_pred') a permission
  ;;; error, and -- asserting -- a body that is not goals a type error naming
  ;;; the whole body. Through 1.10.5 the first three made assert and retract
  ;;; FAIL, and `assertz((foo :- 3))' stored the clause. Answers 0 when the
  ;;; clause may go on, else what the raise answered.
  ;;; THE QUALIFIERS ON TOP OF A CLAUSE OR A HEAD, taken off as swipl's
  ;;; strip_module does (3.19.2, the load's `coco_consult_unqualify'):
  ;;; T left on what they qualify, and 0; else what the raise answered --
  ;;; type_error(module, M) for a module that is no atom, which
  ;;; `coco_type_error' makes an instantiation error for a variable, and
  ;;; for a cycle of them (`X = foo:X') type_error(acyclic_term, X), swipl's
  (static)
  (func coco_clause_unqualify ((coco_engine * e) (size_t * t)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (size_t steps . 0))
          (set (cof t) (coco_deref m (cof t)))
          (while (and (coco-tag-is FUN (nth (cof t) (-> m heap)))
                      (and (== (coco_arity m (cof t)) 2) (== (coco_name_of m (cof t)) (coco-id m ":"))))
            (let ((size_t q . #'(coco_deref m (coco_arg m (cof t) 0))))
              (if (not (and (coco-tag-is ATOM (nth q (-> m heap))) (not (coco_is_nil m q))))
                  (return (coco_type_error e "module" q)))
              (set steps (+ steps 1))
              (if (and (== steps 4096) (!= 1 (coco_acyclic m (cof t))))
                  (return (coco_type_error e "acyclic_term" (cof t))))
              (set (cof t) (coco_deref m (coco_arg m (cof t) 1)))))
          (return 0)))

  ;;; A BODY'S REFUSAL AT AN ASSERT, as at a load (3.19.2,
  ;;; `coco_consult_body_refused'): the qualifiers on its top taken off,
  ;;; the rest walked, a goal that is no goal naming what was left and a
  ;;; module that is no atom itself; under a variable module on top a body
  ;;; that will not do is an instantiation error. 0, or what the raise
  ;;; answered. A variable where a goal or a module stands (3.19.3) has
  ;;; the clause asked as at a load, head HEAD and all (`coco_fresh_fault').
  (static)
  (func coco_body_check ((coco_engine * e) (size_t head) (size_t body)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (size_t mod . 0) (size_t budget . 4096)
              (size_t steps . 0) (int qv . 0) (int bc . 0) (int fv . 0) (size_t b0 . body))
          (set body (coco_deref m body))
          (while (and (coco-tag-is FUN (nth body (-> m heap)))
                      (and (== (coco_arity m body) 2) (== (coco_name_of m body) (coco-id m ":"))))
            (let ((size_t q . #'(coco_deref m (coco_arg m body 0))))
              (if (coco-tag-is REF (nth q (-> m heap)))
                  (block (set qv 1) (set fv 1) (set body (coco_arg m body 1)) break))
              (if (not (and (coco-tag-is ATOM (nth q (-> m heap))) (not (coco_is_nil m q))))
                  (return (coco_type_error e "module" q)))
              (set steps (+ steps 1))
              (if (and (== steps 4096) (!= 1 (coco_acyclic m body)))
                  (return (coco_cyclic_error e)))
              (set body (coco_deref m (coco_arg m body 1)))))
          ;; 4096 control terms: a body past that is asked whether it is
          ;; cyclic, and walked again with no budget when it is not
          (set bc (coco_body_callable m body (aof budget) (aof mod) (aof fv)))
          (if (== bc -1)
              (block
               (if (!= 1 (coco_acyclic m body)) (return (coco_cyclic_error e)))
               (set budget (cast size_t -1))
               (set bc (coco_body_callable m body (aof budget) (aof mod) (aof fv)))))
          (if (== bc -2) (return (coco_mem_error e)))
          (if fv
              ;; the names the consult interns, from the machine's table
              ;; (`:-' and `=>', which the walk asks nothing of, none)
              (let ((u64 ids [13]) (size_t q . 0) (int f . 0))
                (set (nth 11 ids) (coco-id m "$"))
                (set (nth 12 ids) (coco-id m "@"))
                (set (nth 0 ids) (coco-id m ","))
                (set (nth 1 ids) (coco-id m ";"))
                (set (nth 2 ids) (coco-id m "->"))
                (set (nth 3 ids) (coco-id m "*->"))
                (set (nth 4 ids) (coco-id m "\\+"))
                (set (nth 5 ids) 0)
                (set (nth 6 ids) (coco-id m "|"))
                (set (nth 7 ids) (coco-id m ":"))
                (set (nth 8 ids) 0)
                (set (nth 9 ids) (coco-id m "=="))
                (set (nth 10 ids) (coco-id m "\\=="))
                (set f (coco_fresh_fault m head b0 ids (aof q)))
                (if (== f 0) (return 0))
                (if (== f 2) (return (coco_instantiation_error e)))
                (if (== f 4) (return (coco_type_error e "module" q)))
                (if (== f 1)
                    (return (? qv (coco_instantiation_error e)
                               (coco_type_error e "callable" (coco_deref m body)))))))
          (if (== bc 2) (return (coco_type_error e "module" mod)))
          (if (== bc 0)
              (return (? qv (coco_instantiation_error e)
                         (coco_type_error e "callable" (coco_deref m body)))))
          (return 0)))

  (static)
  (func coco_clause_check ((coco_engine * e) (size_t c) (int asserting)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t head) (size_t body . 0) (int rule . 0) (int bad . 0))
          (set c (coco_deref m c))
          (if (coco-tag-is REF (nth c (-> m heap))) (return (coco_instantiation_error e)))
          ;; THE CLAUSE'S QUALIFIERS AND THE HEAD'S ARE TAKEN OFF (3.19.2,
          ;; swipl's): `assertz(foo:7)' is type_error(callable, 7), where it
          ;; failed, and `assertz(3:foo)' type_error(module, 3), where it
          ;; went in
          (set bad (coco_clause_unqualify e (aof c)))
          (if (!= bad 0) (return bad))
          (if (coco-tag-is REF (nth c (-> m heap))) (return (coco_instantiation_error e)))
          (set head c)
          (if (and (coco-tag-is FUN (nth c (-> m heap))) (== (coco_arity m c) 2))
              (if (or (== (coco_name_of m c) (coco-id m ":-"))
                      ;; a single-sided rule's head and body too (3.19.0):
                      ;; `(H, G) => B' is a clause of `,'/2 to swipl's assert
                      (== 0 (strcmp (coco_atom_name m (coco_name_of m c)) "=>")))
                  (block (set head (coco_deref m (coco_arg m c 0)))
                         (set body (coco_arg m c 1))
                         (set rule 1))))
          (set bad (coco_clause_unqualify e (aof head)))
          (if (!= bad 0) (return bad))
          (if (coco-tag-is REF (nth head (-> m heap))) (return (coco_instantiation_error e)))
          (if (not (coco_is_callable m head)) (return (coco_type_error e "callable" head)))
          (if (coco_static_pred m (coco_name_of m head) (coco_arity m head))
              (return (coco_permission_error e "modify" "static_procedure"
                                             (coco_indicator m (coco_name_of m head)
                                                             (coco_arity m head)))))
          (if (and asserting rule) (return (coco_body_check e head body)))
          (return 0)))

  (static)
  (func coco_assert_goal ((coco_engine * e) (size_t g) (int at_end)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t c . #'(coco_deref m (coco_arg m g 0)))
              (size_t head)
              (int bad . #'(coco_clause_check e c 1)))
          (if (!= bad 0) (return bad))
          (set head c)
          ;; a rule marks the predicate its HEAD names, not `:-'/2
          (if (and (coco_is_callable m c) (== (coco_arity m c) 2))
              (if (== 0 (strcmp (coco_atom_name m (coco_name_of m c)) ":-"))
                  (set head (coco_deref m (coco_arg m c 0)))))
          ;; A REFUSAL THE STORE CAN EXPLAIN IS AN EXCEPTION, not a failure.
          ;; `coco_assert' runs below the engine and has no ball to throw, so
          ;; it leaves a sentence behind instead -- today, a clause too long
          ;; for a row. `resource_error/1' is ISO's shape and catchable, which
          ;; is the whole point: the alternative was a commit that took every
          ;; other clause of the transaction with it. A cyclic clause is told
          ;; by the count of cycles put moving (`coco_assert_from').
          (with-green-write e
            (let ((size_t cp . #'(-> m cyc_puts)))
              (if (not (coco_assert (-> e st) m c at_end))
                  (block
                   (if (!= cp (-> m cyc_puts)) (return (coco_cyclic_error e)))
                   ;; the predicate could not be read first, and a write over
                   ;; what was read would have rewritten it without the rest
                   ;; (2.11.1): `coco_assert_from' left the reason
                   (if (!= (nth 0 ($ (cof (-> e st)) fetch_err)) (cast char 0))
                       (return (coco_fetch_error e)))
                   (if (!= (nth 0 ($ (cof (-> e st)) assert_err)) (cast char 0))
                       (return (coco_raise e (coco_make1 m "resource_error"
                                                         (coco_new_atom m "clause_length")))))
                   (return 0))))
            (if (coco_is_callable m head)
                (coco_pred_dynamic (-> e st) (coco_name_of m head) (coco_arity m head)))
            (coco_store_maybe_compact (-> e st) m)
            (return 1))))

  (func coco_bi_asserta ((coco_engine * e) (size_t g)) (out int)
        (return (coco_assert_goal e g 0)))

  (func coco_bi_assertz ((coco_engine * e) (size_t g)) (out int)
        (return (coco_assert_goal e g 1)))

  (decl) (func coco_retractall_none ((coco_engine * e) (size_t g)) (out int))

  (func coco_bi_retract ((coco_engine * e) (size_t g)) (out int)
        (let ((int bad . #'(coco_clause_check e (coco_arg (-> e m) g 0) 0)))
          (if (!= bad 0) (return bad)))
        (with-green-write e
          (let ((int ok . #'(coco_retract (-> e st) (-> e m) (coco_arg (-> e m) g 0))))
            ;; -1: the predicate could not be read, and nothing was taken
            (if (< ok 0) (return (coco_fetch_error e)))
            (coco_store_maybe_compact (-> e st) (-> e m))
            (if ok (return 1))))
        (if (== 0 (strcmp (coco_atom_name (-> e m) (coco_name_of (-> e m) g)) "$retractall"))
            (return (coco_retractall_none e g)))
        (return 0))

  ;;; ---- the system's predicates (3.37.0, 3.38.0) ---------------------------
  ;;;
  ;;; What listing/1 writes as the system's, `%   Foreign: system:N/A', and
  ;;; clause/2 refuses to show, permission_error(access, private_procedure,
  ;;; N/A) (`coco_db_private').

  ;;; A PREDICATE OF THE SYSTEM'S: a construct, a row of the engine or of a
  ;;; compiled-in module, as current_predicate/1 named whole answers
  ;;; (`coco_pred_current''s first question)
  (static)
  (func coco_listing_sys ((coco_machine * m) (u64 nid) (u32 n)) (out int)
        (return (or (>= (coco_builtin_index m nid n) 0)
                    (and (!= coco_claims_hook nil)
                         (coco_claims_hook (coco_atom_name m nid) n)))))

  ;;; A SYSTEM PREDICATE AS SWIPL LISTS ONE, `%   Foreign: system:N/A': what
  ;;; cocolog writes in C, and what its library writes as clauses where
  ;;; swipl defines it in C (lib/swipl-det.cicili's *swipl-foreign*:
  ;;; between/3, atom_concat/3, sub_atom/5), where the store holds them
  (static)
  (func coco_listing_sysdef ((coco_machine * m) (coco_store * st) (u64 nid) (u32 n)) (out int)
        (if (coco_listing_sys m nid n) (return 1))
        (if (not (coco_det_foreign_name (coco_atom_name m nid) n)) (return 0))
        (let ((size_t pi . #'(coco_pred_find st nid n)))
          (return (and (< pi (-> st npreds)) ($ (nth pi (-> st preds)) library)
                       (> (coco_pred_live (aof (nth pi (-> st preds)))) 0)))))

  ;;; WHETHER THE STORE'S PREDICATE PI IS ONE A LISTING FINDS: a live clause,
  ;;; or a dynamic, discontiguous or multifile declaration, as swipl's
  ;;; current_predicate/2 has it -- 1, or 2 for a library's that is the
  ;;; system's (`coco_listing_sysdef': nb_current/2's clause beside its C,
  ;;; between/3's), which is listed as the system's alone
  (static)
  (func coco_listing_found ((coco_machine * m) (coco_store * st) (size_t pi)) (out int)
        (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
          (if (not (or (> (coco_pred_live p) 0) (or (-> p dynamic) (-> p declared))))
              (return 0))
          (if (and (-> p library) (not (-> p own)))
              (return (? (coco_listing_sysdef m st (-> p name) (-> p arity)) 2 1)))
          (return 1)))

  ;;; ---- retract/1 and clause/2 (3.28.0, swipl's) --------------------------
  ;;;
  ;;; A WALK OF THE CLAUSES THAT STOOD WHEN THE CALL BEGAN, as swipl's
  ;;; pl_retract and clause/2 walk them: the predicate's candidates keyed as
  ;;; a call of it is (`coco_trace_kpos': its first argument, or the one
  ;;; swipl's JIT index would take), each copied from the store and its head
  ;;; and body unified with the goal's, and retract/1 takes the one that
  ;;; matched out (`coco_retract_at'). A second candidate keeps a DB frame
  ;;; to come back to -- a clause frame's view of the predicate, `cend' and
  ;;; `fera' kept by `coco_frames_on' as any open call's -- so an answer
  ;;; asserted since is none of the walk's, one retracted since is still an
  ;;; answer (retract/1's then takes nothing: swipl's retry succeeds on a
  ;;; clause erased since), and the last candidate leaves no frame. Through
  ;;; 3.27.0 retract/1 was a builtin that took its first match and left no
  ;;; choice point, and clause/2 read the clauses by their place among the
  ;;; live ones (`'$clause'/3' over between/3), so a change made while it
  ;;; walked moved the walk.

  ;;; T with its module qualifiers taken off (one namespace: `user:q(X)' is
  ;;; q(X), as is any other)
  (static)
  (func coco_db_unq ((coco_machine * m) (size_t t)) (out size_t)
        (set t (coco_deref m t))
        (while (and (coco-tag-is FUN (nth t (-> m heap))) (== (coco_arity m t) 2)
                    (== (coco_name_of m t) (coco-id m ":")))
          (set t (coco_deref m (coco_arg m t 1))))
        (return t))

  ;;; CLAUSE/2'S HEAD with its qualifiers taken off as swipl's
  ;;; PL_strip_module() takes them (3.38.0): an atom's alone, so `M:p(X)'
  ;;; with M unbound -- or `f(x):p', or `[]:p', the list's end being no
  ;;; atom -- stays a head of (:)/2, which has no clause, where through
  ;;; 3.37.0 any qualifier came off and p/1's clauses answered. SYSQ says
  ;;; whether the innermost was `system': the system's definition alone
  ;;; (`system:msort(_, _)').
  (static)
  (func coco_db_unq_atoms ((coco_machine * m) (size_t t) (int * sysq)) (out size_t)
        (set t (coco_deref m t))
        (while (coco_is_compound2 m t ":")
          (let ((size_t q . #'(coco_deref m (coco_arg m t 0))))
            (if (or (not (coco-tag-is ATOM (nth q (-> m heap)))) (coco_is_nil m q)) break)
            (set (cof sysq) (== (coco_name_of m q) (coco_intern m "system")))
            (set t (coco_deref m (coco_arg m t 1)))))
        (return t))

  ;;; WHAT clause/2 OF NAME NID AND ARITY N, the store's predicate PI, MAY
  ;;; SHOW (3.38.0, swipl's pl-proc.c: a predicate written in C is
  ;;; permission_error(access, private_procedure, N/A)): 1 none, a predicate
  ;;; of the system's as listing/1 writes one, `%   Foreign:' -- what
  ;;; cocolog writes in C, and a library's clauses where swipl writes it in
  ;;; C (between/3, sub_atom/5) -- unless the program defines the name
  ;;; itself (msort/2 a file took over, the facts library(reasoning) asserts
  ;;; under number/1's); 2 nothing at all, a name of no system predicate
  ;;; under `system:' (SYSQ); 0 the store's clauses
  (static)
  (func coco_db_private ((coco_machine * m) (coco_store * st) (u64 nid) (u32 n) (size_t pi)
                         (int sysq)) (out int)
        (if sysq (return (? (coco_listing_sysdef m st nid n) 1 2)))
        (let ((int found . #'(? (< pi (-> st npreds)) (coco_listing_found m st pi) 0)))
          (return (or (== found 2) (and (== found 0) (coco_listing_sys m nid n))))))

  ;;; G's head and body, MODE 1 retract(C)'s and 0 clause(H, B)'s: C's `H :-
  ;;; B', or C and 0 for `true' (a fact), and a `H => B' says SSU; clause/2's
  ;;; `f()' is the atom f, whose clauses the store keeps (3.12.0), and its
  ;;; head's qualifiers swipl's (`coco_db_unq_atoms', SYSQ)
  (static)
  (func coco_db_parts ((coco_machine * m) (size_t g) (int mode) (size_t * hp) (size_t * bp)
                       (int * ssu) (int * sysq))
        (let ((size_t h . 0) (size_t bd . 0))
          (set (cof ssu) 0)
          (set (cof sysq) 0)
          (if (== mode 1)
              (let ((size_t c . #'(coco_db_unq m (coco_arg m g 0))))
                (set h c)
                (if (and (coco-tag-is FUN (nth c (-> m heap))) (== (coco_arity m c) 2))
                    (if (== (coco_name_of m c) (coco-id m ":-"))
                        (block (set h (coco_arg m c 0)) (set bd (coco_arg m c 1)))
                        (if (== 0 (strcmp (coco_atom_name m (coco_name_of m c)) "=>"))
                            (block (set h (coco_arg m c 0)) (set bd (coco_arg m c 1))
                                   (set (cof ssu) 1))))))
              (block (set h (coco_arg m g 0)) (set bd (coco_arg m g 1))))
          (set h (? (== mode 1) (coco_db_unq m h) (coco_db_unq_atoms m h sysq)))
          (if (and (== mode 0) (coco-tag-is FUN (nth h (-> m heap))) (== (coco_arity m h) 0))
              (set h (coco_new_atom m (coco_atom_name m (coco_name_of m h)))))
          (set (cof hp) h)
          (set (cof bp) bd)))

  ;;; CLAUSE IX OF P TRIED: copied from the store, its head unified with H
  ;;; and its body with B (0, a fact's `true'). A single-sided rule and the
  ;;; predicate's last clause are no candidate of retract/1's -- swipl
  ;;; 9.0.4's matches none, with any pattern -- and clause/2 shows a rule as
  ;;; swipl's does (`coco_ssu_body'). 1 matched, SPAN its cells in the
  ;;; store; 0 with the machine back at the marks it came in with.
  (static)
  (func coco_db_try ((coco_engine * e) (coco_pred * p) (size_t ix) (int mode)
                     (size_t h) (size_t b) (size_t * span)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t mark . #'(-> (-> e m) heap_len))
              (size_t tmark . #'(-> (-> e m) trail_len))
              (size_t cand . 0) (size_t ch . 0) (size_t cb . 0))
          (set cand (coco_store_get_span m st (nth ix (-> p clauses)) span))
          (coco_clause_parts m cand (aof ch) (aof cb))
          (if (!= cb 0)
              (if (== mode 1)
                  (block
                   (if (or (coco_ssu_clause m cand)
                           (coco_is_compound2 m (coco_deref m cb) "$ssu_none"))
                       (block (set (-> m heap_len) mark) (return 0))))
                  (let ((size_t sb . #'(coco_ssu_body m cb)))
                    (if (== sb (cast size_t -1))
                        (block (set (-> m heap_len) mark) (return 0)))
                    (set cb sb))))
          (if (== cb 0) (set cb (coco_new_atom m "true")))
          (if (== b 0) (set b (coco_new_atom m "true")))
          (if (and (coco_unify m h ch) (coco_unify m b cb)) (return 1))
          (coco_undo_to m tmark)
          (set (-> m heap_len) mark)
          (return 0)))

  ;;; THE NEXT CANDIDATE FROM FROM ON, short of CEND: a dead clause tried
  ;;; only where the walk lived through its death (`coco_frame_next', which
  ;;; reads the dead, and a predicate with none has no array of them)
  (static)
  (func coco_db_next ((coco_store * st) (coco_machine * m) (coco_pred * p) (u32 kpos)
                      (u64 key) (size_t from) (u32 cend) (u32 fera)) (out size_t)
        (if (!= (-> p ntomb) 0) (return (coco_frame_next st m p kpos key from cend fera)))
        (return (? (== kpos 0) (coco_pred_next_clause st p key from)
                   (coco_pred_next_at st m p kpos key from))))

  ;;; THE CANDIDATES OF PI FROM IX ON, short of CEND and keyed on argument
  ;;; KPOS (KEY), the walk's DB frame at CI where FR says it has one: the
  ;;; first that matches is the answer -- the frame on to the next, or gone
  ;;; at the last, so no choice point is left -- and retract/1's takes it out
  ;;; where it still stands, after the frame is gone. 1 an answer; 0 none,
  ;;; the frame gone.
  (static)
  (func coco_db_from ((coco_engine * e) (size_t pi) (u32 kpos) (u64 key) (size_t ix) (u32 cend)
                      (int mode) (size_t h) (size_t bd) (int fr) (size_t ci)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t span . 0) (size_t nx . 0) (u32 fera . 0))
          (if fr (set fera ($ (nth ci (-> e choices)) fera)))
          (while (< ix (cast size_t cend))
            (let ((coco_pred * p . #'(aof (nth pi (-> st preds)))))
              (set nx (coco_db_next st m p kpos key (+ ix 1) cend fera))
              (if fr (set ($ (nth ci (-> e choices)) clause_ix) (+ ix 1)))
              (if (coco_db_try e p ix mode h bd (aof span))
                  (block
                   (if (and fr (>= nx (cast size_t cend))) (set (-> e nchoices) ci))
                   ;; one retracted since the walk began is an answer, and
                   ;; taken already
                   (if (and (== mode 1) (not (coco_pred_dead p ix)))
                       (with-green-write e
                         (coco_retract_at st m pi ix span)
                         (coco_store_maybe_compact st m)))
                   (return 1)))
              (set ix nx)))
          (if fr (set (-> e nchoices) ci))
          (return 0)))

  ;;; A RAISE'S ANSWER RC as a construct answers it: 1 where a catch took
  ;;; the ball and the continuation is its recovery
  (static)
  (func coco_db_raised ((int rc) (int * ret)) (out int)
        (if (== rc 2) (return 1))
        (set (cof ret) rc)
        (return 2))

  ;;; THE CALL, `retract(C)' (MODE 1) or `clause(H, B)' (0), its ports a
  ;;; traced builtin's (none where the printer hides the call, PRINTR 2 on
  ;;; its frame, 3.27.0) and its errors named by its own row (`kcall', the
  ;;; goal in flight): retract/1's as through 3.27.0 (`coco_clause_check'),
  ;;; clause/2's an unbound head's instantiation_error, type_error(callable,
  ;;; H) and, of a predicate written in C, permission_error(access,
  ;;; private_procedure, N/A) (3.38.0, `coco_db_private'). One step and one
  ;;; inference, as the builtin was. Answers as `coco_construct' does.
  (weak) (cold)
  (func coco_db_walk ((coco_engine * e) (size_t g) (int mode) (size_t k) (size_t b)
                      (int * ok) (int * ret)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t h . 0) (size_t bd . 0) (int ssu . 0) (int sysq . 0) (int pv . 0)
              (int rc . 0) (int r . 0) (int tport . 0) (int td . 0))
          (set (-> e kcall) g)
          (if (-> e trace)
              (block (set td (+ (-> e trace_depth) 1))
                     (set tport (? (coco_trace_hidden e g 1) 2 1))
                     (if (== tport 1) (coco_trace_port e "Call" td g))))
          (if (== mode 1)
              (set rc (coco_clause_check e (coco_arg m g 0) 0))
              (let ((size_t h0 . #'(coco_db_unq_atoms m (coco_arg m g 0) (aof sysq))))
                (if (not (coco_is_callable m h0)) (set rc (coco_type_error e "callable" h0)))))
          (if (!= rc 0) (return (coco_db_raised rc ret)))
          (coco_db_parts m g mode (aof h) (aof bd) (aof ssu) (aof sysq))
          (let ((size_t pi . #'(coco_pred_intern st (coco_name_of m h) (coco_arity m h))))
            (if (and (not ssu) (< pi (-> st npreds)))
                (block
                 ;; a predicate the knowledge base could not hand over raises,
                 ;; as its call does (2.11.1)
                 (if (not (coco_pred_ensure st pi)) (return (coco_db_raised (coco_fetch_error e) ret)))
                 ;; CLAUSE/2 OF A PREDICATE WRITTEN IN C raises, as swipl's
                 ;; (3.38.0; through 3.37.0 it failed, and showed the
                 ;; clauses cocolog's library writes for between/3), and
                 ;; under `system:' nothing else is the system's
                 (if (== mode 0)
                     (set pv (coco_db_private m st (coco_name_of m h) (coco_arity m h) pi sysq)))
                 (if (== pv 1)
                     (return (coco_db_raised
                              (coco_permission_error e "access" "private_procedure"
                                                     (coco_indicator m (coco_name_of m h)
                                                                     (coco_arity m h)))
                              ret)))
                 ;; THE DEAD GO FIRST where no frame is open on them, as
                 ;; clause/2's '$pred_count'/3 took them through 3.27.0: a
                 ;; retract under a walk's own frame leaves its clause
                 ;; dead in place, and a drain by once(retract(q(_))) left
                 ;; with none swept counted nothing dead and never
                 ;; compacted the store (test/gc.pl), though it was 38 %
                 ;; faster
                 (if (!= ($ (nth pi (-> st preds)) ntomb) 0) (coco_tomb_try_sweep st m pi))
                 (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
                       ;; none to walk where the system's is no store's
                       (u32 cend . #'(? (== pv 2) 0 (cast u32 ($ (nth pi (-> st preds)) nclauses))))
                       (u32 kpos . 0) (u64 key . 0) (size_t ix . 0) (int fr . 0) (size_t ci . 0))
                   (if (> cend 0)
                       (block
                        (set kpos (coco_trace_kpos e p h))
                        (set key (? (== kpos 0) (coco_arg_key m h) (coco_call_arg_key m h kpos)))
                        (set ix (coco_db_next st m p kpos key 0 cend 0))
                        ;; a second candidate: a frame to come back to, at the
                        ;; machine's marks before anything is tried
                        (if (and (< ix (cast size_t cend))
                                 (< (coco_db_next st m p kpos key (+ ix 1) cend 0) (cast size_t cend)))
                            (block
                             (if (not (coco_push_choice e COCO_CH_DB g k b))
                                 (block (set (cof ret) (coco_fail_err e "out of memory")) (return 2)))
                             (set ci (- (-> e nchoices) 1))
                             (set fr 1)
                             (set ($ (nth ci (-> e choices)) pred) pi)
                             (set ($ (nth ci (-> e choices)) cend) cend)
                             (set ($ (nth ci (-> e choices)) ixpos) kpos)
                             (set ($ (nth ci (-> e choices)) clause_ix) ix)
                             (set ($ (nth ci (-> e tchoices)) printr) tport)
                             (set ($ (nth pi (-> st preds)) framed) 1)))
                        (set r (coco_db_from e pi kpos key ix cend mode h bd fr ci))))))))
          (if (== tport 1) (coco_trace_port e (? r "Exit" "Fail") td g))
          (if r (set (-> e goals) k) (set (cof ok) 0))
          (return 1)))

  ;;; THE WALK'S DB FRAME AT CI RETRIED, the machine at its marks: on from
  ;;; the next candidate, its Redo first, where the printer would show it --
  ;;; the call's own, or the region's it is hidden in (`coco_trace_goal_own',
  ;;; as a `;' of a library's clause is), and the call's context again. 1
  ;;; with the continuation set, 0 with the frame gone.
  (weak) (cold)
  (func coco_db_retry ((coco_engine * e) (size_t ci)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t g . #'($ (nth ci (-> e choices)) call))
              (size_t k . #'($ (nth ci (-> e choices)) goals))
              (size_t pi . #'($ (nth ci (-> e choices)) pred))
              (u32 kpos . #'($ (nth ci (-> e choices)) ixpos))
              (u32 cend . #'($ (nth ci (-> e choices)) cend))
              (size_t ix . #'($ (nth ci (-> e choices)) clause_ix))
              (int mode . #'(? (== (coco_name_of (-> e m) g) (coco-id (-> e m) "retract")) 1 0))
              (size_t h . 0) (size_t bd . 0) (int ssu . 0) (int sysq . 0) (int r . 0)
              (int tport . 0) (int td . 0) (u64 key . 0))
          (if (-> e trace)
              (let ((coco_tchoice * tc . #'(aof (nth ci (-> e tchoices)))))
                (set tport (-> tc printr))
                (set td (+ (-> tc depth) 1))
                (set (-> e trace_goal) (-> tc goal))
                (set (-> e trace_depth) (-> tc depth))
                (if (== tport 1)
                    (block (coco_trace_port e "Redo" td g)
                           (coco_trace_reopen e ci td)))
                (if (== tport 2) (coco_trace_goal_own e ci))))
          (coco_db_parts m g mode (aof h) (aof bd) (aof ssu) (aof sysq))
          (set key (? (== kpos 0) (coco_arg_key m h) (coco_call_arg_key m h kpos)))
          (set r (coco_db_from e pi kpos key ix cend mode h bd 1 ci))
          (if (== tport 1) (coco_trace_port e (? r "Exit" "Fail") td g))
          (if r (set (-> e goals) k))
          (return r)))

  ;;; A PART OF A DECLARATION'S SPEC THAT IS NONE (3.1.0): FORMAL raised as
  ;;; swipl 9.0.4 raises it, NAME/ARITY the frame its raise names
  ;;; (compound_name_arity/3 for an indicator's parts,
  ;;; '$set_predicate_attribute'/3 for an ISO predicate), NAME nil for no
  ;;; context at all. The raise's answer.
  (static)
  (func coco_decl_bad ((coco_engine * e) (size_t formal) (const char * name) (u32 arity)) (out int)
        (if (== name nil) (return (coco_raise e formal)))
        (return (coco_raise_named e formal "system" name arity)))

  ;;; ONE INDICATOR THE WALK DECLARES, through the green world's write
  ;;; barrier: 1, or memory's error, or a backend that refused it
  ;;; resource_error(knowledge_base) in the context KIND/1 with the
  ;;; backend's sentence (3.0.3's).
  (static)
  (func coco_decl_put ((coco_engine * e) (int kind) (u64 nid) (u32 n)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (coco_store * st . #'(-> e st)) (int ok . 1))
          (with-green-write e
            (set (nth 0 (-> st write_err)) (cast char 0))
            (set ok (coco_decl_pi st m nid n kind)))
          (if (== ok 1) (return 1))
          (if (== ok 0) (return (coco_mem_error e)))
          (return (coco_raise_ctx e (coco_make1 m "resource_error" (coco_new_atom m "knowledge_base"))
                                  (coco_ectx_pi m "system" (coco_new_atom m (coco_decl_kind kind)) 1
                                                (coco_new_atom m (-> st write_err)))))))

  ;;; RETRACTALL/1 OF A PREDICATE WITH NO CLAUSES DECLARES IT DYNAMIC
  ;;; (3.15.0), as swipl's: after `retractall(p(_))' p/1 is a dynamic
  ;;; predicate, which current_predicate/1 answers, predicate_property/2
  ;;; calls dynamic and whose clauses are kept as written
  ;;; (`coco_assert_from'). Asked where `'$retractall'' took nothing, of
  ;;; G's head: never a name the engine or a compiled-in module implements,
  ;;; where swipl raises (cocolog keeps facts under such names,
  ;;; `number(dos)'), nor a predicate with clauses, which a retract made
  ;;; dynamic already or swipl refuses. 0, the goal's answer, or a raise's.
  (func coco_retractall_none ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t h . #'(coco_deref m (coco_arg m g 0)))
              (size_t pi . 0) (int rc . 0))
          (if (and (coco_is_callable m h)
                   (and (== (coco_arity m h) 2) (== 0 (strcmp (coco_atom_name m (coco_name_of m h)) ":-"))))
              (set h (coco_deref m (coco_arg m h 0))))
          (while (and (coco_is_callable m h)
                      (and (== (coco_arity m h) 2) (== 0 (strcmp (coco_atom_name m (coco_name_of m h)) ":"))))
            (set h (coco_deref m (coco_arg m h 1))))
          (if (not (coco_is_callable m h)) (return 0))
          (if (!= (coco_claim_kind m (coco_name_of m h) (coco_arity m h)) 0) (return 0))
          (set pi (coco_pred_find st (coco_name_of m h) (coco_arity m h)))
          (if (< pi (-> st npreds))
              (if (or ($ (nth pi (-> st preds)) dynamic)
                      (> (coco_pred_live (aof (nth pi (-> st preds)))) 0))
                  (return 0)))
          (set rc (coco_decl_put e 0 (coco_name_of m h) (coco_arity m h)))
          (return (? (== rc 1) 0 rc))))

  ;;; A GRAMMAR RULE'S ARITY, `A + 2' evaluated as swipl's '$pi_head'/2
  ;;; evaluates it: is/2's own errors, named by that frame (the goal in
  ;;; flight is made '$pi_head'(Spec, _) for the evaluation), and a value
  ;;; that is no integer type_error(integer, V) from compound_name_arity/3.
  ;;; 1 with the arity in OUT, or the raise's answer.
  (static)
  (func coco_decl_dcg_arity ((coco_engine * e) (size_t spec) (size_t ar) (i64 * out)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t was . #'(-> e kcall))
              (int isf . 0) (i64 iv . 0) (double fv . 0.0) (int rc . 0) (size_t v . 0))
          (set (-> e kcall) (coco_make2 m "$pi_head" spec (coco_new_var m)))
          (set rc (coco_arith e (coco_make2 m "+" ar (coco_new_int m 2)) (aof isf) (aof iv) (aof fv) 0))
          (if (== rc 3) (set rc (coco_type_error e "expression" ar)))
          (set (-> e kcall) was)
          (if (!= rc 1) (return rc))
          (if (== isf 0) (block (set (cof out) iv) (return 1)))
          (set v (? (== isf 2) (coco_new_rat m (-> m arith_n) (-> m arith_d)) (coco_new_float m fv)))
          (return (coco_decl_bad e (coco_make2 m "type_error" (coco_new_atom m "integer") v)
                                 "compound_name_arity" 3))))

  ;;; WHETHER NID/N HAS CLAUSES AND IS NO thread_local/1 ONE YET (3.2.0),
  ;;; which thread_local/1 refuses: the clauses the process holds of it.
  (static)
  (func coco_decl_has_clauses ((coco_engine * e) (u64 nid) (u32 n)) (out int)
        (let ((coco_store * st . #'(-> e st))
              (size_t pi . #'(coco_pred_find (-> e st) nid n)))
          (if (>= pi (-> st npreds)) (return 0))
          (if (bitand ($ (nth pi (-> st preds)) pattrs) 8) (return 0))
          (return (> (coco_pred_live (aof (nth pi (-> st preds)))) 0))))

  ;;; A DECLARATION'S SPEC WALKED (3.1.0): dynamic/1's, discontiguous/1's
  ;;; and multifile/1's -- KIND 0, 1, 2 -- as swipl 9.0.4 walks it, a list
  ;;; or a conjunction part by part and `M:S' as S, each Name/Arity or
  ;;; Name//Arity checked and then declared IN TURN, so the parts before a
  ;;; bad one stay declared: `dynamic([a/1, b])' declares a/1 and raises
  ;;; for b, where through 3.0.4 the whole spec was checked first and
  ;;; nothing declared. A part that is none raises, in swipl's words and
  ;;; frames: a variable uninstantiation_error(Part), anything else that is
  ;;; no indicator type_error(predicate_indicator, Part), both with no
  ;;; context; a grammar rule's arity is evaluated first
  ;;; (`coco_decl_dcg_arity'); the name and the arity compound_name_arity/3's
  ;;; errors, or, for an arity of 0, the same errors with no context
  ;;; (swipl's '$head_name_arity'/3 raises those itself); an arity past
  ;;; 255, cocolog's ceiling, representation_error(max_arity); and one of
  ;;; swipl's ISO predicates (`*iso-predicates*', a control construct among
  ;;; them) permission_error(modify, static_procedure, Name/Arity) from
  ;;; '$set_predicate_attribute'/3, as swipl refuses to declare one. 1, or
  ;;; the raise's answer. A directive walks a spec that is not plain part by
  ;;; part through this, reporting each raise ('$decl_directive'/2).
  (func coco_decl_walk ((coco_engine * e) (size_t spec) (int kind)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (int r . 1))
          (set spec (coco_deref m spec))
          (if (coco-tag-is REF (nth spec (-> m heap)))
              (return (coco_decl_bad e (coco_make1 m "uninstantiation_error" spec) nil 0)))
          (if (or (coco_is_compound2 m spec ",") (coco_is_cons m spec))
              (block (set r (coco_decl_walk e (coco_arg m spec 0) kind))
                     (if (!= r 1) (return r))
                     (return (coco_decl_walk e (coco_arg m spec 1) kind))))
          (if (coco_is_nil m spec) (return 1))
          (if (coco_is_compound2 m spec ":")
              (return (coco_decl_walk e (coco_arg m spec 1) kind)))
          (if (and (not (coco_is_compound2 m spec "/")) (not (coco_is_compound2 m spec "//")))
              (return (coco_decl_bad e (coco_make2 m "type_error"
                                                   (coco_new_atom m "predicate_indicator") spec)
                                     nil 0)))
          (let ((size_t nm . #'(coco_deref m (coco_arg m spec 0)))
                (size_t ar . #'(coco_deref m (coco_arg m spec 1)))
                (int dcg . #'(coco_is_compound2 m spec "//"))
                (int known . 0)
                (i64 n . 0)
                (const char * where . "compound_name_arity"))
            ;; a grammar rule's arity, when it is given: evaluated first
            (if (and dcg (not (coco-tag-is REF (nth ar (-> m heap)))))
                (block
                  (set r (coco_decl_dcg_arity e spec ar (aof n)))
                  (if (!= r 1) (return r))
                  (set known 1)))
            (if (and (not known) (coco-is-int (nth ar (-> m heap))))
                (block (set n (coco_int_val m (nth ar (-> m heap)))) (set known 1)))
            ;; an arity of 0 names nothing but the name: no context
            (if (and known (== n 0)) (set where nil))
            (if (or (coco-tag-is REF (nth nm (-> m heap))) (coco-tag-is REF (nth ar (-> m heap))))
                (return (coco_decl_bad e (coco_new_atom m "instantiation_error") where 3)))
            (if (not (coco-tag-is ATOM (nth nm (-> m heap))))
                (return (coco_decl_bad e (coco_make2 m "type_error" (coco_new_atom m "atom") nm) where 3)))
            (if (not known)
                (return (coco_decl_bad e (coco_make2 m "type_error" (coco_new_atom m "integer") ar)
                                       "compound_name_arity" 3)))
            (if (< n 0)
                (return (coco_decl_bad e (coco_make2 m "domain_error" (coco_new_atom m "not_less_than_zero")
                                                     (coco_new_int m n))
                                       "compound_name_arity" 3)))
            (if (> n 255)
                (return (coco_decl_bad e (coco_make1 m "representation_error"
                                                     (coco_new_atom m "max_arity"))
                                       nil 0)))
            ;; and thread_local/1 of a predicate that has clauses and is
            ;; not thread_local already, as swipl refuses it (3.2.0)
            (if (or (coco_iso_predicate (coco_atom_name m (coco_name_of m nm)) (cast u32 n))
                    (and (== kind 6) (coco_decl_has_clauses e (coco_name_of m nm) (cast u32 n))))
                (let ((size_t args [3]))
                  (set (nth 0 args) (coco_new_atom m "modify"))
                  (set (nth 1 args) (coco_new_atom m "static_procedure"))
                  (set (nth 2 args) (coco_make2 m "/" nm (coco_new_int m n)))
                  (return (coco_decl_bad e (coco_make m "permission_error" 3 args)
                                         "$set_predicate_attribute" 3))))
            (return (coco_decl_put e kind (coco_name_of m nm) (cast u32 n))))))

  ;;; dynamic/1, discontiguous/1 and multifile/1 as goals -- what the
  ;;; directives are (`coco_directive', lib/kb-pred.cicili): one walk,
  ;;; reached two ways. Through 3.0.4 discontiguous/1 and multifile/1 kept
  ;;; nothing, and a refusal was the whole spec's.
  (func coco_bi_dynamic ((coco_engine * e) (size_t g)) (out int)
        (return (coco_decl_walk e (coco_arg (-> e m) g 0) 0)))

  (func coco_bi_discontiguous ((coco_engine * e) (size_t g)) (out int)
        (return (coco_decl_walk e (coco_arg (-> e m) g 0) 1)))

  (func coco_bi_multifile ((coco_engine * e) (size_t g)) (out int)
        (return (coco_decl_walk e (coco_arg (-> e m) g 0) 2)))

  ;;; meta_predicate/1 AS A GOAL (3.46.0, swipl's; '$declare'(7, Spec),
  ;;; KIND 7): the spec checked and its heads declared as swipl's checks
  ;;; and declares them (`coco_pred_meta_check'), the heads before a fault
  ;;; standing; the fault raised as swipl's, named by
  ;;; system:(meta_predicate)/1, a specifier's with the message `0..9'.
  ;;; Through 3.45.0 the goal was an unknown procedure, and the directive
  ;;; took any spec in silence
  (func coco_bi_meta_decl ((coco_engine * e) (size_t spec)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (size_t bad . 0) (size_t f . 0)
              (int r . #'(coco_pred_meta_check (-> e st) (-> e m) spec 1 (aof bad))))
          (if (== r 0) (return 1))
          (if (== r 8) (return 0))
          (cond
            ((or (== r 1) (== r 4)) (set f (coco_new_atom m "instantiation_error")))
            ((== r 2) (set f (coco_make2 m "type_error" (coco_new_atom m "callable") bad)))
            ((== r 3)
             (let ((size_t args [3]))
               (set (nth 0 args) (coco_new_atom m "modify"))
               (set (nth 1 args) (coco_new_atom m "static_procedure"))
               (set (nth 2 args) (coco_make2 m "/" (coco_new_atom_id m (coco_name_of m bad))
                                             (coco_new_int m (cast i64 (coco_arity m bad)))))
               (set f (coco_make m "permission_error" 3 args))))
            ((== r 5) (set f (coco_make2 m "domain_error" (coco_new_atom m "meta_argument_specifier") bad)))
            ((== r 6) (set f (coco_make2 m "type_error" (coco_new_atom m "meta_argument_specifier") bad)))
            (#t (set f (coco_make1 m "representation_error" (coco_new_atom m "int")))))
          (return (coco_raise_ctx e f (coco_ectx_pi m "system" (coco_new_atom m "meta_predicate") 1
                                                    (? (and (>= r 4) (<= r 6))
                                                       (coco_new_atom m "0..9")
                                                       (coco_new_var m)))))))

  ;;; '$declare'(Kind, Spec): public/1, volatile/1, module_transparent/1
  ;;; and thread_local/1 (3.2.0, swipl's), KIND 3 to 6 of the same walk --
  ;;; clauses of the Prolog half call it. The first three are an attribute
  ;;; predicate_property/2 tells, and no definition, so a call of a
  ;;; predicate they named and nothing else defined raises existence_error
  ;;; as swipl's does; thread_local/1 is dynamic/1 as well, which every
  ;;; dynamic predicate is here -- a thread has a store of its own. Its
  ;;; refusals name no predicate, as swipl's (no row in *error-contexts*),
  ;;; but the permission error's '$set_predicate_attribute'/3.
  (func coco_bi_declare ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t k . #'(coco_deref m (coco_arg m g 0)))
              (i64 kind . 0))
          (if (not (coco-is-int (nth k (-> m heap)))) (return 0))
          (set kind (coco_int_val m (nth k (-> m heap))))
          (if (== kind 7) (return (coco_bi_meta_decl e (coco_arg m g 1))))
          (if (or (< kind 3) (> kind 6)) (return 0))
          (return (coco_decl_walk e (coco_arg m g 1) (cast int kind)))))

  ;;; redefine_system_predicate(+Head) (3.1.0, swipl's): a clause a program
  ;;; file gives Head's predicate takes it over from the system's, an ISO
  ;;; one's too (`redef', `coco_assert_from'), where without this it is
  ;;; refused; the system's runs until that clause comes. M:Head is Head; a
  ;;; name nothing implements, or a construct but not/1 and ignore/1, is
  ;;; left as it is; a Head that is unbound, or no goal, swipl's error.
  ;;; USER'S DEFINITION GOES FIRST (3.47.0), as pl-proc.c's
  ;;; abolishProcedure() takes it before the mark: the program's clauses by
  ;;; the walk abolish/1 takes, a library's kept, then its declarations;
  ;;; through 3.46.0 they stood, a dynamic predicate's clauses answering on.
  (func coco_bi_redefine_system ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t h . #'(coco_deref (-> e m) (coco_arg (-> e m) g 0))))
          (while (coco_is_compound2 m h ":") (set h (coco_deref m (coco_arg m h 1))))
          (if (not (coco_is_callable m h)) (return (coco_type_error e "callable" h)))
          (let ((u64 nid . #'(coco_name_of m h)) (u32 n . #'(coco_arity m h))
                (size_t ap . #'(coco_pred_find (-> e st) (coco_name_of m h) (coco_arity m h))))
            (if (< ap (-> st npreds))
                (with-green-write e
                 (let ((int lib . 0))
                  (if (not (coco_pred_ensure st ap)) (return (coco_fetch_error e)))
                  (set lib (and ($ (nth ap (-> st preds)) library) (not ($ (nth ap (-> st preds)) own))))
                  (coco_pred_forget_where st m ap 0 (? lib 3 4))
                  (coco_store_maybe_compact st m)
                  (if (and (not lib) (< (coco_pred_undeclare st ap) 0))
                      (return (coco_raise e (coco_make1 m "resource_error"
                                                        (coco_new_atom m "knowledge_base"))))))))
            (if (and (== (coco_claim_kind m nid n) 2) (not (coco_is_construct m nid)))
                (let ((size_t pi . #'(coco_pred_make st nid n)))
                  (if (< pi (-> st npreds)) (set ($ (nth pi (-> st preds)) redef) 1))))
            (return 1))))

  ;;; `'$decl_report'(Kind, Ball)' (3.1.0): what a directive's part raised,
  ;;; reported where the directive stands in swipl's two lines, `Kind/1: '
  ;;; before the message whatever frame the raise named, as swipl's
  ;;; '$pattr_directive' prints it. Always true: the directive goes on.
  (func coco_bi_decl_report ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t k . #'(coco_deref m (coco_arg m g 0)))
              (size_t b . #'(coco_deref m (coco_arg m g 1)))
              (char text [1024]))
          (if (and (coco_is_compound2 m b "error") (coco-tag-is ATOM (nth k (-> m heap))))
              (block
                ;; swipl's module_transparent/1 reports as transparent/1,
                ;; the attribute's own name (3.2.0)
                (if (== 0 (strcmp (coco_atom_name m (coco_name_of m k)) "module_transparent"))
                    (set k (coco_new_atom m "transparent")))
                (set b (coco_make2 m "error" (coco_arg m b 0)
                                   (coco_ectx_pi m "system" k 1 (coco_new_var m))))))
          (coco_error_text m (-> e st) b text (sizeof text))
          (coco_load_message "ERROR" (-> m sloc_file) (-> m sloc_line) text)
          (return 1)))

  ;;; A NO-OP FOR A BINARY THAT LINKS THE ENGINE WITHOUT THE GREEN MODULE
  ;;; (2.8.0): test/solve.cicili and test/shared.cicili have no
  ;;; lib/green.cicili, and Darwin's -undefined,dynamic_lookup would make
  ;;; every write hook a jump to address 0 (found by the 2.8.0 suite, both
  ;;; binaries a SIGSEGV). cocolog.cicili compiles with -DCOCO_GREEN and
  ;;; gets the green module's definition instead.
  (@ifndef (code "COCO_GREEN"))
  (func coco_g_write_begin ((void * e)) (out int) (return 0))
  (func coco_g_write_end () (return))
  (func coco_g_write_end_cleanup ((int * began)) (return))
  (@endif)

  ;;; ---- laying a clause out as swipl does (3.18.0) -----------------------

  ;;; `portray_clause/1' and `listing/1' share one walk over a clause term.
  ;;; It is swipl's boot/listing.pl, function for function where it can be:
  ;;; a body's conjunction one goal a line, a disjunction or an if-then-else
  ;;; in parentheses with its arrows in a column, a meta-call's goal laid out
  ;;; inside it, and a term too long for the line wrapped at its arguments.
  ;;; The layout writes through the ordinary writer, so a quoted atom, an
  ;;; operator and a number are the writer's forms; what is added here is
  ;;; where the line breaks and how far they indent.

  (static) (decl) (func lay_pprint ((coco_machine * m) (coco_strbuf * b)
                                    (size_t t) (int pri)))
  (static) (decl) (func lay_body ((coco_machine * m) (coco_strbuf * b)
                                  (size_t t) (int indent) (int do_indent) (int pri)))
  (static) (decl) (func lay_or ((coco_machine * m) (coco_strbuf * b)
                                (size_t t) (int indent) (int pri)))
  (static) (decl) (func lay_or_plain ((coco_machine * m) (coco_strbuf * b)
                                      (size_t t) (int indent)))
  (static) (decl) (func lay_meta ((coco_machine * m) (coco_strbuf * b) (size_t t)) (out int))

  ;;; A term with this functor and arity.
  (static)
  (func lay_is ((coco_machine * m) (size_t t) (const char * name) (u32 n)) (out int)
        (set t (coco_deref m t))
        (if (not (coco_is_callable m t)) (return 0))
        (if (!= (coco_arity m t) n) (return 0))
        (return (? (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) name)) 1 0)))

  ;;; The column the next character would stand in: characters since the
  ;;; last newline. The layout's terms are ASCII in the common case; a
  ;;; character past ASCII costs its bytes here, which only matters at the
  ;;; wrapping threshold.
  (static)
  (func lay_col ((coco_strbuf * b)) (out int)
        (let ((size_t i . #'(-> b len)) (int n . 0))
          (while (> i 0)
            (set i (- i 1))
            (if (== (nth i (-> b s)) 10) (return n))
            (set n (+ n 1)))
          (return n)))

  (static)
  (func lay_nlindent ((coco_strbuf * b) (int n))
        (coco_sb_putc b (cast char 10))
        (for ((int i . 0)) (< i n) ((++ i))
             (coco_sb_putc b (cast char 32))))

  ;;; An infix operator's two operands' greatest priorities, as swipl's
  ;;; `infix_op/3' gives them. 1 when OP is one.
  (static)
  (func lay_infix ((const char * op) (int * left) (int * right)) (out int)
        (let ((int pri . 0) (int type . 0))
          (if (not (coco_op_infix op (aof pri) (aof type))) (return 0))
          (cond ((== type COCO_XFX)
                 (set (cof left) (- pri 1)) (set (cof right) (- pri 1)))
                ((== type COCO_XFY)
                 (set (cof left) (- pri 1)) (set (cof right) pri))
                ((== type COCO_YFX)
                 (set (cof left) pri) (set (cof right) (- pri 1)))
                (#t (return 0)))
          (return 1)))

  ;;; A prefix operator's argument's greatest priority, as swipl's
  ;;; `prefix_op/2' gives it.
  (static)
  (func lay_prefix ((const char * op) (int * argpri)) (out int)
        (let ((int pri . 0) (int type . 0))
          (if (not (coco_op_prefix op (aof pri) (aof type))) (return 0))
          (cond ((== type COCO_FX) (set (cof argpri) (- pri 1)))
                ((== type COCO_FY) (set (cof argpri) pri))
                (#t (return 0)))
          (return 1)))

  ;;; A control structure that gets the disjunction layout.
  (static)
  (func lay_or_layout ((coco_machine * m) (size_t t)) (out int)
        (return (or (lay_is m t ";" 2)
                    (or (lay_is m t "->" 2) (lay_is m t "*->" 2)))))

  ;;; Whether TERM has to stand in parentheses at priority PRI: its functor
  ;;; is an operator that binds less tightly than the place allows. As
  ;;; swipl's `term_needs_braces/2', which asks the name and not the arity.
  (static)
  (func lay_needs_braces ((coco_machine * m) (size_t t) (int pri)) (out int)
        (set t (coco_deref m t))
        (if (not (coco_is_callable m t)) (return 0))
        (let ((const char * name . #'(coco_atom_name m (coco_name_of m t)))
              (int p . 0) (int type . 0))
          (if (coco_op_infix name (aof p) (aof type)) (return (? (> p pri) 1 0)))
          (if (coco_op_prefix name (aof p) (aof type)) (return (? (> p pri) 1 0)))
          (return 0)))

  ;;; A term the wrapper leaves on one line however long it is: a named
  ;;; variable, the empty dict, or an operator. As swipl's `nowrap_term/1'.
  (static)
  (func lay_nowrap ((coco_machine * m) (size_t t)) (out int)
        (set t (coco_deref m t))
        (if (lay_is m t "$VAR" 1) (return 1))
        (if (not (coco_is_callable m t)) (return 0))
        (let ((const char * name . #'(coco_atom_name m (coco_name_of m t)))
              (u32 n . #'(coco_arity m t))
              (int p . 0) (int type . 0))
          (if (and (== n 0) (== 0 (strcmp name "{}"))) (return 1))
          (if (== n 2) (return (? (coco_op_infix name (aof p) (aof type)) 1 0)))
          (if (== n 1) (return (? (coco_op_prefix name (aof p) (aof type)) 1 0)))
          (return 0)))

  ;;; Write TERM's functor, quoted, into B: `~q('s first half when a
  ;;; compound is wrapped at its arguments.
  (static)
  (func lay_fun_name ((coco_machine * m) (coco_strbuf * b) (size_t t))
        (let ((size_t mark . #'(-> m heap_len))
              (size_t a . #'(coco_new_atom m (coco_atom_name m (coco_name_of m t)))))
          (coco_write_pri m b a 601 1200)
          (set (-> m heap_len) mark)))

  ;;; TERM's written length, capped at swipl's default line width: its
  ;;; `write_length/3' answers only when the term fits, and the caller then
  ;;; uses the width itself.
  (static)
  (func lay_term_len ((coco_machine * m) (size_t t) (int pri)) (out int)
        (let ((coco_strbuf tmp) (int n . 0))
          (coco_sb_init (aof tmp))
          (coco_write_pri m (aof tmp) t 601 pri)
          (set n ($ tmp len))
          (coco_sb_free (aof tmp))
          (if (> n 78) (set n 78))
          (return n)))

  ;;; A list too long for its line, one element a line, swipl's
  ;;; `portray_list/4'. The opening bracket and its space are at INDENT; the
  ;;; elements at INDENT+2; an improper tail after `| ' at INDENT.
  (static)
  (func lay_list ((coco_machine * m) (coco_strbuf * b) (size_t t) (int indent))
        (coco_sb_put b "[ ")
        (let ((int eindent . #'(+ indent 2)) (int first . 1))
          (while 1
            (set t (coco_deref m t))
            (if (coco_is_nil m t) break)
            (if (not (coco_is_cons m t))
                (block
                  (lay_nlindent b (- eindent 2))
                  (coco_sb_put b "| ")
                  (lay_pprint m b t 999)
                  break))
            (if (not first)
                (block (coco_sb_put b ",") (lay_nlindent b eindent)))
            (set first 0)
            (lay_pprint m b (coco_arg m t 0) 999)
            (set t (coco_arg m t 1)))
          (lay_nlindent b indent)
          (coco_sb_put b "]")))

  ;;; A compound too long for its line, its arguments one a line. As swipl's
  ;;; `pprint_wrapped/4': the name and `(' at INDENT, the arguments at the
  ;;; column just after it.
  (static)
  (func lay_wrapped ((coco_machine * m) (coco_strbuf * b) (size_t t) (int indent))
        (lay_fun_name m b t)
        (coco_sb_put b "(")
        (set indent (lay_col b))
        (let ((u32 n . #'(coco_arity m t)))
          (for ((u32 i . 0)) (< i n) ((++ i))
            (if (> i 0) (block (coco_sb_put b ",") (lay_nlindent b indent)))
            (lay_pprint m b (coco_arg m t i) 999))
          (coco_sb_put b ")")))

  ;;; A term at a priority, wrapped at its arguments when swipl would wrap
  ;;; it: a compound or a list, not one of `lay_nowrap''s, longer than the
  ;;; line allows and longer than a quarter of it (`pprint/4').
  (static)
  (func lay_pprint ((coco_machine * m) (coco_strbuf * b) (size_t t) (int pri))
        (set t (coco_deref m t))
        ;; a brace term is a body, its argument laid out as one
        (if (lay_is m t "{}" 1)
            (block
              (let ((int col . #'(lay_col b)))
                (coco_sb_put b "{ ")
                (lay_body m b (coco_arg m t 0) (+ col 2) 0 1000)
                (lay_nlindent b col)
                (coco_sb_put b "}"))
              (return)))
        (if (and (or (coco_is_cons m t)
                     (and (coco_is_callable m t) (> (coco_arity m t) 0)))
                 (not (lay_nowrap m t)))
            (let ((int col . #'(lay_col b))
                  (int len . #'(lay_term_len m t pri)))
              (if (and (> (+ col len) 78) (> len 19))
                  (block
                    (if (coco_is_cons m t)
                        (lay_list m b t col)
                      (lay_wrapped m b t col))
                    (return)))))
        (coco_write_pri m b t 601 pri))

  ;;; A conjunction's goals, one a line. The whole left spine is flattened,
  ;;; as swipl's first comma clause flattens it; the last goal is written at
  ;;; the comma's right priority and the others at its left.
  (static)
  (func lay_conj ((coco_machine * m) (coco_strbuf * b) (size_t t) (int indent))
        (let ((size_t * ws . nil) (size_t wn . 0) (size_t wc . 0)
              (size_t * es . nil) (size_t en . 0) (size_t ec . 0))
          (coco_cells_push (aof ws) (aof wn) (aof wc) t)
          (while (> wn 0)
            (set wn (- wn 1))
            (let ((size_t x . #'(coco_deref m (nth wn ws))))
              (if (lay_is m x "," 2)
                  (block
                    (coco_cells_push (aof ws) (aof wn) (aof wc) (coco_arg m x 1))
                    (coco_cells_push (aof ws) (aof wn) (aof wc) (coco_arg m x 0)))
                (coco_cells_push (aof es) (aof en) (aof ec) x))))
          (for ((size_t i . 0)) (< i en) ((++ i))
            (if (> i 0)
                (block (coco_sb_put b ",") (lay_nlindent b indent)))
            (lay_body m b (nth i es) indent 0
                      (? (== i (- en 1)) 1000 999)))
          (free ws)
          (free es)))

  ;;; Whether ARG is a meta argument of NAME/N whose layout swipl gives its
  ;;; own place: the integer positions of its meta_predicate declaration.
  ;;; The declarations swipl's system and libraries give the control
  ;;; predicates a program uses in a body.
  (static)
  (func lay_meta_pos ((const char * name) (u32 n) (u32 i)) (out int)
        (if (and (== 0 (strcmp name "call")) (and (>= n 1) (<= n 8)) (== i 0))
            (return 1))
        (if (and (or (or (== 0 (strcmp name "once")) (== 0 (strcmp name "ignore")))
                     (== 0 (strcmp name "not")))
                 (== n 1) (== i 0))
            (return 1))
        (if (and (== 0 (strcmp name "catch")) (== n 3) (or (== i 0) (== i 2)))
            (return 1))
        (if (and (== 0 (strcmp name "setup_call_cleanup")) (== n 3)) (return 1))
        (if (and (== 0 (strcmp name "call_cleanup")) (== n 2)) (return 1))
        (if (and (== 0 (strcmp name "forall")) (== n 2)) (return 1))
        (if (and (== 0 (strcmp name "findall")) (and (>= n 3) (<= n 4)) (== i 1))
            (return 1))
        (if (and (== 0 (strcmp name "aggregate_all")) (== n 3) (== i 1))
            (return 1))
        (if (and (== 0 (strcmp name "maplist")) (>= n 2) (== i 0)) (return 1))
        (if (and (== 0 (strcmp name "foldl")) (== n 4) (== i 0)) (return 1))
        (if (and (or (== 0 (strcmp name "freeze")) (== 0 (strcmp name "when")))
                 (== n 2) (== i 1))
            (return 1))
        ;; $(0) and @(0, +) (3.20.0)
        (if (and (or (and (== 0 (strcmp name "$")) (== n 1)) (and (== 0 (strcmp name "@")) (== n 2)))
                 (== i 0))
            (return 1))
        (return 0))

  ;;; Whether NAME/N is a meta predicate whose call swipl's `portray_body/6'
  ;;; hands to `portray_meta/4' -- not only the ones whose goal gets its own
  ;;; lines, but every one whose ordinary form is written at priority 999.
  (static)
  (func lay_meta_name ((const char * name) (u32 n)) (out int)
        (if (and (== 0 (strcmp name "call")) (and (>= n 1) (<= n 8))) (return 1))
        (if (and (or (or (== 0 (strcmp name "once")) (== 0 (strcmp name "ignore")))
                     (== 0 (strcmp name "not")))
                 (== n 1))
            (return 1))
        (if (and (== 0 (strcmp name "$")) (== n 1)) (return 1))
        (if (and (== 0 (strcmp name "@")) (== n 2)) (return 1))
        (if (and (== 0 (strcmp name "catch")) (== n 3)) (return 1))
        (if (and (== 0 (strcmp name "setup_call_cleanup")) (== n 3)) (return 1))
        (if (and (== 0 (strcmp name "call_cleanup")) (== n 2)) (return 1))
        (if (and (== 0 (strcmp name "forall")) (== n 2)) (return 1))
        (if (and (== 0 (strcmp name "findall")) (and (>= n 3) (<= n 4))) (return 1))
        (if (and (or (or (== 0 (strcmp name "bagof")) (== 0 (strcmp name "setof")))
                     (or (== 0 (strcmp name "aggregate")) (== 0 (strcmp name "aggregate_all"))))
                 (== n 3))
            (return 1))
        (if (and (== 0 (strcmp name "maplist")) (>= n 2)) (return 1))
        (if (and (== 0 (strcmp name "foldl")) (== n 4)) (return 1))
        (if (and (or (== 0 (strcmp name "freeze")) (== 0 (strcmp name "when")))
                 (== n 2))
            (return 1))
        (if (and (== 0 (strcmp name "phrase")) (or (== n 2) (== n 3))) (return 1))
        (if (and (== 0 (strcmp name "with_output_to")) (== n 2)) (return 1))
        (if (and (or (or (== 0 (strcmp name "dynamic")) (== 0 (strcmp name "multifile")))
                     (or (== 0 (strcmp name "discontiguous")) (== 0 (strcmp name "public"))))
                 (== n 1))
            (return 1))
        (if (and (or (or (== 0 (strcmp name "volatile")) (== 0 (strcmp name "module_transparent")))
                     (== 0 (strcmp name "thread_local")))
                 (== n 1))
            (return 1))
        (if (and (== 0 (strcmp name "initialization")) (or (== n 1) (== n 2)))
            (return 1))
        (return 0))

  (static)
  (func lay_nonprimitive ((coco_machine * m) (size_t t)) (out int)
        (return (or (lay_or_layout m t) (lay_is m t "," 2))))

  ;;; A meta-call whose goal is a conjunction, a disjunction or an
  ;;; if-then-else, as swipl's `portray_meta/4' writes it: the goal on its
  ;;; own lines inside the call. Answers 0 when the call is written whole.
  (static)
  (func lay_meta ((coco_machine * m) (coco_strbuf * b) (size_t t)) (out int)
        (set t (coco_deref m t))
        (if (not (coco_is_callable m t)) (return 0))
        (if (lay_is m t ":" 2) (return 0))
        (let ((const char * name . #'(coco_atom_name m (coco_name_of m t)))
              (u32 n . #'(coco_arity m t))
              (int any . 0))
          (if (== n 0) (return 0))
          (if (not (lay_meta_name name n)) (return 0))
          (for ((u32 i . 0)) (< i n) ((++ i))
            (if (and (lay_meta_pos name n i)
                     (lay_nonprimitive m (coco_arg m t i)))
                (set any 1)))
          (if (not any)
              (block (lay_pprint m b t 999) (return 1)))
          (lay_fun_name m b t)
          (coco_sb_put b "(")
          (let ((int ind . #'(lay_col b)))
            (for ((u32 i . 0)) (< i n) ((++ i))
              (if (> i 0)
                  (block (coco_sb_put b ",") (lay_nlindent b ind)))
              (if (lay_meta_pos name n i)
                  (lay_body m b (coco_arg m t i) ind 0 999)
                (lay_pprint m b (coco_arg m t i) 999)))
            (coco_sb_put b ")")))
        (return 1))

  ;;; A goal in a body, at INDENT. DO_INDENT says the line has to be started
  ;;; first: a body's first goal is written where `:-' left the column, and
  ;;; every goal after it begins its own line.
  (static)
  (func lay_body ((coco_machine * m) (coco_strbuf * b) (size_t t)
                  (int indent) (int do_indent) (int pri))
        (set t (coco_deref m t))
        (if do_indent (lay_nlindent b indent))
        (if (coco-tag-is REF (nth t (-> m heap)))
            (block (lay_pprint m b t pri) (return)))
        ;; a disjunction or an if-then-else: parentheses and a column
        (if (lay_or_layout m t)
            (block
              (coco_sb_put b "(   ")
              (lay_or m b t indent 1200)
              (lay_nlindent b indent)
              (coco_sb_put b ")")
              (return)))
        ;; an operator too loose for the place: parentheses
        (if (lay_needs_braces m t pri)
            (block
              (coco_sb_put b "( ")
              (lay_body m b t (+ indent 2) 0 1200)
              (lay_nlindent b indent)
              (coco_sb_put b ")")
              (return)))
        (if (lay_is m t "," 2)
            (block (lay_conj m b t indent) (return)))
        (if (lay_is m t "\\+" 1)
            (block
              (coco_sb_put b "\\+ ")
              (let ((int argpri . 900))
                (if (not (lay_prefix "\\+" (aof argpri))) (set argpri 900))
                (lay_body m b (coco_arg m t 0) (+ indent 3) 0 argpri))
              (return)))
        (if (lay_meta m b t) (return))
        (lay_pprint m b t pri))

  ;;; The right-hand side of a disjunction or an if-then-else, after `(   '
  ;;; at INDENT. As swipl's `portray_or/5' and `portray_or/4'.
  (static)
  (func lay_or ((coco_machine * m) (coco_strbuf * b) (size_t t) (int indent) (int pri))
        (set t (coco_deref m t))
        (if (lay_needs_braces m t pri)
            (block
              (let ((int newindent . #'(+ indent 4)))
                (coco_sb_put b "(   ")
                (lay_or_plain m b t newindent)
                (lay_nlindent b newindent)
                (coco_sb_put b ")"))
              (return)))
        (lay_or_plain m b t indent))

  (static)
  (func lay_or_plain ((coco_machine * m) (coco_strbuf * b) (size_t t) (int indent))
        (set t (coco_deref m t))
        (let ((int lp . 0) (int rp . 0) (int lp2 . 0) (int rp2 . 0))
          ;; (If -> Then ; Else) and (If *-> Then ; Else)
          (if (and (lay_is m t ";" 2)
                   (or (lay_is m (coco_arg m t 0) "->" 2)
                       (lay_is m (coco_arg m t 0) "*->" 2)))
              (let ((size_t ift . #'(coco_deref m (coco_arg m t 0)))
                    (int hard . #'(lay_is m (coco_arg m t 0) "*->" 2))
                    (int nest . #'(+ indent 4)))
                (if hard
                    (block (set lp 1049) (set rp 1049))
                  (if (not (lay_infix "->" (aof lp) (aof rp)))
                      (block (set lp 1049) (set rp 1049))))
                (lay_body m b (coco_arg m ift 0) nest 0 lp)
                (lay_nlindent b indent)
                (coco_sb_put b (? hard "*-> " "->  "))
                (lay_body m b (coco_arg m ift 1) nest 0 rp)
                (lay_nlindent b indent)
                (coco_sb_put b ";   ")
                (if (not (lay_infix ";" (aof lp2) (aof rp2)))
                    (block (set lp2 1099) (set rp2 1100)))
                (lay_or m b (coco_arg m t 1) indent rp2)
                (return)))
          ;; (If -> Then) and (If *-> Then)
          (if (or (lay_is m t "->" 2) (lay_is m t "*->" 2))
              (let ((int hard . #'(lay_is m t "*->" 2))
                    (int nest . #'(+ indent 4)))
                (if hard
                    (block (set lp 1049) (set rp 1049))
                  (if (not (lay_infix "->" (aof lp) (aof rp)))
                      (block (set lp 1049) (set rp 1049))))
                (lay_body m b (coco_arg m t 0) nest 0 lp)
                (lay_nlindent b indent)
                (coco_sb_put b (? hard "*-> " "->  "))
                (lay_or m b (coco_arg m t 1) indent rp)
                (return)))
          ;; (A ; B) and (A | B)
          (if (or (lay_is m t ";" 2) (lay_is m t "|" 2))
              (let ((int bar . #'(lay_is m t "|" 2))
                    (int nest . #'(+ indent 4)))
                (if bar
                    (block (if (not (lay_infix "|" (aof lp) (aof rp)))
                               (block (set lp 999) (set rp 1000))))
                  (if (not (lay_infix ";" (aof lp) (aof rp)))
                      (block (set lp 1099) (set rp 1100))))
                (lay_body m b (coco_arg m t 0) nest 0 lp)
                (lay_nlindent b indent)
                (coco_sb_put b (? bar "|   " ";   "))
                (lay_or m b (coco_arg m t 1) indent rp)
                (return))))
        ;; not one of the shapes: as a body would write it
        (lay_body m b t (+ indent 4) 0 1200))

  ;;; A clause term as swipl's `portray_clause/1' writes it: a fact, a rule,
  ;;; or a directive, at LEFT.
  (static)
  (func lay_clause ((coco_machine * m) (coco_strbuf * b) (size_t t) (int left))
        (set t (coco_deref m t))
        (if (coco-tag-is REF (nth t (-> m heap)))
            (block (lay_pprint m b t 1200) (coco_sb_put b ".") (return)))
        ;; Head :- true is the fact Head
        (if (and (lay_is m t ":-" 2) (lay_is m (coco_arg m t 1) "true" 0))
            (block
              (lay_pprint m b (coco_arg m t 0) 1200)
              (coco_sb_put b ".")
              (return)))
        ;; Head :- Body, Head => Body, Head --> Body
        (if (or (lay_is m t ":-" 2)
                (or (lay_is m t "=>" 2) (lay_is m t "-->" 2)))
            (let ((const char * neck . #'(coco_atom_name m (coco_name_of m t)))
                  (int lp . 1199) (int rp . 1199))
              (if (not (lay_infix neck (aof rp) (aof lp)))
                  (block (set lp 1199) (set rp 1199)))
              (lay_pprint m b (coco_arg m t 0) lp)
              (coco_sb_put b " ")
              (coco_sb_put b neck)
              ;; A QUALIFIED BODY THAT IS A CONTROL STRUCTURE, as swipl's
              ;; do_portray_clause/3 lays it out: the module on a line, then
              ;; the body in parentheses under it.
              (let ((size_t body . #'(coco_deref m (coco_arg m t 1))))
                (if (and (lay_is m body ":" 2)
                         (lay_nonprimitive m (coco_arg m body 1)))
                    (block
                      (lay_nlindent b (+ left 4))
                      (lay_pprint m b (coco_arg m body 0) 1200)
                      (coco_sb_put b ":")
                      (lay_nlindent b (+ left 4))
                      (coco_sb_put b "(   ")
                      (lay_body m b (coco_arg m body 1) (+ left 8) 0 1200)
                      (lay_nlindent b (+ left 4))
                      (coco_sb_put b ")"))
                  (lay_body m b body (+ left 4) 1 rp)))
              (coco_sb_put b ".")
              (return)))
        ;; :- Directive and ?- Directive
        (if (or (lay_is m t ":-" 1) (lay_is m t "?-" 1))
            (block
              (coco_sb_put b (? (lay_is m t ":-" 1) ":- " "?- "))
              (lay_body m b (coco_arg m t 0) (+ left 3) 0 1199)
              (coco_sb_put b ".")
              (return)))
        (lay_body m b t left 0 1200)
        (coco_sb_put b "."))

  ;;; The whole clause in B, its variables named `_' and `A', `B', ... as
  ;;; numbervars/4's singletons option names them. A cyclic term is left to
  ;;; the writer's factored form.
  (func coco_layout_clause ((coco_machine * m) (coco_strbuf * b) (size_t t))
        (let ((coco_varmap vm . '{ nil nil 0 0 0 }) (int named . 0))
          ;; a cyclic term is the writer's factored form, as swipl's
          ;; `numbervars'/write pair gives it
          (if (not (coco_acyclic m t))
              (block
                (coco_write_mode m b t 601 1)
                (coco_sb_put b ".")
                (coco_sb_putc b (cast char 10))
                (return)))
          (if (coco_acyclic m t)
              (block
                (coco_varmap_take m (aof vm))
                (if (coco_name_vars m t (aof vm))
                    (block
                      (set (-> m wcanon) (cast (void *) (aof vm)))
                      (set (-> m nwnames) 1)
                      (set named 1))
                  (coco_varmap_give m (aof vm)))))
          (lay_clause m b t 0)
          (coco_sb_putc b (cast char 10))
          (if named
              (block
                (set (-> m wcanon) nil)
                (set (-> m nwnames) 0)
                (coco_varmap_give m (aof vm))))))

  ;;; portray_clause/1 (3.18.0): the clause term laid out as listing/1
  ;;; lays one out, on the current output -- which is stdout here, as
  ;;; write/1's is. The term itself is untouched.
  (func coco_bi_portray_clause ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_layout_clause (-> e m) (aof b) (coco_arg (-> e m) g 0))
          (if (!= ($ b s) nil) (coco_out_puts stdout ($ b s)))
          (coco_sb_free (aof b))
          (return 1)))

  ;;; ---- listing ------------------------------------------------------------

  ;;; META_PREDICATE(Spec)'s Spec: NID of the arguments SPEC writes, a
  ;;; character each (a digit, `/' for `//', or the atom of the character)
  ;;; -- predicate_property/2's (lib/builtins-db.cicili) and listing/1's
  (static)
  (func coco_meta_spec_term ((coco_machine * m) (u64 nid) (const char * spec)) (out size_t)
        (let ((size_t k . #'(strlen spec)) (size_t * a . nil) (size_t t . 0))
          ;; a head of no arguments, `meta_predicate zero' (3.46.0)
          (if (== k 0) (return (coco_new_atom_id m nid)))
          (set a (cast (size_t *) (malloc (* (+ k 1) (sizeof size_t)))))
          (if (== a nil) (return (coco_new_atom_id m nid)))
          (for ((size_t i . 0)) (< i k) ((++ i))
            (let ((int ch . #'(cast int (nth i spec))) (char one [2]))
              (cond
                ((and (>= ch 48) (<= ch 57)) (set (nth i a) (coco_new_int m (cast i64 (- ch 48)))))
                ((== ch 47) (set (nth i a) (coco_new_atom m "//")))
                (#t (block (set (nth 0 one) (cast char ch)) (set (nth 1 one) (cast char 0))
                           (set (nth i a) (coco_new_atom m one)))))))
          (set t (coco_make m (coco_atom_name m nid) (cast u32 k) a))
          (free a)
          (return t)))

  ;;; (Whether the spec makes the predicate transparent is
  ;;; `coco_meta_spec_module' in lib/kb-pred.cicili, which the step's
  ;;; readers of transparency ask too.)

  ;;; A DECLARATION'S LINE, as swipl's write_declarations/2 writes it,
  ;;; `format(':- ~q.~n', [Decl])' (3.37.0): the indicator quoted as
  ;;; writeq/1 quotes it, so `:- dynamic'z q'/1.' and `:- dynamic
  ;;; 'don\'t'/2.' read back -- through 3.36.0 the name went out as it is,
  ;;; `:- dynamic z q/1.' -- and with its module where the listing names one
  (static)
  (func coco_listing_decl ((coco_machine * m) (const char * kind) (size_t pit))
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_sb_put (aof b) ":- ")
          (coco_write_mode m (aof b) (coco_make1 m kind pit) 25 0)
          (coco_sb_put (aof b) ".\n")
          (coco_out_puts stdout ($ b s))
          (coco_sb_free (aof b))))

  ;;; WHETHER A CLAUSE'S HEAD UNIFIES WITH HEAD, undone after: swipl's
  ;;; `\+ \+ rule_head(Rule, Head)' in list_clauses/3, a single-sided rule's
  ;;; head the one before its guard
  (static)
  (func coco_listing_fits ((coco_machine * m) (size_t t) (size_t head)) (out int)
        (let ((size_t h . #'(coco_deref m t)) (size_t tmark . #'(-> m trail_len)) (int ok . 0))
          (cond
            ((coco_is_compound2 m h ":-") (set h (coco_deref m (coco_arg m h 0))))
            ((coco_is_compound2 m h "=>")
             (set h (coco_deref m (coco_arg m h 0)))
             (if (coco_is_compound2 m h ",") (set h (coco_deref m (coco_arg m h 0))))))
          (set ok (coco_unify m h head))
          (coco_undo_to m tmark)
          (return ok)))

  ;;; One predicate, written so that it reads back. Its declarations first,
  ;;; a line each and a blank line after them, then a clause a line -- only
  ;;; those whose head unifies with HEAD where the listing asked for a head
  ;;; (3.37.0, swipl's list_clauses/3: `listing(f(a))' lists f/1's clauses
  ;;; for `a'; (size_t) -1 is none) -- and a blank line: before it all for
  ;;; listing/0 (LEAD), after it for listing/1, where swipl's list_module/2
  ;;; and list_predicates/3 put it. A predicate a module/2 read gave a module
  ;;; (`pmod') is written with it, before each declaration's indicator and
  ;;; each clause, unless it is the listing's own module CTX (0 for user, -1
  ;;; for a variable, which swipl's hide_module/3 unifies with any): swipl's
  ;;; decl_term/3 and write_module/3, `mm:mp(1).'.
  ;;;
  ;;; IT ASKS THE BACKEND FIRST. A predicate whose clauses are still in the
  ;;; database has an empty list here until somebody calls it, and a `listing'
  ;;; that showed nothing for a predicate that plainly has clauses would be
  ;;; worse than no listing at all.
  ;;; Answers whether it printed anything: a predicate that is neither declared
  ;;; nor has any clauses is one this store merely has a name for -- interned by
  ;;; a call that failed, or left behind by retracting the last clause of
  ;;; something never declared -- and listing a blank line for it says nothing.
  ;;; A predicate that could not be read answers -1, with the reason on the
  ;;; store for the caller to raise (2.11.1).
  (static)
  (func coco_listing_pred ((coco_engine * e) (size_t pi) (size_t head) (u64 ctx) (int lead))
        (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (coco_strbuf b))
          (if (not (coco_pred_ensure st pi)) (return -1))
          (let ((coco_pred * p . #'(aof (nth pi (-> st preds))))
                (int dyn . #'($ (nth pi (-> st preds)) dynamic))
                (int dcl . #'($ (nth pi (-> st preds)) declared))
                (int pat . #'($ (nth pi (-> st preds)) pattrs))
                (u64 mod . #'($ (nth pi (-> st preds)) pmod))
                (u64 uid . #'(cast u64 (+ (coco_intern m "user") 1)))
                (size_t hmark . #'(-> m heap_len))
                (size_t pit . 0))

            ;; (bit 32, the tracer's, is no declaration: 3.27.0)
            (if (and (not dyn) (not dcl) (== (bitand pat 31) 0) (== (coco_pred_live p) 0))
                (return 0))
            ;; THE PREDICATE'S MODULE, user's where no module/2 read gave it
            ;; one, written unless it is the listing's -- `user:yy(a, b).' in
            ;; lsm's listing, as swipl's hide_module/3 -- or the listing's is
            ;; a variable, which that unifies with any
            (if (== mod 0) (set mod uid))
            (if (or (== ctx (cast u64 -1)) (== mod (? (== ctx 0) uid ctx))) (set mod 0))
            (if lead (coco_out_puts stdout "\n"))

            ;; THE DECLARATIONS FIRST, one line each and a blank line after
            ;; them, in swipl's order: thread_local, dynamic, volatile,
            ;; multifile, public, meta_predicate (3.48.2: through 3.48.1
            ;; none), then module_transparent, which a meta spec that makes
            ;; the predicate transparent hides, as swipl's declaration/3
            ;; does. A discontiguous declaration it never writes.
            (set pit (coco_make2 m "/" (coco_new_atom_id m (-> p name))
                                 (coco_new_int m (cast i64 (-> p arity)))))
            (if mod (set pit (coco_make2 m ":" (coco_new_atom_id m (- mod 1)) pit)))
            ;; A SYSTEM NAME THE PROGRAM DEFINES says so first, swipl's
            ;; notify_changed/2, after the system's own `%   Foreign:' line
            (if (and (or (not (-> p library)) (-> p own))
                     (coco_listing_sysdef m st (-> p name) (-> p arity)))
                (let ((coco_strbuf nb))
                  (coco_sb_init (aof nb))
                  (coco_sb_put (aof nb) "%   NOTE: system definition has been overruled for ")
                  (coco_write_mode m (aof nb) pit 25 0)
                  (coco_sb_put (aof nb) "\n")
                  (coco_out_puts stdout ($ nb s))
                  (coco_sb_free (aof nb))))
            (if (bitand pat 8) (coco_listing_decl m "thread_local" pit))
            (if dyn (coco_listing_decl m "dynamic" pit))
            (if (bitand pat 2) (coco_listing_decl m "volatile" pit))
            (if (bitand dcl 2) (coco_listing_decl m "multifile" pit))
            (if (bitand pat 1) (coco_listing_decl m "public" pit))
            ;; the spec with the predicate's module where its clauses
            ;; carry one, swipl's `lmm:lp(0)'
            (if (!= (-> p pmeta) nil)
                (let ((size_t mh . #'(coco_meta_spec_term m (-> p name) (-> p pmeta))))
                  (if mod (set mh (coco_make2 m ":" (coco_new_atom_id m (- mod 1)) mh)))
                  (coco_listing_decl m "meta_predicate" mh)))
            (if (and (bitand pat 4) (not (coco_meta_spec_module (-> p pmeta))))
                (coco_listing_decl m "module_transparent" pit))
            (if (or dyn (or (bitand dcl 2) (or (bitand pat 15) (!= (-> p pmeta) nil))))
                (coco_out_puts stdout "\n"))
            (set (-> m heap_len) hmark)

            (for ((size_t i . 0)) (< i (-> p nclauses)) ((++ i))
              ;; a clause retracted under a call still open is gone
              (if (coco_pred_dead p i) continue)
              (let ((size_t mark . #'(-> m heap_len))
                    (size_t t . #'(coco_store_get m st (nth i (-> p clauses)))))
                ;; a single-sided rule as swipl writes it, and the
                ;; predicate's last clause not at all (3.19.0, `coco_ssu_rule')
                (set t (coco_ssu_rule m t))
                (if (and (!= t (cast size_t -1)) (!= head (cast size_t -1)))
                    (if (not (coco_listing_fits m t head)) (set t (cast size_t -1))))
                (if (!= t (cast size_t -1))
                    (block
                      (coco_sb_init (aof b))
                      (if mod
                          (block (coco_write_mode m (aof b) (coco_new_atom_id m (- mod 1)) 25 0)
                                 (coco_sb_put (aof b) ":")))
                      ;; the clause laid out as swipl's portray_clause/1 lays
                      ;; it out, so what listing/1 shows is what a program
                      ;; reads back
                      (coco_layout_clause m (aof b) t)
                      (if (!= ($ b s) nil) (coco_out_puts stdout ($ b s)))
                      (coco_sb_free (aof b))))
                ;; the clause was copied on to the heap only to be written
                (set (-> m heap_len) mark)))
            ;; the blank line separates predicates: after the clauses, and
            ;; after a declared predicate's blank line when it has none, as
            ;; swipl writes it (through 3.0.4 one blank line in all there)
            (if (not lead) (coco_out_puts stdout "\n"))
            (return 1))))

  ;;; A MODULE'S OWN PREDICATES, swipl's list_module/2 (3.37.0): user's for
  ;;; listing/0, `listing(_)' and `listing(user:_)' (CTX 0), M's for
  ;;; `listing(M:_)' -- a module/2 read's, a library's too (`pmod') -- and
  ;;; every module's for `listing(_:_)' (CTX -1), with none written before
  ;;; them; a blank line before each, in the store's order (swipl's walks its
  ;;; procedure table), and a name that begins with `$' none, as swipl's
  ;;; without its access_level system.
  ;;;
  ;;; User's is the PROGRAM, not everything reachable. A library's clauses
  ;;; are in the same store -- that is what makes them callable -- but a
  ;;; person asking what they have written does not want the Files library
  ;;; back, any more than SWI's `listing' hands back library(lists), and
  ;;; every module's is the program's of any module, where swipl's lists
  ;;; every library it loaded too. `listing(Name)' still shows them: asking
  ;;; for one by name is asking about that one specifically. A file the
  ;;; program loaded by its path is the program's (`own', 1.10.28: `-s FILE'
  ;;; listed nothing of FILE), and a module/2 read's file its module's,
  ;;; which swipl's user imports (through 3.36.0 listing/0 wrote them too).
  (func coco_listing_module ((coco_engine * e) (u64 ctx)) (out int)
        ;; `npreds' is read each time round rather than once: `coco_pred_ensure'
        ;; inside the listing can intern predicates the clauses it fetches
        ;; mention, and the loop should reach those too.
        (for ((size_t i . 0)) (< i ($ (cof (-> e st)) npreds)) ((++ i))
          (let ((coco_pred * p . #'(aof (nth i ($ (cof (-> e st)) preds))))
                (int prog . #'(or (not (-> p library)) (-> p own))))
            ;; (36, `$')
            (if (and (!= (nth 0 (coco_atom_name (-> e m) (-> p name))) 36)
                     (? (== ctx 0) (and prog (== (-> p pmod) 0))
                        (? (== ctx (cast u64 -1)) prog (== (-> p pmod) ctx))))
                (if (< (coco_listing_pred e i (cast size_t -1) ctx 1) 0)
                    (return (coco_fetch_error e))))))
        (return 1))

  ;;; listing/0, user's
  (func coco_bi_listing_all ((coco_engine * e) (size_t g)) (out int)
        (coco_store_warm (-> e st))
        (return (coco_listing_module e 0)))

  ;;; ---- listing/1's argument (3.37.0, swipl 9.0.4's) ------------------------
  ;;;
  ;;; swipl's listing_/2 (library(listing)) over '$find_predicate'/2
  ;;; (boot/dwim.pl), which through 3.36.0 took a name or Name/Arity alone,
  ;;; failed when it named nothing, and stopped the query for anything else:
  ;;;
  ;;;   - the meta-argument's qualifiers, `M:Spec' with M an atom, are taken
  ;;;     off (one namespace: M is no module a name's search keeps to), the
  ;;;     innermost M the listing's own module, which a predicate's module
  ;;;     is not written before; a variable M is every module, and ends the
  ;;;     strip (`coco_listing_strip');
  ;;;   - an unbound spec is the module's own predicates
  ;;;     (`coco_listing_module', swipl's list_module/2), and a proper list
  ;;;     each of its elements, in order, under the list's qualifier: `[_]'
  ;;;     the module's, `[lsm:_]' lsm's as `_/_' finds them, `[user:yy/2]'
  ;;;     yy/2;
  ;;;   - Name//Arity is Name/(Arity+2), evaluated, its errors named as
  ;;;     swipl's name_arity/3 names them (the :MAP row of listing/1);
  ;;;   - a compound is its name and arity, and only the clauses whose head
  ;;;     unifies with it are written (`coco_listing_fits');
  ;;;   - anything else is error(type_error(predicate_indicator, S), _);
  ;;;   - the predicates found, in the standard order of Module:Name/Arity:
  ;;;     the store's that a clause or a declaration defines, a library's
  ;;;     too, and the system's, `%   Foreign: system:atom_length/2' --
  ;;;     where the program defines a system name, its own clauses; with the
  ;;;     name unbound, the qualifier's module's, or the program's alone, as
  ;;;     current_predicate/1's;
  ;;;   - a negative arity of a name that is an atom or unbound is
  ;;;     domain_error(not_less_than_zero, A) from functor/3, as swipl's
  ;;;     search and its library index meet it;
  ;;;   - none is error(existence_error(procedure, Spec), context(toplevel,
  ;;;     'DWIM could not correct goal')), Spec as given with `user:' taken
  ;;;     off. No near name is offered: swipl's asks whether to correct it.

  ;;; THE MODULE A FOUND PREDICATE IS LISTED UNDER, for the standard order:
  ;;; `system', a module/2 read's (`pmod'), or `user'
  (static)
  (func coco_listing_mod ((coco_machine * m) (coco_store * st) (size_t pi)) (out const char *)
        (if (== pi (cast size_t -1)) (return "system"))
        (if (!= ($ (nth pi (-> st preds)) pmod) 0)
            (return (coco_atom_name m (- ($ (nth pi (-> st preds)) pmod) 1))))
        (return "user"))

  ;;; ENTRY A BEFORE ENTRY B: Module, then Name, then Arity. An entry is two
  ;;; words, the store's index (-1 the system's) and the arity; the
  ;;; system's name is NID.
  (static)
  (func coco_listing_before ((coco_machine * m) (coco_store * st) (u64 nid)
                             (size_t * a) (size_t * b)) (out int)
        (let ((int c . #'(strcmp (coco_listing_mod m st (nth 0 a))
                                 (coco_listing_mod m st (nth 0 b)))))
          (if (!= c 0) (return (< c 0)))
          (set c (strcmp (coco_atom_name m (? (== (nth 0 a) (cast size_t -1)) nid
                                              ($ (nth (nth 0 a) (-> st preds)) name)))
                         (coco_atom_name m (? (== (nth 0 b) (cast size_t -1)) nid
                                              ($ (nth (nth 0 b) (-> st preds)) name)))))
          (if (!= c 0) (return (< c 0)))
          (return (< (nth 1 a) (nth 1 b)))))

  ;;; WHETHER THE STORE'S PREDICATE PI IS ONE A SPEC'S NAME NM AND ARITY A
  ;;; ASK FOR (ANYAR any): of the name, or with the name unbound module
  ;;; SMOD's (its `pmod', a library's too) where the spec named a module,
  ;;; else the program's, as current_predicate/1 walks them
  (static)
  (func coco_listing_cand ((coco_machine * m) (coco_store * st) (size_t nm) (i64 a) (int anyar)
                           (u64 smod) (size_t pi)) (out int)
        (if (not (or anyar (== (cast i64 ($ (nth pi (-> st preds)) arity)) a))) (return 0))
        (if (coco-tag-is REF (nth nm (-> m heap)))
            (return (? smod (== ($ (nth pi (-> st preds)) pmod) smod)
                       (or (not ($ (nth pi (-> st preds)) library)) ($ (nth pi (-> st preds)) own)))))
        (return (and (coco-tag-is ATOM (nth nm (-> m heap))) (not (coco_is_nil m nm))
                     (== ($ (nth pi (-> st preds)) name) (coco_name_of m nm)))))

  ;;; ONE SPEC S, listing_/2's last clause, searched under the qualifier
  ;;; MQ (-1 user's, as for none): its name and arity, the predicates they
  ;;; find, each written; an existence error names `MQ:S' (S where MQ is
  ;;; user's) and CTX is the listing's module (0 user, -1 a variable)
  (static)
  (func coco_listing_one ((coco_engine * e) (size_t s) (size_t mq) (u64 ctx)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (coco_store * st . #'(-> e st))
              (size_t espec . #'(? (== mq (cast size_t -1)) s (coco_make2 m ":" mq s)))
              (size_t nm . s) (size_t ar . 0) (size_t head . #'(cast size_t -1))
              (int anyar . 0) (i64 a . 0) (size_t * es . nil) (size_t n . 0)
              (u64 smod . 0) (int rc . 1))
          (set s (coco_deref m s))
          ;; AN UNBOUND NAME KEEPS TO ITS QUALIFIER'S MODULE (SMOD), as
          ;; swipl's find_predicate/4 walks a module given: `[lsm:_/1]'
          ;; is lsm's predicates of one argument. A name given is searched
          ;; in the one namespace, whatever its qualifier.
          (if (and (!= mq (cast size_t -1)) (coco-tag-is ATOM (nth (coco_deref m mq) (-> m heap))))
              (set smod (cast u64 (+ (coco_name_of m mq) 1))))
          ;; NAME AND ARITY, swipl's name_arity/3: an unbound spec is
          ;; `_/_', which its Name/Arity clause makes of it
          (cond
            ((and (coco-tag-is ATOM (nth s (-> m heap))) (not (coco_is_nil m s)))
             (set nm s) (set anyar 1))
            ((coco-tag-is REF (nth s (-> m heap)))
             (set nm s) (set anyar 1))
            ((coco_is_compound2 m s "/")
             (set nm (coco_deref m (coco_arg m s 0)))
             (set ar (coco_deref m (coco_arg m s 1))))
            ((coco_is_compound2 m s "//")
             (set nm (coco_deref m (coco_arg m s 0)))
             (set ar (coco_deref m (coco_arg m s 1)))
             (if (coco-tag-is REF (nth ar (-> m heap)))
                 (set anyar 1)
               ;; `Arity is DCGArity+2'
               (let ((int isf . 0) (i64 iv . 0) (double fv . 0.0)
                     (size_t x . #'(coco_make2 m "+" ar (coco_new_int m 2)))
                     (int r . #'(coco_arith e x (aof isf) (aof iv) (aof fv) 0)))
                 (if (!= r 1) (return (? (== r 3) (coco_type_error e "expression" x) r)))
                 (set ar (? (== isf 0) (coco_new_int m iv) (coco_new_atom m "[]"))))))
            ((coco_is_callable m s)
             (set nm (coco_new_atom_id m (coco_name_of m s)))
             (set ar (coco_new_int m (cast i64 (coco_arity m s))))
             (if (> (coco_arity m s) 0) (set head s)))
            (#t (return (coco_raise_ctx e (coco_make2 m "type_error"
                                                     (coco_new_atom m "predicate_indicator") s)
                                        (coco_new_var m)))))
          (set nm (coco_deref m nm))
          (if (not anyar)
              (block
                (set ar (coco_deref m ar))
                (if (coco-tag-is REF (nth ar (-> m heap)))
                    (set anyar 1)
                  (if (not (coco-is-int (nth ar (-> m heap))))
                      (set a -1)
                    (block
                      (set a (coco_int_val m (nth ar (-> m heap))))
                      ;; swipl's functor/3 of the name: its search's of a
                      ;; predicate of it, or its library index's of the
                      ;; name itself -- of a name that is an atom; of an
                      ;; unbound one nothing is found (`_/(-1)')
                      (if (< a 0)
                          (block
                            (if (and (coco-tag-is ATOM (nth nm (-> m heap)))
                                     (not (coco_is_nil m nm)))
                                (return (coco_raise_named
                                         e (coco_make2 m "domain_error"
                                                       (coco_new_atom m "not_less_than_zero") ar)
                                         "system" "functor" 3)))
                            (set a -1)))
                      (if (> a 4294967295) (set a -1)))))))
          ;; THE STORE'S CANDIDATES ARE READ FIRST: a predicate of the
          ;; knowledge base keeps its clauses in the backend until something
          ;; calls it, and one judged by what this process had read was
          ;; empty to a second process (3.37.0's first cut). One this process
          ;; has not reached at all is asked for by name, as before 3.37.0.
          (if (!= a -1)
              (block
                (if (and (coco-tag-is ATOM (nth nm (-> m heap))) (not anyar))
                    (coco_pred_intern st (coco_name_of m nm) (cast u32 a)))
                (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
                  (if (and (coco_listing_cand m st nm a anyar smod i) (not (coco_pred_ensure st i)))
                      (return (coco_fetch_error e))))))
          ;; THE PREDICATES FOUND, two words an entry, at most every
          ;; predicate of the store and 64 of the system's
          (set es (cast (size_t *) (malloc (* (+ (-> st npreds) 65) 2 (sizeof size_t)))))
          (if (== es nil) (return (coco_mem_error e)))
          (if (!= a -1)
              (block
                (for ((size_t i . 0)) (< i (-> st npreds)) ((++ i))
                  (if (and (coco_listing_cand m st nm a anyar smod i) (== (coco_listing_found m st i) 1))
                      (block (set (nth (* 2 n) es) i)
                             (set (nth (+ (* 2 n) 1) es) ($ (nth i (-> st preds)) arity))
                             (set n (+ n 1)))))
                ;; the system's, a program's own definition of the name
                ;; beside it, as swipl finds user:msort/2 and system:msort/2
                (if (coco-tag-is ATOM (nth nm (-> m heap)))
                    (for ((u32 k . 0)) (< k 64) ((++ k))
                      (if (and (or anyar (== (cast i64 k) a))
                               (coco_listing_sysdef m st (coco_name_of m nm) k))
                          (block (set (nth (* 2 n) es) (cast size_t -1))
                                 (set (nth (+ (* 2 n) 1) es) k)
                                 (set n (+ n 1))))))))
          (if (== n 0)
              (block
                (free es)
                (return (coco_raise_ctx e (coco_make2 m "existence_error"
                                                     (coco_new_atom m "procedure") espec)
                                        (coco_make2 m "context" (coco_new_atom m "toplevel")
                                                    (coco_new_atom m "DWIM could not correct goal"))))))
          ;; swipl's sort/2 of them, an insertion sort: a name has a few
          (for ((size_t i . 1)) (< i n) ((++ i))
            (let ((size_t j . i))
              (while (and (> j 0)
                          (coco_listing_before m st (coco_name_of m nm) (aof (nth (* 2 j) es))
                                               (aof (nth (* 2 (- j 1)) es))))
                (let ((size_t t0 . #'(nth (* 2 j) es)) (size_t t1 . #'(nth (+ (* 2 j) 1) es)))
                  (set (nth (* 2 j) es) (nth (* 2 (- j 1)) es))
                  (set (nth (+ (* 2 j) 1) es) (nth (+ (* 2 (- j 1)) 1) es))
                  (set (nth (* 2 (- j 1)) es) t0)
                  (set (nth (+ (* 2 (- j 1)) 1) es) t1))
                (set j (- j 1)))))
          (for ((size_t i . 0)) (and (== rc 1) (< i n)) ((++ i))
            (if (== (nth (* 2 i) es) (cast size_t -1))
                ;; swipl's list_predicate/3 of a foreign one
                (let ((coco_strbuf b) (size_t mark . #'(-> m heap_len))
                      (size_t pit . #'(coco_make2 m "/" nm (coco_new_int m (cast i64 (nth (+ (* 2 i) 1) es))))))
                  (if (and (!= ctx (cast u64 -1)) (!= ctx (cast u64 (+ (coco_intern m "system") 1))))
                      (set pit (coco_make2 m ":" (coco_new_atom m "system") pit)))
                  (coco_sb_init (aof b))
                  (coco_sb_put (aof b) "%   Foreign: ")
                  (coco_write_mode m (aof b) pit 25 0)
                  (coco_sb_put (aof b) "\n\n")
                  (coco_out_puts stdout ($ b s))
                  (coco_sb_free (aof b))
                  (set (-> m heap_len) mark))
              (if (< (coco_listing_pred e (nth (* 2 i) es) head ctx 0) 0)
                  (set rc (coco_fetch_error e)))))
          (free es)
          (return rc)))

  ;;; THE QUALIFIERS TAKEN OFF as each meta-call of swipl's takes them off,
  ;;; strip_module/3's: every `M:' with M an atom, the innermost M the
  ;;; module (MQ, -1 user's), and at the TOP, the listing's own
  ;;; meta-argument, CTX that module too, the one a predicate's is not
  ;;; written before (0 user, -1 a variable). A VARIABLE M ENDS IT, as a
  ;;; module that is no atom ends swipl's: M is every module (`_:p/1' is
  ;;; p/1 of any) and what it qualifies the spec as it stands, so
  ;;; `_:user:yy/2' asks for (:)/2
  (static)
  (func coco_listing_strip ((coco_machine * m) (size_t x) (size_t * mq) (u64 * ctx) (int top))
        (out size_t)
        (set x (coco_deref m x))
        (while (coco_is_compound2 m x ":")
          (let ((size_t q . #'(coco_deref m (coco_arg m x 0))))
            (cond
              ((and (coco-tag-is ATOM (nth q (-> m heap))) (not (coco_is_nil m q)))
               (let ((int u . #'(== (coco_name_of m q) (coco_intern m "user"))))
                 (set (cof mq) (? u (cast size_t -1) q))
                 (if top (set (cof ctx) (? u 0 (cast u64 (+ (coco_name_of m q) 1)))))))
              ((coco-tag-is REF (nth q (-> m heap)))
               (set (cof mq) q)
               (if top (set (cof ctx) (cast u64 -1)))
               (return (coco_deref m (coco_arg m x 1))))
              (#t (return x)))
            (set x (coco_deref m (coco_arg m x 1)))))
        (return x))

  ;;; THE SPEC X, listing_/2 asked of `M:X' (MQ M itself or -1 for user's,
  ;;; CTX its module): an unbound X is CTX's own predicates (swipl's
  ;;; list_module/2: listing/0 is `listing(user:_)'), a proper list each of
  ;;; its elements -- each taken as given, its own qualifiers off only for
  ;;; the search, as swipl's '$find_predicate'/2 takes them -- anything else
  ;;; `coco_listing_one'
  (static)
  (func coco_listing_spec ((coco_engine * e) (size_t x) (size_t mq) (u64 ctx) (int top))
        (out int)
        (let ((coco_machine * m . #'(-> e m)) (size_t t . 0) (size_t guard . 0))
          (set x (coco_deref m x))
          (if top (set x (coco_listing_strip m x (aof mq) (aof ctx) 1)))
          (if (coco-tag-is REF (nth x (-> m heap))) (return (coco_listing_module e ctx)))
          ;; a proper list: a list that is its own tail is none (1.10.19)
          (set t x)
          (while (and (coco_is_cons m t) (<= guard (-> m heap_len)))
            (set t (coco_deref m (coco_arg m t 1)))
            (set guard (+ guard 1)))
          (if (coco_is_nil m t)
              (block
                (set t x)
                (while (coco_is_cons m t)
                  (let ((int r . #'(coco_listing_spec e (coco_arg m t 0) mq ctx 0)))
                    (if (!= r 1) (return r)))
                  (set t (coco_deref m (coco_arg m t 1))))
                (return 1)))
          (if (not top) (set x (coco_listing_strip m x (aof mq) (aof ctx) 0)))
          (return (coco_listing_one e x mq ctx))))

  ;;; listing/1. What the backend holds is ASKED BEFORE ANYTHING IS DECIDED:
  ;;; not only which predicates there are but which of them were DECLARED,
  ;;; and a `listing(counter/1)' that found the clauses and missed the `:-
  ;;; dynamic' line would be quietly wrong in a way that reads back as a
  ;;; different program.
  (func coco_bi_listing ((coco_engine * e) (size_t g)) (out int)
        (coco_store_warm (-> e st))
        (return (coco_listing_spec e (coco_a e g 0) (cast size_t -1) 0 1)))

  (func coco_bi_halt ((coco_engine * e) (size_t g)) (out int)
        (set (-> e halted) 1)
        (return 1))

  ;;; `vacuum_kb' and `vacuum_kb(Live)': the reclaim pass, from inside a
  ;;; program. The store's `vacuum' hook is the whole permission model -- a
  ;;; backend that can vacuum installs it, and the composition root clears it
  ;;; again unless the operator said `--vacuum' -- so a null hook here is a
  ;;; refusal, not an absence: permission_error, with the goal itself as the
  ;;; culprit. Deliberately NOT a quiet success on a local store, because a
  ;;; program that believes it vacuumed and did not is the exact confusion
  ;;; the loud cuda refusal exists to prevent one seam over.
  ;;;
  ;;; Live is the count of live rows left behind -- run it twice and the
  ;;; second answer being the same is what says there was nothing left.
  (func coco_bi_vacuum_kb ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_store * st . #'(-> e st))
              (i64 live . 0))
          (if (== (-> st vacuum) nil)
              (return (coco_permission_error e "vacuum" "knowledge_base" g)))
          (if (not ((-> st vacuum) st (-> st ctx) (aof live)))
              (return (coco_fail_err e "vacuum_kb: the backend refused the pass")))
          (if (== 0 (coco_arity (-> e m) g)) (return 1))
          (return (? (coco_unify (-> e m) (coco_arg (-> e m) g 0)
                                 (coco_new_int (-> e m) live)) 1 0))))

  (func coco_choice_restore ((coco_engine * e) (int kind) (size_t goals)
                           (size_t trail_mark) (size_t heap_mark) (size_t call)
                           (size_t clause_ix) (size_t barrier)
                           (const char * pred_name) (u32 pred_arity)) (out int)
        (if (not (coco_eng_grow e (+ (-> e nchoices) 1))) (return 0))
        ;; the shadow frame ZEROED, which is what the tracer's comment has
        ;; always said a thawed frame gets -- the realloc that makes room for
        ;; it does not zero, and the heap collector reads its goal as a root
        (memset (aof (nth (-> e nchoices) (-> e tchoices))) 0 (sizeof coco_tchoice))
        (let ((coco_choice * c . #'(aof (nth (-> e nchoices) (-> e choices)))))
          (memset c 0 (sizeof coco_choice))
          (set (-> c kind) kind)
          (set (-> c goals) goals)
          (set (-> c trail_mark) trail_mark)
          (set (-> c heap_mark) heap_mark)
          (set (-> c call) call)
          (set (-> c clause_ix) clause_ix)
          (set (-> c barrier) barrier)
          ;; a clause frame, and retract/1's or clause/2's walk (3.28.0), names
          ;; the predicate it walks
          (if (or (== kind COCO_CH_CLAUSE) (== kind COCO_CH_DB))
              (let ((size_t pi . #'(coco_pred_intern (-> e st)
                                                   (coco_intern (-> e m) pred_name)
                                                   pred_arity)))
                (if (>= pi ($ (cof (-> e st)) npreds)) (return 0))
                ;; ask the backend for this predicate NOW rather than when the
                ;; frame is next tried: `clause_ix' is a position in its clause
                ;; list, and a list that has not been fetched yet is empty --
                ;; and one whose read failed is no list at all: the thaw
                ;; refuses, saying why (`coco_thaw', 2.11.1)
                (if (not (coco_pred_ensure (-> e st) pi)) (return 0))
                (set (-> c pred) pi)
                ;; A RESUMED CALL RUNS ON THE KNOWLEDGE BASE AS IT IS (the
                ;; owner's design, README.md's `What is stored, and how'), and
                ;; how far it may go there is the blob's `L' section: the live
                ;; clauses before the end it began with (lib/state.cicili).
                ;; A blob without one leaves the end unsettled here, and the
                ;; run binds it to the clauses there are once it has loaded
                ;; the modules' own clauses back (`coco_frames_bound'): a
                ;; library predicate is empty until then.
                (set (-> c cend) 4294967295)
                (set (-> e cunbound) 1)
                (set ($ (nth pi ($ (cof (-> e st)) preds)) framed) 1)))
          (set (-> e nchoices) (+ (-> e nchoices) 1))
          ;; a setup_call_cleanup/3 frame is counted again (3.1.0): the heap
          ;; it names is the thawed one, read before the frames
          (if (and (== kind COCO_CH_GOAL) (< call ($ (cof (-> e m)) heap_len))
                   (coco_scc_at e (- (-> e nchoices) 1) (coco_intern (-> e m) "$scc_fail")))
              (set (-> e ncleanup) (+ (-> e ncleanup) 1)))
          (return 1)))

  ;;; THE FRAMES OPEN ON PREDICATE PI of ST -- see the declaration in
  ;;; lib/kb.cicili. A clause frame or a clocked one (a clause frame a
  ;;; window's clock marked), or retract/1's or clause/2's walk of the
  ;;; predicate (a DB frame, 3.28.0); a spent one tries nothing more, and a
  ;;; frame of any other kind keeps something else in `pred' and `clause_ix'. The
  ;;; engines of the chain are every one a program can still fail back
  ;;; into: no builtin leaves a choice point behind, so a nested engine is
  ;;; on the chain for as long as it has frames anybody may try, and a
  ;;; host's engine waiting for its next answer runs no goal meanwhile.
  ;;; Each engine is read from the top, where a loop's own frame is.
  (func coco_frames_on ((coco_machine * m) (coco_store * st) (size_t pi)
                        (int act) (u32 era) (size_t at)) (out size_t)
        (if (or (== m nil) (>= pi (-> st npreds))) (return 0))
        (if (not ($ (nth pi (-> st preds)) framed)) (return 0))
        ;; N is the answer, the frames open (or ACT 3's that see AT), and
        ;; OPEN every one open, which says whether the next walk is needed
        (let ((size_t n . 0) (size_t open . 0)
              (coco_machine * mm . #'(cast (coco_machine *) (-> st machines))))
          ;; ONE MACHINE'S FRAMES, OR EVERY MACHINE THE STORE LISTS (2.7.0):
          ;; a green world links the host and every green thread's machine,
          ;; so a suspended thread's open call counts as an open call.
          (if (== mm nil) (set mm m))
          (while (!= mm nil)
            (let ((coco_engine * e . #'(cast (coco_engine *) (-> mm eng))))
              (if (== e nil) (set e (cast (coco_engine *) (-> mm keep_eng))))
              (while (!= e nil)
                (if (== (-> e st) st)
                    (let ((size_t i . #'(-> e nchoices)))
                      (while (> i 0)
                        (set i (- i 1))
                        (let ((coco_choice * c . #'(aof (nth i (-> e choices)))))
                          (if (and (or (== (-> c kind) COCO_CH_CLAUSE) (== (-> c kind) COCO_CH_CLOCKED)
                                       (== (-> c kind) COCO_CH_DB))
                                   (== (-> c pred) pi))
                              (block
                               (set open (+ open 1))
                               (cond
                                 ((== act 0) (return open))
                                 ;; a death it lives through, the first it has
                                 ((== act 1)
                                  (set n open)
                                  (if (== (-> c fera) 0) (set (-> c fera) era)))
                                 ;; a clause at AT inside what it has still to
                                 ;; try, which no move of it can keep from it.
                                 ;; A thawed frame not bounded yet ends nowhere
                                 ;; it could keep, and is not counted
                                 ((== act 3)
                                  (if (and (< (-> c clause_ix) at) (!= (-> c cend) 4294967295)
                                           (> (cast size_t (-> c cend)) at))
                                      (set n (+ n 1))))
                                 (#t
                                  (set n open)
                                  (if (>= (-> c clause_ix) at)
                                      (block
                                       (set (-> c clause_ix) (+ (-> c clause_ix) 1))
                                       ;; a thawed frame not bounded yet stays so
                                       (if (!= (-> c cend) 4294967295)
                                           (set (-> c cend) (+ (-> c cend) 1)))))))))))))
                (set e (cast (coco_engine *) (-> e outer)))))
            (set mm (cast (coco_machine *) (-> mm st_next))))
          ;; none open: no walk until a frame is pushed on it again
          (if (== open 0) (set ($ (nth pi (-> st preds)) framed) 0))
          (return n)))

  ;;; The dispatcher comes last because it names every builtin above it, and a
  ;;; call needs the definition to have been seen.
  (coco-emit-id-fill)

  (coco-emit-builtin-dispatch)
  (coco-emit-builtin-index)
  (coco-emit-iso-predicate)

  ;;; THE ROW A FUNCTOR KEEPS (`bix', 3.1.0): K + 2 for the builtin of row
  ;;; K, and 1 for none -- or for one a program file took over
  ;;; (`coco_pred_taken'; ISO only after redefine_system_predicate/1): swipl
  ;;; calls a user file's definition of a system predicate in its place.
  ;;; Asked once per functor, by the step and by the compiler of a body's
  ;;; later goals (`cc_uplace'), and moved after only by
  ;;; `coco_pred_take_over'.
  (func coco_bix_fill ((coco_machine * m) (coco_store * st) (u64 nid) (u32 n)) (out u32)
        (let ((int row . #'(coco_builtin_index m nid n)))
          (if (< row 0) (return 1))
          (if (coco_pred_taken st nid n) (return 1))
          (return (cast u32 (+ row 2)))))

  ;;; A PROGRAM FILE TAKES PI OVER (3.1.0, `coco_assert_from', for a name
  ;;; `coco_claim_kind' answered 1): the predicate is called from now on,
  ;;; ahead of the builtin it is named after. A functor that already kept
  ;;; the builtin's row keeps none (a body compiled against the row hands
  ;;; its goal over when it finds the row gone, `coco_env_place'), and one
  ;;; a module claimed for this generation of the registry is asked again:
  ;;; the generation moves on, and the module walk passes a taken name by
  ;;; (`coco_m_taken'). An atom has no functor: the step asks the store of
  ;;; an atom goal. A construct's name -- not/1, ignore/1 -- and an ISO
  ;;; one (redefine_system_predicate/1) have every clause compiled again
  ;;; (`coco_code_forget_all'), as a body compiled before runs the construct
  ;;; or the guard in place.
  (func coco_pred_take_over ((coco_store * st) (coco_machine * m) (size_t pi) (size_t head))
        (set ($ (nth pi (-> st preds)) taken) 1)
        (set (-> st ntaken) (+ (-> st ntaken) 1))
        ;; the library's own clauses of it are the library's module's in
        ;; swipl, which the program's definition does not see
        (coco_pred_forget_muted st m pi)
        (set head (coco_deref m head))
        (if (coco-tag-is FUN (nth head (-> m heap)))
            (let ((coco_functor * f . #'(aof (nth (cast size_t (coco-payload (nth head (-> m heap))))
                                                  (-> m functors)))))
              (if (>= (-> f bix) 2) (set (-> f bix) 1))
              (if (and (== (-> f dgen) coco_extern_generation) (>= (-> f dmod) 0))
                  (set coco_extern_generation (+ coco_extern_generation 1)))
              (if (or (coco_is_construct m (-> f name))
                      (coco_iso_predicate (coco_atom_name m (-> f name)) (-> f arity)))
                  (coco_code_forget_all st))))
        ;; and the libraries' calls of it stay the builtin's, as a swipl
        ;; library module's do (`coco_sys_library', `coco_colon')
        (coco_sys_library st m))

  ;;; Whether the module walk passes NAME/ARITY by (3.1.0): a program file
  ;;; took it over -- unless `system:G' asked for the module's own
  ;;; (`systake', `coco_colon').
  (func coco_m_taken ((coco_engine * e) (const char * name) (u32 arity)) (out int)
        (if (== (-> (-> e st) ntaken) 0) (return 0))
        (if (-> e systake) (return 0))
        (return (coco_pred_taken (-> e st) (coco_intern (-> e m) name) arity)))

  ;;; THE NAMES THE ENVIRONMENT'S COMPILER TELLS A CONSTRUCT BY (Stage 6),
  ;;; from the vocabulary interned once per machine (lib/kb.cicili asks):
  ;;; NAMES[0 .. 15] the atoms `;', `->', `*->', `\+', `not', `once',
  ;;; `ignore', `,', `true', `fail', `false', `!', `$true', `$fail', `$' and
  ;;; `@', and FCUT the functor `'$cut'/1'. 0, with nothing written, before
  ;;; the vocabulary is interned. Interned at every compile instead, they
  ;;; cost each clause 1 300 instructions.
  (func coco_unit_names ((coco_machine * m) (u64 * names) (u64 * fcut)) (out int)
        (if (not (-> m ids_ready)) (return 0))
        (set (nth 14 names) (coco-id m "$"))
        (set (nth 15 names) (coco-id m "@"))
        (set (nth 0 names) (coco-id m ";"))
        (set (nth 1 names) (coco-id m "->"))
        (set (nth 2 names) (coco-id m "*->"))
        (set (nth 3 names) (coco-id m "\\+"))
        (set (nth 4 names) (coco-id m "not"))
        (set (nth 5 names) (coco-id m "once"))
        (set (nth 6 names) (coco-id m "ignore"))
        (set (nth 7 names) (coco-id m ","))
        (set (nth 8 names) (coco-id m "true"))
        (set (nth 9 names) (coco-id m "fail"))
        (set (nth 10 names) (coco-id m "false"))
        (set (nth 11 names) (coco-id m "!"))
        (set (nth 12 names) (coco-id m "$true"))
        (set (nth 13 names) (coco-id m "$fail"))
        (set (cof fcut) (coco-fid m "$cut" 1))
        (return 1))
  (coco-emit-builtin-call)

  ) ; impl-solve-db

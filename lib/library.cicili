;;;; cocolog -- the library loader: use_module, like SWI's
;;;
;;; `use_module(library(Name))' -- as a goal, and as a directive in a
;;; consulted file -- resolves Name in this order:
;;;
;;;   1. A REGISTERED MODULE of that name. Linked into the build (files,
;;;      lists, apply, builtins, dcg, torch) or loaded earlier in this
;;;      process: nothing to find, the answer is yes.
;;;   2. Name.so ON THE LIBRARY PATH: a module compiled from Cicili
;;;      against lib/sdk.cicili, dlopen'd, its `coco_library_entry'
;;;      called -- which registers it exactly as a linked-in module
;;;      registers, C half and Coco half both.
;;;   3. Name.pl ON THE LIBRARY PATH: ordinary clauses, registered as a
;;;      clauses-only module -- so they reload after a store reset (a
;;;      thaw), never write through to the knowledge base, and never
;;;      load twice, all for the same reasons a module's Coco half has
;;;      those properties.
;;;
;;; The library path is $COCOLOG_LIBRARY (colon-separated), then
;;; `./library'. A plain atom instead of `library(Name)' is a file path,
;;; tried as written and then with `.pl'.
;;;
;;; WHAT LOADING MEANS, honestly: a library loads INTO THIS PROCESS,
;;; exactly as in SWI. Its clauses are muted -- they belong to the
;;; library, not to the knowledge base -- so another process talking to
;;; the same database does not see them unless it, too, says use_module.
;;; A program that wants clauses shared across processes consults them
;;; into the knowledge base; the two are different acts and stay so.
;;;
;;; The `.so' contract (see lib/sdk.cicili, which a module author
;;; imports): the object exports `int coco_library_entry(void)', which
;;; registers the module through `coco_module_register' -- resolved from
;;; the cocolog binary itself, which is why the binary is linked with
;;; -rdynamic -- and returns the ABI version it was built against.
;;; This loader accepts version 1 and refuses anything else by name.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

(DEFPARAMETER *library-predicates*
  '(("use_module"         1 lb_use_module1)
    ("use_module"         2 lb_use_module2)
    ("ensure_loaded"      1 lb_use_module1)
    ("current_prolog_flag" 2 lb_current_flag)))

(generic decl-library
  ()

  ;;; Resolves and loads SPEC (a term in M: `library(Name)',
  ;;; `library(Dir/Name)' or a path atom) into ST. E may be null -- the
  ;;; directive path during a bare consult -- in which case a freshly
  ;;; registered module's clauses wait for the ask-time load. Answers 1
  ;;; loaded, -1 NOT FOUND, or 0 for a library that was found and would
  ;;; not load -- ERR filled in for both of the last two. The split
  ;;; matters to the directive: not-found stays silent there, because a
  ;;; borrowed file names libraries this build carries under other
  ;;; arrangements, and that has never been worth a sound.
  ;;; The vendored SWI libraries, registered at start-up so a program can
  ;;; just USE them. See the note beside the list below.
  (decl) (func coco_library_preload () (out int))

  (decl) (func coco_library_load ((coco_store * st) (coco_machine * m)
                                  (coco_engine * e) (size_t spec)
                                  (char * err) (size_t errlen)) (out int))

  ;;; Registers the `library' module (use_module/1,2, ensure_loaded/1)
  ;;; and installs the directive hook in kb.cicili. The composition root
  ;;; calls it once, with the other registrations.
  (decl) (func coco_library_module () (out int))

  ) ; decl-library


(generic impl-library
  ()

  ;;; ---- finding the file ----------------------------------------------

  ;;; DIR/NAME.EXT exists and is readable. Answers into BUF.
  (static)
  (func lb_probe ((const char * dir) (const char * name) (const char * ext)
                  (char * buf) (size_t cap)) (out int)
        (snprintf buf cap "%s/%s%s" dir name ext)
        (let ((FILE * f . #'(fopen buf "rb")))
          (if (== f nil) (return 0))
          (fclose f)
          (return 1)))

  ;;; ---- where the binary itself lives -----------------------------------
  ;;;
  ;;; THE DEFAULT PATH USED TO BE RELATIVE TO THE WORKING DIRECTORY, and
  ;;; that is only ever right by accident. `./library' finds the shipped
  ;;; libraries when cocolog is run from its own checkout and finds
  ;;; nothing at all from anywhere else -- so an installed cocolog, or one
  ;;; invoked from a project directory, could not load its OWN vendored
  ;;; libraries. Worse, it is not merely unhelpful: `./library' means a
  ;;; directory somebody else may control, so a cocolog run inside an
  ;;; untrusted tree would prefer THEIR library(lists) to its own.
  ;;;
  ;;; /proc/self/exe is the kernel's answer to "which file am I", and it
  ;;; is exact -- no argv[0] guessing, no PATH search, correct under a
  ;;; symlink because readlink resolves the whole chain. DARWIN HAS NO
  ;;; /proc, and its answer is `_NSGetExecutablePath' -- which hands back
  ;;; whatever path the binary was invoked by, so `realpath' resolves it
  ;;; the way readlink did. Both roads end in the same buffer; where
  ;;; neither is there, the answer is the empty string and the search
  ;;; simply skips those two entries.
  ;;;
  ;;; THE WHOLE PATH IS KEPT, not only its directory, because two things
  ;;; outside this file need it: library(kbs) spawns cocolog processes
  ;;; and CivV's suite drives them, and both used to read /proc/self/exe
  ;;; themselves -- silently failing on every machine without one.
  ;;; `current_prolog_flag(executable, P)' below is the one answer they
  ;;; now share.
  (static) (var char lb_exe_path [1024])
  (static) (var char lb_exe_dir [1024])
  (static) (var int lb_exe_done . 0)

  (static)
  (func lb_exe_resolve ()
        (let ((ssize_t n . 0) (size_t cut . 0))
          (if lb_exe_done (return))
          (set lb_exe_done 1)
          (set (nth 0 lb_exe_path) (cast char 0))
          (set (nth 0 lb_exe_dir) (cast char 0))
          (@ifdef (code "__APPLE__"))
          ;; neither `_NSGetExecutablePath' nor `realpath' is in the std
          ;; POSIX declarations, so both go through the raw-C escape, as
          ;; files.cicili's realpath does -- the fire escape, used for
          ;; exactly what lib/std/c does not declare
          (code "{ char raw[1024]; uint32_t cap = 1024;
                   if (_NSGetExecutablePath(raw, &cap) == 0 && realpath(raw, lb_exe_path) != NULL)
                     n = (ssize_t) strlen(lb_exe_path); }")
          (@else)
          (set n (readlink "/proc/self/exe" lb_exe_path 1023))
          (if (> n 0) (set (nth (cast size_t n) lb_exe_path) (cast char 0)))
          (@endif)
          (if (<= n 0) (block (set (nth 0 lb_exe_path) (cast char 0)) (return)))
          (strcpy lb_exe_dir lb_exe_path)
          ;; back to the last `/', which is where the directory ends
          (for ((size_t j . 0)) (< j (cast size_t n)) ((++ j))
               (if (== (nth j lb_exe_dir) (cast char 47)) (set cut j)))
          (set (nth cut lb_exe_dir) (cast char 0))))

  (static)
  (func lb_exedir () (out const char *)
        (lb_exe_resolve)
        (return lb_exe_dir))

  ;;; ---- argv ------------------------------------------------------------
  ;;;
  ;;; `--' ENDS COCOLOG'S ARGUMENTS AND EVERYTHING AFTER IT IS THE
  ;;; PROGRAM'S. That is SWI's own separator and it is not decoration here:
  ;;; `run FILE GOAL' takes the LAST argument as the goal, so without a
  ;;; separator `cocolog run p.pl main --check' would try to prove
  ;;; `--check'. With one, the option loop and the command dispatch never
  ;;; see past it -- main() simply shortens argc -- and the tail arrives
  ;;; here instead.
  ;;;
  ;;; SET BY THE COMPOSITION ROOT, because it is the only thing that has
  ;;; them: main()'s argv is on ITS stack and nothing else in the binary
  ;;; can reach it. The pointers are into that argv, which lives as long as
  ;;; the process, so nothing is copied and nothing is freed.
  (static) (var int lb_prog_argc)
  (static) (var char ** lb_prog_argv)
  (static) (var int lb_os_argc)
  (static) (var char ** lb_os_argv)

  (func lb_set_argv ((int pargc) (char ** pargv) (int oargc) (char ** oargv))
        (set lb_prog_argc pargc)
        (set lb_prog_argv pargv)
        (set lb_os_argc oargc)
        (set lb_os_argv oargv))

  ;;; [Executable | what followed `--'], which is the shape SWI answers.
  ;;; The head is the RESOLVED path -- the same answer
  ;;; `current_prolog_flag(executable, P)' gives, so a program that
  ;;; re-spawns itself out of argv[0] gets a path that works from any
  ;;; working directory -- and falls back to argv[0] as given where
  ;;; /proc and _NSGetExecutablePath both came up empty.
  (static)
  (func lb_argv_list ((coco_engine * e)) (out size_t)
        (let ((char ** v) (size_t n . 0) (size_t out . 0))
          (lb_exe_resolve)
          (set v (cast (char **) (malloc (* (sizeof (char *))
                                            (cast size_t (+ lb_prog_argc 1))))))
          (if (== v nil) (return 0))
          (set (nth 0 v) (? (!= (nth 0 lb_exe_path) (cast char 0))
                            lb_exe_path
                            (? (> lb_os_argc 0) (nth 0 lb_os_argv) "cocolog")))
          (set n 1)
          (for ((int i . 0)) (< i lb_prog_argc) ((++ i))
               (set (nth n v) (nth i lb_prog_argv))
               (set n (+ n 1)))
          (set out (coco_m_atom_list e v n))
          (free v)
          (return out)))

  ;;; THREE OF SWI'S FLAGS, AND ONLY THREE: `executable', `argv' and
  ;;; `os_argv'. cocolog has no flag table (`set_prolog_flag' in kb.cicili
  ;;; knows `double_quotes' and refuses the rest), and a
  ;;; `current_prolog_flag' that enumerated a dozen invented flags would be
  ;;; the predicate this repository's rule warns about: one that agrees
  ;;; with SWI until it does not. So these three answer and every other
  ;;; flag FAILS -- which is what SWI answers for a flag that does not
  ;;; exist.
  ;;;
  ;;; THE THREE ARE NOT ARBITRARY: each is a question about the PROCESS
  ;;; that nothing else in the language can answer. Where am I
  ;;; (`executable', which library(kbs) and CivV's suite spawn out of),
  ;;; what was I given (`argv'), and what was the whole command line
  ;;; (`os_argv'). A flag like `bounded' or `double_quotes' is a question
  ;;; about the LANGUAGE, and the honest answer to those is the one this
  ;;; file has always given: nothing.
  ;;;
  ;;; `executable' FAILS rather than answering '' where the path could not
  ;;; be found, because a program about to spawn that path had better know.
  ;;; `argv' never fails: see lb_argv_list above.
  (static)
  (func lb_current_flag ((coco_engine * e) (size_t g)) (out int)
        (let ((char flag [64]))
          (if (not (coco_m_is_atom e (coco_m_arg e g 0))) (return 0))
          (if (not (coco_m_text e (coco_m_arg e g 0) flag 64)) (return 0))
          ;; ARGV IS ALWAYS AN ANSWER, and the empty tail is the empty
          ;; tail: a program run with no `--' gets [Executable], never a
          ;; failure. `current_prolog_flag(argv, V)' failing would read as
          ;; "this Prolog has no argv" to every caller that tests it, which
          ;; is the thing this change exists to stop being true.
          (if (== 0 (strcmp flag "argv"))
              (return (coco_m_unify e (coco_m_arg e g 1) (lb_argv_list e))))
          ;; os_argv IS THE LITERAL COMMAND LINE, `--' and cocolog's own
          ;; options included -- SWI's distinction, kept because the two
          ;; questions are different: argv asks what the PROGRAM was given,
          ;; os_argv what the PROCESS was.
          (if (== 0 (strcmp flag "os_argv"))
              (return (coco_m_unify e (coco_m_arg e g 1)
                                    (coco_m_atom_list e lb_os_argv
                                                      (cast size_t lb_os_argc)))))
          ;; `double_quotes' READS BACK what set_prolog_flag/2 put there, so a
          ;; program can ask what a "..." in it will become. FOUR flags answer
          ;; now; the other three are questions about the PROCESS and this one
          ;; is about the READER, which is the first flag here that a program
          ;; can also SET.
          (if (== 0 (strcmp flag "double_quotes"))
              (let ((coco_machine * mm . #'(coco_m_machine e)) (const char * v . "codes"))
                (if (== (-> mm double_quotes) 1) (set v "chars"))
                (if (== (-> mm double_quotes) 2) (set v "atom"))
                (if (== (-> mm double_quotes) 3) (set v "string"))
                (return (coco_m_unify_atom e (coco_m_arg e g 1) v))))
          (if (!= 0 (strcmp flag "executable")) (return 0))
          (lb_exe_resolve)
          (if (== (nth 0 lb_exe_path) (cast char 0)) (return 0))
          (return (coco_m_unify_atom e (coco_m_arg e g 1) lb_exe_path))))

  ;;; A directory under the binary's own: <exedir>/SUB.
  (static)
  (func lb_probe_exe ((const char * sub) (const char * name) (const char * ext)
                      (char * buf) (size_t cap))
        (out int)
        (let ((const char * base . #'(lb_exedir)) (char dir [1024]))
          (if (== (nth 0 base) (cast char 0)) (return 0))
          (snprintf dir (sizeof dir) "%s/%s" base sub)
          (return (lb_probe dir name ext buf cap))))

  ;;; NAME.so or NAME.pl on the library path, in this order:
  ;;;   $COCOLOG_LIBRARY, split on colons   -- what the caller asked for
  ;;;   ./library                           -- a project's own, if any
  ;;;   <exedir>/library                    -- what SHIPPED with this binary
  ;;;   <exedir>/lib/swipl           -- and the vendored SWI set
  ;;; KIND answers 1 for a .so and 2 for a .pl.
  ;;;
  ;;; The caller's path first and the binary's last, because an override
  ;;; that cannot override is not one.
  (static)
  (func lb_find ((const char * name) (char * buf) (size_t cap) (int * kind)) (out int)
        (let ((const char * env . #'(getenv "COCOLOG_LIBRARY"))
              (char dir [512]))
          (if (!= env nil)
              (let ((size_t i . 0) (size_t d . 0))
                (while 1
                  (let ((char c . #'(nth i env)))
                    (if (or (== c (cast char 0)) (== c (cast char 58))) ;; ':'
                        (block
                         (set (nth d dir) (cast char 0))
                         (if (> d 0)
                             (block
                              (if (lb_probe dir name ".so" buf cap)
                                  (block (set (cof kind) 1) (return 1)))
                              (if (lb_probe dir name ".pl" buf cap)
                                  (block (set (cof kind) 2) (return 1)))))
                         (set d 0)
                         (if (== c (cast char 0)) break))
                      (if (< d 511)
                          (block (set (nth d dir) c) (set d (+ d 1)))))
                    (set i (+ i 1))))))
          (if (lb_probe "library" name ".so" buf cap)
              (block (set (cof kind) 1) (return 1)))
          (if (lb_probe "library" name ".pl" buf cap)
              (block (set (cof kind) 2) (return 1)))
          ;; Beside the BINARY, which is where an installed cocolog keeps
          ;; what shipped with it and where a cocolog run from anywhere at
          ;; all can still find its own libraries.
          (if (lb_probe_exe "library" name ".so" buf cap)
              (block (set (cof kind) 1) (return 1)))
          (if (lb_probe_exe "library" name ".pl" buf cap)
              (block (set (cof kind) 2) (return 1)))
          (if (lb_probe_exe "lib/swipl" name ".pl" buf cap)
              (block (set (cof kind) 2) (return 1)))
          ;; AND THE VENDORED SWI LIBRARIES, which were shipped and
          ;; unreachable. lib/swipl holds assoc, pairs, ordsets,
          ;; yall, aggregate, ugraphs and the two dcg files -- vendored,
          ;; documented, listed in CLAUDE.md, and on no default path at
          ;; all, so `use_module(library(assoc))' answered "not found on
          ;; the library path" on a plain checkout. Nothing told a caller
          ;; to set COCOLOG_LIBRARY, and no test did either, because every
          ;; test that used them set it for its own reasons.
          (if (lb_probe "lib/swipl" name ".pl" buf cap)
              (block (set (cof kind) 2) (return 1)))
          (return 0)))

  ;;; ---- the two loaders -------------------------------------------------

  ;;; A whole file as malloc'd text, or null.
  (static)
  (func lb_slurp ((const char * path)) (out char *)
        (let ((FILE * f . #'(fopen path "rb")) (char * buf . nil) (long n . 0))
          (if (== f nil) (return nil))
          (fseek f 0 SEEK_END)
          (set n (ftell f))
          (fseek f 0 SEEK_SET)
          (if (< n 0) (block (fclose f) (return nil)))
          (set buf (cast (char *) (malloc (+ (cast size_t n) 1))))
          (if (== buf nil) (block (fclose f) (return nil)))
          (if (and (> n 0) (!= (cast size_t n) (fread buf 1 (cast size_t n) f)))
              (block (free buf) (fclose f) (return nil)))
          (set (nth (cast size_t n) buf) (cast char 0))
          (fclose f)
          (return buf)))

  ;;; A compiled module: dlopen, check the ABI, let it register itself.
  ;;; The handle is deliberately never closed -- the registry holds
  ;;; pointers into the object for the life of the process.
  (static)
  (func lb_load_so ((const char * path) (char * err) (size_t errlen)) (out int)
        (let ((void * h . #'(dlopen path (bitor RTLD_NOW RTLD_LOCAL))))
          (if (== h nil)
              (block (snprintf err errlen "%s" (dlerror)) (return 0)))
          (let ((void * entry . #'(dlsym h "coco_library_entry")))
            (if (== entry nil)
                (block
                 (snprintf err errlen "%s exports no coco_library_entry" path)
                 (dlclose h)
                 (return 0)))
            (let ((int abi . 0))
              (set abi (code "((int (*)(void)) entry)()"))
              (if (== abi 0)
                  (block
                   (snprintf err errlen "%s would not register" path)
                   (return 0)))
              (if (!= abi 1)
                  (block
                   (snprintf err errlen "%s speaks library ABI %d and this cocolog speaks 1"
                             path abi)
                   (return 0)))))
          (return 1)))

  ;;; A Prolog library: the file's text registered as a clauses-only
  ;;; module under NAME, so reset-and-reload and never-twice come free.
  (static)
  (func lb_load_pl ((const char * path) (const char * name)
                    (char * err) (size_t errlen)) (out int)
        (let ((char * text . #'(lb_slurp path)))
          (if (== text nil)
              (block (snprintf err errlen "cannot read %s" path) (return 0)))
          (let ((char * nm . #'(strdup name)))
            (if (or (== nm nil)
                    (not (coco_module_register nm nil text nil)))
                (block (free text)
                       (snprintf err errlen "cannot register %s" path)
                       (return 0))))
          (return 1)))

  ;;; ---- resolution ------------------------------------------------------

  (func coco_library_load ((coco_store * st) (coco_machine * m)
                           (coco_engine * e) (size_t spec)
                           (char * err) (size_t errlen)) (out int)
        (set spec (coco_deref m spec))
        (let ((char name [256]) (char path [1024]) (int kind . 0) (int is_lib . 0))
          (set (nth 0 name) (cast char 0))

          ;; library(Name), library(Dir/Name), or a plain path atom
          (if (and (coco_is_callable m spec)
                   (== (coco_arity m spec) 1)
                   (== 0 (strcmp (coco_atom_name m (coco_name_of m spec)) "library")))
              (let ((size_t inner . #'(coco_deref m (coco_arg m spec 0))))
                (set is_lib 1)
                (if (coco-tag-is ATOM (nth inner (-> m heap)))
                    (snprintf name 256 "%s" (coco_atom_name m (coco_name_of m inner)))
                  (if (and (coco_is_callable m inner)
                           (== (coco_arity m inner) 2)
                           (== 0 (strcmp (coco_atom_name m (coco_name_of m inner)) "/")))
                      (let ((size_t d . #'(coco_deref m (coco_arg m inner 0)))
                            (size_t f . #'(coco_deref m (coco_arg m inner 1))))
                        (if (not (and (coco-tag-is ATOM (nth d (-> m heap)))
                                      (coco-tag-is ATOM (nth f (-> m heap)))))
                            (block (snprintf err errlen "library/1 wants an atom or Dir/Name")
                                   (return 0)))
                        (snprintf name 256 "%s/%s"
                                  (coco_atom_name m (coco_name_of m d))
                                  (coco_atom_name m (coco_name_of m f))))
                    (block (snprintf err errlen "library/1 wants an atom or Dir/Name")
                           (return 0)))))
            (if (coco-tag-is ATOM (nth spec (-> m heap)))
                (snprintf name 256 "%s" (coco_atom_name m (coco_name_of m spec)))
              (block (snprintf err errlen "use_module wants library(Name) or a file atom")
                     (return 0))))

          ;; 1. already registered, by name
          (if (!= (coco_module_find name) nil)
              (block
               (if (!= e nil) (coco_module_load st m e))
               (return 1)))

          ;; 2/3. the library path, .so before .pl
          (if is_lib
              (block
               (if (not (lb_find name path 1024 (aof kind)))
                   (block (snprintf err errlen "library(%s): not found on the library path"
                                    name)
                          (return -1))))
            ;; a plain path: as written, then with .pl; a .so is named outright
            (block
             (set kind 2)
             (let ((size_t len . #'(strlen name)))
               (if (and (> len 3) (== 0 (strcmp (aof (nth (- len 3) name)) ".so")))
                   (set kind 1)))
             (snprintf path 1024 "%s" name)
             (let ((FILE * f . #'(fopen path "rb")))
               (if (!= f nil) (fclose f)
                 (block
                  (snprintf path 1024 "%s.pl" name)
                  (let ((FILE * g . #'(fopen path "rb")))
                    (if (== g nil)
                        (block (snprintf err errlen "%s: no such file" name) (return -1)))
                    (fclose g)))))))

          (if (== kind 1)
              (block (if (not (lb_load_so path err errlen)) (return 0)))
            (block (if (not (lb_load_pl path name err errlen)) (return 0))))

          ;; the freshly registered clauses, into THIS store now when an
          ;; engine is running the goal; a directive leaves them for the
          ;; ask-time load
          (if (!= e nil)
              (if (not (coco_module_load st m e))
                  (block (snprintf err errlen "%s: its clauses would not consult" path)
                         (return 0))))
          (return 1)))

  ;;; ---- always present --------------------------------------------------
  ;;;
  ;;; SWI'S OWN LIBRARIES ARE PART OF PROLOG, not an optional extra, and
  ;;; a program that has to say `use_module(library(assoc))' before it can
  ;;; use an association list is a program doing the interpreter's
  ;;; bookkeeping. These eight are vendored in lib/swipl under their own
  ;;; BSD-2 headers and are now registered at start-up like `files' and
  ;;; `lists' -- the difference being that those are Cicili modules
  ;;; compiled in and these are read from disk beside the binary.
  ;;;
  ;;; AND IT COSTS NOTHING, which is why this is a load rather than an
  ;;; autoload. Measured across three runs: 469ms bare against 459ms with
  ;;; all eight, then 441 against 446, then 458 against 443 -- the
  ;;; difference is inside the noise of a start-up dominated by the
  ;;; embedded store and libtorch. An autoload hook on the unknown-
  ;;; predicate path would have been more machinery for a cost that is not
  ;;; there.
  ;;;
  ;;; THAT WAS ONLY TRUE LOCALLY UNTIL IT WAS TRUE EVERYWHERE. In the
  ;;; Zeytun arrangement a predicate is a page over the network, and this
  ;;; load first cost 272 extra HTTP round trips -- because `assertz' was
  ;;; fetching the shared predicate before adding each clause, MUTED
  ;;; clauses included. A module's clause never writes through, so it had
  ;;; nothing to be appended to and nothing to read first; kb.cicili now
  ;;; says so, and the whole start-up is one request instead of 440. The
  ;;; measurement is written out there, beside the line it belongs to.
  ;;;
  ;;; A MISSING FILE IS NOT AN ERROR. A cocolog whose lib/swipl did not
  ;;; travel with it still starts, and `use_module(library(assoc))' then
  ;;; fails the way it always did with a message naming the path. Refusing
  ;;; to boot over a library nobody has asked for yet would be the wrong
  ;;; trade.
  (static) (var const char * lb_always []
                . '{"assoc" "pairs" "ordsets" "yall"
                    "aggregate" "ugraphs" "dcg_basics" "dcg_high_order"})

  (func coco_library_preload () (out int)
        (let ((char path [1024]) (char err [512]) (int kind . 0) (int n . 0))
          (for ((size_t i . 0)) (< i 8) ((++ i))
               (let ((const char * name . #'(nth i lb_always)))
                 (if (== (coco_module_find name) nil)
                     (if (lb_find name path 1024 (aof kind))
                         (if (== kind 2)
                             (if (lb_load_pl path name err 512)
                                 (set n (+ n 1))))))))
          (return n)))

  ;;; ---- the module and the directive hook -------------------------------

  (static)
  (func lb_use ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((spec 0))
          (let ((char err [512]))
            (if (== 1 (coco_library_load (-> e st) (-> e m) e spec err 512))
                (return 1))
            (return (coco_m_error e "use_module" err)))))

  (func lb_use_module1 ((coco_engine * e) (size_t g)) (out int)
        (return (lb_use e g)))

  ;;; the import list is accepted and ignored: cocolog has one namespace,
  ;;; so everything a library defines is visible -- MODULES.md records the
  ;;; difference rather than pretending it away
  (func lb_use_module2 ((coco_engine * e) (size_t g)) (out int)
        (return (lb_use e g)))

  ;;; A directive stays QUIET about a library it cannot find -- the old
  ;;; tolerance, kept: borrowed files name libraries this build carries
  ;;; inside other modules. A library that was FOUND and would not load
  ;;; is another matter, and kb.cicili says so on stderr.
  (static)
  (func lb_directive_hook ((coco_store * st) (coco_machine * m) (size_t spec)) (out int)
        (let ((char err [512]))
          (return (? (== 0 (coco_library_load st m nil spec err 512)) 0 1))))

  (static) (coco-emit-module-dispatch lb_dispatch *library-predicates*)

  (func coco_library_module () (out int)
        (coco_use_module_install lb_directive_hook)
        (return (coco_module_register "library" lb_dispatch nil nil)))

  ) ; impl-library

;;;; cocolog -- the library loader: use_module, like SWI's
;;;
;;; `use_module(library(Name))' -- as a goal, and as a directive in a
;;; consulted file -- resolves Name in this order:
;;;
;;;   1. A REGISTERED MODULE of that name. Linked into the build (files,
;;;      lists, apply, builtins, dcg, torch) or loaded earlier in this
;;;      process: nothing to find, the answer is yes.
;;;   2. Name.so ON THE LIBRARY PATH: a module compiled from Cicili
;;;      against lib/sdk.cicili, dlopen'd, its `coco_library_entry'
;;;      called -- which registers it exactly as a linked-in module
;;;      registers, C half and Coco half both.
;;;   3. Name.pl ON THE LIBRARY PATH: ordinary clauses, registered as a
;;;      clauses-only module -- so they reload after a store reset (a
;;;      thaw), never write through to the knowledge base, and never
;;;      load twice, all for the same reasons a module's Coco half has
;;;      those properties.
;;;
;;; The library path is $COCOLOG_LIBRARY (colon-separated), then
;;; `./library'. A plain atom instead of `library(Name)' is a file path,
;;; tried as written and then with `.pl'.
;;;
;;; WHAT LOADING MEANS, honestly: a library loads INTO THIS PROCESS,
;;; exactly as in SWI. Its clauses are muted -- they belong to the
;;; library, not to the knowledge base -- so another process talking to
;;; the same database does not see them unless it, too, says use_module.
;;; A program that wants clauses shared across processes consults them
;;; into the knowledge base; the two are different acts and stay so.
;;;
;;; The `.so' contract (see lib/sdk.cicili, which a module author
;;; imports): the object exports `int coco_library_entry(void)', which
;;; registers the module through `coco_module_register' -- resolved from
;;; the cocolog binary itself, which is why the binary is linked with
;;; -rdynamic -- and returns the ABI version it was built against.
;;; This loader accepts version 1 and refuses anything else by name.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

(DEFPARAMETER *library-predicates*
  '(("use_module"         1 lb_use_module1 :declines)
    ("use_module"         2 lb_use_module2 :declines)
    ("ensure_loaded"      1 lb_use_module1 :declines)
    ("current_prolog_flag" 2 lb_current_flag :declines)
    ("set_prolog_flag"     2 lb_set_flag)
    ;; the two primitives the Coco half below is built from (2.13.0)
    ("$lf_file"            2 lb_load_file)
    ("$lf_say"             1 lb_say)
    ;; absolute_file_name/3's library path, lb_find's (3.1.0)
    ("$library_dirs"       1 lb_library_dirs)))

;;; CONSULT/1, LOAD_FILES/2 AND `[File]' AS GOALS (2.13.0), SWI's, which
;;; through 2.12 were not there: a program that loaded a file at run time
;;; stopped at existence_error(procedure, consult/1). Clauses, because a
;;; LIST of files is walked here, a file at a time, and so the files still
;;; to load ride on the engine's own continuation -- which a collection in
;;; one file's directives moves -- rather than in a C frame's cells. What
;;; one file is, is `$lf_file'/2's (below, in C).
;;;
;;; SWI's shapes, read off swipl 9.0.4: an unbound file and a partial
;;; option list are instantiation errors, an option list that is no list a
;;; type error naming its tail; a single file's error is raised, while in
;;; a list each file's is PRINTED and the next file loaded; and options
;;; this loader has nothing to do with are ignored, as SWI ignores one it
;;; does not know. The first if(C) is taken, as option/2 takes it, and
;;; must_be_module(true) is use_module/1's. A code list is one name, which
;;; under the codes default is what "file" reads as. A list's TAIL is
;;; checked before any file is loaded (3.0.0, swipl's): a partial list is
;;; the instantiation_error, any other tail type_error(list, Tail) --
;;; through 2.16 each file before it was loaded and reported first.
(DEFPARAMETER *library-prolog*
  (FORMAT NIL "~{~A ~}"
          (LIST
           ;; the flags current_prolog_flag/2 answers, for a flag it was not
           ;; given (3.0.0): its C half declines that goal to this clause
           "current_prolog_flag(F, V) :- var(F), member(F, [bounded, max_integer, min_integer, max_tagged_integer, min_tagged_integer, float_overflow, float_zero_div, float_undefined, float_underflow, float_min, float_max, float_max_integer, double_quotes, text_units, verbose, argv, os_argv, executable]), current_prolog_flag(F, V)."
           "consult(Files) :- '$lf_load'(Files, true)."
           ;; ONE FILE IN BRACKETS IS consult/1 OF THE FILE (2.14.0), swipl's
           ;; `[X] :- !, consult(X).': a missing one raises, as consult(F)
           ;; does, where a longer list reports it and goes on
           "[File] :- !, '$lf_load'(File, true)."
           "[File|Files] :- '$lf_load'([File|Files], true)."
           ;; load_files/2's IF rides as lf(If), so that its C half refuses a
           ;; number as swipl's load_files/2 does (3.4.0), where consult/1 and
           ;; `[N]' look for the file its text names
           "load_files(Files, Options) :- '$lf_list'(Options), '$lf_if'(Options, If), '$lf_load'(Files, lf(If))."

           "'$lf_list'(L) :- var(L), !, throw(error(instantiation_error, _))."
           "'$lf_list'([]) :- !."
           "'$lf_list'([_|T]) :- !, '$lf_list'(T)."
           "'$lf_list'(L) :- throw(error(type_error(list, L), _))."

           "'$lf_if'(Os, module) :- '$lf_opt'(must_be_module(true), Os), !."
           "'$lf_if'(Os, If) :- '$lf_opt'(if(If), Os), atom(If), !."
           "'$lf_if'(_, true)."
           "'$lf_opt'(O, [X|_]) :- nonvar(X), X = O, !."
           "'$lf_opt'(O, [_|Xs]) :- '$lf_opt'(O, Xs)."

           "'$lf_load'(F, _) :- var(F), !, throw(error(instantiation_error, _))."
           "'$lf_load'([], _) :- !."
           "'$lf_load'([C|Cs], If) :- integer(C), !, atom_codes(F, [C|Cs]), '$lf_file'(F, If)."
           "'$lf_load'([F|Fs], If) :- !, '$lf_tail'(Fs), '$lf_each'([F|Fs], If)."
           "'$lf_tail'(T) :- var(T), !, throw(error(instantiation_error, _))."
           "'$lf_tail'([]) :- !."
           "'$lf_tail'([_|T]) :- !, '$lf_tail'(T)."
           "'$lf_tail'(T) :- throw(error(type_error(list, T), _))."
           "'$lf_load'(F, If) :- '$lf_file'(F, If)."

           "'$lf_each'(T, _) :- var(T), !, throw(error(instantiation_error, _))."
           "'$lf_each'([], _) :- !."
           "'$lf_each'([F|Fs], If) :- !, catch('$lf_load'(F, If), E, '$lf_failed'(E)), '$lf_each'(Fs, If)."
           "'$lf_each'(T, _) :- throw(error(type_error(list, T), _))."
           ;; a file's ERROR is reported and the list goes on; a signal and
           ;; a program's own ball are not the file's, and go on up
           "'$lf_failed'(error(signal(S, N), C)) :- !, throw(error(signal(S, N), C))."
           "'$lf_failed'(error(F, C)) :- !, '$lf_say'(error(F, C))."
           "'$lf_failed'(E) :- throw(E)."
           ;; A LIST OF FILES TO use_module/1,2 AND ensure_loaded/1 (3.4.0),
           ;; swipl's: the C half declines a list to these clauses, which
           ;; load each file and report a file's error and go on, as a list
           ;; to load_files/2 does. A list of codes is one name, the C's.
           "use_module(Files) :- '$lf_mods'(Files)."
           "use_module(Files, _) :- '$lf_mods'(Files)."
           "ensure_loaded(Files) :- '$lf_mods'(Files)."
           "'$lf_mods'(Fs) :- '$lf_tail'(Fs), '$lf_mod_each'(Fs)."
           "'$lf_mod_each'([])."
           "'$lf_mod_each'([F|Fs]) :- catch(use_module(F), E, '$lf_failed'(E)), '$lf_mod_each'(Fs).")))

;;; The Coco half's text where the registration wants it: a macro that
;;; expands to the string, as `coco-defmodule' splices one.
(DEFMACRO lb-prolog-text () *library-prolog*)

(generic decl-library
  ()

  ;;; Resolves and loads SPEC (a term in M: `library(Name)',
  ;;; `library(Dir/Name)' or a path atom) into ST. E may be null -- the
  ;;; directive path during a bare consult -- in which case a freshly
  ;;; registered module's clauses wait for the ask-time load. Answers 1
  ;;; loaded, -1 NOT FOUND, or 0 for a library that was found and would
  ;;; not load -- ERR filled in for both of the last two. The split
  ;;; matters to the directive: not-found stays silent there, because a
  ;;; borrowed file names libraries this build carries under other
  ;;; arrangements, and that has never been worth a sound.
  ;;; The vendored SWI libraries, registered at start-up so a program can
  ;;; just USE them. See the note beside the list below.
  (decl) (func coco_library_preload () (out int))

  (decl) (func coco_library_load ((coco_store * st) (coco_machine * m)
                                  (coco_engine * e) (size_t spec)
                                  (char * err) (size_t errlen)) (out int))

  ;;; Registers the `library' module (use_module/1,2, ensure_loaded/1,
  ;;; consult/1, load_files/2) and installs the directive hook in
  ;;; kb.cicili. The composition root calls it once, with the other
  ;;; registrations.
  (decl) (func coco_library_module () (out int))

  ;;; Notes in ST that the file at PATH is being consulted into it now
  ;;; (2.13.0, the store's `loads'): its real path and its time_file/2.
  ;;; Every consult a host makes calls it before the read -- `run', the
  ;;; `consult' command, the toplevel -- as consult/1 and load_files/2 do,
  ;;; so ensure_loaded/1 knows the file is there and `if(changed)' when it
  ;;; was read. Answers whether ST had noted it before (2.14.1), which is
  ;;; the read's AGAIN (`coco_consult_again'): a file read into the store
  ;;; again places its clauses as swipl's reload does.
  (decl) (func coco_library_note_load ((coco_store * st) (const char * path)) (out int))

  ) ; decl-library


(generic impl-library
  ()

  ;;; ---- finding the file ----------------------------------------------

  ;;; DIR/NAME.EXT exists and is readable. Answers into BUF.
  (static)
  (func lb_probe ((const char * dir) (const char * name) (const char * ext)
                  (char * buf) (size_t cap)) (out int)
        (snprintf buf cap "%s/%s%s" dir name ext)
        (let ((FILE * f . #'(fopen buf "rb")))
          (if (== f nil) (return 0))
          (fclose f)
          (return 1)))

  ;;; ---- where the binary itself lives -----------------------------------
  ;;;
  ;;; THE DEFAULT PATH USED TO BE RELATIVE TO THE WORKING DIRECTORY, and
  ;;; that is only ever right by accident. `./library' finds the shipped
  ;;; libraries when cocolog is run from its own checkout and finds
  ;;; nothing at all from anywhere else -- so an installed cocolog, or one
  ;;; invoked from a project directory, could not load its OWN vendored
  ;;; libraries. Worse, it is not merely unhelpful: `./library' means a
  ;;; directory somebody else may control, so a cocolog run inside an
  ;;; untrusted tree would prefer THEIR library(lists) to its own.
  ;;;
  ;;; /proc/self/exe is the kernel's answer to "which file am I", and it
  ;;; is exact -- no argv[0] guessing, no PATH search, correct under a
  ;;; symlink because readlink resolves the whole chain. DARWIN HAS NO
  ;;; /proc, and its answer is `_NSGetExecutablePath' -- which hands back
  ;;; whatever path the binary was invoked by, so `realpath' resolves it
  ;;; the way readlink did. Both roads end in the same buffer; where
  ;;; neither is there, the answer is the empty string and the search
  ;;; simply skips those two entries.
  ;;;
  ;;; THE WHOLE PATH IS KEPT, not only its directory, because two things
  ;;; outside this file need it: library(kbs) spawns cocolog processes
  ;;; and CivV's suite drives them, and both used to read /proc/self/exe
  ;;; themselves -- silently failing on every machine without one.
  ;;; `current_prolog_flag(executable, P)' below is the one answer they
  ;;; now share.
  (static) (var char lb_exe_path [1024])
  (static) (var char lb_exe_dir [1024])
  (static) (var int lb_exe_done . 0)

  (static)
  (func lb_exe_resolve ()
        (let ((ssize_t n . 0) (size_t cut . 0))
          (if lb_exe_done (return))
          (set lb_exe_done 1)
          (set (nth 0 lb_exe_path) (cast char 0))
          (set (nth 0 lb_exe_dir) (cast char 0))
          (@ifdef (code "__APPLE__"))
          ;; neither `_NSGetExecutablePath' nor `realpath' is in the std
          ;; POSIX declarations, so both go through the raw-C escape, as
          ;; files.cicili's realpath does -- the fire escape, used for
          ;; exactly what lib/std/c does not declare
          (code "{ char raw[1024]; uint32_t cap = 1024;
                   if (_NSGetExecutablePath(raw, &cap) == 0 && realpath(raw, lb_exe_path) != NULL)
                     n = (ssize_t) strlen(lb_exe_path); }")
          (@else)
          (set n (readlink "/proc/self/exe" lb_exe_path 1023))
          (if (> n 0) (set (nth (cast size_t n) lb_exe_path) (cast char 0)))
          (@endif)
          (if (<= n 0) (block (set (nth 0 lb_exe_path) (cast char 0)) (return)))
          ;; BOUNDED, though it cannot overflow today: both arrays are 1024
          ;; and the path is at most 1023 bytes on either branch above. The
          ;; bound is what keeps that true if one of them ever changes size.
          (snprintf lb_exe_dir (sizeof lb_exe_dir) "%s" lb_exe_path)
          ;; back to the last `/', which is where the directory ends
          (for ((size_t j . 0)) (< j (cast size_t n)) ((++ j))
               (if (== (nth j lb_exe_dir) (cast char 47)) (set cut j)))
          (set (nth cut lb_exe_dir) (cast char 0))))

  (static)
  (func lb_exedir () (out const char *)
        (lb_exe_resolve)
        (return lb_exe_dir))

  ;;; ---- argv ------------------------------------------------------------
  ;;;
  ;;; `--' ENDS COCOLOG'S ARGUMENTS AND EVERYTHING AFTER IT IS THE
  ;;; PROGRAM'S. That is SWI's own separator and it is not decoration here:
  ;;; `run FILE GOAL' takes the LAST argument as the goal, so without a
  ;;; separator `cocolog run p.pl main --check' would try to prove
  ;;; `--check'. With one, the option loop and the command dispatch never
  ;;; see past it -- main() simply shortens argc -- and the tail arrives
  ;;; here instead.
  ;;;
  ;;; SET BY THE COMPOSITION ROOT, because it is the only thing that has
  ;;; them: main()'s argv is on ITS stack and nothing else in the binary
  ;;; can reach it. The pointers are into that argv, which lives as long as
  ;;; the process, so nothing is copied and nothing is freed.
  (static) (var int lb_prog_argc)
  (static) (var char ** lb_prog_argv)
  (static) (var int lb_os_argc)
  (static) (var char ** lb_os_argv)

  (func lb_set_argv ((int pargc) (char ** pargv) (int oargc) (char ** oargv))
        (set lb_prog_argc pargc)
        (set lb_prog_argv pargv)
        (set lb_os_argc oargc)
        (set lb_os_argv oargv))

  ;;; [Executable | what followed `--'], which is the shape SWI answers.
  ;;; The head is the RESOLVED path -- the same answer
  ;;; `current_prolog_flag(executable, P)' gives, so a program that
  ;;; re-spawns itself out of argv[0] gets a path that works from any
  ;;; working directory -- and falls back to argv[0] as given where
  ;;; /proc and _NSGetExecutablePath both came up empty.
  (static)
  (func lb_argv_list ((coco_engine * e)) (out size_t)
        (let ((char ** v) (size_t n . 0) (size_t out . 0))
          (lb_exe_resolve)
          (set v (cast (char **) (malloc (* (sizeof (char *))
                                            (cast size_t (+ lb_prog_argc 1))))))
          (if (== v nil) (return 0))
          (set (nth 0 v) (? (!= (nth 0 lb_exe_path) (cast char 0))
                            lb_exe_path
                            (? (> lb_os_argc 0) (nth 0 lb_os_argv) "cocolog")))
          (set n 1)
          (for ((int i . 0)) (< i lb_prog_argc) ((++ i))
               (set (nth n v) (nth i lb_prog_argv))
               (set n (+ n 1)))
          (set out (coco_m_atom_list e v n))
          (free v)
          (return out)))

  ;;; THE PROCESS'S THREE OF SWI'S FLAGS: `executable', `argv' and
  ;;; `os_argv'. cocolog has no flag table (`lb_set_flag' below sets seven,
  ;;; the float four among them, and refuses the rest), and a
  ;;; `current_prolog_flag' that enumerated a dozen invented flags would be
  ;;; the predicate this repository's rule warns about: one that agrees
  ;;; with SWI until it does not. So these three and the language's below
  ;;; answer, and every other flag FAILS -- which is what SWI answers for a
  ;;; flag that does not exist.
  ;;;
  ;;; THE THREE ARE NOT ARBITRARY: each is a question about the PROCESS
  ;;; that nothing else in the language can answer. Where am I
  ;;; (`executable', which library(kbs) and CivV's suite spawn out of),
  ;;; what was I given (`argv'), and what was the whole command line
  ;;; (`os_argv'). A flag about the LANGUAGE answers only where the
  ;;; answer is true and a program can act on it: `double_quotes' and
  ;;; `text_units', which a program also sets, and since 2.0.0 the five
  ;;; about its integers -- `bounded' is true, `max_integer' and
  ;;; `min_integer' are 64 bits' ends, past which arithmetic raises
  ;;; evaluation_error(int_overflow), and `max_tagged_integer' and
  ;;; `min_tagged_integer' the 60 bits' a cell keeps without a table.
  ;;;
  ;;; `executable' FAILS rather than answering '' where the path could not
  ;;; be found, because a program about to spawn that path had better know.
  ;;; `argv' never fails: see lb_argv_list above.
  ;;;
  ;;; `verbose' (2.16.0) is the process's, as swipl's: empty is `normal'.
  (static) (var char lb_verbose [64])

  (static)
  (func lb_current_flag ((coco_engine * e) (size_t g) (int * found)) (out int)
        (let ((char flag [64]))
          ;; AN UNBOUND FLAG ENUMERATES (3.0.0), declined to the Coco half's
          ;; clause, which asks again of each flag this answers; anything
          ;; but an atom is type_error(atom, F), swipl's. Through 2.16 both
          ;; failed.
          (if (coco_m_is_var e (coco_m_arg e g 0))
              (block (coco_m_decline e) (set (cof found) 0) (return 0)))
          (if (not (coco_m_is_atom e (coco_m_arg e g 0)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (if (not (coco_m_text e (coco_m_arg e g 0) flag 64)) (return 0))
          ;; ARGV IS ALWAYS AN ANSWER, and the empty tail is the empty
          ;; tail: a program run with no `--' gets [Executable], never a
          ;; failure. `current_prolog_flag(argv, V)' failing would read as
          ;; "this Prolog has no argv" to every caller that tests it, which
          ;; is the thing this change exists to stop being true.
          (if (== 0 (strcmp flag "argv"))
              (return (coco_m_unify e (coco_m_arg e g 1) (lb_argv_list e))))
          ;; os_argv IS THE LITERAL COMMAND LINE, `--' and cocolog's own
          ;; options included -- SWI's distinction, kept because the two
          ;; questions are different: argv asks what the PROGRAM was given,
          ;; os_argv what the PROCESS was.
          (if (== 0 (strcmp flag "os_argv"))
              (return (coco_m_unify e (coco_m_arg e g 1)
                                    (coco_m_atom_list e lb_os_argv
                                                      (cast size_t lb_os_argc)))))
          ;; `double_quotes' READS BACK what set_prolog_flag/2 put there, so a
          ;; program can ask what a "..." in it will become. FOUR flags answer
          ;; now; the other three are questions about the PROCESS and this one
          ;; is about the READER, which is the first flag here that a program
          ;; can also SET.
          (if (== 0 (strcmp flag "double_quotes"))
              (let ((coco_machine * mm . #'(coco_m_machine e)) (const char * v . "codes"))
                (if (== (-> mm double_quotes) 1) (set v "chars"))
                (if (== (-> mm double_quotes) 2) (set v "atom"))
                (if (== (-> mm double_quotes) 3) (set v "string"))
                (return (coco_m_unify_atom e (coco_m_arg e g 1) v))))
          ;; `text_units' (1.13.0): bytes or characters, as set_prolog_flag/2
          ;; or COCOLOG_TEXT_UNITS left it for this machine
          (if (== 0 (strcmp flag "text_units"))
              (return (coco_m_unify_atom e (coco_m_arg e g 1)
                                         (? (-> (coco_m_machine e) text_chars) "characters" "bytes"))))
          ;; THE INTEGERS (2.0.0): 64 bits, and SWI's names for their ends
          (if (== 0 (strcmp flag "bounded"))
              (return (coco_m_unify_atom e (coco_m_arg e g 1) "true")))
          (if (== 0 (strcmp flag "max_integer"))
              (return (coco_m_unify_int e (coco_m_arg e g 1) 9223372036854775807)))
          (if (== 0 (strcmp flag "min_integer"))
              (return (coco_m_unify_int e (coco_m_arg e g 1) (- -9223372036854775807 1))))
          (if (== 0 (strcmp flag "max_tagged_integer"))
              (return (coco_m_unify_int e (coco_m_arg e g 1) 576460752303423487)))
          (if (== 0 (strcmp flag "min_tagged_integer"))
              (return (coco_m_unify_int e (coco_m_arg e g 1) -576460752303423488)))
          ;; THE FLOATS (2.2.2): what a float that is no number becomes, as
          ;; set_prolog_flag/2 left it for this machine (`fflags'), and
          ;; swipl's three read-only bounds -- the least normal double, the
          ;; greatest, and 2^53, past which a double holds no odd integer
          (let ((int fl . #'(-> (coco_m_machine e) fflags)))
            (if (== 0 (strcmp flag "float_overflow"))
                (return (coco_m_unify_atom e (coco_m_arg e g 1) (? (!= 0 (bitand fl 1)) "infinity" "error"))))
            (if (== 0 (strcmp flag "float_zero_div"))
                (return (coco_m_unify_atom e (coco_m_arg e g 1) (? (!= 0 (bitand fl 2)) "infinity" "error"))))
            (if (== 0 (strcmp flag "float_undefined"))
                (return (coco_m_unify_atom e (coco_m_arg e g 1) (? (!= 0 (bitand fl 4)) "nan" "error"))))
            (if (== 0 (strcmp flag "float_underflow"))
                (return (coco_m_unify_atom e (coco_m_arg e g 1) (? (!= 0 (bitand fl 8)) "error" "ignore")))))
          (if (== 0 (strcmp flag "float_min"))
              (return (coco_m_unify_float e (coco_m_arg e g 1) 2.2250738585072014e-308)))
          (if (== 0 (strcmp flag "float_max"))
              (return (coco_m_unify_float e (coco_m_arg e g 1) 1.7976931348623157e308)))
          (if (== 0 (strcmp flag "float_max_integer"))
              (return (coco_m_unify_float e (coco_m_arg e g 1) 9007199254740992.0)))
          ;; `verbose' (2.16.0): swipl's `normal', which `swipl -q' makes
          ;; `silent' and print_message/2 reads -- under `silent' an
          ;; informational or banner message prints nothing
          (if (== 0 (strcmp flag "verbose"))
              (return (coco_m_unify_atom e (coco_m_arg e g 1)
                                         (? (== (nth 0 lb_verbose) (cast char 0)) "normal" lb_verbose))))
          (if (!= 0 (strcmp flag "executable")) (return 0))
          (lb_exe_resolve)
          (if (== (nth 0 lb_exe_path) (cast char 0)) (return 0))
          (return (coco_m_unify_atom e (coco_m_arg e g 1) lb_exe_path))))

  ;;; THE VALUE OF V, an atom no longer than CAP, or the raise's answer as
  ;;; set_prolog_flag/2 says it: instantiation_error, type_error(atom, V),
  ;;; and an atom too long for any flag's value a domain error in DOMAIN.
  ;;; 1 when VAL holds it.
  (static)
  (func lb_flag_value ((coco_engine * e) (size_t v) (const char * domain)
                       (char * val) (size_t cap) (int * rc)) (out int)
        (if (coco_m_is_var e v) (block (set (cof rc) (coco_m_instantiation_error e)) (return 0)))
        (if (not (coco_m_is_atom e v)) (block (set (cof rc) (coco_m_type_error e "atom" v)) (return 0)))
        (if (not (coco_m_text e v val cap))
            (block (set (cof rc) (coco_m_domain_error e domain v)) (return 0)))
        (return 1))

  ;;; SET_PROLOG_FLAG/2 AS A GOAL (2.2.2), swipl's, which through 2.2.1 was
  ;;; only a directive. The flag is asked about first, then the value, each
  ;;; refused in swipl's words: an unbound one instantiation_error; a flag
  ;;; that is no atom type_error(atom, F); one cocolog does not have
  ;;; existence_error(prolog_flag, F) -- swipl's answer under its
  ;;; user_flags `error', where by default it makes the flag, and cocolog
  ;;; has no table to make one in --; one current_prolog_flag/2 answers and
  ;;; nothing sets permission_error(modify, flag, F) (argv and os_argv
  ;;; among them, which swipl lets a program set); a value that is no atom
  ;;; type_error(atom, V); and one the flag does not take
  ;;; domain_error(flag_value, V), where double_quotes and text_units name
  ;;; themselves, as swipl's double_quotes does. A value it already has
  ;;; succeeds.
  ;;;
  ;;; THE FOUR FLOAT FLAGS are this machine's (`fflags', lib/term.cicili)
  ;;; and the process's default for a machine made after them, a thread's
  ;;; or run_isolated/2's, as text_units is. double_quotes changes what this
  ;;; machine's reader builds from here on, text_units what its text
  ;;; builtins count, and generate_debug_info takes swipl's booleans and
  ;;; changes nothing: cocolog makes no debugging metadata to switch off.
  ;;; As a directive those last three are answered in kb.cicili, before
  ;;; the next clause is read; the float flags come here, as any goal a
  ;;; directive runs does.
  (static)
  (func lb_set_flag ((coco_engine * e) (size_t g)) (out int)
        (let ((char flag [64]) (char val [64]) (int rc . 0) (int bit . 0)
              (const char * on . nil) (const char * off . nil)
              (size_t f . #'(coco_m_arg e g 0)) (size_t v . #'(coco_m_arg e g 1))
              (coco_machine * mm . #'(coco_m_machine e)))
          (if (coco_m_is_var e f) (return (coco_m_instantiation_error e)))
          (if (not (coco_m_is_atom e f)) (return (coco_m_type_error e "atom" f)))
          (if (not (coco_m_text e f flag 64)) (return (coco_m_existence_error e "prolog_flag" f)))
          (if (or (== 0 (strcmp flag "argv")) (== 0 (strcmp flag "os_argv"))
                  (== 0 (strcmp flag "executable")) (== 0 (strcmp flag "bounded"))
                  (== 0 (strcmp flag "max_integer")) (== 0 (strcmp flag "min_integer"))
                  (== 0 (strcmp flag "max_tagged_integer")) (== 0 (strcmp flag "min_tagged_integer"))
                  (== 0 (strcmp flag "float_min")) (== 0 (strcmp flag "float_max"))
                  (== 0 (strcmp flag "float_max_integer")))
              (return (coco_m_permission_error e "modify" "flag" f)))
          ;; each float flag a bit, the word that sets it and the one that
          ;; clears it: float_underflow's bit is `error', its default
          ;; `ignore' the bit clear, so 0 is swipl's defaults for all four
          (cond
            ((== 0 (strcmp flag "float_overflow"))  (set bit 1) (set on "infinity") (set off "error"))
            ((== 0 (strcmp flag "float_zero_div"))  (set bit 2) (set on "infinity") (set off "error"))
            ((== 0 (strcmp flag "float_undefined")) (set bit 4) (set on "nan")      (set off "error"))
            ((== 0 (strcmp flag "float_underflow")) (set bit 8) (set on "error")    (set off "ignore")))
          (if (!= bit 0)
              (block
               (if (not (lb_flag_value e v "flag_value" val 64 (aof rc))) (return rc))
               (cond
                 ((== 0 (strcmp val on))  (set (-> mm fflags) (bitor (-> mm fflags) bit)))
                 ((== 0 (strcmp val off)) (set (-> mm fflags) (bitand (-> mm fflags) (- 15 bit))))
                 (#t (return (coco_m_domain_error e "flag_value" v))))
               (coco_fflags_default_set (-> mm fflags))
               (return 1)))
          (if (== 0 (strcmp flag "double_quotes"))
              (block
               (if (not (lb_flag_value e v "double_quotes" val 64 (aof rc))) (return rc))
               (cond
                 ((== 0 (strcmp val "codes"))  (set (-> mm double_quotes) 0))
                 ((== 0 (strcmp val "chars"))  (set (-> mm double_quotes) 1))
                 ((== 0 (strcmp val "atom"))   (set (-> mm double_quotes) 2))
                 ((== 0 (strcmp val "string")) (set (-> mm double_quotes) 3))
                 (#t (return (coco_m_domain_error e "double_quotes" v))))
               (return 1)))
          (if (== 0 (strcmp flag "text_units"))
              (block
               (if (not (lb_flag_value e v "text_units" val 64 (aof rc))) (return rc))
               (cond
                 ((== 0 (strcmp val "bytes"))      (set (-> mm text_chars) 0))
                 ((== 0 (strcmp val "characters")) (set (-> mm text_chars) 1))
                 (#t (return (coco_m_domain_error e "text_units" v))))
               (coco_text_default_set (-> mm text_chars))
               (return 1)))
          ;; `verbose' (2.16.0) takes any atom, as swipl's does, and is the
          ;; process's: print_message/2 reads `silent' alone
          (if (== 0 (strcmp flag "verbose"))
              (block
               (if (not (lb_flag_value e v "flag_value" val 64 (aof rc))) (return rc))
               (snprintf lb_verbose (sizeof lb_verbose) "%s" val)
               (coco_verbose_silent_set (== 0 (strcmp val "silent")))
               (return 1)))
          (if (== 0 (strcmp flag "generate_debug_info"))
              (block
               (if (coco_m_is_var e v) (return (coco_m_instantiation_error e)))
               (if (and (coco_m_is_atom e v) (coco_m_text e v val 64)
                        (or (== 0 (strcmp val "true")) (== 0 (strcmp val "false"))
                            (== 0 (strcmp val "on")) (== 0 (strcmp val "off"))))
                   (return 1))
               (return (coco_m_type_error e "bool" v))))
          (return (coco_m_existence_error e "prolog_flag" f))))

  ;;; A directory under the binary's own: <exedir>/SUB.
  (static)
  (func lb_probe_exe ((const char * sub) (const char * name) (const char * ext)
                      (char * buf) (size_t cap))
        (out int)
        (let ((const char * base . #'(lb_exedir)) (char dir [1024]))
          (if (== (nth 0 base) (cast char 0)) (return 0))
          (snprintf dir (sizeof dir) "%s/%s" base sub)
          (return (lb_probe dir name ext buf cap))))

  ;;; NAME.so or NAME.pl on the library path, in this order:
  ;;;   $COCOLOG_LIBRARY, split on colons   -- what the caller asked for
  ;;;   ./library                           -- a project's own, if any
  ;;;   <exedir>/library                    -- what SHIPPED with this binary
  ;;;   <exedir>/lib/swipl           -- and the vendored SWI set
  ;;; KIND answers 1 for a .so and 2 for a .pl.
  ;;;
  ;;; The caller's path first and the binary's last, because an override
  ;;; that cannot override is not one.
  (static)
  (func lb_find ((const char * name) (char * buf) (size_t cap) (int * kind)) (out int)
        (let ((const char * env . #'(getenv "COCOLOG_LIBRARY"))
              (char dir [512]))
          (if (!= env nil)
              (let ((size_t i . 0) (size_t d . 0))
                (while 1
                  (let ((char c . #'(nth i env)))
                    (if (or (== c (cast char 0)) (== c (cast char 58))) ;; ':'
                        (block
                         (set (nth d dir) (cast char 0))
                         (if (> d 0)
                             (block
                              (if (lb_probe dir name ".so" buf cap)
                                  (block (set (cof kind) 1) (return 1)))
                              (if (lb_probe dir name ".pl" buf cap)
                                  (block (set (cof kind) 2) (return 1)))))
                         (set d 0)
                         (if (== c (cast char 0)) break))
                      (if (< d 511)
                          (block (set (nth d dir) c) (set d (+ d 1)))))
                    (set i (+ i 1))))))
          (if (lb_probe "library" name ".so" buf cap)
              (block (set (cof kind) 1) (return 1)))
          (if (lb_probe "library" name ".pl" buf cap)
              (block (set (cof kind) 2) (return 1)))
          ;; Beside the BINARY, which is where an installed cocolog keeps
          ;; what shipped with it and where a cocolog run from anywhere at
          ;; all can still find its own libraries.
          (if (lb_probe_exe "library" name ".so" buf cap)
              (block (set (cof kind) 1) (return 1)))
          (if (lb_probe_exe "library" name ".pl" buf cap)
              (block (set (cof kind) 2) (return 1)))
          (if (lb_probe_exe "lib/swipl" name ".pl" buf cap)
              (block (set (cof kind) 2) (return 1)))
          ;; AND THE VENDORED SWI LIBRARIES, which were shipped and
          ;; unreachable. lib/swipl holds assoc, pairs, ordsets,
          ;; yall, aggregate, ugraphs and the two dcg files -- vendored,
          ;; documented, listed in CLAUDE.md, and on no default path at
          ;; all, so `use_module(library(assoc))' answered "not found on
          ;; the library path" on a plain checkout. Nothing told a caller
          ;; to set COCOLOG_LIBRARY, and no test did either, because every
          ;; test that used them set it for its own reasons.
          (if (lb_probe "lib/swipl" name ".pl" buf cap)
              (block (set (cof kind) 2) (return 1)))
          (return 0)))

  ;;; `'$library_dirs'(-Dirs)' (3.1.0): the directories lb_find above
  ;;; searches, in its order, as atoms whether or not each is there -- each
  ;;; entry of $COCOLOG_LIBRARY, `library', the binary's own library and
  ;;; lib/swipl, then `lib/swipl'. The `library' and `foreign' aliases of
  ;;; absolute_file_name/3 (lib/files.cicili) are these, so the library(X)
  ;;; a program finds there is the one use_module/1 would load.
  (func lb_library_dirs ((coco_engine * e) (size_t g)) (out int)
        (let ((const char * env . #'(getenv "COCOLOG_LIBRARY"))
              (const char * base . #'(lb_exedir))
              (size_t el . 0) (size_t slots . 5) (size_t n . 0) (size_t out . 0)
              (char * text . nil) (char ** v . nil)
              (char lib [1100]) (char swi [1100]))
          (if (!= env nil) (set el (strlen env)))
          (for ((size_t i . 0)) (< i el) ((++ i))
            (if (== (nth i env) (cast char 58)) (set slots (+ slots 1))))
          (set slots (+ slots 1))
          (set text (cast (char *) (malloc (+ el 1))))
          (set v (cast (char **) (malloc (* slots (sizeof (char *))))))
          (if (or (== text nil) (== v nil))
              (block (free text) (free v) (return (coco_m_resource_error e "memory"))))
          (if (!= env nil) (memcpy text env el))
          (set (nth el text) (cast char 0))
          ;; each non-empty entry, cut at its colon
          (let ((size_t start . 0))
            (for ((size_t i . 0)) (<= i el) ((++ i))
              (if (or (== i el) (== (nth i text) (cast char 58)))
                  (block (set (nth i text) (cast char 0))
                         (if (> i start)
                             (block (set (nth n v) (+ text start)) (set n (+ n 1))))
                         (set start (+ i 1))))))
          (set (nth n v) "library") (set n (+ n 1))
          (if (!= (nth 0 base) (cast char 0))
              (block (snprintf lib (sizeof lib) "%s/library" base)
                     (snprintf swi (sizeof swi) "%s/lib/swipl" base)
                     (set (nth n v) lib) (set n (+ n 1))
                     (set (nth n v) swi) (set n (+ n 1))))
          (set (nth n v) "lib/swipl") (set n (+ n 1))
          (set out (coco_m_atom_list e v n))
          (free v)
          (free text)
          (return (coco_m_unify e (coco_m_arg e g 0) out))))

  ;;; ---- the two loaders -------------------------------------------------

  ;;; A whole file as malloc'd text, or null.
  (static)
  (func lb_slurp ((const char * path)) (out char *)
        (let ((FILE * f . #'(fopen path "rb")) (char * buf . nil) (long n . 0))
          (if (== f nil) (return nil))
          (fseek f 0 SEEK_END)
          (set n (ftell f))
          (fseek f 0 SEEK_SET)
          (if (< n 0) (block (fclose f) (return nil)))
          (set buf (cast (char *) (malloc (+ (cast size_t n) 1))))
          (if (== buf nil) (block (fclose f) (return nil)))
          (if (and (> n 0) (!= (cast size_t n) (fread buf 1 (cast size_t n) f)))
              (block (free buf) (fclose f) (return nil)))
          (set (nth (cast size_t n) buf) (cast char 0))
          (fclose f)
          (return buf)))

  ;;; A compiled module: dlopen, check the ABI, let it register itself.
  ;;; The handle is deliberately never closed -- the registry holds
  ;;; pointers into the object for the life of the process. What the entry
  ;;; registered is the object's (`coco_module_set_foreign', 3.0.2): its
  ;;; predicates' errors name their module, as swipl's foreign ones do.
  (static)
  (func lb_load_so ((const char * path) (char * err) (size_t errlen)) (out int)
        (let ((void * h . #'(dlopen path (bitor RTLD_NOW RTLD_LOCAL))))
          (if (== h nil)
              (block (snprintf err errlen "%s" (dlerror)) (return 0)))
          (let ((void * entry . #'(dlsym h "coco_library_entry")))
            (if (== entry nil)
                (block
                 (snprintf err errlen "%s exports no coco_library_entry" path)
                 (dlclose h)
                 (return 0)))
            (let ((int abi . 0) (size_t n0 . #'(coco_module_count)))
              (set abi (code "((int (*)(void)) entry)()"))
              (coco_module_set_foreign n0)
              (if (== abi 0)
                  (block
                   (snprintf err errlen "%s would not register" path)
                   (return 0)))
              (if (!= abi 1)
                  (block
                   (snprintf err errlen "%s speaks library ABI %d and this cocolog speaks 1"
                             path abi)
                   (return 0)))))
          (return 1)))

  ;;; A Prolog library: the file's text registered as a clauses-only
  ;;; module under NAME, so reset-and-reload and never-twice come free.
  (static)
  (func lb_load_pl ((const char * path) (const char * name)
                    (char * err) (size_t errlen)) (out int)
        (let ((char * text . #'(lb_slurp path)) (double t . 0.0))
          (if (== text nil)
              (block (snprintf err errlen "cannot read %s" path) (return 0)))
          ;; the time the text was read at, which if(changed) asks (2.14.0)
          (if (not (coco_file_mtime path (aof t))) (set t 0.0))
          (let ((char * nm . #'(strdup name)))
            (if (or (== nm nil)
                    (not (coco_module_register nm nil text nil)))
                (block (free text)
                       (snprintf err errlen "cannot register %s" path)
                       (return 0)))
            ;; the file it came from, which its load names (1.11.9): the
            ;; registry keeps the copy, as it keeps the name and the text
            (coco_module_set_file nm (strdup path))
            (coco_module_set_text nm text t))
          (return 1)))

  ;;; ---- lending the operators -------------------------------------------
  ;;;
  ;;; A LIBRARY LENDS ITS OPERATORS TO THE FILE THAT NAMES IT. The table
  ;;; `op/3' writes is the process's, so a library's `:- op' would reach
  ;;; the importing file on its own -- except for WHEN it runs: a library's
  ;;; clauses are consulted at the first goal, after the file naming it has
  ;;; been read whole, and a clause parsed before its operator existed was
  ;;; parsed wrong or refused. Every tensor program therefore opened with
  ;;; the library's own three `:- op' lines, copied. So the load reads the
  ;;; library's text once here, for its `:- op(P, T, N)' directives only,
  ;;; and applies each as it is met -- in order, since a later one may
  ;;; need an earlier one to read -- and the rest of the importing file
  ;;; parses with them. The ask-time consult applies them again, which is
  ;;; the same definition twice and changes nothing.
  ;;;
  ;;; Every other directive is skipped: a `use_module' inside the library
  ;;; is not followed, so a library lends what it declares, not what it
  ;;; borrowed. A clause the reader cannot take is passed over, as the
  ;;; consult that follows passes it over and names its line (3.1.0;
  ;;; through 3.0.4 it ended the walk). The heap is wound back a clause at
  ;;; a time, as coco_consult winds it.
  (static)
  (func lb_lend_ops ((coco_machine * m) (const char * text)) (out int)
        (if (== text nil) (return 0))
        (let ((coco_reader r) (size_t t . 0) (int rc . 1) (int n . 0)
              (size_t mark . 0) (char err [128]))
          (coco_reader_init (aof r) m text)
          (while (== rc 1)
            (set mark (-> m heap_len))
            (set rc (coco_read_clause (aof r) (aof t)))
            (if (== rc -1)
                (block (set (-> m heap_len) mark)
                       (coco_reader_resync (aof r))
                       (set rc 1)
                       continue))
            (if (== rc 1)
                (let ((size_t c . #'(coco_deref m t)))
                  (if (and (coco_is_callable m c) (== (coco_arity m c) 1)
                           (== 0 (strcmp (coco_atom_name m (coco_name_of m c)) ":-")))
                      (let ((size_t d . #'(coco_deref m (coco_arg m c 0))))
                        (if (and (coco_is_callable m d) (== (coco_arity m d) 3)
                                 (== 0 (strcmp (coco_atom_name m (coco_name_of m d)) "op")))
                            (if (== (coco_op_apply m d err 128) 1) (set n (+ n 1))))))))
            (set (-> m heap_len) mark))
          (coco_reader_free (aof r))
          (return n)))

  ;;; ---- what is loaded already (2.13.0) ---------------------------------

  (static)
  (func lb_directory ((const char * path)) (out int)
        (let ((stat_t sb))
          (if (!= 0 (stat path (aof sb))) (return 0))
          (return (? (S_ISDIR ($ sb st_mode)) 1 0))))

  ;;; The registered module whose text was read from the file at real path
  ;;; FULL, by whatever spelling it was named -- `use_module(f)' and
  ;;; `use_module('./f.pl')' are one file -- or null. By the real path the
  ;;; registry resolved when the file was named (2.14.0), and by its name
  ;;; resolved now for one whose path would not resolve then.
  (static)
  (func lb_module_of ((const char * full)) (out const coco_module *)
        (let ((char rp [4096]))
          (for ((size_t i . 0)) (< i (coco_module_count)) ((++ i))
            (let ((const coco_module * mod . #'(coco_module_at i)))
              (if (!= (-> mod real) nil)
                  (block (if (== 0 (strcmp (-> mod real) full)) (return mod)))
                (if (and (!= (-> mod file) nil) (!= nil (realpath (-> mod file) rp))
                         (== 0 (strcmp rp full)))
                    (return mod)))))
          (return nil)))

  (func coco_library_note_load ((coco_store * st) (const char * path)) (out int)
        (let ((char full [4096]) (double t . 0.0) (int was . 0))
          (if (== nil (realpath path full)) (return 0))
          (coco_file_mtime full (aof t))
          (set was (coco_store_loaded st full nil))
          (coco_store_note_load st full t)
          (return was)))

  ;;; ---- a file spec, and where its file is (3.4.0) ----------------------

  ;;; ONE SEGMENT OF A FILE SPEC into B, as swipl's '$segments_to_atom'/2
  ;;; takes one: an atom (never []), a string, an integer's digits, or a
  ;;; list of codes -- what "file" reads as under the codes default -- as
  ;;; one name. 0 for anything else, a variable among it: a list of atoms
  ;;; is a list of files, which the loader's callers walk, as swipl's.
  (static)
  (func lb_seg_put ((coco_machine * m) (size_t t) (coco_strbuf * b)) (out int)
        (set t (coco_deref m t))
        (let ((u64 c . #'(nth t (-> m heap))) (const char * sp . nil) (size_t sn . 0))
          (if (coco_string_text m t (aof sp) (aof sn))
              (return (coco_sb_put_len b sp sn)))
          (if (and (coco-tag-is ATOM c) (not (coco_is_nil m t)))
              (return (coco_sb_put b (coco_atom_name m (coco_name_of m t)))))
          (if (coco-is-int c) (return (coco_sb_put_i64 b (coco_int_val m c))))
          (if (not (coco_is_cons m t)) (return 0))
          (while (coco_is_cons m t)
            (let ((size_t h . #'(coco_deref m (coco_arg m t 0))) (u64 hc . #'(nth h (-> m heap))))
              (if (not (coco-is-int hc)) (return 0))
              (let ((i64 cp . #'(coco_int_val m hc)))
                (if (or (< cp 1) (> cp 1114111)) (return 0))
                (if (-> m text_chars)
                    (coco_utf8_put b cp)
                  (block (if (> cp 255) (return 0))
                         (coco_sb_putc b (cast char cp)))))
              (set t (coco_deref m (coco_arg m t 1)))))
          (return (coco_is_nil m t))))

  ;;; A LIST OF FILES (3.4.0): a list whose first element is no code, or
  ;;; `[]', which loads nothing -- each element a spec of its own, as swipl's
  ;;; load_files/2 walks one. A list of codes is one name (`lb_seg_put').
  (static)
  (func lb_files_list ((coco_machine * m) (size_t t)) (out int)
        (set t (coco_deref m t))
        (if (coco_is_nil m t) (return 1))
        (if (not (coco_is_cons m t)) (return 0))
        (return (not (coco-is-int (nth (coco_deref m (coco_arg m t 0)) (-> m heap))))))

  ;;; A FILE SPEC'S TEXT into BUF: one segment, or swipl's path of them,
  ;;; `Dir/File' -- `deeper/h6' and `'../sub'/h3' name the files
  ;;; `deeper/h6' and `../sub/h3' -- the segments joined by `/'. 0 for a
  ;;; term that is neither, or one too long.
  (static)
  (func lb_segs_put ((coco_machine * m) (size_t t) (coco_strbuf * b)) (out int)
        (set t (coco_deref m t))
        (if (coco_is_compound2 m t "/")
            (return (and (lb_segs_put m (coco_arg m t 0) b)
                         (coco_sb_putc b (cast char 47))
                         (lb_segs_put m (coco_arg m t 1) b))))
        (return (lb_seg_put m t b)))

  (static)
  (func lb_spec_text ((coco_machine * m) (size_t t) (char * buf) (size_t cap)) (out int)
        (let ((coco_strbuf b) (int ok . 0))
          (coco_sb_init (aof b))
          (set ok (lb_segs_put m t (aof b)))
          (if (and ok (or (== ($ b s) nil) (>= ($ b len) cap) (== ($ b len) 0)
                          (!= (strlen ($ b s)) ($ b len))))
              (set ok 0))
          (if ok (snprintf buf cap "%s" ($ b s)))
          (coco_sb_free (aof b))
          (return ok)))

  ;;; A FILE A LOAD CAN READ: there, no directory, and readable -- swipl's
  ;;; file_type(prolog) and access(read). The directory is asked by stat:
  ;;; fopen alone opens one on Linux, and the read then fails as if the
  ;;; file held nothing.
  (static)
  (func lb_loadable ((const char * path)) (out int)
        (let ((stat_t sb))
          (if (!= 0 (stat path (aof sb))) (return 0))
          (if (S_ISDIR ($ sb st_mode)) (return 0))
          (return (? (== 0 (access path R_OK)) 1 0))))

  ;;; BASE WITH EACH OF SWIPL'S PROLOG EXTENSIONS AND THEN AS IT IS, the
  ;;; first a load can read, into OUT: '$extend_file'/3's order, where
  ;;; file_name_extension/3 adds one only where BASE has not got it, so
  ;;; `x' is x.pl before x, and `x.pl' x.pl. Through 3.3.0 the name as
  ;;; written came first, and x before x.pl. A `.so' is named outright, as
  ;;; it always was; a `.qlf' is none cocolog reads.
  (static) (var const char * lb_prolog_exts [] . '{".pl" ".prolog" ""})

  (static)
  (func lb_extend ((const char * base) (char * out) (size_t cap)) (out int)
        (let ((size_t n . #'(strlen base)))
          (if (and (> n 3) (== 0 (strcmp (+ base (- n 3)) ".so")))
              (block (snprintf out cap "%s" base) (return (lb_loadable out))))
          (for ((size_t i . 0)) (< i 3) ((++ i))
            (let ((const char * x . #'(nth i lb_prolog_exts)) (size_t xl . #'(strlen x)))
              (if (and (> xl 0) (>= n xl) (== 0 (strcmp (+ base (- n xl)) x)))
                  (snprintf out cap "%s" base)
                (snprintf out cap "%s%s" base x))
              (if (lb_loadable out) (return 1))))
          (return 0)))

  ;;; A PATH FOUND, NAMED BY ITS ABSOLUTE PATH into OUT (3.4.0), as swipl
  ;;; names every file it loads: against the working directory, `.' and
  ;;; `..' folded away, no link resolved (`coco_f_normalise'). As it
  ;;; stands where it will not fit.
  (static)
  (func lb_absolute ((const char * found) (char * out) (size_t cap))
        (let ((char abs [4096]))
          (if (coco_f_normalise found abs (sizeof abs))
              (snprintf out cap "%s" abs)
            (snprintf out cap "%s" found))))

  ;;; WHERE A FILE SPEC'S TEXT IS (3.4.0), as swipl's '$chk_file'/5 looks
  ;;; for it: an absolute name as it stands; a relative one in the
  ;;; directory of the file being loaded first -- while a load reads a
  ;;; file, which is when source_location/2 answers (`sloc_file', set
  ;;; around each of its directives) -- and then in the working directory.
  ;;; So `:- ensure_loaded(sib).' in sub/main.pl loads sub/sib.pl, read from
  ;;; anywhere; a goal the program runs after its load, and an
  ;;; initialization/1 goal, the working directory's. Through 3.3.0 every
  ;;; name was the working directory's. Each place with swipl's extensions
  ;;; first (`lb_extend'); 1 with the path in OUT, absolute (`lb_absolute').
  (static)
  (func lb_resolve ((coco_machine * m) (const char * text) (char * out) (size_t cap)) (out int)
        (let ((char found [4096]))
          (if (== (nth 0 text) (cast char 47))
              (block (if (not (lb_extend text found (sizeof found))) (return 0))
                     (lb_absolute found out cap)
                     (return 1)))
          (if (!= (-> m sloc_file) nil)
              (let ((const char * src . #'(-> m sloc_file))
                    (const char * slash . #'(strrchr src 47)))
                ;; a source in the working directory has no place of its own
                (if (!= slash nil)
                    (let ((char base [4096]))
                      (snprintf base (sizeof base) "%.*s/%s" (cast int (- slash src)) src text)
                      (if (lb_extend base found (sizeof found))
                          (block (lb_absolute found out cap) (return 1)))))))
          (if (not (lb_extend text found (sizeof found))) (return 0))
          (lb_absolute found out cap)
          (return 1)))

  ;;; Whether TEXT names a directory in either place, its absolute path in
  ;;; OUT: what a load that found no file names, existence_error(file,
  ;;; Spec) with context(_, directory(Dir)), as swipl's search names a
  ;;; candidate that is there and is no file
  (static)
  (func lb_resolve_dir ((coco_machine * m) (const char * text) (char * out) (size_t cap)) (out int)
        (if (and (!= (nth 0 text) (cast char 47)) (!= (-> m sloc_file) nil))
            (let ((const char * src . #'(-> m sloc_file))
                  (const char * slash . #'(strrchr src 47)))
              (if (!= slash nil)
                  (let ((char base [4096]))
                    (snprintf base (sizeof base) "%.*s/%s" (cast int (- slash src)) src text)
                    (if (lb_directory base)
                        (block (lb_absolute base out cap) (return 1)))))))
        (if (not (lb_directory text)) (return 0))
        (lb_absolute text out cap)
        (return 1))

  ;;; ---- resolution ------------------------------------------------------

  ;;; A FILE FOUND, at PATH, loaded as the module NAME (KIND 1 a .so, 2 a
  ;;; .pl), as coco_library_load loads one
  (static)
  (func lb_load_found ((coco_store * st) (coco_machine * m) (coco_engine * e)
                       (const char * name) (const char * path) (int kind) (int is_lib)
                       (char * err) (size_t errlen)) (out int)
          ;; A FILE ALREADY LOADED BY ANOTHER ROAD IS LOADED (2.13.0): one
          ;; this store holds consulted (`run', consult/1, the toplevel), or
          ;; one a module was read from under another spelling. Through 2.12
          ;; `consult(f)' and then `ensure_loaded(f)', or `use_module(f)' and
          ;; then `use_module('./f.pl')', read the file a second time beside
          ;; the first, and each of its clauses answered twice.
          (if (== kind 2)
              (let ((char full [4096]))
                (if (!= nil (realpath path full))
                    (block
                     (if (coco_store_loaded st full nil) (return 1))
                     (let ((const coco_module * mod . #'(lb_module_of full)))
                       (if (!= mod nil)
                           (block (lb_lend_ops m (-> mod prolog))
                                  (if (!= e nil) (coco_module_load st m e))
                                  (return 1))))))))

          ;; A LIBRARY'S FILE IS NAMED BY ITS ABSOLUTE PATH too (3.4.0), the
          ;; path its load's reports name, as swipl's
          (let ((char abs [4096]))
            (lb_absolute path abs (sizeof abs))
            (if (== kind 1)
                (block (if (not (lb_load_so abs err errlen)) (return 0)))
              (block (if (not (lb_load_pl abs name err errlen)) (return 0))
                     ;; a file named by its path is the program's own, not a
                     ;; library: its predicates are counted as the program's
                     ;; (1.10.28, `own' in lib/kb.cicili)
                     (if (not is_lib) (coco_module_set_own name)))))

          ;; its operators, for the rest of the file being read
          (let ((const coco_module * mod . #'(coco_module_find name)))
            (if (!= mod nil) (lb_lend_ops m (-> mod prolog))))

          ;; the freshly registered clauses, into THIS store now when an
          ;; engine is running the goal; a directive leaves them for the
          ;; ask-time load
          ;; WHY, AND WHERE (1.11.9): the consult's own words -- the file
          ;; that would not consult, which may be one this one loads, its
          ;; line and column, and the reason. Through 1.11.8 it was this
          ;; file's name and `its clauses would not consult', nothing more.
          (if (!= e nil)
              (if (not (coco_module_load st m e))
                  (block (if (!= (nth 0 (-> st load_err)) (cast char 0))
                             (snprintf err errlen "%s" (-> st load_err))
                           (snprintf err errlen "%s: its clauses would not consult" path))
                         (return 0))))
          (return 1))

  ;;; A MODULE REGISTERED UNDER NAME is loaded: its operators lent again,
  ;;; because a second file naming it is being read now, and its clauses
  ;;; into this store when an engine runs the goal. 0 when there is none.
  (static)
  (func lb_load_known ((coco_store * st) (coco_machine * m) (coco_engine * e)
                       (const char * name)) (out int)
        (let ((const coco_module * mod . #'(coco_module_find name)))
          (if (== mod nil) (return 0))
          (lb_lend_ops m (-> mod prolog))
          (if (!= e nil) (coco_module_load st m e))
          (return 1)))

  ;;; A FILE FOUND AT PATH, loaded as a module of the program's: KNOWN BY
  ;;; WHERE IT IS (3.4.0), registered under its path, so the `h1' beside
  ;;; one file and the `h1' beside another are two modules, where the name
  ;;; as written made them one. A `.so' is a compiled module.
  (static)
  (func lb_load_path ((coco_store * st) (coco_machine * m) (coco_engine * e)
                      (const char * path) (char * err) (size_t errlen)) (out int)
        (let ((size_t len . #'(strlen path)) (int kind . 2))
          (if (lb_load_known st m e path) (return 1))
          (if (and (> len 3) (== 0 (strcmp (+ path (- len 3)) ".so"))) (set kind 1))
          (return (lb_load_found st m e path path kind 0 err errlen))))

  ;;; THE ANSWERS: 1 loaded; -1 not there -- a library not on the path, a
  ;;; file in neither place, a term that names no file --; -2 a spec that
  ;;; is a variable, swipl's instantiation_error; -3 a number where a file
  ;;; name stands, swipl's type_error(text, N) from is_absolute_file_name/1;
  ;;; -4 a name that is a directory, swipl's existence_error(file, Spec)
  ;;; with context(_, directory(Dir)), Dir's absolute path in ERR; and 0
  ;;; for one that was found and would not load, ERR saying why. Through
  ;;; 3.3.0 a spec was library(Name), library(Dir/Name) or an atom, looked
  ;;; for in the working directory alone, and anything else `use_module
  ;;; wants library(Name) or a file atom'.
  (func coco_library_load ((coco_store * st) (coco_machine * m)
                           (coco_engine * e) (size_t spec)
                           (char * err) (size_t errlen)) (out int)
        (set spec (coco_deref m spec))
        (let ((char name [4096]) (char path [4096]) (int kind . 0)
              (u64 c . #'(nth spec (-> m heap))))
          ;; a file: its text, or a path of segments, where it is
          (if (not (and (coco_is_callable m spec)
                        (== (coco_arity m spec) 1)
                        (== 0 (strcmp (coco_atom_name m (coco_name_of m spec)) "library"))))
              (block
               (if (coco-tag-is REF c) (return -2))
               (if (or (coco-is-int c) (or (coco-tag-is FLT c) (coco-rat-p c))) (return -3))
               (if (not (lb_spec_text m spec name (sizeof name)))
                   (block (snprintf err errlen "no such file") (return -1)))
               (if (not (lb_resolve m name path (sizeof path)))
                   (block (if (lb_resolve_dir m name err errlen) (return -4))
                          (snprintf err errlen "%s: no such file" name)
                          (return -1)))
               (return (lb_load_path st m e path err errlen))))
          ;; library(Name), library(Dir/Name): registered, or on the
          ;; library path, .so before .pl
          (let ((size_t inner . #'(coco_deref m (coco_arg m spec 0))))
            (if (coco-tag-is REF (nth inner (-> m heap))) (return -2))
            (if (not (lb_spec_text m inner name (sizeof name)))
                (block (snprintf err errlen "library: no such library") (return -1))))
          (if (lb_load_known st m e name) (return 1))
          (if (not (lb_find name path (sizeof path) (aof kind)))
              (block (snprintf err errlen "library(%s): not found on the library path" name)
                     (return -1)))
          (return (lb_load_found st m e name path kind 1 err errlen))))

  ;;; ---- always present --------------------------------------------------
  ;;;
  ;;; SWI'S OWN LIBRARIES ARE PART OF PROLOG, not an optional extra, and
  ;;; a program that has to say `use_module(library(assoc))' before it can
  ;;; use an association list is a program doing the interpreter's
  ;;; bookkeeping. These eight are vendored in lib/swipl under their own
  ;;; BSD-2 headers and are now registered at start-up like `files' and
  ;;; `lists' -- the difference being that those are Cicili modules
  ;;; compiled in and these are read from disk beside the binary.
  ;;;
  ;;; AND IT COSTS NOTHING, which is why this is a load rather than an
  ;;; autoload. Measured across three runs: 469ms bare against 459ms with
  ;;; all eight, then 441 against 446, then 458 against 443 -- the
  ;;; difference is inside the noise of a start-up dominated by the
  ;;; embedded store and libtorch. An autoload hook on the unknown-
  ;;; predicate path would have been more machinery for a cost that is not
  ;;; there.
  ;;;
  ;;; THAT WAS ONLY TRUE LOCALLY UNTIL IT WAS TRUE EVERYWHERE. In the
  ;;; Zeytun arrangement a predicate is a page over the network, and this
  ;;; load first cost 272 extra HTTP round trips -- because `assertz' was
  ;;; fetching the shared predicate before adding each clause, MUTED
  ;;; clauses included. A module's clause never writes through, so it had
  ;;; nothing to be appended to and nothing to read first; kb.cicili now
  ;;; says so, and the whole start-up is one request instead of 440. The
  ;;; measurement is written out there, beside the line it belongs to.
  ;;;
  ;;; A MISSING FILE IS NOT AN ERROR. A cocolog whose lib/swipl did not
  ;;; travel with it still starts, and `use_module(library(assoc))' then
  ;;; fails the way it always did with a message naming the path. Refusing
  ;;; to boot over a library nobody has asked for yet would be the wrong
  ;;; trade.
  (static) (var const char * lb_always []
                . '{"assoc" "pairs" "ordsets" "yall"
                    "aggregate" "ugraphs" "dcg_basics" "dcg_high_order"})

  (func coco_library_preload () (out int)
        (let ((char path [1024]) (char err [512]) (int kind . 0) (int n . 0))
          (for ((size_t i . 0)) (< i 8) ((++ i))
               (let ((const char * name . #'(nth i lb_always)))
                 (if (== (coco_module_find name) nil)
                     (if (lb_find name path 1024 (aof kind))
                         (if (== kind 2)
                             (if (lb_load_pl path name err 512)
                                 (set n (+ n 1))))))))
          ;; LIBRARY(ASYNC) IS TIER 1 SINCE 2.8.0: cocolog's green threads,
          ;; preloaded from the binary's library path so async coroutines
          ;; are on by default (async_run/1,2, go/2, yield/0, await/2 and
          ;; the channels), and use_module(library(async)) is a no-op.
          (if (== (coco_module_find "async") nil)
              (if (lb_find "async" path 1024 (aof kind))
                  (if (== kind 2)
                      (if (lb_load_pl path "async" err 512)
                          (set n (+ n 1))))))
          ;; AND print_message/2 SINCE 2.16.0 (library/print_message.pl),
          ;; swipl's, which a program calls without asking for a library: the
          ;; kinds, the prefixes, the location line in a load and the error
          ;; terms' text, with message_hook/3 and prolog:message//1. It
          ;; costs every start-up 3.2 million instructions (`cocolog query
          ;; true', 21.7 million to 25.0, callgrind), about half a
          ;; millisecond of ten.
          (if (== (coco_module_find "print_message") nil)
              (if (lb_find "print_message" path 1024 (aof kind))
                  (if (== kind 2)
                      (if (lb_load_pl path "print_message" err 512)
                          (set n (+ n 1))))))
          (return n)))

  ;;; ---- the module and the directive hook -------------------------------

  ;;; A BALL THAT ENDED THE LOAD JUST MADE (3.1.0) is thrown again here, in
  ;;; the engine that asked for the load, as swipl's consult/1 lets it go
  ;;; on: 2 caught, -1 not, and 0 when the load kept none
  (static)
  (func lb_ball_again ((coco_engine * e)) (out int)
        (let ((size_t b . 0))
          (if (not (coco_load_ball_take (-> e st) (-> e m) (aof b))) (return 0))
          (return (? (coco_m_thrown e b) 2 -1))))

  ;;; A LIBRARY LOADED BY A GOAL MAY COLLECT IN ITS DIRECTIVES (1.9.6) when
  ;;; the engine asking may collect: nothing of the heap is read here after
  ;;; the load, the spec only before it, and the step that called this keeps
  ;;; its goal on the engine (`kcall'). The vouch is `dgc' (lib/term.cicili).
  ;;; THE BALL OF A NAME THAT IS A DIRECTORY (3.4.0), swipl's:
  ;;; error(existence_error(file, Spec), context(_, directory(Dir))), Dir
  ;;; the directory's absolute path
  (static)
  (func lb_directory_ball ((coco_machine * m) (size_t spec) (const char * dir)) (out size_t)
        (return (coco_make2 m "error"
                            (coco_make2 m "existence_error" (coco_new_atom m "file") spec)
                            (coco_make2 m "context" (coco_new_var m)
                                        (coco_make1 m "directory" (coco_new_atom m dir))))))

  ;;; ---- include/1 (3.5.0) -----------------------------------------------

  ;;; THE FILE `:- include(Spec).' READS (`coco_include_hook'), found where
  ;;; a load looks for one (`lb_resolve': beside the file being read first,
  ;;; then in the working directory, swipl's extensions before the name as
  ;;; it is), or on the library path for library(Name): 1, its absolute path
  ;;; in PATH and its text in TEXT. A spec that names nothing it can read is
  ;;; swipl's ball, which ends the load -- existence_error(source_sink,
  ;;; Spec), a list's too; instantiation_error; a number's type_error(text,
  ;;; N) from is_absolute_file_name/1; a directory's existence_error(file,
  ;;; Spec) -- put on the machine (`lball') and its text in ERR: 0.
  (static)
  (func lb_include ((coco_store * st) (coco_machine * m) (size_t spec)
                    (char * path) (size_t pathlen) (char ** text)
                    (char * err) (size_t errlen)) (out int)
        (set spec (coco_deref m spec))
        (let ((u64 c . #'(nth spec (-> m heap))) (char name [4096]) (char dir [4096])
              (size_t mark . #'(-> m heap_len)) (size_t ball . 0) (int kind . 0)
              ;; 0 found, 1 no such file -- swipl's source_sink --, 2 BALL
              (int why . 1))
          (set (cof text) nil)
          (cond
            ((coco-tag-is REF c)
             (block (set ball (coco_make2 m "error" (coco_new_atom m "instantiation_error")
                                          (coco_new_var m)))
                    (set why 2)))
            ((or (coco-is-int c) (or (coco-tag-is FLT c) (coco-rat-p c)))
             (block (set ball (coco_make2 m "error"
                                          (coco_make2 m "type_error" (coco_new_atom m "text") spec)
                                          (coco_ectx_pi m "system"
                                                        (coco_new_atom m "is_absolute_file_name")
                                                        1 (coco_new_var m))))
                    (set why 2)))
            ;; `[]', whose segments swipl joins with atomic_list_concat/2,
            ;; and its type_error says so
            ((coco_is_nil m spec)
             (block (set ball (coco_make2 m "error"
                                          (coco_make2 m "type_error" (coco_new_atom m "text") spec)
                                          (coco_ectx_pi m "system"
                                                        (coco_new_atom m "atomic_list_concat")
                                                        2 (coco_new_var m))))
                    (set why 2)))
            ((coco_is_compound1 m spec "library")
             (if (and (lb_spec_text m (coco_arg m spec 0) name (sizeof name))
                      (and (lb_find name dir (sizeof dir) (aof kind)) (== kind 2)))
                 (block (lb_absolute dir path pathlen) (set why 0))))
            ;; any other list is no name -- a list of files, which a load
            ;; takes and an include does not, swipl's source_sink -- as a
            ;; term that is no text is none (`lb_seg_put' takes codes alone)
            ((not (lb_spec_text m spec name (sizeof name)))
             (set why 1))
            ((lb_resolve m name path pathlen) (set why 0))
            ((lb_resolve_dir m name dir (sizeof dir))
             (block (set ball (lb_directory_ball m spec dir)) (set why 2))))
          (if (== why 0)
              (block (set (cof text) (lb_slurp path))
                     (if (!= (cof text) nil) (return 1))
                     (set why 1)))
          (if (== why 1)
              (set ball (coco_make2 m "error"
                                    (coco_make2 m "existence_error" (coco_new_atom m "source_sink") spec)
                                    (coco_new_var m))))
          (coco_error_text m st ball err errlen)
          (let ((size_t cb . #'(coco_store_put st m ball)))
            (set (-> m lball) (+ cb 1))
            (set (-> m lball_size) (- (-> st len) cb)))
          (set (-> m heap_len) mark)
          (return 0)))

  (static)
  (func lb_use ((coco_engine * e) (size_t g) (int * found)) (out int)
        (coco-mod-args e g ((spec 0))
          (let ((char err [4096]) (coco_machine * m . #'(-> e m)) (int was . #'(-> m dgc))
                (int r . 0))
            ;; A LIST OF FILES (3.4.0), swipl's: each loaded by the Coco
            ;; half's `'$lf_mods'/1', a file's error printed and the next one
            ;; loaded. Through 3.3.0 `use_module wants library(Name) or a
            ;; file atom'.
            (if (lb_files_list m spec)
                (block (coco_m_decline e) (set (cof found) 0) (return 0)))
            (set (-> m dgc) (? (-> e gc) 1 0))
            (set r (coco_library_load (-> e st) m e spec err (sizeof err)))
            (set (-> m dgc) was)
            (if (== 1 r) (return 1))
            ;; SWIPL'S ERRORS (3.4.0), where through 3.3.0 each was
            ;; cocolog_error('use_module: nope: no such file'): a file or a
            ;; library that is not there, an unbound spec, a number where a
            ;; name stands, which swipl's is_absolute_file_name/1 refuses,
            ;; and a name that is a directory
            (if (== r -1) (return (coco_m_existence_error e "source_sink" spec)))
            (if (== r -2) (return (coco_m_instantiation_error e)))
            (if (== r -3)
                (return (coco_m_raise_pi e (coco_make2 m "type_error" (coco_new_atom m "text") spec)
                                         "system" "is_absolute_file_name" 1)))
            (if (== r -4)
                (return (? (coco_m_thrown e (lb_directory_ball m spec err)) 2 -1)))
            ;; a ball that ended the module's load goes on (3.1.0)
            (let ((int t . #'(lb_ball_again e)))
              (if (!= t 0) (return t)))
            (return (coco_m_error e "use_module" err)))))

  (func lb_use_module1 ((coco_engine * e) (size_t g) (int * found)) (out int)
        (return (lb_use e g found)))

  ;;; the import list is accepted and ignored: cocolog has one namespace,
  ;;; so everything a library defines is visible -- MODULES.md records the
  ;;; difference rather than pretending it away
  (func lb_use_module2 ((coco_engine * e) (size_t g) (int * found)) (out int)
        (return (lb_use e g found)))

  ;;; ---- consult/1, load_files/2 and `[File]' (2.13.0) -------------------

  ;;; A load's report on stderr in SWI's shape, after what the program has
  ;;; written so far, so that the two read in order in one stream, and on a
  ;;; line of its own (2.16.0, `coco_out_fresh')
  (static)
  (func lb_say_text ((const char * msg))
        (fflush stdout)
        (coco_out_fresh stderr)
        (fprintf stderr "ERROR: %s\n" msg)
        (coco_out_note stderr "\n" 1))

  ;;; `$lf_say'(Ball): one file of a list that would not load, reported as
  ;;; SWI reports it, and the list goes on with the next.
  ;;; Inside a directive it is said at the directive's place (3.4.0), as
  ;;; swipl's print_message/2 says an error there: `:- [a, nope].'
  (static)
  (func lb_say ((coco_engine * e) (size_t g)) (out int)
        (let ((char msg [4096]) (coco_machine * m . #'(-> e m)))
          (coco_error_text m (-> e st) (coco_m_arg e g 0) msg (sizeof msg))
          (if (!= (-> m sloc_file) nil)
              (coco_load_message "ERROR" (-> m sloc_file) (-> m sloc_line) msg)
            (lb_say_text msg))
          (return 1)))

  ;;; `$lf_file'(Spec, If): ONE FILE, loaded as SWI's load_files/2 loads it
  ;;; under if(If); the Coco half walks a list and reads the options.
  ;;;
  ;;; library(Name) is the library loader's, as SWI loads a library: a
  ;;; module, loaded once, whatever IF says. Any other spec names a file by
  ;;; its text -- an atom, a string, a number, whose text SWI's error gives
  ;;; as an atom -- tried as written and then with `.pl', as use_module/1
  ;;; tries it. One that is not there is existence_error(source_sink, Spec),
  ;;; a directory existence_error(file, Spec), and under if(exists) either
  ;;; is a success that loads nothing.
  ;;;
  ;;; THE FILE IS CONSULTED INTO THE KNOWLEDGE BASE, written through, as
  ;;; `run', the `consult' command and the toplevel's `[File]' write it:
  ;;; its clauses from the last time are replaced (SWI's reconsult), and
  ;;; its directives run again, as SWI's do. IF says when. `true': always.
  ;;; `changed', and `exists' for a file that is there: unless this store
  ;;; read it and its time_file/2 is no later than the one it had then (an
  ;;; older stamp reads nothing, as in swipl). `not_loaded' and `module' (must_be_module(true)):
  ;;; unless the store read it, and then by the module loader, as
  ;;; ensure_loaded/1 and use_module/1 load -- which SWI says they are.
  ;;;
  ;;; A FILE THIS PROCESS LOADED AS A MODULE (use_module/1, ensure_loaded/1,
  ;;; `-s') IS READ AGAIN AS THAT MODULE (2.14.0), as SWI reloads it, under
  ;;; `true', `exists', and `changed' once its time moved (`lb_reread');
  ;;; `not_loaded' and `module' load nothing. Through 2.13 such a file was
  ;;; its first load whatever IF said, and a consult of the edited file
  ;;; kept the old clauses (cicilang's report).
  ;;;
  ;;; A FILE THAT WILL NOT READ WHOLE IS REPORTED, AND THE GOAL SUCCEEDS, as
  ;;; SWI's load reports a syntax error and goes on -- but the consult here
  ;;; ends at the error (the one thing that ends a consult), so what comes
  ;;; after it is not read. A library(Name) that will not load raises, as
  ;;; use_module/1 raises.

  ;;; A FILE LOADED AS A MODULE, READ AGAIN (2.14.0), as SWI's consult/1
  ;;; reloads one. The registry takes the new text, so a store made after
  ;;; this -- a thread's, run_isolated/2's -- loads it, and THIS store's
  ;;; clauses of the module are replaced by the new text's, consulted as
  ;;; `coco_module_load' consults a module: MUTED, because they are this
  ;;; process's and are never written through; `double_quotes' as its
  ;;; author wrote it; its predicates the program's own where the file is
  ;;; (`own'); its directives run again; owned by its real path, so that
  ;;; the first clause of each predicate takes the module's old clauses of
  ;;; it out, and a predicate the new text no longer defines loses them
  ;;; (`coco_consult_owner'). What the program asserted into one of its
  ;;; predicates stays, as it stays in swipl. A store another thread made
  ;;; before keeps what it loaded: threads share nothing. Answers 0 for a
  ;;; file that cannot be read.
  (static)
  (func lb_reread ((coco_engine * e) (const coco_module * mod) (const char * path)
                   (double now)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (coco_store * st . #'(-> e st))
              (char * text . #'(lb_slurp path)) (char err [4096]) (int r . 0)
              (int dq . #'(-> m double_quotes)) (int own . #'(-> st ownload))
              (int was . #'(-> m dgc)))
          (if (== text nil) (return 0))
          (coco_module_set_text (-> mod name) text now)
          (coco_store_mute st)
          (set (-> m double_quotes) 0)
          (set (-> st ownload) (-> mod own))
          ;; its directives may collect when this engine may: nothing of
          ;; the heap is read after the consult, and the spec was read before
          (set (-> m dgc) (? (-> e gc) 1 0))
          (set r (coco_consult_owner st m text
                                     (? (== (-> mod file) nil) (-> mod name) (-> mod file))
                                     (-> mod real) 1 err (sizeof err)))
          (set (-> m dgc) was)
          (set (-> st ownload) own)
          (set (-> m double_quotes) dq)
          (coco_store_unmute st)
          ;; a ball that ended the read goes on (3.1.0): 2 or -1, the
          ;; predicate's answer
          (if (< r 0)
              (let ((int t . #'(lb_ball_again e)))
                (if (!= t 0) (return t))
                (lb_say_text err)))
          (return 1)))

  (static)
  (func lb_load_file ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((spec 0) (how 1))
          (let ((coco_machine * m . #'(-> e m)) (coco_store * st . #'(-> e st))
                (char name [4096]) (char path [4096]) (char full [4096]) (char err [4096])
                (const char * mode . nil) (u32 ar . 0) (u32 har . 0)
                (const char * fn . #'(coco_m_functor e spec (aof ar)))
                (const char * hfn . #'(coco_m_functor e how (aof har)))
                (int exists . 0) (int lf . 0) (int r . 0) (int was . 0) (int again . 0)
                (size_t culprit . spec) (u64 c . 0)
                (double then . 0.0) (double now . 0.0) (char * text . nil))
            ;; load_files/2's own IF comes as lf(If), so a number is its
            ;; error and not consult/1's (3.4.0)
            (if (and (!= hfn nil) (and (== har 1) (== 0 (strcmp hfn "lf"))))
                (block (set lf 1) (set how (coco_deref m (coco_arg m (coco_deref m how) 0)))))
            (set mode (coco_m_atom e how))
            (if (== mode nil) (set mode "true"))
            (set exists (== 0 (strcmp mode "exists")))
            ;; library(Name): the library loader's
            (if (and (!= fn nil) (== ar 1) (== 0 (strcmp fn "library")))
                (block
                 (set was (-> m dgc))
                 (set (-> m dgc) (? (-> e gc) 1 0))
                 (set r (coco_library_load st m e spec err (sizeof err)))
                 (set (-> m dgc) was)
                 (if (== r 1) (return 1))
                 (let ((int t . #'(lb_ball_again e)))
                   (if (!= t 0) (return t)))
                 (if (== r -1)
                     (return (? exists 1 (coco_m_existence_error e "source_sink" spec))))
                 (if (== r -2) (return (coco_m_instantiation_error e)))
                 (return (coco_m_error e "consult" err))))
            ;; A NUMBER (3.4.0), swipl's: load_files/2 refuses it as its
            ;; is_absolute_file_name/1 does, type_error(text, N), and
            ;; consult/1 and `[N]' look for the file its text names, an atom
            ;; in their error (`'1.5''). Through 3.3.0 an integer was
            ;; consult/1's for both, and a float named no file.
            (set c (nth (coco_deref m spec) (-> m heap)))
            (if (or (coco-is-int c) (or (coco-tag-is FLT c) (coco-rat-p c)))
                (block
                 (if lf (return (coco_m_raise_pi e (coco_make2 m "type_error"
                                                               (coco_new_atom m "text") spec)
                                                 "system" "is_absolute_file_name" 1)))
                 (let ((coco_strbuf nb))
                   (coco_sb_init (aof nb))
                   (coco_write_term m (aof nb) (coco_deref m spec) 0 0)
                   (snprintf name (sizeof name) "%s" (? (== ($ nb s) nil) "" ($ nb s)))
                   (coco_sb_free (aof nb)))
                 (set culprit (coco_m_new_atom e name)))
              ;; a file by its text, or by swipl's path of segments, Dir/File;
              ;; any other compound names none
              (block
               (if (or (and (!= fn nil) (and (> ar 0) (not (coco_is_compound2 m spec "/"))))
                       (not (lb_spec_text m spec name (sizeof name))))
                   (return (? exists 1 (coco_m_existence_error e "source_sink" spec))))
               ;; consult/1 takes a string's text, an atom in its error
               (if (and (not lf) (coco-tag-is STR c)) (set culprit (coco_m_new_atom e name)))))
            ;; WHERE IT IS (3.4.0): the directory of the file being loaded
            ;; first, then the working directory, swipl's extensions before
            ;; the name as it is (`lb_resolve'), the path absolute. Through
            ;; 3.3.0 the name as written and then with `.pl', in the working
            ;; directory alone.
            (if (not (lb_resolve m name path (sizeof path)))
                (block
                 (if exists (return 1))
                 (if (lb_resolve_dir m name full (sizeof full))
                     (return (? (coco_m_thrown e (lb_directory_ball m culprit full)) 2 -1)))
                 (return (coco_m_existence_error e "source_sink" culprit))))
            (if (== nil (realpath path full)) (snprintf full (sizeof full) "%s" path))
            (if (not (coco_file_mtime full (aof now))) (set now 0.0))
            ;; LOADED AS A MODULE: read again as that module (2.14.0), unless
            ;; IF says it is loaded, or it is no newer than its text was
            (let ((const coco_module * mod . #'(lb_module_of full)))
              (if (!= mod nil)
                  (block
                   (if (or (== 0 (strcmp mode "not_loaded")) (== 0 (strcmp mode "module")))
                       (return 1))
                   (if (and (or (== 0 (strcmp mode "changed")) exists) (<= now (-> mod time)))
                       (return 1))
                   (let ((int rr . #'(lb_reread e mod path now)))
                     (if (== rr 0)
                         (return (coco_m_existence_error e "source_sink" culprit)))
                     (return rr)))))
            (if (or (== 0 (strcmp mode "not_loaded")) (== 0 (strcmp mode "module")))
                (block
                 (if (coco_store_loaded st full nil) (return 1))
                 (set was (-> m dgc))
                 (set (-> m dgc) (? (-> e gc) 1 0))
                 ;; the path found, loaded as itself: a spec looked for
                 ;; again would be looked for where this load stands
                 (set r (lb_load_path st m e path err (sizeof err)))
                 (set (-> m dgc) was)
                 (if (!= r 1)
                     (let ((int t . #'(lb_ball_again e)))
                       (if (!= t 0) (return t))
                       (lb_say_text err)))
                 (return 1)))
            ;; NEWER, NOT ONLY OTHER (2.14.0): swipl 9.0.4 reads the file
            ;; again only when its time is past the one its last read had
            ;; ('$noload'/3: Modified @=< LoadTime loads nothing), and
            ;; if(exists) is if(changed) for a file that is there. Through
            ;; 2.13 an older time read it again too, and if(exists) read it
            ;; always.
            (if (and (or (== 0 (strcmp mode "changed")) exists)
                     (coco_store_loaded st full (aof then)) (<= now then))
                (return 1))
            (set text (lb_slurp path))
            (if (== text nil) (return (coco_m_existence_error e "source_sink" culprit)))
            ;; NOTED BEFORE THE READ, as SWI marks a file loading: a directive
            ;; in it that ensure_loaded/1s it finds it there. Noted before,
            ;; it is read AGAIN, and its clauses placed as swipl's reload
            ;; places them (2.14.1)
            (set again (coco_store_loaded st full nil))
            (coco_store_note_load st full now)
            ;; ITS DIRECTIVES MAY COLLECT when this engine may (`dgc'): the
            ;; spec is read before the consult and nothing of the heap after.
            ;; AND IT IS THE PROGRAM'S CONSULT even inside a module's load --
            ;; a directive or initialization/1 of an `-s' file runs while the
            ;; store is muted for that file, and the muted read wrote nothing
            ;; through and owned nothing, so the next consult added a copy.
            ;; The mute is the module's, and is put back after.
            (let ((int muted . #'(-> st muted)) (int own . #'(-> st ownload)))
              (set (-> st muted) 0)
              (set (-> st ownload) 0)
              (set was (-> m dgc))
              (set (-> m dgc) (? (-> e gc) 1 0))
              (set r (coco_consult_again st m text path again err (sizeof err)))
              (set (-> m dgc) was)
              (set (-> st muted) muted)
              (set (-> st ownload) own))
            (free text)
            ;; WHAT ITS DIRECTIVES REGISTERED IS LOADED NOW (3.4.0), into this
            ;; store, as use_module/1 as a goal loads it: a directive has no
            ;; engine and leaves a module for the next ask, and through 3.3.0
            ;; a goal of this engine called after the consult found the
            ;; module's predicates unknown -- only a nested search, which
            ;; asks, loaded them
            (if (>= r 0)
                (block (set was (-> m dgc))
                       (set (-> m dgc) (? (-> e gc) 1 0))
                       (coco_module_load st m e)
                       (set (-> m dgc) was)))
            ;; A BALL A DIRECTIVE THREW THAT IS NO error(_, _) ENDED THE
            ;; LOAD (3.1.0), and goes on from here, as swipl's consult/1
            ;; lets it: what was read before it stays
            (if (< r 0)
                (let ((int t . #'(lb_ball_again e)))
                  (if (!= t 0) (return t))
                  (lb_say_text err)))
            (return 1))))

  ;;; SWI'S NAMES FOR WHAT THIS BUILD CARRIES UNDER ANOTHER ARRANGEMENT,
  ;;; answered as loaded when a directive names them. SWI files dcg_basics
  ;;; and dcg_high_order as dcg/basics and dcg/high_order; here they are
  ;;; registered at start-up under the flat names above. library(error)'s
  ;;; must_be/2, is_of_type/2 and its type_error/2, domain_error/2 and
  ;;; instantiation_error/1 are builtins -- which is what the two SWI files
  ;;; read at every start-up (dcg_basics.pl, ordsets.pl) load it for. Its
  ;;; existence_error/2, permission_error/3, representation_error/1 and
  ;;; resource_error/1 are not built in, and a call to one says so by name.
  ;;; Written as the writer writes the spec, which is what is compared.
  (static) (var const char * lb_carried []
                . '{"library(error)" "library(dcg/basics)" "library(dcg/high_order)"})

  ;;; A DIRECTIVE GETS THE LOADER'S THREE ANSWERS -- 1 loaded, 0 found and
  ;;; would not load, -1 not there -- and kb.cicili reports the last two in
  ;;; SWI's words. This used to answer 1 for a library it could not find,
  ;;; the tolerance for files borrowed from SWI, and that made a missing
  ;;; library(ray) look loaded until its first call. What the tolerance was
  ;;; FOR is kept, by name, in lb_carried.
  ;;; AN UNBOUND SPEC, A NUMBER AND A DIRECTORY (3.4.0) are swipl's errors
  ;;; here too, reported as a raising directive's: the ball's text into ERR,
  ;;; the answer 0, and kb.cicili names the directive that failed
  (static)
  (func lb_directive_one ((coco_store * st) (coco_machine * m) (size_t spec)
                          (char * err) (size_t errlen)) (out int)
        (let ((int r . #'(coco_library_load st m nil spec err errlen)))
          (if (or (== r -2) (or (== r -3) (== r -4)))
              (let ((size_t mark . #'(-> m heap_len)) (size_t ball . 0) (char dir [4096]))
                (cond ((== r -2)
                       (set ball (coco_make2 m "error" (coco_new_atom m "instantiation_error")
                                             (coco_new_var m))))
                      ((== r -3)
                       (set ball (coco_make2 m "error"
                                             (coco_make2 m "type_error" (coco_new_atom m "text") spec)
                                             (coco_ectx_pi m "system"
                                                           (coco_new_atom m "is_absolute_file_name") 1
                                                           (coco_new_var m)))))
                      (#t (snprintf dir (sizeof dir) "%s" err)
                          (set ball (lb_directory_ball m spec dir))))
                (coco_error_text m st ball err errlen)
                (set (-> m heap_len) mark)
                (return 0)))
          (if (!= r -1) (return r))
          (let ((coco_strbuf b) (int carried . 0))
            (coco_sb_init (aof b))
            (coco_write_term m (aof b) (coco_deref m spec) 1 0)
            (if (!= ($ b s) nil)
                (for ((size_t i . 0)) (< i 3) ((++ i))
                     (if (== 0 (strcmp ($ b s) (nth i lb_carried))) (set carried 1))))
            (coco_sb_free (aof b))
            (return (? carried 1 -1)))))

  ;;; A LIST OF FILES (3.4.0), swipl's `:- use_module([a, b]).': each
  ;;; loaded, each that loads nothing said at the directive's place, and the
  ;;; directive holds -- no Warning that it failed. A list whose tail is no
  ;;; list is its error, and the directive fails. Through 3.3.0 `use_module
  ;;; wants library(Name) or a file atom'.
  (static)
  (func lb_directive_hook ((coco_store * st) (coco_machine * m) (size_t spec)
                           (char * err) (size_t errlen)) (out int)
        (if (not (lb_files_list m spec)) (return (lb_directive_one st m spec err errlen)))
        (let ((size_t t . #'(coco_deref m spec)))
          (while (coco_is_cons m t)
            (let ((size_t f . #'(coco_deref m (coco_arg m t 0))) (int r . 0))
              (set (nth 0 err) (cast char 0))
              (set r (lb_directive_one st m f err errlen))
              (if (!= r 1)
                  (let ((coco_strbuf w))
                    (coco_sb_init (aof w))
                    (coco_write_term m (aof w) f 1 0)
                    (if (== r -1)
                        (snprintf err errlen "source_sink `%s' does not exist"
                                  (? (== ($ w s) nil) "?" ($ w s)))
                      (if (== (nth 0 err) (cast char 0))
                          (snprintf err errlen "%s: could not be loaded"
                                    (? (== ($ w s) nil) "?" ($ w s)))))
                    (coco_sb_free (aof w))
                    (coco_load_message "ERROR" (-> m sloc_file) (-> m sloc_line) err))))
            (set t (coco_deref m (coco_arg m t 1))))
          (if (coco_is_nil m t) (return 1))
          (let ((size_t mark . #'(-> m heap_len)) (size_t ball . 0))
            (if (coco-tag-is REF (nth t (-> m heap)))
                (set ball (coco_make2 m "error" (coco_new_atom m "instantiation_error")
                                      (coco_new_var m)))
              (set ball (coco_make2 m "error"
                                    (coco_make2 m "type_error" (coco_new_atom m "list") t)
                                    (coco_new_var m))))
            (coco_error_text m st ball err errlen)
            (set (-> m heap_len) mark)
            (return 0))))

  ;;; ---- and the seam a DIRECTIVE runs through ---------------------------
  ;;;
  ;;; THE ENGINE IS HERE AND THE STORE IS NOT, which is the whole reason for
  ;;; a hook: `:- G' has to run G, kb.cicili is compiled before solve.cicili,
  ;;; and this file is compiled after both. One engine per directive, over
  ;;; the machine and store the load is already using -- so a directive that
  ;;; asserts is asserting into the file's own knowledge base, and a
  ;;; directive that reads sees the clauses above it.
  ;;;
  ;;; ITS ANSWER IS THE THREE-WAY ONE the caller needs: 1 proved, 0 failed,
  ;;; -1 threw with the ball already turned into SWI's words -- the engine's
  ;;; own `err' is the fallback for the errors that are not balls at all.
  ;;;
  ;;; `:- halt.' HALTS, here as in SWI. The flag belongs to the engine that
  ;;; ran the goal and would die with it, so it is read before that engine
  ;;; is freed and acted on at once: a program that says halt in a directive
  ;;; means the process, not this goal. And a halt is an ANSWER, as it is
  ;;; after the CLI's goal: what the run wrote is committed first
  ;;; (`coco_halt_load'), where an exit from here used to lose it.
  ;;;
  ;;; THE GOAL COLLECTS THE HEAP WHEN ITS CALLER VOUCHED (1.9.6): `dgc' on
  ;;; the machine (lib/term.cicili), set by the frame that called the hook
  ;;; only once every frame out to the host has registered what it reads
  ;;; afterwards. It is taken here, so nothing the goal starts reads it, and
  ;;; given back after. As a builtin's search does (`coco_engine_findall'),
  ;;; the goal collects once it has grown by the floor, and the heap and
  ;;; trail where it starts are its marks -- a barrier the trail is
  ;;; compacted against when an engine runs outside it, and moved with the
  ;;; cells, traced or not (`coco_engine_findall'). Through 1.9.5 a
  ;;; directive's goal collected nothing, and a long phase in one kept its
  ;;; whole heap.
  ;;;
  ;;; THE FRAME IT RUNS IN IS swipl's (3.1.0): a directive's and an
  ;;; initialization(G, main)'s goal under catch/3, an initialization/1's
  ;;; under '$run_init_goal'/1 (KIND 0, 2 and 1), which an unknown procedure
  ;;; at the goal's root names (`rootn' 5 and 6). And a DIRECTIVE's ball
  ;;; that is no error(_, _) -- the only ones swipl's catch/3 there takes --
  ;;; ends the load: it is kept in the load's store for whoever asked for
  ;;; the load to throw (the machine's `lball'), ERR says what it was, and
  ;;; the answer is -2.
  (static)
  (func lb_goal_hook ((coco_store * st) (coco_machine * m) (size_t goal) (int kind)
                      (char * err) (size_t errlen)) (out int)
        (let ((coco_engine e) (int rc . 0) (int halted . 0) (int code . 0)
              (int dgc . #'(-> m dgc)) (int gc . 0) (size_t gsaved . 0) (int ends . 0))
          (set (-> m dgc) 0)
          (coco_engine_init (aof e) m st)
          (set ($ e max_steps) 0)
          (set ($ e rootn) (? (== kind 1) 6 5))
          ;; A BALL THIS GOAL DOES NOT CATCH IS REPORTED HERE, with where it
          ;; was raised (1.10.17): no catch outside the load can take it, so
          ;; its throw asks no further out than this engine, and its lines
          ;; are kept for the report only when it raised one
          (set ($ e btstop) 1)
          (coco_engine_ask (aof e) goal)
          ;; after the ask, which frees the retired codes when the engine
          ;; may collect and runs alone: whether it does is this frame's say
          (set ($ e ptrail) (-> m trail_len))
          (set ($ e pheap) (-> m heap_len))
          (set gc (? dgc 1 0))
          (set ($ e gc) gc)
          (if gc (set gsaved (coco_gc_nested_begin m ($ e pheap))))
          (set rc (coco_engine_next (aof e)))
          ;; a directive runs once: what it left is cut, a cleanup run with
          ;; `!' (3.1.0), as swipl's
          (if (== rc 1) (coco_engine_cut (aof e)))
          (if gc (coco_gc_nested_end m gsaved))
          (set (-> m dgc) dgc)
          (set halted ($ e halted))
          (set code ($ e halt_code))
          (if (== rc -1)
              (if (not (coco_engine_error_text (aof e) err errlen))
                  (snprintf err errlen "%s" ($ e err))))
          ;; A RAISE OR A FAILURE UNDOES THE GOAL'S BINDINGS (3.1.0), as the
          ;; catch/3 swipl runs it under does and as backtracking out of it
          ;; would: the Warning after it names the goal as it was asked,
          ;; `user:(mk(3,_A),_A==[3,2,9])', where a failure that left no
          ;; choice to go back to kept them, `mk(3,[3,2,1])'
          (if (or (== rc -1) (== rc 0)) (coco_undo_to m ($ e ptrail)))
          (if (and (== rc -1) ($ e has_ball) (== kind 0))
              (let ((coco_store * bs . #'(? (== ($ e ball_st) nil) st
                                            (cast (coco_store *) ($ e ball_st))))
                    (size_t ball . 0))
                (set ball (coco_store_read m bs ($ e ball_cell)))
                (if (not (coco_is_compound2 m ball "error"))
                    (block
                     ;; a ball still in the load's store is kept where it is;
                     ;; one in an engine's own is put into it
                     (if (== bs st)
                         (block (set (-> m lball) (+ ($ e ball_cell) 1))
                                (set (-> m lball_size) ($ e ball_size)))
                       (let ((size_t c . #'(coco_store_put st m ball)))
                         (set (-> m lball) (+ c 1))
                         (set (-> m lball_size) (- (-> st len) c))))
                     (set ends 1)))))
          ;; its lines are a report's, and a ball that ends the load is
          ;; reported by no one here
          (if (or ends (not (and (== rc -1) ($ e has_ball)))) (coco_bt_say m 0))
          (coco_engine_free (aof e))
          (if halted (coco_halt_load st code 1))
          (if (== rc 1) (return 1))
          (if (== rc 0) (return 0))
          (if ends (return -2))
          (return -1)))

  (static) (coco-emit-module-dispatch lb_dispatch *library-predicates*)

  (func coco_library_module () (out int)
        (coco_use_module_install lb_directive_hook)
        (coco_goal_install lb_goal_hook)
        (coco_include_install lb_include)
        (return (coco_module_register "library" lb_dispatch (lb-prolog-text) nil)))

  ) ; impl-library

;;;; cocolog -- reading and writing Prolog text
;;;
;;; TWO HALVES OF ONE GRAMMAR, so one file. The reader turns text into terms on
;;; the machine's heap; the writer turns terms back into text. They have to
;;; agree exactly, because the round trip is not a convenience here -- it is
;;; how a clause gets into Zigurat and back out again. A writer that emits
;;; `a- -1' where the reader wants `a - -1' is a knowledge base that cannot be
;;; reloaded, and nothing else in the system would notice until it was too
;;; late to fix cheaply.
;;;
;;; THE OPERATOR TABLE IS WRITTEN ONCE, IN LISP, AND READ BY BOTH. *operators*
;;; below is the whole of cocolog's syntax. From it the macro layer emits the
;;; three lookup functions the parser needs and the two predicates the writer
;;; needs -- as chains of strcmp against literals, not as a table walked at run
;;; time. Adding an operator is one line; the reader and the writer cannot
;;; disagree about it because neither of them has its own copy.
;;;
;;; A CICILI STRING IS RAW, AND MAY NOT END IN A BACKSLASH. The reader copies
;;; a string literal through to C untouched -- "\\n" is two characters here and
;;; the C compiler is what turns it into a newline -- and it decides where the
;;; literal ends by looking at whether the previous character was a backslash.
;;; So `"/\\"' does not terminate: the closing quote is taken as escaped, the
;;; reader runs on into the rest of the file, and every string after it is read
;;; as code. That is why the bitwise operators are not in the table below and
;;; why a doubled backslash is written with two putc calls rather than as a
;;; literal. It costs three operators cocolog has no builtin for.
;;;
;;; THE LEXER IS WRITTEN IN CHARACTERS AND COMPILES TO NUMBERS. Cicili has no
;;; character literal -- a C `'a'` has no spelling in an s-expression -- so a
;;; lexer written straight would be a wall of 97s and 122s. `coco-ch',
;;; `coco-ch-between' and `coco-ch-in' take the characters as strings and fold them
;;; to their codes at expansion time, so the source says `(coco-ch-between c "a" "z")'
;;; and the C says `c >= 97 && c <= 122'. That is the whole reason the reader
;;; below is readable at all.

(DEFPACKAGE :cocolog
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :cocolog)

;;;; ------------------------------------------------------------------
;;;; Characters, at expansion time
;;;; ------------------------------------------------------------------

;;; the code of the first character of S
(DEFMACRO coco-ch (s) (CHAR-CODE (CHAR (STRING s) 0)))

;;; LO <= C <= HI, with LO and HI written as characters
(DEFMACRO coco-ch-between (c lo hi)
  `(and (>= ,c ,(CHAR-CODE (CHAR (STRING lo) 0)))
        (<= ,c ,(CHAR-CODE (CHAR (STRING hi) 0)))))

;;; C is one of the characters in S. Expands to a chain of comparisons; the
;;; sets it is used on have a dozen members at most, and a C compiler turns
;;; that into a jump table or a bitmask better than a hand-rolled lookup would.
(DEFMACRO coco-ch-in (c s)
  (LET ((codes (MAP 'LIST #'CHAR-CODE (STRING s))))
    (IF (NULL codes)
        0
        `(or ,@(MAPCAR (LAMBDA (k) `(== ,c ,k)) codes)))))

;;;; ------------------------------------------------------------------
;;;; The operator table
;;;; ------------------------------------------------------------------

;;; priority, type, then the names. This is standard Prolog's table, less the
;;; operators cocolog has no builtin for. `\\+' and friends are Lisp strings,
;;; so the backslash is doubled here and single in the language.
;;; THE TABLE HOLDS THE TEXT THE READER WILL SEE, and this puts back the
;;; escaping C needs on the way out. Cicili emits a string literal RAW, so
;;; until now each name here was written pre-escaped for C -- `"\\+"' in the
;;; source to mean the two characters `\+'. That works for every name that can
;;; be written at all, and `/\' cannot: a Cicili string may not end in a
;;; backslash, because `\"' still escapes the closing quote. Escaping HERE
;;; instead lets a name be spelled as itself, and lets the two that have no
;;; spelling be built from their character codes below. Only the backslash
;;; needs escaping -- no operator has a quote in it.
(DEFUN c-escape (s)
  (WITH-OUTPUT-TO-STRING (o)
    (LOOP FOR ch ACROSS s DO
      (WHEN (CHAR= ch (CODE-CHAR 92)) (WRITE-CHAR (CODE-CHAR 92) o))
      (WRITE-CHAR ch o))))

;;; 47 is `/', 92 is `\'. These two have no writable spelling; `\/' and the
;;; rest do, and are written.
(DEFPARAMETER *op-and* (COERCE (LIST (CODE-CHAR 47) (CODE-CHAR 92)) 'STRING))
(DEFPARAMETER *op-not* (COERCE (LIST (CODE-CHAR 92)) 'STRING))

(DEFPARAMETER *operators*
  `((1200 xfx ":-" "-->" "=>")
    (1200 fx  ":-" "?-")
    ;; The declaration prefixes. `:- dynamic counter/1.' is only a term at all
    ;; because `dynamic' is one of these -- without it the reader takes
    ;; `dynamic' for an atom, finds `counter' where it wanted the `.', and says
    ;; so at the offset of the `/', which is a confusing place to be told that
    ;; an operator is missing.
    ;; `meta_predicate' and `multifile' are here for the sake of files
    ;; borrowed from a Prolog that has modules: without the operator the
    ;; directive is not even a term, and the file cannot be read at all.
    ;; AND THE REST OF SWIPL'S (3.2.0): `:- table f/1.' and `:- public f/1.'
    ;; were syntax errors, the clause skipped
    (1150 fx  "dynamic" "discontiguous" "initialization" "meta_predicate"
              "module_transparent" "multifile" "public" "thread_local"
              "thread_initialization" "volatile" "table")
    ;; THE BAR IS AN OPERATOR OF ITS OWN (3.2.0, swipl's): `a|b' is
    ;; '|'(a, b), which a clause's body holds as ;/2 (`coco_clause_compile') and a
    ;; call runs as one. Through 3.1.0 the reader made every bar outside a
    ;; list `;' and op/3 changed nothing it read
    (1105 xfy "|")
    (1100 xfy ";")
    (1050 xfy "->" "*->")
    (1000 xfy ",")
    (900  fy  "\+")
    ;; swipl's, which its dicts and its global variables name (3.2.0)
    (800  xfx ":=")
    (700  xfx "=" "\=" "==" "\==" "@<" "@>" "@=<" "@>=" "=.." "is"
              "=:=" "=\=" "<" ">" "=<" ">=" "=@=" "\=@=" "as" ":<" ">:<")
    ;; module qualification. cocolog has one namespace, so `m:g' is only
    ;; ever a term here -- but a borrowed file writes it, and a reader that
    ;; cannot parse it cannot read the file.
    (600  xfy ":")
    ;; The bitwise three sit at 500 with `+' and `-' because ISO puts them
    ;; there, so `A /\ B =:= C' needs no brackets. Without them in this table
    ;; the reader does not merely refuse `12 /\ 10': `/\' is a symbolic token
    ;; either way, so it reads `12', meets an operator it does not know, and
    ;; stops with the rest of the term unread -- `X is 12 /\ 10' quietly
    ;; became `X is 12'. `xor' is swipl's 400 (3.2.0; 500 through 3.1.0):
    ;; `a + b xor c' is a + (b xor c)
    (500  yfx "+" "-" ,*op-and* "\/")
    (400  yfx "*" "/" "//" "div" "mod" "rem" "<<" ">>" "rdiv" "xor")
    (200  xfx "**")
    (200  xfy "^")
    ;; `\' is the bitwise complement, prefix, sharing 200 fy with unary
    ;; minus. It is not `\+', which is 900 fy and a different token.
    (200  fy  "-" "+" ,*op-not*)
    ;; swipl's `$', 1 fx (3.2.0): `$x' is '$'(x)
    (1    fx  "$")))

;;; The five types, as the numbers the C side uses. `coco_op_type' in the emitted
;;; code is one of these; the parser turns it into the two argument priorities.
(DEFPARAMETER *op-types* '((xfx . 0) (xfy . 1) (yfx . 2) (fy . 3) (fx . 4)))

(DEFUN op-type-code (sym) (CDR (ASSOC sym *op-types* :TEST #'STRING=)))

(DEFUN ops-of-class (class)
  "Every (name prec typecode) whose type is in CLASS -- :infix or :prefix."
  (LET ((out NIL))
    (DOLIST (row *operators* (NREVERSE out))
      (LET* ((prec (FIRST row))
             (type (SECOND row))
             (code (op-type-code type))
             (infixp (MEMBER type '(xfx xfy yfx) :TEST #'STRING=)))
        (WHEN (OR (AND (EQ class :infix) infixp)
                  (AND (EQ class :prefix) (NOT infixp)))
          (DOLIST (name (CDDR row))
            (PUSH (LIST (c-escape name) prec code) out)))))))

;;; One lookup function per class. Each answers 1 and fills in the priority and
;;; the type, or answers 0. Written as a cond over strcmp: the names are known
;;; here, so nothing is searched at run time.
;;;
;;; BY THE FIRST BYTE FIRST (1.13.7). The reader asks this of every atom it
;;; reads, and a name that is no operator -- nearly all of them -- went down
;;; every row: 18 strcmp calls an atom, 4 % of fetching a predicate of 31 000
;;; clauses out of a store. The rows are grouped by their first byte, in
;;; their order, and a name is compared only with the rows it could be.
(DEFMACRO coco-emit-op-lookup (fname class)
  (LET* ((rows (ops-of-class class))
         (firsts (REMOVE-DUPLICATES (MAPCAR (LAMBDA (row) (CHAR-CODE (CHAR (FIRST row) 0))) rows)
                                    :FROM-END T)))
    `(func ,fname ((const char * s) (int * prec) (int * type)) (out int)
       (let ((int c0 . #'(cast int (nth 0 s))))
         (cond
           ,@(MAPCAR (LAMBDA (fc)
                       `((== c0 ,fc)
                         (cond
                           ,@(MAPCAR (LAMBDA (row)
                                       `((== 0 (strcmp s ,(FIRST row)))
                                         (set (cof prec) ,(SECOND row))
                                         (set (cof type) ,(THIRD row))
                                         (return 1)))
                                     (REMOVE-IF-NOT (LAMBDA (row) (= (CHAR-CODE (CHAR (FIRST row) 0)) fc))
                                                    rows))
                           (#t (return 0)))))
                     firsts)
           (#t (return 0)))))))

;;; The whole table again, reachable one row at a time, so that
;;; `current_op/3' can enumerate what was built in. TWO macros and not one,
;;; because a Cicili macro emits ONE form -- several from one leaves the
;;; symbols unregistered and the next reference to them is a link error, which
;;; is exactly what happened here the first time.
;;;
;;; A generated `cond' over an index rather than an initialised array: an array
;;; of structs would want a brace initialiser, and this way the one table still
;;; emits everything.
(DEFUN op-static-rows ()
  (APPEND (MAPCAR (LAMBDA (r) (APPEND r '(0))) (ops-of-class :infix))
          (MAPCAR (LAMBDA (r) (APPEND r '(1))) (ops-of-class :prefix))))

(DEFMACRO coco-emit-op-static-count ()
  `(func coco_op_static_count () (out size_t) (return ,(LENGTH (op-static-rows)))))

(DEFMACRO coco-emit-op-static-at ()
  `(func coco_op_static_at ((size_t i) (const char ** name) (int * prec)
                          (int * type) (int * kind)) (out int)
     (cond
       ,@(LET ((n -1))
           (MAPCAR (LAMBDA (row)
                     (INCF n)
                     `((== i ,n)
                       (set (cof name) ,(FIRST row))
                       (set (cof prec) ,(SECOND row))
                       (set (cof type) ,(THIRD row))
                       (set (cof kind) ,(FOURTH row))
                       (return 1)))
                   (op-static-rows)))
       (#t (return 0)))))

;;; Is this name an operator at all? The writer asks, because an atom that is
;;; an operator has to be bracketed when it stands as an argument -- `f(-)' is
;;; fine but `- + -' is not what anyone meant.
(DEFMACRO coco-emit-op-any ()
  (LET ((names (REMOVE-DUPLICATES
                (MAPCAR #'FIRST (APPEND (ops-of-class :infix) (ops-of-class :prefix)))
                :TEST #'STRING=)))
    `(func coco_op_is_any_static ((const char * s)) (out int)
       (cond
         ,@(MAPCAR (LAMBDA (n) `((== 0 (strcmp s ,n)) (return 1))) names)
         (#t (return 0))))))

;;;; ------------------------------------------------------------------
;;;; The parser, written once and emitted twice
;;;; ------------------------------------------------------------------
;;; THE READER EVERY CONSULT USES AND THE ONE read_term/3 USES FOR
;;; POSITIONS (1.10.7) ARE ONE TEXT: each body below is the function's,
;;; with P 0 for `coco_parse_term' and its kin and 1 for `coco_parse_term_p'
;;; and theirs, and the names of the siblings it calls passed in, so each
;;; family calls only its own. Every position site is `(if ,P ...)', which
;;; the compiler drops from the first family. Written into ONE parser with
;;; a test of the reader's flag at each site instead, they made consulting
;;; the translator 1.3 % dearer with positions off: clang inlines the
;;; primary, the named term, the arguments and the list into
;;; `coco_parse_term', and sites it never took still cost it registers.
;;; The funcs are written out, each with its `static', and the macros make
;;; only their bodies (a `static' written before a macro that emits a
;;; function does not reach it).

;;; `[ ... ]' after the bracket, which began at F, has been consumed. PS
;;; holds the elements' positions.
(DEFMACRO coco-parse-list-body (P TERM)
  `(block
     (if (coco_is_punct r (coco-ch "]"))
         (block (if ,P (coco_pos_leaf r f (-> r pos)))
                (if (not (coco_next_token r)) (return 0))
                (set (cof out) (coco_new_nil (-> r m)))
                (return 1)))
     ;; AN ELEMENT AND THE TAIL ARE READ TO 1200 (3.2.0), as an argument
     ;; is (`coco-parse-args-body'), ending at a comma or a bar: `[a:-b]' is
     ;; [(a:-b)] and `[(a|b)]' ['|'(a,b)]
     (let ((size_t * items . nil) (size_t * ps . nil) (size_t n . 0) (size_t cap . 0)
           (size_t tail) (int prec) (int ok . 1) (int bar . 0) (int oom . 0)
           (int ostop . #'(-> r stop)))
       (set (-> r stop) 2)
       (while 1
         (let ((size_t item))
           (if (not (,TERM r 1200 (aof item) (aof prec)))
               (block (coco_term_close r 93 ",|]") (set ok 0) break))
           ;; GROWN THROUGH A SECOND POINTER (2.11.1): set from `realloc'
           ;; itself, a refusal left nil where the old block was -- leaked,
           ;; and the read failed saying nothing of why
           (if (>= n cap)
               (let ((size_t ncap . #'(? (== cap 0) 8 (* cap 2)))
                     (size_t * grown . #'(cast (size_t *) (realloc items (* ncap (sizeof size_t))))))
                 (if (== grown nil) (block (set ok 0) (set oom 1) break))
                 (set items grown)
                 (if ,P
                     (let ((size_t * pgrown . #'(cast (size_t *) (realloc ps (* ncap (sizeof size_t))))))
                       (if (== pgrown nil) (block (set ok 0) (set oom 1) break))
                       (set ps pgrown)))
                 (set cap ncap)))
           (set (nth n items) item)
           (if ,P (set (nth n ps) (-> r lpos)))
           (set n (+ n 1)))
         (if (not (coco_is_punct r (coco-ch ","))) break)
         (if (not (coco_next_token r)) (block (set ok 0) break)))
       (if (not ok)
           (block (free items) (if ,P (free ps))
                  (if oom (return (coco_fail r "out of memory reading a list")))
                  (return 0)))
       ;; an explicit tail, or the empty list
       (set tail (cast size_t 0))
       (if (coco_is_punct r (coco-ch "|"))
           (block (if (not (coco_next_token r)) (block (free items) (if ,P (free ps)) (return 0)))
                  (if (not (,TERM r 1200 (aof tail) (aof prec)))
                      (block (coco_term_close r 93 "]") (free items) (if ,P (free ps)) (return 0)))
                  (set bar 1))
         (set tail (coco_new_nil (-> r m))))
       (set (-> r stop) ostop)
       (if (not (coco_is_punct r (coco-ch "]")))
           (block (free items) (if ,P (free ps)) (return (coco_close_fail r "expected ] closing a list" bar))))
       ;; the tail's position is the term parsed last, `none' with no bar
       (if ,P
           (block
             (coco_pos_list_term r f (-> r pos) ps n
                                 (? bar (-> r lpos) (coco_new_atom (-> r m) "none")))
             (free ps)))
       (if (not (coco_next_token r)) (block (free items) (return 0)))
       ;; fold from the right, so [a,b|T] becomes '.'(a, '.'(b, T))
       (while (> n 0)
         (set n (- n 1))
         (set tail (coco_cons (-> r m) (nth n items) tail)))
       (free items)
       (set (cof out) tail)
       (return 1))))

;;; `name(...)' -- the bracket has been consumed, and the name stood from
;;; NF to NT. PS holds the arguments' positions, ARGS their cells.
;;; AN ARGUMENT IS READ TO 1200 AND ENDS AT ITS COMMA (3.2.0), as swipl's
;;; reader reads one with the `iso' flag off: `f(a:-b)' is f((a:-b)) and
;;; `f(a;b)' f((a;b)), and a bare comma still separates the arguments --
;;; it is no operator while `stop' is 1, down every operand of the
;;; argument, and a bracket of any kind inside reads one again. Through
;;; 3.1.0 an argument was read to 999, ISO's, and both were syntax errors.
(DEFMACRO coco-parse-args-body (P TERM)
  `(let ((size_t * args . nil) (size_t * ps . nil) (size_t n . 0) (size_t cap . 0)
         (int prec) (int ok . 1) (int oom . 0) (int ostop . #'(-> r stop))
         (int bnil . #'(-> r bnil)))
     (set (-> r bnil) 0)
     ;; `f()', A COMPOUND OF NO ARGUMENTS (3.12.0), swipl 7's: its functor
     ;; is the name and 0, and it is no atom
     (if (coco_is_punct r (coco-ch ")"))
         (block (if ,P (coco_pos_term r nf (-> r pos) nf nt nil 0))
                (if (not (coco_next_token r)) (return 0))
                (set (cof out) (coco_push (-> r m) (coco-cell FUN (coco_parse_fid r name bnil 0))))
                (return 1)))
     (set (-> r stop) 1)
     (while 1
       (let ((size_t a))
         (if (not (,TERM r 1200 (aof a) (aof prec)))
             (block (coco_term_close r 41 ",)") (set ok 0) break))
         ;; grown through a second pointer, as the list's are (2.11.1)
         (if (>= n cap)
             (let ((size_t ncap . #'(? (== cap 0) 8 (* cap 2)))
                   (size_t * grown . #'(cast (size_t *) (realloc args (* ncap (sizeof size_t))))))
               (if (== grown nil) (block (set ok 0) (set oom 1) break))
               (set args grown)
               (if ,P
                   (let ((size_t * pgrown . #'(cast (size_t *) (realloc ps (* ncap (sizeof size_t))))))
                     (if (== pgrown nil) (block (set ok 0) (set oom 1) break))
                     (set ps pgrown)))
               (set cap ncap)))
         (set (nth n args) a)
         (if ,P (set (nth n ps) (-> r lpos)))
         (set n (+ n 1)))
       (if (not (coco_is_punct r (coco-ch ","))) break)
       (if (not (coco_next_token r)) (block (set ok 0) break)))
     (set (-> r stop) ostop)
     (if (not ok)
         (block (free args) (if ,P (free ps))
                (if oom (return (coco_fail r "out of memory reading an argument list")))
                (return 0)))
     (if (not (coco_is_punct r (coco-ch ")")))
         (block (free args) (if ,P (free ps)) (return (coco_close_fail r "expected ) closing an argument list" 0))))
     (if ,P (block (coco_pos_term r nf (-> r pos) nf nt ps n) (free ps)))
     (if (not (coco_next_token r)) (block (free args) (return 0)))
     (set (cof out) (coco_make_f (-> r m) (coco_parse_fid r name bnil (cast u32 n)) (cast u32 n) args))
     (free args)
     (return 1)))

(DEFMACRO coco-parse-primary-body (P TERM LIST NAMED)
  `(block
     (set (cof outprec) 0)
     (cond
       ((== (-> r tok) COCO_TK_INT)
        ;; AN INTEGER IS 64 BITS (2.0.0; 61 through 1.15.0): a literal
        ;; past 2^63 - 1 is refused by name, where SWI makes a bignum.
        ;; The lexer said whether the magnitude fit (`iwide')
        (if (!= (-> r iwide) 0)
            (return (coco_fail r "integer out of range")))
        (set (cof out) (coco_new_int (-> r m) (-> r ival)))
        (if ,P (coco_pos_leaf r (-> r tstart) (-> r pos)))
        (return (coco_next_token r)))

       ((== (-> r tok) COCO_TK_FLOAT)
        (set (cof out) (coco_new_float (-> r m) (-> r fval)))
        (if ,P (coco_pos_leaf r (-> r tstart) (-> r pos)))
        (return (coco_next_token r)))

       ((== (-> r tok) COCO_TK_RAT)
        (set (cof out) (coco_new_rat (-> r m) (-> r rval_n) (-> r rval_d)))
        (if (== (cof out) (cast size_t -1)) (return (coco_fail r "out of memory")))
        (if ,P (coco_pos_leaf r (-> r tstart) (-> r pos)))
        (return (coco_next_token r)))

       ((== (-> r tok) COCO_TK_VAR)
        (set (cof out) (coco_var_for r ($ (-> r text) s)))
        (if ,P (coco_pos_leaf r (-> r tstart) (-> r pos)))
        (return (coco_next_token r)))

       ((== (-> r tok) COCO_TK_STRING)
        (if (not (coco_string_to_list r out)) (return 0))
        (if ,P (coco_pos_wrap r "string_position" (-> r tstart) (-> r pos)))
        (return (coco_next_token r)))

       ;; a bracket reads its term whole, its commas and bars operators
       ;; whatever term it stands in (`stop' 0, 3.2.0)
       ((coco_is_punct r (coco-ch "("))
        (let ((size_t f . #'(-> r tstart)))
          (if (not (coco_next_token r)) (return 0))
          (let ((int p) (int ostop . #'(-> r stop)))
            (set (-> r stop) 0)
            (if (not (,TERM r 1200 out (aof p))) (block (coco_term_close r 41 ")") (return 0)))
            (set (-> r stop) ostop))
          (if (not (coco_is_punct r (coco-ch ")"))) (return (coco_close_fail r "expected )" 0)))
          (if ,P (coco_pos_wrap r "parentheses_term_position" f (-> r pos)))
          (return (coco_next_token r))))

       ((coco_is_punct r (coco-ch "["))
        (let ((size_t f . #'(-> r tstart)))
          (if (not (coco_next_token r)) (return 0))
          ;; `[](a)' and `[ ](a)', the two against a `(' (3.12.0, swipl
          ;; 7's): a compound named by the list's end, as `{}(' makes one
          (if (and (coco_is_punct r (coco-ch "]")) (== (coco_peek r) (coco-ch "(")))
              (block (set (-> r bnil) 1)
                     (return (,NAMED r maxprec "[]" 0 f (-> r pos) out outprec))))
          (return (,LIST r f out))))

       ((coco_is_punct r (coco-ch "{"))
        (let ((size_t f . #'(-> r tstart)))
          (if (not (coco_next_token r)) (return 0))
          (if (coco_is_punct r (coco-ch "}"))
              (block
               ;; `{}(a,b)', the two against a `(' (3.1.0, swipl's): a
               ;; compound named `{}', as `f(' makes one -- `{}(x)' is `{x}'
               (if (== (coco_peek r) (coco-ch "("))
                   (return (,NAMED r maxprec "{}" 0 f (-> r pos) out outprec)))
               (set (cof out) (coco_new_atom (-> r m) "{}"))
               (if ,P (coco_pos_leaf r f (-> r pos)))
               (return (coco_next_token r))))
          (let ((size_t inner) (int p) (int ostop . #'(-> r stop)))
            (set (-> r stop) 0)
            (if (not (,TERM r 1200 (aof inner) (aof p))) (block (coco_term_close r 125 "}") (return 0)))
            (set (-> r stop) ostop)
            (if (not (coco_is_punct r (coco-ch "}"))) (return (coco_close_fail r "expected }" 0)))
            (if ,P (coco_pos_wrap r "brace_term_position" f (-> r pos)))
            (if (not (coco_next_token r)) (return 0))
            (set (cof out) (coco_make1 (-> r m) "{}" inner))
            (return 1))))

       ((== (-> r tok) COCO_TK_NAME)
        ;; THE NAME HAS TO BE COPIED, and so does WHETHER IT WAS QUOTED:
        ;; both belong to the token in hand and the lookahead below replaces
        ;; them. `coco_tok_name' does the copying at any length; the rest of
        ;; the case is `coco_parse_named' so that the buffer it may have
        ;; allocated is freed at ONE place rather than at each of the seven
        ;; ways that case can end. Where it stood goes with it.
        (let ((char small [256]) (char * heap . nil) (size_t hcap . 0)
              (char * name . #'(coco_tok_name r small (sizeof small)
                                              (aof heap) (aof hcap)))
              (int was_quoted . #'(-> r quoted)) (int ok . 0)
              (size_t nf . #'(-> r tstart)) (size_t nt . #'(-> r pos)))
          (if (== name nil) (return (coco_fail r "out of memory")))
          (set ok (,NAMED r maxprec name was_quoted nf nt out outprec))
          (free heap)
          (return ok)))

       (#t (coco_fail r "expected a term")
           ;; settled at its bracket (3.10.0, `coco_term_close')
           (set (-> r eopen) 1) (set (-> r eops) 0) (set (-> r eopc) 0)
           (return 0)))))

;;; A NAME token that has already been copied out: an atom, a compound, a
;;; prefix operator applied to what follows, or the negative-number spelling.
;;; It stood from NF to NT.
(DEFMACRO coco-parse-named-body (P TERM ARGS)
  `(block
     (if (not (coco_next_token r)) (return 0))

     ;; f( with no space between is an application; `f (' is not
     (if (and (coco_is_punct r (coco-ch "(")) (== (-> r layout_before) 0))
         (block (if (not (coco_next_token r)) (return 0))
                (return (,ARGS r name nf nt out))))

     ;; `-1' is the integer; `- 1' is -(1). Only the absence of layout
     ;; tells them apart -- and the digit's script: `-١' is -(1), as
     ;; swipl's sign wants an ASCII digit after it (3.35.0)
     (if (and (== 0 (strcmp name "-")) (and (== (-> r layout_before) 0) (== (-> r wnum) 0)))
         (block
          (if (== (-> r tok) COCO_TK_INT)
              (block (if (> (-> r iwide) 1)
                         (return (coco_fail r "integer out of range")))
                     ;; -2^63 is the least, whose magnitude no i64 holds
                     (set (cof out) (coco_new_int (-> r m)
                                                  (? (== (-> r iwide) 1)
                                                     (- -9223372036854775807 1)
                                                     (- 0 (-> r ival)))))
                     (if ,P (coco_pos_leaf r nf (-> r pos)))
                     (return (coco_next_token r))))
          (if (== (-> r tok) COCO_TK_RAT)
              (block (set (cof out) (coco_new_rat (-> r m) (- 0 (-> r rval_n)) (-> r rval_d)))
                     (if (== (cof out) (cast size_t -1)) (return (coco_fail r "out of memory")))
                     (if ,P (coco_pos_leaf r nf (-> r pos)))
                     (return (coco_next_token r))))
          (if (== (-> r tok) COCO_TK_FLOAT)
              ;; -0.0 keeps its sign, and a NaN its bits, as swipl's reader
              ;; and -/1 keep them (2.2.2): -1.5NaN == 1.5NaN
              (block (set (cof out) (coco_new_float (-> r m) (? (!= (-> r fval) (-> r fval))
                                                                (-> r fval) (- (-> r fval)))))
                     (if ,P (coco_pos_leaf r nf (-> r pos)))
                     (return (coco_next_token r))))))

     ;; a prefix operator, but only if it was written as one, and
     ;; something follows that it could apply to, and its priority fits
     ;; where we are. WRITTEN AS ONE means unquoted: `'-' - a' is infix
     ;; with the atom `-' on the left, and `- - a' is prefix applied to
     ;; `-a', and quoting is the whole of the difference -- unless the
     ;; name cannot be written without its quotes (3.15.1, swipl's):
     ;; `'p\'q' a' and `'Ab' x' apply the operator, `'-' a' is no term
     (let ((int prec . 0) (int type . 0) (int prefix . 0))
       (if (or (not was_quoted) (coco_quoted_op name))
           (set prefix (coco_op_prefix name (aof prec) (aof type))))
       (if (and prefix (and (<= prec maxprec) (coco_starts_term r)))
           (let ((size_t arg) (int argprec)
                 (int argmax . #'(? (== type COCO_FY) prec (- prec 1))))
             ;; its operand is what an operator clash in it is placed after
             (set (-> r lopend) nt)
             (if (not (,TERM r argmax (aof arg) (aof argprec)))
                 (block (coco_op_failed r name) (return 0)))
             ;; named as an application is (3.15.1): a quoted `'[]'' the atom
             (set (cof out) (coco_make1_f (-> r m) (coco_parse_fid r name 0 1) arg))
             (set (cof outprec) prec)
             (if ,P (coco_pos_prefix r nf nf nt))
             (return 1)))

       ;; A PREFIX OPERATOR OVER THE PRIORITY HERE, BEFORE A TERM (3.10.0):
       ;; `a = \+ b', `a :- :- b' -- swipl's operator clash, at the token
       ;; after it and placed after the operator before it; the read fails
       ;; at that token, which no operator here can take
       (if (and prefix (and (> prec maxprec) (coco_starts_term r)))
           (coco_clash r (-> r lopend)))

       ;; Otherwise a plain atom -- AT ITS PREFIX PRIORITY when it is an
       ;; unquoted prefix operator, and 0 else (3.2.0, swipl's): so it is
       ;; the left operand only of an infix operator that admits that
       ;; much, `- = a' and `\+ -> a' read and `\+ = a', `dynamic ; a'
       ;; and `:- = a' are `operator expected', where `(\+) = a' and
       ;; `'\+' = a' read. Nothing else reads the priority back: a prefix
       ;; operator's operand, an argument and the right operand take the
       ;; atom whatever it is (`- dynamic', `a = \+'), as swipl's do.
       ;; Through 3.1.0 every such atom was 0. (Carrying the INFIX
       ;; priority, once tried, made `- * a' unreadable: `-' came back at
       ;; 500, over `*''s 400; its prefix priority is 200.) The WRITER
       ;; brackets such an atom when it stands as an operand. Before an
       ;; infix bar it is refused at any priority, as swipl refuses
       ;; `- | a' and `f(\+ | a)' (where `[- | a]''s bar ends the element)
       (if (and prefix (and (coco_is_punct r (coco-ch "|")) (!= (-> r stop) 2)))
           (return (coco_fail r "operator expected")))
       (set (cof out) (coco_new_atom (-> r m) name))
       (set (cof outprec) (? prefix prec 0))
       (if ,P (coco_pos_leaf r nf nt))
       (return 1))))

;;; SMALL/HEAP live across the loop, not inside it, so that the one
;;; `free' at the end covers every iteration -- and outside the
;;; RECURSION too, because each nesting level parses its own operator
;;; and a buffer shared with the frame below would be overwritten under
;;; it. An operator longer than 255 characters is absurd but is read
;;; correctly anyway, for the same reason a long atom now is: the reader
;;; should not be where a name quietly changes.
(DEFMACRO coco-parse-term-body (P TERM PRIMARY)
  `(let ((size_t left) (int leftprec) (size_t lopt . 0)
         (char small [256]) (char * heap . nil) (size_t hcap . 0))
     (if (not (,PRIMARY r maxprec (aof left) (aof leftprec)))
         (block (free heap) (return 0)))
     (while 1
       (let ((char * name . #'small) (int prec) (int type) (int have . 0))
         ;; `,' and `|' arrive as punctuation but are operators: the comma
         ;; is ','/2 and the bar '|'/2 (3.2.0; `;' through 3.1.0), each as
         ;; the operator table has it -- save where they END the term read:
         ;; an argument's comma (`stop' 1) or a list element's comma or bar
         ;; (2), whatever priority it is read to (`coco_parse_args')
         (cond
           ((== (-> r tok) COCO_TK_NAME)
            (set name (coco_tok_name r small (sizeof small) (aof heap) (aof hcap)))
            (if (== name nil) (block (free heap) (return (coco_fail r "out of memory"))))
            ;; A QUOTED NAME IS AN INFIX OPERATOR ONLY WHERE IT CANNOT BE
            ;; WRITTEN WITHOUT ITS QUOTES (3.15.1, swipl's): `a 'x\'y' b'
            ;; and `a ',' b' apply it, `a '-' b' is no term
            (if (or (not (-> r quoted)) (coco_quoted_op name)) (set have 1)))
           ((coco_is_punct r (coco-ch ","))
            (if (== (-> r stop) 0)
                (block (snprintf small (sizeof small) ",") (set have 1))))
           ((coco_is_punct r (coco-ch "|"))
            (if (!= (-> r stop) 2)
                (block (snprintf small (sizeof small) "|") (set have 1)))))
         (if (not have) break)
         (if (not (coco_op_infix name (aof prec) (aof type))) break)
         (if (> prec maxprec) break)
         (let ((int lmax . #'(? (== type COCO_YFX) prec (- prec 1)))
               (int rmax . #'(? (== type COCO_XFY) prec (- prec 1))))
           ;; a clash (3.10.0), placed after this level's last operator -- or
           ;; none, when the left came from the primary: `\+ = a' is swipl's
           ;; operator_expected
           (if (> leftprec lmax)
               (block (if (!= lopt 0) (coco_clash r lopt)) break))
           ;; for positions: where the operator stands, and the left
           ;; operand's position and start, which the term built on it
           ;; begins with -- the term parsed last, so far
           (let ((size_t opf . #'(-> r tstart)) (size_t opt . #'(-> r pos))
                 (size_t lp . #'(-> r lpos)) (size_t lf . #'(-> r lfrom)))
             (set lopt opt) (set (-> r lopend) opt)
             (if (not (coco_next_token r)) (block (free heap) (return 0)))
             (let ((size_t right) (int rightprec))
               (if (not (,TERM r rmax (aof right) (aof rightprec)))
                   (block (coco_op_failed r name) (free heap) (return 0)))
               (set left (coco_make2_f (-> r m) (coco_parse_fid r name 0 2) left right))
               (set leftprec prec)
               (if ,P (coco_pos_infix r lp lf opf opt)))))))
     (free heap)
     (set (cof out) left)
     (set (cof outprec) leftprec)
     (return 1)))


;;;; ------------------------------------------------------------------
;;;; Declarations
;;;; ------------------------------------------------------------------

(generic decl-syntax
  ()

  ;;; Token kinds. NAME covers every atom-shaped token -- alphabetic, symbolic,
  ;;; quoted and solo -- because what distinguishes them matters to the lexer
  ;;; and not at all to the parser.
  (enum coco_token
    (COCO_TK_EOF    . 0)
    (COCO_TK_NAME   . 1)
    (COCO_TK_VAR    . 2)
    (COCO_TK_INT    . 3)
    (COCO_TK_FLOAT  . 4)
    (COCO_TK_STRING . 5)
    (COCO_TK_PUNCT  . 6)
    (COCO_TK_END    . 7)
    (COCO_TK_RAT    . 8))

  ;;; Operator types, matching *op-types* above.
  (enum coco_optype
    (COCO_XFX . 0) (COCO_XFY . 1) (COCO_YFX . 2) (COCO_FY . 3) (COCO_FX . 4))

  (decl) (func coco_op_infix  ((const char * s) (int * prec) (int * type)) (out int))
  (decl) (func coco_op_prefix ((const char * s) (int * prec) (int * type)) (out int))
  (decl) (func coco_op_is_any ((const char * s)) (out int))

  ;;; ---- operators a program declared -------------------------------------
  ;;;
  ;;; `*operators*' is read at BUILD time and emits both halves of the grammar,
  ;;; which is what stops the reader and the writer disagreeing about an
  ;;; operator. `op/3' cannot change that table, so it adds a second one that
  ;;; is consulted FIRST -- and an entry there with priority 0 hides the built-in
  ;;; of the same name, which is how `op(0, xfx, =)' takes one away.
  ;;;
  ;;; KIND is 0 for infix and 1 for prefix. cocolog's reader has no postfix, so
  ;;; there is no 2: `op/3' refuses `xf' and `yf' rather than accepting a
  ;;; declaration it would then ignore.
  (decl) (func coco_op_define ((const char * name) (int prec) (int type) (int kind))
               (out int))
  (decl) (func coco_op_dyn_clear ())

  ;;; The five specifiers cocolog's reader has, from their names. `xf' and `yf'
  ;;; are POSTFIX and the reader has none, so they are refused rather than
  ;;; accepted and then ignored -- which would leave a program believing it had
  ;;; declared something.
  (decl) (func coco_op_type_of ((const char * name) (int * type) (int * kind))
               (out int))

  ;;; Applies an `op(Priority, Type, Name)' TERM, Name being one name or a list
  ;;; of them. This is what a `:- op(...)' directive calls -- and it has to be
  ;;; reachable from kb.cicili, which is compiled before the engine and cannot
  ;;; run a goal, because the declaration must take effect for the REST OF THE
  ;;; FILE being read and not after it.
  (decl) (func coco_op_apply ((coco_machine * m) (size_t t) (char * err) (size_t errlen))
               (out int))

  ;;; Whether a name is DECLARED of this kind, and what as: -1 when nothing was
  ;;; declared, 0 when a declaration hid it, 1 with the priority and type filled
  ;;; in. `current_op/3' asks so that it does not list a built-in that a
  ;;; declaration has replaced.
  (decl) (func coco_op_dyn_lookup_pub ((const char * s) (int kind) (int * prec)
                                     (int * type)) (out int))
  (decl) (func coco_op_dyn_count () (out size_t))
  (decl) (func coco_op_dyn_at ((size_t i) (const char ** name) (int * prec)
                             (int * type) (int * kind)) (out int))

  ;;; The built-in table, one row at a time, for `current_op/3'.
  (decl) (func coco_op_static_count () (out size_t))
  (decl) (func coco_op_static_at ((size_t i) (const char ** name) (int * prec)
                                (int * type) (int * kind)) (out int))

  ;;; The reader. One of these reads a whole source text, clause by clause; the
  ;;; variable names of the clause just read stay in it so a caller can report
  ;;; `X = 1' rather than `_G17 = 1'.
  (struct coco_reader
    (member coco_machine * m)
    (member const char * src)
    (member size_t       pos)
    (member size_t       len)

    ;; the token in hand
    (member int          tok)
    (member coco_strbuf    text)
    (member i64          ival)
    ;; WHETHER AN INTEGER TOKEN'S MAGNITUDE FIT (2.0.0): 0 it is `ival',
    ;; 1 it is 2^63 (only the least integer, negated, takes it), 2 more
    (member int          iwide)
    (member double       fval)
    ;; A RATIONAL TOKEN'S PAIR (2.5.0), `digits r digits' as one token
    (member i64          rval_n)
    (member i64          rval_d)
    (member int          layout_before)   ; was there space before this token?

    ;; Was this NAME written in quotes? A QUOTED ATOM IS NOT AN OPERATOR:
    ;; `'-' - a' is infix `-' with the atom `-' on its left, where `- - a' is
    ;; prefix `-' applied to `-a'. The two are the same tokens and differ only
    ;; in this, which is why the lexer has to remember it.
    (member int          quoted)

    ;; WHERE THE TOKEN IN HAND STANDS in SRC: TSTART its first byte, after
    ;; the layout before it, and POS the one past its last -- the lexer
    ;; stops there, and reads no further until the next token is asked
    ;; for. One store a token; the positions read_term/3 answers (1.10.7)
    ;; are built from them only by the parser's second family, which
    ;; `coco_read_clause' takes when WANT_POS, and LPOS, LFROM and LTO
    ;; then describe the term parsed last -- its position term, and its
    ;; first byte and the one past its last. A position counts CHARACTERS
    ;; from PBASE, the character offset of SRC's first byte in whatever SRC
    ;; came from; CIDX turns a byte offset into a character offset once
    ;; SRC is found not to be all ASCII (CSCAN 0 unscanned, 1 ASCII, 2 CIDX
    ;; built). Consulting the translator's 1.25 MB (247 072 tokens) runs
    ;; `coco_next_token''s instructions exactly as 1.10.6 did, and the
    ;; parser's within 0.13 %, half of that alignment padding (callgrind).
    (member size_t       tstart)
    (member int          want_pos)
    (member i64          pbase)
    (member size_t *     cidx)
    (member int          cscan)
    (member size_t       lpos)
    (member size_t       lfrom)
    (member size_t       lto)

    ;; the variables of the clause being read
    (member char **      var_names)
    (member size_t *     var_cells)
    (member size_t       nvars)
    (member size_t       var_cap)

    (member char         err [192])
    (member int          failed)
    ;; WHERE AND WHY IT STOPPED (1.11.9): the first byte of the token in hand
    ;; when the reader failed, and the reason alone -- `err' says both as a
    ;; byte offset, for every reader of a term; a load says them as SWI
    ;; does, by the line and column (`coco_reader_load_error')
    (member size_t       epos)
    (member const char * ewhat)
    ;; WHERE THE CLAUSE BEING READ BEGAN (3.1.0): the first byte of its first
    ;; token, kept by `coco_read_clause' as it starts -- where
    ;; `coco_reader_resync' walks from after a syntax error, as swipl's raw
    ;; read of a clause's text walks from there
    (member size_t       cstart)
    ;; WHAT ENDS THE TERM BEING READ (3.2.0), past its priority: 0 nothing,
    ;; 1 a comma (an argument), 2 a comma or a bar (a list element); each
    ;; bracket sets its own and puts the one around it back
    (member int          stop)
    ;; WHAT SWIPL WOULD CALL THE FAILURE (3.10.0), decided where the reader
    ;; failed, as pl-read.c's complex_term decides it -- nil for a reason
    ;; the lexer's words name (`coco_reader_id'). A term that was
    ;; wanted and not there (EOPEN) is settled at its bracket
    ;; (`coco_term_close'): EOPS operators were passed on the way up to it,
    ;; EOPC the innermost's character when it is a comma or a semicolon,
    ;; and EPN the token it stopped at, for punct(Op, Next). An operator
    ;; that could not take what came before it is a CLASH at CLASH_TOK,
    ;; placed at CLASH_AT, the end of the operator before it (swipl's
    ;; last_token_start there); LOPEND is the end of the last operator
    ;; whose operand is being read. ECOMMENT is a block comment the text
    ;; ended in, at its first byte plus one.
    (member const char * esyn)
    (member int          eopen)
    (member int          eops)
    (member int          eopc)
    (member int          epn)
    (member int          clash_set)
    (member size_t       clash_at)
    (member size_t       lopend)
    (member size_t       ecomment)
    ;; A NAME `[]' THE BRACKETS MADE (3.12.0): set by `[]' or `[ ]' before a
    ;; `(' as the application is read, and taken by its arguments' read, so
    ;; `[](a)' is named by the list's end and a quoted `'[]'(a)' by the atom
    ;; `'[]'', as swipl 7's
    (member int          bnil)
    ;; A NUMBER TOKEN IN ANOTHER SCRIPT'S DIGITS (3.35.0,
    ;; `coco_lex_wide_number'): no minus before it is its sign
    (member int          wnum))

  (decl) (func coco_reader_init ((coco_reader * r) (coco_machine * m) (const char * src)))

  ;;; WHAT A LOAD SAYS OF A CLAUSE THAT WOULD NOT READ, AND WHERE (3.10.0),
  ;;; as swipl's raw read of a stream and its parse say it: the id (A1, A2 as
  ;;; `coco_reader_id' answers them) -- what the raw read refuses first, a
  ;;; text that ends in a quoted item or a block comment, a clause with no
  ;;; full stop before the end (end_of_file) or a full stop with nothing
  ;;; before it (end_of_clause) -- and the line from 1 and the column from
  ;;; 0, in BYTES as swipl 9 counts them (`z('áá', b c).' fails at column
  ;;; 12, 1.11.9). swipl places it by walking the clause's raw text from one
  ;;; column past its first character for one character less than the
  ;;; error's place, so a token on a later line of the clause is one column
  ;;; short of where it stands (`g(x\n  y).' says 2:1), and the refusals of
  ;;; the raw read are at the first character's column plus one; a block
  ;;; comment open before anything was read is at 0:1. Through 3.9.0 the
  ;;; place was the token's own (`coco_reader_place').
  (decl) (func coco_reader_load_error ((coco_reader * r) (int * line) (int * col)
                                        (int * a1) (int * a2)) (out const char *))
  ;;; swipl's id as a term: ID an atom, or punct(A1, A2), or ID(A1) for
  ;;; undefined_char_escape and end_of_file_in_quoted, each argument the
  ;;; atom of its character
  (decl) (func coco_syntax_id_term ((coco_machine * m) (const char * id) (int a1) (int a2))
                (out size_t))
  (decl) (func coco_reader_free ((coco_reader * r)))

  ;;; Reads one clause, up to and including its terminating `.'. Answers 1 and
  ;;; sets OUT, 0 at clean end of input, -1 on a syntax error -- in which case
  ;;; `r->err' says what and where.
  (decl) (func coco_read_clause ((coco_reader * r) (size_t * out)) (out int))

  ;;; After a syntax error, the next clause, where swipl's reader finds it
  ;;; (3.1.0): the reader put after the full stop that ends the clause it
  ;;; failed in, the next token in hand. 1, or 0 when that token would not
  ;;; read either -- the reader has failed again, further on.
  (decl) (func coco_reader_resync ((coco_reader * r)) (out int))

  ;;; SWIPL'S NAME FOR WHERE A READER FAILED (3.10.0): the syntax_error
  ;;; id, and its arguments as characters into A1 and A2 -- punct(A1, A2),
  ;;; undefined_char_escape(A1), end_of_file_in_quoted(A1) -- or 0. The
  ;;; parser's decision where it made one, else the lexer's reason in
  ;;; swipl's word.
  (decl) (func coco_reader_id ((coco_reader * r) (int * a1) (int * a2)) (out const char *))
  ;;; The byte swipl places that failure at: the token's first, or for a
  ;;; priority clash the end of the operator before it.
  (decl) (func coco_reader_errat ((coco_reader * r)) (out size_t))
  ;;; A term read, and a token after it that ends nothing (3.10.0): the
  ;;; reader failed there, as swipl's says it (operator_expected,
  ;;; cannot_start_term, operator_clash). 0.
  (decl) (func coco_reader_junk ((coco_reader * r)) (out int))
  ;;; A term read at the top that failed: a term wanted and not there is
  ;;; settled as the top's (end_of_clause, punct, operator_balance, ...).
  (decl) (func coco_reader_close_top ((coco_reader * r)))
  ;;; SWIPL'S SENTENCE FOR AN ID (3.10.0), messages.pl's syntax_error//1,
  ;;; into OUT: A1 and A2 as `coco_reader_id' answers them, DQ the
  ;;; double_quotes flag (0 codes, 1 chars, 2 atom, 3 string) for a quoted
  ;;; string the text ended in. An id it does not know is said as it is.
  (decl) (func coco_syntax_sentence ((const char * id) (int a1) (int a2) (int dq)
                                      (char * out) (size_t len)))

  ;;; SWIPL'S RAW READ OF ONE CLAUSE'S TEXT (3.10.0), pl-read.c's
  ;;; raw_read2: from FROM in S (N bytes), the end of the clause there, as
  ;;; swipl's reader finds it before it parses -- the byte after the `.'
  ;;; that ends it, or N. Layout and comments before the clause are passed
  ;;; over; inside it a comment is a space a character (a newline stays a
  ;;; newline), quoted text is walked with swipl's escapes (an octal or a
  ;;; hex escape takes the character after its digits, its closing
  ;;; backslash, and a quote there closes the item), `0'c' and a radix's
  ;;; quote (`16'ff') are no quoted items, a run of symbol characters is
  ;;; one token whatever it holds, and a full stop is a `.' that begins a
  ;;; token and is followed by layout, a `%' or the end. KIND: 0 a full
  ;;; stop ended it, 1 the end of the text did with something read, 2
  ;;; nothing was read, 3 the text ended in a quoted item (*Q its quote),
  ;;; 4 in a block comment, 5 straight after `0'' or a radix's quote
  ;;; (swipl's end_of_file), 6 a full stop with nothing before it. RAW,
  ;;; when not nil, gets the text swipl's syntax error quotes: from the
  ;;; clause's first character, the comments made spaces, and ending `. '
  ;;; -- after the full stop, or after a space put on the end when the
  ;;; text ended on no layout -- or, for 3 to 5, as far as the walk got.
  ;;; CHARS counts a comment's character as one space, else each byte.
  ;;; *AT0 is where the clause's first character is.
  (decl) (func coco_raw_walk ((const char * s) (size_t n) (size_t from) (coco_strbuf * raw)
                              (int chars) (int * kind) (int * q) (size_t * at0)) (out size_t))

  ;;; Reads one term from a reader that is already going, and does NOT insist
  ;;; on a terminating `.'. The point of taking the reader rather than the text
  ;;; is that its variable names survive the call, so a caller can report
  ;;; `X = 1' rather than `_G17 = 1' -- which is what a REPL and the tests need
  ;;; and what `coco_read_term_from' cannot give, having freed its reader.
  (decl) (func coco_read_goal ((coco_reader * r) (size_t * out)) (out int))

  ;;; Reads a single term from a NUL-terminated string, with or without a
  ;;; trailing `.'. This is what the KB backends use on text out of the
  ;;; database, and what the REPL uses on a line typed at it.
  (decl) (func coco_read_term_from ((coco_machine * m) (const char * src) (size_t * out)) (out int))

  ;;; Reads a NUMBER and nothing else, for number_codes/2, number_chars/2
  ;;; and atom_number/2 (2.5.0): leading layout and a sign written against
  ;;; the digits are allowed, and anything after the number -- even a space
  ;;; -- answers 0, as SWI's illegal_number rule does.
  (decl) (func coco_read_number_text ((coco_machine * m) (const char * src) (int strict) (size_t * out)) (out int))

  ;;; The writer. QUOTED puts quotes round an atom that needs them, so the
  ;;; output reads back; IGNORE_OPS writes `+(1,2)' instead of `1+2'. Canonical
  ;;; form -- what goes into the database -- is quoted with operators kept,
  ;;; which is both readable and re-readable.
  (decl) (func coco_write_term ((coco_machine * m) (coco_strbuf * b) (size_t t)
                              (int quoted) (int ignore_ops)) (out int))
  (decl) (func coco_write_canonical ((coco_machine * m) (coco_strbuf * b) (size_t t)) (out int))
  ;;; A write at a stated priority, for a layout that indents a clause: the
  ;;; mode word is the writer's (1, 8, 16, 64, 512 for listing/1's and
  ;;; portray_clause/1's layout) and MAXPREC the priority the term stands at.
  (decl) (func coco_write_pri ((coco_machine * m) (coco_strbuf * b) (size_t t)
                              (int mode) (int maxprec)) (out int))
  ;;; write_canonical/1's and `~k''s text, swipl's (3.1.0): no operators,
  ;;; and the variables `_' and `A', `B', ... by when the write meets them
  (decl) (func coco_write_canon ((coco_machine * m) (coco_strbuf * b) (size_t t)) (out int))

  ;;; Name a term's variables as numbervars/4 with singletons(true) names
  ;;; them: one met once is `_', the others `A' ... `Z', `A1' .... The map
  ;;; is then handed to the writer as `wcanon' (3.18.0, listing/1's and
  ;;; portray_clause/1's layout).
  (decl) (func coco_name_vars ((coco_machine * m) (size_t t) (coco_varmap * vm)) (out int))

  ;;; PRINT/1'S FORM (2.2.4), swipl's print/1 and format's `~p': quoted, and
  ;;; with numbervars, so `'$VAR'(1)' is written `B' (mode 8,
  ;;; `coco_write_numbervar'), and since 2.2.5 swipl's character escapes
  ;;; (mode 16, `'don\'t''), a code in them since 3.1.0 as `\u0001' (mode 64,
  ;;; swipl's character_escapes_unicode, where writeq/1's is `\x1\'). Through
  ;;; 2.2.3 print/1 was write/1.
  (decl) (func coco_write_print ((coco_machine * m) (coco_strbuf * b) (size_t t)) (out int))

  ;;; A WRITE IN THE MODE A PROGRAM'S WRITER ASKS FOR (2.2.5), the mode word
  ;;; whole: quoted 1, ignore_ops 2, numbervars 8, character escapes 16, a
  ;;; code escaped as `\u0001' 64 (3.1.0) and a curly term written `{}(x)' 128
  ;;; (3.1.0), and since 3.53.0 a list written as the compounds it is,
  ;;; `.(1,[])' 2048 (dotlists) and `'[|]'(1,[])' 4096 (no_lists). NAMED
  ;;; writes a cyclic term's variables S_1, S_2, ... (`coco_write_cyclic').
  ;;; write/1 is 8, writeq/1 25, print/1 89, write_term/2 what its options
  ;;; say; write_canonical/1 is `coco_write_canon''s 147.
  (decl) (func coco_write_mode ((coco_machine * m) (coco_strbuf * b) (size_t t)
                              (int mode) (int named)) (out int))

  ;;; A WRITE THAT ASKS PORTRAY (3.54.0), MODE with 8192: print/1's,
  ;;; `~p''s and write_term/2's portray(true) and portray_goal(G), each term
  ;;; of it but a variable asked of `coco_portray_hook' first, a cyclic term
  ;;; in its factors from the first, and a goal's throw left on the machine
  ;;; (`wpstate') with what came before it written.
  (decl) (func coco_write_portrayed ((coco_machine * m) (coco_strbuf * b) (size_t t)
                                   (int mode) (int named)) (out int))

  ;;; WRITE_TERM/2'S FULLSTOP(TRUE) (3.53.0, pl-write.c's PutToken(".")):
  ;;; the full stop after what B holds, a space before it where the two
  ;;; would be one token (`- .', `a:- .'), and NL a newline after it, else a
  ;;; space, so that a read of the text ends there.
  (decl) (func coco_write_fullstop ((coco_strbuf * b) (int nl)) (out int))

  ;;; THE FORM A CLAUSE IS STORED IN, which is quoted and with operators
  ;;; IGNORED -- `rule(===>(a,b))' and not `rule(a ===> b)'.
  ;;;
  ;;; The difference matters exactly once, and then it matters completely. A
  ;;; clause lives in the database as text and is parsed on the way back in, by
  ;;; whichever process happens to fetch it. If it were written with operators,
  ;;; a clause using one that `op/3' declared could only be read by a process
  ;;; that had made the same declaration -- and a second interpreter opening
  ;;; the same knowledge base has made no declarations at all. It would not
  ;;; fail loudly either: the clause simply would not parse, and the predicate
  ;;; would look empty.
  ;;;
  ;;; Written functionally it needs no operator table at all, so it reads the
  ;;; same in every process for ever. `listing' still shows operators, because
  ;;; that is for a person.
  (decl) (func coco_write_storable ((coco_machine * m) (coco_strbuf * b) (size_t t)) (out int))
  (decl) (func coco_print_term ((coco_machine * m) (FILE * f) (size_t t)))

  ;;; True when NAME can be written without quotes.
  (decl) (func coco_atom_needs_quotes ((const char * name)) (out int))

  ) ; decl-syntax


;;;; ------------------------------------------------------------------
;;;; Implementation
;;;; ------------------------------------------------------------------

(generic impl-syntax
  ()

  (coco-emit-op-lookup coco_op_infix_static  :infix)
  (coco-emit-op-lookup coco_op_prefix_static :prefix)
  (coco-emit-op-any)
  (coco-emit-op-static-count)
  (coco-emit-op-static-at)

  ;;; ---- the table a program can add to -----------------------------------

  ;;; A NAME OF ANY LENGTH (3.34.1, swipl's): a copy of its own, made by
  ;;; `coco_op_define' and freed by `coco_op_dyn_clear'. Through 3.34.0 it
  ;;; was a `char [64]', and op/3 of a longer name -- 64 bytes, 32 `é' --
  ;;; raised cocolog_error('that operator name will not fit').
  (struct coco_opdef
    (member char * name)
    (member int  prec)
    (member int  type)
    (member int  kind))

  (static) (var coco_opdef * coco_dynops)
  (static) (var size_t coco_ndynops)
  (static) (var size_t coco_dynopcap)

  ;;; An entry for NAME of this kind, or the count if there is none.
  (static)
  (func coco_op_dyn_find ((const char * name) (int kind)) (out size_t)
        (for ((size_t i . 0)) (< i coco_ndynops) ((++ i))
          (if (and (== ($ (nth i coco_dynops) kind) kind)
                   (== 0 (strcmp ($ (nth i coco_dynops) name) name)))
              (return i)))
        (return coco_ndynops))

  ;;; 1 with NAME defined, 0 when memory was refused (or NAME is nil)
  (func coco_op_define ((const char * name) (int prec) (int type) (int kind)) (out int)
        (if (== name nil) (return 0))
        (let ((size_t at . #'(coco_op_dyn_find name kind)))
          (if (< at coco_ndynops)
              (block (set ($ (nth at coco_dynops) prec) prec)
                     (set ($ (nth at coco_dynops) type) type)
                     (return 1)))
          (if (>= coco_ndynops coco_dynopcap)
              (let ((size_t ncap . #'(? (== coco_dynopcap 0) 8 (* coco_dynopcap 2)))
                    (coco_opdef * nb))
                (set nb (cast (coco_opdef *)
                              (realloc coco_dynops (* ncap (sizeof coco_opdef)))))
                (if (== nb nil) (return 0))
                (set coco_dynops nb)
                (set coco_dynopcap ncap)))
          (let ((char * copy . #'(strdup name)))
            (if (== copy nil) (return 0))
            (set ($ (nth coco_ndynops coco_dynops) name) copy))
          (set ($ (nth coco_ndynops coco_dynops) prec) prec)
          (set ($ (nth coco_ndynops coco_dynops) type) type)
          (set ($ (nth coco_ndynops coco_dynops) kind) kind)
          (set coco_ndynops (+ coco_ndynops 1))
          (return 1)))

  (func coco_op_dyn_clear ()
        (for ((size_t i . 0)) (< i coco_ndynops) ((++ i))
          (free ($ (nth i coco_dynops) name)))
        (set coco_ndynops 0))

  (func coco_op_type_of ((const char * name) (int * type) (int * kind)) (out int)
        (set (cof kind) 0)
        (if (== 0 (strcmp name "xfx")) (block (set (cof type) COCO_XFX) (return 1)))
        (if (== 0 (strcmp name "xfy")) (block (set (cof type) COCO_XFY) (return 1)))
        (if (== 0 (strcmp name "yfx")) (block (set (cof type) COCO_YFX) (return 1)))
        (set (cof kind) 1)
        (if (== 0 (strcmp name "fy"))  (block (set (cof type) COCO_FY) (return 1)))
        (if (== 0 (strcmp name "fx"))  (block (set (cof type) COCO_FX) (return 1)))
        (return 0))

  ;;; Whether op/3 takes H as one of its names: an atom, never `,', and `|'
  ;;; only as an infix of priority 0 or past 1000 (swipl's, 3.0.0).
  (static)
  (func coco_op_name_ok ((coco_machine * m) (size_t h) (i64 prec) (int kind)) (out int)
        (set h (coco_deref m h))
        (if (not (coco-tag-is ATOM (nth h (-> m heap)))) (return 0))
        (let ((const char * s . #'(coco_atom_name m (coco_name_of m h))))
          (if (== 0 (strcmp s ",")) (return 0))
          (if (and (== 0 (strcmp s "|"))
                   (or (!= kind 0) (and (!= prec 0) (< prec 1001))))
              (return 0)))
        (return 1))

  ;;; 1 with every name defined; -1 when op/3 would raise (3.0.0), err the
  ;;; reason and NOTHING defined, so that the directive runs op/3 as a goal
  ;;; and reports swipl's error term the way every raising directive is
  ;;; reported -- a declaration of `,' accepted here broke the reader for
  ;;; the rest of the run; 0 when memory is refused for a name (through
  ;;; 3.34.0 also when it was 64 bytes or more).
  (func coco_op_apply ((coco_machine * m) (size_t t) (char * err) (size_t errlen)) (out int)
        (let ((size_t p . #'(coco_deref m (coco_arg m t 0)))
              (size_t ty . #'(coco_deref m (coco_arg m t 1)))
              (size_t nm . #'(coco_deref m (coco_arg m t 2)))
              (size_t l . 0) (size_t budget . #'(-> m heap_len))
              (int type . 0) (int kind . 0) (i64 prec . 0))

          (if (not (coco-tag-is ATOM (nth ty (-> m heap))))
              (block (snprintf err errlen "op/3 wants an atom for its type") (return -1)))
          (if (not (coco-is-int (nth p (-> m heap))))
              (block (snprintf err errlen "op/3 wants an integer priority") (return -1)))
          (set prec (coco_int_val m (nth p (-> m heap))))
          (if (or (< prec 0) (> prec 1200))
              (block (snprintf err errlen "op/3: priority out of range") (return -1)))
          (if (not (coco_op_type_of (coco_atom_name m (coco_name_of m ty)) (aof type) (aof kind)))
              (block (snprintf err errlen "op/3: %s is not a specifier cocolog has"
                               (coco_atom_name m (coco_name_of m ty)))
                     (return -1)))

          ;; one name, or a list of them, every one checked before any is
          ;; defined
          (if (and (coco-tag-is ATOM (nth nm (-> m heap))) (not (coco_is_nil m nm)))
              (block (if (not (coco_op_name_ok m nm prec kind))
                         (block (snprintf err errlen "op/3 refuses that name") (return -1)))
                     (if (not (coco_op_define (coco_atom_name m (coco_name_of m nm))
                                            (cast int prec) type kind))
                         (block (snprintf err errlen "op/3: out of memory") (return 0)))
                     (return 1)))
          (set l nm)
          (while (and (coco_is_cons m l) (> budget 0))
            (if (not (coco_op_name_ok m (coco_arg m l 0) prec kind))
                (block (snprintf err errlen "op/3 refuses a name in its list") (return -1)))
            (set budget (- budget 1))
            (set l (coco_deref m (coco_arg m l 1))))
          (if (not (coco_is_nil m l))
              (block (snprintf err errlen "op/3 wants an atom or a list of atoms") (return -1)))
          (while (coco_is_cons m nm)
            (let ((size_t h . #'(coco_deref m (coco_arg m nm 0))))
              (if (not (coco_op_define (coco_atom_name m (coco_name_of m h))
                                     (cast int prec) type kind))
                  (block (snprintf err errlen "op/3: out of memory") (return 0))))
            (set nm (coco_deref m (coco_arg m nm 1))))
          (return 1)))
  (func coco_op_dyn_count () (out size_t) (return coco_ndynops))

  (func coco_op_dyn_at ((size_t i) (const char ** name) (int * prec)
                      (int * type) (int * kind)) (out int)
        (if (>= i coco_ndynops) (return 0))
        (set (cof name) ($ (nth i coco_dynops) name))
        (set (cof prec) ($ (nth i coco_dynops) prec))
        (set (cof type) ($ (nth i coco_dynops) type))
        (set (cof kind) ($ (nth i coco_dynops) kind))
        (return 1))

  ;;; ---- the lookups the grammar actually calls ---------------------------
  ;;;
  ;;; The declared table first, then the built-in one. A declared entry with
  ;;; priority 0 is not an operator: it hides the built-in and the lookup
  ;;; answers 0, which is what `op(0, T, N)' means.

  (static)
  (func coco_op_dyn_lookup ((const char * s) (int kind) (int * prec) (int * type))
        (out int)
        (let ((size_t at . #'(coco_op_dyn_find s kind)))
          (if (>= at coco_ndynops) (return -1))
          (if (== ($ (nth at coco_dynops) prec) 0) (return 0))
          (set (cof prec) ($ (nth at coco_dynops) prec))
          (set (cof type) ($ (nth at coco_dynops) type))
          (return 1)))

  (func coco_op_dyn_lookup_pub ((const char * s) (int kind) (int * prec) (int * type))
        (out int)
        (return (coco_op_dyn_lookup s kind prec type)))

  (func coco_op_infix ((const char * s) (int * prec) (int * type)) (out int)
        (let ((int d . #'(coco_op_dyn_lookup s 0 prec type)))
          (if (>= d 0) (return d)))
        (return (coco_op_infix_static s prec type)))

  (func coco_op_prefix ((const char * s) (int * prec) (int * type)) (out int)
        (let ((int d . #'(coco_op_dyn_lookup s 1 prec type)))
          (if (>= d 0) (return d)))
        (return (coco_op_prefix_static s prec type)))

  (func coco_op_is_any ((const char * s)) (out int)
        (let ((int p . 0) (int t . 0))
          (if (coco_op_infix s (aof p) (aof t)) (return 1))
          (if (coco_op_prefix s (aof p) (aof t)) (return 1))
          (return 0)))

  ;;; ---- character classes ---------------------------------------------
  ;;; All five fold to comparisons against literals. `symbol' is the set that
  ;;; makes a symbolic atom: `=..' and `-->' are one token each because a run
  ;;; of these characters is taken whole.

  (static) (func coco_is_lower ((int c)) (out int) (return (? (coco-ch-between c "a" "z") 1 0)))
  (static) (func coco_is_upper ((int c)) (out int)
                 (return (? (or (coco-ch-between c "A" "Z") (== c (coco-ch "_"))) 1 0)))
  (static) (func coco_is_digit ((int c)) (out int) (return (? (coco-ch-between c "0" "9") 1 0)))
  (static) (func coco_is_alnum ((int c)) (out int)
                 (return (? (or (coco-ch-between c "a" "z")
                                (or (coco-ch-between c "A" "Z")
                                    (or (coco-ch-between c "0" "9") (== c (coco-ch "_")))))
                            1 0)))
  ;;; The characters a symbolic atom is made of. The backslash is given as its
  ;;; code, not put in the string: this set ends with `$' only because a string
  ;;; ending in a backslash would not terminate (see the head of this file),
  ;;; and a set whose contents depend on their order is a trap. The colon joins
  ;;; it for symmetry.
  (static) (func coco_is_symbol ((int c)) (out int)
                 (return (? (or (coco-ch-in c "+-*/^<>=~.?@#&$")
                                (or (== c 92) (== c 58)))
                            1 0)))
  ;;; Layout: the space and the five controls swipl's table calls space,
  ;;; tab to return (3.35.0; through 3.34.1 not the vertical tab or the
  ;;; form feed, which were `illegal_character').
  (static) (func coco_is_space ((int c)) (out int)
                 (return (? (or (== c 32) (and (>= c 9) (<= c 13))) 1 0)))

  ;;; ---- a code point's class (3.35.0) -----------------------------------
  ;;; PAST ASCII THE READER TAKES WHAT swipl's TAKES, by the code point's
  ;;; classes (`coco_rd_flags', swipl's '$code_class'/2: pl-read.c's table
  ;;; up to U+00FF and pl-umap.c's past it): a letter begins or continues a
  ;;; name, a capital a variable, a symbol a run of symbols, a digit of
  ;;; another script a number, a space is layout. Through 3.34.1 every byte
  ;;; past ASCII outside quotes was `illegal_character'. The text is UTF-8
  ;;; whatever `text_units' says: a byte that is no UTF-8 is U+DC00 plus
  ;;; it, a code the reader refuses.

  ;;; The code at S[P] (N bytes in S) and its byte count into *W
  (static) (inline)
  (func coco_cp_at ((const char * s) (size_t n) (size_t p) (size_t * w)) (out i64)
        (let ((size_t j . p) (i64 c . #'(coco_utf8_get s n (aof j))))
          (set (cof w) (- j p))
          (return c)))

  ;;; The code that ends at S[E - 1], none of it before S[A]: a byte that
  ;;; ends no character there is U+DC00 plus it
  (static)
  (func coco_cp_before ((const char * s) (size_t n) (size_t a) (size_t e)) (out i64)
        (let ((size_t b . #'(- e 1)) (size_t w . 0) (i64 c . 0))
          (while (and (> b a) (and (< (- e b) 4) (== (bitand (cast int (nth b s)) 192) 128)))
            (set b (- b 1)))
          (set c (coco_cp_at s n b (aof w)))
          (if (== (+ b w) e) (return c))
          (return (+ 56320 (bitand (cast int (nth (- e 1) s)) 255)))))

  ;;; Whether code C is of KIND to the reader -- 1 layout, 2 a symbol, 8 a
  ;;; name's continuation -- ASCII by the lexer's own classes, which are
  ;;; swipl's table's
  (static)
  (func coco_rd_is ((i64 c) (int kind)) (out int)
        (if (< c 0) (return 0))
        (if (< c 128)
            (cond ((== kind 1) (return (coco_is_space (cast int c))))
                  ((== kind 2) (return (coco_is_symbol (cast int c))))
                  (#t (return (coco_is_alnum (cast int c))))))
        (return (!= 0 (bitand (coco_rd_flags c) (cast u32 kind)))))

  ;;; The byte count of a code of KIND at S[P] past ASCII, or 0
  (static)
  (func coco_rd_wide_at ((const char * s) (size_t n) (size_t p) (int kind)) (out size_t)
        (if (or (>= p n) (< (cast int (cast uchar (nth p s))) 128)) (return 0))
        (let ((size_t w . 0) (i64 c . #'(coco_cp_at s n p (aof w))))
          (return (? (coco_rd_is c kind) w 0))))

  ;;; WHETHER TWO PIECES OF OUTPUT NEED A SPACE BETWEEN THEM, which is the
  ;;; whole of the writer's spacing rule and is the reader's tokeniser read
  ;;; backwards: a space is needed exactly when the two would otherwise lex as
  ;;; ONE token. `a' and `-' do not merge, so `a-b'; `-' and `-' do, so
  ;;; `1- -2'; `mod' and `b' do, so `a mod b'.
  ;;;
  ;;; A is the last character already written and B the first of what comes
  ;;; next. Either being 0 -- nothing written, nothing coming -- needs nothing.
  ;;; A solo character (`,' `;' `!' `|') is in neither class and so never takes
  ;;; a space, which is why SWI writes `a,-1' and not `a, -1'.
  ;;;
  ;;; A QUOTE AFTER A DIGIT, AND A QUOTE AFTER A QUOTE, TAKE ONE TOO
  ;;; (3.15.1, pl-write.c's PutOpenToken): `x1 'x\'y' 2' and `'A' 'x\'y'
  ;;; 'B'', where `1'x\'y'' read as a character code and `'A''x\'y''' as
  ;;; one atom with a quote in it.
  ;;;
  ;;; ON CODE POINTS (3.35.0, pl-write.c's needSpace()): a letter, digit
  ;;; or `_' past ASCII as one of ASCII's, `1 éa 2', and a symbol past it as
  ;;; a symbol, `- ∀'; through 3.34.1 the two bytes' classes, `1éa 2'.
  ;;; The two class rules where A or B is past ASCII (3.35.0): the quote
  ;;; rules ask two ASCII codes, and so ask neither
  (weak) (cold)
  (func coco_needs_gap_wide ((int a) (int b)) (out int)
        (return (or (and (coco_rd_is a 2) (coco_rd_is b 2))
                    (and (coco_rd_is a 8) (coco_rd_is b 8)))))

  (static) (func coco_needs_gap ((int a) (int b)) (out int)
                 (if (or (== a 0) (== b 0)) (return 0))
                 (if (or (>= a 128) (>= b 128)) (return (coco_needs_gap_wide a b)))
                 (if (and (coco_is_symbol a) (coco_is_symbol b)) (return 1))
                 (if (and (coco_is_alnum a) (coco_is_alnum b)) (return 1))
                 (if (and (== b 39) (coco_is_digit a)) (return 1))
                 (if (and (== a 39) (== b 39)) (return 1))
                 (return 0))

  ;;; The code a buffer of a byte past ASCII at its end, or at its start,
  ;;; holds there (3.35.0)
  (weak) (cold)
  (func coco_sb_wide_end ((coco_strbuf * b) (int last)) (out int)
        (let ((size_t w . 0))
          (if last (return (cast int (coco_cp_before ($ (cof b) s) ($ (cof b) len) 0 ($ (cof b) len)))))
          (return (cast int (coco_cp_at ($ (cof b) s) ($ (cof b) len) 0 (aof w))))))

  ;;; The last character in a buffer, a code point (3.35.0), or 0 if it is
  ;;; empty.
  (static) (inline) (func coco_sb_last ((coco_strbuf * b)) (out int)
                 (if (or (== ($ (cof b) s) nil) (== ($ (cof b) len) 0)) (return 0))
                 (let ((int c . #'(bitand (cast int (nth (- ($ (cof b) len) 1) ($ (cof b) s))) 255)))
                   (if (< c 128) (return c))
                   (return (coco_sb_wide_end b 1))))

  ;;; The first character of a buffer, a code point (3.35.0), or 0 if it
  ;;; is empty.
  (static) (inline) (func coco_sb_first ((coco_strbuf * b)) (out int)
                 (if (or (== ($ (cof b) s) nil) (== ($ (cof b) len) 0)) (return 0))
                 (let ((int c . #'(bitand (cast int (nth 0 ($ (cof b) s))) 255)))
                   (if (< c 128) (return c))
                   (return (coco_sb_wide_end b 0))))

  ;;; ---- the character stream -------------------------------------------

  (static) (func coco_peek_at ((coco_reader * r) (size_t off)) (out int)
                 (if (>= (+ (-> r pos) off) (-> r len)) (return -1))
                 (return (cast int (cast uchar (nth (+ (-> r pos) off) (-> r src))))))

  (static) (func coco_peek ((coco_reader * r)) (out int) (return (coco_peek_at r 0)))

  (static) (func coco_bump ((coco_reader * r)) (set (-> r pos) (+ (-> r pos) 1)))

  ;;; After a float's fraction: 1 if `Inf' follows as a whole word, 2 if
  ;;; `NaN' does, 0 otherwise (73 110 102 and 78 97 78 are their codes).
  (static) (func coco_float_tag ((coco_reader * r)) (out int)
                 (if (coco_is_alnum (coco_peek_at r 3)) (return 0))
                 ;; nor a letter past ASCII (3.35.0, float_tag()'s PlIdContW())
                 (if (!= 0 (coco_rd_wide_at (-> r src) (-> r len) (+ (-> r pos) 3) 8)) (return 0))
                 (if (and (== (coco_peek_at r 0) 73)
                          (and (== (coco_peek_at r 1) 110) (== (coco_peek_at r 2) 102)))
                     (return 1))
                 (if (and (== (coco_peek_at r 0) 78)
                          (and (== (coco_peek_at r 1) 97) (== (coco_peek_at r 2) 78)))
                     (return 2))
                 (return 0))

  ;;; Records where and what, and answers 0 so every caller can `return' this
  ;;; call directly. The offset is into the source text the reader was given,
  ;;; which is what a caller loading a clause out of the database needs in
  ;;; order to say which clause would not read.
  ;;; The token's first byte and the bare reason are kept too (1.11.9),
  ;;; which a load turns into SWI's FILE:LINE:COL (`coco_reader_load_error')
  ;;; and swipl's id (`coco_reader_id'): every WHAT here is a literal, so
  ;;; the pointer outlives the reader.
  (static)
  (func coco_fail ((coco_reader * r) (const char * what)) (out int)
        (snprintf (-> r err) 192 "syntax error at offset %lu: %s"
                  (cast ulong (-> r pos)) what)
        (set (-> r epos) (? (<= (-> r tstart) (-> r pos)) (-> r tstart) (-> r pos)))
        (set (-> r ewhat) what)
        (set (-> r failed) 1)
        (return 0))

  ;;; THE READER'S REASON IN SWIPL'S WORD (3.10.0). It SETTLES the
  ;;; failure -- an escape that is no escape in a `0'c' is swipl's illegal
  ;;; number, placed at the number -- so it is asked before
  ;;; `coco_reader_errat'.
  (func coco_reader_id ((coco_reader * r) (int * a1) (int * a2)) (out const char *)
        (let ((const char * w . #'(-> r ewhat)) (const char * s . #'(-> r src))
              (size_t t . #'(-> r tstart)) (int zq . 0))
          (set (cof a1) 0) (set (cof a2) 0)
          (if (!= (-> r esyn) nil)
              (block (if (== 0 (strcmp (-> r esyn) "punct"))
                         (block (set (cof a1) (-> r eopc)) (set (cof a2) (-> r epn))))
                     (return (-> r esyn))))
          (if (== w nil) (return "operator_expected"))
          (set zq (and (< (+ t 1) (-> r len))
                       (and (== (nth t s) (cast char 48)) (== (nth (+ t 1) s) (cast char 39)))))
          (if (and zq (or (== 0 (strcmp w "unknown escape"))
                          (or (== 0 (strcmp w "undefined escape \\x"))
                              (or (== 0 (strcmp w "illegal character code"))
                                  (== 0 (strcmp w "illegal \\u or \\U sequence"))))))
              (block (set (-> r epos) t) (set (-> r esyn) "illegal_number")
                     (return "illegal_number")))
          (cond
            ((or (== 0 (strcmp w "illegal number"))
                 (== 0 (strcmp w "digits expected after radix prefix")))
             (return "illegal_number"))
            ;; swipl makes a bignum; with bounded integers it says this
            ((== 0 (strcmp w "integer out of range")) (return "integer_overflow"))
            ((== 0 (strcmp w "float overflow")) (return "float_overflow"))
            ((== 0 (strcmp w "numeric constant out of range"))
             (return "numeric constant out of range"))
            ((or (== 0 (strcmp w "unknown escape")) (== 0 (strcmp w "undefined escape \\x")))
             (let ((size_t i . #'(-> r epos)))
               (if (< i (-> r len))
                   (set (cof a1) (cast int (coco_utf8_get s (-> r len) (aof i)))))
               (return "undefined_char_escape")))
            ((== 0 (strcmp w "illegal \\u or \\U sequence")) (return "Illegal \\u or \\U sequence"))
            ((== 0 (strcmp w "illegal character code")) (return "Illegal character code"))
            ((== 0 (strcmp w "unexpected character")) (return "illegal_character"))
            ;; a prefix operator's atom before an infix bar
            ((== 0 (strcmp w "operator expected")) (return "quoted_punctuation"))
            ((== 0 (strcmp w "unterminated quoted item"))
             (if (< t (-> r len)) (set (cof a1) (bitand (cast int (nth t s)) 255)))
             (return "end_of_file_in_quoted"))
            ;; a block comment open to the end is the raw walk's to say,
            ;; which runs first in a load and in a text
            ((== 0 (strcmp w "unterminated character code")) (return "end_of_file")))
          (return "operator_expected")))

  (func coco_syntax_sentence ((const char * id) (int a1) (int a2) (int dq)
                              (char * out) (size_t len))
        (let ((const char * w . nil) (coco_strbuf c))
          (cond ((== 0 (strcmp id "end_of_clause")) (set w "Unexpected end of clause"))
                ((== 0 (strcmp id "end_of_clause_expected")) (set w "End of clause expected"))
                ((== 0 (strcmp id "end_of_file")) (set w "Unexpected end of file"))
                ((== 0 (strcmp id "end_of_file_in_block_comment"))
                 (set w "End of file in /* ... */ comment"))
                ((== 0 (strcmp id "illegal_number")) (set w "Illegal number"))
                ((== 0 (strcmp id "long_atom")) (set w "Atom too long (see style_check/1)"))
                ((== 0 (strcmp id "long_string")) (set w "String too long (see style_check/1)"))
                ((== 0 (strcmp id "operator_clash")) (set w "Operator priority clash"))
                ((== 0 (strcmp id "operator_expected")) (set w "Operator expected"))
                ((== 0 (strcmp id "operator_balance")) (set w "Unbalanced operator"))
                ((== 0 (strcmp id "quoted_punctuation"))
                 (set w "Operand expected, unquoted comma or bar found"))
                ((== 0 (strcmp id "list_rest")) (set w "Unexpected comma or bar in rest of list"))
                ((== 0 (strcmp id "cannot_start_term")) (set w "Illegal start of term"))
                ((== 0 (strcmp id "void_not_allowed")) (set w "Empty argument list \"()\"")))
          (if (!= w nil) (block (snprintf out len "%s" w) (return)))
          ;; the three with an argument, each a character
          (coco_sb_init (aof c))
          (cond
            ((== 0 (strcmp id "punct"))
             (coco_sb_put (aof c) "Unexpected `")
             (coco_utf8_put (aof c) (cast i64 a1))
             (coco_sb_put (aof c) "' before `")
             (coco_utf8_put (aof c) (cast i64 a2))
             (coco_sb_putc (aof c) (cast char 39)))
            ((== 0 (strcmp id "undefined_char_escape"))
             (coco_sb_put (aof c) "Unknown character escape in quoted atom or string: `")
             (coco_sb_putc (aof c) (cast char 92))
             (coco_utf8_put (aof c) (cast i64 a1))
             (coco_sb_putc (aof c) (cast char 39)))
            ((== 0 (strcmp id "end_of_file_in_quoted"))
             ;; a string's type is the double_quotes flag's, a back quote's
             ;; the back_quotes flag's (codes, the one value here)
             (coco_sb_put (aof c) "End of file in quoted ")
             (coco_sb_put (aof c) (? (== a1 39) "atom"
                                     (? (== a1 96) "codes"
                                        (? (== dq 1) "chars"
                                           (? (== dq 2) "atom"
                                              (? (== dq 3) "string" "codes")))))))
            (#t (coco_sb_put (aof c) id)))
          (snprintf out len "%s" (? (== ($ c s) nil) "" ($ c s)))
          (coco_sb_free (aof c))))

  (static)
  (func coco_syntax_char_atom ((coco_machine * m) (int c)) (out size_t)
        (let ((coco_strbuf b) (size_t a . 0))
          (coco_sb_init (aof b))
          (coco_utf8_put (aof b) (cast i64 c))
          (set a (coco_new_atom m (? (== ($ b s) nil) "" ($ b s))))
          (coco_sb_free (aof b))
          (return a)))

  (func coco_syntax_id_term ((coco_machine * m) (const char * id) (int a1) (int a2))
        (out size_t)
        (cond
          ((== 0 (strcmp id "punct"))
           (return (coco_make2 m "punct" (coco_syntax_char_atom m a1) (coco_syntax_char_atom m a2))))
          ((or (== 0 (strcmp id "undefined_char_escape")) (== 0 (strcmp id "end_of_file_in_quoted")))
           (return (coco_make1 m id (coco_syntax_char_atom m a1)))))
        (return (coco_new_atom m id)))

  (func coco_reader_errat ((coco_reader * r)) (out size_t)
        (if (and (!= (-> r esyn) nil) (== 0 (strcmp (-> r esyn) "operator_clash")))
            (return (-> r clash_at)))
        (return (-> r epos)))

  ;;; The characters of S from A to B: a byte that begins one when CHARS,
  ;;; else every byte.
  (static)
  (func coco_raw_chars ((const char * s) (size_t a) (size_t b) (int chars)) (out i64)
        (let ((i64 k . 0))
          (for ((size_t i . a)) (< i b) ((++ i))
            (if (or (not chars) (!= (bitand (cast int (nth i s)) 192) 128)) (set k (+ k 1))))
          (return k)))

  (func coco_reader_load_error ((coco_reader * r) (int * line) (int * col)
                                (int * a1) (int * a2)) (out const char *)
        (let ((const char * s . #'(-> r src)) (size_t n . #'(-> r len))
              (int chars . #'(-> (-> r m) text_chars)) (int kind . 0) (int q . 0)
              (size_t at0 . 0) (size_t at . 0) (const char * id . nil)
              (i64 walk . 0) (int ln . 1) (int cl . 0) (coco_strbuf raw))
          (set (cof a1) 0) (set (cof a2) 0)
          (coco_sb_init (aof raw))
          (coco_raw_walk s n (-> r cstart) (aof raw) chars (aof kind) (aof q) (aof at0))
          (cond
            ((== kind 3) (set id "end_of_file_in_quoted") (set (cof a1) q))
            ((== kind 4) (set id "end_of_file_in_block_comment"))
            ((== kind 6) (set id "end_of_clause"))
            ;; no full stop before the end: a stream's raw read refuses it
            ;; there, at its last character
            ((or (== kind 1) (== kind 5))
             (set id "end_of_file")
             (set walk (- (coco_raw_chars s at0 n chars) 1)))
            (#t
             (set id (coco_reader_id r a1 a2))
             ;; a place before the clause's first character walks nothing:
             ;; the clamp below makes it that character
             (set at (coco_reader_errat r))
             (set walk (- (coco_raw_chars s at0 at chars) 1))))
          ;; the column the clause begins at, in characters, as swipl's
          ;; stream counts its line position (3.35.0; through 3.34.1 in
          ;; bytes: `p(α). q(x y).' failed at 11, swipl's 10)
          (for ((size_t i . 0)) (< i at0) ((++ i))
            (if (== (nth i s) (cast char 10))
                (block (set ln (+ ln 1)) (set cl 0))
              (if (or (not chars) (!= (bitand (cast int (nth i s)) 192) 128))
                  (set cl (+ cl 1)))))
          (cond
            ;; a block comment open before anything was read has no place
            ((and (== kind 4) (>= at0 n)) (set ln 0) (set cl 1))
            ;; the error at the clause's first character is at its column
            ((< walk 0) (set walk 0))
            ;; else the walk, over the RAW text: a comment's character is
            ;; the one space it is there, and any other's bytes are
            ;; columns, swipl's (`w(/* é */ a b).' fails at 12)
            (#t
             (set cl (+ cl 1))
             (let ((size_t p . 0) (i64 k . 0) (size_t rn . #'($ raw len)))
               (while (and (< p rn) (< k walk))
                 (if (== (nth p ($ raw s)) (cast char 10))
                     (block (set ln (+ ln 1)) (set cl 0))
                   (set cl (+ cl 1)))
                 (set p (+ p 1))
                 (if chars
                     (while (and (< p rn) (== (bitand (cast int (nth p ($ raw s))) 192) 128))
                       (set cl (+ cl 1)) (set p (+ p 1))))
                 (set k (+ k 1)))
               ;; THE CHARACTER RIGHT BEFORE THE ERROR'S TOKEN is its bytes
               ;; less one more (3.35.0): swipl's ptr_to_location() counts
               ;; the bytes up to the token, `p(∀0'a).' at 5, where this
               ;; counted the one column, 3
               (if (and chars (and (< p rn) (!= (nth p ($ raw s)) (cast char 10))))
                   (let ((size_t q . #'(+ p 1)))
                     (while (and (< q rn) (== (bitand (cast int (nth q ($ raw s))) 192) 128))
                       (set q (+ q 1)))
                     (set cl (+ cl (cast int (- q (+ p 1))))))))))
          (coco_sb_free (aof raw))
          (set (cof line) ln)
          (set (cof col) cl)
          (return id)))

  (static) (decl) (func coco_skip_layout ((coco_reader * r) (int any)) (out int))

  ;;; Layout past ASCII at the reader's position (3.35.0), swipl's
  ;;; PlBlankW(): U+00A0, U+2028, U+3000 and their kin, and then the layout
  ;;; after it. Out of line and cold, and reached by a tail call, so the
  ;;; skip's own loop saves no register: inlined there, each token's skip
  ;;; pushed and popped six, a start 846 000 instructions more.
  (weak) (cold)
  (func coco_skip_layout_wide ((coco_reader * r) (int any)) (out int)
        (let ((size_t w . #'(coco_rd_wide_at (-> r src) (-> r len) (-> r pos) 1)))
          (if (== w 0) (return any))
          (set (-> r pos) (+ (-> r pos) w))
          (return (coco_skip_layout r 1))))

  ;;; Whitespace, `%' to end of line, and nested-free /* */ blocks. Whether
  ;;; anything was skipped is recorded, because `f(' and `f (' are different
  ;;; things in Prolog and this is the only place that difference is visible:
  ;;; ANY is 1 where layout went before, else 0.
  (static)
  (func coco_skip_layout ((coco_reader * r) (int any)) (out int)
        (block
          (while 1
            (let ((int c . #'(coco_peek r)))
              (cond
                ((coco_is_space c) (coco_bump r) (set any 1))
                ((== c (coco-ch "%"))
                 (set any 1)
                 (while (and (!= (coco_peek r) -1) (!= (coco_peek r) 10)) (coco_bump r)))
                ((and (== c (coco-ch "/")) (== (coco_peek_at r 1) (coco-ch "*")))
                 (set any 1)
                 ;; one the text ends in is swipl's end_of_file_in_block_comment
                 ;; (3.10.0), which `coco_next_token' says, at the comment
                 (let ((size_t cs . #'(-> r pos)))
                   (coco_bump r) (coco_bump r)
                   (while (and (!= (coco_peek r) -1)
                               (not (and (== (coco_peek r) (coco-ch "*"))
                                         (== (coco_peek_at r 1) (coco-ch "/")))))
                     (coco_bump r))
                   (if (!= (coco_peek r) -1) (block (coco_bump r) (coco_bump r))
                     (set (-> r ecomment) (+ cs 1)))))
                ((< c 128) (return any))
                ;; a code past ASCII: swipl's layout, or the token's start
                (#t (return (coco_skip_layout_wide r any))))))
          (return any)))

  ;;; ---- tokens ----------------------------------------------------------

  ;;; The escapes a quoted atom or a string may contain. Answers the character,
  ;;; or -1 if this is not an escape cocolog knows.
  (static)
  (func coco_escape_char ((int c)) (out int)
        (cond ((== c (coco-ch "n")) (return 10))
              ((== c (coco-ch "t")) (return 9))
              ((== c (coco-ch "r")) (return 13))
              ((== c (coco-ch "a")) (return 7))
              ((== c (coco-ch "b")) (return 8))
              ((== c (coco-ch "f")) (return 12))
              ((== c (coco-ch "v")) (return 11))
              ((== c (coco-ch "0")) (return 0))
              ((== c 92) (return 92))          ; a backslash escapes itself
              ((== c (coco-ch "'")) (return 39))
              ((== c 34) (return 34))          ; a double quote; see below
              (#t (return -1))))

  ;;; A hexadecimal digit's value, or -1.
  (static) (inline)
  (func coco_hex_digit ((int c)) (out int)
        (cond ((coco_is_digit c) (return (- c (coco-ch "0"))))
              ((coco-ch-between c "a" "f") (return (+ 10 (- c (coco-ch "a")))))
              ((coco-ch-between c "A" "F") (return (+ 10 (- c (coco-ch "A")))))
              (#t (return -1))))

  ;;; The digits of an escape in BASE (8 or 16), as many as come -- or, MAX
  ;;; not 0, exactly MAX of them -- into *V: how many were read. A value past
  ;;; U+10FFFF stays past it, however many digits follow.
  (static)
  (func coco_lex_escape_digits ((coco_reader * r) (int base) (int max) (i64 * v)) (out int)
        (let ((int n . 0))
          (set (cof v) 0)
          (while (or (== max 0) (< n max))
            (let ((int d . #'(coco_hex_digit (coco_peek r))))
              (if (or (< d 0) (>= d base)) break)
              (if (<= (cof v) 1114111) (set (cof v) (+ (* (cof v) base) d)))
              (set n (+ n 1))
              (coco_bump r)))
          (return n)))

  ;;; ONE ESCAPE, the reader just past its backslash (3.1.0, swipl's): the
  ;;; code into *OUT and 1; 2 for a continuation, which is no character --
  ;;; a newline and the white space after it, or `\c' and all the layout
  ;;; after it; 0 when it is no escape, the reader failed. The letters of
  ;;; `coco_escape_char', and `\e' (escape), `\s' (space) and a backquote;
  ;;; `\xHEX\' and `\OCTAL\', any number of digits, the closing backslash
  ;;; optional; `\uXXXX' and `\UXXXXXXXX', exactly four and eight. A code
  ;;; past U+10FFFF or a surrogate is refused, as swipl refuses it: text
  ;;; made from codes may hold a surrogate, a read escape may not.
  (static)
  (func coco_lex_escape ((coco_reader * r) (i64 * out)) (out int)
        ;; AT is the escape's letter and CAT its digits' first (3.10.0):
        ;; where swipl places a bad one
        (let ((int c . #'(coco_peek r)) (i64 v . 0) (int n . 0)
              (size_t at . #'(-> r pos)) (size_t cat . #'(-> r pos)))
          (cond
            ((== c (coco-ch "x"))
             (coco_bump r)
             (set cat (-> r pos))
             (set n (coco_lex_escape_digits r 16 0 (aof v)))
             (if (== n 0)
                 (block (coco_fail r "undefined escape \\x") (set (-> r epos) at) (return 0)))
             (if (== (coco_peek r) 92) (coco_bump r)))
            ((coco-ch-between c "0" "7")
             (coco_lex_escape_digits r 8 0 (aof v))
             (if (== (coco_peek r) 92) (coco_bump r)))
            ((or (== c (coco-ch "u")) (== c (coco-ch "U")))
             (coco_bump r)
             (let ((int want . #'(? (== c (coco-ch "u")) 4 8)))
               (if (!= want (coco_lex_escape_digits r 16 want (aof v)))
                   (block (coco_fail r "illegal \\u or \\U sequence") (set (-> r epos) at) (return 0)))))
            ((== c 10)
             (coco_bump r)
             (while (or (== (coco_peek r) 32) (== (coco_peek r) 9)) (coco_bump r))
             (return 2))
            ((== c (coco-ch "c"))
             (coco_bump r)
             (while (coco_is_space (coco_peek r)) (coco_bump r))
             (return 2))
            ((== c (coco-ch "e")) (coco_bump r) (set v 27))
            ((== c (coco-ch "s")) (coco_bump r) (set v 32))
            ((== c 96) (coco_bump r) (set v 96))
            (#t
             (let ((int e . #'(coco_escape_char c)))
               ;; placed at the escape's letter, as swipl places it --
               ;; `c('a\qb').' at column 5 -- not at the quote that opens
               ;; the token (3.1.0)
               (if (== e -1)
                   (block (coco_fail r "unknown escape")
                          (set (-> r epos) (-> r pos))
                          (return 0)))
               (coco_bump r)
               (set v e))))
          (if (or (> v 1114111) (and (>= v 55296) (<= v 57343)))
              (block (coco_fail r "illegal character code") (set (-> r epos) cat) (return 0)))
          (set (cof out) v)
          (return 1)))

  ;;; A quoted item, ending at QUOTE. Doubling the quote is how a quote is
  ;;; written inside one -- 'it''s' -- and backslash escapes are accepted
  ;;; too (`coco_lex_escape'): a code past 127 is put as its character's
  ;;; UTF-8, or under `text_units = bytes' as the byte below 256.
  (static)
  (func coco_lex_quoted ((coco_reader * r) (int quote)) (out int)
        (coco_bump r)
        (while 1
          (let ((int c . #'(coco_peek r)))
            (cond
              ((== c -1) (return (coco_fail r "unterminated quoted item")))
              ((== c quote)
               (coco_bump r)
               (if (== (coco_peek r) quote)
                   (block (coco_sb_putc (aof (-> r text)) (cast char quote)) (coco_bump r))
                 (return 1)))
              ((== c 92)
               (coco_bump r)
               (let ((i64 e . 0) (int k . #'(coco_lex_escape r (aof e))))
                 (if (== k 0) (return 0))
                 (if (== k 1)
                     (if (or (< e 128) (and (not (-> (-> r m) text_chars)) (< e 256)))
                         (coco_sb_putc (aof (-> r text)) (cast char e))
                         (coco_utf8_put (aof (-> r text)) e)))))
              (#t (coco_sb_putc (aof (-> r text)) (cast char c)) (coco_bump r)))))
        (return 1))

  ;;; ONE DIGIT D MORE OF A LITERAL'S MAGNITUDE (2.0.0): V becomes V * BASE
  ;;; + D while that is no more than 2^63, the least integer's magnitude;
  ;;; past it answers 1, V left where it was. Unsigned, so nothing here
  ;;; overflows.
  (static) (inline)
  (func coco_mag_digit ((u64 * v) (u64 base) (u64 d)) (out int)
        (let ((u64 lim . #'(+ (cast u64 9223372036854775807) 1)))
          (if (> (cof v) (/ (- lim d) base)) (return 1))
          (set (cof v) (+ (* (cof v) base) d))
          (return 0)))

  ;;; An integer token of magnitude V, WIDE when it went past 2^63: `ival'
  ;;; and `iwide' as the parser reads them.
  (static)
  (func coco_mag_token ((coco_reader * r) (u64 v) (int wide))
        (set (-> r tok) COCO_TK_INT)
        (set (-> r ival) 0)
        (cond
          (wide (set (-> r iwide) 2))
          ((> v (cast u64 9223372036854775807)) (set (-> r iwide) 1))
          (#t (set (-> r iwide) 0) (set (-> r ival) (cast i64 v)))))

  ;;; A digit's value in RADIX (2 to 36: 0-9, then a-z or A-Z), or -1.
  (static) (inline)
  (func coco_radix_digit ((int c) (int radix)) (out int)
        (let ((int d . -1))
          (cond ((coco_is_digit c) (set d (- c (coco-ch "0"))))
                ((coco-ch-between c "a" "z") (set d (+ 10 (- c (coco-ch "a")))))
                ((coco-ch-between c "A" "Z") (set d (+ 10 (- c (coco-ch "A"))))))
          (return (? (< d radix) d -1))))

  ;;; A DIGIT GROUP'S SEPARATOR (3.1.0, swipl's), the reader just past a
  ;;; digit of RADIX: `_' and any layout -- comments too -- or, for a radix
  ;;; of ten or less, exactly one space, each only before a digit of RADIX:
  ;;; 1, and the reader past it; else 0, and the reader where it was.
  ;;; `1_000_000', `1 000 000' and `16'f_f' are numbers; `1__0', `1_' and
  ;;; `1  000' are not.
  (static)
  (func coco_lex_group ((coco_reader * r) (int radix)) (out int)
        (let ((size_t at . #'(-> r pos)))
          (cond
            ((== (coco_peek r) (coco-ch "_"))
             (coco_bump r)
             (coco_skip_layout r 0))
            ((and (== (coco_peek r) 32) (<= radix 10)) (coco_bump r))
            (#t (return 0)))
          (if (>= (coco_radix_digit (coco_peek r) radix) 0) (return 1))
          (set (-> r pos) at)
          (return 0)))

  ;;; The digits of a number in RADIX, groups and all, into *V: how many,
  ;;; negated when the magnitude went past 2^63 (`coco_mag_digit'), and 0
  ;;; for none.
  (static)
  (func coco_lex_radix_digits ((coco_reader * r) (int radix) (u64 * v)) (out int)
        (let ((int n . 0) (int wide . 0))
          (set (cof v) 0)
          (while 1
            (let ((int d . #'(coco_radix_digit (coco_peek r) radix)))
              (if (< d 0)
                  (if (or (== n 0) (not (coco_lex_group r radix))) break)
                  (block
                    (if (not wide) (set wide (coco_mag_digit v (cast u64 radix) (cast u64 d))))
                    (set n (+ n 1))
                    (coco_bump r)))))
          (return (? wide (- 0 n) n))))

  ;;; A number. `0'c' is a character code, 0x/0o/0b are radix prefixes,
  ;;; `R'DIGITS' a number in radix R from 2 to 36 (3.1.0, swipl's), and a
  ;;; `.' only starts a fraction when a digit follows it -- otherwise it is the
  ;;; end of the clause, which is why `f(1).' does not read as a float. The
  ;;; digits of an integer, of the integer part of a float, of a radix's and
  ;;; of a rational's two sides come in groups (`coco_lex_group'); a grouped
  ;;; integer takes no exponent without a fraction, as swipl's.
  (static) (decl) (func coco_lex_decimal_rest ((coco_reader * r) (int grouped)) (out int))
  (static)
  (func coco_lex_number ((coco_reader * r)) (out int)
        (if (and (== (coco_peek r) (coco-ch "0")) (== (coco_peek_at r 1) (coco-ch "'")))
            (block (coco_bump r) (coco_bump r)
                   (let ((int c . #'(coco_peek r)))
                     (if (== c -1) (return (coco_fail r "unterminated character code")))
                     ;; ONE CHARACTER of however many bytes under `text_units
                     ;; = characters' (1.13.0): 0'á is 225, where bytes read
                     ;; its first byte and stop at its second
                     (if (and (>= c 128) (-> (-> r m) text_chars))
                         (let ((size_t i . #'(-> r pos)))
                           (set (-> r ival) (coco_utf8_get (-> r src) (-> r len) (aof i)))
                           (set (-> r iwide) 0)
                           (set (-> r pos) i)
                           (set (-> r tok) COCO_TK_INT)
                           (return 1)))
                     (coco_bump r)
                     ;; ISO writes the quote doubled after the 0 and its
                     ;; quote, and swipl takes it single too (3.1.0): 39
                     ;; either way
                     (if (and (== c 39) (== (coco_peek r) 39)) (coco_bump r))
                     (let ((i64 code . #'(cast i64 c)))
                       (cond
                         ;; the newline after the backslash is the code, swipl's
                         ((and (== c 92) (== (coco_peek r) 10)) (coco_bump r) (set code 10))
                         ;; and `0'\c' is the c, no continuation (3.10.0, swipl's)
                         ((and (== c 92) (== (coco_peek r) (coco-ch "c"))) (coco_bump r) (set code 99))
                         ((== c 92)
                          (let ((int k . #'(coco_lex_escape r (aof code))))
                            (if (== k 0) (return 0))
                            ;; a continuation is no character to take the code of
                            (if (== k 2) (return (coco_fail r "unterminated character code"))))))
                       (set (-> r ival) code))
                     (set (-> r iwide) 0)
                     (set (-> r tok) COCO_TK_INT)
                     (return 1))))
        (if (== (coco_peek r) (coco-ch "0"))
            (let ((int p . #'(coco_peek_at r 1)) (int base . 0))
              (cond ((or (== p (coco-ch "x")) (== p (coco-ch "X"))) (set base 16))
                    ((or (== p (coco-ch "o")) (== p (coco-ch "O"))) (set base 8))
                    ((or (== p (coco-ch "b")) (== p (coco-ch "B"))) (set base 2)))
              (if (!= base 0)
                  (block (coco_bump r) (coco_bump r)
                         (let ((u64 v . 0) (int n . #'(coco_lex_radix_digits r base (aof v))))
                           (if (== n 0) (return (coco_fail r "digits expected after radix prefix")))
                           (coco_mag_token r v (< n 0))
                           (return 1))))))
        ;; plain decimal, possibly a float, or a rational `N r D' (2.5.0):
        ;; SWI's one-token form, no spaces and no sign after the r
        (coco_sb_reset (aof (-> r text)))
        (let ((int grouped . 0))
          (while 1
            (while (coco_is_digit (coco_peek r))
              (coco_sb_putc (aof (-> r text)) (cast char (coco_peek r))) (coco_bump r))
            (if (not (coco_lex_group r 10)) break)
            (set grouped 1))
          ;; R'DIGITS (3.1.0): a radix written plain, 2 to 36, its quote and a
          ;; digit of it -- `16'ff', `2'1010', `36'zz'
          (if (and (not grouped) (== (coco_peek r) 39) (<= ($ (-> r text) len) 2))
              (let ((int radix . #'(atoi ($ (-> r text) s))))
                (if (and (>= radix 2) (<= radix 36)
                         (>= (coco_radix_digit (coco_peek_at r 1) radix) 0))
                    (let ((u64 v . 0) (int n . 0))
                      (coco_bump r)
                      (set n (coco_lex_radix_digits r radix (aof v)))
                      (coco_mag_token r v (< n 0))
                      (return 1)))))
          (return (coco_lex_decimal_rest r grouped))))

  ;;; The rest of a decimal number, its integer part's digits in the
  ;;; reader's text (GROUPED when they came in groups): a rational's
  ;;; denominator, a fraction, an exponent, or nothing more.
  (static)
  (func coco_lex_decimal_rest ((coco_reader * r) (int grouped)) (out int)
        (if (and (== (coco_peek r) (coco-ch "r")) (coco_is_digit (coco_peek_at r 1)))
            (block
              (coco_bump r)
              (let ((u64 dv . 0) (int nd . #'(coco_lex_radix_digits r 10 (aof dv)))
                    (int dwide . #'(< nd 0)))
                (let ((u64 nv . 0) (int nwide . 0)
                      (const char * ds . #'($ (-> r text) s)))
                  (for ((size_t i . 0)) (and (not nwide) (!= (nth i ds) 0)) ((++ i))
                    (set nwide (coco_mag_digit (aof nv) 10
                                               (cast u64 (- (cast int (nth i ds))
                                                            (coco-ch "0"))))))
                  ;; a denominator of zero, or either side past 64 bits, is
                  ;; SWI's `illegal number' here
                  (if (or (== nd 0) (or dwide (== dv 0)))
                      (return (coco_fail r "illegal number")))
                  (if (or nwide (or (> nv 9223372036854775807)
                                    (> dv 9223372036854775807)))
                      (return (coco_fail r "integer out of range")))
                  (set (-> r rval_n) (cast i64 nv))
                  (set (-> r rval_d) (cast i64 dv))
                  (set (-> r tok) COCO_TK_RAT)
                  (return 1)))))
        (let ((int isfloat . 0) (int tag . 0))
          (if (and (== (coco_peek r) (coco-ch ".")) (coco_is_digit (coco_peek_at r 1)))
              (block (set isfloat 1)
                     (coco_sb_putc (aof (-> r text)) (cast char (coco-ch "."))) (coco_bump r)
                     (while (coco_is_digit (coco_peek r))
                       (coco_sb_putc (aof (-> r text)) (cast char (coco_peek r))) (coco_bump r))
                     (set tag (coco_float_tag r))))
          (if (and (== tag 0) (or isfloat (not grouped))
                   (or (== (coco_peek r) (coco-ch "e")) (== (coco_peek r) (coco-ch "E"))))
              (let ((int off . 1))
                (if (or (== (coco_peek_at r 1) (coco-ch "+")) (== (coco_peek_at r 1) (coco-ch "-")))
                    (set off 2))
                (if (coco_is_digit (coco_peek_at r (cast size_t off)))
                    (block (set isfloat 1)
                           (coco_sb_putc (aof (-> r text)) (cast char (coco_peek r))) (coco_bump r)
                           (if (== off 2)
                               (block (coco_sb_putc (aof (-> r text)) (cast char (coco_peek r)))
                                      (coco_bump r)))
                           (while (coco_is_digit (coco_peek r))
                             (coco_sb_putc (aof (-> r text)) (cast char (coco_peek r)))
                             (coco_bump r))))))
          (if isfloat
              (block (set (-> r fval) (strtod ($ (-> r text) s) nil))
                     ;; A LITERAL PAST THE LARGEST DOUBLE IS SWIPL'S
                     ;; float_overflow (3.10.0): through 3.9.0 `1.0e400' read
                     ;; as the infinity strtod answers for it
                     (if (and (== tag 0) (> (-> r fval) 1.7976931348623157e308))
                         (return (coco_fail r "float overflow")))
                     ;; 1.0Inf and 1.5NaN, SWI's spelling of the two values no
                     ;; digits say, which the writer writes (1.10.28): any
                     ;; mantissa before Inf, one between 1 and 2 before NaN
                     ;; (1.0NaN is SWI's syntax error too, and outside 1 and 2
                     ;; the NaN is no part of the number, 3.10.0: `2.5NaN' is
                     ;; 2.5 and an atom, operator_expected, as swipl's)
                     (if (and (== tag 2) (or (< (-> r fval) 1.0) (>= (-> r fval) 2.0)))
                         (set tag 0))
                     (if (!= tag 0)
                         (block
                           (if (and (== tag 2) (== (-> r fval) 1.0))
                               (return (coco_fail r "numeric constant out of range")))
                           (set (-> r fval) (strtod (? (== tag 1) "inf" "nan") nil))
                           (coco_bump r) (coco_bump r) (coco_bump r)))
                     (set (-> r tok) COCO_TK_FLOAT))
            ;; the digits, in 64 bits and never past them (2.0.0: through
            ;; 1.15.0 `strtoll', which saturates at 2^63 - 1 and kept the
            ;; least integer's magnitude from being read)
            (let ((u64 v . 0) (int wide . 0) (const char * ds . #'($ (-> r text) s)))
              (for ((size_t i . 0)) (and (not wide) (!= (nth i ds) 0)) ((++ i))
                (set wide (coco_mag_digit (aof v) 10 (cast u64 (- (cast int (nth i ds)) (coco-ch "0"))))))
              (coco_mag_token r v wide))))
        (return 1))

  ;;; A code past ASCII of KIND onto the token's text, the reader moved
  ;;; past it: 1, or 0 where the code there is none of KIND (3.35.0)
  (weak) (cold)
  (func coco_lex_wide_step ((coco_reader * r) (int kind)) (out int)
        (let ((size_t w . #'(coco_rd_wide_at (-> r src) (-> r len) (-> r pos) kind)))
          (if (== w 0) (return 0))
          (coco_sb_put_len (aof (-> r text)) (+ (-> r src) (-> r pos)) w)
          (set (-> r pos) (+ (-> r pos) w))
          (return 1)))

  ;;; THE RUN AT THE READER'S POSITION onto the token's text (3.35.0): the
  ;;; ASCII codes TEST takes -- `coco_is_alnum' a name's (swipl's
  ;;; SkipAtomIdCont: a letter, a digit or `_'), `coco_is_symbol' a
  ;;; symbol's (SkipSymbol) -- and past ASCII those of KIND, 8 id_continue
  ;;; and 2 a symbol, a step out of line. A DEFMACRO, so each site's ASCII
  ;;; loop is the one 3.34.1 inlined: as one function asking KIND at each
  ;;; code, a run cost a start 400 000 instructions more.
  (DEFMACRO coco-lex-run (r test kind)
    `(while 1
       (let ((int b . #'(coco_peek ,r)))
         (cond
           ((,test b) (coco_sb_putc (aof (-> ,r text)) (cast char b)) (coco_bump ,r))
           ((< b 128) break)
           ((not (coco_lex_wide_step ,r ,kind)) break)))))

  ;;; A NUMBER IN ANOTHER SCRIPT'S DIGITS (3.35.0), as swipl's str_number()
  ;;; reads one: the digits of the block of the first, C0 less its weight
  ;;; its zero, wherever an ASCII number has digits -- the integer and its
  ;;; groups, a rational's denominator, a fraction, an exponent -- and
  ;;; never `0'c', a radix or `0x', which want an ASCII zero, nor 1.5NaN.
  ;;; The lexer's own over a copy with those digits made ASCII, to the
  ;;; first code that is neither one of them nor an ASCII character such a
  ;;; number holds (an ASCII digit is none: the block is the first's), as
  ;;; swipl's to_double() converts it; the reader is moved on by the bytes
  ;;; of the codes the copy's number took. `wnum' says so: a minus before
  ;;; it is no sign (`-١' is -(1)), as swipl's isDigit() asks an ASCII one.
  (static)
  (func coco_lex_wide_number ((coco_reader * r) (i64 c0)) (out int)
        (let ((i64 zero . #'(- c0 (cast i64 (bitand (>> (coco_ct_flags c0) 11) 15))))
              (coco_strbuf cp) (size_t p . #'(-> r pos)) (size_t from . #'(-> r pos))
              (coco_reader t) (int ok . 0))
          (coco_sb_init (aof cp))
          (while (< p (-> r len))
            (let ((size_t w . 0) (i64 c . #'(coco_cp_at (-> r src) (-> r len) p (aof w))))
              (cond
                ((and (>= c zero) (<= c (+ zero 9)))
                 (coco_sb_putc (aof cp) (cast char (+ 48 (- c zero)))))
                ((and (< c 128) (coco-ch-in (cast int c) "eErInf+-._ "))
                 (coco_sb_putc (aof cp) (cast char c)))
                ((and (< c 128) (coco_is_space (cast int c)))
                 (coco_sb_putc (aof cp) (cast char c)))
                (#t break))
              (set p (+ p w))))
          (if (== ($ cp s) nil) (return (coco_fail r "out of memory")))
          (coco_reader_init (aof t) (-> r m) ($ cp s))
          ;; the copy's offset K as the source's: one code a byte of it
          (let ((size_t k . #'(? ($ t failed) ($ t epos) ($ t pos))) (size_t q . from))
            (while (and (> k 0) (< q (-> r len)))
              (coco_utf8_get (-> r src) (-> r len) (aof q))
              (set k (- k 1)))
            (if ($ t failed)
                (block (set (-> r pos) q) (coco_fail r ($ t ewhat)) (set (-> r epos) q))
              (block
                (set (-> r pos) q)
                (set (-> r tok) ($ t tok))
                (set (-> r ival) ($ t ival)) (set (-> r iwide) ($ t iwide))
                (set (-> r fval) ($ t fval))
                (set (-> r rval_n) ($ t rval_n)) (set (-> r rval_d) ($ t rval_d))
                (coco_sb_put_len (aof (-> r text)) (+ (-> r src) from) (- q from))
                (set (-> r wnum) 1)
                (set ok 1))))
          (coco_reader_free (aof t))
          (coco_sb_free (aof cp))
          (return ok)))

  ;;; A TOKEN THAT BEGINS PAST ASCII (3.35.0), as pl-read.c's get_token()
  ;;; takes a code past U+00FF and its Latin-1 table one below it: one the
  ;;; reader refuses (a control character, a code no class names), a letter
  ;;; that begins a name -- a variable's when it is a capital, `Été' -- a
  ;;; symbol, a digit of another script, and anything else a name of one
  ;;; character, as `!' is. Out of line and cold, so that `coco_next_token'
  ;;; is the loop 3.34.1 was.
  (weak) (cold)
  (func coco_lex_wide_token ((coco_reader * r)) (out int)
        (let ((size_t w . 0) (i64 cp . #'(coco_cp_at (-> r src) (-> r len) (-> r pos) (aof w)))
              (u32 f . #'(coco_rd_flags cp)))
          (cond
            ((!= 0 (bitand f 64)) (return (coco_fail r "unexpected character")))
            ((!= 0 (bitand f 4))
             ;; the letter, whatever follows: a start continues itself
             (coco_sb_put_len (aof (-> r text)) (+ (-> r src) (-> r pos)) w)
             (set (-> r pos) (+ (-> r pos) w))
             (coco-lex-run r coco_is_alnum 8)
             (set (-> r tok) (? (!= 0 (bitand f 16)) COCO_TK_VAR COCO_TK_NAME))
             (return 1))
            ((!= 0 (bitand f 2))
             (coco-lex-run r coco_is_symbol 2)
             (set (-> r tok) COCO_TK_NAME)
             (return 1))
            ((!= 0 (bitand f 32)) (return (coco_lex_wide_number r cp)))
            (#t
             (coco_sb_put_len (aof (-> r text)) (+ (-> r src) (-> r pos)) w)
             (set (-> r pos) (+ (-> r pos) w))
             (set (-> r tok) COCO_TK_NAME)
             (return 1)))))

  ;;; One token into the reader. Everything the parser knows about the input is
  ;;; what this leaves behind: the kind, the text, whether layout preceded it,
  ;;; and where it begins.
  (static)
  (func coco_next_token ((coco_reader * r)) (out int)
        (set (-> r layout_before) (coco_skip_layout r 0))
        (set (-> r tstart) (-> r pos))
        ;; the text ended in a block comment: the token is that, placed at
        ;; the comment (3.10.0; through 3.9.0 the text ended there quietly)
        (if (!= (-> r ecomment) 0)
            (block (set (-> r tstart) (- (-> r ecomment) 1))
                   (set (-> r ecomment) 0)
                   (set (-> r tok) COCO_TK_EOF)
                   (return (coco_fail r "end of file in a block comment"))))
        (set (-> r quoted) 0)
        (set (-> r wnum) 0)
        (coco_sb_reset (aof (-> r text)))
        (let ((int c . #'(coco_peek r)))
          (cond
            ((== c -1) (set (-> r tok) COCO_TK_EOF) (return 1))

            ((coco_is_digit c) (return (coco_lex_number r)))

            ;; a name and a variable go on past ASCII (3.35.0): `aé', `Xα'
            ((coco_is_lower c)
             (coco-lex-run r coco_is_alnum 8)
             (set (-> r tok) COCO_TK_NAME)
             (return 1))

            ((coco_is_upper c)
             (coco-lex-run r coco_is_alnum 8)
             (set (-> r tok) COCO_TK_VAR)
             (return 1))

            ((== c (coco-ch "'"))
             (if (not (coco_lex_quoted r (coco-ch "'"))) (return 0))
             (set (-> r tok) COCO_TK_NAME)
             (set (-> r quoted) 1)
             (return 1))

            ;; 34 is the double quote, written as its code: a Cicili string is
            ;; raw, so "\"" holds a backslash AND a quote and `coco-ch' would
            ;; answer with the backslash.
            ((== c 34)
             (if (not (coco_lex_quoted r 34)) (return 0))
             (set (-> r tok) COCO_TK_STRING)
             (return 1))

            ;; 96, a backquote: `abc` is the codes of its text whatever
            ;; `double_quotes' says, swipl's default `back_quotes' (3.1.0),
            ;; and `quoted' 2 tells `coco_string_to_list' so
            ((== c 96)
             (if (not (coco_lex_quoted r 96)) (return 0))
             (set (-> r tok) COCO_TK_STRING)
             (set (-> r quoted) 2)
             (return 1))

            ;; the bracket family, plus the two solo characters that are
            ;; punctuation rather than atoms
            ((coco-ch-in c "()[]{},|")
             (coco_sb_putc (aof (-> r text)) (cast char c)) (coco_bump r)
             (set (-> r tok) COCO_TK_PUNCT)
             (return 1))

            ;; `!' and `;' are atoms that stand alone
            ((coco-ch-in c "!;")
             (coco_sb_putc (aof (-> r text)) (cast char c)) (coco_bump r)
             (set (-> r tok) COCO_TK_NAME)
             (return 1))

            ((coco_is_symbol c)
             (coco-lex-run r coco_is_symbol 2)
             ;; a lone `.' followed by layout or nothing ends the clause --
             ;; layout past ASCII too (3.35.0), as swipl's PlBlankW() asks
             (if (and (== ($ (-> r text) len) 1) (== (nth 0 ($ (-> r text) s)) (cast char 46)))
                 (let ((int nxt . #'(coco_peek r)))
                   (if (or (== nxt -1)
                           (or (coco_is_space nxt)
                               (or (== nxt (coco-ch "%"))
                                   (!= 0 (coco_rd_wide_at (-> r src) (-> r len) (-> r pos) 1)))))
                       (block (set (-> r tok) COCO_TK_END) (return 1)))))
             (set (-> r tok) COCO_TK_NAME)
             (return 1))

            ;; past ASCII (3.35.0): `coco_lex_wide_token'
            ((>= c 128) (return (coco_lex_wide_token r)))

            (#t (return (coco_fail r "unexpected character")))))
        (return 1))

  ;;; ---- positions, for read_term/3 (1.10.7) -----------------------------
  ;;; SWI's `subterm_positions', in characters from PBASE: From-To for an
  ;;; atom, a number or a variable; string_position(F, T) for "..." under
  ;;; any `double_quotes'; term_position(F, T, FF, FT, Args) for a compound,
  ;;; FF-FT where its name or its operator stands; list_position(F, T,
  ;;; Elements, Tail), Tail `none' when the list has none;
  ;;; brace_term_position(F, T, Arg); parentheses_term_position(F, T,
  ;;; Inner). test/files/read_term.pl holds them to SWI's.
  ;;; Only the `_p' family of the parser calls these.

  ;;; Byte offset B of SRC as a character offset from PBASE: a UTF-8
  ;;; character is one, whatever its bytes (a continuation byte, 10xxxxxx,
  ;;; is never the first).
  (static)
  (func coco_rchar ((coco_reader * r) (size_t b)) (out i64)
        (if (== (-> r cscan) 0)
            (block
              (set (-> r cscan) 1)
              (for ((size_t i . 0)) (< i (-> r len)) ((++ i))
                   (if (>= (cast int (cast uchar (nth i (-> r src)))) 128)
                       (let ((size_t * t . #'(cast (size_t *) (malloc (* (+ (-> r len) 1) (sizeof size_t)))))
                             (size_t c . 0))
                         (if (!= t nil)
                             (block
                               (for ((size_t j . 0)) (< j (-> r len)) ((++ j))
                                    (set (nth j t) c)
                                    (if (!= (bitand (cast int (cast uchar (nth j (-> r src)))) 192) 128)
                                        (set c (+ c 1))))
                               (set (nth (-> r len) t) c)
                               (set (-> r cidx) t)
                               (set (-> r cscan) 2)))
                         break)))))
        (if (== (-> r cscan) 2) (return (+ (-> r pbase) (cast i64 (nth b (-> r cidx))))))
        (return (+ (-> r pbase) (cast i64 b))))

  (static)
  (func coco_rint ((coco_reader * r) (size_t b)) (out size_t)
        (return (coco_new_int (-> r m) (coco_rchar r b))))

  ;;; The term just parsed spans F to T and is a leaf: From-To.
  (static)
  (func coco_pos_leaf ((coco_reader * r) (size_t f) (size_t t)) (out void)
        (set (-> r lfrom) f)
        (set (-> r lto) t)
        (set (-> r lpos) (coco_make2 (-> r m) "-" (coco_rint r f) (coco_rint r t))))

  ;;; The term just parsed spans F to T and is NAME(F, T, What): what a
  ;;; string, a pair of braces and a pair of brackets are. WHAT is the
  ;;; inner term's position, or none for a string.
  (static)
  (func coco_pos_wrap ((coco_reader * r) (const char * name) (size_t f) (size_t t)) (out void)
        (let ((size_t a . #'(coco_rint r f)) (size_t b . #'(coco_rint r t)))
          (if (== 0 (strcmp name "string_position"))
              (set (-> r lpos) (coco_make2 (-> r m) name a b))
            (let ((size_t xs [3]))
              (set (nth 0 xs) a)
              (set (nth 1 xs) b)
              (set (nth 2 xs) (-> r lpos))
              (set (-> r lpos) (coco_make (-> r m) name 3 xs)))))
        (set (-> r lfrom) f)
        (set (-> r lto) t))

  ;;; The N positions in PS as a list.
  (static)
  (func coco_pos_list ((coco_reader * r) (const size_t * ps) (size_t n)) (out size_t)
        (let ((size_t acc . #'(coco_new_nil (-> r m))))
          (while (> n 0)
            (set n (- n 1))
            (set acc (coco_cons (-> r m) (nth n ps) acc)))
          (return acc)))

  ;;; A compound from F to T whose name or operator is FF to FT, with the
  ;;; N argument positions in PS.
  (static)
  (func coco_pos_term ((coco_reader * r) (size_t f) (size_t t) (size_t ff) (size_t ft)
                       (const size_t * ps) (size_t n)) (out void)
        (let ((size_t xs [5]))
          (set (nth 4 xs) (coco_pos_list r ps n))
          (set (nth 0 xs) (coco_rint r f))
          (set (nth 1 xs) (coco_rint r t))
          (set (nth 2 xs) (coco_rint r ff))
          (set (nth 3 xs) (coco_rint r ft))
          (set (-> r lpos) (coco_make (-> r m) "term_position" 5 xs)))
        (set (-> r lfrom) f)
        (set (-> r lto) t))

  ;;; An operator from FF to FT applied to one operand (a prefix operator,
  ;;; whose position the term just parsed holds, F its own start) or to
  ;;; two (infix: LP the left operand's position, F its start).
  (static)
  (func coco_pos_prefix ((coco_reader * r) (size_t f) (size_t ff) (size_t ft)) (out void)
        (let ((size_t ps [1]))
          (set (nth 0 ps) (-> r lpos))
          (coco_pos_term r f (-> r lto) ff ft ps 1)))

  (static)
  (func coco_pos_infix ((coco_reader * r) (size_t lp) (size_t f) (size_t ff) (size_t ft)) (out void)
        (let ((size_t ps [2]))
          (set (nth 0 ps) lp)
          (set (nth 1 ps) (-> r lpos))
          (coco_pos_term r f (-> r lto) ff ft ps 2)))

  ;;; A list from F to T, its N elements' positions in PS, TP its tail's
  ;;; (`none' when it has none).
  (static)
  (func coco_pos_list_term ((coco_reader * r) (size_t f) (size_t t) (const size_t * ps) (size_t n)
                            (size_t tp)) (out void)
        (let ((size_t xs [4]))
          (set (nth 2 xs) (coco_pos_list r ps n))
          (set (nth 3 xs) tp)
          (set (nth 0 xs) (coco_rint r f))
          (set (nth 1 xs) (coco_rint r t))
          (set (-> r lpos) (coco_make (-> r m) "list_position" 4 xs)))
        (set (-> r lfrom) f)
        (set (-> r lto) t))

  ;;; ---- the parser -------------------------------------------------------
  ;;; Standard operator-precedence reading. The two mutually recursive halves
  ;;; are declared first, because `coco_parse_primary' has to call back into
  ;;; `coco_parse_term' for a bracketed subterm and for a prefix operator's
  ;;; argument.

  (static) (decl) (func coco_parse_term ((coco_reader * r) (int maxprec)
                                       (size_t * out) (int * outprec)) (out int))
  (static) (decl) (func coco_parse_primary ((coco_reader * r) (int maxprec)
                                          (size_t * out) (int * outprec)) (out int))
  (static) (decl) (func coco_parse_named ((coco_reader * r) (int maxprec)
                                        (const char * name) (int was_quoted)
                                        (size_t nf) (size_t nt)
                                        (size_t * out) (int * outprec)) (out int))
  (static) (decl) (func coco_parse_term_p ((coco_reader * r) (int maxprec)
                                       (size_t * out) (int * outprec)) (out int))
  (static) (decl) (func coco_parse_primary_p ((coco_reader * r) (int maxprec)
                                          (size_t * out) (int * outprec)) (out int))
  (static) (decl) (func coco_parse_named_p ((coco_reader * r) (int maxprec)
                                        (const char * name) (int was_quoted)
                                        (size_t nf) (size_t nt)
                                        (size_t * out) (int * outprec)) (out int))

  ;;; THE TOKEN IN HAND, COPIED, AT WHATEVER LENGTH IT IS.
  ;;;
  ;;; The parser cannot read a name straight out of `r->text': that buffer is
  ;;; reused by every token, and the name is still needed after the lookahead
  ;;; that decides what the token means. So it is copied -- and it used to be
  ;;; copied into a `char [256]' with `snprintf', which SILENTLY TRUNCATED
  ;;; every atom past 255 characters. Nothing complained: the atom table stores
  ;;; names by length and holds any of them, the reader's own buffer grows, and
  ;;; the cut happened between the two. A 408-character hex atom -- a Bitcoin
  ;;; transaction, which is a perfectly ordinary thing to hand a program --
  ;;; came back 255 characters long, and the only symptom was that a hex
  ;;; decoder downstream saw an odd number of digits and refused it.
  ;;;
  ;;; So: SMALL, of CAP bytes, takes the common case with no allocation at all,
  ;;; and anything longer goes to *HEAP, which grows to fit and which the caller
  ;;; frees ONCE at the end. Answers the pointer to use, or nil if the
  ;;; allocation failed.
  ;;;
  ;;; A reader that has read nothing but `''' has put no character in its
  ;;; buffer, which is then still unallocated: `term_to_atom(T, '''''')' copied
  ;;; the terminator from a nil pointer and ended the process (through
  ;;; 1.10.25; library(flow/debug) met it in an argument a call exited with).
  (static)
  (func coco_tok_name ((coco_reader * r) (char * small) (size_t cap)
                       (char ** heap) (size_t * hcap)) (out char *)
        (let ((size_t n . #'($ (-> r text) len)))
          (if (== ($ (-> r text) s) nil)
              (block (set (nth 0 small) (cast char 0)) (return small)))
          (if (< n cap)
              (block (memcpy small ($ (-> r text) s) (+ n 1)) (return small)))
          (if (<= (cof hcap) n)
              (let ((char * ns . #'(cast (char *) (realloc (cof heap) (+ n 1)))))
                (if (== ns nil) (return nil))
                (set (cof heap) ns)
                (set (cof hcap) (+ n 1))))
          (memcpy (cof heap) ($ (-> r text) s) (+ n 1))
          (return (cof heap))))

  ;;; The token in hand is this punctuation mark.
  (static)
  (func coco_is_punct ((coco_reader * r) (int c)) (out int)
        (return (? (and (== (-> r tok) COCO_TK_PUNCT)
                        (== (cast int (nth 0 ($ (-> r text) s))) c))
                   1 0)))

  ;;; ---- what swipl calls a failure (3.10.0) ------------------------------
  ;;;
  ;;; swipl's complex_term reads a bracket's term over a stack of operators
  ;;; and decides what a failure is from that stack and the token in hand;
  ;;; this reader is recursive, so the same decision is made where the
  ;;; failure comes back up to its bracket. Each is one call on a path that
  ;;; is already failing, kept out of line.

  ;;; The punctuation mark in hand, or 0 for any other token.
  (static)
  (func coco_tok_punct ((coco_reader * r)) (out int)
        (if (!= (-> r tok) COCO_TK_PUNCT) (return 0))
        (return (cast int (nth 0 ($ (-> r text) s)))))

  ;;; An operator whose operand failed, on the way up to the bracket: one
  ;;; more pending (swipl's side stack), its mark kept when it is a comma
  ;;; or a semicolon -- read only when it is the one pending
  ;;; (`coco_term_close').
  (weak) (cold)
  (func coco_op_failed ((coco_reader * r) (const char * name))
        (if (not (-> r eopen)) (return))
        (set (-> r eops) (+ (-> r eops) 1))
        (set (-> r eopc) (? (== 0 (strcmp name ",")) 44
                              (? (== 0 (strcmp name ";")) 59 0))))

  ;;; An operator that cannot take what is before it, at the token in hand:
  ;;; swipl places the clash at the end of the operator before it (AT). The
  ;;; first one a read meets is kept -- the innermost, which fails the read.
  (weak) (cold)
  (func coco_clash ((coco_reader * r) (size_t at))
        (if (-> r clash_set) (return))
        (set (-> r clash_set) 1)
        (set (-> r clash_at) at))

  ;;; A BRACKET'S TERM THAT FAILED (swipl's complex_term with STOPS, the
  ;;; marks that end it; CLOSER its own, 0 at the top, where the full stop
  ;;; ends it): a term wanted and not there is settled here. Nothing read
  ;;; at this level -- the operand that failed was the bracket's own -- is
  ;;; the token's fault: the end of the clause, a closing bracket that
  ;;; starts no term, or a comma or a bar where an operand stands.
  ;;; Something read -- operators pending -- and a token that ends this
  ;;; bracket's term is swipl's `exit' with operators left: punct(Op,
  ;;; Next) when the one left is a comma or a semicolon, else an
  ;;; unbalanced operator; the end of the clause inside a bracket is the
  ;;; end of the clause.
  (weak) (cold)
  (func coco_term_close ((coco_reader * r) (int closer) (const char * stops))
        (if (not (-> r eopen)) (return))
        (set (-> r eopen) 0)
        (let ((int p . #'(coco_tok_punct r))
              (int fin . #'(or (== (-> r tok) COCO_TK_END) (== (-> r tok) COCO_TK_EOF)))
              (int ends . 0))
          (cond
            (fin (set ends (== closer 0)))
            ((!= p 0) (set ends (!= (strchr stops p) nil))))
          (cond
            ((and (> (-> r eops) 0) ends)
             (if (and (== (-> r eops) 1) (!= (-> r eopc) 0))
                 (block (set (-> r esyn) "punct")
                        (set (-> r epn) (? fin 46 p)))
               (set (-> r esyn) "operator_balance")))
            (fin (set (-> r esyn) "end_of_clause"))
            ((or (== p 41) (or (== p 93) (== p 125))) (set (-> r esyn) "cannot_start_term"))
            ((or (== p 44) (== p 124)) (set (-> r esyn) "quoted_punctuation")))))

  ;;; A BRACKET THAT DID NOT CLOSE, at the token in hand (WHAT the reader's
  ;;; own words): a priority clash there, a comma or a bar after a list's
  ;;; tail (REST), a closing bracket of another kind, else an operator
  ;;; expected. 0, as `coco_fail' answers.
  (weak) (cold)
  (func coco_close_fail ((coco_reader * r) (const char * what) (int rest)) (out int)
        (let ((int p . #'(coco_tok_punct r)))
          (coco_fail r what)
          (cond
            ;; a clash breaks the term at its token, and nothing after it
            ;; takes that token: the bracket fails there
            ((-> r clash_set) (set (-> r esyn) "operator_clash"))
            ((and rest (or (== p 44) (== p 124))) (set (-> r esyn) "list_rest"))
            ((or (== p 41) (or (== p 93) (== p 125))) (set (-> r esyn) "cannot_start_term"))
            (#t (set (-> r esyn) "operator_expected")))
          (return 0)))

  (func coco_reader_junk ((coco_reader * r)) (out int)
        (return (coco_close_fail r "expected . ending a clause" 0)))

  (func coco_reader_close_top ((coco_reader * r))
        (coco_term_close r 0 ""))

  ;;; No failure decided and no clash seen. A reader is made with none, only
  ;;; a read that fails sets them, and a failed reader reads nothing until
  ;;; `coco_reader_resync' takes it past the clause, which calls this.
  (static)
  (func coco_reader_fresh ((coco_reader * r))
        (set (-> r esyn) nil)
        (set (-> r eopen) 0)
        (set (-> r clash_set) 0))

  ;;; INLINE, because both parser families call these three: with one caller
  ;;; each clang inlined them, with two it left them out of line, and the
  ;;; translator's consult ran 0.74 % more instructions (169.97 M against
  ;;; 168.72 M). Cicili's (inline) inlines at every call since it was split
  ;;; from (weak), which is what (inline) emitted through Cicili 1.0.1.
  ;;; A variable by name, within the clause being read. `_' is anonymous: every
  ;;; occurrence is a different variable and none of them is recorded, which is
  ;;; exactly what makes `foo(_, _)' mean two unrelated things.
  (static) (inline)
  (func coco_var_for ((coco_reader * r) (const char * name)) (out size_t)
        (if (== 0 (strcmp name "_")) (return (coco_new_var (-> r m))))
        (for ((size_t i . 0)) (< i (-> r nvars)) ((++ i))
          (if (== 0 (strcmp (nth i (-> r var_names)) name))
              (return (nth i (-> r var_cells)))))
        (if (>= (-> r nvars) (-> r var_cap))
            (let ((size_t ncap . #'(? (== (-> r var_cap) 0) 8 (* (-> r var_cap) 2)))
                  (char ** nn) (size_t * nc))
              (set nn (cast (char **) (realloc (-> r var_names) (* ncap (sizeof (char *))))))
              (if (== nn nil) (return (coco_new_var (-> r m))))
              (set (-> r var_names) nn)
              (set nc (cast (size_t *) (realloc (-> r var_cells) (* ncap (sizeof size_t)))))
              (if (== nc nil) (return (coco_new_var (-> r m))))
              (set (-> r var_cells) nc)
              (set (-> r var_cap) ncap)))
        (let ((size_t v . #'(coco_new_var (-> r m))))
          (set (nth (-> r nvars) (-> r var_names)) (strdup name))
          (set (nth (-> r nvars) (-> r var_cells)) v)
          (set (-> r nvars) (+ (-> r nvars) 1))
          (return v)))

  ;;; WHETHER A QUOTED NAME IS AN OPERATOR (3.15.1, swipl's): one that
  ;;; cannot be written without its quotes -- `'p\'q'', `'Ab'', `','',
  ;;; `'|'', and `'[]'', the atom apart from the list's end -- where `'-''
  ;;; and `'@@@'' are atoms whatever the table says.
  (static) (inline)
  (func coco_quoted_op ((const char * name)) (out int)
        (return (? (or (coco_atom_needs_quotes name) (== 0 (strcmp name "[]"))) 1 0)))

  ;;; Whether the token in hand could begin a term. A prefix operator only
  ;;; takes an argument if one follows: in `X = -' the `-' is an atom, and the
  ;;; only thing that says so is that `.' comes next.
  (static) (inline)
  (func coco_starts_term ((coco_reader * r)) (out int)
        (cond ((== (-> r tok) COCO_TK_INT)    (return 1))
              ((== (-> r tok) COCO_TK_FLOAT)  (return 1))
              ((== (-> r tok) COCO_TK_RAT)    (return 1))
              ((== (-> r tok) COCO_TK_VAR)    (return 1))
              ((== (-> r tok) COCO_TK_STRING) (return 1))
              ;; A NAME USUALLY STARTS A TERM, and an operator name usually
              ;; does too -- `- - a' is prefix `-' applied to `-a', because the
              ;; second `-' can begin one. But an operator that is ONLY infix
              ;; cannot: in `- = a' the `=' is not the start of anything, so
              ;; the `-' before it is an atom and `=' is the operator between
              ;; them. Without this the reader took `-' as a prefix operator
              ;; applied to the atom `=' and stopped, leaving `a' unread.
              ((== (-> r tok) COCO_TK_NAME)
               ;; ...unless it was QUOTED -- a quoted atom is not an operator,
               ;; by the same rule that makes `'-' - a' infix, save one that
               ;; cannot be written unquoted (3.15.1: `- 'x\'y' a' is
               ;; 'x\'y'(-, a), as `- = a') -- or the `(' is right up against
               ;; it, which makes it a functor whatever else it is:
               ;; `meta_predicate '>>'(?, 0)' begins with an operand.
               (if (and (-> r quoted) (not (coco_quoted_op ($ (-> r text) s))))
                   (return 1))
               (if (== (coco_peek r) (coco-ch "(")) (return 1))
               (let ((int p . 0) (int t . 0))
                 (if (and (coco_op_infix ($ (-> r text) s) (aof p) (aof t))
                          (not (coco_op_prefix ($ (-> r text) s) (aof p) (aof t))))
                     (return 0))
                 (return 1)))
              ((== (-> r tok) COCO_TK_PUNCT)
               (return (? (coco-ch-in (cast int (nth 0 ($ (-> r text) s))) "([{") 1 0)))
              (#t (return 0))))

  ;;; A double-quoted item is a list of character codes -- the ISO default, and
  ;;; the one that makes "abc" something a Prolog program can take apart.
  ;;; `"..."' AS A TERM, under whichever `double_quotes' is in force: 0 codes
  ;;; (the default, and what this Prolog has always done), 1 chars, 2 atom,
  ;;; 3 string. SWI's four values, all four honoured, because three of them
  ;;; are the same walk over the same bytes and refusing them would be a
  ;;; refusal to do arithmetic somebody has already done.
  (static) (inline)
  (func coco_string_to_list ((coco_reader * r) (size_t * out)) (out int)
        (let ((coco_machine * m . #'(-> r m))
              (size_t n . #'($ (-> r text) len))
              (int mode . 0))
          ;; a backquoted text is codes (3.1.0)
          (set mode (? (== (-> r quoted) 2) 0 (-> m double_quotes)))
          (if (== mode 3)
              (block (set (cof out) (coco_new_string m ($ (-> r text) s) n))
                     (return 1)))
          (if (== mode 2)
              (block (set (cof out)
                          (coco_new_atom m (? (== ($ (-> r text) s) nil) "" ($ (-> r text) s))))
                     (return 1)))
          ;; codes and chars ARE CHARACTERS under `text_units = characters'
          ;; (1.13.0): "dár" is [100,225,114], or [d,á,r]
          (if (-> m text_chars)
              (block (set (cof out) (coco_text_list m ($ (-> r text) s) n (? (== mode 1) 1 0)
                                                    (coco_new_nil m)))
                     (return 1)))
          (let ((size_t tail . #'(coco_new_nil m)))
            (while (> n 0)
              (set n (- n 1))
              (let ((size_t c . 0))
                (if (== mode 1)
                    (let ((char one [2]))
                      (set (nth 0 one) (nth n ($ (-> r text) s)))
                      (set (nth 1 one) (cast char 0))
                      (set c (coco_new_atom m one)))
                  (set c (coco_new_int m (cast i64 (cast uchar (nth n ($ (-> r text) s)))))))
                (set tail (coco_cons m c tail))))
            (set (cof out) tail))
          (return 1)))


  ;;; THE FUNCTOR AN APPLICATION READS (3.12.0): its name and its arity --
  ;;; a quoted `'[]'' the atom of those two characters, and `[]' the list's
  ;;; end only when the brackets made it (BNIL), as swipl 7 tells
  ;;; `'[]'(a)' from `[](a)'. Through 3.11.0 both were the list's end.
  (static) (inline)
  (func coco_parse_fid ((coco_reader * r) (const char * name) (int bnil) (u32 n)) (out u64)
        (if (and (not bnil) (and (== (nth 0 name) (cast char 91))
                                 (and (== (nth 1 name) (cast char 93)) (== (nth 2 name) (cast char 0)))))
            (return (coco_functor_id (-> r m) (coco_intern_tnil (-> r m)) n)))
        (return (coco_functor_id (-> r m) (coco_intern (-> r m) name) n)))

  ;;; THE TWO FAMILIES (the macros at the top of this file say why): the
  ;;; first is every consult's, the second, `_p', builds positions too.
  (static)
  (func coco_parse_list ((coco_reader * r) (size_t f) (size_t * out)) (out int)
        (coco-parse-list-body 0 coco_parse_term))
  (static)
  (func coco_parse_args ((coco_reader * r) (const char * name) (size_t nf) (size_t nt)
                         (size_t * out)) (out int)
        (coco-parse-args-body 0 coco_parse_term))
  (static)
  (func coco_parse_primary ((coco_reader * r) (int maxprec) (size_t * out) (int * outprec)) (out int)
        (coco-parse-primary-body 0 coco_parse_term coco_parse_list coco_parse_named))
  (static)
  (func coco_parse_named ((coco_reader * r) (int maxprec) (const char * name)
                          (int was_quoted) (size_t nf) (size_t nt)
                          (size_t * out) (int * outprec)) (out int)
        (coco-parse-named-body 0 coco_parse_term coco_parse_args))
  (static)
  (func coco_parse_term ((coco_reader * r) (int maxprec) (size_t * out) (int * outprec)) (out int)
        (coco-parse-term-body 0 coco_parse_term coco_parse_primary))

  (static)
  (func coco_parse_list_p ((coco_reader * r) (size_t f) (size_t * out)) (out int)
        (coco-parse-list-body 1 coco_parse_term_p))
  (static)
  (func coco_parse_args_p ((coco_reader * r) (const char * name) (size_t nf) (size_t nt)
                         (size_t * out)) (out int)
        (coco-parse-args-body 1 coco_parse_term_p))
  (static)
  (func coco_parse_primary_p ((coco_reader * r) (int maxprec) (size_t * out) (int * outprec)) (out int)
        (coco-parse-primary-body 1 coco_parse_term_p coco_parse_list_p coco_parse_named_p))
  (static)
  (func coco_parse_named_p ((coco_reader * r) (int maxprec) (const char * name)
                          (int was_quoted) (size_t nf) (size_t nt)
                          (size_t * out) (int * outprec)) (out int)
        (coco-parse-named-body 1 coco_parse_term_p coco_parse_args_p))
  (static)
  (func coco_parse_term_p ((coco_reader * r) (int maxprec) (size_t * out) (int * outprec)) (out int)
        (coco-parse-term-body 1 coco_parse_term_p coco_parse_primary_p))

  ;;; ---- the reader's own surface -----------------------------------------

  (func coco_reader_init ((coco_reader * r) (coco_machine * m) (const char * src))
        (memset r 0 (sizeof coco_reader))
        (set (-> r m) m)
        (set (-> r src) src)
        (set (-> r len) (strlen src))
        (coco_sb_init (aof (-> r text)))
        (coco_next_token r))

  (static)
  (func coco_reader_clear_vars ((coco_reader * r))
        (for ((size_t i . 0)) (< i (-> r nvars)) ((++ i))
          (free (nth i (-> r var_names))))
        (set (-> r nvars) 0))

  (func coco_reader_free ((coco_reader * r))
        (coco_reader_clear_vars r)
        (free (-> r var_names))
        (free (-> r var_cells))
        (free (-> r cidx))
        (coco_sb_free (aof (-> r text)))
        (memset r 0 (sizeof coco_reader)))

  (func coco_read_clause ((coco_reader * r) (size_t * out)) (out int)
        (coco_reader_clear_vars r)
        ;; the token in hand is this clause's first, or the one that would
        ;; not read where this clause begins
        (set (-> r cstart) (-> r tstart))
        ;; a clause read after one that failed part way starts with none
        (set (-> r stop) 0)
        (if (-> r failed) (return -1))
        (if (== (-> r tok) COCO_TK_EOF) (return 0))
        (let ((size_t t) (int p) (int ok . 0))
          ;; the family that builds positions, only when they were asked for
          (if (-> r want_pos)
              (set ok (coco_parse_term_p r 1200 (aof t) (aof p)))
            (set ok (coco_parse_term r 1200 (aof t) (aof p))))
          (if (not ok) (block (coco_term_close r 0 "") (return -1)))
          (if (!= (-> r tok) COCO_TK_END)
              (block (coco_reader_junk r) (return -1)))
          ;; THE CLAUSE IS READ WHOLE ONCE ITS FULL STOP IS (3.1.0): a token
          ;; after it that will not read is the NEXT clause's error, which
          ;; the next call answers -- through 3.0.4 it took this clause
          ;; with it (`p(1). "a\q".' lost `p(1)'), as swipl's does not
          (coco_next_token r)
          (set (cof out) t)
          (return 1)))

  ;;; One byte onto the raw text, when there is one, counted and kept as
  ;;; the last.
  (static)
  (func coco_raw_add ((coco_strbuf * raw) (size_t * nraw) (int * lastc) (int c))
        (if (!= raw nil) (coco_sb_putc raw (cast char c)))
        (set (cof nraw) (+ (cof nraw) 1))
        (set (cof lastc) c))

  ;;; A comment's bytes A to B as the raw text has them: a space a
  ;;; character (a byte, not CHARS), a newline kept.
  (static)
  (func coco_raw_blank ((const char * s) (size_t a) (size_t b) (coco_strbuf * raw)
                        (size_t * nraw) (int * lastc) (int chars))
        (for ((size_t i . a)) (< i b) ((++ i))
          (let ((int c . #'(bitand (cast int (nth i s)) 255)))
            (if (or (not chars) (!= (bitand c 192) 128))
                (coco_raw_add raw nraw lastc (? (== c 10) 10 32))))))

  ;;; A symbol past ASCII at S[P] onto the raw text (3.35.0): its byte
  ;;; count, or 0 where the code there is no symbol
  (weak) (cold)
  (func coco_raw_wide_symbol ((const char * s) (size_t n) (size_t p) (coco_strbuf * raw)
                              (size_t * nraw) (int * lastc)) (out size_t)
        (let ((size_t w . #'(coco_rd_wide_at s n p 2)))
          (for ((size_t k . 0)) (< k w) ((++ k))
            (coco_raw_add raw nraw lastc (bitand (cast int (nth (+ p k) s)) 255)))
          (return w)))

  ;;; THE RUN OF SYMBOLS at S[P] onto the raw text, P moved past it
  ;;; (3.35.0): ASCII's inline, as 3.34.1 had it, and past ASCII a step out
  ;;; of line -- a DEFMACRO, as `coco-lex-run' is
  (DEFMACRO coco-raw-symbols (s n p raw nraw lastc)
    `(while (< ,p ,n)
       (let ((int sb . #'(bitand (cast int (nth ,p ,s)) 255)))
         (cond
           ((coco_is_symbol sb) (coco_raw_add ,raw ,nraw ,lastc sb) (set ,p (+ ,p 1)))
           ((< sb 128) break)
           (#t (let ((size_t sw . #'(coco_raw_wide_symbol ,s ,n ,p ,raw ,nraw ,lastc)))
                 (if (== sw 0) break)
                 (set ,p (+ ,p sw))))))))

  ;;; A CODE PAST ASCII at S[P] in the raw walk (3.35.0): a run of symbols;
  ;;; swipl's layout, its bytes kept where ANY says a token was read; or
  ;;; another code, its bytes. *TOK says whether a token began there; the
  ;;; answer is the position after it. Out of line and cold, so the walk's
  ;;; ASCII path is 3.34.1's but for one test.
  (weak) (cold)
  (func coco_raw_wide ((const char * s) (size_t n) (size_t p) (coco_strbuf * raw)
                       (size_t * nraw) (int * lastc) (int any) (int * tok)) (out size_t)
        (let ((size_t w . 0) (u32 f . #'(coco_rd_flags (coco_cp_at s n p (aof w)))))
          (if (!= 0 (bitand f 2))
              (block (set (cof tok) 1)
                     (coco-raw-symbols s n p raw nraw lastc)
                     (return p)))
          (set (cof tok) (== 0 (bitand f 1)))
          (if (or (cof tok) any)
              (for ((size_t k . 0)) (< k w) ((++ k))
                (coco_raw_add raw nraw lastc (bitand (cast int (nth (+ p k) s)) 255))))
          (return (+ p w))))

  (func coco_raw_walk ((const char * s) (size_t n) (size_t from) (coco_strbuf * raw)
                       (int chars) (int * kind) (int * q) (size_t * at0)) (out size_t)
        (let ((size_t p . from) (int any . 0) (size_t nraw . 0) (int lastc . 32))
          (set (cof kind) 2) (set (cof q) 0) (set (cof at0) n)
          (if (> p n) (set p n))
          (while (< p n)
            (let ((int c . #'(bitand (cast int (nth p s)) 255)))
              (cond
                ;; a block comment, a space a character once something is read
                ((and (== c 47) (and (< (+ p 1) n) (== (nth (+ p 1) s) (cast char 42))))
                 (let ((size_t e . #'(+ p 2)))
                   (while (and (< e n)
                               (not (and (== (nth e s) (cast char 42))
                                         (and (< (+ e 1) n) (== (nth (+ e 1) s) (cast char 47))))))
                     (set e (+ e 1)))
                   (if (>= e n)
                       (block (set (cof kind) 4) (return n)))
                   (if any (coco_raw_blank s p (+ e 2) raw (aof nraw) (aof lastc) chars))
                   (set p (+ e 2))))
                ;; a line comment, to its newline
                ((== c 37)
                 (let ((size_t e . p))
                   (while (and (< e n) (!= (nth e s) (cast char 10))) (set e (+ e 1)))
                   (if any (coco_raw_blank s p e raw (aof nraw) (aof lastc) chars))
                   (set p e)))
                ;; layout, kept once something is read
                ((coco_is_space c)
                 (if any (coco_raw_add raw (aof nraw) (aof lastc) c))
                 (set p (+ p 1)))
                ;; past ASCII (3.35.0): `coco_raw_wide', out of line. Here,
                ;; after the ASCII arms, it costs the walk 9 % (a letter is
                ;; tested against `/', `%' and the spaces in turn, where
                ;; 3.34.1's one compare sent a byte past `/' to the token's
                ;; arm); asked first it cost 26 %, and as a flag set by one
                ;; range test 16 % (instructions, reading 28 368 lines)
                ((>= c 128)
                 (let ((int tk . 0) (size_t p0 . p))
                   (set p (coco_raw_wide s n p raw (aof nraw) (aof lastc) any (aof tk)))
                   (if (and tk (not any)) (block (set any 1) (set (cof at0) p0)))))
                (#t
                 (if (not any) (block (set any 1) (set (cof at0) p)))
                 (cond
                   ;; a full stop, or a `.' that begins a run of symbols
                   ((== c 46)
                    (coco_raw_add raw (aof nraw) (aof lastc) c)
                    (set p (+ p 1))
                    (if (or (>= p n) (or (coco_is_space (bitand (cast int (nth p s)) 255))
                                         (or (== (nth p s) (cast char 37))
                                             (and (>= (bitand (cast int (nth p s)) 255) 128)
                                                  (!= 0 (coco_rd_wide_at s n p 1))))))
                        (block
                          (if (== nraw 1) (block (set (cof kind) 6) (return p)))
                          (coco_raw_add raw (aof nraw) (aof lastc) 32)
                          (set (cof kind) 0)
                          (return p)))
                    (coco-raw-symbols s n p raw (aof nraw) (aof lastc)))
                   ;; a run of symbol characters is one token, whatever it
                   ;; holds -- symbols past ASCII among them (3.35.0)
                   ((coco_is_symbol c)
                    (coco-raw-symbols s n p raw (aof nraw) (aof lastc)))
                   ((or (== c 39) (or (== c 34) (== c 96)))
                    (let ((int quoted . 1))
                      ;; 0'c and R'DIGIT after one or two digits that begin a
                      ;; number: no quoted item
                      (if (and (== c 39) (and (> p (cof at0)) (coco_is_digit (bitand (cast int (nth (- p 1) s)) 255))))
                          (let ((size_t bs . #'(- p 1)) (int base . 0) (i64 pc . 32))
                            (if (and (> bs (cof at0)) (coco_is_digit (bitand (cast int (nth (- bs 1) s)) 255)))
                                (set bs (- bs 1)))
                            ;; the character before the digits continues no
                            ;; name -- a code past ASCII asked as one
                            ;; (3.35.0), as swipl's PlIdContW(prev_code())
                            (if (> bs (cof at0)) (set pc (coco_cp_before s n (cof at0) bs)))
                            (if (not (coco_rd_is pc 8))
                                (block
                                  (for ((size_t i . bs)) (< i p) ((++ i))
                                    (set base (+ (* base 10) (- (cast int (nth i s)) 48))))
                                  (cond
                                    ((== base 0)
                                     (set quoted 0)
                                     (coco_raw_add raw (aof nraw) (aof lastc) c)
                                     (set p (+ p 1))
                                     (if (>= p n) (block (set (cof kind) 5) (return n)))
                                     (let ((int c1 . #'(bitand (cast int (nth p s)) 255)))
                                       (coco_raw_add raw (aof nraw) (aof lastc) c1)
                                       (set p (+ p 1))
                                       (cond
                                         ((and (== c1 92) (< p n))
                                          (coco_raw_add raw (aof nraw) (aof lastc) (bitand (cast int (nth p s)) 255))
                                          (set p (+ p 1)))
                                         ((and (== c1 39) (and (< p n) (== (nth p s) (cast char 39))))
                                          (coco_raw_add raw (aof nraw) (aof lastc) 39)
                                          (set p (+ p 1))))))
                                    ((<= base 36)
                                     (if (>= (+ p 1) n) (block (set (cof kind) 5) (return n)))
                                     (let ((int d . #'(bitand (cast int (nth (+ p 1) s)) 255))
                                           (int v . -1))
                                       (cond ((coco_is_digit d) (set v (- d 48)))
                                             ((coco-ch-between d "a" "z") (set v (+ 10 (- d 97))))
                                             ((coco-ch-between d "A" "Z") (set v (+ 10 (- d 65)))))
                                       (if (and (>= v 0) (< v base))
                                           (block (set quoted 0)
                                                  (coco_raw_add raw (aof nraw) (aof lastc) c)
                                                  (coco_raw_add raw (aof nraw) (aof lastc) d)
                                                  (set p (+ p 2)))))))))))
                      ;; A QUOTED ITEM, as pl-read.c's raw_read_quoted walks it
                      (if quoted
                          (let ((int qq . c) (int closed . 0))
                            (coco_raw_add raw (aof nraw) (aof lastc) qq)
                            (set p (+ p 1))
                            (while (not closed)
                              (if (>= p n) (block (set (cof kind) 3) (set (cof q) qq) (return n)))
                              (let ((int d . #'(bitand (cast int (nth p s)) 255)))
                                (coco_raw_add raw (aof nraw) (aof lastc) d)
                                (set p (+ p 1))
                                (cond
                                  ((== d qq) (set closed 1))
                                  ((== d 92)
                                   (if (>= p n) (block (set (cof kind) 3) (set (cof q) qq) (return n)))
                                   (let ((int e . #'(bitand (cast int (nth p s)) 255)))
                                     (coco_raw_add raw (aof nraw) (aof lastc) e)
                                     (set p (+ p 1))
                                     (cond
                                       ;; \xHEX and \OCTAL take the character after
                                       ;; their digits, a quote there closing the item
                                       ;; and a backslash there no escape: `'\x41\''
                                       ;; is closed. Any other escape is its letter,
                                       ;; taken as any character is (\c's layout and
                                       ;; a backslash's newline close nothing either)
                                       ((or (== e 120) (coco-ch-between e "0" "7"))
                                        (if (== e 120)
                                            (while (and (< p n) (>= (coco_hex_digit (bitand (cast int (nth p s)) 255)) 0))
                                              (coco_raw_add raw (aof nraw) (aof lastc) (bitand (cast int (nth p s)) 255))
                                              (set p (+ p 1)))
                                          (while (and (< p n) (coco-ch-between (bitand (cast int (nth p s)) 255) "0" "7"))
                                            (coco_raw_add raw (aof nraw) (aof lastc) (bitand (cast int (nth p s)) 255))
                                            (set p (+ p 1))))
                                        (if (>= p n) (block (set (cof kind) 3) (set (cof q) qq) (return n)))
                                        (let ((int f . #'(bitand (cast int (nth p s)) 255)))
                                          (coco_raw_add raw (aof nraw) (aof lastc) f)
                                          (set p (+ p 1))
                                          (if (== f qq) (set closed 1))))))))))))))
                   (#t
                    (coco_raw_add raw (aof nraw) (aof lastc) c)
                    (set p (+ p 1))))))))
          ;; layout and comments alone: nothing to read (3.11.0, the stream
          ;; module's question at a stream's end; the load and the text
          ;; readers have asked the reader first, which saw the end)
          (if (not any) (return n))
          ;; the end of the text: swipl puts its full stop there
          (if (not (coco_is_space lastc)) (coco_raw_add raw (aof nraw) (aof lastc) 32))
          (coco_raw_add raw (aof nraw) (aof lastc) 46)
          (coco_raw_add raw (aof nraw) (aof lastc) 32)
          (set (cof kind) 1)
          (return n)))

  ;;; A SYNTAX ERROR SKIPS ITS CLAUSE (3.1.0), as swipl's does: swipl reads
  ;;; a clause's text whole, up to its full stop, before it parses it, so a
  ;;; clause that will not parse is passed over and the load goes on. Here
  ;;; the walk starts where the clause began (`cstart', its first token's
  ;;; first byte), not where the reader failed -- inside a quoted atom with
  ;;; a bad escape the failing byte is in the quotes, and a walk from there
  ;;; would take the closing quote for an opening one -- and is swipl's raw
  ;;; read since 3.10.0 (`coco_raw_walk'): through 3.9.0 an octal or a hex
  ;;; escape's closing backslash took the quote after it for an escaped one
  ;;; (`z('\101\').' ran on to the end of the text, and the clauses after
  ;;; it were lost), and a radix's quote (`16'ff') opened a quoted atom. A
  ;;; quote or a block comment that never closes runs to the end.
  (func coco_reader_resync ((coco_reader * r)) (out int)
        (let ((int kind . 0) (int q . 0) (size_t at0 . 0) (size_t p . 0))
          (set p (coco_raw_walk (-> r src) (-> r len) (-> r cstart) nil 0
                                (aof kind) (aof q) (aof at0)))
          (coco_reader_clear_vars r)
          (set (-> r pos) p)
          (set (-> r failed) 0)
          (set (nth 0 (-> r err)) (cast char 0))
          (set (-> r ewhat) nil)
          (coco_reader_fresh r)
          (return (coco_next_token r))))

  (func coco_read_goal ((coco_reader * r) (size_t * out)) (out int)
        (coco_reader_clear_vars r)
        (set (-> r stop) 0)
        (if (-> r failed) (return 0))
        (if (== (-> r tok) COCO_TK_EOF) (return 0))
        (let ((size_t t) (int p))
          (if (not (coco_parse_term r 1200 (aof t) (aof p))) (return 0))
          (set (cof out) t)
          (return 1)))

  (func coco_read_term_from ((coco_machine * m) (const char * src) (size_t * out)) (out int)
        (let ((coco_reader r) (int rc))
          (coco_reader_init (aof r) m src)
          (if ($ r failed) (block (coco_reader_free (aof r)) (return 0)))
          (if (== ($ r tok) COCO_TK_EOF) (block (coco_reader_free (aof r)) (return 0)))
          (let ((size_t t) (int p))
            (set rc (coco_parse_term (aof r) 1200 (aof t) (aof p)))
            (if rc (set (cof out) t)))
          (coco_reader_free (aof r))
          (return rc)))

  ;;; A NUMBER AND NOTHING ELSE (2.5.0), for number_codes/2 and its kin.
  ;;; A sign is written against the digits, and the number must end the
  ;;; text -- a trailing space, a newline or a `.` is SWI's illegal_number,
  ;;; which the callers raise. Layout before it is allowed unless STRICT
  ;;; (3.0.0, swipl 9.0.4's): number_codes(N, " 12") is 12 and
  ;;; atom_number(' 12', N) and number_string(N, " 12") fail. Through
  ;;; 2.16.1 the sign was asked for no layout before IT, so "- 12" read
  ;;; as -12 and " -12" as no number. STRICT is a sum: 1 the layout's
  ;;; refusal, 2 (3.1.0, name/2's) an answer of 2 for an integer past 64
  ;;; bits, which is a number swipl makes and this cannot -- 0 to any
  ;;; caller that does not ask, as through 3.0.0. A character code with an
  ;;; escape, `0'\n', is no number to any of them (3.1.0, swipl's: its
  ;;; number readers take `0'a' and refuse the escape the reader reads).
  (func coco_read_number_text ((coco_machine * m) (const char * src) (int strict) (size_t * out)) (out int)
        (let ((const char * p . src))
          (while (and (!= (nth 0 p) 0) (coco_is_space (cast int (cast uchar (nth 0 p))))) (set p (+ p 1)))
          (if (or (== (nth 0 p) (cast char 43)) (== (nth 0 p) (cast char 45))) (set p (+ p 1)))
          (if (and (== (nth 0 p) (cast char 48)) (== (nth 1 p) (cast char 39)) (== (nth 2 p) (cast char 92)))
              (return 0)))
        (let ((coco_reader r) (int ok . 0) (int neg . 0))
          (coco_reader_init (aof r) m src)
          (if ($ r failed) (block (coco_reader_free (aof r)) (return 0)))
          (if (and (bitand strict 1) ($ r layout_before))
              (block (coco_reader_free (aof r)) (return 0)))
          (if (== ($ r tok) COCO_TK_NAME)
              (let ((const char * nm . #'($ r text s)))
                (if (or (== 0 (strcmp nm "+")) (== 0 (strcmp nm "-")))
                    (block
                      (set neg (? (== (nth 0 nm) (coco-ch "-")) 1 0))
                      (if (not (coco_next_token (aof r)))
                          (block (coco_reader_free (aof r)) (return 0)))
                      ;; the digits against the sign
                      (if ($ r layout_before)
                          (block (coco_reader_free (aof r)) (return 0))))
                  (block (coco_reader_free (aof r)) (return 0)))))
          (if (and (!= ($ r tok) COCO_TK_INT)
                   (and (!= ($ r tok) COCO_TK_FLOAT) (!= ($ r tok) COCO_TK_RAT)))
              (block (coco_reader_free (aof r)) (return 0)))
          ;; nothing follows the number, not even layout
          (if (!= ($ r pos) (strlen src))
              (block (coco_reader_free (aof r)) (return 0)))
          (cond
            ((== ($ r tok) COCO_TK_INT)
             ;; iwide 1 is 2^63, which only the negative literal reaches
             (if (> ($ r iwide) (? neg 1 0))
                 (block (coco_reader_free (aof r)) (return (? (bitand strict 2) 2 0))))
             (if (and neg (== ($ r iwide) 1))
                 (set (cof out) (coco_new_int m (- -9223372036854775807 1)))
               (set (cof out) (coco_new_int m (? neg (- 0 ($ r ival)) ($ r ival)))))
             (set ok 1))
            ((== ($ r tok) COCO_TK_FLOAT)
             ;; -0.0 KEEPS ITS SIGN, and a NaN its bits, as the reader's
             ;; own sign does (2.2.2): `0 - X' is +0.0 when X is 0.0,
             ;; and `-NaN' flips the sign bit SWI keeps
             (set (cof out) (coco_new_float m
                              (? neg
                                 (? (!= ($ r fval) ($ r fval)) ($ r fval) (- ($ r fval)))
                                 ($ r fval))))
             (set ok 1))
            (#t
             (set (cof out) (coco_new_rat m (cast i64 (? neg (- 0 ($ r rval_n)) ($ r rval_n)))
                                          (cast i64 ($ r rval_d))))
             (if (!= (cof out) (cast size_t -1)) (set ok 1))))
          (coco_reader_free (aof r))
          (return ok)))

  ;;; ---- the writer -------------------------------------------------------

  ;;; Whether NAME, which holds a code past ASCII, needs quotes (3.35.0):
  ;;; pl-write.c's atomType() for an atom of codes up to U+00FF, its
  ;;; unquoted_atomW() for any other; `coco_atom_needs_quotes' says more.
  ;;; The first code's flags, whether each after it continues a name
  ;;; (`coco_rd_flags' 8), whether every one is a symbol (2), the count.
  (static)
  (func coco_wide_needs_quotes ((const char * name)) (out int)
        (let ((size_t n . #'(strlen name)) (size_t i . 0) (size_t cnt . 0)
              (u32 f0 . 0) (int wide . 0) (int cont . 1) (int sym . 1))
          (while (< i n)
            (let ((i64 c . #'(coco_utf8_get name n (aof i))) (u32 f . #'(coco_rd_flags c)))
              (if (> c 255) (set wide 1))
              (if (== cnt 0) (set f0 f) (if (== 0 (bitand f 8)) (set cont 0)))
              (if (== 0 (bitand f 2)) (set sym 0))
              (set cnt (+ cnt 1))))
          (if wide
              ;; a name's start -- a letter and no capital -- and what
              ;; continues one after it; or symbols, the first among them
              (return (? (and (!= 0 (bitand f0 4)) (== 0 (bitand f0 16))) (not cont) (not sym))))
          ;; the Latin-1 table: a small letter (LC), letters and digits after
          ;; it; a symbol (SY) and symbols, none begun by `/*'; one solo
          ;; character (SO: no class)
          (if (and (!= 0 (bitand f0 4)) (== 0 (bitand f0 16))) (return (not cont)))
          (if (!= 0 (bitand f0 2))
              (return (or (not sym) (and (== (cast int (nth 0 name)) (coco-ch "/"))
                                         (== (cast int (nth 1 name)) (coco-ch "*"))))))
          (return (not (and (== cnt 1) (== 0 (bitand f0 127)))))))

  ;;; An atom needs no quotes when it is a lower-case alphanumeric word, a run
  ;;; of symbol characters, or one of the four names that stand alone. `,' is
  ;;; not among them: written bare it would be read as an argument separator.
  ;;; Nor are two runs of symbol characters, which would not read back as
  ;;; themselves: `.' alone ends a clause, and a run that begins `/*' begins
  ;;; a comment (coco_skip_layout) -- SWI quotes both.
  ;;;
  ;;; A NAME PAST ASCII IS ASKED AS swipl's IS (3.35.0; through 3.34.1
  ;;; every one was quoted, `'é''): one of codes up to U+00FF by its Latin-1
  ;;; table (atomType()) -- a small letter and letters or digits after it
  ;;; (`é', `aª'), symbols (`¬¡'), one solo character (`²') -- and any other
  ;;; by unquoted_atomW(): a name's start, which no capital is, and a name's
  ;;; continuation after it (`αβ', `éα'), or symbols alone (`∀', `+∀'),
  ;;; where swipl makes no exception of `/*'. The classes are
  ;;; `coco_rd_flags''s, the reader's own, so what this leaves bare reads
  ;;; back as itself. ONE PASS: an ASCII name is decided as through 3.34.1,
  ;;; and the first byte past ASCII hands the whole name to
  ;;; `coco_wide_needs_quotes' -- an ASCII byte that breaks a word or a run
  ;;; of symbols before one breaks it in either table, but the `/*' that
  ;;; quotes an ASCII run quotes none past U+00FF, so it is asked last.
  (func coco_atom_needs_quotes ((const char * name)) (out int)
        (if (== (nth 0 name) (cast char 0)) (return 1))
        (if (or (== 0 (strcmp name "[]")) (or (== 0 (strcmp name "{}"))
                (or (== 0 (strcmp name "!")) (== 0 (strcmp name ";")))))
            (return 0))
        (let ((int c0 . #'(cast int (cast uchar (nth 0 name)))))
          (if (>= c0 128) (return (coco_wide_needs_quotes name)))
          (if (coco_is_lower c0)
              (block (for ((size_t i . 1)) (!= (nth i name) (cast char 0)) ((++ i))
                       (let ((int c . #'(cast int (cast uchar (nth i name)))))
                         (if (not (coco_is_alnum c))
                             (return (? (>= c 128) (coco_wide_needs_quotes name) 1)))))
                     (return 0)))
          (if (coco_is_symbol c0)
              (block (for ((size_t i . 1)) (!= (nth i name) (cast char 0)) ((++ i))
                       (let ((int c . #'(cast int (cast uchar (nth i name)))))
                         (if (not (coco_is_symbol c))
                             (return (? (>= c 128) (coco_wide_needs_quotes name) 1)))))
                     (return (or (== 0 (strcmp name "."))
                                 (and (== c0 (coco-ch "/"))
                                      (== (cast int (nth 1 name)) (coco-ch "*")))))))
          (return 1)))

  ;;; A CONTROL CHARACTER THE READER HAS A LETTER FOR, under swipl's
  ;;; character escapes (2.2.5): 7 `\a', 8 `\b', 11 `\v', 12 `\f' and, for a
  ;;; string, 13 `\r' -- the letter, or 0. The others are written by their
  ;;; code, `\x1\' or `\u0001' (`coco_write_escape', 3.1.0).
  (static) (inline)
  (func coco_escape_letter ((int c)) (out int)
        (cond ((== c 7) (return (coco-ch "a")))
              ((== c 8) (return (coco-ch "b")))
              ((== c 11) (return (coco-ch "v")))
              ((== c 12) (return (coco-ch "f")))
              ((== c 13) (return (coco-ch "r")))
              (#t (return 0))))

  ;;; WHETHER A QUOTED WRITE ESCAPES CODE CP (3.1.0, swipl's): a control
  ;;; character with no letter (`coco_escape_letter' and the three the
  ;;; writers spell themselves are the ones with), DEL, and past ASCII
  ;;; what pl-write.c's unicode_quoted_escape() escapes (3.35.0,
  ;;; `coco_rd_flags' 128): a C1 control, a separator (U+00A0, U+2028), a
  ;;; format character (U+00AD, U+200B), a code no class names and a
  ;;; surrogate -- U+DC80..U+DCFF among them, a byte that was no UTF-8.
  ;;; Through 3.34.1 the controls and the surrogates alone, and U+00A0 was
  ;;; written as it is, where swipl writes `\xA0\' to a stream that can
  ;;; hold any character, as with_output_to/2's can.
  (static) (inline)
  (func coco_write_escaped ((i64 cp)) (out int)
        (if (>= cp 128) (return (!= 0 (bitand (coco_rd_flags cp) 128))))
        (return (or (and (< cp 32) (!= cp 9) (!= cp 10) (!= cp 13) (== 0 (coco_escape_letter (cast int cp))))
                    (== cp 127))))

  ;;; CP as swipl's quoted write escapes it: writeq/1's `\x1\' and `\xD800\',
  ;;; or, UNI (print/1's and write_term/2's, swipl's
  ;;; character_escapes_unicode), `\u0001' and `\U0001F600'. The closing
  ;;; backslash of the first is a character of its own (92): a Cicili string
  ;;; may not end in one. A code is at most U+10FFFF, an int.
  (static)
  (func coco_write_escape ((coco_strbuf * b) (i64 cp) (int uni)) (out int)
        (let ((char t [16]))
          (cond ((not uni) (snprintf t 16 "\\x%X" (cast int cp)))
                ((<= cp 65535) (snprintf t 16 "\\u%04X" (cast int cp)))
                (#t (snprintf t 16 "\\U%08X" (cast int cp))))
          (if (not (coco_sb_put b t)) (return 0))
          (if (not uni) (return (coco_sb_putc b (cast char 92))))
          (return 1)))

  ;;; WHETHER NAME HOLDS A CHARACTER PAST U+00FF (3.55.0): write_term/2's
  ;;; quote_non_ascii(true) quotes such an atom, as swipl's quotes every
  ;;; atom it holds as wide text (unquoted_atomW() under
  ;;; PL_WRT_QUOTE_NON_ASCII: `'αβ'', `'∀'(x)', `a'≈'b') and none it holds
  ;;; as Latin-1 (atomType(): `é', `¬a', `f(ÿ)'). Such a character's first
  ;;; byte in UTF-8 is 0xC4 or more; a byte that is no UTF-8 is quoted
  ;;; anyway, by `coco_wide_needs_quotes'.
  (static) (inline)
  (func coco_atom_past_latin1 ((const char * name)) (out int)
        (for ((size_t i . 0)) (!= (nth i name) (cast char 0)) ((++ i))
          (if (>= (cast int (cast uchar (nth i name))) 196) (return 1)))
        (return 0))

  ;;; QUOTED is the write's mode word, of which this reads quoted (1) and
  ;;; swipl's character escapes (16, 2.2.5): with them a quote inside is
  ;;; `\'' and a control character with a letter is the letter
  ;;; (`coco_escape_letter') -- writeq/1's `'don\'t'' -- one with none its
  ;;; code (`coco_write_escaped', in the form 64 asks for: 3.1.0); and
  ;;; without, the quote is doubled, `'don''t'', as term_to_atom/2 writes it
  ;;; in swipl too and as the store, a channel and a message always have.
  ;;; And 256 (3.15.1) writes a newline, a tab and a return as they are,
  ;;; as term_to_atom/2 and term_string/2 write them in swipl -- 256
  ;;; without 16 is swipl's PL_WRT_QUOTED alone, write_term/2's
  ;;; character_escapes(false) too since 3.55.0: every character as it is
  ;;; but the quote, doubled, and the backslash, `\\'. And 32768
  ;;; (quote_non_ascii(true), 3.55.0) quotes a name past U+00FF.
  (static)
  (func coco_write_atom ((coco_strbuf * b) (const char * name) (int quoted)) (out int)
        ;; 32 is the functor's force: `{}` and `[]` stand alone unquoted,
        ;; but as a FUNCTOR they must be `'{}'(X)` and `'[]'(X)`, or the
        ;; reader takes the brace for the construct and stops. A snapshot
        ;; of SWI's yall library found it (2.6.0).
        (if (or (== 0 (bitand quoted 1))
                (and (== 0 (bitand quoted 32))
                     (and (not (coco_atom_needs_quotes name))
                          (or (== 0 (bitand quoted 32768)) (not (coco_atom_past_latin1 name))))))
            (return (coco_sb_put b name)))
        (if (not (coco_sb_putc b (cast char (coco-ch "'")))) (return 0))
        (let ((int esc . #'(bitand quoted 16)) (int uni . #'(bitand quoted 64)) (size_t n . 0))
          (for ((size_t i . 0)) (!= (nth i name) (cast char 0)) ((++ i))
            (let ((int c . #'(cast int (cast uchar (nth i name)))))
              (cond
                ((== c 39)
                 (if esc
                     (block (coco_sb_putc b (cast char 92)) (coco_sb_putc b (cast char 39)))
                   (coco_sb_put b "''")))
                ;; a backslash is written doubled, and has to be written as two
                ;; characters: the literal that would say so cannot be spelt
                ((== c 92) (coco_sb_putc b (cast char 92)) (coco_sb_putc b (cast char 92)))
                ;; 256 writes them as they are (3.15.1): term_to_atom/2 and
                ;; term_string/2's text, as swipl's PL_WRT_QUOTED alone
                ((and (!= 0 (bitand quoted 256)) (or (== c 10) (== c 9) (== c 13)))
                 (coco_sb_putc b (cast char c)))
                ((== c 10) (coco_sb_put b "\\n"))
                ((== c 9)  (coco_sb_put b "\\t"))
                ((== c 13) (coco_sb_put b "\\r"))
                ((and esc (!= 0 (coco_escape_letter c)))
                 (coco_sb_putc b (cast char 92))
                 (coco_sb_putc b (cast char (coco_escape_letter c))))
                ((and esc (< c 128) (coco_write_escaped c)) (coco_write_escape b c uni))
                ;; past ASCII a character, of however many bytes, is asked
                ;; whether it is one to escape, and copied whole when not
                ((and esc (>= c 128))
                 (block
                   (if (== n 0) (set n (strlen name)))
                   (let ((size_t j . i) (i64 cp . #'(coco_utf8_get name n (aof j))))
                     (if (coco_write_escaped cp)
                         (coco_write_escape b cp uni)
                         (for ((size_t k . i)) (< k j) ((++ k)) (coco_sb_putc b (nth k name))))
                     (set i (- j 1)))))
                (#t (coco_sb_putc b (cast char c)))))))
        (return (coco_sb_putc b (cast char (coco-ch "'")))))

  ;;; THE WRITE'S MODE IS ONE WORD (1.10.18): quoted (1), operators ignored
  ;;; (2), and the term an operator's operand (4) -- the first two hold for
  ;;; the whole write, the third is each term's own. The depth the cycle
  ;;; guard counts made the writer's arguments eight, and the seventh and
  ;;; eighth went on the stack: two pushes and a pop a call, 3 % of the
  ;;; writer's own count. Six fit in registers.
  (static) (decl) (func coco_write_rec ((coco_machine * m) (coco_strbuf * b) (size_t t)
                                      (int mode) (int maxprec) (u32 depth)) (out int))

  ;;; A CYCLE STOPS THE WRITE (1.10.18): WCYC set, and WDEEP 0, so that every
  ;;; compound still to be written answers at once -- `X = f(X, X)' would
  ;;; otherwise write both arguments of every level above the one it was
  ;;; found at -- and the top of the write takes back what it wrote
  ;;; (`coco_write_top').
  (static)
  (func coco_write_stop ((coco_machine * m))
        (set (-> m wcyc) 1)
        (set (-> m wdeep) 0))

  ;;; `[a,b|T]'. Written iteratively rather than by recursing on the tail, so a
  ;;; ten-thousand-element list does not need ten thousand stack frames --
  ;;; a list is the one term shape deep enough for that to matter.
  ;;;
  ;;; A LIST AS THE COMPOUNDS IT IS, under write_term/2's dotlists(true)
  ;;; (2048) and no_lists(true) (4096): `.(1,.(2,[]))' and
  ;;; `'[|]'(1,'[|]'(2,[]))', swipl 9.0.4's writeList(), dotlists the
  ;;; stronger -- its `.' a token of its own (`- .(1,[])'), the other the
  ;;; atom swipl names its list cells by, quoted as a write quotes. Each
  ;;; element one deeper than the one before, as the list's own walk counts
  ;;; them under max_depth (1024), and a tail past the limit `...'; the
  ;;; tail's cycle asked as the list's walk asks it (Brent's). Out of line:
  ;;; no other write comes here.
  (weak)
  (func coco_write_list_dots ((coco_machine * m) (coco_strbuf * b) (size_t t)
                              (int mode) (u32 depth)) (out int)
        (let ((int kids . #'(bitand mode 49115)) (int cut . #'(!= 0 (bitand mode 1024)))
              (u32 k . 0) (size_t kept . #'(cast size_t -1)) (size_t lam . 0) (size_t power . 1024))
          (while 1
            (set t (coco_deref m t))
            (if (== t kept) (block (coco_write_stop m) break))
            (set lam (+ lam 1))
            (if (== lam power)
                (block (if (-> m wcyc) break)
                       (set kept t) (set power (* power 2)) (set lam 0)))
            (if (!= 0 (bitand mode 2048))
                (coco_sb_putc b (cast char (coco-ch ".")))
              (coco_write_atom b "[|]" (bitand mode 337)))
            (coco_sb_putc b (cast char (coco-ch "(")))
            (set k (+ k 1))
            (coco_write_rec m b (coco_arg m t 0) kids 999 (? cut (+ depth k) (+ depth 1)))
            (coco_sb_putc b (cast char (coco-ch ",")))
            (if (!= 0 (bitand mode 512)) (coco_sb_putc b (cast char 32)))
            (set t (coco_deref m (coco_arg m t 1)))
            (if (and (coco-tag-is ATOM (nth t (-> m heap))) (coco_is_nil m t))
                (block (coco_sb_put b "[]") break))
            (if (and cut (>= (+ (cast i64 depth) (+ (cast i64 k) 1)) (-> m wmax)))
                (block (coco_sb_put b "...") break))
            (if (not (coco_is_cons m t))
                (block (coco_write_rec m b t kids 999 (? cut (+ depth (+ k 1)) (+ depth 1)))
                       break)))
          (while (> k 0)
            (coco_sb_putc b (cast char (coco-ch ")")))
            (set k (- k 1)))
          (return 1)))

  ;;; A TAIL THAT COMES BACK ON ITSELF is found by Brent's method (1.10.18):
  ;;; a cell kept, compared with each cell after it, and kept again at the
  ;;; 1024th, the 2048th after that, and so on -- a cycle of any length is
  ;;; met within twice it, past the first thousand, for a compare and a
  ;;; count a cell. Through 1.10.17 `X = [a|X]' wrote until memory ran out.
  ;;; A LIST UNDER A DEPTH LIMIT (3.49.0, swipl's writeList()): its K-th
  ;;; element one deeper than the K-1-th, the first one deeper than the
  ;;; list, and a list that would go past the limit ends `|...]' -- so the
  ;;; limit ends the walk, and no cycle needs looking for. Out of line: a
  ;;; write with no limit and no dotlists(true) or no_lists(true) never
  ;;; comes here.
  (weak)
  (func coco_write_list_cut ((coco_machine * m) (coco_strbuf * b) (size_t t)
                             (int mode) (u32 depth)) (out int)
        ;; dotlists(true) and no_lists(true) come by here too (3.53.0): the
        ;; list writer asks one test for the three
        (if (!= 0 (bitand mode 6144)) (return (coco_write_list_dots m b t mode depth)))
        (coco_sb_putc b (cast char (coco-ch "[")))
        (let ((int kids . #'(bitand mode 49115)) (u32 k . 0))
          (while 1
            (set t (coco_deref m t))
            (if (> k 0)
                (block (coco_sb_putc b (cast char (coco-ch ",")))
                       (if (!= 0 (bitand mode 512)) (coco_sb_putc b (cast char 32)))))
            (set k (+ k 1))
            (coco_write_rec m b (coco_arg m t 0) kids 999 (+ depth k))
            (set t (coco_deref m (coco_arg m t 1)))
            (if (and (coco-tag-is ATOM (nth t (-> m heap))) (coco_is_nil m t)) break)
            (if (>= (+ (cast i64 depth) (+ (cast i64 k) 1)) (-> m wmax))
                (return (coco_sb_put b "|...]")))
            (if (not (coco_is_cons m t))
                (block (coco_sb_putc b (cast char (coco-ch "|")))
                       (coco_write_rec m b t kids 999 (+ depth (+ k 1)))
                       break)))
          (return (coco_sb_putc b (cast char (coco-ch "]"))))))

  (static)
  (func coco_write_list ((coco_machine * m) (coco_strbuf * b) (size_t t)
                       (int mode) (u32 depth)) (out int)
        ;; a depth limit (1024), dotlists(true) or no_lists(true) (2048,
        ;; 4096): one test, and the rest out of line
        (if (!= 0 (bitand mode 7168)) (return (coco_write_list_cut m b t mode depth)))
        (coco_sb_putc b (cast char (coco-ch "[")))
        (let ((int first . 1) (int kids . #'(bitand mode 49115))
              (size_t kept . #'(cast size_t -1)) (size_t lam . 0) (size_t power . 1024))
          (while 1
            (set t (coco_deref m t))
            (let ((u64 c . #'(nth t (-> m heap))))
              (if (coco_is_cons m t)
                  (block
                   (if (== t kept) (block (coco_write_stop m) break))
                   (set lam (+ lam 1))
                   (if (== lam power)
                       (block (if (-> m wcyc) break)
                              (set kept t) (set power (* power 2)) (set lam 0)))
                   (if (not first)
                       (block (coco_sb_putc b (cast char (coco-ch ",")))
                              ;; spacing(next_argument) (3.18.0)
                              (if (!= 0 (bitand mode 512)) (coco_sb_putc b (cast char 32)))))
                   (set first 0)
                   (coco_write_rec m b (coco_arg m t 0) kids 999 (+ depth 1))
                   (set t (coco_arg m t 1))
                   continue))
              ;; not a list cell: either the proper end, or a partial list
              (if (and (coco-tag-is ATOM c)
                       (coco_is_nil m t))
                  break)
              (coco_sb_putc b (cast char (coco-ch "|")))
              (coco_write_rec m b t kids 999 (+ depth 1))
              break)))
        (return (coco_sb_putc b (cast char (coco-ch "]")))))

  ;;; `'$VAR'(N)' WRITTEN AS THE VARIABLE IT NAMES (2.2.4), under numbervars
  ;;; (mode 8: print/1, and since 2.2.5 write/1, writeq/1 and write_term/2's
  ;;; numbervars(true)), as swipl's writer does it: an integer N of 0 or
  ;;; more is the letter N mod 26, and past the first 26 the count N // 26
  ;;; after it (`A', `Z', `A1'); a negative one `S_' and its magnitude
  ;;; (`S_1'); an atom that reads as a variable (A-Z or `_', then letters,
  ;;; digits and `_', ASCII as the reader takes them) itself, unquoted.
  ;;; Anything else -- `x', `'Foo bar'', a float, a string, a compound --
  ;;; answers 0 having written nothing, and is written as the compound it is.
  (static)
  (func coco_write_numbervar ((coco_machine * m) (coco_strbuf * b) (size_t a)) (out int)
        (set a (coco_deref m a))
        (let ((u64 c . #'(nth a (-> m heap))) (i64 n . 0))
          (cond ((coco-tag-is INT c) (set n (coco-signed-payload c)))
                ;; a rational is no integer and names none here (2.5.0)
                ((coco-rat-p c) (return 0))
                ((coco-tag-is BIG c) (set n (nth (cast size_t (coco-payload c)) (-> m bigs))))
                ;; a name that reads as a variable: a capital or `_' first and
                ;; a name's continuation after it, past ASCII too (3.35.0,
                ;; swipl's atomIsVarName(): `'$VAR'('Été')' is Été)
                ((coco-tag-is ATOM c)
                 (let ((const char * s . #'(coco_atom_name m (coco_name_of m a)))
                       (size_t n . #'(strlen s)) (size_t i . 0))
                   (if (== n 0) (return 0))
                   (if (== 0 (bitand (coco_rd_flags (coco_utf8_get s n (aof i))) 16)) (return 0))
                   (while (< i n)
                     (if (== 0 (bitand (coco_rd_flags (coco_utf8_get s n (aof i))) 8)) (return 0)))
                   (coco_sb_put b s)
                   (return 1)))
                (#t (return 0)))
          (if (< n 0)
              (block (coco_sb_put b "S_")
                     ;; the magnitude, negated through u64 (no overflow in
                     ;; C): the least integer, which has none in i64, comes
                     ;; out as itself, `S_-9223372036854775808', which is
                     ;; swipl's text to the letter (its own negation wraps)
                     (coco_sb_put_i64 b (cast i64 (- (cast u64 0) (cast u64 n))))
                     (return 1)))
          (coco_sb_putc b (cast char (+ (coco-ch "A") (cast int (% n 26)))))
          (if (>= n 26) (coco_sb_put_i64 b (/ n 26)))
          (return 1)))

  ;;; A PORTRAY GOAL THAT THREW INSIDE SUB (3.54.0): SUB's text has just
  ;;; been put on B from OFF, so the place the write stops at is B's now --
  ;;; an operand is written in a buffer of its own, and the parent puts it
  ;;; on its own when the operand is done, punctuation after the stop too.
  (static)
  (func coco_write_cut_up ((coco_machine * m) (coco_strbuf * b) (coco_strbuf * sub) (size_t off))
        (if (and (-> m wpstop) (== (-> m wpcutbuf) (cast (void *) sub)))
            (let ((size_t at . #'(+ off (-> m wpcut))))
              (set (-> m wpcutbuf) (cast (void *) b))
              (set (-> m wpcut) (? (> at (-> b len)) (-> b len) at)))))

  ;;; A COMPOUND, written: its own function, inlined where it is called, so
  ;;; that the cycle guard's slow path RETURNS rather than rejoining the
  ;;; write -- a call that rejoined could have moved the heap, as far as the
  ;;; compiler knew, and the compound's tag and functor were read again on
  ;;; every compound written (21 instructions each).
  ;;;
  ;;; A WRITE THAT ASKS PORTRAY WRITES ITS COMPOUNDS WITH A COPY OF ITS OWN
  ;;; (3.54.0, `coco_write_fun_p', P 1 below), the body written once: an
  ;;; operand whose first token a portray goal wrote takes no space before
  ;;; it from the token rule -- each write of swipl's begins with no last
  ;;; character, `1+-1', `dynamicxx' -- though the spaces swipl writes
  ;;; whatever follows stay (`a mod -1', `+- = -1', next_argument's `a, -1');
  ;;; and a goal that threw inside an operand carries the place the write
  ;;; stops at up to the buffer the operand is put on (`coco_write_cut_up').
  ;;; Each such site is `(if ,P ...)', which the compiler drops from the
  ;;; plain copy, so a write that asks nothing runs as it ran.
  (DEFMACRO coco-write-fun-body (P)
        `(let ((const char * name . #'(coco_atom_name m (coco_name_of m t)))
              (u32 n . #'(coco_arity m t))
              ;; what an atom of it reads: quoted 1, escapes 16 and their
              ;; form 64 (3.1.0), the raw text 256 and quote_non_ascii's
              ;; 32768 (3.55.0)
              (int quoted . #'(bitand mode 33105))
              ;; what this write's operands and arguments carry down:
              ;; quoted 1, ignore_ops 2, numbervars 8, escapes 16 and 64,
              ;; write_canonical/1's braces 128 (brace_terms(false)'s
              ;; since 3.55.0), the raw text 256, next_argument's comma
              ;; spaces 512, max_depth's limit 1024, dotlists 2048,
              ;; no_lists 4096, portray 8192 and quote_non_ascii 32768 (the
              ;; operand's 4 is each operand's own, and 16384, a portray
              ;; asked, the term's)
              (int kids . #'(bitand mode 49115)))

          ;; THE ATOM `'[]'' AS AN OPERATOR IS WRITTEN QUOTED, and the list's
          ;; end is none (3.15.1, swipl's): op/3 of `'[]'' declares the atom,
          ;; so `'[]'(a,b)' is `a'[]'b' and `[](a,b)' the application
          (if (and (== (nth 0 name) (cast char 91)) (coco_atom_is_tnil m (coco_name_of m t)))
              (set quoted (bitor quoted 32)))

          ;; numbervars (2.2.4): `'$VAR'(N)' as the variable it names
          (if (and (!= 0 (bitand mode 8)) (== n 1) (== 0 (strcmp name "$VAR"))
                   (coco_write_numbervar m b (coco_arg m t 0)))
              (return 1))

          ;; LISTS AND CURLY TERMS HAVE THEIR OWN SURFACE SYNTAX, with the
          ;; operators ignored too (3.1.0, swipl's: `[a,b|c]', `{x}';
          ;; through 3.0.0 `'.'(a,'.'(b,c))' and `'{}'(x)') -- save a curly
          ;; term under write_canonical/1 and write_term/2's
          ;; brace_terms(false) (128, swipl's PL_WRT_BRACETERMS; the option
          ;; read past through 3.54.0), `{}(x)' as swipl writes it
          (if (coco_is_cons m t)
              (return (coco_write_list m b t mode depth)))
          (if (and (== n 1) (== 0 (bitand mode 128)) (== 0 (strcmp name "{}")))
              (block (coco_sb_putc b (cast char (coco-ch "{")))
                     (coco_write_rec m b (coco_arg m t 0) kids 1200 (+ depth 1))
                     (return (coco_sb_putc b (cast char (coco-ch "}"))))))

          (if (and (== 0 (bitand mode 2)) (!= (coco_name_of m t) (coco_nil_id m)))
              (block
               (let ((int prec) (int type))
                 ;; infix
                 (if (and (== n 2) (coco_op_infix name (aof prec) (aof type)))
                     (let ((int lmax . #'(? (== type COCO_YFX) prec (- prec 1)))
                           (int rmax . #'(? (== type COCO_XFY) prec (- prec 1)))
                           (int paren . #'(? (> prec maxprec) 1 0)))
                       (if paren (coco_sb_putc b (cast char (coco-ch "("))))
                       (coco_write_rec m b (coco_arg m t 0) (bitor kids 4) lmax (+ depth 1))
                       ;; NO SPACES UNLESS THE TOKENS WOULD MERGE. `a-b',
                       ;; but `a mod b' and `1- -2'. The operator and the
                       ;; right operand are rendered into buffers of their
                       ;; own first, because deciding needs their actual
                       ;; first and last characters -- a quoted atom
                       ;; begins with a quote, a negative number with a
                       ;; minus, and neither is knowable from the term.
                       (let ((coco_strbuf ob) (coco_strbuf rb)
                             (void * pold . #'(-> m wpfirst)) (int pf . 0))
                         (coco_sb_init (aof ob))
                         (coco_sb_init (aof rb))
                         ;; THE COMMA IS NOT QUOTED IN OPERATOR POSITION.
                         ;; `coco_write_atom' would make it `','', which is
                         ;; right for the atom and wrong for the operator:
                         ;; `a:-b,c' would come out `a:-b','c' and read
                         ;; back as something else entirely. Nor is the bar
                         ;; (3.2.0), `a|b' as swipl writes '|'(a,b): they
                         ;; are the two operators in the table that
                         ;; `coco_write_atom' quotes.
                         (if (== 0 (strcmp name ","))
                             (coco_sb_putc (aof ob) (cast char (coco-ch ",")))
                           (if (== 0 (strcmp name "|"))
                               (coco_sb_putc (aof ob) (cast char (coco-ch "|")))
                             (coco_write_atom (aof ob) name quoted)))
                         (if ,P (set (-> m wpfirst) nil))
                         (coco_write_rec m (aof rb) (coco_arg m t 1)
                                       (bitor kids 4) rmax (+ depth 1))
                         ;; the right side's first token a portray goal's
                         ;; (3.54.0): no space from the token rule before it
                         (if ,P (block (set pf (== (-> m wpfirst) (cast (void *) (aof rb))))
                                       (set (-> m wpfirst) pold)))
                         ;; A SPACE BEFORE THE OPERATOR IS ONE AFTER IT TOO
                         ;; (3.0.0, swipl's): `+- = b', `+- - 1', where the
                         ;; right side's own gap stands alone (`a- -1')
                         (let ((int gb . #'(coco_needs_gap (coco_sb_last b) (coco_sb_first (aof ob)))))
                           (if gb (coco_sb_putc b (cast char 32)))
                           (if (!= ($ ob s) nil) (coco_sb_put b ($ ob s)))
                           (if (or gb
                                   (and (not pf)
                                        (coco_needs_gap (coco_sb_last (aof ob))
                                                        (coco_sb_first (aof rb))))
                                   ;; spacing(next_argument): `a, b' and `a| b'
                                   (and (!= 0 (bitand mode 512))
                                        (or (== 0 (strcmp name ","))
                                            (== 0 (strcmp name "|")))))
                               (coco_sb_putc b (cast char 32))))
                         (let ((size_t off . #'(-> b len)))
                           (if (!= ($ rb s) nil) (coco_sb_put b ($ rb s)))
                           (if ,P (coco_write_cut_up m b (aof rb) off)))
                         (coco_sb_free (aof ob))
                         (coco_sb_free (aof rb)))
                       (if paren (coco_sb_putc b (cast char (coco-ch ")"))))
                       (return 1)))
                 ;; PREFIX, where the merging rule is not quite the same.
                 ;; `-a' is fine and `-[a]' and `-f(x)' are fine, but
                 ;; three things after a symbolic prefix operator need a
                 ;; space and only one of them is a merge in the ordinary
                 ;; sense:
                 ;;
                 ;;   a symbol character -- `- -a', the ordinary rule;
                 ;;   a DIGIT after `-' alone -- `- 1', because `-1' is
                 ;;     not the operator applied to 1, it is the integer
                 ;;     minus one; that is a rule about prefix position
                 ;;     (`1-2' is right without a space) and about `-'
                 ;;     (`+1', `\1', `?-1' and `:-1' read back as the
                 ;;     operator applied to 1, and swipl writes them so:
                 ;;     through 2.2.2 every one took the space);
                 ;;   an opening parenthesis -- `- (a+b)', which SWI
                 ;;     writes with a space and this follows, after any
                 ;;     prefix operator since 3.15.1, and a brace term.
                 ;;
                 ;; An alphabetic prefix operator always takes one:
                 ;; `dynamic f/1', never `dynamicf/1'.
                 (if (and (== n 1) (coco_op_prefix name (aof prec) (aof type)))
                     (let ((int amax . #'(? (== type COCO_FY) prec (- prec 1)))
                           (int paren . #'(? (> prec maxprec) 1 0)))
                       (if paren (coco_sb_putc b (cast char (coco-ch "("))))
                       (let ((coco_strbuf ob) (coco_strbuf ab)
                             (void * pold . #'(-> m wpfirst)) (int pf . 0))
                         (coco_sb_init (aof ob))
                         (coco_sb_init (aof ab))
                         (coco_write_atom (aof ob) name quoted)
                         (if ,P (set (-> m wpfirst) nil))
                         (coco_write_rec m (aof ab) (coco_arg m t 0)
                                       (bitor kids 4) amax (+ depth 1))
                         ;; the operand's first token a portray goal's
                         ;; (3.54.0): no space before it, `--1', `dynamicxx'
                         (if ,P (block (set pf (== (-> m wpfirst) (cast (void *) (aof ab))))
                                       (set (-> m wpfirst) pold)))
                         (if (coco_needs_gap (coco_sb_last b) (coco_sb_first (aof ob)))
                             (coco_sb_putc b (cast char 32)))
                         (if (!= ($ ob s) nil) (coco_sb_put b ($ ob s)))
                         ;; AN OPENING PARENTHESIS OR BRACE TAKES THE SPACE
                         ;; AFTER ANY PREFIX OPERATOR (3.15.1, swipl's):
                         ;; `pq (a,b)', `'p\'q' (-)', `\+ {a}', `- {}',
                         ;; where `pq(a,b)' read back as pq/2
                         (let ((int last . #'(coco_sb_last (aof ob)))
                               (int first . #'(coco_sb_first (aof ab))))
                           (if (and (not pf)
                                    (or (coco_needs_gap last first)
                                        (== first (coco-ch "("))
                                        (== first (coco-ch "{"))
                                        (and (coco_is_symbol last) (coco_is_digit first)
                                             (== 0 (strcmp name "-")))))
                               (coco_sb_putc b (cast char 32))))
                         (let ((size_t off . #'(-> b len)))
                           (if (!= ($ ab s) nil) (coco_sb_put b ($ ab s)))
                           (if ,P (coco_write_cut_up m b (aof ab) off)))
                         (coco_sb_free (aof ob))
                         (coco_sb_free (aof ab)))
                       (if paren (coco_sb_putc b (cast char (coco-ch ")"))))
                       (return 1))))))

          ;; canonical application: the atom `'[]'' quoted, `'[]'(X)', and
          ;; the list's end bare, `[](X)', as swipl 7 tells them apart
          ;; (3.12.0; through 3.11.0 both `'[]'(X)', which read back as the
          ;; list's end); and `{}' as swipl writes it, `{}(a,b)', in a write
          ;; a program asks for (16, 3.1.0: the reader takes it back since,
          ;; or 256, term_to_atom/2's and character_escapes(false)'s since
          ;; 3.55.0); the engine's own quoted text keeps `'{}'(a,b)', which
          ;; an older reader takes
          (if (== (coco_name_of m t) (coco_nil_id m))
              (coco_sb_put b "[]")
            (if (or (== 0 (strcmp name "[]"))
                    (and (== (bitand mode 273) 1) (== 0 (strcmp name "{}"))))
                (coco_write_atom b name (bitor quoted 32))
              (coco_write_atom b name quoted)))
          (coco_sb_putc b (cast char (coco-ch "(")))
          (for ((u32 i . 0)) (< i n) ((++ i))
            (if (> i 0)
                (block (coco_sb_putc b (cast char (coco-ch ",")))
                       ;; spacing(next_argument) (3.18.0)
                       (if (!= 0 (bitand mode 512)) (coco_sb_putc b (cast char 32)))))
            (coco_write_rec m b (coco_arg m t i) kids 999 (+ depth 1)))
          (return (coco_sb_putc b (cast char (coco-ch ")"))))))

  (static) (inline)
  (func coco_write_fun ((coco_machine * m) (coco_strbuf * b) (size_t t)
                        (int mode) (int maxprec) (u32 depth)) (out int)
        (coco-write-fun-body 0))

  ;;; ... AND A WRITE THAT ASKS PORTRAY'S (3.54.0), out of line, as
  ;;; `coco_write_ask' calls it
  (static)
  (func coco_write_fun_p ((coco_machine * m) (coco_strbuf * b) (size_t t)
                          (int mode) (int maxprec) (u32 depth)) (out int)
        (coco-write-fun-body 1))

  ;;; THE WRITER'S CYCLE GUARD (1.10.18), for every compound met WDEEP (1024)
  ;;; levels down or more. A cyclic term's every infinite path comes this
  ;;; deep, and a tree's rarely does, so the compound met exactly there asks
  ;;; `coco_acyclic' of its own term -- once a path -- and a cycle stops the
  ;;; write; any other is written as it is. Through 1.10.17 nothing asked:
  ;;; the recursion ran until the C stack did, and `write(X)' of `X = f(X)'
  ;;; was a SIGSEGV.
  (static)
  (func coco_write_deep ((coco_machine * m) (coco_strbuf * b) (size_t t)
                         (int mode) (int maxprec) (u32 depth)) (out int)
        (if (-> m wcyc) (return 1))
        (if (and (== depth (-> m wdeep)) (== 0 (coco_acyclic m t)))
            (block (coco_write_stop m) (return 1)))
        (return (coco_write_fun m b t mode maxprec depth)))

  ;;; A VARIABLE OF A WRITE THAT NAMES THEM, out of line (an unnamed one is
  ;;; the writer's common case): write_canonical/1's `_' and `A' ... `Z',
  ;;; `A1' ... from the map `coco_write_canon' filled (`wcanon', 3.1.0),
  ;;; else write_term/2's variable_names or a cyclic write's S_N, else, as
  ;;; any other write, `_G' and the cell.
  (weak)
  (func coco_write_named_var ((coco_machine * m) (coco_strbuf * b) (size_t t)) (out int)
        (if (!= (-> m wcanon) nil)
            (let ((size_t v . 0))
              (if (and (coco_varmap_get (cast (coco_varmap *) (-> m wcanon)) t (aof v)) (>= v 1))
                  (block
                    (if (== v 1) (return (coco_sb_putc b (cast char 95))))
                    (let ((size_t j . #'(- v 2)))
                      (if (not (coco_sb_putc b (cast char (+ 65 (% j 26))))) (return 0))
                      (if (>= j 26) (return (coco_sb_put_i64 b (cast i64 (/ j 26)))))
                      (return 1))))
              (coco_sb_put b "_G")
              (return (coco_sb_put_i64 b (cast i64 t)))))
        (for ((size_t i . 0)) (< i (-> m nwnames)) ((++ i))
          (if (== (nth i (-> m wcells)) t)
              (return (coco_sb_put b (coco_atom_name m (nth i (-> m wnames)))))))
        (coco_sb_put b "_G")
        (return (coco_sb_put_i64 b (cast i64 t))))

  ;;; THE PORTRAY HOOK (3.54.0), filled in by the builtins module
  ;;; (`coco_portray_call' in lib/builtins-format.cicili): it asks portray/1,
  ;;; or portray_goal(G), of T at priority PREC, its text put on B, and
  ;;; answers 1 it portrayed T, 0 it did not, -1 it threw (the write is
  ;;; stopped, `wpstop'). Null in a binary with no builtins module, where
  ;;; nothing asks it.
  (static) (var func coco_portray_hook ((coco_machine * m) (coco_strbuf * b) (size_t t)
                                        (int prec)) (out int))

  (func coco_portray_install ((func h ((coco_machine * m) (coco_strbuf * b) (size_t t)
                                       (int prec)) (out int)))
        (set coco_portray_hook h))

  ;;; A PORTRAY GOAL THAT FAILED HAVING WRITTEN (3.54.0, swipl's): the term
  ;;; is written after its text, from Q, with a space between where the two
  ;;; would read as one token, as the next token of swipl's takes one
  ;;; (`partial w', `-9 v'), and before an opening bracket after anything
  ;;; but a blank or a bracket -- unless the term's first text is another
  ;;; goal's (3.55.0, `wpgapb'), before which no space goes
  (static)
  (func coco_write_gap_at ((coco_strbuf * b) (size_t q))
        (if (or (== q 0) (or (>= q (-> b len)) (== (-> b s) nil))) (return))
        (let ((size_t w . 0)
              (int a . #'(cast int (coco_cp_before (-> b s) (-> b len) 0 q)))
              (int c . #'(cast int (coco_cp_at (-> b s) (-> b len) q (aof w)))))
          (if (or (coco_needs_gap a c)
                  (and (== c (coco-ch "("))
                       (and (!= a (coco-ch "(")) (not (coco_is_space a)))))
              (block (coco_sb_putc b (cast char 32))
                     (memmove (+ (-> b s) (+ q 1)) (+ (-> b s) q) (- (- (-> b len) 1) q))
                     (set (nth q (-> b s)) (cast char 32))))))

  ;;; A TERM OF A WRITE THAT ASKS SOMETHING FIRST (3.54.0, swipl's
  ;;; writeTerm2()), out of line: no write that asks nothing comes here, and
  ;;; the term writer pays one call where 3.53.0 paid one for its `...'
  ;;; (with both asks inline, clang took a putc of the compound writer's out
  ;;; of line: +0.27 % of a write-heavy run). WRITE_TERM/2'S MAX_DEPTH(D)
  ;;; (3.49.0, swipl's writeTerm()) first: a term past D is `...', a token of
  ;;; symbol characters, whose spaces the writer of its operator gives it as
  ;;; it gives an atom's; DEPTH is swipl's less one. Then PORTRAY (8192): a
  ;;; variable is asked nothing, any other term first of all; a goal that
  ;;; portrayed it has written it, one that threw has stopped the write, and
  ;;; one that failed having written leaves its text before the term. A
  ;;; compound is written by the copy that knows a goal's text
  ;;; (`coco_write_fun_p'). Answers -1 where the caller writes the term
  ;;; itself, as a term of no write that asks. 16384 in MODE: this term was
  ;;; asked already. COLD, so that clang takes the branch to it for the
  ;;; unlikely one it is: weighed by the zero heuristic, its `r >= 0'
  ;;; return took the main path's share down far enough that the compound
  ;;; writer's `(' and `)' were cold call sites, each a call of
  ;;; `coco_sb_putc' (+0.27 % of a write-heavy run, +0.43 % with the depth
  ;;; test inside this function and no mark).
  (weak) (cold)
  (func coco_write_ask ((coco_machine * m) (coco_strbuf * b) (size_t t)
                        (int mode) (int maxprec) (u32 depth)) (out int)
        (if (and (!= 0 (bitand mode 1024)) (>= (cast i64 depth) (-> m wmax)))
            (return (coco_sb_put b "...")))
        (if (== 0 (bitand mode 8192)) (return -1))
        (set t (coco_deref m t))
        ;; a write a goal stopped, or a cycle, writes no more
        (if (or (-> m wpstop) (-> m wcyc)) (return 1))
        (if (and (== 0 (bitand mode 16384))
                 (and (!= coco_portray_hook nil) (not (coco-tag-is REF (nth t (-> m heap))))))
            (let ((size_t p0 . #'(-> b len)) (int r . #'(coco_portray_hook m b t maxprec)))
              (if (!= r 0) (return 1))
              (if (> (-> b len) p0)
                  (let ((size_t q . #'(-> b len))
                        (void * sb . #'(-> m wpgapb)) (size_t sq . #'(-> m wpgapq)))
                    ;; the gap at Q is this goal's, until a goal's text
                    ;; begins there (3.55.0: `pgpg a', swipl's)
                    (set (-> m wpgapb) (cast (void *) b)) (set (-> m wpgapq) q)
                    (coco_write_rec m b t (bitor mode 16384) maxprec depth)
                    (if (== (-> m wpgapb) (cast (void *) b)) (coco_write_gap_at b q))
                    (set (-> m wpgapb) sb) (set (-> m wpgapq) sq)
                    (return 1)))))
        (if (coco-tag-is FUN (nth t (-> m heap)))
            (block
              (if (and (== depth (-> m wdeep)) (== 0 (coco_acyclic m t)))
                  (block (coco_write_stop m) (return 1)))
              (return (coco_write_fun_p m b t mode maxprec depth))))
        (return -1))

  (func coco_write_rec ((coco_machine * m) (coco_strbuf * b) (size_t t)
                      (int mode) (int maxprec) (u32 depth)) (out int)
        ;; A WRITE THAT ASKS NOTHING PAYS ONE TEST OF ITS MODE: max_depth's
        ;; 1024 (on only while WMAX is set, `coco_wt_put') and portray's 8192
        ;; are asked out of line (`coco_write_ask')
        (if (!= 0 (bitand mode 9216))
            (let ((int r . #'(coco_write_ask m b t mode maxprec depth)))
              (if (>= r 0) (return r))))
        (set t (coco_deref m t))
        (let ((u64 c . #'(nth t (-> m heap))))
          (cond
            ;; an unbound variable prints by its cell, which is stable for as
            ;; long as the machine lives and unique across it -- unless this
            ;; write names its variables (`coco_write_named_var')
            ((coco-tag-is REF c)
             (if (!= (-> m nwnames) 0) (return (coco_write_named_var m b t)))
             (coco_sb_put b "_G")
             (return (coco_sb_put_i64 b (cast i64 t))))

            ((coco-tag-is INT c) (return (coco_sb_put_i64 b (coco-signed-payload c))))

            ;; a rational is `N r D' in every write mode, as SWI writes it
            ;; (2.5.0); the pair is already reduced and D > 1, and the tag
            ;; keeps it apart from the boxed integers (four tag bits, 2.5.0)
            ((coco-rat-p c)
             (let ((i64 n . 0) (i64 d . 1))
               (coco_rat_nd m c (aof n) (aof d))
               (coco_sb_put_i64 b n)
               (coco_sb_putc b (cast char (coco-ch "r")))
               (return (coco_sb_put_i64 b d))))

            ;; an integer past the 60 bits a cell keeps, from its table (2.0.0)
            ((coco-tag-is BIG c)
             (return (coco_sb_put_i64 b (nth (cast size_t (coco-payload c)) (-> m bigs)))))

            ;; to read back bit for bit, as SWI writes it (1.10.28)
            ((coco-tag-is FLT c)
             (return (coco_sb_put_double b (nth (cast size_t (coco-payload c)) (-> m floats)))))

            ;; A STRING WRITES AS ITS TEXT, and quoted it writes in DOUBLE
            ;; quotes -- which is the one place cocolog emits a `"' meaning
            ;; anything but a code list. Reading it back needs
            ;; `double_quotes' to be `string', which is exactly the flag that
            ;; made it in the first place, so a term written under that flag
            ;; reads under it.
            ;;
            ;; THE BYTES GO OUT ONE AT A TIME because a string may contain a
            ;; NUL and coco_sb_put takes a C string. That is the difference
            ;; between this and the atom case below it, and it is the whole
            ;; reason the type exists.
            ((coco-tag-is STR c)
             ;; 34 is `"', 92 is `\', 110 is `n', 116 is `t'. Written as
             ;; codes for the reason the lexer above already gives: a Cicili
             ;; string literal is RAW, so `"\""' holds a backslash AND a
             ;; quote, and `coco-ch' of it answers with the backslash. Getting
             ;; that wrong wrote every string delimited by backslashes.
             (let ((const char * sp . nil) (size_t sn . 0))
               (if (not (coco_string_text m t (aof sp) (aof sn))) (return 0))
               (if (== 0 (bitand mode 1))
                   (block ;; its text goes out with no token's check, as
                          ;; swipl's PutString() puts it: no gap before it
                          ;; where a failed goal's text or partial(true)'s
                          ;; last character stands (3.56.0, `pgs', `as')
                          (if (and (> sn 0) (and (== (-> m wpgapb) (cast (void *) b))
                                                 (== (-> m wpgapq) (-> b len))))
                              (set (-> m wpgapb) nil))
                          (for ((size_t i . 0)) (< i sn) ((++ i))
                                (coco_sb_putc b (nth i sp)))
                          (return 1)))
               (coco_sb_putc b (cast char 34))
               (for ((size_t i . 0)) (< i sn) ((++ i))
                    (let ((char ch . #'(nth i sp)))
                      (cond ;; doubled under 256 without the escapes (3.55.0):
                            ;; swipl's PL_WRT_QUOTED alone, term_to_atom/2's
                            ;; `"a""b"' and character_escapes(false)'s
                            ((and (== ch (cast char 34)) (== (bitand mode 272) 256))
                             (coco_sb_putc b (cast char 34))
                             (coco_sb_putc b (cast char 34)))
                            ((== ch (cast char 34))
                             (coco_sb_putc b (cast char 92))
                             (coco_sb_putc b (cast char 34)))
                            ((== ch (cast char 92))
                             (coco_sb_putc b (cast char 92))
                             (coco_sb_putc b (cast char 92)))
                            ;; as they are under 256 (3.15.1), as in an atom
                            ((and (!= 0 (bitand mode 256))
                                  (or (== ch (cast char 10)) (== ch (cast char 9))))
                             (coco_sb_putc b ch))
                            ((== ch (cast char 10))
                             (coco_sb_putc b (cast char 92))
                             (coco_sb_putc b (cast char 110)))
                            ((== ch (cast char 9))
                             (coco_sb_putc b (cast char 92))
                             (coco_sb_putc b (cast char 116)))
                            ;; under swipl's character escapes (2.2.5) the
                            ;; control characters with a letter, 13 `\r'
                            ;; among them, as in an atom
                            ((and (!= 0 (bitand mode 16))
                                  (!= 0 (coco_escape_letter (cast int ch))))
                             (coco_sb_putc b (cast char 92))
                             (coco_sb_putc b (cast char (coco_escape_letter (cast int ch)))))
                            ;; and a character to escape by its code, of
                            ;; however many bytes (3.1.0, `coco_write_atom')
                            ((and (!= 0 (bitand mode 16))
                                  (or (< (cast uchar ch) 32) (>= (cast uchar ch) 127)))
                             (let ((size_t j . i) (i64 cp . #'(coco_utf8_get sp sn (aof j))))
                               (if (coco_write_escaped cp)
                                   (coco_write_escape b cp (bitand mode 64))
                                   (for ((size_t k . i)) (< k j) ((++ k)) (coco_sb_putc b (nth k sp))))
                               (set i (- j 1))))
                            (#t (coco_sb_putc b ch)))))
               (coco_sb_putc b (cast char 34))
               (return 1)))

            ((coco-tag-is ATOM c)
             (let ((const char * name . #'(coco_atom_name m (coco_name_of m t))))
               ;; AN OPERATOR ATOM IS BRACKETED AS AN OPERAND AND NOWHERE
               ;; ELSE. `f(-)' and `[-]' and `[a,-]' are all fine as they
               ;; stand: an argument is read at priority 999 and a `-' followed
               ;; by a `,' or a `]' cannot be a prefix operator, so it comes
               ;; back as the atom. `- (-)' and `(-)-a' are not fine, because
               ;; there the atom really is where an operator would be read.
               ;;
               ;; It used to bracket in every position but the top, which is
               ;; safe and is not what SWI writes.
               ;;
               ;; OPERAND IS ASKED FIRST. The tables answer with a `strcmp'
               ;; down every infix and then every prefix operator, about
               ;; 1300 instructions, and they were asked of every atom
               ;; written -- 7.8 % of the translator's lesson -- to be
               ;; thrown away for every atom that was not an operand.
               ;;
               ;; THE ATOM `'[]'' IS WRITTEN QUOTED wherever quotes are
               ;; written (3.0.0): unquoted it would read back as the list's
               ;; end, which shares its name. Its first byte is asked first.
               (if (and (!= 0 (bitand mode 1))
                        (and (== (nth 0 name) (cast char 91))
                             (coco_atom_is_tnil m (coco_name_of m t))))
                   (return (coco_write_atom b name (bitor (bitand mode 81) 32))))
               (if (and (!= 0 (bitand mode 4)) (coco_op_is_any name))
                   (block (coco_sb_putc b (cast char (coco-ch "(")))
                          (coco_write_atom b name (bitand mode 33105))
                          (return (coco_sb_putc b (cast char (coco-ch ")"))))))
               (return (coco_write_atom b name (bitand mode 33105)))))

            ;; a compound, unless it is deep enough to be asked whether it is
            ;; a cycle -- or a cycle was found
            ((coco-tag-is FUN c)
             (if (>= depth (-> m wdeep))
                 (return (coco_write_deep m b t mode maxprec depth)))
             (return (coco_write_fun m b t mode maxprec depth)))

            (#t (return (coco_sb_put b "<?>"))))))

  ;;; A CYCLIC TERM WRITTEN AS SWI WRITES ONE (1.10.18), `@(Template,
  ;;; Substitutions)' -- `@(S_1,[S_1=f(S_1)])' for `X = f(X)' -- from
  ;;; `coco_factorize' (lib/term-walk.cicili), its cells wound back after. NAMED
  ;;; writes the variables that stand for the cycles S_1, S_2, ..., as
  ;;; SWI's write/1, print/1 and writeq/1 do; otherwise each is the variable
  ;;; it is. A write under numbervars (8) binds each to `'$VAR'('S_N')', as
  ;;; swipl's writeTopTerm() binds them (3.55.0): written as the variable
  ;;; it names, beside any variable_names/1 names (`@(g(S_1,V),...)'), and
  ;;; asked of portray as a term (`pg S_1'). The engine's own writes,
  ;;; with no numbervars, name them by the write's names, unless this
  ;;; write names variables of its own.
  (static)
  (func coco_write_cyclic ((coco_machine * m) (coco_strbuf * b) (size_t t)
                           (int mode) (int named)) (out int)
        (let ((size_t mark . #'(-> m heap_len))
              (size_t * vars . nil) (size_t nv . 0) (u64 * ids . nil)
              (int rc . 0) (int own . 0)
              (size_t f . #'(coco_factorize m t "@" (aof vars) (aof nv))))
          (if (== f 0)
              (block (free vars) (set (-> m heap_len) mark) (return 0)))
          (if (and named (!= 0 (bitand mode 8)))
              (let ((char nm [32]))
                ;; bound as the factors were, above MARK and off the trail
                (for ((size_t i . 0)) (< i nv) ((++ i))
                  (snprintf nm (sizeof nm) "S_%d" (cast int (+ i 1)))
                  (let ((size_t dv . #'(coco_make1 m "$VAR" (coco_new_atom m nm))))
                    (set (nth (nth i vars) (-> m heap)) (coco-cell REF dv))))
                (set named 0)))
          (if (and named (and (== (-> m nwnames) 0) (> nv 0)))
              (block
               (set ids (cast (u64 *) (malloc (* nv (sizeof u64)))))
               (if (!= ids nil)
                   (let ((char nm [32]))
                     (for ((size_t i . 0)) (< i nv) ((++ i))
                       (snprintf nm (sizeof nm) "S_%d" (cast int (+ i 1)))
                       (set (nth i ids) (coco_intern m nm)))
                     (set (-> m wcells) vars) (set (-> m wnames) ids) (set (-> m nwnames) nv)
                     (set own 1)))))
          (set rc (coco_write_rec m b f mode 1200 0))
          (if own
              (block (set (-> m wcells) nil) (set (-> m wnames) nil) (set (-> m nwnames) 0)))
          (free ids) (free vars)
          (set (-> m heap_len) mark)
          (return rc)))

  ;;; THE TOP OF A WRITE (1.10.18): the term as it stands -- or, when the
  ;;; walk met a cycle, what it wrote taken back and the term written in
  ;;; factors. The guard's state is the machine's between writes (WDEEP
  ;;; 1024, WCYC 0) and is put back here, so a write that meets no cycle
  ;;; pays a load and a branch for it. MODE is the writer's word without the
  ;;; operand's 4: quoted 1, ignore_ops 2, numbervars 8, character escapes 16,
  ;;; their unicode form 64, write_canonical/1's curly terms 128 (and
  ;;; brace_terms(false)'s, 3.55.0), a control character as it is 256
  ;;; (term_to_atom/2's, 3.15.1; without 16, character_escapes(false)'s
  ;;; text, 3.55.0), a space after each comma 512 (3.18.0), a depth limit
  ;;; 1024 (3.49.0, the machine's WMAX), dotlists 2048, no_lists 4096,
  ;;; portray 8192 and quote_non_ascii 32768 (3.55.0). Under a limit of
  ;;; 1024 or less a cyclic term meets the limit before the guard, and is
  ;;; written to it, as swipl's.
  (static) (inline)
  (func coco_write_top ((coco_machine * m) (coco_strbuf * b) (size_t t)
                        (int mode) (int named)) (out int)
        (let ((size_t from . #'(-> b len))
              (int rc . #'(coco_write_rec m b t mode (? (> (-> m wprec) 0) (- (-> m wprec) 1) 1200) 0)))
          (if (-> m wcyc)
              (block
               (set (-> b len) from)
               (if (!= (-> b s) nil) (set (nth from (-> b s)) (cast char 0)))
               (set (-> m wcyc) 0) (set (-> m wdeep) 1024)
               (set rc (coco_write_cyclic m b t mode named))
               ;; the factors hold no cycle; this is for a write that
               ;; could not make them
               (set (-> m wcyc) 0) (set (-> m wdeep) 1024)))
          (return rc)))

  (func coco_write_term ((coco_machine * m) (coco_strbuf * b) (size_t t)
                       (int quoted) (int ignore_ops)) (out int)
        (return (coco_write_top m b t (bitor (? quoted 1 0) (? ignore_ops 2 0)) 1)))

  (func coco_write_pri ((coco_machine * m) (coco_strbuf * b) (size_t t)
                        (int mode) (int maxprec)) (out int)
        (return (coco_write_rec m b t mode maxprec 0)))

  ;;; What goes into the database: quoted, so it reads back, and with operators
  ;;; kept, so a person looking at the table can see what the clause says.
  (func coco_write_storable ((coco_machine * m) (coco_strbuf * b) (size_t t)) (out int)
        (return (coco_write_top m b t 3 0)))

  (func coco_write_canonical ((coco_machine * m) (coco_strbuf * b) (size_t t)) (out int)
        (return (coco_write_top m b t 1 0)))

  ;;; The term's variables in the order a write meets them, a compound's
  ;;; arguments left to right, each mapped in VM to 1 when met once and to
  ;;; 2 when met again, and then the ones met again to 2 + J, J counting
  ;;; them in that order. 0 when a table could not grow.
  (static)
  (func coco_canon_vars ((coco_machine * m) (size_t t) (coco_varmap * vm)) (out int)
        (let ((size_t * wl . nil) (size_t wlen . 0) (size_t wcap . 0)
              (size_t * vars . nil) (size_t nv . 0) (size_t vcap . 0)
              (int ok . 1) (size_t j . 0))
          (if (not (coco_cells_push (aof wl) (aof wlen) (aof wcap) t)) (set ok 0))
          (while (and ok (> wlen 0))
            (set wlen (- wlen 1))
            (let ((size_t a . #'(coco_deref m (nth wlen wl))) (size_t seen . 0))
              (cond
                ((coco-tag-is REF (nth a (-> m heap)))
                 (cond
                   ((coco_varmap_get vm a (aof seen))
                    (if (and (== seen 1) (not (coco_varmap_put vm a 2))) (set ok 0)))
                   ((not (coco_varmap_put vm a 1)) (set ok 0))
                   ((not (coco_cells_push (aof vars) (aof nv) (aof vcap) a)) (set ok 0))
                   (#t (block))))
                ((coco-tag-is FUN (nth a (-> m heap)))
                 (for ((u32 i . #'(coco_arity m a))) (> i 0) ((set i (- i 1)))
                   (if (not (coco_cells_push (aof wl) (aof wlen) (aof wcap) (coco_arg m a (- i 1))))
                       (set ok 0))))
                (#t (block)))))
          (for ((size_t i . 0)) (and ok (< i nv)) ((++ i))
            (let ((size_t seen . 0))
              (if (and (coco_varmap_get vm (nth i vars) (aof seen)) (== seen 2))
                  (block (if (not (coco_varmap_put vm (nth i vars) (+ 2 j))) (set ok 0))
                         (set j (+ j 1))))))
          (free wl) (free vars)
          (return ok)))

  (func coco_name_vars ((coco_machine * m) (size_t t) (coco_varmap * vm)) (out int)
        (return (coco_canon_vars m t vm)))

  ;;; write_canonical/1 AND `~k' AS swipl's (3.1.0): quoted with swipl's
  ;;; character escapes, operators ignored and a curly term functional
  ;;; (147: `-(1,2)', `-(1)', `{}(x)'; a list is `[a|b]'),
  ;;; no numbervars (`'$VAR'(1)' as it is), and each variable named by
  ;;; when the write meets it: one met once `_', the others `A' ... `Z',
  ;;; `A1' ... (`f(A,_,A)'). A cyclic term is written in its factors with
  ;;; their variables as they are, as swipl's is. Through 3.0.0 operators
  ;;; were kept and a variable was `_G' and its cell. The engine's own
  ;;; canonical text is `coco_write_canonical''s.
  (func coco_write_canon ((coco_machine * m) (coco_strbuf * b) (size_t t)) (out int)
        (if (or (!= (-> m nwnames) 0) (== 0 (coco_acyclic m t)))
            (return (coco_write_top m b t 147 0)))
        (let ((coco_varmap vm . '{ nil nil 0 0 0 }) (int rc . 0))
          (coco_varmap_take m (aof vm))
          (if (not (coco_canon_vars m t (aof vm)))
              (block (coco_varmap_give m (aof vm)) (set (-> m oom) 1) (return 0)))
          (set (-> m wcanon) (cast (void *) (aof vm)))
          (set (-> m nwnames) 1)
          (set rc (coco_write_top m b t 147 0))
          (set (-> m wcanon) nil)
          (set (-> m nwnames) 0)
          (coco_varmap_give m (aof vm))
          (return rc)))

  ;;; print/1 and `~p': quoted, numbervars and swipl's character escapes
  ;;; (25; 9 in 2.2.4, `'don''t'')
  (func coco_write_print ((coco_machine * m) (coco_strbuf * b) (size_t t)) (out int)
        (return (coco_write_top m b t 89 1)))

  (func coco_write_mode ((coco_machine * m) (coco_strbuf * b) (size_t t)
                         (int mode) (int named)) (out int)
        (return (coco_write_top m b t mode named)))

  ;;; A WRITE THAT ASKS PORTRAY (3.54.0, swipl's writeTopTerm() under
  ;;; portray(true)), MODE with 8192: a cyclic term in its factors from the
  ;;; first, as swipl asks PL_is_acyclic() before it writes, so that no goal
  ;;; is asked of the term unwound -- unless a depth limit cuts the walk
  ;;; first (`coco_write_top' 's note); and where a goal threw, what was
  ;;; written after its text taken back, the ball left for the builtin
  ;;; (`wpstate'). The buffer the stop is in is B by then: every operand's
  ;;; own carries it up as it is put on its parent's (`coco_write_cut_up').
  (func coco_write_portrayed ((coco_machine * m) (coco_strbuf * b) (size_t t)
                              (int mode) (int named)) (out int)
        (let ((int rc . 0))
          (set (-> m wpstop) 0) (set (-> m wpcutbuf) nil) (set (-> m wpfirst) nil)
          (if (and (== 0 (bitand mode 1024)) (== 0 (coco_acyclic m t)))
              (set rc (coco_write_cyclic m b t mode named))
            (set rc (coco_write_top m b t mode named)))
          (if (-> m wpstop)
              (block
                (if (and (== (-> m wpcutbuf) (cast (void *) b)) (< (-> m wpcut) (-> b len)))
                    (block (set (-> b len) (-> m wpcut))
                           (if (!= (-> b s) nil) (set (nth (-> b len) (-> b s)) (cast char 0)))))
                (set (-> m wpstop) 0) (set (-> m wpcutbuf) nil)))
          (set (-> m wpfirst) nil)
          (return rc)))

  (func coco_write_fullstop ((coco_strbuf * b) (int nl)) (out int)
        (if (coco_needs_gap (coco_sb_last b) (coco-ch ".")) (coco_sb_putc b (cast char 32)))
        (coco_sb_putc b (cast char (coco-ch ".")))
        (return (coco_sb_putc b (cast char (? nl 10 32)))))

  ;;; write/1 and writeln/1: numbervars (8, 2.2.5; through 2.2.4 none, and
  ;;; `write('$VAR'(1))' was `$VAR(1)' where swipl writes `B')
  (func coco_print_term ((coco_machine * m) (FILE * f) (size_t t))
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_top m (aof b) t 8 1)
          (if (!= ($ b s) nil) (coco_out_puts f ($ b s)))
          (coco_sb_free (aof b))))

  ) ; impl-syntax

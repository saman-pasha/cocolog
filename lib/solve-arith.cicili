                               (if (== s1 2) (return (coco_not_integer_rat e n1 d1)))
                               (if s1 (return (coco_not_integer e f1)))
                               (if (== s2 2) (return (coco_not_integer_rat e n2 d2)))
                               (if s2 (return (coco_not_integer e f2)))
                               (if (< i0 0)
                                   (return (coco_domain_error e "not_less_than_zero"
                                                              (coco_new_int m i0))))
                               (if (< i1 0)
                                   (return (coco_domain_error e "not_less_than_zero"
                                                              (coco_new_int m i1))))
                               (if (< i2 1)
                                   (return (coco_domain_error e "not_less_than_one"
                                                              (coco_new_int m i2))))
                               (set (cof iv) (cast i64 (coco_powm64 (cast u64 i0)
                                                                    (cast u64 i1)
                                                                    (cast u64 i2))))
                               (set (cof isf) 0) (return 1))
                           (return (coco_not_evaluable e nid n)))
                       (return (coco_not_evaluable e nid n)))))))))
          (return 0)))

  ;;; ROUNDTOWARD(Expr, Mode) (2.5.0): the C rounding mode set around the
  ;;; evaluation of Expr -- so the arithmetic inside rounds as asked -- and
  ;;; put back whatever it was, even on a raise. swipl's caveat applies:
  ;;; a libm function is free to ignore the mode.
  (static)
  (func coco_roundtoward ((coco_engine * e) (size_t t)
                          (int * isf) (i64 * iv) (double * fv) (u32 depth)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (size_t mt . #'(coco_deref m (coco_arg m t 1)))
              (int mode . -1) (int old . 0) (int rc . 0))
          (if (not (coco-tag-is ATOM (nth mt (-> m heap))))
              (return (coco_type_error e "round" mt)))
          (set mode (coco_round_mode (coco_atom_name m (coco_name_of m mt))))
          (if (< mode 0) (return (coco_domain_error e "round" mt)))
          (set old (fegetround))
          (fesetround mode)
          (set rc (coco_arith e (coco_arg m t 0) isf iv fv (+ depth 1)))
          (fesetround old)
          (return rc)))

  (func coco_bi_is ((coco_engine * e) (size_t g)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (int isf) (i64 iv) (double fv) (int rc))
          (set rc (coco_arith e (coco_arg m g 1)
                              (aof isf) (aof iv) (aof fv) 0))
          (if (!= rc 1)
              (return (? (== rc 3) (coco_type_error e "expression" (coco_arg m g 1)) rc)))
          (let ((size_t r . #'(? (== isf 2) (coco_new_rat m (-> m arith_n) (-> m arith_d))
                                 (? (== isf 1) (coco_new_float m fv) (coco_new_int m iv)))))
            (if (== r (cast size_t -1)) (return (coco_int_overflow e)))
            (return (? (coco_unify m (coco_arg m g 0) r) 1 0)))))

  ;;; The six numeric comparisons. Both sides are evaluated, then compared as
  ;;; doubles unless both stayed integers -- so 1 =:= 1.0 is true, as it must
  ;;; be, while 1 == 1.0 is false, as it also must be. OUT_C is -1, 0 or 1,
  ;;; or 2 when a NaN leaves the two UNORDERED (2.1.2, IEEE's and swipl's):
  ;;; then =\= holds and the other five fail, `X =:= X' among them. Through
  ;;; 2.1.1 a NaN was 0 against anything, equal to every number.
  (static)
  (func coco_num_cmp ((coco_engine * e) (size_t g) (int * out_c)) (out int)
        (let ((coco_machine * m . #'(-> e m))
              (int s0) (i64 i0) (i64 n0 . 0) (i64 d0 . 1) (double f0)
              (int s1) (i64 i1) (i64 n1 . 0) (i64 d1 . 1) (double f1)
              (int rc))
          (set rc (coco_arith e (coco_arg m g 0)
                              (aof s0) (aof i0) (aof f0) 0))
          (if (!= rc 1)
              (return (? (== rc 3) (coco_type_error e "expression" (coco_arg m g 0)) rc)))
          (if (== s0 2)
              (block (set n0 (-> m arith_n)) (set d0 (-> m arith_d))))
          (set rc (coco_arith e (coco_arg m g 1)
                              (aof s1) (aof i1) (aof f1) 0))
          (if (!= rc 1)
              (return (? (== rc 3) (coco_type_error e "expression" (coco_arg m g 1)) rc)))
          (if (== s1 2)
              (block (set n1 (-> m arith_n)) (set d1 (-> m arith_d))))
          (if (and (== s0 0) (== s1 0))
              (set (cof out_c) (? (< i0 i1) -1 (? (> i0 i1) 1 0)))
            (if (or (== s0 2) (== s1 2))
                ;; A RATIONAL ON EITHER SIDE IS COMPARED EXACTLY (2.5.0);
                ;; a float that is no i64 fraction falls back to doubles
                (let ((i64 a . 0) (i64 b . 1) (i64 c . 0) (i64 e . 1) (int ok . 1))
                  (if (== s0 2) (block (set a n0) (set b d0))
                    (if (== s0 1)
                        (if (not (coco_double_rat f0 (aof a) (aof b))) (set ok 0))
                      (set a i0)))
                  (if (== s1 2) (block (set c n1) (set e d1))
                    (if (== s1 1)
                        (if (not (coco_double_rat f1 (aof c) (aof e))) (set ok 0))
                      (set c i1)))
                  (if ok
                      (block (set (cof out_c) (coco_rat_cmp a b c e)) (return 1)))
                  (let ((double x . #'(? (== s0 1) f0
                                         (? (== s0 2) (/ (cast double n0) (cast double d0))
                                            (cast double i0))))
                        (double y . #'(? (== s1 1) f1
                                         (? (== s1 2) (/ (cast double n1) (cast double d1))
                                            (cast double i1)))))
                    (set (cof out_c) (? (< x y) -1 (? (> x y) 1 (? (== x y) 0 2))))
                    (return 1)))
              (let ((double a . #'(? (== s0 1) f0 (cast double i0)))
                    (double b . #'(? (== s1 1) f1 (cast double i1))))
                (set (cof out_c) (? (< a b) -1 (? (> a b) 1 (? (== a b) 0 2)))))))
          (return 1)))

  (func coco_bi_num_eq  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (== c 0) 1 0))))
  (func coco_bi_num_neq ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (!= c 0) 1 0))))
  (func coco_bi_num_lt  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (< c 0) 1 0))))
  (func coco_bi_num_gt  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (== c 1) 1 0))))
  (func coco_bi_num_le  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (<= c 0) 1 0))))
  (func coco_bi_num_ge  ((coco_engine * e) (size_t g)) (out int)
        (let ((int c) (int rc . #'(coco_num_cmp e g (aof c)))) (if (!= rc 1) (return rc))
             (return (? (or (== c 0) (== c 1)) 1 0))))

  ) ; impl-solve-arith


;;;; The torch module: libtorch as cocolog predicates, in one Cicili
;;;; C++ target.
;;;;
;;;; WHAT THIS IS. cocolog's module seam takes a dispatcher and a piece
;;;; of Prolog text; nothing says the C half has to be C. This target is
;;;; C++ so that it can hold torch::Tensor and torch::nn::Module -- it
;;;; declares the slice of cocolog's module API it uses (cocolog.c
;;;; compiles as C99, so the raw extern "C" block below is the real
;;;; declaration and the Cicili decls after it feed inference),
;;;; implements the predicates against the real libtorch, and registers
;;;; itself with coco_module_register like any other module. `make
;;;; torch' links it; the plain build reaches coco_torch_module through
;;;; a weak symbol, finds nothing, and the torch predicates are then
;;;; what they should be in a build without torch: unknown procedures.
;;;;
;;;; TWO LANGUAGES, ONE TARGET, EACH DOING WHAT IT IS FOR. The network
;;;; machinery -- layers, shape flow, the training loop, schedulers,
;;;; the parameter-and-buffer walks -- is RAW C++ inside (code ...)
;;;; blocks: it is exactly the C++ lib/cpp/torch's DSL emits at
;;;; expansion time, written once at run time, and libtorch's holder
;;;; and options idioms are native there. Everything that faces the
;;;; engine -- argument marshalling, term building, the dispatcher --
;;;; is Cicili.
;;;;
;;;; HANDLES, AND WHAT THEY ARE NOT. A tensor or a model is a C++
;;;; object; Prolog holds an integer handle. A handle is PROCESS-LOCAL
;;;; and deliberately not part of any machine's state: a suspended
;;;; machine carrying one finds it meaningless when it thaws somewhere
;;;; else, exactly as it would a file descriptor. What IS durable is a
;;;; model as terms -- model_spec/2 and model_params/2 (parameters AND
;;;; buffers: batch norm's running statistics travel too) -- and the
;;;; Coco half writes model_save/2 and model_load/2 over them, chunked
;;;; to the page discipline. An assert is what puts a trained model in
;;;; Zigurat.
;;;;
;;;; NUMBERS CROSS THE SEAM AS double -- Prolog's float. Tensors compute
;;;; in float32 as libtorch prefers; the conversion happens in tensors,
;;;; not element by element.
;;;;
;;;; TWO EXECUTION PATHS, ONE SET OF PREDICATES. Under tensor_execution(eager),
;;;; the default, a producer computes and adopts, as it always did. Under
;;;; tensor_execution(graph) it RECORDS a node -- the producer, its arguments,
;;;; its inputs BY POINTER, and a shape and dtype worked out on the meta
;;;; device -- and the consumers (tensor_to_list, tensor_item, tensor_reduce,
;;;; the model predicates) force what they read. The same raw workers run
;;;; either way, later. Random leaves execute at once so draws keep their
;;;; order. DESIGN-lazy-graph.md is the contract; test/torch-graph.sh holds
;;;; it to equality against eager.
;;;;
;;;; ---- the surface -------------------------------------------------------
;;;;
;;;; A T or an M is a handle, a Shape is a list of integers, and numbers
;;;; cross as floats. README.md beside this file has the layer vocabulary
;;;; and the training options in full.
;;;;
;;;; tensors:
;;;;   tensor_from_list(+List, -T)               numbers -> [N]; rows -> [R,C]
;;;;   tensor_to_list(+T, -List)                 the inverse; a READ under graph
;;;;   tensor_shape(+T, -Shape)                  costs nothing under graph
;;;;   tensor_item(+T, -Number)                  the one element of a one-element tensor
;;;;   tensor_load_csv(+Path, -T)                a rectangle of numbers -> [R,C]
;;;;   tensor_new(+Shape, +Kind, -T)             zeros ones randn rand
;;;;   tensor_zeros(+Shape, -T)
;;;;   tensor_ones(+Shape, -T)
;;;;   tensor_randn(+Shape, -T)
;;;;   tensor_rand(+Shape, -T)
;;;;   tensor_full(+Shape, +Value, -T)
;;;;   tensor_eye(+N, -T)
;;;;   tensor_arange(+N, -T)
;;;;   tensor_randperm(+N, -T)
;;;;   tensor_rows(+T, +From, +To, -T2)          rows [From, To)
;;;;   tensor_cols(+T, +From, +To, -T2)          columns [From, To)
;;;;   tensor_standardise(+T, +NTrain, -T2)      per column, from the first NTrain rows ONLY
;;;;   tensor_train_test(+T, +NTrain, -Train, -Test)
;;;;   tensor_reshape(+T, +Shape, -T2)
;;;;   tensor_cat(+Ts, +Dim, -T2)
;;;;   tensor_index_rows(+T, +IndexT, -T2)       rows picked by an index tensor
;;;;   tensor_argmax(+T, +Dim, -T2)
;;;;   tensor_free(+T)
;;;;
;;;; operations -- four generics, and the names spelled over them:
;;;;   tensor_unary(+Op, +T, -T2)                neg abs exp log sqrt relu sigmoid tanh transpose
;;;;   tensor_binary(+Op, +A, +B, -C)            add sub mul div matmul
;;;;   tensor_scalar(+Op, +A, +Value, -C)        add sub mul div pow
;;;;   tensor_reduce(+Op, +T, -Number)           sum mean max min std, over everything
;;;;   tensor_neg(+T, -T2)
;;;;   tensor_abs(+T, -T2)
;;;;   tensor_exp(+T, -T2)
;;;;   tensor_log(+T, -T2)
;;;;   tensor_sqrt(+T, -T2)
;;;;   tensor_relu(+T, -T2)
;;;;   tensor_sigmoid(+T, -T2)
;;;;   tensor_tanh(+T, -T2)
;;;;   tensor_transpose(+T, -T2)
;;;;   tensor_add(+A, +B, -C)
;;;;   tensor_sub(+A, +B, -C)
;;;;   tensor_mul(+A, +B, -C)
;;;;   tensor_div(+A, +B, -C)
;;;;   tensor_matmul(+A, +B, -C)
;;;;   tensor_sum(+T, -Number)
;;;;   tensor_mean(+T, -Number)
;;;;   tensor_max(+T, -Number)
;;;;   tensor_min(+T, -Number)
;;;;   tensor_std(+T, -Number)
;;;;
;;;; the two paths, and autograd through what was recorded:
;;;;   tensor_execution(?Mode)                   eager | graph; unbound asks
;;;;   tensor_execution(?Backend, ?Mode)         torch | tensorflow, and the mode
;;;;   tensor_execution(?Backend, ?Mode, ?Device)   and cpu | cuda | auto
;;;;   tensor_parameter(+T0, -P)                 a fresh leaf that requires grad; T0 untouched
;;;;   tensor_agg(+Op, +T, -T2)                  sum mean max min std, as a ONE-ELEMENT tensor
;;;;   tensor_grad(+Loss, +Params, -Grads)       d Loss / d each parameter, in order
;;;;   tensor_step(+P, +G, +LR, -P2)             P - LR*G as a new leaf; P is not mutated
;;;;   tensor_force(+T)                          execute what T depends on, now
;;;;   tensor_graph_stats(-Stats)                stats(recorded(N), executed(M), replayed(R), pending(P))
;;;;
;;;; models:
;;;;   model_new(+Spec, -M)                      the layer list; the shape flows down it
;;;;   model_train(+M, +X, +Y, +Options)         epochs batch lr optimiser loss shuffle schedule final_loss
;;;;   model_predict(+M, +X, -T)                 forward, gradients off
;;;;   model_evaluate(+M, +X, +Y, +Metric, -Score)   rmse | accuracy | mae
;;;;   model_spec(+M, -Spec)                     the architecture back as terms
;;;;   model_params(+M, -Floats)                 parameters AND buffers, flat
;;;;   model_set_params(+M, +Floats)             the inverse
;;;;   model_save(+Name, +M)                     spec and params into the knowledge base
;;;;   model_load(+Name, -M)                     and back, onto whatever device is current
;;;;   model_free(+M)
;;;;
;;;; the device, and the seed:
;;;;   torch_device(+D)                          cpu | cuda | cuda(N) | auto; governs the NEXT model_new
;;;;   torch_current_device(-D)                  cpu or cuda(N)
;;;;   torch_cuda_available(-Bool)
;;;;   torch_cuda_count(-N)
;;;;   torch_seed(+N)                            libtorch's manual seed
;;;;   torch_execution(?Mode)                    tensor_execution/1 under its first name

;;; A METHOD CALL AS A CONDITION goes through `bool?': the emitter takes a
;;; bare (($ t is_cuda)) in an `if' for a construct, and (not (not ...)) is
;;; the same truth written as an expression it does read.
(DEFMACRO bool? (x) `(not (not ,x)))

(source "coco-torch.cpp"
  ;; COMPILED BY build.sh, NOT BY CICILI, now that this is a LOADABLE
  ;; module: what has to come out is a shared object linked against
  ;; libtorch, and the flags for that belong beside the module. Cicili's
  ;; {$TORCH_*} tokens still resolve the include paths for the transpile;
  ;; the script asks python for the same directory when it links.
  (make :cpp #t :compile #f)

  (include <torch/torch.h>)
  (include <cstdio>)
  (include <cstdint>)
  (include <cstring>)
  (include <cstdlib>)
  (include <string>)
  (include <exception>)
  (include <memory>)
  (include <vector>)
  (include <map>)
  (include <algorithm>)
  (include <cmath>)

  (import "lib/cpp/torch/torch.cicili")

  (decl) (struct std::exception
           (const) (method what () (out (const char *))))

  ;; ---- the slice of cocolog this module is written against ----------

  (decl) (struct coco_engine)
  (decl) (struct coco_machine)

  ;; THE LINKAGE, FIRST AND RAW. These are C names; this block is their
  ;; real declaration for the C++ compiler. The Cicili decls after it
  ;; emit plain prototypes -- and C++ gives a redeclaration the linkage
  ;; of the first one it saw, which is why this block comes first.
  (code "extern \"C\" {")
  (code "int coco_module_register(const char*, int (*)(struct coco_engine*, const char*, uint32_t, size_t, int*), const char*, int (*)(struct coco_engine*));")
  (code "size_t coco_m_arg(struct coco_engine*, size_t, uint32_t);")
  (code "struct coco_machine* coco_m_machine(struct coco_engine*);")
  (code "int coco_m_is_atom(struct coco_engine*, size_t);")
  (code "const char* coco_m_atom(struct coco_engine*, size_t);")
  (code "int coco_m_int(struct coco_engine*, size_t, int64_t*); int coco_m_float(struct coco_engine*, size_t, double*);")
  (code "int coco_m_text(struct coco_engine*, size_t, char*, size_t);")
  (code "int coco_m_unify(struct coco_engine*, size_t, size_t);")
  (code "int coco_m_unify_int(struct coco_engine*, size_t, int64_t); int coco_m_unify_float(struct coco_engine*, size_t, double);")
  (code "size_t coco_m_list(struct coco_engine*, const size_t*, size_t);")
  (code "int coco_m_list_array(struct coco_engine*, size_t, size_t**, size_t*);")
  (code "int coco_m_type_error(struct coco_engine*, const char*, size_t); int coco_m_domain_error(struct coco_engine*, const char*, size_t);")
  (code "size_t coco_deref(struct coco_machine*, size_t); int coco_is_callable(struct coco_machine*, size_t);")
  (code "int coco_m_tensor_put(struct coco_engine*, const char*, int64_t, const double*, uint32_t);")
  (code "int coco_m_tensor_row(struct coco_engine*, const char*, int64_t, double*, uint32_t, uint32_t*);")
  (code "int coco_m_tensor_forget(struct coco_engine*, const char*);")
  (code "uint32_t coco_arity(struct coco_machine*, size_t); uint64_t coco_name_of(struct coco_machine*, size_t);")
  (code "const char* coco_atom_name(struct coco_machine*, uint64_t); size_t coco_arg(struct coco_machine*, size_t, uint32_t);")
  (code "size_t coco_new_float(struct coco_machine*, double); size_t coco_new_int(struct coco_machine*, int64_t);")
  (code "size_t coco_make1(struct coco_machine*, const char*, size_t); size_t coco_make2(struct coco_machine*, const char*, size_t, size_t);")
  (code "size_t coco_make(struct coco_machine*, const char*, uint32_t, const size_t*);")
  (code "size_t coco_new_atom(struct coco_machine*, const char*);")
  (code "}")

  (decl) (func coco_module_register ((const char * name)
                                     (func dispatch ((coco_engine * e) (const char * nm)
                                                     (uint32_t arity) (size_t g)
                                                     (int * found)) (out int))
                                     (const char * prolog)
                                     (func init ((coco_engine * e)) (out int))) (out int))
  (decl) (func coco_m_arg ((coco_engine * e) (size_t g) (uint32_t i)) (out size_t))
  (decl) (func coco_m_machine ((coco_engine * e)) (out coco_machine *))
  (decl) (func coco_m_is_atom ((coco_engine * e) (size_t t)) (out int))
  (decl) (func coco_m_atom ((coco_engine * e) (size_t t)) (out const char *))
  (decl) (func coco_m_int ((coco_engine * e) (size_t t) (int64_t * out)) (out int))
  (decl) (func coco_m_float ((coco_engine * e) (size_t t) (double * out)) (out int))
  (decl) (func coco_m_tensor_put ((coco_engine * e) (const char * name) (int64_t seq)
                                  (const double * v) (uint32_t n)) (out int))
  (decl) (func coco_m_tensor_row ((coco_engine * e) (const char * name) (int64_t seq)
                                  (double * out) (uint32_t cap) (uint32_t * n)) (out int))
  (decl) (func coco_m_tensor_forget ((coco_engine * e) (const char * name)) (out int))
  (decl) (func coco_m_text ((coco_engine * e) (size_t t) (char * buf) (size_t cap)) (out int))
  (decl) (func coco_m_unify ((coco_engine * e) (size_t t) (size_t u)) (out int))
  (decl) (func coco_m_unify_int ((coco_engine * e) (size_t t) (int64_t v)) (out int))
  (decl) (func coco_m_unify_float ((coco_engine * e) (size_t t) (double v)) (out int))
  (decl) (func coco_m_list ((coco_engine * e) (const size_t * items) (size_t n)) (out size_t))
  (decl) (func coco_m_list_array ((coco_engine * e) (size_t t) (size_t ** out)
                                  (size_t * n)) (out int))
  (decl) (func coco_m_type_error ((coco_engine * e) (const char * type)
                                  (size_t culprit)) (out int))
  (decl) (func coco_m_domain_error ((coco_engine * e) (const char * domain)
                                    (size_t culprit)) (out int))
  (decl) (func coco_deref ((coco_machine * m) (size_t t)) (out size_t))
  (decl) (func coco_is_callable ((coco_machine * m) (size_t t)) (out int))
  (decl) (func coco_arity ((coco_machine * m) (size_t t)) (out uint32_t))
  (decl) (func coco_name_of ((coco_machine * m) (size_t t)) (out uint64_t))
  (decl) (func coco_atom_name ((coco_machine * m) (uint64_t id)) (out const char *))
  (decl) (func coco_arg ((coco_machine * m) (size_t t) (uint32_t i)) (out size_t))
  (decl) (func coco_new_float ((coco_machine * m) (double v)) (out size_t))
  (decl) (func coco_new_int ((coco_machine * m) (int64_t v)) (out size_t))
  (decl) (func coco_make1 ((coco_machine * m) (const char * name) (size_t a)) (out size_t))
  (decl) (func coco_make2 ((coco_machine * m) (const char * name) (size_t a) (size_t b)) (out size_t))
  (decl) (func coco_make ((coco_machine * m) (const char * name) (uint32_t n)
                          (const size_t * args)) (out size_t))
  (decl) (func coco_new_atom ((coco_machine * m) (const char * name)) (out size_t))



  ;; THE DEVICE IS MODULE STATE, chosen once and honoured everywhere: a
  ;; model is built on it, training and prediction move their batches to
  ;; the MODEL's device, and every answer comes back to the CPU -- so
  ;; the tensor handles Prolog holds are always CPU tensors and the term
  ;; seam never knows which silicon did the work. model_params travels
  ;; through the CPU too, which is what lets a model train on one
  ;; device, save into Zigurat, and load onto another.
  ;; ---- the device -----------------------------------------------------
  ;; ONE LANGUAGE, ONE TARGET: this is a :cpp target and everything below
  ;; is Cicili clauses over the declarations in cicili/lib/cpp/torch -- a
  ;; layer is ((-> m forward) x), a node is a std::shared_ptr<CtNode>, a
  ;; guard is a letin* -- and the C++ compiler sees ordinary C++ against
  ;; <torch/torch.h>. What was a raw block behind a seam of declared
  ;; functions is the same functions, written in the language of the file.
  (static) (var torch::Device ct_device . #'(torch::Device torch::kCPU))
  (func ct_cuda_available () (out int) (return (? (bool? (torch::cuda::is_available)) 1 0)))
  (func ct_cuda_count () (out llong) (return (cast llong (torch::cuda::device_count))))
  (func ct_current_device ((llong * index)) (out int)
    (set (cof index) (? (bool? (($ ct_device has_index))) (cast llong (($ ct_device index))) 0))
    (return (? (bool? (($ ct_device is_cuda))) 1 0)))
  (func ct_set_device ((int kind) (llong index)) (out int)
    (if (== kind 0) (block (set ct_device (torch::Device torch::kCPU)) (return 1)))
    ;; kind 2 is the device `cuda' names: the first one, or the CPU when there is none
    (if (== kind 2)
        (block
          (if (bool? (torch::cuda::is_available))
              (set ct_device (torch::Device torch::kCUDA 0))
              (set ct_device (torch::Device torch::kCPU)))
          (return 1)))
    (if (not (torch::cuda::is_available)) (return 0))
    (if (>= index (cast llong (torch::cuda::device_count))) (return 0))
    (set ct_device (torch::Device torch::kCUDA (cast i8 index)))
    (return 1))

  ;; ---- the model: a layer list, and a Module built from it -------------
  ;; kind: 0 input(N)  1 image(C,H,W)  2 dense(W,act)
  ;;       3 conv(F,K,act,pad,stride)  4 pool(K,pad,stride)
  ;;       5 flatten  6 dropout(f)  7 norm
  ;;       8 sequence(L)  9 embedding(V,D)  10 lstm(H) (s=1: take the last step)
  ;;       11 attention(H)  12 ffn(W)  13 positional   -- s=1 on any of the
  ;;       three means the same thing it means on the lstm: hand the dense
  ;;       head the LAST position rather than the whole sequence.
  ;; A transformer block carries its own residual, because forward below is a
  ;; linear chain with no branching: there is nowhere to hold x while a side
  ;; path computes f(x). So `x = x + f(LN(x))' happens INSIDE one case.
  (struct CtLayer
    (member int kind) (member int act)
    (member llong a) (member llong b) (member llong c) (member llong s) (member llong d)
    (member double f))
  (struct CtAttn
    (member torch::nn::LayerNorm ln)
    (member torch::nn::Linear q) (member torch::nn::Linear k) (member torch::nn::Linear v) (member torch::nn::Linear o)
    ;; an EMPTY holder is built from nullptr, not from a null pointer of some
    ;; other type: nullptr_t is what ModuleHolder's empty constructor takes
    (ctor () (init (ln (static-cast std::nullptr_t 0)) (q (static-cast std::nullptr_t 0)) (k (static-cast std::nullptr_t 0))
                   (v (static-cast std::nullptr_t 0)) (o (static-cast std::nullptr_t 0)))))
  (struct CtFfn
    (member torch::nn::LayerNorm ln)
    (member torch::nn::Linear w1) (member torch::nn::Linear w2)
    (ctor () (init (ln (static-cast std::nullptr_t 0)) (w1 (static-cast std::nullptr_t 0)) (w2 (static-cast std::nullptr_t 0)))))

  ;; THE CONTAINERS, DECLARED: a member reached through `$' must have a type
  ;; Cicili knows, and a template-id is a type of its own -- so each vector
  ;; and pointer type the structs below hold is named once here. In a target
  ;; a `(decl) (struct ...)' of a template-id emits nothing.
  (decl) (struct CtNode)
  (decl) (struct (t<> std::shared_ptr CtNode))
  (decl) (struct (t<> std::vector (t<> std::shared_ptr CtNode)))
  (decl) (struct (t<> std::vector i64))
  (decl) (struct (t<> std::vector CtLayer))
  (decl) (struct (t<> std::vector CtAttn))
  (decl) (struct (t<> std::vector CtFfn))
  (decl) (struct (t<> std::vector torch::nn::Linear))
  (decl) (struct (t<> std::vector torch::nn::Conv2d))
  (decl) (struct (t<> std::vector torch::nn::Dropout))
  (decl) (struct (t<> std::vector torch::nn::BatchNorm2d))
  (decl) (struct (t<> std::vector torch::nn::Embedding))
  (decl) (struct (t<> std::vector torch::nn::LSTM))
  (decl) (struct CtNet)
  (decl) (func ct_layer_forward ((CtNet * net) (const CtLayer & L) (torch::Tensor x)) (out torch::Tensor))
  (struct CtNet (inherits torch::nn::Module)
    (member (t<> std::vector CtLayer) spec)
    (member (t<> std::vector torch::nn::Linear) fc)
    (member (t<> std::vector torch::nn::Conv2d) cv)
    (member (t<> std::vector torch::nn::Dropout) dp)
    (member (t<> std::vector torch::nn::BatchNorm2d) bn)
    (member (t<> std::vector torch::nn::Embedding) em)
    (member (t<> std::vector torch::nn::LSTM) ls)
    (member (t<> std::vector CtAttn) at)
    (member (t<> std::vector CtFfn) ff)
    (member llong in_c) (member llong in_h) (member llong in_w)   ; image input, or 0
    (member llong in_n)                                           ; flat input width
    (member llong in_seq)                                         ; sequence input length, or 0
    (member int seq_ids)                                          ; the steps are token ids (an embedding leads)
    (member torch::Device dev)
    (ctor () (init (in_c 0) (in_h 0) (in_w 0) (in_n 0) (in_seq 0) (seq_ids 0) (dev (torch::Device torch::kCPU))))
    (method shape_in ((const torch::Tensor & x)) (out torch::Tensor)
      (if (> ($ this in_c) 0) (return (($ x view) (dims -1 ($ this in_c) ($ this in_h) ($ this in_w)))))
      ;; A sequence row is L steps: token ids stay [N, L] for the embedding
      ;; to widen, plain numbers become [N, L, 1] for the lstm to read.
      (if (> ($ this in_seq) 0)
          (let ((torch::Tensor v . #'(($ x view) (dims -1 ($ this in_seq)))))
            (if ($ this seq_ids) (return v))
            (return (($ v view) (dims -1 ($ this in_seq) 1)))))
      (return x))
    (method forward ((torch::Tensor x)) (out torch::Tensor)
      (for ((size_t i . 0)) (< i (($ this spec size))) ((++ i))
        (let ((CtLayer L . #'(($ this spec at) i)))
          (set x (ct_layer_forward this L x))
          (cond
            ((== ($ L act) 1) (set x (torch::relu x)))
            ((== ($ L act) 2) (set x (torch::tanh x)))
            ((== ($ L act) 3) (set x (torch::sigmoid x)))
            ((== ($ L act) 4) (set x (torch::log_softmax x 1))))))
      (return x)))

  ;; the last position of a sequence, for the dense head that follows it
  (static) (func ct_last_step ((const torch::Tensor & x)) (out torch::Tensor)
    (return (($ x select) 1 (- (($ x size) 1) 1))))

  ;; Pre-norm causal self-attention, multi-head, with the residual.
  (static) (func ct_attention ((CtAttn & B) (llong heads) (torch::Tensor x)) (out torch::Tensor)
    (let ((torch::Tensor h . #'((-> ($ B ln) forward) x)))
      (let ((llong N . #'(($ h size) 0)) (llong T . #'(($ h size) 1)) (llong D . #'(($ h size) 2)))
        (let ((llong HD . #'(/ D heads)))
          (let ((torch::Tensor q . #'(($ (($ ((-> ($ B q) forward) h) view) (dims N T heads HD)) transpose) 1 2))
                (torch::Tensor k . #'(($ (($ ((-> ($ B k) forward) h) view) (dims N T heads HD)) transpose) 1 2))
                (torch::Tensor v . #'(($ (($ ((-> ($ B v) forward) h) view) (dims N T heads HD)) transpose) 1 2)))
            (let ((torch::Tensor a . #'(torch::matmul q (($ k transpose) -2 -1))))
              (set a (/ a (std::sqrt (cast double HD))))
              ;; THE MASK ORIENTATION IS THE WHOLE THING. triu(1) is the strict upper
              ;; triangle -- the entries where the key index exceeds the query index,
              ;; i.e. the FUTURE. Those are the ones filled with -inf. Get this
              ;; backwards and the model reads the answer off the next character: it
              ;; scores beautifully and has learned nothing you can use.
              (let ((torch::TensorOptions bo . #'(($ (($ (torch::TensorOptions) dtype) torch::kBool) device) (($ a device)))))
                (let ((torch::Tensor m . #'(($ (torch::ones (dims T T) bo) triu) 1)))
                  (set a (($ a masked_fill) m -1e9))
                  (set a (torch::softmax a -1))
                  (let ((torch::Tensor y . #'(torch::matmul a v)))
                    (set y (($ (($ (($ y transpose) 1 2) contiguous)) view) (dims N T D)))
                    (return (+ x ((-> ($ B o) forward) y))))))))))))

  ;; Pre-norm feed-forward, with the residual. GELU because that is what a
  ;; transformer block uses; relu would also train.
  (static) (func ct_ffn ((CtFfn & B) (torch::Tensor x)) (out torch::Tensor)
    (let ((torch::Tensor h . #'((-> ($ B ln) forward) x)))
      (set h (torch::gelu ((-> ($ B w1) forward) h)))
      (return (+ x ((-> ($ B w2) forward) h)))))

  ;; A LEARNED position embedding, added to every row. Learned rather than
  ;; sinusoidal on purpose: it reuses the Embedding this file already
  ;; registers, so it needs no new module type and no trigonometry.
  (static) (func ct_positional ((torch::nn::Embedding & m) (torch::Tensor x)) (out torch::Tensor)
    (let ((torch::TensorOptions po . #'(($ (($ (torch::TensorOptions) dtype) torch::kLong) device) (($ x device)))))
      (let ((torch::Tensor p . #'(torch::arange (($ x size) 1) po)))
        (return (+ x (($ ((-> m forward) p) unsqueeze) 0))))))

  ;; one layer of the chain; a sequence layer marked s=1 hands on its last step
  (func ct_layer_forward ((CtNet * net) (const CtLayer & L) (torch::Tensor x)) (out torch::Tensor)
    (cond
      ((== ($ L kind) 2)
       (let ((torch::nn::Linear & m . #'(($ (cof net) fc at) (cast size_t ($ L d))))) (return ((-> m forward) x))))
      ((== ($ L kind) 3)
       (let ((torch::nn::Conv2d & m . #'(($ (cof net) cv at) (cast size_t ($ L d))))) (return ((-> m forward) x))))
      ((== ($ L kind) 4)
       (return (torch::max_pool2d x (dims ($ L a) ($ L a)) (dims ($ L c) ($ L c)) (dims ($ L b) ($ L b)))))
      ((== ($ L kind) 5) (return (($ x flatten) 1)))
      ((== ($ L kind) 6)
       (let ((torch::nn::Dropout & m . #'(($ (cof net) dp at) (cast size_t ($ L d))))) (return ((-> m forward) x))))
      ((== ($ L kind) 7)
       (let ((torch::nn::BatchNorm2d & m . #'(($ (cof net) bn at) (cast size_t ($ L d))))) (return ((-> m forward) x))))
      ((== ($ L kind) 9)
       (let ((torch::nn::Embedding & m . #'(($ (cof net) em at) (cast size_t ($ L d))))) (return ((-> m forward) (($ x to) torch::kLong)))))
      ((== ($ L kind) 10)
       (let ((torch::nn::LSTM & m . #'(($ (cof net) ls at) (cast size_t ($ L d)))))
         (let ((auto r . #'((-> m forward) x)))
           (set x ((t<> std::get 0) r))
           ;; the dense head reads the LAST step; a stacked lstm reads them all
           (if (== ($ L s) 1) (return (ct_last_step x)))
           (return x))))
      ((== ($ L kind) 11)
       (let ((CtAttn & B . #'(($ (cof net) at at) (cast size_t ($ L d)))))
         (set x (ct_attention B ($ L a) x))
         (if (== ($ L s) 1) (return (ct_last_step x)))
         (return x)))
      ((== ($ L kind) 12)
       (let ((CtFfn & B . #'(($ (cof net) ff at) (cast size_t ($ L d)))))
         (set x (ct_ffn B x))
         (if (== ($ L s) 1) (return (ct_last_step x)))
         (return x)))
      ((== ($ L kind) 13)
       (let ((torch::nn::Embedding & m . #'(($ (cof net) em at) (cast size_t ($ L d)))))
         (set x (ct_positional m x))
         (if (== ($ L s) 1) (return (ct_last_step x)))
         (return x)))
      (#t (return x))))

  ;; a 0-d tensor's value, as the double the engine speaks
  (static) (func ct_item ((const torch::Tensor & t)) (out double)
    (return (cast double (($ t (t<> item float))))))

  (static) (var char ctnet_errbuf [256])
  (func ctnet_error () (out const char *) (return ctnet_errbuf))
  (func ctnet_fail ((const char * what)) (out int)
    (snprintf ctnet_errbuf 256 "%s" what)
    (return 0))

  ;; THE SHAPE FLOWS DOWN THE LIST, worked out here so a mismatch cannot be
  ;; built -- the same arithmetic the DSL runs at expansion time:
  ;;   out = floor((in + 2*pad - kernel) / stride) + 1
  (func ctnet_create ((const llong * enc) (const double * fenc) (int n)) (out CtNet *)
    (set (nth 0 ctnet_errbuf) 0)
    (if (< n 2) (block (ctnet_fail "a model is an input and at least one layer") (return nil)))
    (let ((CtNet * net . #'(new* CtNet))
          (int image . 0) (llong C . 0) (llong H . 0) (llong W . 0) (llong flat . 0)
          (int seq . 0) (llong feat . 0) (int reg . 0))
      (for ((int i . 0)) (< i n) ((++ i))
        (let ((CtLayer L) (char label [16]) (char lb [24]))
          (set ($ L kind) (cast int (nth (* i 8) enc)))
          (set ($ L act) (cast int (nth (+ (* i 8) 1) enc)))
          (set ($ L a) (nth (+ (* i 8) 2) enc))
          (set ($ L b) (nth (+ (* i 8) 3) enc))
          (set ($ L c) (nth (+ (* i 8) 4) enc))
          (set ($ L s) (nth (+ (* i 8) 5) enc))
          (set ($ L d) 0)
          (set ($ L f) (nth i fenc))
          (snprintf label 16 "m%d" reg)
          (cond
            ((== ($ L kind) 0)
             (if (!= i 0) (block (ctnet_fail "input(N) must come first") (delete* net) (return nil)))
             (set flat ($ L a)) (set (-> net in_n) flat) (set image 0))
            ((== ($ L kind) 1)
             (if (!= i 0) (block (ctnet_fail "image(C,H,W) must come first") (delete* net) (return nil)))
             (set C ($ L a)) (set H ($ L b)) (set W ($ L c)) (set image 1)
             (set (-> net in_c) C) (set (-> net in_h) H) (set (-> net in_w) W))
            ((== ($ L kind) 2)
             (if image (block (ctnet_fail "dense needs a flat input; add (flatten)") (delete* net) (return nil)))
             (if seq
                 ;; a sequence reaches its dense head through an lstm, whose last
                 ;; step becomes the flat input -- marked on the lstm layer itself
                 (let ((int pk . #'(? (bool? (($ (cof net) spec empty))) -1 ($ (($ (cof net) spec back)) kind))))
                   (if (and (!= pk 10) (and (!= pk 11) (and (!= pk 12) (!= pk 13))))
                       (block (ctnet_fail "dense after a sequence needs an lstm or a transformer block before it")
                              (delete* net) (return nil)))
                   (set ($ (($ (cof net) spec back)) s) 1)
                   (set seq 0) (set flat feat)))
             (set ($ L d) (cast llong (($ (cof net) fc size))))
             (($ (cof net) fc push_back) ((-> net register_module) (std::string label) (torch::nn::Linear flat ($ L a))))
             (set flat ($ L a)) (set reg (+ reg 1)))
            ((== ($ L kind) 3)
             (if (not image) (block (ctnet_fail "conv needs an image input") (delete* net) (return nil)))
             (let ((llong F . #'($ L a)) (llong K . #'($ L b)) (llong P . #'($ L c)) (llong S . #'($ L s)))
               (set ($ L d) (cast llong (($ (cof net) cv size))))
               (($ (cof net) cv push_back)
                ((-> net register_module) (std::string label)
                 (torch::nn::Conv2d (($ (($ (torch::nn::Conv2dOptions C F K) padding) (dims P P)) stride) (dims S S)))))
               (set C F)
               (set H (+ (/ (- (+ H (* 2 P)) K) S) 1))
               (set W (+ (/ (- (+ W (* 2 P)) K) S) 1))
               (if (or (< H 1) (< W 1)) (block (ctnet_fail "the picture shrank away inside conv") (delete* net) (return nil)))
               (set reg (+ reg 1))))
            ((== ($ L kind) 4)
             (if (not image) (block (ctnet_fail "pool needs an image input") (delete* net) (return nil)))
             (let ((llong K . #'($ L a)) (llong P . #'($ L b)) (llong S . #'($ L c)))
               (set H (+ (/ (- (+ H (* 2 P)) K) S) 1))
               (set W (+ (/ (- (+ W (* 2 P)) K) S) 1))
               (if (or (< H 1) (< W 1)) (block (ctnet_fail "the picture shrank away inside pool") (delete* net) (return nil)))))
            ((== ($ L kind) 5)
             (if (not image) (block (ctnet_fail "flatten needs an image to flatten") (delete* net) (return nil)))
             (set flat (* (* C H) W)) (set image 0))
            ((== ($ L kind) 6)
             (set ($ L d) (cast llong (($ (cof net) dp size))))
             (($ (cof net) dp push_back) ((-> net register_module) (std::string label) (torch::nn::Dropout ($ L f))))
             (set reg (+ reg 1)))
            ((== ($ L kind) 7)
             (if (not image) (block (ctnet_fail "norm is BatchNorm2d and needs an image") (delete* net) (return nil)))
             (set ($ L d) (cast llong (($ (cof net) bn size))))
             (($ (cof net) bn push_back) ((-> net register_module) (std::string label) (torch::nn::BatchNorm2d C)))
             (set reg (+ reg 1)))
            ((== ($ L kind) 8)
             (if (!= i 0) (block (ctnet_fail "sequence(L) must come first") (delete* net) (return nil)))
             (set seq 1) (set feat 1) (set (-> net in_seq) ($ L a)) (set image 0))
            ((== ($ L kind) 9)
             (if (not (and seq (== i 1))) (block (ctnet_fail "embedding follows sequence(L) directly") (delete* net) (return nil)))
             (set (-> net seq_ids) 1) (set feat ($ L b))
             (set ($ L d) (cast llong (($ (cof net) em size))))
             (($ (cof net) em push_back) ((-> net register_module) (std::string label) (torch::nn::Embedding ($ L a) ($ L b))))
             (set reg (+ reg 1)))
            ((== ($ L kind) 10)
             (if (not seq) (block (ctnet_fail "lstm needs a sequence input") (delete* net) (return nil)))
             (set ($ L d) (cast llong (($ (cof net) ls size))))
             (($ (cof net) ls push_back)
              ((-> net register_module) (std::string label)
               (torch::nn::LSTM (($ (torch::nn::LSTMOptions feat ($ L a)) batch_first) true))))
             (set feat ($ L a)) (set reg (+ reg 1)))
            ((== ($ L kind) 11)
             (if (not seq) (block (ctnet_fail "attention needs a sequence input") (delete* net) (return nil)))
             (if (or (< ($ L a) 1) (!= 0 (% feat ($ L a))))
                 (block (ctnet_fail "attention(H): the width reaching it must divide by H") (delete* net) (return nil)))
             (let ((CtAttn B))
               (snprintf lb 24 "a%dn" reg)
               (set ($ B ln) ((-> net register_module) (std::string lb)
                              (torch::nn::LayerNorm (torch::nn::LayerNormOptions ((t<> std::vector i64) 1 (cast i64 feat))))))
               (snprintf lb 24 "a%dq" reg)
               (set ($ B q) ((-> net register_module) (std::string lb) (torch::nn::Linear feat feat)))
               (snprintf lb 24 "a%dk" reg)
               (set ($ B k) ((-> net register_module) (std::string lb) (torch::nn::Linear feat feat)))
               (snprintf lb 24 "a%dv" reg)
               (set ($ B v) ((-> net register_module) (std::string lb) (torch::nn::Linear feat feat)))
               (snprintf lb 24 "a%do" reg)
               (set ($ B o) ((-> net register_module) (std::string lb) (torch::nn::Linear feat feat)))
               (set ($ L d) (cast llong (($ (cof net) at size))))
               (($ (cof net) at push_back) B)
               (set reg (+ reg 1))))
            ((== ($ L kind) 12)
             (if (not seq) (block (ctnet_fail "ffn needs a sequence input") (delete* net) (return nil)))
             (if (< ($ L a) 1) (block (ctnet_fail "ffn(W) wants a positive width") (delete* net) (return nil)))
             (let ((CtFfn B))
               (snprintf lb 24 "f%dn" reg)
               (set ($ B ln) ((-> net register_module) (std::string lb)
                              (torch::nn::LayerNorm (torch::nn::LayerNormOptions ((t<> std::vector i64) 1 (cast i64 feat))))))
               (snprintf lb 24 "f%d1" reg)
               (set ($ B w1) ((-> net register_module) (std::string lb) (torch::nn::Linear feat ($ L a))))
               (snprintf lb 24 "f%d2" reg)
               (set ($ B w2) ((-> net register_module) (std::string lb) (torch::nn::Linear ($ L a) feat)))
               (set ($ L d) (cast llong (($ (cof net) ff size))))
               (($ (cof net) ff push_back) B)
               (set reg (+ reg 1))))
            ((== ($ L kind) 13)
             (if (not seq) (block (ctnet_fail "positional needs a sequence input") (delete* net) (return nil)))
             ;; positional with no argument spans the whole declared sequence
             (if (< ($ L a) 1) (set ($ L a) (-> net in_seq)))
             (set ($ L d) (cast llong (($ (cof net) em size))))
             (($ (cof net) em push_back) ((-> net register_module) (std::string label) (torch::nn::Embedding ($ L a) feat)))
             (set reg (+ reg 1)))
            (#t (ctnet_fail "unknown layer kind") (delete* net) (return nil)))
          (($ (cof net) spec push_back) L)))
      (if image (block (ctnet_fail "the network ends on an image; add (flatten) and a dense head") (delete* net) (return nil)))
      (if seq (block (ctnet_fail "the network ends inside a sequence; add a dense head") (delete* net) (return nil)))
      (set (-> net dev) ct_device)
      ((-> net to) ct_device)
      (return net)))

  (func ctnet_free_raw ((CtNet * net)) (delete* net))
  (func ctnet_nspec ((CtNet * net)) (out int) (return (cast int (($ (cof net) spec size)))))
  (func ctnet_spec_out ((CtNet * net) (llong * enc) (double * fenc))
    (for ((size_t i . 0)) (< i (($ (cof net) spec size))) ((++ i))
      (let ((CtLayer L . #'(($ (cof net) spec at) i)))
        (set (nth (* i 8) enc) ($ L kind))
        (set (nth (+ (* i 8) 1) enc) ($ L act))
        (set (nth (+ (* i 8) 2) enc) ($ L a))
        (set (nth (+ (* i 8) 3) enc) ($ L b))
        (set (nth (+ (* i 8) 4) enc) ($ L c))
        (set (nth (+ (* i 8) 5) enc) ($ L s))
        (set (nth i fenc) ($ L f)))))

  ;; the parameter-and-buffer walk: what persists. Buffers matter -- batch
  ;; norm's running mean and variance are learned by watching, not by
  ;; gradient, and a model saved without them predicts differently.
  (func ctnet_nparams ((CtNet * net)) (out llong)
    (let ((llong total . 0))
      (letin* ((ps ((-> net parameters))) (bs ((-> net buffers))))
        (for ((size_t i . 0)) (< i (($ ps size))) ((++ i)) (set total (+ total (($ (($ ps at) i) numel)))))
        (for ((size_t i . 0)) (< i (($ bs size))) ((++ i)) (set total (+ total (($ (($ bs at) i) numel))))))
      (return total)))
  ;; one tensor's values, as float64 rows, into the buffer at off
  (static) (func ctnet_read_one ((const torch::Tensor & p) (double * out) (llong * off) (llong cap)) (out int)
    (let ((torch::Tensor flat . #'(($ (($ (($ (($ (($ p detach)) cpu)) to) torch::kFloat64) contiguous)) view) (dims -1))))
      (let ((llong n . #'(($ flat numel))))
        (if (> (+ (cof off) n) cap) (return 0))
        (($ (torch::from_blob (+ out (cof off)) (dims n) (torch::dtype torch::kFloat64)) copy_) flat)
        (set (cof off) (+ (cof off) n))
        (return 1))))
  (func ctnet_read_params ((CtNet * net) (double * out) (llong cap)) (out int)
    (let ((llong off . 0))
      (letin* ((ps ((-> net parameters))) (bs ((-> net buffers))))
        (for ((size_t i . 0)) (< i (($ ps size))) ((++ i))
          (if (not (ctnet_read_one (($ ps at) i) out (aof off) cap)) (return 0)))
        (for ((size_t i . 0)) (< i (($ bs size))) ((++ i))
          (if (not (ctnet_read_one (($ bs at) i) out (aof off) cap)) (return 0))))
      (return 1)))
  (static) (func ctnet_write_one ((torch::Tensor & p) (const double * in) (llong * off) (llong n)) (out int)
    (let ((llong pn . #'(($ p numel))))
      (if (> (+ (cof off) pn) n) (return 0))
      (let ((torch::Tensor src . #'(torch::from_blob (+ (cast (double *) in) (cof off)) (dims pn) (torch::dtype torch::kFloat64))))
        (($ p copy_) (($ src view) (($ p sizes))))
        (set (cof off) (+ (cof off) pn))
        (return 1))))
  (func ctnet_write_params ((CtNet * net) (const double * in) (llong n)) (out int)
    (letin* ((guard (torch::NoGradGuard)))
      (let ((llong off . 0))
        (letin* ((ps ((-> net parameters))) (bs ((-> net buffers))))
          (for ((size_t i . 0)) (< i (($ ps size))) ((++ i))
            (if (not (ctnet_write_one (($ ps at) i) in (aof off) n)) (return 0)))
          (for ((size_t i . 0)) (< i (($ bs size))) ((++ i))
            (if (not (ctnet_write_one (($ bs at) i) in (aof off) n)) (return 0))))
        (return (? (== off n) 1 0)))))

  (func ctnet_loss_of ((int loss) (const torch::Tensor & out) (const torch::Tensor & y)) (out torch::Tensor)
    (cond ((== loss 1) (return (torch::nll_loss out y)))
          ((== loss 2) (return (torch::cross_entropy_loss out y)))
          ((== loss 3) (return (torch::binary_cross_entropy out y)))
          (#t (return (torch::mse_loss out y)))))

  ;; the loop the DSL emits, at run time: per epoch one permutation, per
  ;; batch one gather, zero_grad / forward / loss / backward / step; the
  ;; schedule steps per EPOCH -- per batch is the classic way to decay a
  ;; learning rate to nothing inside one pass.
  ;; A FORWARD OVER EVERY ROW AT ONCE IS THE MEMORY, NOT THE LOOP. The final
  ;; loss, an evaluation and a prediction each ran the whole set through the
  ;; net in one call, and a transformer's activations over ninety thousand
  ;; windows of thirty-two are gigabytes: on a 12 GB VM the 180 000-window run
  ;; died there, and a 17 900-window one on a laptop cost 3 GB for one epoch.
  ;; So each walks the rows in chunks under no-grad and folds the results --
  ;; a mean weighted by rows is the mean, a count is a count, and a
  ;; prediction is the chunks concatenated.
  (static) (func ctnet_mean_loss ((CtNet * net) (const torch::Tensor & x) (const torch::Tensor & y) (int loss)) (out double)
    (letin* ((guard (torch::NoGradGuard)))
      (let ((llong n . #'(($ x size) 0)) (double acc . 0.0))
        (for ((llong b . 0)) (< b n) ((set b (+ b 1024)))
          (let ((llong take . #'(? (> (+ b 1024) n) (- n b) 1024)))
            (let ((torch::Tensor l . #'(ctnet_loss_of loss ((-> net forward) (($ x narrow) 0 b take)) (($ y narrow) 0 b take))))
              (set acc (+ acc (* (ct_item l) (cast double take)))))))
        (return (? (> n 0) (/ acc (cast double n)) 0.0)))))
  (static) (func ctnet_forward_all ((CtNet * net) (const torch::Tensor & x)) (out torch::Tensor)
    (letin* ((guard (torch::NoGradGuard)) (parts ((t<> std::vector torch::Tensor))))
      (let ((llong n . #'(($ x size) 0)))
        (for ((llong b . 0)) (< b n) ((set b (+ b 1024)))
          (let ((llong take . #'(? (> (+ b 1024) n) (- n b) 1024)))
            (($ parts push_back) (($ ((-> net forward) (($ x narrow) 0 b take)) detach)))))
        (if (== (($ parts size)) 1) (return (($ parts at) 0)))
        (return (torch::cat parts 0)))))
  (func ctnet_train_raw ((CtNet * net) (const torch::Tensor * xp) (const torch::Tensor * yp)
                         (int epochs) (int batch) (int opt) (double lr) (int loss) (int shuffle)
                         (llong sched_every) (double sched_gamma) (double * final_loss)) (out int)
    (let ((torch::Tensor x . #'(($ (($ ((-> net shape_in) (cof xp)) clone)) to) (-> net dev)))
          (torch::Tensor y . #'(? (or (== loss 1) (== loss 2))
                                  (($ (($ (($ ((-> yp view) (dims -1)) to) torch::kLong) clone)) to) (-> net dev))
                                  (($ ((-> yp clone)) to) (-> net dev))))
          (llong n . #'((-> xp size) 0)))
      (if (< batch 1) (set batch 1))
      (letin* ((o ((t<> std::unique_ptr torch::optim::Optimizer))))
        (if (== opt 1)
            (($ o reset) (new* torch::optim::SGD ((-> net parameters)) lr))
            (($ o reset) (new* torch::optim::Adam ((-> net parameters)) lr)))
        (let ((torch::optim::Optimizer * op . #'(($ o get))))
          ((-> net train) true)
          (for ((int e . 0)) (< e epochs) ((++ e))
            (let ((torch::Tensor perm . #'(($ (? shuffle (torch::randperm n) (($ (torch::arange (cast double n)) to) torch::kLong)) to) (-> net dev))))
              (for ((llong b . 0)) (< b n) ((set b (+ b batch)))
                (let ((llong take . #'(? (> (+ b batch) n) (- n b) batch)))
                  (let ((torch::Tensor idx . #'(($ perm narrow) 0 b take)))
                    (let ((torch::Tensor bx . #'(($ x index_select) 0 idx)) (torch::Tensor by . #'(($ y index_select) 0 idx)))
                      ((-> op zero_grad))
                      (let ((torch::Tensor l . #'(ctnet_loss_of loss ((-> net forward) bx) by)))
                        (($ l backward))
                        ((-> op step)))))))
              (if (and (> sched_every 0) (== 0 (% (+ e 1) sched_every)))
                  (let (((t<> std::vector torch::optim::OptimizerParamGroup) & groups . #'((-> op param_groups))))
                    (for ((size_t gi . 0)) (< gi (($ groups size))) ((++ gi))
                      (let ((torch::optim::OptimizerOptions & go . #'(($ (($ groups at) gi) options))))
                        (($ go set_lr) (* (($ go get_lr)) sched_gamma))))))))
          ((-> net eval))
          (if (!= final_loss nil) (set (cof final_loss) (ctnet_mean_loss net x y loss)))
          (return 1)))))
  (func ctnet_predict_raw ((CtNet * net) (const torch::Tensor * xp)) (out torch::Tensor *)
    (letin* ((guard (torch::NoGradGuard)))
      ((-> net eval))
      (return (new* torch::Tensor (($ (ctnet_forward_all net (($ ((-> net shape_in) (cof xp)) to) (-> net dev))) cpu))))))
  ;; one chunk's contribution to the metric: right answers, absolute error, squared error
  (static) (func ctnet_metric_chunk ((int metric) (const torch::Tensor & out) (const torch::Tensor & yb)) (out double)
    (if (== metric 1)
        (let ((torch::Tensor hits . #'(($ (($ (($ out argmax) 1) eq) yb) to) torch::kFloat32)))
          (return (ct_item (($ hits sum))))))
    (let ((torch::Tensor d . #'(($ out sub) yb)))
      (if (== metric 2) (return (ct_item (($ (($ d abs)) sum)))))
      (return (ct_item (($ (($ d pow) 2) sum))))))
  (func ctnet_eval_raw ((CtNet * net) (const torch::Tensor * xp) (const torch::Tensor * yp)
                        (int metric) (double * out_score)) (out int)
    (letin* ((guard (torch::NoGradGuard)))
      ((-> net eval))
      (let ((torch::Tensor x . #'(($ ((-> net shape_in) (cof xp)) to) (-> net dev)))
            (torch::Tensor y . #'(? (== metric 1)
                                    (($ (($ ((-> yp view) (dims -1)) to) torch::kLong) to) (-> net dev))
                                    ((-> yp to) (-> net dev)))))
        (let ((llong n . #'(($ x size) 0)) (double acc . 0.0))
          (for ((llong b . 0)) (< b n) ((set b (+ b 1024)))
            (let ((llong take . #'(? (> (+ b 1024) n) (- n b) 1024)))
              (set acc (+ acc (ctnet_metric_chunk metric ((-> net forward) (($ x narrow) 0 b take)) (($ y narrow) 0 b take))))))
          (if (== n 0) (block (set (cof out_score) 0.0) (return 1)))
          (cond ((== metric 1) (set (cof out_score) (/ acc (cast double n))))
                ((== metric 2) (set (cof out_score) (/ acc (cast double (* n (/ (($ y numel)) n))))))
                (#t (set (cof out_score) (std::sqrt (/ acc (cast double (($ y numel)))))))))
        (return 1))))

  ;; ---- the tensor operations, one raw worker per family ----------------
  (func ct_unary_raw ((int op) (const torch::Tensor * a)) (out torch::Tensor *)
    (cond ((== op 0) (return (new* torch::Tensor ((-> a neg)))))
          ((== op 1) (return (new* torch::Tensor ((-> a abs)))))
          ((== op 2) (return (new* torch::Tensor ((-> a exp)))))
          ((== op 3) (return (new* torch::Tensor ((-> a log)))))
          ((== op 4) (return (new* torch::Tensor ((-> a sqrt)))))
          ((== op 5) (return (new* torch::Tensor (torch::relu (cof a)))))
          ((== op 6) (return (new* torch::Tensor (torch::sigmoid (cof a)))))
          ((== op 7) (return (new* torch::Tensor (torch::tanh (cof a)))))
          ((== op 8) (return (new* torch::Tensor ((-> a t)))))
          (#t (return nil))))
  (func ct_binary_raw ((int op) (const torch::Tensor * a) (const torch::Tensor * b)) (out torch::Tensor *)
    (cond ((== op 0) (return (new* torch::Tensor ((-> a add) (cof b)))))
          ((== op 1) (return (new* torch::Tensor ((-> a sub) (cof b)))))
          ((== op 2) (return (new* torch::Tensor ((-> a mul) (cof b)))))
          ((== op 3) (return (new* torch::Tensor ((-> a div) (cof b)))))
          ((== op 4) (return (new* torch::Tensor ((-> a matmul) (cof b)))))
          (#t (return nil))))
  (func ct_scalar_raw ((int op) (const torch::Tensor * a) (double v)) (out torch::Tensor *)
    (cond ((== op 0) (return (new* torch::Tensor ((-> a add) v))))
          ((== op 1) (return (new* torch::Tensor ((-> a sub) v))))
          ((== op 2) (return (new* torch::Tensor ((-> a mul) v))))
          ((== op 3) (return (new* torch::Tensor ((-> a div) v))))
          ((== op 4) (return (new* torch::Tensor ((-> a pow) v))))
          (#t (return nil))))
  (func ct_reduce_raw ((int op) (const torch::Tensor * a) (double * out)) (out int)
    (cond ((== op 0) (set (cof out) (ct_item ((-> a sum)))) (return 1))
          ((== op 1) (set (cof out) (ct_item ((-> a mean)))) (return 1))
          ((== op 2) (set (cof out) (ct_item ((-> a max)))) (return 1))
          ((== op 3) (set (cof out) (ct_item ((-> a min)))) (return 1))
          ((== op 4) (set (cof out) (ct_item ((-> a std)))) (return 1))
          (#t (return 0))))
  (func ct_argmax_raw ((const torch::Tensor * a) (llong dim)) (out torch::Tensor *)
    (return (new* torch::Tensor (($ ((-> a argmax) dim) to) torch::kFloat32))))
  (func ct_reshape_raw ((const torch::Tensor * a) (const llong * shape) (int nd)) (out torch::Tensor *)
    (return (new* torch::Tensor ((-> a reshape) (c10::IntArrayRef (cast (const i64 *) shape) (cast size_t nd))))))
  (func ct_cat_raw ((torch::Tensor ** parts) (int n) (llong dim)) (out torch::Tensor *)
    (letin* ((v ((t<> std::vector torch::Tensor))))
      (for ((int i . 0)) (< i n) ((++ i)) (($ v push_back) (cof (nth i parts))))
      (return (new* torch::Tensor (torch::cat v dim)))))
  (func ct_index_rows_raw ((const torch::Tensor * a) (const torch::Tensor * idx)) (out torch::Tensor *)
    (return (new* torch::Tensor ((-> a index_select) 0 (($ ((-> idx view) (dims -1)) to) torch::kLong)))))
  (func ct_factory_raw ((int kind) (const llong * shape) (int nd) (double v)) (out torch::Tensor *)
    (let ((c10::IntArrayRef s . #'(c10::IntArrayRef (cast (const i64 *) shape) (cast size_t nd))))
      (cond ((== kind 0) (return (new* torch::Tensor (torch::zeros s))))
            ((== kind 1) (return (new* torch::Tensor (torch::ones s))))
            ((== kind 2) (return (new* torch::Tensor (torch::randn s))))
            ((== kind 3) (return (new* torch::Tensor (torch::rand s))))
            ((== kind 4) (return (new* torch::Tensor (torch::full s v))))
            (#t (return nil)))))
  (func ct_arange_raw ((llong n)) (out torch::Tensor *) (return (new* torch::Tensor (torch::arange (cast double n)))))
  (func ct_eye_raw ((llong n)) (out torch::Tensor *) (return (new* torch::Tensor (torch::eye n))))
  (func ct_randperm_raw ((llong n)) (out torch::Tensor *) (return (new* torch::Tensor (($ (torch::randperm n) to) torch::kFloat32))))

  ;; ---- the graph path: nodes, recording, forcing ----------------------------
  ;; A handle names a NODE. A value node holds a tensor; a deferred node holds
  ;; its producer, its arguments, its inputs BY POINTER (so tensor_free of an
  ;; input cannot alias a reused slot), and the shape and dtype the meta device
  ;; answered when it was recorded. Forcing runs the same raw workers eager runs.
  (struct CtNode
    (member int prod)                     ; 0 value; producers: 1 unary 2 binary 3 scalar 4 reshape 5 cat
    (member int op)                       ;   6 index_rows 7 argmax 8 factory 9 arange 10 eye 11 narrow 12 standardise
    (member double v) (member llong n) (member llong dim) (member llong from) (member llong len)
    (member (t<> std::vector i64) ishape)
    (member (t<> std::vector (t<> std::shared_ptr CtNode)) ins)
    (member (t<> std::vector i64) shape)
    (member c10::ScalarType dtype)
    (member torch::Tensor value)
    (member int done)
    (ctor () (init (prod 0) (op 0) (v 0.0) (n 0) (dim 0) (from 0) (len 0) (dtype torch::kFloat32) (done 0))))
  (static) (var (t<> std::shared_ptr CtNode) ct_nodes [4096])
  (static) (var int ct_graph_mode . 0)
  (static) (var llong ct_rec . 0)
  (static) (var llong ct_exe . 0)
  (static) (var llong ct_rep . 0)
  (func ct_graph_get () (out int) (return ct_graph_mode))
  (func ct_graph_set ((int m)) (set ct_graph_mode (? m 1 0)))
  (func ct_slot_exists ((llong h)) (out int)
    (return (? (and (> h 0) (and (< h 4096) (!= (($ (nth h ct_nodes) get)) nil))) 1 0)))
  (static) (func ct_slot_new (((t<> std::shared_ptr CtNode) nd)) (out llong)
    (for ((llong i . 1)) (< i 4096) ((++ i))
      (if (== (($ (nth i ct_nodes) get)) nil) (block (set (nth i ct_nodes) nd) (return i))))
    (return 0))
  ;; ---- phase 3: where work runs ---------------------------------------------
  ;; A value lives on the chosen device -- torch_device/1, or the third argument
  ;; of tensor_execution/3 -- and is moved there ONCE: as it is made under eager
  ;; (ct_value_node below), and on either path the first time a node reads it
  ;; after a switch (ct_force_node), so a value made before the switch follows
  ;; it, as it does on the other library. A parameter is re-made as a leaf there
  ;; so it stays a leaf; a value in the MIDDLE of a differentiable expression is
  ;; left where it is, since a copy would cut the tape. ONE CARE, paid for on a
  ;; T4: `cuda' with no index is the same device as `cuda:0', where every tensor
  ;; actually lives, and torch::Device's == says otherwise -- so the test below
  ;; is by type and, only when both name one, by index. With == a parameter
  ;; under `auto' was re-made a fresh leaf at every touch, each result detached,
  ;; and thirty tutorials trained to nothing without one error.
  (static) (func ct_on_device ((const torch::Tensor & t)) (out int)
    (if (!= (($ (($ t device)) type)) (($ ct_device type))) (return 0))
    (if (not (bool? (($ ct_device has_index)))) (return 1))
    (if (not (bool? (($ (($ t device)) has_index)))) (return 1))
    (return (? (== (($ (($ t device)) index)) (($ ct_device index))) 1 0)))
  (static) (func ct_place ((const torch::Tensor & t)) (out torch::Tensor)
    (if (ct_on_device t) (return t))
    (if (bool? (($ t requires_grad)))
        (block
          (if (not (bool? (($ t is_leaf)))) (return t))
          (let ((torch::Tensor u . #'(($ (($ t detach)) to) ct_device)))
            (($ u set_requires_grad) true)
            (return u))))
    (return (($ t to) ct_device)))
  (static) (func ct_value_node ((const torch::Tensor & t0)) (out (t<> std::shared_ptr CtNode))
    (let ((torch::Tensor t . #'(ct_place t0)))   ; an eager value lives on the chosen device
      (let (((t<> std::shared_ptr CtNode) nd . #'((t<> std::make_shared CtNode))))
        (let ((CtNode * p . #'(($ nd get))))
          (set (-> p value) t)
          (set (-> p done) 1)
          (set (-> p dtype) (($ t scalar_type)))
          (let ((c10::IntArrayRef sz . #'(($ t sizes))))
            (for ((size_t i . 0)) (< i (($ sz size))) ((++ i)) (($ (cof p) shape push_back) (nth i sz)))))
        (return nd))))
  (func ct_slot_keep ((const torch::Tensor & t)) (out llong) (return (ct_slot_new (ct_value_node t))))
  (func ct_slot_adopt ((torch::Tensor * t)) (out llong)
    (let ((llong h . #'(ct_slot_new (ct_value_node (cof t)))))
      (delete* t)
      (return h)))
  (func ct_slot_release ((llong h)) (out int)
    (if (not (ct_slot_exists h)) (return 0))
    (($ (nth h ct_nodes) reset))
    (return 1))
  (func ct_slot_shape ((llong h) (llong * out) (int cap)) (out int)
    (if (not (ct_slot_exists h)) (return -1))
    (let ((CtNode * p . #'(($ (nth h ct_nodes) get))))
      (if (> (cast int (($ (cof p) shape size))) cap) (return -1))
      (for ((size_t i . 0)) (< i (($ (cof p) shape size))) ((++ i)) (set (nth i out) (($ (cof p) shape at) i)))
      (return (cast int (($ (cof p) shape size))))))
  ;; the one reduction that stays a TENSOR (0-d), so a loss can be differentiated
  (func ct_agg_raw ((int op) (const torch::Tensor * a)) (out torch::Tensor *)
    (cond ((== op 0) (return (new* torch::Tensor ((-> a sum)))))
          ((== op 1) (return (new* torch::Tensor ((-> a mean)))))
          ((== op 2) (return (new* torch::Tensor ((-> a max)))))
          ((== op 3) (return (new* torch::Tensor ((-> a min)))))
          ((== op 4) (return (new* torch::Tensor ((-> a std)))))
          (#t (return nil))))
  ;; one producer, on its real inputs or on meta stand-ins of them
  (static) (func ct_apply_in ((const CtNode & nd) ((t<> std::vector torch::Tensor) & in) (int meta)) (out torch::Tensor)
    (let ((torch::TensorOptions fo . #'(($ (torch::TensorOptions) dtype) torch::kFloat32)))
      (if meta
          (set fo (($ fo device) torch::kMeta))
          (if (bool? (($ ct_device is_cuda))) (set fo (($ fo device) ct_device))))
      (let ((c10::IntArrayRef ish . #'(c10::IntArrayRef (cast (const i64 *) (($ nd ishape data))) (($ nd ishape size)))))
        ;; Four producers have no meta kernel in every libtorch, and none of them
        ;; can raise a SHAPE error the rule below would miss: elementwise unaries and
        ;; scalar ops keep their input's shape; index_rows swaps dim 0 for the index
        ;; count (a bad index VALUE is found at force, as OOM is -- DESIGN, section 6);
        ;; standardise keeps its shape and refuses a training count past the rows.
        (if meta
            (block
              (if (and (== ($ nd prod) 1) (!= ($ nd op) 8)) (return (torch::empty_like (($ in at) 0))))
              (if (== ($ nd prod) 3) (return (torch::empty_like (($ in at) 0))))
              (if (== ($ nd prod) 14) (return (torch::empty (c10::IntArrayRef) fo)))
              (if (== ($ nd prod) 6)
                  (letin* ((sz ((t<> std::vector i64))))
                    (let ((c10::IntArrayRef s0 . #'(($ (($ in at) 0) sizes))))
                      (for ((size_t i . 0)) (< i (($ s0 size))) ((++ i)) (($ sz push_back) (nth i s0))))
                    (if (bool? (($ sz empty))) (throw* (std::out_of_range (std::to_string (cast long ($ nd prod))))))
                    (set (nth 0 sz) (($ (($ in at) 1) numel)))
                    (return (torch::empty (c10::IntArrayRef sz) (($ (($ in at) 0) options))))))
              (if (== ($ nd prod) 12)
                  (block
                    (if (or (< (($ (($ in at) 0) dim)) 1) (or (< ($ nd n) 0) (> ($ nd n) (($ (($ in at) 0) size) 0))))
                        (throw* (std::out_of_range (std::to_string (cast long ($ nd n))))))
                    (return (torch::empty_like (($ in at) 0)))))))
        (let ((torch::Tensor * r . nil))
          (cond
            ((== ($ nd prod) 1) (set r (ct_unary_raw ($ nd op) (aof (($ in at) 0)))))
            ((== ($ nd prod) 2) (set r (ct_binary_raw ($ nd op) (aof (($ in at) 0)) (aof (($ in at) 1)))))
            ((== ($ nd prod) 3) (set r (ct_scalar_raw ($ nd op) (aof (($ in at) 0)) ($ nd v))))
            ((== ($ nd prod) 4) (set r (ct_reshape_raw (aof (($ in at) 0)) (cast (const llong *) (($ nd ishape data))) (cast int (($ nd ishape size))))))
            ((== ($ nd prod) 5) (set r (new* torch::Tensor (torch::cat in ($ nd dim)))))
            ((== ($ nd prod) 6) (set r (ct_index_rows_raw (aof (($ in at) 0)) (aof (($ in at) 1)))))
            ((== ($ nd prod) 7) (set r (ct_argmax_raw (aof (($ in at) 0)) ($ nd dim))))
            ((== ($ nd prod) 14) (set r (ct_agg_raw ($ nd op) (aof (($ in at) 0)))))
            ((== ($ nd prod) 8)
             (if (== ($ nd op) 0) (return (torch::zeros ish fo)))
             (if (== ($ nd op) 1) (return (torch::ones ish fo)))
             (return (torch::full ish ($ nd v) fo)))
            ((== ($ nd prod) 9) (return (torch::arange (cast double ($ nd n)) fo)))
            ((== ($ nd prod) 10) (return (torch::eye ($ nd n) fo)))
            ((== ($ nd prod) 11) (return (($ (($ (($ in at) 0) narrow) (cast i64 ($ nd dim)) ($ nd from) ($ nd len)) clone))))
            ((== ($ nd prod) 12)
             (let ((torch::Tensor head . #'(($ (($ in at) 0) narrow) 0 0 ($ nd n))))
               (let ((torch::Tensor mu . #'(($ head mean) (dims 0) true))
                     (torch::Tensor sd . #'(($ (($ head std) (dims 0) true true) clamp_min) 1e-7)))
                 (return (($ (($ (($ in at) 0) sub) mu) div) sd))))))
          (if (== r nil) (throw* (std::out_of_range (std::to_string (cast long ($ nd prod))))))
          (let ((torch::Tensor out . #'(cof r)))
            (delete* r)
            (return out))))))
  (static) (func ct_apply ((const CtNode & nd) (int meta)) (out torch::Tensor)
    (letin* ((in ((t<> std::vector torch::Tensor))))
      (for ((size_t i . 0)) (< i (($ nd ins size))) ((++ i))
        (let ((CtNode * p . #'(($ (($ nd ins at) i) get))))
          (if meta
              (($ in push_back) (torch::empty (c10::IntArrayRef (cast (const i64 *) (($ (cof p) shape data))) (($ (cof p) shape size)))
                                              (($ (($ (torch::TensorOptions) dtype) (-> p dtype)) device) torch::kMeta)))
              (($ in push_back) (-> p value)))))
      (return (ct_apply_in nd in meta))))
  ;; ---- phase 3: replay of a recurring forward ---------------------------------
  ;; The closure of a forced node -- its undone nodes in dependency order, and
  ;; the done LEAVES they read -- is keyed by every shape, dtype, producer and
  ;; argument in it. The first time a key is forced it runs plainly; the
  ;; second time it is captured as one CUDA graph over static copies of its
  ;; leaves, then replayed; after that every force with the same key copies the
  ;; new leaf values into those static buffers and replays. A closure with a
  ;; parameter in it is never captured: a replay builds no tape. Compiled in
  ;; only where libtorch_cuda is (build.sh); elsewhere every force is plain.
  (static) (func ct_has (((t<> std::vector (t<> std::shared_ptr CtNode)) & v) (const (t<> std::shared_ptr CtNode) & nd)) (out int)
    (for ((size_t i . 0)) (< i (($ v size))) ((++ i)) (if (== (($ v at) i) nd) (return 1)))
    (return 0))
  (static) (func ct_closure ((const (t<> std::shared_ptr CtNode) & nd)
                             ((t<> std::vector (t<> std::shared_ptr CtNode)) & def)
                             ((t<> std::vector (t<> std::shared_ptr CtNode)) & leaves))
    (let ((CtNode * p . #'(($ nd get))))
      (if (-> p done)
          (if (not (ct_has leaves nd)) (($ leaves push_back) nd))
          (if (not (ct_has def nd))
              (block
                (for ((size_t i . 0)) (< i (($ (cof p) ins size))) ((++ i)) (ct_closure (($ (cof p) ins at) i) def leaves))
                (($ def push_back) nd))))))
  (static) (func ct_key ((const (t<> std::vector (t<> std::shared_ptr CtNode)) & def)
                         (const (t<> std::vector (t<> std::shared_ptr CtNode)) & leaves)) (out std::string)
    (letin* ((k (std::string)))
      (for ((size_t i . 0)) (< i (($ leaves size))) ((++ i))
        (let ((CtNode * lp . #'(($ (($ leaves at) i) get))))
          (set k (+ k (std::string "L")))
          (for ((size_t j . 0)) (< j (($ (cof lp) shape size))) ((++ j))
            (set k (+ (+ k (std::to_string (($ (cof lp) shape at) j))) (std::string ","))))
          (set k (+ (+ (+ k (std::string "/")) (std::to_string (cast int (-> lp dtype)))) (std::string ";")))))
      (for ((size_t i . 0)) (< i (($ def size))) ((++ i))
        (let ((CtNode * np . #'(($ (($ def at) i) get))))
          (set k (+ (+ k (std::string "N")) (std::to_string (-> np prod))))
          (set k (+ (+ k (std::string ":")) (std::to_string (-> np op))))
          (set k (+ (+ k (std::string ":")) (std::to_string (-> np v))))
          (set k (+ (+ k (std::string ":")) (std::to_string (-> np n))))
          (set k (+ (+ k (std::string ":")) (std::to_string (-> np dim))))
          (set k (+ (+ k (std::string ":")) (std::to_string (-> np from))))
          (set k (+ (+ (+ k (std::string ":")) (std::to_string (-> np len))) (std::string ":")))
          (for ((size_t j . 0)) (< j (($ (cof np) ishape size))) ((++ j))
            (set k (+ (+ k (std::to_string (($ (cof np) ishape at) j))) (std::string ","))))
          (set k (+ k (std::string "|")))
          (for ((size_t j . 0)) (< j (($ (cof np) ins size))) ((++ j))
            (let ((llong ix . -1000000))
              (for ((size_t a . 0)) (< a (($ def size))) ((++ a))
                (if (== (($ def at) a) (($ (cof np) ins at) j)) (set ix (cast llong a))))
              (for ((size_t a . 0)) (< a (($ leaves size))) ((++ a))
                (if (== (($ leaves at) a) (($ (cof np) ins at) j)) (set ix (- (- 0 (cast llong a)) 1))))
              (set k (+ (+ k (std::to_string ix)) (std::string ",")))))
          (set k (+ k (std::string ";")))))
      (return k)))
  ;; every node of a closure, from the given leaf and node tensors
  (static) (func ct_compute_all ((const (t<> std::vector (t<> std::shared_ptr CtNode)) & def)
                                 (const (t<> std::vector (t<> std::shared_ptr CtNode)) & leaves)
                                 ((t<> std::vector torch::Tensor) & lin) ((t<> std::vector torch::Tensor) & out))
    (for ((size_t i . 0)) (< i (($ def size))) ((++ i))
      (letin* ((in ((t<> std::vector torch::Tensor))))
        (let ((CtNode * np . #'(($ (($ def at) i) get))))
          (for ((size_t j . 0)) (< j (($ (cof np) ins size))) ((++ j))
            (let ((int found . 0))
              (for ((size_t a . 0)) (and (< a (($ def size))) (not found)) ((++ a))
                (if (== (($ def at) a) (($ (cof np) ins at) j)) (block (($ in push_back) (($ out at) a)) (set found 1))))
              (for ((size_t a . 0)) (and (< a (($ leaves size))) (not found)) ((++ a))
                (if (== (($ leaves at) a) (($ (cof np) ins at) j)) (block (($ in push_back) (($ lin at) a)) (set found 1))))))
          (set (($ out at) i) (ct_apply_in (cof np) in 0))))))
  (@ifdef (code "COCO_TORCH_CUDA"))
  (include <ATen/cuda/CUDAGraph.h>)
  (include <c10/cuda/CUDAStream.h>)
  (include <c10/cuda/CUDAGuard.h>)
  (decl) (struct (t<> std::unique_ptr at::cuda::CUDAGraph))
  (struct CtCapture
    (member (t<> std::unique_ptr at::cuda::CUDAGraph) graph)
    (member (t<> std::vector torch::Tensor) in)
    (member (t<> std::vector torch::Tensor) out)
    (member int seen))
  ;; heap-allocated and never freed ON PURPOSE: a captured graph destroyed after
  ;; the CUDA driver has shut down at process exit warns on every run
  (decl) (struct (t<> std::map std::string CtCapture))
  (static) (var (t<> std::map std::string CtCapture) * ct_captures . #'(new* (t<> std::map std::string CtCapture)))
  (static) (func ct_force_replay_cuda ((const (t<> std::shared_ptr CtNode) & target)) (out int)
    (letin* ((def ((t<> std::vector (t<> std::shared_ptr CtNode)))) (leaves ((t<> std::vector (t<> std::shared_ptr CtNode)))))
      (ct_closure target def leaves)
      (if (< (($ def size)) 2) (return 0))
      (for ((size_t i . 0)) (< i (($ leaves size))) ((++ i))
        (let ((CtNode * lp . #'(($ (($ leaves at) i) get))))
          (set (-> lp value) (ct_place (-> lp value)))
          (if (bool? (($ (-> lp value) requires_grad))) (return 0))))
      (letin* ((key (ct_key def leaves)))
        (if (== 0 (($ (cof ct_captures) count) key))
            (block
              (if (>= (($ (cof ct_captures) size)) 64) (($ (cof ct_captures) clear)))
              (set ($ (nth key (cof ct_captures)) seen) 1)
              (return 0)))                            ; the first time: plain, and remembered
        (let ((CtCapture * c . #'(aof (nth key (cof ct_captures)))))
          (if (== (($ (-> c graph) get)) nil)
              (block                                  ; the second time: capture, then replay
                (($ (cof c) in clear))
                (($ (cof c) out clear))
                (($ (cof c) out resize) (($ def size)))
                (for ((size_t i . 0)) (< i (($ leaves size))) ((++ i))
                  (let ((CtNode * lp . #'(($ (($ leaves at) i) get))))
                    (($ (cof c) in push_back) (($ (-> lp value) clone)))))
                (let ((c10::cuda::CUDAStream side . #'(c10::cuda::getStreamFromPool)))
                  (letin* ((guard (c10::cuda::CUDAStreamGuard side)))
                    (ct_compute_all def leaves (-> c in) (-> c out))   ; warm-up on the capture stream
                    (($ side synchronize))
                    (($ (-> c graph) reset) (new* at::cuda::CUDAGraph))
                    (let ((at::cuda::CUDAGraph * gp . #'(($ (-> c graph) get))))
                      ((-> gp capture_begin))
                      (ct_compute_all def leaves (-> c in) (-> c out))
                      ((-> gp capture_end))))))
              (for ((size_t i . 0)) (< i (($ leaves size))) ((++ i))
                (let ((CtNode * lp . #'(($ (($ leaves at) i) get))))
                  (($ (($ (cof c) in at) i) copy_) (-> lp value)))))
          (let ((at::cuda::CUDAGraph * gp . #'(($ (-> c graph) get))))
            ((-> gp replay)))
          (for ((size_t i . 0)) (< i (($ def size))) ((++ i))
            (let ((CtNode * dp . #'(($ (($ def at) i) get))))
              (set (-> dp value) (($ (($ (cof c) out at) i) clone)))
              (set (-> dp done) 1)))
          (set ct_rep (+ ct_rep 1))
          (return 1)))))
  (@endif)
  (static) (func ct_force_replay ((const (t<> std::shared_ptr CtNode) & target)) (out int)
    (@ifdef (code "COCO_TORCH_CUDA"))
    (return (ct_force_replay_cuda target))
    (@else)
    (return 0)
    (@endif))
  (static) (func ct_force_node ((const (t<> std::shared_ptr CtNode) & nd)) (out torch::Tensor *)
    (let ((CtNode * p . #'(($ nd get))))
      (if (not (-> p done))
          (block
            (if (and ct_graph_mode (and (bool? (($ ct_device is_cuda))) (ct_force_replay nd))) (return (aof (-> p value))))
            (for ((size_t i . 0)) (< i (($ (cof p) ins size))) ((++ i)) (ct_force_node (($ (cof p) ins at) i)))
            (set (-> p value) (ct_apply (cof p) 0))
            (set (-> p done) 1)
            (set ct_exe (+ ct_exe 1)))
          (set (-> p value) (ct_place (-> p value))))   ; made before a device switch: it follows, on either path
      (return (aof (-> p value)))))
  (func ct_slot_tensor ((llong h)) (out torch::Tensor *)
    (if (ct_slot_exists h) (return (ct_force_node (nth h ct_nodes))))
    (return nil))
  (func ct_slot_force ((llong h)) (out int) (return (? (!= (ct_slot_tensor h) nil) 1 0)))
  ;; record a deferred node. Its shape and dtype come from the meta device NOW,
  ;; so a shape error is thrown here -- at the same goal eager throws it.
  (func ct_record ((int prod) (int op) (double v) (llong n) (llong dim) (llong from) (llong len)
                   (const llong * ishape) (int nd) (const llong * ins) (int nins)) (out llong)
    (let (((t<> std::shared_ptr CtNode) node . #'((t<> std::make_shared CtNode))))
      (let ((CtNode * p . #'(($ node get))))
        (set (-> p prod) prod) (set (-> p op) op) (set (-> p v) v) (set (-> p n) n)
        (set (-> p dim) dim) (set (-> p from) from) (set (-> p len) len)
        (if (and (!= ishape nil) (> nd 0))
            (for ((int i . 0)) (< i nd) ((++ i)) (($ (cof p) ishape push_back) (nth i ishape))))
        (for ((int i . 0)) (< i nins) ((++ i))
          (if (not (ct_slot_exists (nth i ins))) (return -1))
          (($ (cof p) ins push_back) (nth (nth i ins) ct_nodes)))
        (let ((torch::Tensor m . #'(ct_apply (cof p) 1)))
          (let ((c10::IntArrayRef sz . #'(($ m sizes))))
            (for ((size_t i . 0)) (< i (($ sz size))) ((++ i)) (($ (cof p) shape push_back) (nth i sz))))
          (set (-> p dtype) (($ m scalar_type))))
        (let ((llong h . #'(ct_slot_new node)))
          (if (> h 0) (set ct_rec (+ ct_rec 1)))
          (return h)))))
  ;; ---- phase 2: autograd through what was recorded -------------------------
  ;; Forcing runs real ops on real tensors, and libtorch records them on its own
  ;; tape whenever an input requires grad -- in BOTH execution paths. So a
  ;; parameter is a leaf that requires grad, a gradient is what autograd answers
  ;; for a forced scalar, and a step is a NEW leaf: nothing is mutated in place,
  ;; which is what keeps a deferred node that still names the old parameter
  ;; honest. See DESIGN-lazy-graph.md, gate B.
  (func ct_parameter ((llong h)) (out llong)
    (let ((torch::Tensor * t . #'(ct_slot_tensor h)))
      (if (== t nil) (return -1))
      (let ((torch::Tensor p . #'(ct_place (($ ((-> t detach)) clone)))))
        (($ p set_requires_grad) true)
        (return (ct_slot_keep p)))))
  (func ct_step ((llong hp) (llong hg) (double lr)) (out llong)
    (let ((torch::Tensor * p . #'(ct_slot_tensor hp)) (torch::Tensor * g . #'(ct_slot_tensor hg)))
      (if (or (== p nil) (== g nil)) (return -1))
      (let ((torch::Tensor q))
        (letin* ((ng (torch::NoGradGuard)))
          (set q (($ ((-> p detach)) sub) (($ ((-> g detach)) mul) lr))))
        (($ q set_requires_grad) true)
        (return (ct_slot_keep q)))))
  ;; -1 no such tensor; -2 the loss is not one element; -3 it depends on no parameter
  (func ct_grad ((llong hloss) (const llong * hps) (int n) (llong * out)) (out int)
    (let ((torch::Tensor * l . #'(ct_slot_tensor hloss)))
      (if (== l nil) (return -1))
      (if (!= ((-> l numel)) 1) (return -2))
      (if (not (bool? ((-> l requires_grad)))) (return -3))
      (letin* ((ps ((t<> std::vector torch::Tensor))) (outs ((t<> std::vector torch::Tensor))) (none ((t<> std::vector torch::Tensor))))
        (for ((int i . 0)) (< i n) ((++ i))
          (let ((torch::Tensor * p . #'(ct_slot_tensor (nth i hps))))
            (if (== p nil) (return -1))
            (($ ps push_back) (cof p))))
        (($ outs push_back) (cof l))
        (letin* ((gs (torch::autograd::grad outs ps none true false true)))
          (for ((int i . 0)) (< i n) ((++ i))
            (let ((torch::Tensor g . #'(? (bool? (($ (($ gs at) i) defined))) (($ (($ gs at) i) detach)) (torch::zeros_like (($ ps at) i)))))
              (set (nth i out) (ct_slot_keep g))))
          (return 1)))))
  (func ct_graph_stats ((llong * rec) (llong * exe) (llong * rep) (llong * pend))
    (let ((llong p . 0))
      (for ((llong i . 1)) (< i 4096) ((++ i))
        (if (!= (($ (nth i ct_nodes) get)) nil)
            (let ((CtNode * np . #'(($ (nth i ct_nodes) get))))
              (if (not (-> np done)) (set p (+ p 1))))))
      (set (cof rec) ct_rec) (set (cof exe) ct_exe) (set (cof rep) ct_rep) (set (cof pend) p)))

  ;; ---- the handle tables --------------------------------------------
  ;; Fixed tables; a freed slot is reused; 0 is never a handle. Process
  ;; state, on purpose -- see the head of the file. Tensors live in the
  ;; node table above: tensor_of FORCES a deferred node and answers its
  ;; value, so every consumer below works in both execution paths.

  (var CtNet * ct_models [256])

  (func tensor_of ((int64_t h)) (out torch::Tensor *)
    (return (ct_slot_tensor (cast llong h))))

  (func tensor_keep ((const torch::Tensor & t)) (out int64_t)
    (return (cast int64_t (ct_slot_keep t))))

  (func model_of ((int64_t h)) (out CtNet *)
    (if (or (<= h 0) (>= h 256)) (return nil))
    (return (nth h ct_models)))

  (func arg_handle ((coco_engine * e) (size_t t)) (out int64_t)
    (let ((int64_t h . 0))
      (if (not (coco_m_int e t (aof h))) (return -1))
      (return h)))

  ;; doubles in, float32 tensor out -- one conversion, in torch
  (func tensor_from_doubles ((const double * data) (const int64_t * shape) (int nd))
        (out torch::Tensor)
    (letin* ((wide (torch::from_blob (cast (void *) data)
                                     (c10::IntArrayRef (cast (const i64 *) shape)
                                                       (cast size_t nd))
                                     (torch::dtype torch::kFloat64)))
             (narrow32 (($ wide to) torch::kFloat32)))
      (return (($ narrow32 clone)))))

  ;; the elements as doubles, row-major, into a malloc'd buffer
  (func tensor_to_doubles ((const torch::Tensor & t) (int64_t * out_n)) (out double *)
    (let ((int64_t n . #'(cast int64_t (($ t numel))))
          (double * buf . nil))
      (set buf (cast (double *) (malloc (* (cast size_t n) (sizeof double)))))
      (if (== buf nil) (return nil))
      (letin* ((view (torch::from_blob (cast (void *) buf) (dims n)
                                       (torch::dtype torch::kFloat64)))
               (dt (($ t detach)))
               (wide (($ dt to) torch::kFloat64))
               (ct (($ wide contiguous)))
               (flat (($ ct view) (dims n))))
        (($ view copy_) flat)
        (cast void 0))
      (set (cof out_n) n)
      (return buf)))

  ;; ---- the predicates -------------------------------------------------
  ;; Every one deterministic, every torch exception turned into a
  ;; domain error on the goal -- the module rules, obeyed.

  ;; torch_seed(+N)
  (func t_seed ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t n . 0))
      (if (not (coco_m_int e (coco_m_arg e g 0) (aof n)))
          (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
      (torch::manual_seed (cast u64 n))
      (return 1)))

  ;; tensor_from_list(+List, -T): a list of numbers is [N]; a list of
  ;; lists of numbers is [Rows, Cols]
  (func t_from_list ((coco_engine * e) (size_t g)) (out int)
    (let ((size_t lt . #'(coco_m_arg e g 0))
          (size_t * rows . nil) (size_t nrows . 0)
          (double * data . nil) (int64_t shape [2]) (int nd . 0)
          (int ok . 1))
      (if (not (coco_m_list_array e lt (aof rows) (aof nrows)))
          (return (coco_m_type_error e "list" lt)))
      (if (== nrows 0)
          (block (if (!= rows nil) (free (cast (void *) rows)))
                 (return (coco_m_domain_error e "non_empty_list" lt))))
      (let ((double probe . 0.0) (int64_t iprobe . 0))
        (if (or (coco_m_float e (nth 0 rows) (aof probe))
                (coco_m_int e (nth 0 rows) (aof iprobe)))
            (block ;; ---- flat [N] --------------------------------------
              (set nd 1)
              (set (nth 0 shape) (cast int64_t nrows))
              (set data (cast (double *) (malloc (* nrows (sizeof double)))))
              (let ((size_t i . 0))
                (while (< i nrows)
                  (let ((double v . 0.0) (int64_t iv . 0))
                    (cond
                      ((coco_m_float e (nth i rows) (aof v)) (set (nth i data) v))
                      ((coco_m_int e (nth i rows) (aof iv)) (set (nth i data) (cast double iv)))
                      (#t (set ok 0))))
                  (set i (+ i 1)))))
          (block ;; ---- [Rows, Cols] ------------------------------------
            (set nd 2)
            (let ((size_t * cols . nil) (size_t ncols . 0))
              (if (not (coco_m_list_array e (nth 0 rows) (aof cols) (aof ncols)))
                  (set ok 0)
                (block
                  (if (!= cols nil) (free (cast (void *) cols)))
                  (set (nth 0 shape) (cast int64_t nrows))
                  (set (nth 1 shape) (cast int64_t ncols))
                  (set data (cast (double *) (malloc (* (* nrows ncols) (sizeof double)))))
                  (let ((size_t i . 0))
                    (while (and (< i nrows) ok)
                      (let ((size_t * cell . nil) (size_t nc . 0))
                        (if (or (not (coco_m_list_array e (nth i rows) (aof cell) (aof nc)))
                                (!= nc ncols))
                            (set ok 0)
                          (let ((size_t j . 0))
                            (while (< j nc)
                              (let ((double v . 0.0) (int64_t iv . 0))
                                (cond
                                  ((coco_m_float e (nth j cell) (aof v))
                                   (set (nth (+ (* i ncols) j) data) v))
                                  ((coco_m_int e (nth j cell) (aof iv))
                                   (set (nth (+ (* i ncols) j) data) (cast double iv)))
                                  (#t (set ok 0))))
                              (set j (+ j 1)))))
                        (if (!= cell nil) (free (cast (void *) cell))))
                      (set i (+ i 1))))))))))
      (free (cast (void *) rows))
      (if (not ok)
          (block (if (!= data nil) (free (cast (void *) data)))
                 (return (coco_m_type_error e "tensor_data" lt))))
      (let ((int rc . 0))
        (try
          (let ((int64_t h . #'(tensor_keep (tensor_from_doubles data shape nd))))
            (set rc (? (> h 0) (coco_m_unify_int e (coco_m_arg e g 1) h) 0)))
          (catch ((const std::exception & ex))
            (cast void ex)
            (set rc 0)))
        (free (cast (void *) data))
        (return rc))))

  ;; tensor_to_list(+T, -List): [N] comes back flat, [R,C] as rows
  (func t_to_list ((coco_engine * e) (size_t g)) (out int)
    (let ((torch::Tensor * t . #'(tensor_of (arg_handle e (coco_m_arg e g 0)))))
      (if (== t nil) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (try
        (block
          (let ((int64_t n . 0)
                (double * buf . #'(tensor_to_doubles (cof t) (aof n)))
                (coco_machine * m . #'(coco_m_machine e)))
            (if (== buf nil) (return 0))
            (let ((size_t * cells . #'(cast (size_t *) (malloc (* (cast size_t n) (sizeof size_t)))))
                  (size_t lst . 0))
              (let ((int64_t i . 0))
                (while (< i n)
                  (set (nth i cells) (coco_new_float m (nth i buf)))
                  (set i (+ i 1))))
              (if (and (== ((-> t dim)) 2) (> ((-> t size) 1) 0))
                  (let ((int64_t nr . #'((-> t size) 0)) (int64_t nc . #'((-> t size) 1)))
                    (let ((size_t * rcells . #'(cast (size_t *) (malloc (* (cast size_t nr) (sizeof size_t))))))
                      (let ((int64_t r . 0))
                        (while (< r nr)
                          (set (nth r rcells)
                               (coco_m_list e (aof (nth (* r nc) cells)) (cast size_t nc)))
                          (set r (+ r 1))))
                      (set lst (coco_m_list e rcells (cast size_t nr)))
                      (free (cast (void *) rcells))))
                (set lst (coco_m_list e cells (cast size_t n))))
              (free (cast (void *) cells))
              (free (cast (void *) buf))
              (return (coco_m_unify e (coco_m_arg e g 1) lst)))))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return 0)))))

  ;; tensor_shape(+T, -Shape): from the node, which knew its shape when it
  ;; was recorded -- nothing is executed to answer
  (func t_shape ((coco_engine * e) (size_t g)) (out int)
    (let ((llong h . #'(cast llong (arg_handle e (coco_m_arg e g 0))))
          (llong dimsv [16])
          (coco_machine * m . #'(coco_m_machine e))
          (size_t cells [16]))
      (let ((int nd . #'(ct_slot_shape h dimsv 16)))
        (if (< nd 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
        (let ((int i . 0))
          (while (< i nd)
            (set (nth i cells) (coco_new_int m (cast int64_t (nth i dimsv))))
            (set i (+ i 1))))
        (return (coco_m_unify e (coco_m_arg e g 1)
                              (coco_m_list e cells (cast size_t nd)))))))

  ;; tensor_load_csv(+Path, -T): whitespace/comma numbers -> [Rows,
  ;; Cols]. Finding and checking the path is the Files module's business
  ;; in Prolog; pouring a million floats through a Prolog list is
  ;; nobody's, which is why the bulk loader is here.
  (func t_load_csv ((coco_engine * e) (size_t g)) (out int)
    (let ((char path [1024]))
      (if (not (coco_m_text e (coco_m_arg e g 0) path (sizeof path)))
          (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
      (let ((FILE * f . #'(fopen path "r")))
        (if (== f nil) (return (coco_m_domain_error e "readable_file" (coco_m_arg e g 0))))
        (let ((double * data . nil) (int64_t ndata . 0) (int64_t cap . 0)
              (int64_t rows . 0) (int64_t cols . 0) (int64_t line_cols . 0)
              (char line [65536]) (int bad . 0))
          (while (!= (fgets line (sizeof line) f) nil)
            (set line_cols 0)
            (let ((char * p . line) (char * endp . nil))
              (while 1
                (while (and (!= (nth 0 p) 0)
                            (or (== (nth 0 p) 32)
                                (or (== (nth 0 p) 44)
                                    (or (== (nth 0 p) 9) (== (nth 0 p) 13)))))
                  (set p (+ p 1)))
                (if (or (== (nth 0 p) 0) (== (nth 0 p) 10)) break)
                (let ((double v . #'(strtod p (aof endp))))
                  (if (== endp p) (block (set bad 1) break))
                  (set p endp)
                  (if (>= ndata cap)
                      (block
                        (set cap (? (== cap 0) 4096 (* cap 2)))
                        (set data (cast (double *)
                                        (realloc (cast (void *) data)
                                                 (* (cast size_t cap) (sizeof double)))))))
                  (set (nth ndata data) v)
                  (set ndata (+ ndata 1))
                  (set line_cols (+ line_cols 1)))))
            (if bad break)
            (if (> line_cols 0)
                (block
                  (if (== rows 0) (set cols line_cols)
                    (if (!= line_cols cols) (block (set bad 1) break)))
                  (set rows (+ rows 1)))))
          (fclose f)
          (if (or bad (== rows 0))
              (block
                (if (!= data nil) (free (cast (void *) data)))
                (return (coco_m_domain_error e "rectangular_csv" (coco_m_arg e g 0)))))
          (let ((int rc . 0) (int64_t shape [2]))
            (set (nth 0 shape) rows)
            (set (nth 1 shape) cols)
            (try
              (let ((int64_t h . #'(tensor_keep (tensor_from_doubles data shape 2))))
                (set rc (? (> h 0) (coco_m_unify_int e (coco_m_arg e g 1) h) 0)))
              (catch ((const std::exception & ex))
                (cast void ex)
                (set rc 0)))
            (free (cast (void *) data))
            (return rc))))))

  ;; tensor_cols(+T, +From, +To, -T2) / tensor_rows(+T, +From, +To, -T2)
  (func t_narrowed ((coco_engine * e) (size_t g) (int dim)) (out int)
    (let ((llong h . #'(cast llong (arg_handle e (coco_m_arg e g 0))))
          (int64_t from . 0) (int64_t to . 0))
      (if (not (ct_slot_exists h)) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (or (not (coco_m_int e (coco_m_arg e g 1) (aof from)))
              (not (coco_m_int e (coco_m_arg e g 2) (aof to))))
          (return (coco_m_type_error e "integer" (coco_m_arg e g 1))))
      (try
        (block
          (if (ct_graph_get)
              (let ((llong ins [1]))
                (set (nth 0 ins) h)
                (return (coco_m_unify_int e (coco_m_arg e g 3)
                          (ct_record 11 0 0.0 0 (cast llong dim) (cast llong from)
                                     (cast llong (- to from)) nil 0 ins 1)))))
          (let ((torch::Tensor * t . #'(tensor_of (cast int64_t h))))
            (letin* ((part ((-> t narrow) dim from (- to from)))
                     (own (($ part clone))))
              (return (coco_m_unify_int e (coco_m_arg e g 3) (tensor_keep own))))))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "tensor_range" g))))))

  (func t_cols ((coco_engine * e) (size_t g)) (out int) (return (t_narrowed e g 1)))
  (func t_rows ((coco_engine * e) (size_t g)) (out int) (return (t_narrowed e g 0)))

  ;; tensor_standardise(+T, +NTrain, -T2): per column, statistics FROM
  ;; THE FIRST NTRAIN ROWS ONLY -- over everything leaks the held-out
  ;; rows into the model
  (func t_standardise ((coco_engine * e) (size_t g)) (out int)
    (let ((llong h . #'(cast llong (arg_handle e (coco_m_arg e g 0))))
          (int64_t ntrain . 0))
      (if (not (ct_slot_exists h)) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (not (coco_m_int e (coco_m_arg e g 1) (aof ntrain)))
          (return (coco_m_type_error e "integer" (coco_m_arg e g 1))))
      (if (ct_graph_get)
          (try
            (let ((llong ins [1]))
              (set (nth 0 ins) h)
              (return (coco_m_unify_int e (coco_m_arg e g 2)
                        (ct_record 12 0 0.0 (cast llong ntrain) 0 0 0 nil 0 ins 1))))
            (catch ((const std::exception & ex))
              (cast void ex)
              (return (coco_m_domain_error e "tensor_range" g)))))
      (let ((torch::Tensor * t . #'(tensor_of (cast int64_t h))))
      (try
        (letin* ((head ((-> t narrow) 0 0 ntrain))
                 (mu (mean_t head 0))
                 (sd0 (($ head std) (dims 0) #t #t))
                 (sd (($ sd0 clamp_min) 1e-7))
                 (centred (($ (cof t) sub) mu))
                 (z (($ centred div) sd)))
          (return (coco_m_unify_int e (coco_m_arg e g 2) (tensor_keep z))))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "tensor_range" g)))))))

  ;; tensor_free(+T): Prolog no longer names it; a node that others depend
  ;; on lives on through their pointers
  (func t_free ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t h . #'(arg_handle e (coco_m_arg e g 0))))
      (return (ct_slot_release (cast llong h)))))

  ;; ---- the tensor operations ------------------------------------------
  ;; Four generic C-half predicates carry every family; the Coco half
  ;; below spells the friendly names (tensor_add/3, tensor_zeros/2...)
  ;; over them, which is what keeps this dispatcher a table rather than
  ;; a catalogue.

  ;; adopts a new'd tensor into the table as a value node
  (func tensor_adopt ((torch::Tensor * t)) (out llong)
    (return (ct_slot_adopt t)))

  (func op_code ((const char * nm) (const char ** table) (int n)) (out int)
    (let ((int i . 0))
      (while (< i n)
        (if (== 0 (strcmp nm (nth i table))) (return i))
        (set i (+ i 1))))
    (return -1))

  ;; tensor_unary(+Op, +T, -T2): neg abs exp log sqrt relu sigmoid tanh transpose
  (func t_unary ((coco_engine * e) (size_t g)) (out int)
    (let ((const char * nm . #'(coco_m_atom e (coco_m_arg e g 0)))
          (llong ha . #'(cast llong (arg_handle e (coco_m_arg e g 1))))
          (const char * ops [9]))
      (set (nth 0 ops) "neg") (set (nth 1 ops) "abs") (set (nth 2 ops) "exp")
      (set (nth 3 ops) "log") (set (nth 4 ops) "sqrt") (set (nth 5 ops) "relu")
      (set (nth 6 ops) "sigmoid") (set (nth 7 ops) "tanh") (set (nth 8 ops) "transpose")
      (if (== nm nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
      (if (not (ct_slot_exists ha)) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 1))))
      (let ((int op . #'(op_code nm ops 9)))
        (if (< op 0) (return (coco_m_domain_error e "tensor_op" (coco_m_arg e g 0))))
        (try
          (block
            (if (ct_graph_get)
                (let ((llong ins [1]))
                  (set (nth 0 ins) ha)
                  (return (coco_m_unify_int e (coco_m_arg e g 2)
                            (ct_record 1 op 0.0 0 0 0 0 nil 0 ins 1)))))
            (let ((torch::Tensor * r . #'(ct_unary_raw op (tensor_of (cast int64_t ha)))))
              (if (== r nil) (return 0))
              (return (coco_m_unify_int e (coco_m_arg e g 2) (tensor_adopt r)))))
          (catch ((const std::exception & ex))
            (cast void ex)
            (return (coco_m_domain_error e "tensor_op" g)))))))

  ;; tensor_binary(+Op, +A, +B, -C): add sub mul div matmul
  (func t_binary ((coco_engine * e) (size_t g)) (out int)
    (let ((const char * nm . #'(coco_m_atom e (coco_m_arg e g 0)))
          (llong ha . #'(cast llong (arg_handle e (coco_m_arg e g 1))))
          (llong hb . #'(cast llong (arg_handle e (coco_m_arg e g 2))))
          (const char * ops [5]))
      (set (nth 0 ops) "add") (set (nth 1 ops) "sub") (set (nth 2 ops) "mul")
      (set (nth 3 ops) "div") (set (nth 4 ops) "matmul")
      (if (== nm nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
      (if (or (not (ct_slot_exists ha)) (not (ct_slot_exists hb)))
          (return (coco_m_domain_error e "tensor" g)))
      (let ((int op . #'(op_code nm ops 5)))
        (if (< op 0) (return (coco_m_domain_error e "tensor_op" (coco_m_arg e g 0))))
        (try
          (block
            (if (ct_graph_get)
                (let ((llong ins [2]))
                  (set (nth 0 ins) ha) (set (nth 1 ins) hb)
                  (return (coco_m_unify_int e (coco_m_arg e g 3)
                            (ct_record 2 op 0.0 0 0 0 0 nil 0 ins 2)))))
            (let ((torch::Tensor * r . #'(ct_binary_raw op (tensor_of (cast int64_t ha))
                                                           (tensor_of (cast int64_t hb)))))
              (if (== r nil) (return 0))
              (return (coco_m_unify_int e (coco_m_arg e g 3) (tensor_adopt r)))))
          (catch ((const std::exception & ex))
            (cast void ex)
            (return (coco_m_domain_error e "tensor_op" g)))))))

  ;; tensor_scalar(+Op, +A, +V, -C): add sub mul div pow
  (func t_scalar ((coco_engine * e) (size_t g)) (out int)
    (let ((const char * nm . #'(coco_m_atom e (coco_m_arg e g 0)))
          (llong ha . #'(cast llong (arg_handle e (coco_m_arg e g 1))))
          (double v . 0.0) (int64_t iv . 0)
          (const char * ops [5]))
      (set (nth 0 ops) "add") (set (nth 1 ops) "sub") (set (nth 2 ops) "mul")
      (set (nth 3 ops) "div") (set (nth 4 ops) "pow")
      (if (== nm nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
      (if (not (ct_slot_exists ha)) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 1))))
      (cond
        ((coco_m_float e (coco_m_arg e g 2) (aof v)) (block))
        ((coco_m_int e (coco_m_arg e g 2) (aof iv)) (set v (cast double iv)))
        (#t (return (coco_m_type_error e "number" (coco_m_arg e g 2)))))
      (let ((int op . #'(op_code nm ops 5)))
        (if (< op 0) (return (coco_m_domain_error e "tensor_op" (coco_m_arg e g 0))))
        (try
          (block
            (if (ct_graph_get)
                (let ((llong ins [1]))
                  (set (nth 0 ins) ha)
                  (return (coco_m_unify_int e (coco_m_arg e g 3)
                            (ct_record 3 op v 0 0 0 0 nil 0 ins 1)))))
            (let ((torch::Tensor * r . #'(ct_scalar_raw op (tensor_of (cast int64_t ha)) v)))
              (if (== r nil) (return 0))
              (return (coco_m_unify_int e (coco_m_arg e g 3) (tensor_adopt r)))))
          (catch ((const std::exception & ex))
            (cast void ex)
            (return (coco_m_domain_error e "tensor_op" g)))))))

  ;; tensor_reduce(+Op, +T, -X): sum mean max min std, over everything
  (func t_reduce ((coco_engine * e) (size_t g)) (out int)
    (let ((const char * nm . #'(coco_m_atom e (coco_m_arg e g 0)))
          (torch::Tensor * a . #'(tensor_of (arg_handle e (coco_m_arg e g 1))))
          (const char * ops [5]))
      (set (nth 0 ops) "sum") (set (nth 1 ops) "mean") (set (nth 2 ops) "max")
      (set (nth 3 ops) "min") (set (nth 4 ops) "std")
      (if (== nm nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
      (if (== a nil) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 1))))
      (let ((int op . #'(op_code nm ops 5)))
        (if (< op 0) (return (coco_m_domain_error e "tensor_op" (coco_m_arg e g 0))))
        (try
          (block
            (let ((double out . 0.0))
              (if (not (ct_reduce_raw op a (aof out))) (return 0))
              (return (coco_m_unify_float e (coco_m_arg e g 2) out))))
          (catch ((const std::exception & ex))
            (cast void ex)
            (return (coco_m_domain_error e "tensor_op" g)))))))

  ;; tensor_argmax(+T, +Dim, -T2)
  (func t_argmax ((coco_engine * e) (size_t g)) (out int)
    (let ((llong ha . #'(cast llong (arg_handle e (coco_m_arg e g 0))))
          (int64_t dim . 0))
      (if (not (ct_slot_exists ha)) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (not (coco_m_int e (coco_m_arg e g 1) (aof dim)))
          (return (coco_m_type_error e "integer" (coco_m_arg e g 1))))
      (try
        (block
          (if (ct_graph_get)
              (let ((llong ins [1]))
                (set (nth 0 ins) ha)
                (return (coco_m_unify_int e (coco_m_arg e g 2)
                          (ct_record 7 0 0.0 0 (cast llong dim) 0 0 nil 0 ins 1)))))
          (return (coco_m_unify_int e (coco_m_arg e g 2)
                    (tensor_adopt (ct_argmax_raw (tensor_of (cast int64_t ha)) (cast llong dim))))))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "tensor_op" g))))))

  ;; a Shape argument as an array of longs; answers the count or -1
  (func shape_arg ((coco_engine * e) (size_t t) (llong * out) (int cap)) (out int)
    (let ((size_t * cells . nil) (size_t n . 0))
      (if (not (coco_m_list_array e t (aof cells) (aof n))) (return -1))
      (if (> n (cast size_t cap))
          (block (free (cast (void *) cells)) (return -1)))
      (let ((size_t i . 0) (int ok . 1))
        (while (< i n)
          (let ((int64_t v . 0))
            (if (not (coco_m_int e (nth i cells) (aof v))) (set ok 0)
              (set (nth i out) (cast llong v))))
          (set i (+ i 1)))
        (free (cast (void *) cells))
        (if (not ok) (return -1))
        (return (cast int n)))))

  ;; tensor_reshape(+T, +Shape, -T2)
  (func t_reshape ((coco_engine * e) (size_t g)) (out int)
    (let ((llong ha . #'(cast llong (arg_handle e (coco_m_arg e g 0))))
          (llong shape [16]))
      (if (not (ct_slot_exists ha)) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (let ((int nd . #'(shape_arg e (coco_m_arg e g 1) shape 16)))
        (if (< nd 1) (return (coco_m_type_error e "shape" (coco_m_arg e g 1))))
        (try
          (block
            (if (ct_graph_get)
                (let ((llong ins [1]))
                  (set (nth 0 ins) ha)
                  (return (coco_m_unify_int e (coco_m_arg e g 2)
                            (ct_record 4 0 0.0 0 0 0 0 shape nd ins 1)))))
            (return (coco_m_unify_int e (coco_m_arg e g 2)
                      (tensor_adopt (ct_reshape_raw (tensor_of (cast int64_t ha)) shape nd)))))
          (catch ((const std::exception & ex))
            (cast void ex)
            (return (coco_m_domain_error e "tensor_shape" g)))))))

  ;; tensor_cat(+TList, +Dim, -T2)
  (func t_cat ((coco_engine * e) (size_t g)) (out int)
    (let ((size_t * cells . nil) (size_t n . 0) (int64_t dim . 0)
          (torch::Tensor * parts [64]))
      (if (not (coco_m_list_array e (coco_m_arg e g 0) (aof cells) (aof n)))
          (return (coco_m_type_error e "list" (coco_m_arg e g 0))))
      (if (or (== n 0) (> n 64))
          (block (if (!= cells nil) (free (cast (void *) cells)))
                 (return (coco_m_domain_error e "tensor_list" (coco_m_arg e g 0)))))
      (if (not (coco_m_int e (coco_m_arg e g 1) (aof dim)))
          (block (free (cast (void *) cells))
                 (return (coco_m_type_error e "integer" (coco_m_arg e g 1)))))
      (let ((size_t i . 0) (int ok . 1) (llong ins [64]))
        (while (< i n)
          (let ((llong h . #'(cast llong (arg_handle e (nth i cells)))))
            (if (not (ct_slot_exists h)) (set ok 0) (set (nth i ins) h)))
          (set i (+ i 1)))
        (free (cast (void *) cells))
        (if (not ok) (return (coco_m_domain_error e "tensor_list" (coco_m_arg e g 0))))
        (try
          (block
            (if (ct_graph_get)
                (return (coco_m_unify_int e (coco_m_arg e g 2)
                          (ct_record 5 0 0.0 0 (cast llong dim) 0 0 nil 0 ins (cast int n)))))
            (set i 0)
            (while (< i n)
              (set (nth i parts) (tensor_of (cast int64_t (nth i ins))))
              (set i (+ i 1)))
            (return (coco_m_unify_int e (coco_m_arg e g 2)
                      (tensor_adopt (ct_cat_raw parts (cast int n) (cast llong dim))))))
          (catch ((const std::exception & ex))
            (cast void ex)
            (return (coco_m_domain_error e "tensor_op" g)))))))

  ;; tensor_index_rows(+T, +IdxT, -T2): rows picked by an index tensor
  (func t_index_rows ((coco_engine * e) (size_t g)) (out int)
    (let ((llong ha . #'(cast llong (arg_handle e (coco_m_arg e g 0))))
          (llong hi . #'(cast llong (arg_handle e (coco_m_arg e g 1)))))
      (if (or (not (ct_slot_exists ha)) (not (ct_slot_exists hi)))
          (return (coco_m_domain_error e "tensor" g)))
      (try
        (block
          (if (ct_graph_get)
              (let ((llong ins [2]))
                (set (nth 0 ins) ha) (set (nth 1 ins) hi)
                (return (coco_m_unify_int e (coco_m_arg e g 2)
                          (ct_record 6 0 0.0 0 0 0 0 nil 0 ins 2)))))
          (return (coco_m_unify_int e (coco_m_arg e g 2)
                    (tensor_adopt (ct_index_rows_raw (tensor_of (cast int64_t ha))
                                                     (tensor_of (cast int64_t hi)))))))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "tensor_op" g))))))

  ;; tensor_new(+Shape, +Kind, -T): zeros ones randn rand
  (func t_new ((coco_engine * e) (size_t g)) (out int)
    (let ((llong shape [16])
          (const char * nm . #'(coco_m_atom e (coco_m_arg e g 1)))
          (const char * kinds [4]))
      (set (nth 0 kinds) "zeros") (set (nth 1 kinds) "ones")
      (set (nth 2 kinds) "randn") (set (nth 3 kinds) "rand")
      (if (== nm nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 1))))
      (let ((int nd . #'(shape_arg e (coco_m_arg e g 0) shape 16))
            (int kind . #'(op_code nm kinds 4)))
        (if (< nd 1) (return (coco_m_type_error e "shape" (coco_m_arg e g 0))))
        (if (< kind 0) (return (coco_m_domain_error e "tensor_kind" (coco_m_arg e g 1))))
        (try
          (block
            ;; zeros and ones are deterministic leaves and may wait; randn and
            ;; rand draw from the generator NOW, so draws keep program order
            (if (and (ct_graph_get) (< kind 2))
                (return (coco_m_unify_int e (coco_m_arg e g 2)
                          (ct_record 8 kind 0.0 0 0 0 0 shape nd nil 0))))
            (return (coco_m_unify_int e (coco_m_arg e g 2)
                      (tensor_adopt (ct_factory_raw kind shape nd 0.0)))))
          (catch ((const std::exception & ex))
            (cast void ex)
            (return (coco_m_domain_error e "tensor_shape" g)))))))

  ;; tensor_full(+Shape, +V, -T)
  (func t_full ((coco_engine * e) (size_t g)) (out int)
    (let ((llong shape [16]) (double v . 0.0) (int64_t iv . 0))
      (cond
        ((coco_m_float e (coco_m_arg e g 1) (aof v)) (block))
        ((coco_m_int e (coco_m_arg e g 1) (aof iv)) (set v (cast double iv)))
        (#t (return (coco_m_type_error e "number" (coco_m_arg e g 1)))))
      (let ((int nd . #'(shape_arg e (coco_m_arg e g 0) shape 16)))
        (if (< nd 1) (return (coco_m_type_error e "shape" (coco_m_arg e g 0))))
        (try
          (block
            (if (ct_graph_get)
                (return (coco_m_unify_int e (coco_m_arg e g 2)
                          (ct_record 8 4 v 0 0 0 0 shape nd nil 0))))
            (return (coco_m_unify_int e (coco_m_arg e g 2)
                      (tensor_adopt (ct_factory_raw 4 shape nd v)))))
          (catch ((const std::exception & ex))
            (cast void ex)
            (return (coco_m_domain_error e "tensor_shape" g)))))))

  ;; tensor_arange(+N, -T) / tensor_eye(+N, -T) / tensor_randperm(+N, -T)
  (func t_by_count ((coco_engine * e) (size_t g) (int which)) (out int)
    (let ((int64_t n . 0))
      (if (not (coco_m_int e (coco_m_arg e g 0) (aof n)))
          (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
      (if (< n 1) (return (coco_m_domain_error e "positive_integer" (coco_m_arg e g 0))))
      (try
        (block
          ;; arange and eye are deterministic and may wait; randperm draws NOW
          (if (and (ct_graph_get) (< which 2))
              (return (coco_m_unify_int e (coco_m_arg e g 1)
                        (ct_record (? (== which 0) 9 10) 0 0.0 (cast llong n) 0 0 0 nil 0 nil 0))))
          (let ((torch::Tensor * r . nil))
            (cond
              ((== which 0) (set r (ct_arange_raw (cast llong n))))
              ((== which 1) (set r (ct_eye_raw (cast llong n))))
              (#t (set r (ct_randperm_raw (cast llong n)))))
            (return (coco_m_unify_int e (coco_m_arg e g 1) (tensor_adopt r)))))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "tensor_op" g))))))

  (func t_arange ((coco_engine * e) (size_t g)) (out int) (return (t_by_count e g 0)))
  (func t_eye ((coco_engine * e) (size_t g)) (out int) (return (t_by_count e g 1)))
  (func t_randperm ((coco_engine * e) (size_t g)) (out int) (return (t_by_count e g 2)))

  ;; tensor_item(+T, -X): the one element of a one-element tensor
  (func t_item ((coco_engine * e) (size_t g)) (out int)
    (let ((torch::Tensor * a . #'(tensor_of (arg_handle e (coco_m_arg e g 0)))))
      (if (== a nil) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (try
        (block
          (let ((int64_t n . 0)
                (double * buf . #'(tensor_to_doubles (cof a) (aof n))))
            (if (== buf nil) (return 0))
            (if (!= n 1)
                (block (free (cast (void *) buf))
                       (return (coco_m_domain_error e "scalar_tensor" (coco_m_arg e g 0)))))
            (let ((double v . #'(nth 0 buf)))
              (free (cast (void *) buf))
              (return (coco_m_unify_float e (coco_m_arg e g 1) v)))))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return 0)))))

  ;; ---- models ---------------------------------------------------------

  (func act_code ((const char * nm)) (out int)
    (cond
      ((== 0 (strcmp nm "relu")) (return 1))
      ((== 0 (strcmp nm "tanh")) (return 2))
      ((== 0 (strcmp nm "sigmoid")) (return 3))
      ((== 0 (strcmp nm "log_softmax")) (return 4))
      ((== 0 (strcmp nm "none")) (return 0))
      (#t (return -1))))

  ;; one int argument of a compound, or -1
  (func int_arg ((coco_engine * e) (coco_machine * m) (size_t t) (uint32_t i)) (out llong)
    (let ((int64_t v . 0))
      (if (not (coco_m_int e (coco_arg m t i) (aof v))) (return -1))
      (return (cast llong v))))

  ;; model_new(+Spec, -M).
  ;;   Spec = [ input(N) | image(C,H,W),
  ;;            dense(W[,Act]) | conv(F,K[,Act][,pad(P)][,stride(S)])
  ;;          | pool(K[,pad(P)][,stride(S)]) | flatten | dropout(P) | norm,
  ;;            ... ]
  ;; The whole DSL layer set, parsed here and built (with the shape flow
  ;; and its refusals) in ctnet_create.
  (func t_model_new ((coco_engine * e) (size_t g)) (out int)
    (let ((coco_machine * m . #'(coco_m_machine e))
          (size_t * layers . nil) (size_t nlayers . 0)
          (llong enc [256]) (double fenc [32]) (int ok . 1))
      (if (not (coco_m_list_array e (coco_m_arg e g 0) (aof layers) (aof nlayers)))
          (return (coco_m_type_error e "list" (coco_m_arg e g 0))))
      (if (or (< nlayers 2) (> nlayers 32))
          (block (if (!= layers nil) (free (cast (void *) layers)))
                 (return (coco_m_domain_error e "model_spec" (coco_m_arg e g 0)))))
      (let ((size_t i . 0))
        (while (and (< i nlayers) ok)
          (let ((size_t l . #'(coco_deref m (nth i layers)))
                (llong * row . #'(aof (nth (* i 8) enc))))
            (set (nth 0 row) -1) (set (nth 1 row) 0)
            (set (nth 2 row) 0) (set (nth 3 row) 0) (set (nth 4 row) 0)
            (set (nth 5 row) 0) (set (nth 6 row) 0) (set (nth 7 row) 0)
            (set (nth i fenc) 0.0)
            (if (not (coco_is_callable m l))
                (set ok 0)
              (let ((const char * nm . #'(coco_atom_name m (coco_name_of m l)))
                    (uint32_t na . #'(coco_arity m l)))
                (cond
                  ((and (== 0 (strcmp nm "input")) (== na 1))
                   (set (nth 0 row) 0)
                   (set (nth 2 row) (int_arg e m l 0))
                   (if (< (nth 2 row) 1) (set ok 0)))
                  ((and (== 0 (strcmp nm "image")) (== na 3))
                   (set (nth 0 row) 1)
                   (set (nth 2 row) (int_arg e m l 0))
                   (set (nth 3 row) (int_arg e m l 1))
                   (set (nth 4 row) (int_arg e m l 2))
                   (if (or (< (nth 2 row) 1) (or (< (nth 3 row) 1) (< (nth 4 row) 1)))
                       (set ok 0)))
                  ((and (== 0 (strcmp nm "dense")) (and (>= na 1) (<= na 2)))
                   (set (nth 0 row) 2)
                   (set (nth 2 row) (int_arg e m l 0))
                   (if (< (nth 2 row) 1) (set ok 0))
                   (if (== na 2)
                       (let ((size_t at . #'(coco_deref m (coco_arg m l 1))))
                         (if (coco_m_is_atom e at)
                             (set (nth 1 row) (cast llong (act_code (coco_m_atom e at))))
                           (set (nth 1 row) -1))
                         (if (< (nth 1 row) 0) (set ok 0)))))
                  ((and (== 0 (strcmp nm "conv")) (and (>= na 2) (<= na 5)))
                   (set (nth 0 row) 3)
                   (set (nth 2 row) (int_arg e m l 0))
                   (set (nth 3 row) (int_arg e m l 1))
                   (set (nth 5 row) 1)          ;; stride defaults to 1
                   (if (or (< (nth 2 row) 1) (< (nth 3 row) 1)) (set ok 0))
                   (let ((uint32_t k . 2))
                     (while (and (< k na) ok)
                       (let ((size_t a2 . #'(coco_deref m (coco_arg m l k))))
                         (cond
                           ((coco_m_is_atom e a2)
                            (let ((int ac . #'(act_code (coco_m_atom e a2))))
                              (if (< ac 0) (set ok 0) (set (nth 1 row) (cast llong ac)))))
                           ((and (coco_is_callable m a2)
                                 (and (== (coco_arity m a2) 1)
                                      (== 0 (strcmp (coco_atom_name m (coco_name_of m a2)) "pad"))))
                            (set (nth 4 row) (int_arg e m a2 0))
                            (if (< (nth 4 row) 0) (set ok 0)))
                           ((and (coco_is_callable m a2)
                                 (and (== (coco_arity m a2) 1)
                                      (== 0 (strcmp (coco_atom_name m (coco_name_of m a2)) "stride"))))
                            (set (nth 5 row) (int_arg e m a2 0))
                            (if (< (nth 5 row) 1) (set ok 0)))
                           (#t (set ok 0))))
                       (set k (+ k 1)))))
                  ((and (== 0 (strcmp nm "pool")) (and (>= na 1) (<= na 3)))
                   (set (nth 0 row) 4)
                   (set (nth 2 row) (int_arg e m l 0))
                   (if (< (nth 2 row) 1) (set ok 0))
                   (set (nth 4 row) (nth 2 row))  ;; stride defaults to the kernel
                   (let ((uint32_t k . 1))
                     (while (and (< k na) ok)
                       (let ((size_t a2 . #'(coco_deref m (coco_arg m l k))))
                         (cond
                           ((and (coco_is_callable m a2)
                                 (and (== (coco_arity m a2) 1)
                                      (== 0 (strcmp (coco_atom_name m (coco_name_of m a2)) "pad"))))
                            (set (nth 3 row) (int_arg e m a2 0))
                            (if (< (nth 3 row) 0) (set ok 0)))
                           ((and (coco_is_callable m a2)
                                 (and (== (coco_arity m a2) 1)
                                      (== 0 (strcmp (coco_atom_name m (coco_name_of m a2)) "stride"))))
                            (set (nth 4 row) (int_arg e m a2 0))
                            (if (< (nth 4 row) 1) (set ok 0)))
                           (#t (set ok 0))))
                       (set k (+ k 1)))))
                  ((and (== 0 (strcmp nm "flatten")) (== na 0))
                   (set (nth 0 row) 5))
                  ((and (== 0 (strcmp nm "dropout")) (== na 1))
                   (set (nth 0 row) 6)
                   (let ((double p . 0.0) (int64_t ip . 0))
                     (cond
                       ((coco_m_float e (coco_arg m l 0) (aof p)) (set (nth i fenc) p))
                       ((coco_m_int e (coco_arg m l 0) (aof ip)) (set (nth i fenc) (cast double ip)))
                       (#t (set ok 0)))))
                  ((and (== 0 (strcmp nm "norm")) (== na 0))
                   (set (nth 0 row) 7))
                  ((and (== 0 (strcmp nm "sequence")) (== na 1))
                   (set (nth 0 row) 8)
                   (set (nth 2 row) (int_arg e m l 0))
                   (if (< (nth 2 row) 1) (set ok 0)))
                  ((and (== 0 (strcmp nm "embedding")) (== na 2))
                   (set (nth 0 row) 9)
                   (set (nth 2 row) (int_arg e m l 0))
                   (set (nth 3 row) (int_arg e m l 1))
                   (if (or (< (nth 2 row) 1) (< (nth 3 row) 1)) (set ok 0)))
                  ((and (== 0 (strcmp nm "lstm")) (== na 1))
                   (set (nth 0 row) 10)
                   (set (nth 2 row) (int_arg e m l 0))
                   (if (< (nth 2 row) 1) (set ok 0)))

                  ;; attention(Heads) -- ONE pre-norm causal self-attention
                  ;; block with its residual inside it. The width reaching it
                  ;; must divide by Heads, which ctnet_create checks because
                  ;; only it knows what that width is.
                  ((and (== 0 (strcmp nm "attention")) (== na 1))
                   (set (nth 0 row) 11)
                   (set (nth 2 row) (int_arg e m l 0))
                   (if (< (nth 2 row) 1) (set ok 0)))

                  ;; ffn(Width) -- the other half of a transformer block
                  ((and (== 0 (strcmp nm "ffn")) (== na 1))
                   (set (nth 0 row) 12)
                   (set (nth 2 row) (int_arg e m l 0))
                   (if (< (nth 2 row) 1) (set ok 0)))

                  ;; `positional' spans the whole declared sequence;
                  ;; `positional(L)' says how far explicitly. A LEARNED
                  ;; embedding over positions, so it needs no new module type
                  ;; and no trigonometry nobody here can compile to check.
                  ((and (== 0 (strcmp nm "positional")) (== na 0))
                   (set (nth 0 row) 13)
                   (set (nth 2 row) 0))
                  ((and (== 0 (strcmp nm "positional")) (== na 1))
                   (set (nth 0 row) 13)
                   (set (nth 2 row) (int_arg e m l 0))
                   (if (< (nth 2 row) 1) (set ok 0)))
                  (#t (set ok 0))))))
          (set i (+ i 1))))
      (free (cast (void *) layers))
      (if (not ok)
          (return (coco_m_domain_error e "model_spec" (coco_m_arg e g 0))))
      (try
        (block
          (let (((struct CtNet) * net . #'(ctnet_create enc fenc (cast int nlayers))))
            (if (== net nil)
                (return (coco_m_domain_error e "model_spec" (coco_m_arg e g 0))))
            (let ((llong i . 1))
              (while (< i 256)
                (if (== (nth i ct_models) nil)
                    (block
                      (set (nth i ct_models) net)
                      (return (coco_m_unify_int e (coco_m_arg e g 1) i))))
                (set i (+ i 1))))
            (ctnet_free_raw net)
            (return (coco_m_domain_error e "model_table" g))))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "model_spec" (coco_m_arg e g 0)))))))

  ;; model_spec(+M, -Spec): every layer back as its full canonical term
  (func t_model_spec ((coco_engine * e) (size_t g)) (out int)
    (let (((struct CtNet) * net . #'(model_of (arg_handle e (coco_m_arg e g 0)))))
      (if (== net nil) (return (coco_m_domain_error e "model" (coco_m_arg e g 0))))
      (let ((coco_machine * m . #'(coco_m_machine e))
            (llong enc [256]) (double fenc [32]) (size_t cells [32])
            (int n . #'(ctnet_nspec net))
            (const char * anames [5]))
        (set (nth 0 anames) "none") (set (nth 1 anames) "relu")
        (set (nth 2 anames) "tanh") (set (nth 3 anames) "sigmoid")
        (set (nth 4 anames) "log_softmax")
        (ctnet_spec_out net enc fenc)
        (let ((int i . 0))
          (while (< i n)
            (let ((llong * row . #'(aof (nth (* i 8) enc)))
                  (llong kind . #'(nth 0 row)))
              (cond
                ((== kind 0)
                 (set (nth i cells) (coco_make1 m "input" (coco_new_int m (nth 2 row)))))
                ((== kind 1)
                 (let ((size_t args [3]))
                   (set (nth 0 args) (coco_new_int m (nth 2 row)))
                   (set (nth 1 args) (coco_new_int m (nth 3 row)))
                   (set (nth 2 args) (coco_new_int m (nth 4 row)))
                   (set (nth i cells) (coco_make m "image" 3 args))))
                ((== kind 2)
                 (set (nth i cells)
                      (coco_make2 m "dense" (coco_new_int m (nth 2 row))
                                  (coco_new_atom m (nth (nth 1 row) anames)))))
                ((== kind 3)
                 (let ((size_t args [5]))
                   (set (nth 0 args) (coco_new_int m (nth 2 row)))
                   (set (nth 1 args) (coco_new_int m (nth 3 row)))
                   (set (nth 2 args) (coco_new_atom m (nth (nth 1 row) anames)))
                   (set (nth 3 args) (coco_make1 m "pad" (coco_new_int m (nth 4 row))))
                   (set (nth 4 args) (coco_make1 m "stride" (coco_new_int m (nth 5 row))))
                   (set (nth i cells) (coco_make m "conv" 5 args))))
                ((== kind 4)
                 (let ((size_t args [3]))
                   (set (nth 0 args) (coco_new_int m (nth 2 row)))
                   (set (nth 1 args) (coco_make1 m "pad" (coco_new_int m (nth 3 row))))
                   (set (nth 2 args) (coco_make1 m "stride" (coco_new_int m (nth 4 row))))
                   (set (nth i cells) (coco_make m "pool" 3 args))))
                ((== kind 5) (set (nth i cells) (coco_new_atom m "flatten")))
                ((== kind 6)
                 (set (nth i cells) (coco_make1 m "dropout" (coco_new_float m (nth i fenc)))))
                ((== kind 7) (set (nth i cells) (coco_new_atom m "norm")))
                ((== kind 8)
                 (set (nth i cells) (coco_make1 m "sequence" (coco_new_int m (nth 2 row)))))
                ((== kind 9)
                 (set (nth i cells)
                      (coco_make2 m "embedding" (coco_new_int m (nth 2 row))
                                  (coco_new_int m (nth 3 row)))))
                ((== kind 10)
                 (set (nth i cells) (coco_make1 m "lstm" (coco_new_int m (nth 2 row)))))
                ((== kind 11)
                 (set (nth i cells) (coco_make1 m "attention" (coco_new_int m (nth 2 row)))))
                ((== kind 12)
                 (set (nth i cells) (coco_make1 m "ffn" (coco_new_int m (nth 2 row)))))
                ;; RE-EMITTED WITH ITS LENGTH, never bare. ctnet_create filled
                ;; L.a in from in_seq when the caller wrote `positional', and
                ;; model_load rebuilds from THIS term -- a bare atom here would
                ;; rebuild an embedding of length zero and model_set_params
                ;; would then not line up with the saved parameters.
                ((== kind 13)
                 (set (nth i cells) (coco_make1 m "positional" (coco_new_int m (nth 2 row)))))
                (#t (set (nth i cells) (coco_new_atom m "unknown")))))
            (set i (+ i 1))))
        (return (coco_m_unify e (coco_m_arg e g 1)
                              (coco_m_list e cells (cast size_t n)))))))

  ;; model_train(+M, +X, +Y, +Options): epochs(N) batch(N) lr(F)
  ;; optimiser(adam|sgd) loss(mse|nll|cross_entropy|bce)
  ;; shuffle(true|false) schedule(step, Every, Gamma) final_loss(-L)
  (func t_model_train ((coco_engine * e) (size_t g)) (out int)
    (let (((struct CtNet) * net . #'(model_of (arg_handle e (coco_m_arg e g 0))))
          (torch::Tensor * xp . #'(tensor_of (arg_handle e (coco_m_arg e g 1))))
          (torch::Tensor * yp . #'(tensor_of (arg_handle e (coco_m_arg e g 2))))
          (coco_machine * m . #'(coco_m_machine e))
          (int64_t epochs . 10) (int64_t batch . 100) (double lr . 0.001)
          (int opt . 0) (int loss . 0) (int shuffle . 0)
          (llong sched_every . 0) (double sched_gamma . 1.0)
          (size_t loss_out . 0) (int ok . 1))
      (if (or (== net nil) (or (== xp nil) (== yp nil)))
          (return (coco_m_domain_error e "model_or_tensor" g)))
      (let ((size_t * opts . nil) (size_t nopts . 0))
        (if (not (coco_m_list_array e (coco_m_arg e g 3) (aof opts) (aof nopts)))
            (return (coco_m_type_error e "list" (coco_m_arg e g 3))))
        (let ((size_t i . 0))
          (while (and (< i nopts) ok)
            (let ((size_t o . #'(coco_deref m (nth i opts))))
              (if (not (coco_is_callable m o))
                  (set ok 0)
                (let ((const char * nm . #'(coco_atom_name m (coco_name_of m o)))
                      (uint32_t na . #'(coco_arity m o)))
                  (cond
                    ((and (== 0 (strcmp nm "epochs")) (== na 1))
                     (if (not (coco_m_int e (coco_arg m o 0) (aof epochs))) (set ok 0)))
                    ((and (== 0 (strcmp nm "batch")) (== na 1))
                     (if (not (coco_m_int e (coco_arg m o 0) (aof batch))) (set ok 0)))
                    ((and (== 0 (strcmp nm "lr")) (== na 1))
                     (if (not (coco_m_float e (coco_arg m o 0) (aof lr))) (set ok 0)))
                    ((and (== 0 (strcmp nm "optimiser")) (== na 1))
                     (let ((const char * v . #'(coco_m_atom e (coco_arg m o 0))))
                       (cond ((== v nil) (set ok 0))
                             ((== 0 (strcmp v "adam")) (set opt 0))
                             ((== 0 (strcmp v "sgd")) (set opt 1))
                             (#t (set ok 0)))))
                    ((and (== 0 (strcmp nm "loss")) (== na 1))
                     (let ((const char * v . #'(coco_m_atom e (coco_arg m o 0))))
                       (cond ((== v nil) (set ok 0))
                             ((== 0 (strcmp v "mse")) (set loss 0))
                             ((== 0 (strcmp v "nll")) (set loss 1))
                             ((== 0 (strcmp v "cross_entropy")) (set loss 2))
                             ((== 0 (strcmp v "bce")) (set loss 3))
                             (#t (set ok 0)))))
                    ((and (== 0 (strcmp nm "shuffle")) (== na 1))
                     (let ((const char * v . #'(coco_m_atom e (coco_arg m o 0))))
                       (cond ((== v nil) (set ok 0))
                             ((== 0 (strcmp v "true")) (set shuffle 1))
                             ((== 0 (strcmp v "false")) (set shuffle 0))
                             (#t (set ok 0)))))
                    ((and (== 0 (strcmp nm "schedule")) (== na 3))
                     ;; schedule(step, Every, Gamma) -- multiply the lr by
                     ;; Gamma every Every epochs
                     (let ((const char * v . #'(coco_m_atom e (coco_arg m o 0)))
                           (int64_t ev . 0))
                       (if (or (== v nil) (!= 0 (strcmp v "step"))) (set ok 0)
                         (block
                           (if (not (coco_m_int e (coco_arg m o 1) (aof ev))) (set ok 0))
                           (set sched_every (cast llong ev))
                           (if (not (coco_m_float e (coco_arg m o 2) (aof sched_gamma)))
                               (set ok 0))))))
                    ((and (== 0 (strcmp nm "final_loss")) (== na 1))
                     (set loss_out (coco_arg m o 0)))
                    (#t (set ok 0))))))
            (set i (+ i 1))))
        (if (!= opts nil) (free (cast (void *) opts)))
        (if (not ok) (return (coco_m_domain_error e "train_options" (coco_m_arg e g 3)))))
      (try
        (block
          (let ((double fl . 0.0))
            (if (not (ctnet_train_raw net xp yp (cast int epochs) (cast int batch)
                                      opt lr loss shuffle sched_every sched_gamma (aof fl)))
                (return (coco_m_domain_error e "training" g)))
            (if (!= loss_out 0)
                (if (not (coco_m_unify_float e loss_out fl)) (return 0)))
            (return 1)))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "training" g))))))

  ;; model_predict(+M, +X, -T)
  (func t_model_predict ((coco_engine * e) (size_t g)) (out int)
    (let (((struct CtNet) * net . #'(model_of (arg_handle e (coco_m_arg e g 0))))
          (torch::Tensor * xp . #'(tensor_of (arg_handle e (coco_m_arg e g 1)))))
      (if (or (== net nil) (== xp nil))
          (return (coco_m_domain_error e "model_or_tensor" g)))
      (try
        (block
          (let ((torch::Tensor * out . #'(ctnet_predict_raw net xp)))
            (return (coco_m_unify_int e (coco_m_arg e g 2) (tensor_adopt out)))))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "prediction" g))))))

  ;; model_evaluate(+M, +X, +Y, +Metric, -Score): rmse | accuracy | mae
  (func t_model_eval ((coco_engine * e) (size_t g)) (out int)
    (let (((struct CtNet) * net . #'(model_of (arg_handle e (coco_m_arg e g 0))))
          (torch::Tensor * xp . #'(tensor_of (arg_handle e (coco_m_arg e g 1))))
          (torch::Tensor * yp . #'(tensor_of (arg_handle e (coco_m_arg e g 2))))
          (const char * metric . #'(coco_m_atom e (coco_m_arg e g 3)))
          (int mc . -1))
      (if (or (== net nil) (or (== xp nil) (== yp nil)))
          (return (coco_m_domain_error e "model_or_tensor" g)))
      (if (== metric nil)
          (return (coco_m_type_error e "atom" (coco_m_arg e g 3))))
      (cond
        ((== 0 (strcmp metric "rmse")) (set mc 0))
        ((== 0 (strcmp metric "accuracy")) (set mc 1))
        ((== 0 (strcmp metric "mae")) (set mc 2))
        (#t (return (coco_m_domain_error e "metric" (coco_m_arg e g 3)))))
      (try
        (block
          (let ((double score . 0.0))
            (if (not (ctnet_eval_raw net xp yp mc (aof score)))
                (return (coco_m_domain_error e "evaluation" g)))
            (return (coco_m_unify_float e (coco_m_arg e g 4) score))))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "evaluation" g))))))

  ;; model_params(+M, -List): parameters AND buffers, flattened -- plain
  ;; terms, the shape the knowledge base stores
  (func t_model_params ((coco_engine * e) (size_t g)) (out int)
    (let (((struct CtNet) * net . #'(model_of (arg_handle e (coco_m_arg e g 0)))))
      (if (== net nil) (return (coco_m_domain_error e "model" (coco_m_arg e g 0))))
      (try
        (block
          (let ((coco_machine * m . #'(coco_m_machine e))
                (llong total . #'(ctnet_nparams net)))
            (let ((double * buf . #'(cast (double *) (malloc (* (cast size_t total) (sizeof double)))))
                  (size_t * cells . #'(cast (size_t *) (malloc (* (cast size_t total) (sizeof size_t))))))
              (if (not (ctnet_read_params net buf total))
                  (block (free (cast (void *) buf))
                         (free (cast (void *) cells))
                         (return 0)))
              (let ((llong k . 0))
                (while (< k total)
                  (set (nth k cells) (coco_new_float m (nth k buf)))
                  (set k (+ k 1))))
              (let ((size_t lst . #'(coco_m_list e cells (cast size_t total))))
                (free (cast (void *) cells))
                (free (cast (void *) buf))
                (return (coco_m_unify e (coco_m_arg e g 1) lst))))))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return 0)))))

  ;; model_set_params(+M, +List): the inverse, under no_grad
  (func t_model_set_params ((coco_engine * e) (size_t g)) (out int)
    (let (((struct CtNet) * net . #'(model_of (arg_handle e (coco_m_arg e g 0))))
          (size_t * cells . nil) (size_t n . 0))
      (if (== net nil) (return (coco_m_domain_error e "model" (coco_m_arg e g 0))))
      (if (not (coco_m_list_array e (coco_m_arg e g 1) (aof cells) (aof n)))
          (return (coco_m_type_error e "list" (coco_m_arg e g 1))))
      (let ((double * buf . #'(cast (double *) (malloc (* n (sizeof double)))))
            (int ok . 1))
        (let ((size_t i . 0))
          (while (< i n)
            (let ((double v . 0.0) (int64_t iv . 0))
              (cond
                ((coco_m_float e (nth i cells) (aof v)) (set (nth i buf) v))
                ((coco_m_int e (nth i cells) (aof iv)) (set (nth i buf) (cast double iv)))
                (#t (set ok 0))))
            (set i (+ i 1))))
        (free (cast (void *) cells))
        (if (not ok)
            (block (free (cast (void *) buf))
                   (return (coco_m_type_error e "number_list" (coco_m_arg e g 1)))))
        (try
          (block
            (let ((int fit . #'(ctnet_write_params net buf (cast llong n))))
              (free (cast (void *) buf))
              (if (not fit)
                  (return (coco_m_domain_error e "parameter_count" (coco_m_arg e g 1))))
              (return 1)))
          (catch ((const std::exception & ex))
            (cast void ex)
            (free (cast (void *) buf))
            (return 0))))))

  ;; '$tensor_save'(+Name, +Params): the parameters into the store's tensors
  ;; table -- rows of one vector field, 512 doubles to a piece, the name and
  ;; the seq saying which tensor and which piece. Fails cleanly when the
  ;; arrangement has no tensor storage (the hooks are null), which is what
  ;; sends model_save into the clause-chunk fallback; a wire failure
  ;; mid-save also fails, and the turn's transaction takes the partial rows
  ;; back with it.
  (func t_tensor_save ((coco_engine * e) (size_t g)) (out int)
    (let ((size_t nt . #'(coco_m_arg e g 0))
          (size_t * cells . nil) (size_t n . 0))
      (if (not (coco_m_is_atom e nt)) (return 0))
      (let ((const char * name . #'(coco_m_atom e nt)))
        ;; the probe doubles as the clear: no tensor storage answers 0 here,
        ;; BEFORE anything is written
        (if (not (coco_m_tensor_forget e name)) (return 0))
        (if (not (coco_m_list_array e (coco_m_arg e g 1) (aof cells) (aof n)))
            (return 0))
        (let ((double * buf . #'(cast (double *) (malloc (* (? (== n 0) 1 n) (sizeof double)))))
              (int ok . 1))
          (if (== buf nil)
              (block (free (cast (void *) cells)) (return 0)))
          (let ((size_t i . 0))
            (while (< i n)
              (let ((double v . 0.0) (int64_t iv . 0))
                (cond
                  ((coco_m_float e (nth i cells) (aof v)) (set (nth i buf) v))
                  ((coco_m_int e (nth i cells) (aof iv)) (set (nth i buf) (cast double iv)))
                  (#t (set ok 0))))
              (set i (+ i 1))))
          (free (cast (void *) cells))
          (if (not ok)
              (block (free (cast (void *) buf)) (return 0)))
          (let ((size_t off . 0) (int64_t seq . 0))
            (while (and ok (< off n))
              (let ((size_t take . #'(? (> (- n off) 512) 512 (- n off))))
                (if (not (coco_m_tensor_put e name seq (aof (nth off buf))
                                            (cast uint32_t take)))
                    (set ok 0))
                (set off (+ off take))
                (set seq (+ seq 1))))
            ;; an empty parameter list still records one empty piece, so a
            ;; loader can tell "saved empty" from "not there at all"
            (if (and ok (== n 0))
                (if (not (coco_m_tensor_put e name 0 buf 0)) (set ok 0))))
          (free (cast (void *) buf))
          (return ok)))))

  ;; '$tensor_load'(+Name, -Params): the inverse -- the pieces back in seq
  ;; order until one is not there, joined flat, as a list of floats. Fails
  ;; when the arrangement has no tensor storage or the name has no rows,
  ;; which is what sends model_load into the clause-chunk fallback.
  (func t_tensor_load ((coco_engine * e) (size_t g)) (out int)
    (let ((size_t nt . #'(coco_m_arg e g 0)))
      (if (not (coco_m_is_atom e nt)) (return 0))
      (let ((const char * name . #'(coco_m_atom e nt))
            (double * buf . nil) (size_t n . 0) (size_t cap . 0)
            (double piece [512]) (uint32_t pn . 0) (int64_t seq . 0)
            (int any . 0) (int ok . 1))
        (while (and ok (coco_m_tensor_row e name seq piece 512 (aof pn)))
          (set any 1)
          (if (> (+ n (cast size_t pn)) cap)
              (let ((size_t ncap . #'(? (== cap 0) 1024 (* cap 2))))
                (while (> (+ n (cast size_t pn)) ncap) (set ncap (* ncap 2)))
                (let ((double * nb . #'(cast (double *) (realloc (cast (void *) buf)
                                                                 (* ncap (sizeof double))))))
                  (if (== nb nil) (set ok 0) (block (set buf nb) (set cap ncap))))))
          (if ok
              (block
               (memcpy (aof (nth n buf)) piece (* (cast size_t pn) (sizeof double)))
               (set n (+ n (cast size_t pn)))))
          (set seq (+ seq 1))
          (if (== pn 0) break))
        (if (or (not ok) (not any))
            (block (free (cast (void *) buf)) (return 0)))
        (let ((coco_machine * m . #'(coco_m_machine e))
              (size_t * cells . #'(cast (size_t *) (malloc (* (? (== n 0) 1 n) (sizeof size_t))))))
          (if (== cells nil)
              (block (free (cast (void *) buf)) (return 0)))
          (let ((size_t k . 0))
            (while (< k n)
              (set (nth k cells) (coco_new_float m (nth k buf)))
              (set k (+ k 1))))
          (let ((size_t lst . #'(coco_m_list e cells n)))
            (free (cast (void *) cells))
            (free (cast (void *) buf))
            (return (coco_m_unify e (coco_m_arg e g 1) lst)))))))

  ;; model_free(+M)
  (func t_model_free ((coco_engine * e) (size_t g)) (out int)
    (let ((llong h . #'(arg_handle e (coco_m_arg e g 0)))
          ((struct CtNet) * net . #'(model_of (arg_handle e (coco_m_arg e g 0)))))
      (if (== net nil) (return 0))
      (ctnet_free_raw net)
      (set (nth h ct_models) nil)
      (return 1)))

  ;; ---- devices ---------------------------------------------------------

  ;; torch_device(+D): cpu | cuda | cuda(N) | auto. `auto' takes cuda when
  ;; there is one and cpu otherwise, which is what a script that runs on
  ;; both kinds of machine wants; naming cuda on a machine without one is
  ;; a domain error, not a silent fallback. The choice governs where the
  ;; NEXT model_new builds; models already built keep their device.
  (func t_device ((coco_engine * e) (size_t g)) (out int)
    (let ((coco_machine * m . #'(coco_m_machine e))
          (size_t d . #'(coco_deref m (coco_m_arg e g 0))))
      (if (coco_m_is_atom e d)
          (let ((const char * nm . #'(coco_m_atom e d)))
            (cond
              ((== 0 (strcmp nm "cpu"))
               (if (ct_set_device 0 0) (return 1) (return 0)))
              ((== 0 (strcmp nm "auto"))
               (if (ct_set_device 2 0) (return 1) (return 0)))
              ((== 0 (strcmp nm "cuda"))
               (if (ct_set_device 1 0) (return 1)
                 (return (coco_m_domain_error e "cuda_available" d))))
              (#t (return (coco_m_domain_error e "device" d))))))
      (if (and (coco_is_callable m d)
               (and (== (coco_arity m d) 1)
                    (== 0 (strcmp (coco_atom_name m (coco_name_of m d)) "cuda"))))
          (let ((int64_t ix . 0))
            (if (not (coco_m_int e (coco_arg m d 0) (aof ix)))
                (return (coco_m_type_error e "integer" (coco_arg m d 0))))
            (if (ct_set_device 1 (cast llong ix)) (return 1)
              (return (coco_m_domain_error e "cuda_available" d)))))
      (return (coco_m_domain_error e "device" d))))

  ;; torch_cuda_available(-B): true | false
  (func t_cuda_available ((coco_engine * e) (size_t g)) (out int)
    (let ((coco_machine * m . #'(coco_m_machine e)))
      (return (coco_m_unify e (coco_m_arg e g 0)
                (coco_new_atom m (? (ct_cuda_available) "true" "false"))))))

  ;; torch_cuda_count(-N)
  (func t_cuda_count ((coco_engine * e) (size_t g)) (out int)
    (return (coco_m_unify_int e (coco_m_arg e g 0) (ct_cuda_count))))

  ;; torch_current_device(-D): cpu or cuda(N)
  (func t_current_device ((coco_engine * e) (size_t g)) (out int)
    (let ((coco_machine * m . #'(coco_m_machine e))
          (llong ix . 0))
      (if (ct_current_device (aof ix))
          (return (coco_m_unify e (coco_m_arg e g 0)
                    (coco_make1 m "cuda" (coco_new_int m (cast int64_t ix)))))
        (return (coco_m_unify e (coco_m_arg e g 0) (coco_new_atom m "cpu"))))))

  ;; ---- the graph path's own predicates ---------------------------------

  ;; THE BACKEND SEAM. The tensor_* predicates are one surface with two
  ;; implementations: this file, libtorch, and -- on Linux, when
  ;; library(tensorflow) is loaded -- TensorFlow's C library. That module
  ;; registers its dispatcher here through coco_tensor_backend_set, and while
  ;; tensor_execution(tensorflow, _) is in force every tensor_* call is handed
  ;; to it. The model_* predicates stay libtorch's. Asking for tensorflow with
  ;; no backend registered is a domain error, not a silent fallback.
  (code "typedef int (*coco_tensor_dispatch_t)(struct coco_engine*, const char*, uint32_t, size_t, int*);")
  (code "typedef int (*ct_entry_t)(void);")
  (static) (var int ct_backend . 0)                      ; 0 torch, 1 tensorflow
  (static) (var coco_tensor_dispatch_t ct_backend_dispatch . nil)
  (static) (var const char * ct_backend_names [2] . '{ "torch" "tensorflow" })
  (static) (func ct_backend_name () (out const char *) (return (nth ct_backend ct_backend_names)))
  ;; C LINKAGE: library(tensorflow) finds these by name. What is defined
  ;; inside the block is reached by name from outside it only through a
  ;; function defined outside, which is what ct_backend_name is.
  (extern-c
    (func coco_tensor_backend_set ((const char * name) (coco_tensor_dispatch_t fn)) (out int)
      (if (and (!= name nil) (== 0 (strcmp name "tensorflow")))
          (block (set ct_backend_dispatch fn) (return 1)))
      (return 0))
    (func coco_tensor_backend_name () (out const char *) (return (ct_backend_name)))
    (func coco_tensor_graph_mode () (out int) (return ct_graph_mode)))
  (static) (func ct_backend_active () (out int)
    (return (? (and (== ct_backend 1) (!= ct_backend_dispatch nil)) 1 0)))
  (static) (func ct_backend_loaded () (out int) (return (? (!= ct_backend_dispatch nil) 1 0)))
  (static) (func ct_backend_select ((int b)) (set ct_backend b))
  (static) (func ct_backend_forward ((coco_engine * e) (const char * name) (uint32_t arity) (size_t g) (int * found)) (out int)
    (return (ct_backend_dispatch e name arity g found)))
  ;; ON DEMAND: asked for tensorflow with no backend registered, look for
  ;; tensorflow.so beside this module and let it register itself -- so a file
  ;; that names only library(torch) runs on either library from one source.
  (include <dlfcn.h>)
  (import "lib/cpp/dl.cicili")
  (static) (func ct_backend_try_load () (out int)
    (let ((Dl_info info))
      (if (== 0 (dladdr (cast (void *) ct_backend_active) (aof info))) (return 0))
      (if (== ($ info dli_fname) nil) (return 0))
      (let ((char path [4096]))
        (snprintf path 4096 "%s" ($ info dli_fname))
        (let ((char * slash . #'(strrchr path 47)))
          (if (== slash nil) (return 0))
          (snprintf (+ slash 1) (- 4096 (cast size_t (- (+ slash 1) path))) "tensorflow.so")
          (let ((void * h . #'(dlopen path (bitor RTLD_NOW RTLD_GLOBAL))))
            (if (== h nil) (return 0))
            (let ((ct_entry_t entry . #'(cast ct_entry_t (dlsym h "coco_library_entry"))))
              (if (== entry nil) (return 0))
              (if (and (entry) (!= ct_backend_dispatch nil)) (return 1))
              (return 0)))))))

  ;; tensor_execution(?Backend, ?Mode) and tensor_execution(?Mode): Backend is
  ;; torch | tensorflow, Mode is eager | graph; unbound asks. Module state,
  ;; like torch_device/1; it governs what the NEXT producer does. The one-
  ;; argument form sets or asks the mode and leaves the backend as it is.
  ;; (torch_execution/1 is the old name and still answers.)
  (func t_execution_mode ((coco_engine * e) (size_t d)) (out int)
    (let ((coco_machine * m . #'(coco_m_machine e)))
      (if (coco_m_is_atom e d)
          (let ((const char * nm . #'(coco_m_atom e d)))
            (cond
              ((== 0 (strcmp nm "eager")) (ct_graph_set 0) (return 1))
              ((== 0 (strcmp nm "graph")) (ct_graph_set 1) (return 1))
              (#t (return (coco_m_domain_error e "tensor_execution" d))))))
      (return (coco_m_unify e d (coco_new_atom m (? (ct_graph_get) "graph" "eager"))))))
  (func t_execution ((coco_engine * e) (size_t g)) (out int)
    (let ((coco_machine * m . #'(coco_m_machine e)))
      (return (t_execution_mode e (coco_deref m (coco_m_arg e g 0))))))
  (func t_execution2 ((coco_engine * e) (size_t g)) (out int)
    (let ((coco_machine * m . #'(coco_m_machine e))
          (size_t b . #'(coco_deref m (coco_m_arg e g 0))))
      (if (coco_m_is_atom e b)
          (let ((const char * nm . #'(coco_m_atom e b)))
            (cond
              ((== 0 (strcmp nm "torch")) (ct_backend_select 0))
              ((== 0 (strcmp nm "tensorflow"))
               (if (and (not (ct_backend_loaded)) (not (ct_backend_try_load)))
                   (return (coco_m_domain_error e "tensor_backend_loaded" b)))
               (ct_backend_select 1))
              (#t (return (coco_m_domain_error e "tensor_backend" b)))))
        (if (not (coco_m_unify e b (coco_new_atom m (ct_backend_name)))) (return 0)))
      (return (t_execution_mode e (coco_deref m (coco_m_arg e g 1))))))

  ;; tensor_execution(?Backend, ?Mode, ?Device): the device third -- cpu | cuda
  ;; | auto sets where the NEXT producer runs, unbound asks. `auto' takes cuda
  ;; when there is one; `cuda' on a machine without one goes to the CPU and
  ;; SAYS SO, once per call, where torch_device/1 refuses -- a file that names
  ;; cuda runs everywhere, and the notice tells the reader why it is slow. On
  ;; tensorflow the device is that module's to set, so the call goes on to it.
  ;; ONE CARE: library(tensor_expr)'s nonterminal tensor_execution//1 is, once
  ;; the grammar is translated, a clause tensor_execution(Mode, S0, S) -- three
  ;; arguments too. That shape has a mode where a backend would be, or a list
  ;; where a mode would be; it is not this predicate's call, and is handed
  ;; back to the clauses by answering `not found'.
  (func t_execution3 ((coco_engine * e) (size_t g) (int * found)) (out int)
    (let ((coco_machine * m . #'(coco_m_machine e))
          (size_t a0 . #'(coco_deref m (coco_m_arg e g 0)))
          (size_t a1 . #'(coco_deref m (coco_m_arg e g 1)))
          (size_t d . #'(coco_deref m (coco_m_arg e g 2)))
          (size_t * cells . nil) (size_t ncells . 0)
          (int fwd . 0))
      (if (and (coco_m_is_atom e a0)
               (or (== 0 (strcmp (coco_m_atom e a0) "eager")) (== 0 (strcmp (coco_m_atom e a0) "graph"))))
          (block (set (cof found) 0) (return 0)))
      (if (coco_m_list_array e a1 (aof cells) (aof ncells))
          (block (if (!= cells nil) (free (cast (void *) cells))) (set (cof found) 0) (return 0)))
      (if (not (t_execution2 e g)) (return 0))
      (if (ct_backend_active) (return (ct_backend_forward e "tensor_execution" 3 g (aof fwd))))
      (if (coco_m_is_atom e d)
          (let ((const char * nm . #'(coco_m_atom e d)))
            (cond
              ((== 0 (strcmp nm "cpu"))  (ct_set_device 0 0) (return 1))
              ((== 0 (strcmp nm "auto")) (ct_set_device 2 0) (return 1))
              ((== 0 (strcmp nm "cuda"))
               (if (not (ct_set_device 1 0))
                   (block (ct_set_device 0 0)
                          (fprintf stderr "cocolog: tensor_execution: no cuda for torch on this machine -- running on cpu\n")))
               (return 1))
              (#t (return (coco_m_domain_error e "device" d))))))
      (let ((llong ix . 0))
        (return (coco_m_unify e d (coco_new_atom m (? (ct_current_device (aof ix)) "cuda" "cpu")))))))

  ;; tensor_force(+T): execute what T depends on, now
  (func t_force ((coco_engine * e) (size_t g)) (out int)
    (let ((llong h . #'(cast llong (arg_handle e (coco_m_arg e g 0)))))
      (if (not (ct_slot_exists h)) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (try
        (return (ct_slot_force h))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "tensor_op" g))))))

  ;; tensor_graph_stats(-S): stats(recorded(N), executed(M), replayed(R), pending(P))
  (func t_graph_stats ((coco_engine * e) (size_t g)) (out int)
    (let ((coco_machine * m . #'(coco_m_machine e))
          (llong rec . 0) (llong exe . 0) (llong rep . 0) (llong pend . 0)
          (size_t args [4]))
      (ct_graph_stats (aof rec) (aof exe) (aof rep) (aof pend))
      (set (nth 0 args) (coco_make1 m "recorded" (coco_new_int m (cast int64_t rec))))
      (set (nth 1 args) (coco_make1 m "executed" (coco_new_int m (cast int64_t exe))))
      (set (nth 2 args) (coco_make1 m "replayed" (coco_new_int m (cast int64_t rep))))
      (set (nth 3 args) (coco_make1 m "pending" (coco_new_int m (cast int64_t pend))))
      (return (coco_m_unify e (coco_m_arg e g 0) (coco_make m "stats" 4 args)))))

  ;; ---- autograd through what was recorded (phase 2) ----------------------

  ;; tensor_agg(+Op, +T, -T2): sum mean max min std, as a ONE-ELEMENT TENSOR
  ;; rather than a number -- tensor_reduce/3 answers a number, and a number
  ;; cannot be differentiated. Recordable, like every other producer.
  (func t_agg ((coco_engine * e) (size_t g)) (out int)
    (let ((const char * nm . #'(coco_m_atom e (coco_m_arg e g 0)))
          (llong ha . #'(cast llong (arg_handle e (coco_m_arg e g 1))))
          (const char * ops [5]))
      (set (nth 0 ops) "sum") (set (nth 1 ops) "mean") (set (nth 2 ops) "max")
      (set (nth 3 ops) "min") (set (nth 4 ops) "std")
      (if (== nm nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
      (if (not (ct_slot_exists ha)) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 1))))
      (let ((int op . #'(op_code nm ops 5)))
        (if (< op 0) (return (coco_m_domain_error e "tensor_op" (coco_m_arg e g 0))))
        (try
          (block
            (if (ct_graph_get)
                (let ((llong ins [1]))
                  (set (nth 0 ins) ha)
                  (return (coco_m_unify_int e (coco_m_arg e g 2)
                            (ct_record 14 op 0.0 0 0 0 0 nil 0 ins 1)))))
            (let ((torch::Tensor * r . #'(ct_agg_raw op (tensor_of (cast int64_t ha)))))
              (if (== r nil) (return 0))
              (return (coco_m_unify_int e (coco_m_arg e g 2) (tensor_adopt r)))))
          (catch ((const std::exception & ex))
            (cast void ex)
            (return (coco_m_domain_error e "tensor_op" g)))))))

  ;; tensor_parameter(+T0, -T): a fresh leaf that requires grad, with T0's
  ;; values; T0 is untouched. Executes now in both paths -- it is a leaf.
  (func t_parameter ((coco_engine * e) (size_t g)) (out int)
    (let ((llong h . #'(cast llong (arg_handle e (coco_m_arg e g 0)))))
      (if (not (ct_slot_exists h)) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (try
        (let ((llong p . #'(ct_parameter h)))
          (if (< p 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
          (return (coco_m_unify_int e (coco_m_arg e g 1) p)))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "tensor_op" g))))))

  ;; tensor_step(+P, +G, +LR, -P2): P2 = P - LR*G, a fresh leaf that requires
  ;; grad. P is not mutated: a program threads P2 into its next step.
  (func t_step ((coco_engine * e) (size_t g)) (out int)
    (let ((llong hp . #'(cast llong (arg_handle e (coco_m_arg e g 0))))
          (llong hg . #'(cast llong (arg_handle e (coco_m_arg e g 1))))
          (double lr . 0.0) (int64_t ilr . 0))
      (if (or (not (ct_slot_exists hp)) (not (ct_slot_exists hg)))
          (return (coco_m_domain_error e "tensor" g)))
      (cond
        ((coco_m_float e (coco_m_arg e g 2) (aof lr)) (block))
        ((coco_m_int e (coco_m_arg e g 2) (aof ilr)) (set lr (cast double ilr)))
        (#t (return (coco_m_type_error e "number" (coco_m_arg e g 2)))))
      (try
        (let ((llong p . #'(ct_step hp hg lr)))
          (if (< p 0) (return (coco_m_domain_error e "tensor" g)))
          (return (coco_m_unify_int e (coco_m_arg e g 3) p)))
        (catch ((const std::exception & ex))
          (cast void ex)
          (return (coco_m_domain_error e "tensor_op" g))))))

  ;; tensor_grad(+Loss, +Params, -Grads): d Loss / d each parameter, one
  ;; tensor per parameter, in order. Loss is forced first, which is what
  ;; builds the tape under the graph path; a parameter Loss never touched
  ;; answers zeros of its shape.
  (func t_grad ((coco_engine * e) (size_t g)) (out int)
    (let ((llong hl . #'(cast llong (arg_handle e (coco_m_arg e g 0))))
          (size_t * cells . nil) (size_t n . 0)
          (llong hps [64]) (llong outs [64]) (size_t items [64])
          (coco_machine * m . #'(coco_m_machine e)))
      (if (not (ct_slot_exists hl)) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (not (coco_m_list_array e (coco_m_arg e g 1) (aof cells) (aof n)))
          (return (coco_m_type_error e "list" (coco_m_arg e g 1))))
      (if (or (== n 0) (> n 64))
          (block (if (!= cells nil) (free (cast (void *) cells)))
                 (return (coco_m_domain_error e "tensor_list" (coco_m_arg e g 1)))))
      (let ((size_t i . 0) (int ok . 1))
        (while (< i n)
          (let ((llong h . #'(cast llong (arg_handle e (nth i cells)))))
            (if (not (ct_slot_exists h)) (set ok 0) (set (nth i hps) h)))
          (set i (+ i 1)))
        (free (cast (void *) cells))
        (if (not ok) (return (coco_m_domain_error e "tensor_list" (coco_m_arg e g 1))))
        (try
          (let ((int rc . #'(ct_grad hl hps (cast int n) outs)))
            (cond
              ((== rc -2) (return (coco_m_domain_error e "scalar_tensor" (coco_m_arg e g 0))))
              ((== rc -3) (return (coco_m_domain_error e "differentiable" (coco_m_arg e g 0))))
              ((< rc 0)   (return (coco_m_domain_error e "tensor" g))))
            (set i 0)
            (while (< i n)
              (set (nth i items) (coco_new_int m (cast int64_t (nth i outs))))
              (set i (+ i 1)))
            (return (coco_m_unify e (coco_m_arg e g 2) (coco_m_list e items n))))
          (catch ((const std::exception & ex))
            ;; an exception from the backward pass -- out of device memory, most
            ;; often -- said `parameter expected' and nothing else, once, for
            ;; an afternoon: the message goes to stderr before the error
            (fprintf stderr "cocolog: tensor_grad: %s\n" (($ ex what)))
            (return (coco_m_domain_error e "tensor_op" g)))))))

  ;; ---- the Coco half --------------------------------------------------
  ;; model_save/2 and model_load/2 are the Zigurat bridge, CHUNKED to the
  ;; page discipline; below them, the friendly spellings of the generic
  ;; tensor operations.

  (var const char * torch_prolog .
       ":- dynamic torch_model/2.\n:- dynamic torch_params/3.\nmodel_save(Name, M) :- model_spec(M, Spec), model_params(M, Ps), ( retract(torch_model(Name, _)) -> true ; true ), '$torch_forget_params'(Name), assertz(torch_model(Name, Spec)), ( '$tensor_save'(Name, Ps) -> true ; '$torch_save_chunks'(Ps, Name, 0) ).\n'$torch_forget_params'(Name) :- ( retract(torch_params(Name, _, _)) -> '$torch_forget_params'(Name) ; true ).\n'$torch_save_chunks'([], _, _) :- !.\n'$torch_save_chunks'(Ps, Name, Seq) :- '$torch_split'(Ps, 120, Chunk, Rest), assertz(torch_params(Name, Seq, Chunk)), Seq1 is Seq + 1, '$torch_save_chunks'(Rest, Name, Seq1).\n'$torch_split'(Xs, 0, [], Xs) :- !.\n'$torch_split'([], _, [], []) :- !.\n'$torch_split'([X|Xs], N, [X|Cs], Rest) :- N1 is N - 1, '$torch_split'(Xs, N1, Cs, Rest).\nmodel_load(Name, M) :- torch_model(Name, Spec), ( '$tensor_load'(Name, Ps) -> true ; ( findall(Seq-Chunk, torch_params(Name, Seq, Chunk), Pairs), msort(Pairs, Sorted), '$torch_join_chunks'(Sorted, Ps) ) ), model_new(Spec, M), model_set_params(M, Ps).\n'$torch_join_chunks'([], []).\n'$torch_join_chunks'([_-C|T], Ps) :- '$torch_join_chunks'(T, Rest), append(C, Rest, Ps).\ntensor_train_test(T, NTrain, Train, Test) :- tensor_shape(T, [N|_]), tensor_rows(T, 0, NTrain, Train), tensor_rows(T, NTrain, N, Test).\ntensor_add(A, B, C) :- tensor_binary(add, A, B, C).\ntensor_sub(A, B, C) :- tensor_binary(sub, A, B, C).\ntensor_mul(A, B, C) :- tensor_binary(mul, A, B, C).\ntensor_div(A, B, C) :- tensor_binary(div, A, B, C).\ntensor_matmul(A, B, C) :- tensor_binary(matmul, A, B, C).\ntensor_neg(A, C) :- tensor_unary(neg, A, C).\ntensor_abs(A, C) :- tensor_unary(abs, A, C).\ntensor_exp(A, C) :- tensor_unary(exp, A, C).\ntensor_log(A, C) :- tensor_unary(log, A, C).\ntensor_sqrt(A, C) :- tensor_unary(sqrt, A, C).\ntensor_relu(A, C) :- tensor_unary(relu, A, C).\ntensor_sigmoid(A, C) :- tensor_unary(sigmoid, A, C).\ntensor_tanh(A, C) :- tensor_unary(tanh, A, C).\ntensor_transpose(A, C) :- tensor_unary(transpose, A, C).\ntensor_zeros(Shape, T) :- tensor_new(Shape, zeros, T).\ntensor_ones(Shape, T) :- tensor_new(Shape, ones, T).\ntensor_randn(Shape, T) :- tensor_new(Shape, randn, T).\ntensor_rand(Shape, T) :- tensor_new(Shape, rand, T).\ntensor_sum(T, X) :- tensor_reduce(sum, T, X).\ntensor_mean(T, X) :- tensor_reduce(mean, T, X).\ntensor_max(T, X) :- tensor_reduce(max, T, X).\ntensor_min(T, X) :- tensor_reduce(min, T, X).\ntensor_std(T, X) :- tensor_reduce(std, T, X).\n")

  ;; ---- dispatch and registration --------------------------------------

  (extern-c

    (func coco_torch_dispatch ((coco_engine * e) (const char * name)
                               (uint32_t arity) (size_t g) (int * found)) (out int)
      (set (cof found) 1)
      ;; the seam: under tensor_execution(tensorflow, _) every tensor_* call is the other module's
      (if (and (ct_backend_active) (== 0 (strncmp name "tensor_" 7))
               (!= 0 (strcmp name "tensor_execution")))
          (return (ct_backend_forward e name arity g found)))
      (cond
        ((== arity 1)
         (cond
           ((== 0 (strcmp name "torch_seed"))   (return (t_seed e g)))
           ((== 0 (strcmp name "torch_device")) (return (t_device e g)))
           ((== 0 (strcmp name "torch_cuda_available")) (return (t_cuda_available e g)))
           ((== 0 (strcmp name "torch_cuda_count"))     (return (t_cuda_count e g)))
           ((== 0 (strcmp name "torch_current_device")) (return (t_current_device e g)))
           ((== 0 (strcmp name "tensor_free"))  (return (t_free e g)))
           ((== 0 (strcmp name "model_free"))   (return (t_model_free e g)))
           ((== 0 (strcmp name "tensor_execution"))   (return (t_execution e g)))
           ((== 0 (strcmp name "torch_execution"))    (return (t_execution e g)))
           ((== 0 (strcmp name "tensor_force"))       (return (t_force e g)))
           ((== 0 (strcmp name "tensor_graph_stats")) (return (t_graph_stats e g)))
           (#t (set (cof found) 0) (return 0))))
        ((== arity 2)
         (cond
           ((== 0 (strcmp name "tensor_execution")) (return (t_execution2 e g)))
           ((== 0 (strcmp name "tensor_from_list")) (return (t_from_list e g)))
           ((== 0 (strcmp name "tensor_to_list"))   (return (t_to_list e g)))
           ((== 0 (strcmp name "tensor_shape"))     (return (t_shape e g)))
           ((== 0 (strcmp name "tensor_load_csv"))  (return (t_load_csv e g)))
           ((== 0 (strcmp name "tensor_arange"))    (return (t_arange e g)))
           ((== 0 (strcmp name "tensor_eye"))       (return (t_eye e g)))
           ((== 0 (strcmp name "tensor_randperm"))  (return (t_randperm e g)))
           ((== 0 (strcmp name "tensor_item"))      (return (t_item e g)))
           ((== 0 (strcmp name "model_new"))        (return (t_model_new e g)))
           ((== 0 (strcmp name "model_spec"))       (return (t_model_spec e g)))
           ((== 0 (strcmp name "model_params"))     (return (t_model_params e g)))
           ((== 0 (strcmp name "model_set_params")) (return (t_model_set_params e g)))
           ((== 0 (strcmp name "$tensor_save"))     (return (t_tensor_save e g)))
           ((== 0 (strcmp name "$tensor_load"))     (return (t_tensor_load e g)))
           ((== 0 (strcmp name "tensor_parameter")) (return (t_parameter e g)))
           (#t (set (cof found) 0) (return 0))))
        ((== arity 3)
         (cond
           ((== 0 (strcmp name "tensor_execution")) (return (t_execution3 e g found)))
           ((== 0 (strcmp name "tensor_standardise")) (return (t_standardise e g)))
           ((== 0 (strcmp name "tensor_unary"))       (return (t_unary e g)))
           ((== 0 (strcmp name "tensor_reduce"))      (return (t_reduce e g)))
           ((== 0 (strcmp name "tensor_argmax"))      (return (t_argmax e g)))
           ((== 0 (strcmp name "tensor_reshape"))     (return (t_reshape e g)))
           ((== 0 (strcmp name "tensor_cat"))         (return (t_cat e g)))
           ((== 0 (strcmp name "tensor_index_rows"))  (return (t_index_rows e g)))
           ((== 0 (strcmp name "tensor_new"))         (return (t_new e g)))
           ((== 0 (strcmp name "tensor_full"))        (return (t_full e g)))
           ((== 0 (strcmp name "model_predict"))      (return (t_model_predict e g)))
           ((== 0 (strcmp name "tensor_agg"))         (return (t_agg e g)))
           ((== 0 (strcmp name "tensor_grad"))        (return (t_grad e g)))
           (#t (set (cof found) 0) (return 0))))
        ((== arity 4)
         (cond
           ((== 0 (strcmp name "tensor_cols"))   (return (t_cols e g)))
           ((== 0 (strcmp name "tensor_rows"))   (return (t_rows e g)))
           ((== 0 (strcmp name "tensor_binary")) (return (t_binary e g)))
           ((== 0 (strcmp name "tensor_scalar")) (return (t_scalar e g)))
           ((== 0 (strcmp name "model_train"))   (return (t_model_train e g)))
           ((== 0 (strcmp name "tensor_step"))   (return (t_step e g)))
           (#t (set (cof found) 0) (return 0))))
        ((== arity 5)
         (cond
           ((== 0 (strcmp name "model_evaluate")) (return (t_model_eval e g)))
           (#t (set (cof found) 0) (return 0))))
        (#t (set (cof found) 0) (return 0))))

    ;;; THE ONE SYMBOL THE LOADER CALLS, inside the `extern "C"' block with
    ;;; everything else here -- a C++ entry point that kept C++ linkage
    ;;; would compile and link and then not be found, because the mangled
    ;;; name is not `coco_library_entry'.
    ;;;
    ;;; It replaces `coco_torch_module', which the composition root called
    ;;; by name through a weak symbol. Nothing else in this file changed.
    ;;; The 1 is the ABI version lib/sdk.cicili defines, not a success flag.
    (func coco_library_entry () (out int)
      (if (not (coco_module_register "torch" coco_torch_dispatch torch_prolog nil))
          (return 0))
      (return 1))))

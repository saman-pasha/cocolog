  (static)
  (func cw_term_data ((coco_engine * e) (size_t g) (const char * who) (char ** out)) (out int)
        (let ((char * text . #'(coco_m_term_text e (coco_m_arg e g 0))))
          (if (== text nil)
              (return (coco_m_error e who "the data term would not write")))
          (let ((char * p . #'(cw_arena_text text (strlen text))))
            (free text)
            (if (== p nil) (return (coco_m_error e who "no memory for the data term")))
            (set (cof out) p)
            (return 1))))

  (func clay_p_image ((coco_engine * e) (size_t g)) (out int)

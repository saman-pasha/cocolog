          (return 1)))

  ;;; `$clay_clip'(H, V, Scroll): a clip cuts what overflows; a SCROLL cuts
  ;;; and moves the children by the offset the wheel has accumulated for
  ;;; this element, which Clay answers for the element being configured.
  (func clay_p_clip ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 v [3]))
          (for ((int j . 0)) (< j 3) ((++ j))
               (let ((int rc24 . #'(cw_iarg e g j (+ v j)))) (if (!= rc24 1) (return rc24))))
          (set ($ cw_decl clip horizontal) (!= (nth 0 v) 0))
          (set ($ cw_decl clip vertical) (!= (nth 1 v) 0))
          (if (nth 2 v) (set ($ cw_decl clip childOffset) (Clay_GetScrollOffset)))
          (return 1)))

  (func clay_p_aspect ((coco_engine * e) (size_t g)) (out int)
        (let ((double f . 0.0))
          (let ((int rc25 . #'(cw_farg e g 0 (aof f)))) (if (!= rc25 1) (return rc25)))
          (set ($ cw_decl aspectRatio aspectRatio) (cast float f))
          (return 1)))

  ;;; A term to ride through Clay: its canonical text into the arena, and

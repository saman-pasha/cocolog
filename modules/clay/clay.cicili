        (Clay__CloseElement)
        (return 1))

  ;;; A text element: the content into the arena, the config as a value
  ;;; Clay stores for the frame.
  (func clay_p_text ((coco_engine * e) (size_t g)) (out int)
        (let ((char text [16384]) (i64 font . 0) (i64 size . 0) (double c [4])
              (i64 spacing . 0) (i64 lh . 0) (i64 wrap . 0) (i64 align . 0)
              (size_t n . 0) (char * p . nil)
              (Clay_TextElementConfig tc . '{ 0 }))
          (let ((int rc38 . #'(cw_need_frame e "clay_text"))) (if (!= rc38 1) (return rc38)))
          (if (not (coco_m_text e (coco_m_arg e g 0) text (sizeof text)))
              (return (coco_m_type_error e "text" (coco_m_arg e g 0))))
          (let ((int rc39 . #'(cw_iarg e g 1 (aof font)))) (if (!= rc39 1) (return rc39)))
          (let ((int rc40 . #'(cw_iarg e g 2 (aof size)))) (if (!= rc40 1) (return rc40)))
          (let ((int rc41 . #'(cw_four e g 3 c))) (if (!= rc41 1) (return rc41)))
          (let ((int rc42 . #'(cw_iarg e g 7 (aof spacing)))) (if (!= rc42 1) (return rc42)))
          (let ((int rc43 . #'(cw_iarg e g 8 (aof lh)))) (if (!= rc43 1) (return rc43)))
          (let ((int rc44 . #'(cw_iarg e g 9 (aof wrap)))) (if (!= rc44 1) (return rc44)))
          (let ((int rc45 . #'(cw_iarg e g 10 (aof align)))) (if (!= rc45 1) (return rc45)))
          (if (or (< wrap 0) (> wrap 2))
              (return (coco_m_domain_error e "clay_wrap" (coco_m_arg e g 9))))
          (if (or (< align 0) (> align 2))
              (return (coco_m_domain_error e "clay_text_align" (coco_m_arg e g 10))))
          (set n (strlen text))
          (set p (cw_arena_text text n))
          (if (== p nil) (return (coco_m_error e "clay_text" "no memory for the text")))
          (set ($ tc textColor) (cw_color c))
          (set ($ tc fontId) (cast u16 font))
          (set ($ tc fontSize) (cast u16 size))
          (set ($ tc letterSpacing) (cast u16 spacing))
          (set ($ tc lineHeight) (cast u16 lh))
          (set ($ tc wrapMode) (cast Clay_TextElementConfigWrapMode wrap))
          (set ($ tc textAlignment) (cast Clay_TextAlignment align))
          (Clay__OpenTextElement (cw_str p (cast long n)) (Clay__StoreTextElementConfig tc))
          (return 1)))

  ;;; ---- the commands back, as rows ----
  ;;;
  ;;; Built from the last command to the first so each cons is onto a list
  ;;; already made; a row is an array of cells handed to coco_m_list. A
  ;;; color comes back as the integer it went in as, a coordinate as the
  ;;; float Clay computed.
  ;;;
  ;;; Clay computes in single precision, so a text 100.8 wide comes back as
  ;;; 100.800003051758 through a double; a thousandth of a pixel is where
  ;;; the truth ends, and rounding there is what lets a test pin 100.8.
  (static)
  (func cw_round3 ((double x)) (out double)
        (return (/ (floor (+ (* x 1000.0) 0.5)) 1000.0)))

  (static)
  (func cw_put_color ((coco_engine * e) (Clay_Color c) (size_t * items) (int at)) (out void)
        (set (nth at items) (coco_m_new_int e (cast i64 (+ ($ c r) 0.5))))
        (set (nth (+ at 1) items) (coco_m_new_int e (cast i64 (+ ($ c g) 0.5))))
        (set (nth (+ at 2) items) (coco_m_new_int e (cast i64 (+ ($ c b) 0.5))))
        (set (nth (+ at 3) items) (coco_m_new_int e (cast i64 (+ ($ c a) 0.5)))))

  (static)
  (func cw_put_corners ((coco_engine * e) (Clay_CornerRadius c) (size_t * items) (int at)) (out void)
        (set (nth at items) (coco_m_new_float e (cw_round3 ($ c topLeft))))
        (set (nth (+ at 1) items) (coco_m_new_float e (cw_round3 ($ c topRight))))
        (set (nth (+ at 2) items) (coco_m_new_float e (cw_round3 ($ c bottomLeft))))
        (set (nth (+ at 3) items) (coco_m_new_float e (cw_round3 ($ c bottomRight)))))

  (static)
  (func cw_put_box ((coco_engine * e) (Clay_BoundingBox b) (size_t * items) (int at)) (out void)
        (set (nth at items) (coco_m_new_float e (cw_round3 ($ b x))))
        (set (nth (+ at 1) items) (coco_m_new_float e (cw_round3 ($ b y))))
        (set (nth (+ at 2) items) (coco_m_new_float e (cw_round3 ($ b width))))
        (set (nth (+ at 3) items) (coco_m_new_float e (cw_round3 ($ b height)))))

  (static)
  (func cw_codes ((coco_engine * e) (const char * s) (long n)) (out size_t)
        (let ((size_t lst . #'(coco_m_nil e)))
          (for ((long i . n)) (> i 0) ((-- i))
               (set lst (coco_m_cons e (coco_m_new_int e (cast i64 (bitand (cast int (nth (- i 1) s)) 255))) lst)))
          (return lst)))

  ;;; The term an image or a custom element carried, read back from the
  ;;; text it went across as; `none' if nothing was there.
  (static)
  (func cw_data_term ((coco_engine * e) (void * data)) (out size_t)
        (let ((size_t term . 0))
          (if (!= data nil) (set term (coco_m_read_term e (cast (const char *) data))))
          (if (== term 0) (set term (coco_m_new_atom e "none")))
          (return term)))

  ;;; One command as a row, or 0 for a kind nothing draws.
  (static)
  (func cw_row ((coco_engine * e) (long i)) (out size_t)
        (let ((Clay_RenderCommand * c . #'(Clay_RenderCommandArray_Get (aof cw_cmds) (cast i32 i)))
              (int kind . #'(cast int (-> c commandType)))
              (size_t items [20]) (int n . 0))
          (if (== kind CLAY_RENDER_COMMAND_TYPE_NONE) (return 0))
          (set (nth 1 items) (coco_m_new_int e (cast i64 (-> c id))))
          (cw_put_box e (-> c boundingBox) items 2)
          (set n 6)
          (if (== kind CLAY_RENDER_COMMAND_TYPE_RECTANGLE)
              (block
               (set (nth 0 items) (coco_m_new_atom e "rect"))
               (cw_put_color e ($ (cof c) renderData rectangle backgroundColor) items 6)
               (cw_put_corners e ($ (cof c) renderData rectangle cornerRadius) items 10)
               (set n 14)))
          (if (== kind CLAY_RENDER_COMMAND_TYPE_BORDER)
              (block
               (set (nth 0 items) (coco_m_new_atom e "border"))
               (cw_put_color e ($ (cof c) renderData border color) items 6)
               (cw_put_corners e ($ (cof c) renderData border cornerRadius) items 10)
               (set (nth 14 items) (coco_m_new_int e (cast i64 ($ (cof c) renderData border width left))))
               (set (nth 15 items) (coco_m_new_int e (cast i64 ($ (cof c) renderData border width right))))
               (set (nth 16 items) (coco_m_new_int e (cast i64 ($ (cof c) renderData border width top))))
               (set (nth 17 items) (coco_m_new_int e (cast i64 ($ (cof c) renderData border width bottom))))
               (set (nth 18 items) (coco_m_new_int e (cast i64 ($ (cof c) renderData border width betweenChildren))))
               (set n 19)))
          (if (== kind CLAY_RENDER_COMMAND_TYPE_TEXT)
              (block
               (set (nth 0 items) (coco_m_new_atom e "text"))
               (cw_put_color e ($ (cof c) renderData text textColor) items 6)
               (set (nth 10 items) (coco_m_new_int e (cast i64 ($ (cof c) renderData text fontId))))
               (set (nth 11 items) (coco_m_new_int e (cast i64 ($ (cof c) renderData text fontSize))))
               (set (nth 12 items) (coco_m_new_int e (cast i64 ($ (cof c) renderData text letterSpacing))))
               (set (nth 13 items) (coco_m_new_int e (cast i64 ($ (cof c) renderData text lineHeight))))
               (set (nth 14 items) (cw_codes e ($ (cof c) renderData text stringContents chars)
                                             (cast long ($ (cof c) renderData text stringContents length))))
               (set n 15)))
          (if (== kind CLAY_RENDER_COMMAND_TYPE_IMAGE)
              (block
               (set (nth 0 items) (coco_m_new_atom e "image"))
               (cw_put_color e ($ (cof c) renderData image backgroundColor) items 6)
               (cw_put_corners e ($ (cof c) renderData image cornerRadius) items 10)
               (set (nth 14 items) (cw_data_term e ($ (cof c) renderData image imageData)))
               (set n 15)))
          (if (== kind CLAY_RENDER_COMMAND_TYPE_CUSTOM)
              (block
               (set (nth 0 items) (coco_m_new_atom e "custom"))
               (cw_put_color e ($ (cof c) renderData custom backgroundColor) items 6)
               (cw_put_corners e ($ (cof c) renderData custom cornerRadius) items 10)
               (set (nth 14 items) (cw_data_term e ($ (cof c) renderData custom customData)))
               (set n 15)))
          (if (== kind CLAY_RENDER_COMMAND_TYPE_SCISSOR_START)
              (block
               (set (nth 0 items) (coco_m_new_atom e "scissor_start"))
               (set (nth 6 items) (coco_m_new_int e (cast i64 ($ (cof c) renderData clip horizontal))))
               (set (nth 7 items) (coco_m_new_int e (cast i64 ($ (cof c) renderData clip vertical))))
               (set n 8)))
          (if (== kind CLAY_RENDER_COMMAND_TYPE_SCISSOR_END)
              (block (set (nth 0 items) (coco_m_new_atom e "scissor_end"))
                     (set n 6)))
          (if (> kind CLAY_RENDER_COMMAND_TYPE_CUSTOM) (return 0))
          (return (coco_m_list e items (cast size_t n)))))

  (func clay_p_end ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t lst . 0) (long n . 0))
          (let ((int rc46 . #'(cw_need_frame e "clay_end"))) (if (!= rc46 1) (return rc46)))
          (set cw_cmds (Clay_EndLayout))
          (set cw_in_frame 0)
          (if cw_err_set (return (coco_m_error e "clay" cw_err)))
          (set lst (coco_m_nil e))
          (set n (cast long ($ cw_cmds length)))
          (for ((long i . #'(- n 1))) (>= i 0) ((-- i))
               (let ((size_t row . #'(cw_row e i)))
                 (if (!= row 0) (set lst (coco_m_cons e row lst)))))
          (return (coco_m_unify e (coco_m_arg e g 0) lst))))

  ;;; A frame given up half way -- the tree threw -- is left where it stands
  ;;; for the next begin to reset; what this does is stop the element
  ;;; predicates from adding to it in the meantime.
  (func clay_p_abort ((coco_engine * e) (size_t g)) (out int)
        (set cw_in_frame 0)
        (return 1))

  ;;; ---- the pointer and the wheel, before a frame ----
  (func clay_p_pointer ((coco_engine * e) (size_t g)) (out int)
        (let ((double x . 0.0) (double y . 0.0) (i64 down . 0))
          (let ((int rc47 . #'(cw_farg e g 0 (aof x)))) (if (!= rc47 1) (return rc47)))
          (let ((int rc48 . #'(cw_farg e g 1 (aof y)))) (if (!= rc48 1) (return rc48)))
          (let ((int rc49 . #'(cw_iarg e g 2 (aof down)))) (if (!= rc49 1) (return rc49)))
          (let ((int rce . #'(cw_ensure e "clay_pointer"))) (if (!= rce 1) (return rce)))
          (Clay_SetPointerState (cw_vec x y) (!= down 0))
          (return 1)))

  (func clay_p_scroll ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 drag . 0) (double dx . 0.0) (double dy . 0.0) (double dt . 0.0))
          (let ((int rc50 . #'(cw_iarg e g 0 (aof drag)))) (if (!= rc50 1) (return rc50)))
          (let ((int rc51 . #'(cw_farg e g 1 (aof dx)))) (if (!= rc51 1) (return rc51)))
          (let ((int rc52 . #'(cw_farg e g 2 (aof dy)))) (if (!= rc52 1) (return rc52)))
          (let ((int rc53 . #'(cw_farg e g 3 (aof dt)))) (if (!= rc53 1) (return rc53)))
          (let ((int rce . #'(cw_ensure e "clay_scroll"))) (if (!= rce 1) (return rce)))
          (Clay_UpdateScrollContainers (!= drag 0) (cw_vec dx dy) (cast float dt))
          (return 1)))

  ;;; An id's three parts as arguments FROM, for the queries about one.
  (static)
  (func cw_id_args ((coco_engine * e) (size_t g) (int from) (char * name) (size_t cap)
                    (i64 * index) (i64 * local)) (out int)
        (if (not (coco_m_text e (coco_m_arg e g (cast size_t from)) name cap))
            (return (coco_m_type_error e "atom" (coco_m_arg e g (cast size_t from)))))
        (let ((int rc54 . #'(cw_iarg e g (+ from 1) index))) (if (!= rc54 1) (return rc54)))
        (let ((int rc55 . #'(cw_iarg e g (+ from 2) local))) (if (!= rc55 1) (return rc55)))
        (return 1))

  (func clay_p_over ((coco_engine * e) (size_t g)) (out int)
        (let ((char name [512]) (i64 index . 0) (i64 local . 0))
          (let ((int rc56 . #'(cw_id_args e g 0 name (sizeof name) (aof index) (aof local))))
            (if (!= rc56 1) (return rc56)))
          (if cw_reinit (return 0))
          (if (Clay_PointerOver (cw_id name (cast long (strlen name)) (cast long index) (cast long local)))
              (return 1))
          (return 0)))

  (func clay_p_hovered ((coco_engine * e) (size_t g)) (out int)
        (if cw_reinit (return 0))
        (if (not cw_in_frame) (return 0))
        (if (Clay_PointerOver cw_last_id) (return 1))
        (return 0))

  (func clay_p_box ((coco_engine * e) (size_t g)) (out int)
        (let ((char name [512]) (i64 index . 0) (i64 local . 0)
              (Clay_ElementData d . '{ 0 }))
          (let ((int rc57 . #'(cw_id_args e g 0 name (sizeof name) (aof index) (aof local))))
            (if (!= rc57 1) (return rc57)))
          (if cw_reinit (return 0))
          (set d (Clay_GetElementData (cw_id name (cast long (strlen name)) (cast long index) (cast long local))))
          (if (not ($ d found)) (return 0))
          (if (not (coco_m_unify_float e (coco_m_arg e g 3) (cw_round3 ($ d boundingBox x)))) (return 0))
          (if (not (coco_m_unify_float e (coco_m_arg e g 4) (cw_round3 ($ d boundingBox y)))) (return 0))
          (if (not (coco_m_unify_float e (coco_m_arg e g 5) (cw_round3 ($ d boundingBox width)))) (return 0))
          (return (coco_m_unify_float e (coco_m_arg e g 6) (cw_round3 ($ d boundingBox height))))))

  (func clay_p_scroll_data ((coco_engine * e) (size_t g)) (out int)
        (let ((char name [512]) (i64 index . 0) (i64 local . 0)
              (Clay_ScrollContainerData d . '{ 0 }))
          (let ((int rc58 . #'(cw_id_args e g 0 name (sizeof name) (aof index) (aof local))))
            (if (!= rc58 1) (return rc58)))
          (if cw_reinit (return 0))
          (set d (Clay_GetScrollContainerData (cw_id name (cast long (strlen name)) (cast long index) (cast long local))))
          (if (not ($ d found)) (return 0))
          (if (not (coco_m_unify_float e (coco_m_arg e g 3) (cw_round3 (-> ($ d scrollPosition) x)))) (return 0))
          (if (not (coco_m_unify_float e (coco_m_arg e g 4) (cw_round3 (-> ($ d scrollPosition) y)))) (return 0))
          (if (not (coco_m_unify_float e (coco_m_arg e g 5) (cw_round3 ($ d scrollContainerDimensions width)))) (return 0))
          (if (not (coco_m_unify_float e (coco_m_arg e g 6) (cw_round3 ($ d scrollContainerDimensions height)))) (return 0))
          (if (not (coco_m_unify_float e (coco_m_arg e g 7) (cw_round3 ($ d contentDimensions width)))) (return 0))
          (return (coco_m_unify_float e (coco_m_arg e g 8) (cw_round3 ($ d contentDimensions height))))))

  ;;; ---- a font's metrics: `$clay_font'(Id, Base, Advances) ----
  (func clay_p_font ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 id . 0) (double base . 0.0) (size_t * items . nil) (size_t n . 0)
              (double total . 0.0) (int f . 0))
          (let ((int rc59 . #'(cw_iarg e g 0 (aof id)))) (if (!= rc59 1) (return rc59)))
          (let ((int rc60 . #'(cw_farg e g 1 (aof base)))) (if (!= rc60 1) (return rc60)))
          (if (or (< id 0) (>= id 16))
              (return (coco_m_domain_error e "clay_font_id" (coco_m_arg e g 0))))
          (if (<= base 0.0)
              (return (coco_m_domain_error e "clay_font_base" (coco_m_arg e g 1))))
          (if (not (coco_m_list_array e (coco_m_arg e g 2) (aof items) (aof n)))
              (return (coco_m_type_error e "list" (coco_m_arg e g 2))))
          (if (== n 0)
              (return (coco_m_domain_error e "clay_font_advances" (coco_m_arg e g 2))))
          (set f (cast int id))
          (for ((size_t j . 0)) (< j n) ((++ j))
               (let ((double a . 0.0) (i64 ai . 0))
                 (if (coco_m_int e (nth j items) (aof ai))
                     (set a (cast double ai))
                   (if (not (coco_m_float e (nth j items) (aof a)))
                       (let ((size_t bad . #'(nth j items)))
                         (free items)
                         (return (coco_m_type_error e "number" bad)))))
                 (if (< j 224) (set (nth j (nth f cw_font_adv)) a))
                 (set total (+ total a))))
          (free items)
          (set (nth f cw_font_mean) (/ total (cast double n)))
          (for ((size_t j . n)) (< j 224) ((++ j))
               (set (nth j (nth f cw_font_adv)) (nth f cw_font_mean)))
          (set (nth f cw_font_base) base)
          (set (nth f cw_font_set) 1)
          (return 1)))

  (static) (coco-emit-module-dispatch clay_dispatch *clay-predicates*)

  (coco-deflibrary "clay" clay_dispatch *clay-prolog*)
  ) ; source

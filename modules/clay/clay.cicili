          (return 1)))

  (func clay_p_floating ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 to . 0) (i64 parent . 0) (double f [4]) (i64 z . 0) (i64 ae . 0) (i64 ap . 0)
              (i64 cap . 0) (i64 cl . 0))
          (let ((int rc28 . #'(cw_iarg e g 0 (aof to)))) (if (!= rc28 1) (return rc28)))
          (let ((int rc29 . #'(cw_iarg e g 1 (aof parent)))) (if (!= rc29 1) (return rc29)))
          (let ((int rc30 . #'(cw_four e g 2 f))) (if (!= rc30 1) (return rc30)))
          (let ((int rc31 . #'(cw_iarg e g 6 (aof z)))) (if (!= rc31 1) (return rc31)))
          (let ((int rc32 . #'(cw_iarg e g 7 (aof ae)))) (if (!= rc32 1) (return rc32)))
          (let ((int rc33 . #'(cw_iarg e g 8 (aof ap)))) (if (!= rc33 1) (return rc33)))
          (let ((int rc34 . #'(cw_iarg e g 9 (aof cap)))) (if (!= rc34 1) (return rc34)))
          (let ((int rc35 . #'(cw_iarg e g 10 (aof cl)))) (if (!= rc35 1) (return rc35)))
          (set ($ cw_decl floating attachTo) (cast Clay_FloatingAttachToElement to))
          (set ($ cw_decl floating parentId) (cast u32 parent))
          (set ($ cw_decl floating offset) (cw_vec (nth 0 f) (nth 1 f)))
          (set ($ cw_decl floating expand width) (cast float (nth 2 f)))
          (set ($ cw_decl floating expand height) (cast float (nth 3 f)))
          (set ($ cw_decl floating zIndex) (cast i16 z))
          (set ($ cw_decl floating attachPoints element) (cast Clay_FloatingAttachPointType ae))
          (set ($ cw_decl floating attachPoints parent) (cast Clay_FloatingAttachPointType ap))
          (set ($ cw_decl floating pointerCaptureMode) (cast Clay_PointerCaptureMode cap))

          (if (not (coco_m_unify_atom e (coco_m_arg e g 2) "term")) (return 0))
          (if (not (coco_m_unify e (coco_m_arg e g 3) t)) (return 0))
          (return (coco_m_unify e (coco_m_arg e g 4) names))))

  ;;; ---- codes, as cocolog counts them: one per byte ----

            (set c (st_getc s))
            (if (< c 0) break)
            (if (not (st_grow (aof buf) (aof cap) (+ n 2))) (block (free buf) (return -1)))
            (set (nth n buf) (cast u8 c))
            (set n (+ n 1))
            (cond
              ((== state 4)
               (if (== c 10) (set state 0)))
              ((== state 5)
               (if (and (== c 47) (== prev 42)) (set state 0)))
              ((== state 6)
               (set state 0)
               (if (== c 92)                ; a backslash escape takes one more
                   (let ((int d . #'(st_getc s)))
                     (if (>= d 0)
                         (block (if (not (st_grow (aof buf) (aof cap) (+ n 2))) (block (free buf) (return -1)))
                                (set (nth n buf) (cast u8 d)) (set n (+ n 1)))))))
              ((== state 1) (if (== c 39) (set state 0)))
              ((== state 2) (if (== c 34) (set state 0)))
              ((== state 3) (if (== c 96) (set state 0)))
              (#t

  (func st_p_get_char ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (u8 ch [8]) (char name [8]) (int n . 0))
          (let ((int rc33 . #'(st_slot e g 1 (aof s)))) (if (!= rc33 1) (return rc33)))
          (let ((int rc34 . #'(st_need e g 0 s 1 "input"))) (if (!= rc34 1) (return rc34)))
          (let ((int rc35 . #'(st_readable e g 0 s))) (if (!= rc35 1) (return rc35)))

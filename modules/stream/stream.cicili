        (let ((int s . -1) (size_t * items . nil) (size_t n . 0) (u8 * buf . nil))
          (let ((int rc28 . #'(st_slot e g 1 (aof s)))) (if (!= rc28 1) (return rc28)))
          (let ((int rc29 . #'(st_need e g 0 s kind "output"))) (if (!= rc29 1) (return rc29)))
          (let ((int rc30 . #'(st_writable e g 0 s))) (if (!= rc30 1) (return rc30)))

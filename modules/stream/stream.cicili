          (return (coco_m_unify_atom e (coco_m_arg e g 2) name))))

  (func st_p_peek_char ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (u8 ch [8]) (char name [8]) (int n . 0))
          (let ((int rc36 . #'(st_slot e g 1 (aof s)))) (if (!= rc36 1) (return rc36)))
          (let ((int rc37 . #'(st_need e g 0 s 1 "input"))) (if (!= rc37 1) (return rc37)))

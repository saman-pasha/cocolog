                    (if (or (< d 0) (or (== d 32) (or (== d 10) (or (== d 9) (or (== d 13) (== d 37))))))
                        (block (if (>= d 0) (st_ungetc s d))
                               (set (cof out) buf) (set (cof len) n)
                               (return 1)))
                    (st_ungetc s d))))))
            (if (and (== state 0) (or (== c 32) (or (== c 10) (or (== c 9) (== c 13)))))
                (set prev 32)

                 ((== c 37) (set state 4))
                 ((and (== c 42) (== prev 47)) (set state 5))
                 ;; 0'c takes the next character literally, when the 0 begins a number
                 ((and (== c 39) (and (== prev 48) (st_number_start buf n))) (set state 6))
                 ((== c 39) (set state 1))
                 ((== c 34) (set state 2))
                 ((== c 96) (set state 3))
                 ((and (== c 46) (not (st_is_symbol prev)))
                  ;; the end token: a `.' followed by layout, `%' or the end

          (return (coco_m_unify_atom e (coco_m_arg e g 2) name))))

  (func st_p_put_char ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (char ch [16]) (size_t n . 0))
          (let ((int rc39 . #'(st_slot e g 1 (aof s)))) (if (!= rc39 1) (return rc39)))
          (let ((int rc40 . #'(st_need e g 0 s 1 "output"))) (if (!= rc40 1) (return rc40)))
          (let ((int rc41 . #'(st_writable e g 0 s))) (if (!= rc41 1) (return rc41)))

                     (let ((int b . #'(cast int (nth i buf))))
                       (if (and (!= b 32) (and (!= b 10) (and (!= b 9) (!= b 13))))
                           (block (set clean 0) break))))
                ;; a comment-only tail is clean too: strip comments by rescanning
                (if (not clean)

;;;; cocolog -- library(stream): files as streams -- bytes, characters,
;;;; lines, terms and formatted text, in and out.
;;;
;;; THE INTERPRETER HAS NO STREAM LAYER, AND THIS IS THE ONE IT GETS. The
;;; engine writes to the literal stdout in seventy places and reads a
;;; program from a file it consults; what a program could do with a file
;;; of its own was `read_file_to_codes/2' and nothing else -- no byte at
;;; a time, no line at a time, no term at a time, nothing written but
;;; whole files through the shell. A stream here is a HANDLE in this
;;; module's table, the shape library(tcp) gives a socket: `'$stream'(N)'
;;; names a slot that holds the FILE, its path, its mode and whether it
;;; is TEXT or BINARY, and the three standard streams sit in slots 0, 1
;;; and 2 from the first call, as `user_input', `user_output' and
;;; `user_error' by name.
;;;
;;; THREE KINDS OF I/O, AND THE KIND IS THE STREAM'S. A stream is opened
;;; `text' (the default) or `binary', and the BYTE predicates work on a
;;; binary stream alone: a byte of a text one is swipl's
;;; `permission_error(input, text_stream, S)', asked after the stream's
;;; direction. The CHARACTER, LINE and TERM predicates take either kind, a
;;; binary stream's characters being its bytes -- swipl's octet encoding
;;; (3.16.0): `é' written there is the byte 233, a character past 255 is
;;; io_error(write, S), and a byte read is the character of its code.
;;; Through 3.15.2 they refused a binary stream with
;;; `permission_error(input, binary_stream, S)'. FORMATTED output --
;;; `format/2''s directives, `write/1''s spelling, `print/1''s and
;;; `writeq/1''s -- goes through the engine's own formatter into codes
;;; and from there into the stream, so a `~t~20|' column in a file is
;;; exactly the column it is on the terminal; formatted INPUT is the
;;; engine's own reader over one clause of text, so `stream_read_term/2'
;;; reads what `consult' would, operators and all, and answers
;;; `end_of_file' at the end.
;;;
;;; A CHARACTER IS A UTF-8 CHARACTER. cocolog's text is bytes, and a
;;; byte past 127 alone is not a character; `stream_get_char/2' reads
;;; one code point's bytes and answers the one-character atom they spell,
;;; and `stream_put_char/2' writes an atom's bytes back. A line and a
;;; whole file come back as CODES, one per byte, which is what every
;;; text predicate in this family takes (`atom_codes/2' is the way to an
;;; atom) -- a line has its newline taken off, and a CR before it too.
;;; UNDER `text_units = characters' (1.13.0) a text stream's codes are
;;; code points, as `atom_codes/2''s are there: a line, a whole text
;;; file, `get_code/2', `peek_code/2' and `put_code/2' read and write one
;;; per character; a binary stream's stay bytes.
;;;
;;; THE DIVISION IS THE USUAL ONE. The C half is FLAT -- a slot number
;;; and one plain value per call -- and the Coco half is the surface: the
;;; handle term, the names of the modes and the kinds, the aliases,
;;; `stream_property/2' as clauses over the table, and every error that
;;; names a TERM rather than a slot.
;;;
;;; EVERY ERROR NAMES THE PREDICATE THE PROGRAM CALLED (3.16.0), as swipl's
;;; do: `error(existence_error(stream, foo), context(system:get_char/2, _))',
;;; read_util:read_line_to_codes/2 for that one, and system:read_string/5
;;; for read_line_to_string/2, swipl's own names. Each public predicate
;;; hands its indicator to `stream_slot/3' and, as the last argument, to
;;; the C half it calls, whose raises a row of the engine's
;;; `*error-contexts*' (:PI) names by it. The order of the checks is
;;; swipl's: a put's character or byte before the stream, a stream's
;;; direction before its kind, open/4's and close/2's options before the
;;; stream, read_term/3's before a byte is read; and a get reads first and
;;; asks its argument only when what it read did not unify. Through 3.15.2
;;; the slot's errors named `stream_slot/2', bare, and the C half's
;;; `stream:'$stream_get_char'/3'.
;;;
;;; ISO'S NAMES ARE HERE TOO, SINCE 1.8.34, AND THE ENGINE HAD TO MEET THEM
;;; HALF WAY. `open/4', `get_char/2', `read_term/3', `write/2' and the rest
;;; are the same table under the standard's spelling -- loaded with this
;;; module and not before, so a program that never asks pays nothing. Two
;;; things could not be done from here alone, and each is ONE seam:
;;;
;;;   * `format/3' and `with_output_to/2' are the engine's, and a stream is
;;;     this module's. The engine asks an installed SINK HOOK about a sink
;;;     before its own (`coco_m_sink_install', lib/sdk.cicili), and this
;;;     module answers for `'$stream'(N)', for an alias it holds, and for
;;;     `user_output' while a file is the current output; anything else
;;;     answers 0 and the engine carries on as it always has.
;;;   * `write/1', `nl/0' and `format/2' write to the literal stdout, so
;;;     `set_output(S)' points FILE DESCRIPTOR 1 at the stream's file --
;;;     the mechanism `with_output_to/2' already uses -- and keeps the real
;;;     stdout aside, so that `user_output' named outright still reaches
;;;     the terminal. The two buffers on the one file are kept in the order
;;;     a program wrote: stdout emptied before the stream writes, the
;;;     stream after (`st_out_begin', `st_out_end').
;;;
;;; `read_term/3' reads through `coco_m_read_clause', the engine's reader
;;; with the variable names it met, so `variable_names/1', `variables/1'
;;; and `singletons/1' are what the file said; a clause that will not read
;;; is swipl's `error(syntax_error(Id), file(File, Line, LinePos, CharNo))'
;;; -- `stream(S, ...)' for a standard stream, and for a block comment open
;;; before anything -- at the place a load gives it (3.11.0; through 3.10.1
;;; error(syntax_error(Message), read_term/3), a sentence of cocolog's). SWI's
;;; `subterm_positions/1' and `term_position/1' are the reader's too
;;; (`coco_m_read_clause_pos', 1.10.7): positions in characters from the
;;; start of the stream, and '$stream_position'(Char, Line, LinePos, Byte)
;;; where the term begins, counted by every byte this module reads.
;;;
;;; A CODE IS A BYTE, as `atom_codes/2' counts one: `get_code/2' reads one
;;; byte of a text stream and `put_code/2' writes one, and a code past 255
;;; is written as the UTF-8 of that code point, the one reading that loses
;;; nothing. Under `text_units = characters' a code is a code point, as
;;; atom_codes/2 counts one there.
;;;
;;; THE CURRENT INPUT IS THIS MODULE'S ALONE, and needs no seam: the engine
;;; reads no terminal of its own, so `read/1', `get_char/1' and the rest
;;; here read `current_input/1' and nothing else has to follow it.
;;;
;;; A POSITION IS SWIPL'S '$stream_position'(Char, Line, LinePos, Byte)
;;; (3.16.0): what `stream_property(S, position(P))' answers, counted from
;;; the open by every byte this module reads or writes, and what
;;; `set_stream_position/2' takes back -- the stream seeks to Byte and
;;; counts on from the counters as given. Anything else is swipl's
;;; domain_error(stream_position, P), context(stream_position/3, _).
;;; Through 3.15.2 a position was the byte offset; cocolog's own
;;; stream_position/2 and stream_seek/2,3 still are.
;;;
;;; AN ALIAS IS THE STREAM (3.16.0): open/4 with alias(A) unifies the
;;; stream argument with A, as swipl's does; of two aliases the last is
;;; it, and of two types the last too.
;;;
;;; WHAT IS NOT HERE, deliberately: `eof_action/1' other than `eof_code'
;;; and `reposition/1' as OPTIONS of open/4 (swipl's values are checked,
;;; and both are answered as properties); and pipes and sockets, which
;;; library(process) and library(tcp) own. EVERY ENCODING swipl names is
;;; applied (3.19.0; iso_latin_1, octet and ascii since 3.17.0): UTF-8 the
;;; default, a byte a character in octet, ascii and iso_latin_1, two or four
;;; bytes in UTF-16 either way round, four in wchar_t, the BOM written where
;;; bom(true) asks and looked for by a read, set_stream/2 changing it; text
;;; is the locale's to swipl and UTF-8 here.
;;;
;;; NO DEFPACKAGE -- a file compiled on its own is the whole unit;
;;; modules/tcp/tcp.cicili says why at its top.
;;;
;;; ---- the surface -------------------------------------------------------
;;;
;;; A Stream is `'$stream'(N)' from stream_open, or user_input, user_output,
;;; user_error. A Mode is read, write, append or update (read and write,
;;; the file kept). Text is an atom, a string, a code list or a char list.
;;;
;;;   stream_open(+Path, +Mode, -Stream)               a TEXT stream; no such file is existence_error(source_sink, Path)
;;;   stream_open(+Path, +Mode, +Options, -Stream)     type(text) or type(binary)
;;;   stream_close(+Stream)                            flushed and forgotten; the standard three: nothing, as ISO says
;;;   stream_flush(+Stream)
;;;   stream_eof(+Stream)                              nothing left to read
;;;   stream_position(+Stream, -Bytes)                 where the next byte lands, from the start
;;;   stream_seek(+Stream, +Bytes)                     from the start
;;;   stream_seek(+Stream, +Offset, +Whence)           bof, current or eof
;;;   stream_size(+Stream, -Bytes)                     the file's, whatever the position
;;;   stream_property(?Stream, ?Property)              file_name mode type encoding bom input output alias position end_of_stream eof_action reposition
;;;   character_count(+Stream, -Count)                 SWI's: characters read or written from the open
;;;   line_count(+Stream, -Line)                       the line, from 1
;;;   line_position(+Stream, -Column)                  the column, from 0
;;;   byte_count(+Stream, -Bytes)                      the bytes read or written from the open
;;;   is_stream(?Stream)                               a stream handle, an alias or a standard stream
;;;   stream_position_data(?Field, +Position, -Value)  char_count line_count line_position byte_count
;;;   set_stream(+Stream, +Attribute)                  SWI's: type encoding line_position alias, and the rest checked
;;;   stream_input(-Stream)  stream_output(-Stream)  stream_error(-Stream)   the standard three
;;;   -- binary --
;;;   stream_get_byte(+Stream, -Byte)                  0..255, or -1 at the end
;;;   stream_peek_byte(+Stream, -Byte)                 the same, and the byte stays
;;;   stream_put_byte(+Stream, +Byte)
;;;   stream_read_bytes(+Stream, +N, -Bytes)           up to N, as codes; [] at the end
;;;   stream_write_bytes(+Stream, +Bytes)              a code list, 0..255 each
;;;   -- text --
;;;   stream_get_char(+Stream, -Char)                  one UTF-8 character as an atom, or end_of_file
;;;   stream_peek_char(+Stream, -Char)
;;;   stream_put_char(+Stream, +Char)
;;;   stream_read_line(+Stream, -Codes)                the newline (and a CR before it) off; end_of_file at the end
;;;   stream_read_lines(+Stream, -Lines)               the rest, one code list a line
;;;   stream_write_text(+Stream, +Text)                as its characters
;;;   stream_nl(+Stream)
;;;   -- either kind --
;;;   stream_read_all(+Stream, -Codes)                 the rest of the stream
;;;   -- formatted --
;;;   stream_format(+Stream, +Format, +Args)           format/2's directives, into a text stream
;;;   stream_write(+Stream, +Term)                     as write/1 spells it
;;;   stream_writeq(+Stream, +Term)                    as writeq/1
;;;   stream_print(+Stream, +Term)                     as print/1
;;;   stream_write_canonical(+Stream, +Term)           as write_canonical/1
;;;   stream_write_term(+Stream, +Term, +Options)      as write_term/2
;;;   stream_with_output(+Stream, :Goal)               what Goal writes to stdout goes to the stream instead
;;;   stream_read_term(+Stream, -Term)                 one clause, up to its `. '; end_of_file at the end
;;;   stream_read_terms(+Stream, -Terms)               the rest, as a list
;;;   -- ISO's names over the same table; Stream is also an alias --
;;;   open(+Path, +Mode, -Stream)                      stream_open/3
;;;   open(+Path, +Mode, -Stream, +Options)            type(Kind) and alias(Name); swipl's others checked
;;;   close(+Stream)                                   stream_close/1
;;;   close(+Stream, +Options)                         force(Bool) checked, and taken as close/1
;;;   current_input(-Stream)                           what read/1 and get_char/1 read
;;;   current_output(-Stream)                          what write/1 and format/2 write
;;;   set_input(+Stream)
;;;   set_output(+Stream)                              a text stream; fd 1 follows it
;;;   flush_output(+Stream)
;;;   at_end_of_stream(+Stream)
;;;   at_end_of_stream                                 of the current input
;;;   set_stream_position(+Stream, +Position)          '$stream_position'(Char, Line, LinePos, Byte)
;;;   get_char(+Stream, -Char)
;;;   get_char(-Char)
;;;   peek_char(+Stream, -Char)
;;;   peek_char(-Char)
;;;   put_char(+Stream, +Char)
;;;   put_char(+Char)
;;;   get_code(+Stream, -Code)                         a byte, as atom_codes/2 counts (a code point under characters); -1 at the end
;;;   get_code(-Code)
;;;   peek_code(+Stream, -Code)
;;;   peek_code(-Code)
;;;   put_code(+Stream, +Code)                         past 255, the code point's UTF-8 (every code, under characters)
;;;   put_code(+Code)
;;;   get_byte(+Stream, -Byte)
;;;   get_byte(-Byte)
;;;   peek_byte(+Stream, -Byte)
;;;   peek_byte(-Byte)
;;;   put_byte(+Stream, +Byte)
;;;   put_byte(+Byte)
;;;   read(+Stream, -Term)
;;;   read(-Term)
;;;   read_term(+Stream, -Term, +Options)              variable_names variables singletons subterm_positions term_position
;;;   read_term(-Term, +Options)
;;;   write(+Stream, +Term)
;;;   writeq(+Stream, +Term)
;;;   print(+Stream, +Term)
;;;   write_canonical(+Stream, +Term)
;;;   write_term(+Stream, +Term, +Options)
;;;   nl(+Stream)
;;;   writeln(+Stream, +Term)                          write/2, then nl/1
;;;   portray_clause(+Stream, +Clause)                 portray_clause/1's layout
;;;   tab(+Stream, +N)
;;;   read_line_to_codes(+Stream, -Codes)              SWI's; end_of_file at the end
;;;   read_line_to_string(+Stream, -String)
;;;   read_stream_to_codes(+Stream, -Codes)
;;;   -- and the engine's own, given a stream or an alias as the sink --
;;;   format(+Stream, +Format, +Args)                  the engine's format/3
;;;   with_output_to(+Stream, :Goal)                   the engine's with_output_to/2

;;;; ------------------------------------------------------------------
;;;; The C half, as a table
;;;; ------------------------------------------------------------------
(DEFPARAMETER *stream-predicates*
  ;; a C half a predicate's error names takes that predicate's indicator as
  ;; its last argument, and a row of the engine's `*error-contexts*' (:PI)
  ;; names it (3.16.0): put_code/2's error is put_code/2's, not this table's
  '(("$stream_open"          7 st_p_open)
    ("$stream_enc"           4 st_p_enc)
    ("$stream_set"           5 st_p_set)
    ("$stream_close"         2 st_p_close)
    ("$stream_open_p"        1 st_p_open_p)
    ("$stream_slots"         1 st_p_slots)
    ("$stream_info"          5 st_p_info)
    ("$stream_set_alias"     2 st_p_set_alias)
    ("$stream_drop_alias"    1 st_p_drop_alias)
    ("$stream_by_alias"      2 st_p_by_alias)
    ("$stream_alias_of"      2 st_p_alias_of)
    ("$stream_cur"           2 st_p_cur)
    ("$stream_set_input"     3 st_p_set_input)
    ("$stream_set_output"    3 st_p_set_output)
    ("$stream_flush"         3 st_p_flush)
    ("$stream_eof"           3 st_p_eof)
    ("$stream_position"      4 st_p_position)
    ("$stream_seek"          5 st_p_seek)
    ("$stream_size"          4 st_p_size)
    ("$stream_set_pos"       7 st_p_set_pos)
    ("$stream_where"         6 st_p_where)
    ("$stream_out"           3 st_p_out)
    ("$stream_lastc"         2 st_p_lastc)
    ("$stream_lastc_set"     1 st_p_lastc_set)
    ("$stream_char"          3 st_p_char)
    ("$stream_get_byte"      4 st_p_get_byte)
    ("$stream_peek_byte"     4 st_p_peek_byte)
    ("$stream_put_byte"      4 st_p_put_byte)
    ("$stream_read_bytes"    5 st_p_read_bytes)
    ("$stream_write_bytes"   4 st_p_write_bytes)
    ("$stream_write_codes"   4 st_p_write_codes)
    ("$stream_read_all"      4 st_p_read_all)
    ("$stream_get_char"      4 st_p_get_char)
    ("$stream_peek_char"     4 st_p_peek_char)
    ("$stream_put_char"      4 st_p_put_char)
    ("$stream_get_code"      4 st_p_get_code)
    ("$stream_peek_code"     4 st_p_peek_code)
    ("$stream_put_code"      4 st_p_put_code)
    ("$stream_read_line"     4 st_p_read_line)
    ("$stream_write_text"    4 st_p_write_text)
    ("$stream_read_term"     7 st_p_read_term)
    ("$stream_read_term_pos" 12 st_p_read_term_pos)))

;;;; ------------------------------------------------------------------
;;;; The Coco half: the handle, the names, the formatted writers
;;;; ------------------------------------------------------------------
;;; A Cicili string literal cannot carry a newline, so clauses are joined
;;; with spaces; commentary lives out here.
;;;
;;; EVERY ERROR NAMES THE TERM THE PROGRAM WROTE, AND THE PREDICATE IT
;;; CALLED. `stream_slot/3' turns a handle into its slot and is where a
;;; closed stream, a stream that never was and a non-stream are told apart
;;; -- existence_error(stream, S), domain_error(stream_or_alias, S),
;;; instantiation_error, each context(system:PI, _) for the PI it is handed
;;; -- so the C half is only ever asked about a slot it handed out. The
;;; direction and kind checks are the C half's, because it holds the table;
;;; they raise `permission_error' with the handle, named by the PI the C
;;; half takes last.
;;;
;;; THE FORMATTED WRITERS ARE THE ENGINE'S FORMATTER INTO CODES, then the
;;; codes into the stream: one spelling of `~w', `~q', `~p' and every
;;; column directive, shared with the terminal, and no second writer to
;;; drift from the first. `stream_with_output/2' is `with_output_to/2'
;;; with the stream as the sink, which makes any goal that prints a goal
;;; that writes a file.
(DEFPARAMETER *stream-prolog*
  (FORMAT NIL "~{~A ~}"
          (LIST
           ;; ---- the handle, an alias, or a standard name ----
           "stream_input('$stream'(0))."
           "stream_output('$stream'(1))."
           "stream_error('$stream'(2))."
           ;; every error names the predicate the program called, swipl's
           ;; context(system:Name/Arity, _), or Module:Name/Arity as given
           "stream_err(F, PI) :- stream_err(F, PI, _)."
           "stream_err(F, PI, M) :- ( PI = _:_ -> C = PI ; C = system:PI ), throw(error(F, context(C, M)))."
           "stream_slot(S, _, PI) :- var(S), !, stream_err(instantiation_error, PI)."
           "stream_slot('$stream'(N), N, PI) :- integer(N), !, ( '$stream_open_p'(N) -> true ; stream_err(existence_error(stream, '$stream'(N)), PI) )."
           "stream_slot(user_input, 0, _) :- !."
           "stream_slot(user_output, 1, _) :- !."
           "stream_slot(user_error, 2, _) :- !."
           "stream_slot(A, N, PI) :- atom(A), !, ( '$stream_by_alias'(A, N) -> true ; stream_err(existence_error(stream, A), PI) )."
           "stream_slot(S, _, PI) :- stream_err(domain_error(stream_or_alias, S), PI)."
           ;; the formatted writers' check: a stream, and one that takes output
           "stream_out(S, PI) :- stream_slot(S, N, PI), '$stream_out'(S, N, PI)."
           "stream_must(X, PI) :- ( var(X) -> stream_err(instantiation_error, PI) ; true )."
           "stream_bool(X, PI) :- stream_must(X, PI), ( memberchk(X, [true, false, on, off]) -> true ; stream_err(type_error(bool, X), PI) )."
           "stream_one_of(X, L, D, PI) :- stream_must(X, PI), ( memberchk(X, L) -> true ; stream_err(domain_error(D, X), PI) )."
           ;; a byte is checked before the stream, as swipl's put_byte/2 checks it
           "stream_byte(B, PI) :- ( integer(B), B >= 0, B =< 255 -> true ; var(B) -> stream_err(instantiation_error, PI) ; stream_err(type_error(byte, B), PI) )."

           ;; ---- open and close ----
           ;; swipl's order: the options a list, the mode, each option, the
           ;; alias free, the file, and then the stream: unbound, or with an
           ;; alias given the alias, which is the stream (swipl unifies it; of
           ;; two the last), and another term fails -- the file opened is
           ;; closed again, where swipl's stays open
           "stream_open(Path, Mode, S) :- stream_open(Path, Mode, [], S, stream_open/3)."
           "stream_open(Path, Mode, Opts, S) :- stream_open(Path, Mode, Opts, S, stream_open/4)."
           ;; the encoding (3.19.0): a binary stream's is octet and no other,
           ;; swipl's 'type(binary) implies encoding(octet)'; one not given is
           ;; UTF-8's, or octet's for binary; bom(B) -1 when not given
           "stream_open(Path, Mode, Opts, S, PI) :- stream_list(Opts, PI), stream_mode(Mode, M, PI), stream_open_opts(Opts, o(text, _, _, _), o(T, A, E, B), PI), stream_type(T, K), stream_enc_check(T, E, PI), stream_enc_of(T, E, EI), stream_bom_of(B, BI), ( nonvar(A) -> stream_alias_free(A, PI) ; true ), '$stream_open'(Path, M, K, EI, BI, N, PI), stream_bind(S, N, A, PI)."
           "stream_enc_check(binary, E, PI) :- nonvar(E), E \\== octet, !, stream_err(domain_error(encoding, E), PI, 'type(binary) implies encoding(octet)')."
           "stream_enc_check(_, _, _)."
           "stream_enc_of(_, E, I) :- nonvar(E), !, stream_enc_id(E, I)."
           "stream_enc_of(binary, _, 1) :- !."
           "stream_enc_of(_, _, 0)."
           "stream_bom_of(B, -1) :- var(B), !."
           "stream_bom_of(B, 1) :- memberchk(B, [true, on]), !."
           "stream_bom_of(_, 0)."
           "stream_enc_id(utf8, 0). stream_enc_id(octet, 1). stream_enc_id(ascii, 2). stream_enc_id(iso_latin_1, 3). stream_enc_id(text, 4)."
           "stream_enc_id(unicode_be, 5). stream_enc_id(unicode_le, 6). stream_enc_id(utf16be, 7). stream_enc_id(utf16le, 8). stream_enc_id(wchar_t, 9)."
           "stream_enc_names([octet, ascii, iso_latin_1, text, utf8, unicode_be, unicode_le, utf16be, utf16le, wchar_t])."
           "stream_bind(S, N, A, _) :- nonvar(A), !, ( S = A -> '$stream_set_alias'(N, A) ; '$stream_close'('$stream'(N), N), fail )."
           "stream_bind(S, N, _, _) :- var(S), !, S = '$stream'(N)."
           "stream_bind(S, N, _, PI) :- '$stream_close'('$stream'(N), N), stream_err(uninstantiation_error(S), PI, 'stream-argument')."
           "stream_list(L, PI) :- var(L), !, stream_err(instantiation_error, PI)."
           "stream_list([], _) :- !."
           "stream_list([_|T], PI) :- !, stream_list(T, PI)."
           "stream_list(T, PI) :- stream_err(type_error(list, T), PI)."
           "stream_mode(M, _, PI) :- var(M), !, stream_err(instantiation_error, PI)."
           "stream_mode(read, 1, _) :- !."
           "stream_mode(write, 2, _) :- !."
           "stream_mode(append, 3, _) :- !."
           "stream_mode(update, 4, _) :- !."
           "stream_mode(M, _, PI) :- atom(M), !, stream_err(domain_error(io_mode, M), PI)."
           "stream_mode(M, _, PI) :- stream_err(type_error(atom, M), PI)."
           "stream_open_opts([], R, R, _)."
           "stream_open_opts([O|Os], R0, R, PI) :- stream_open_opt(O, R0, R1, PI), stream_open_opts(Os, R1, R, PI)."
           "stream_open_opt(type(T), o(_, A, E, B), o(T, A, E, B), PI) :- !, stream_must(T, PI), ( memberchk(T, [text, binary]) -> true ; stream_err(domain_error(stream_option, type(T)), PI) )."
           "stream_open_opt(alias(A), o(T, _, E, B), o(T, A, E, B), PI) :- !, stream_must(A, PI), ( atom(A) -> true ; stream_err(type_error(atom, A), PI) )."
           "stream_open_opt(eof_action(X), R, R, PI) :- !, stream_one_of(X, [eof_code, error, reset], eof_action, PI)."
           "stream_open_opt(encoding(X), o(T, A, _, B), o(T, A, X, B), PI) :- !, stream_enc_names(L), stream_one_of(X, L, encoding, PI)."
           "stream_open_opt(lock(X), R, R, PI) :- !, stream_one_of(X, [none, read, shared, write, exclusive], lock, PI)."
           "stream_open_opt(create(X), R, R, PI) :- !, stream_must(X, PI), ( is_list(X) -> true ; stream_err(type_error(list, X), PI) )."
           "stream_open_opt(close_on_abort(X), R, R, PI) :- !, stream_bool(X, PI)."
           "stream_open_opt(wait(X), R, R, PI) :- !, stream_bool(X, PI)."
           "stream_open_opt(bom(X), o(T, A, E, _), o(T, A, E, X), PI) :- !, stream_bool(X, PI)."
           "stream_open_opt(reposition(X), R, R, PI) :- !, stream_bool(X, PI)."
           ;; an option swipl does not know is passed by, a non-option refused
           "stream_open_opt(O, R, R, PI) :- ( compound(O), functor(O, _, 1) -> true ; stream_err(type_error(option, O), PI) )."
           "stream_type(text, 1)."
           "stream_type(binary, 2)."
           "stream_alias_free(A, PI) :- ( ( memberchk(A, [user_input, user_output, user_error]) ; '$stream_by_alias'(A, _) ) -> stream_err(permission_error(open, source_sink, alias(A)), PI) ; true )."
           ;; closing a standard stream does nothing, which is ISO's rule; a
           ;; handle closed before is swipl's existence_error, 'already closed'
           "stream_close(S) :- stream_close(S, stream_close/1)."
           "stream_close(S, PI) :- ( nonvar(S), S = '$stream'(N), integer(N) -> ( '$stream_open_p'(N) -> true ; stream_err(existence_error(stream, S), PI, 'already closed') ) ; stream_slot(S, N, PI) ), ( N < 3 -> true ; '$stream_close'(S, N) )."
           "stream_close_opts(O, PI) :- var(O), !, stream_err(instantiation_error, PI)."
           "stream_close_opts([], _) :- !."
           "stream_close_opts([O|Os], PI) :- !, stream_close_opt(O, PI), stream_close_opts(Os, PI)."
           "stream_close_opts(O, PI) :- stream_err(type_error(list, O), PI)."
           "stream_close_opt(force(B), PI) :- !, stream_bool(B, PI)."
           "stream_close_opt(O, PI) :- ( compound(O), functor(O, _, 1) -> true ; stream_err(type_error(option, O), PI) )."
           "stream_flush(S) :- stream_flush(S, stream_flush/1)."
           "stream_flush(S, PI) :- stream_slot(S, N, PI), '$stream_flush'(S, N, PI)."
           "stream_eof(S) :- stream_eof(S, stream_eof/1)."
           "stream_eof(S, PI) :- stream_slot(S, N, PI), '$stream_eof'(S, N, PI)."
           "stream_position(S, P) :- stream_slot(S, N, stream_position/2), '$stream_position'(S, N, P, stream_position/2)."
           "stream_seek(S, P) :- stream_slot(S, N, stream_seek/2), '$stream_seek'(S, N, P, 0, stream_seek/2)."
           "stream_seek(S, Off, Whence) :- stream_slot(S, N, stream_seek/3), stream_whence(Whence, W), '$stream_seek'(S, N, Off, W, stream_seek/3)."
           "stream_whence(bof, 0) :- !."
           "stream_whence(current, 1) :- !."
           "stream_whence(eof, 2) :- !."
           "stream_whence(W, _) :- stream_err(domain_error(stream_whence, W), stream_seek/3)."
           "stream_size(S, B) :- stream_slot(S, N, stream_size/2), '$stream_size'(S, N, B, stream_size/2)."
           ;; ---- swipl's counters (3.17.0): a stream's position, field by
           ;; field, and whether a term names an open stream ----
           "character_count(S, C) :- stream_slot(S, N, character_count/2), '$stream_where'(S, N, C0, _, _, _), C = C0."
           "line_count(S, L) :- stream_slot(S, N, line_count/2), '$stream_where'(S, N, _, L0, _, _), L = L0."
           "line_position(S, P) :- stream_slot(S, N, line_position/2), '$stream_where'(S, N, _, _, P0, _), P = P0."
           "byte_count(S, B) :- stream_slot(S, N, byte_count/2), '$stream_where'(S, N, _, _, _, B0), B = B0."
           "is_stream(S) :- nonvar(S), ( S = '$stream'(N) -> integer(N), '$stream_open_p'(N) ; atom(S), ( memberchk(S, [user_input, user_output, user_error]) -> true ; '$stream_by_alias'(S, _) ) )."
           ;; swipl's boot/init.pl, to the letter: a field it does not know is
           ;; error/1, and a position that is no compound arg/3's errors
           "stream_position_data(F, P, V) :- nonvar(F), !, ( stream_pos_field(F, I) -> stream_pos_arg(I, P, V) ; throw(error(domain_error(stream_position_data, F))) )."
           "stream_position_data(F, P, V) :- stream_pos_field(F, I), stream_pos_arg(I, P, V)."
           "stream_pos_field(char_count, 1). stream_pos_field(line_count, 2). stream_pos_field(line_position, 3). stream_pos_field(byte_count, 4)."
           "stream_pos_arg(_, P, _) :- var(P), !, throw(error(instantiation_error, context(arg/3, _)))."
           "stream_pos_arg(I, P, V) :- compound(P), !, arg(I, P, V)."
           "stream_pos_arg(_, P, _) :- throw(error(type_error(compound, P), context(arg/3, _)))."

           ;; ---- set_stream/2, swipl's (3.19.0): the alias, the encoding, the
           ;; type and the column take effect; the other attributes swipl knows
           ;; are checked as swipl checks them and change nothing here ----
           "set_stream(S, P) :- stream_slot(S, N, set_stream/2), stream_set(P, S, N)."
           "stream_set(P, _, _) :- var(P), !, stream_err(instantiation_error, set_stream/2)."
           "stream_set(alias(A), _, N) :- !, stream_atom(A), stream_alias_take(A, N)."
           "stream_set(encoding(E), S, N) :- !, stream_atom(E), stream_enc_names(L), ( memberchk(E, L) -> true ; stream_err(domain_error(encoding, E), set_stream/2) ), stream_enc_id(E, I), '$stream_set'(S, N, 0, I, set_stream/2)."
           ;; swipl names type/1's domain error by set_stream/2 bare, as it does
           "stream_set(type(T), S, N) :- !, stream_must(T, set_stream/2), ( stream_type(T, K) -> true ; throw(error(domain_error(type, T), context(set_stream/2, _))) ), '$stream_set'(S, N, 1, K, set_stream/2)."
           "stream_set(line_position(P), S, N) :- !, stream_int(P), '$stream_set'(S, N, 2, P, set_stream/2)."
           "stream_set(buffer(X), _, _) :- !, stream_one_of(X, [full, line, false], buffer, set_stream/2)."
           "stream_set(buffer_size(X), _, _) :- !, stream_int(X), ( X >= 1 -> true ; stream_err(domain_error(not_less_than_one, X), set_stream/2) )."
           "stream_set(close_on_abort(X), _, _) :- !, stream_bool(X, set_stream/2)."
           "stream_set(close_on_exec(X), _, _) :- !, stream_bool(X, set_stream/2)."
           "stream_set(record_position(X), _, _) :- !, stream_bool(X, set_stream/2)."
           "stream_set(tty(X), _, _) :- !, stream_bool(X, set_stream/2)."
           "stream_set(eof_action(_), _, _) :- !."
           ;; a name swipl does not know is its instantiation_error, and so
           ;; is an unbound one; anything but an atom type_error(atom, X)
           "stream_set(newline(X), _, _) :- !, stream_atom(X), ( memberchk(X, [posix, dos, detect]) -> true ; stream_err(instantiation_error, set_stream/2) )."
           "stream_set(representation_errors(X), _, _) :- !, stream_one_of(X, [error, prolog, xml], representation_errors, set_stream/2)."
           "stream_set(write_errors(X), _, _) :- !, stream_one_of(X, [error, ignore], write_errors, set_stream/2)."
           "stream_set(timeout(X), _, _) :- !, stream_must(X, set_stream/2), ( ( number(X) ; X == infinite ) -> true ; stream_err(type_error(float, X), set_stream/2) )."
           "stream_set(file_name(X), _, _) :- !, stream_atom(X)."
           ;; a locale is swipl's default one or none it knows
           "stream_set(locale(X), _, _) :- !, stream_must(X, set_stream/2), ( X == default -> true ; stream_err(existence_error(locale, X), set_stream/2) )."
           "stream_set(P, _, _) :- compound(P), !, stream_err(domain_error(stream_attribute, P), set_stream/2)."
           "stream_set(P, _, _) :- stream_err(type_error(stream_attribute, P), set_stream/2)."
           "stream_atom(X) :- stream_must(X, set_stream/2), ( atom(X) -> true ; stream_err(type_error(atom, X), set_stream/2) )."
           "stream_int(X) :- stream_must(X, set_stream/2), ( integer(X) -> true ; stream_err(type_error(integer, X), set_stream/2) )."
           ;; an alias is one stream's: another that held it gives it up
           "stream_alias_take(A, N) :- ( '$stream_by_alias'(A, M), M =\\= N -> '$stream_drop_alias'(M) ; true ), '$stream_set_alias'(N, A)."

           ;; ---- the properties, ISO's, enumerable over the table ----
           "stream_property(S, P) :- nonvar(S), !, ( var(P) -> PI = '$stream_properties'/2 ; PI = '$stream_property'/2 ), stream_slot(S, N, PI), stream_prop('$stream'(N), N, P)."
           "stream_property(S, P) :- '$stream_slots'(Ns), member(N, Ns), S = '$stream'(N), stream_prop(S, N, P)."
           "stream_prop(S, N, file_name(Path)) :- N >= 3, '$stream_info'(S, N, Path, _, _)."
           ;; the names read the other way round, by tables: stream_mode/3 checks its
           ;; argument first, which is right for open/4 and wrong for a property
           "stream_prop(S, N, mode(Mode)) :- '$stream_info'(S, N, _, M, _), stream_mode_name(M, Mode)."
           "stream_prop(S, N, type(Type)) :- '$stream_info'(S, N, _, _, K), stream_type_name(K, Type)."
           ;; the encoding, by swipl's name, and bom(true) where a BOM was read
           ;; or written (3.19.0); a stream with none has no bom property
           "stream_prop(S, N, encoding(E)) :- '$stream_enc'(S, N, I, _), stream_enc_id(E, I)."
           "stream_prop(S, N, bom(true)) :- '$stream_enc'(S, N, _, 1)."
           "stream_prop(S, N, input) :- '$stream_info'(S, N, _, M, _), ( M =:= 1 ; M =:= 4 )."
           "stream_prop(S, N, output) :- '$stream_info'(S, N, _, M, _), M >= 2."
           "stream_prop(_, N, alias(A)) :- stream_std_alias(N, A)."
           "stream_prop(_, N, alias(A)) :- '$stream_alias_of'(N, A)."
           ;; swipl's position: characters, the line, the column and bytes,
           ;; counted from the open by every byte read or written here
           "stream_prop(S, N, position('$stream_position'(C, L, LP, B))) :- N >= 3, '$stream_where'(S, N, C, L, LP, B)."
           "stream_prop(S, N, end_of_stream(E)) :- N >= 3, '$stream_info'(S, N, _, M, _), ( M =:= 1 ; M =:= 4 ), ( '$stream_eof'(S, N, stream_property/2) -> E = at ; E = not )."
           "stream_prop(_, _, eof_action(eof_code))."
           "stream_prop(_, N, reposition(B)) :- ( N >= 3 -> B = true ; B = false )."
           "stream_mode_name(1, read). stream_mode_name(2, write). stream_mode_name(3, append). stream_mode_name(4, update)."
           "stream_type_name(1, text). stream_type_name(2, binary)."
           "stream_std_alias(0, user_input)."
           "stream_std_alias(1, user_output)."
           "stream_std_alias(2, user_error)."

           ;; ---- bytes ----
           "stream_get_byte(S, B) :- stream_slot(S, N, stream_get_byte/2), '$stream_get_byte'(S, N, B, stream_get_byte/2)."
           "stream_peek_byte(S, B) :- stream_slot(S, N, stream_peek_byte/2), '$stream_peek_byte'(S, N, B, stream_peek_byte/2)."
           "stream_put_byte(S, B) :- stream_byte(B, stream_put_byte/2), stream_slot(S, N, stream_put_byte/2), '$stream_put_byte'(S, N, B, stream_put_byte/2)."
           "stream_read_bytes(S, Count, Bs) :- stream_slot(S, N, stream_read_bytes/3), '$stream_read_bytes'(S, N, Count, Bs, stream_read_bytes/3)."
           "stream_write_bytes(S, Bs) :- stream_slot(S, N, stream_write_bytes/2), '$stream_write_bytes'(S, N, Bs, stream_write_bytes/2)."
           "stream_read_all(S, Cs) :- stream_slot(S, N, stream_read_all/2), '$stream_read_all'(S, N, Cs, stream_read_all/2)."

           ;; ---- characters and lines ----
           ;; a character to put is checked before the stream, as swipl's
           ;; put_char/2 checks it ('$stream_char'/3 gives its code)
           "stream_get_char(S, C) :- stream_slot(S, N, stream_get_char/2), '$stream_get_char'(S, N, C, stream_get_char/2)."
           "stream_peek_char(S, C) :- stream_slot(S, N, stream_peek_char/2), '$stream_peek_char'(S, N, C, stream_peek_char/2)."
           "stream_put_char(S, C) :- '$stream_char'(C, K, stream_put_char/2), stream_slot(S, N, stream_put_char/2), '$stream_put_char'(S, N, K, stream_put_char/2)."
           "stream_read_line(S, L) :- stream_slot(S, N, stream_read_line/2), '$stream_read_line'(S, N, L, stream_read_line/2)."
           "stream_read_lines(S, Ls) :- stream_slot(S, N, stream_read_lines/2), stream_lines_(S, N, Ls)."
           "stream_lines_(S, N, Ls) :- '$stream_read_line'(S, N, L, stream_read_lines/2), ( L == end_of_file -> Ls = [] ; Ls = [L|Rest], stream_lines_(S, N, Rest) )."
           "stream_write_text(S, T) :- stream_slot(S, N, stream_write_text/2), '$stream_write_text'(S, N, T, stream_write_text/2)."
           "stream_nl(S) :- stream_slot(S, N, stream_nl/1), '$stream_write_codes'(S, N, [10], stream_nl/1)."

           ;; ---- formatted: the engine's formatter, into the stream through the sink hook ----
           "stream_format(S, F, A) :- stream_out(S, stream_format/3), format(S, F, A)."
           "stream_write(S, T) :- stream_out(S, stream_write/2), format(S, '~w', [T])."
           "stream_writeq(S, T) :- stream_out(S, stream_writeq/2), format(S, '~q', [T])."
           "stream_print(S, T) :- stream_out(S, stream_print/2), format(S, '~p', [T])."
           "stream_write_canonical(S, T) :- stream_out(S, stream_write_canonical/2), with_output_to(S, write_canonical(T))."
           "stream_write_term(S, T, O) :- stream_wt(S, T, O, stream_write_term/3)."
           ;; write_term/2's options are checked before the stream, as swipl's are
           ;; (3.16.0; through 3.15.2 after the stream's name): the term written to a string first;
           ;; a cyclic term under cycles(false) after it, as swipl's writeTopTerm() asks (3.55.0)
           "stream_wt(S, T, O, PI) :- '$stream_lastc'(S, C), catch(with_output_to(string(X), ('$stream_lastc_set'(C), write_term(T, O))), error(E, context(system:write_term/2, M)), stream_wt_err(E, S, PI, M)), stream_slot(S, N, PI), '$stream_out'(S, N, PI), '$stream_write_text'(S, N, X, PI)."
           "stream_wt_err(domain_error(cyclic_term, C), S, PI, M) :- !, stream_slot(S, N, PI), '$stream_out'(S, N, PI), stream_err(domain_error(cyclic_term, C), PI, M)."
           "stream_wt_err(E, _, PI, M) :- stream_err(E, PI, M)."
           "stream_with_output(S, G) :- stream_out(S, stream_with_output/2), with_output_to(S, G)."
           "stream_read_term(S, T) :- stream_slot(S, N, stream_read_term/2), stream_rt(S, N, T, [], stream_read_term/2)."
           "stream_read_terms(S, Ts) :- stream_slot(S, N, stream_read_terms/2), stream_rts(S, N, Ts)."
           "stream_rts(S, N, Ts) :- stream_rt(S, N, T, [], stream_read_terms/2), ( T == end_of_file -> Ts = [] ; Ts = [T|Rest], stream_rts(S, N, Rest) )."

           ;; ---- ISO's names, over the same table ----
           "open(F, M, S) :- stream_open(F, M, [], S, open/3)."
           "open(F, M, S, O) :- stream_open(F, M, O, S, open/4)."
           "close(S) :- stream_close(S, close/1)."
           "close(S, O) :- stream_close_opts(O, close/2), stream_close(S, close/2)."
           ;; a stream given is compared with the current one, as swipl's
           "current_input(S) :- '$stream_cur'(0, N), ( var(S) -> S = '$stream'(N) ; stream_slot(S, M, current_input/1), M =:= N )."
           "current_output(S) :- '$stream_cur'(1, N), ( var(S) -> S = '$stream'(N) ; stream_slot(S, M, current_output/1), M =:= N )."
           "set_input(S) :- stream_slot(S, N, set_input/1), '$stream_set_input'(S, N, set_input/1)."
           "set_output(S) :- stream_slot(S, N, set_output/1), '$stream_set_output'(S, N, set_output/1)."
           "flush_output(S) :- stream_flush(S, flush_output/1)."
           "at_end_of_stream :- '$stream_cur'(0, N), '$stream_eof'(current_input, N, at_end_of_stream/0)."
           "at_end_of_stream(S) :- stream_eof(S, at_end_of_stream/1)."
           ;; a position is the property's '$stream_position'(C, L, LP, B), and
           ;; anything else is swipl's domain_error, named stream_position/3
           "set_stream_position(S, P) :- stream_slot(S, N, set_stream_position/2), stream_pos(P, C, L, LP, B), '$stream_set_pos'(S, N, C, L, LP, B, set_stream_position/2)."
           "stream_pos(P, _, _, _, _) :- var(P), !, throw(error(instantiation_error, context(stream_position/3, _)))."
           "stream_pos('$stream_position'(C, L, LP, B), C, L, LP, B) :- integer(C), integer(L), integer(LP), integer(B), !."
           "stream_pos(P, _, _, _, _) :- throw(error(domain_error(stream_position, P), context(stream_position/3, _)))."
           ;; the forms of one argument read the current stream, named as swipl
           ;; names it in an error: current_input, current_output
           "get_char(C) :- '$stream_cur'(0, N), '$stream_get_char'(current_input, N, C, get_char/1)."
           "get_char(S, C) :- stream_slot(S, N, get_char/2), '$stream_get_char'(S, N, C, get_char/2)."
           "peek_char(C) :- '$stream_cur'(0, N), '$stream_peek_char'(current_input, N, C, peek_char/1)."
           "peek_char(S, C) :- stream_slot(S, N, peek_char/2), '$stream_peek_char'(S, N, C, peek_char/2)."
           "put_char(C) :- '$stream_char'(C, K, put_char/1), '$stream_cur'(1, N), '$stream_put_char'(current_output, N, K, put_char/1)."
           "put_char(S, C) :- '$stream_char'(C, K, put_char/2), stream_slot(S, N, put_char/2), '$stream_put_char'(S, N, K, put_char/2)."
           "get_code(C) :- '$stream_cur'(0, N), '$stream_get_code'(current_input, N, C, get_code/1)."
           "get_code(S, C) :- stream_slot(S, N, get_code/2), '$stream_get_code'(S, N, C, get_code/2)."
           "peek_code(C) :- '$stream_cur'(0, N), '$stream_peek_code'(current_input, N, C, peek_code/1)."
           "peek_code(S, C) :- stream_slot(S, N, peek_code/2), '$stream_peek_code'(S, N, C, peek_code/2)."
           "put_code(C) :- '$stream_char'(C, K, put_code/1), '$stream_cur'(1, N), '$stream_put_code'(current_output, N, K, put_code/1)."
           "put_code(S, C) :- '$stream_char'(C, K, put_code/2), stream_slot(S, N, put_code/2), '$stream_put_code'(S, N, K, put_code/2)."
           "get_byte(B) :- '$stream_cur'(0, N), '$stream_get_byte'(current_input, N, B, get_byte/1)."
           "get_byte(S, B) :- stream_slot(S, N, get_byte/2), '$stream_get_byte'(S, N, B, get_byte/2)."
           "peek_byte(B) :- '$stream_cur'(0, N), '$stream_peek_byte'(current_input, N, B, peek_byte/1)."
           "peek_byte(S, B) :- stream_slot(S, N, peek_byte/2), '$stream_peek_byte'(S, N, B, peek_byte/2)."
           "put_byte(B) :- stream_byte(B, put_byte/1), '$stream_cur'(1, N), '$stream_put_byte'(current_output, N, B, put_byte/1)."
           "put_byte(S, B) :- stream_byte(B, put_byte/2), stream_slot(S, N, put_byte/2), '$stream_put_byte'(S, N, B, put_byte/2)."
           "read(T) :- '$stream_cur'(0, N), stream_rt('$stream'(N), N, T, [], read/1)."
           "read(S, T) :- stream_slot(S, N, read/2), stream_rt(S, N, T, [], read/2)."
           "read_term(T, O) :- '$stream_cur'(0, N), stream_rt('$stream'(N), N, T, O, read_term/2)."
           "read_term(S, T, O) :- stream_slot(S, N, read_term/3), stream_rt(S, N, T, O, read_term/3)."
           ;; the options are checked before a byte is read, as swipl checks
           ;; them; every byte is counted, and the positions are built only when
           ;; an option asks for them; end_of_file spans its name from the end
           "stream_rt(S, N, T, O, PI) :- stream_read_opts(O, PI), ( stream_wants_pos(O) -> '$stream_read_term_pos'(S, N, K, T0, Ns0, Msg, P, C, L, LP, B, PI), W = '$stream_position'(C, L, LP, B), ( K == end_of_file -> E is C + 11, P = C-E ; true ) ; '$stream_read_term'(S, N, K, T0, Ns0, Msg, PI) ), stream_read_result(K, N, T0, Ns0, Msg, T1, Ns), stream_read_options(O, r(T1, Ns, P, W)), T = T1."
           "stream_read_opts(Os, PI) :- var(Os), !, stream_err(instantiation_error, PI)."
           "stream_read_opts([], _) :- !."
           "stream_read_opts([O|Os], PI) :- !, ( var(O) -> stream_err(instantiation_error, PI) ; compound(O), functor(O, _, 1) -> true ; stream_err(type_error(option, O), PI) ), stream_read_opts(Os, PI)."
           "stream_read_opts(Os, PI) :- stream_err(type_error(list, Os), PI)."
           "stream_wants_pos(Os) :- Os = [O|Rest], ( ( O = term_position(_) ; O = subterm_positions(_) ) -> true ; stream_wants_pos(Rest) )."
           "stream_read_result(term, _, T, Ns, _, T, Ns) :- !."
           "stream_read_result(end_of_file, _, _, _, _, end_of_file, []) :- !."
           "stream_read_result(syntax_error, N, _, _, '$syntax'(Id, L, LP, C), _, _) :- stream_syntax_context(N, L, LP, C, Ctx), throw(error(syntax_error(Id), Ctx))."
           "stream_syntax_context(N, L, LP, C, file(F, L, LP, C)) :- L > 0, N >= 3, '$stream_info'('$stream'(N), N, F, _, _), !."
           "stream_syntax_context(N, L, LP, C, stream(S1, L, LP, C)) :- ( stream_std_alias(N, A) -> S1 = A ; S1 = '$stream'(N) )."
           "stream_read_options([], _)."
           "stream_read_options([O|Os], R) :- stream_read_option(O, R), stream_read_options(Os, R)."
           "stream_read_option(variable_names(V), r(_, Ns, _, _)) :- !, V = Ns."
           "stream_read_option(variables(V), r(T, _, _, _)) :- !, term_variables(T, V)."
           "stream_read_option(singletons(V), r(T, Ns, _, _)) :- !, stream_singletons(Ns, T, V)."
           "stream_read_option(subterm_positions(V), r(_, _, P, _)) :- !, V = P."
           "stream_read_option(term_position(V), r(_, _, _, W)) :- !, V = W."
           ;; an option SWI or a later ISO revision knows and this reader does
           ;; not (syntax_errors, comments, ...) is accepted and has no
           ;; effect, so a program written for SWI reads the same terms
           "stream_read_option(_, _)."
           "stream_singletons([], _, [])."
           "stream_singletons([Name = V|Ns], T, Out) :- stream_occurs(T, V, 0, K), atom_codes(Name, [C0|_]), ( K =:= 1, ( C0 < 95 ; C0 > 95 ) -> Out = [Name = V|Rest] ; Out = Rest ), stream_singletons(Ns, T, Rest)."
           "stream_occurs(X, V, K0, K) :- var(X), !, ( X == V -> K is K0 + 1 ; K = K0 )."
           "stream_occurs(X, V, K0, K) :- compound(X), !, X =.. [_|As], stream_occurs_list(As, V, K0, K)."
           "stream_occurs(_, _, K, K)."
           "stream_occurs_list([], _, K, K)."
           "stream_occurs_list([A|As], V, K0, K) :- stream_occurs(A, V, K0, K1), stream_occurs_list(As, V, K1, K)."
           ;; the sink's errors (a character a binary stream cannot hold) are the
           ;; predicate's, as swipl's name write/2 (3.16.0)
           "stream_put(G, PI) :- catch(G, error(E, C), stream_put_err(E, C, PI))."
           "stream_put_err(E, C, PI) :- nonvar(C), C = context(Q, M), ( Q == system:format/3 ; Q == system:with_output_to/2 ), !, stream_err(E, PI, M)."
           "stream_put_err(E, C, _) :- throw(error(E, C))."
           "write(S, T) :- stream_out(S, write/2), stream_put(format(S, '~w', [T]), write/2)."
           "writeq(S, T) :- stream_out(S, writeq/2), stream_put(format(S, '~q', [T]), writeq/2)."
           "print(S, T) :- stream_out(S, print/2), stream_put(format(S, '~p', [T]), print/2)."
           "write_canonical(S, T) :- stream_out(S, write_canonical/2), stream_put(with_output_to(S, write_canonical(T)), write_canonical/2)."
           "write_term(S, T, O) :- stream_wt(S, T, O, write_term/3)."
           "nl(S) :- stream_slot(S, N, nl/1), '$stream_write_codes'(S, N, [10], nl/1)."
           ;; swipl's writeln/2 (3.9.0): write/2 and then a newline
           "writeln(S, T) :- stream_out(S, writeln/2), stream_put(format(S, '~w~n', [T]), writeln/2)."
           ;; swipl's portray_clause/2 (3.19.0): portray_clause/1's layout,
           ;; the clause starting a line of its own
           "portray_clause(S, T) :- stream_out(S, portray_clause/2), stream_put(with_output_to(S, portray_clause(T)), portray_clause/2)."
           ;; the stream's direction before the count, whose errors are tab/2's
           "tab(S, N) :- stream_out(S, tab/2), catch(with_output_to(S, tab(N)), error(E, context(system:tab/1, M)), stream_err(E, tab/2, M))."

           ;; ---- SWI's library(readutil), which ported programs call constantly ----
           ;; named as swipl's: read_util's, and read_string/5 for a string
           "read_line_to_codes(S, L) :- stream_slot(S, N, read_util:read_line_to_codes/2), '$stream_read_line'(S, N, L, read_util:read_line_to_codes/2)."
           "read_line_to_string(S, Str) :- stream_slot(S, N, read_string/5), '$stream_read_line'(S, N, L, read_string/5), ( L == end_of_file -> Str = end_of_file ; string_codes(Str, L) )."
           "read_stream_to_codes(S, Cs) :- stream_slot(S, N, read_util:read_stream_to_codes/2), '$stream_read_all'(S, N, Cs, read_util:read_stream_to_codes/2).")))

;;;; ------------------------------------------------------------------
;;;; The C half
;;;; ------------------------------------------------------------------
(source "stream.c"
  (make :std #t :compile #f)

  (include <stdio.h>)
  (include <stdlib.h>)
  (include <string.h>)
  (include <errno.h>)
  (include <unistd.h>)

  (import "./sdk.cicili")
  (coco-sdk)

  ;;; ---- the table: a handle is a slot, and the slot knows its kind ----
  ;;;
  ;;; Slots 0, 1 and 2 are stdin, stdout and stderr, filled the first time
  ;;; anything asks, and never closed. A slot's PUSHBACK holds the bytes a
  ;;; peek gave back -- up to a whole UTF-8 character -- as a stack, so
  ;;; that a peek needs no seek and works on a pipe as well as a file.
  (static) (var FILE * st_file [256])
  (static) (var int st_kind [256])          ; 0 free, 1 text, 2 binary
  (static) (var int st_mode [256])          ; 1 read, 2 write, 3 append, 4 update
  (static) (var char * st_path [256])
  (static) (var u8 st_push [256][8])
  (static) (var int st_npush [256])
  (static) (var char * st_alias [256])      ; open(..., [alias(A)]), or null
  (static) (var int st_ready . 0)

  ;;; THE ENCODING (3.19.0), swipl's names by number: 0 utf8, 1 octet, 2
  ;;; ascii, 3 iso_latin_1, 4 text, 5 unicode_be, 6 unicode_le, 7 utf16be,
  ;;; 8 utf16le, 9 wchar_t -- and its CLASS, which is what the reads and
  ;;; writes ask: 0 UTF-8 (utf8, text), 1 one byte a character (a binary
  ;;; stream, octet, ascii, iso_latin_1), 2 UTF-16 big-endian, 3 UTF-16
  ;;; little-endian, 4 UCS-4 little-endian (wchar_t). A UTF-16 or UCS-4
  ;;; stream is DECODED INTO UTF-8 below the pushback: a character is read
  ;;; from the file and its UTF-8 bytes handed up one at a time, so every
  ;;; reader above sees the text a UTF-8 stream would give, and a write is
  ;;; its UTF-8 encoded again (`st_emit'). `st_praw' is how many of the
  ;;; file's bytes the character decoded last took, which its first byte
  ;;; counts. A BOM read at the open, or written there, is `st_bom';
  ;;; `st_bomlen' the bytes
  ;;; it took, after which a count again from the start begins.
  (static) (var int st_enc [256])
  (static) (var int st_cls [256])
  (static) (var int st_praw [256])
  (static) (var int st_bom [256])
  (static) (var int st_bomlen [256])

  ;;; WHERE A READ STANDS, as SWI counts it for read_term/3's positions
  ;;; (1.10.7): the bytes and the characters taken, the line from 1 and
  ;;; the column from 0 -- a tab to the next multiple of eight, a CR back
  ;;; to 0, a backspace one back. Every byte `st_getc' takes is counted and
  ;;; every one `st_ungetc' gives back uncounted, so a pipe has a position
  ;;; too; the column before each of the last eight bytes is kept, which is
  ;;; as deep as the pushback goes. A seek, or a write to an update stream,
  ;;; moves the file under the counters, and `st_pos_sync' counts again
  ;;; from the start when they disagree with it.
  (static) (var i64 st_nb [256])
  (static) (var i64 st_nc [256])
  (static) (var i64 st_nl [256])
  (static) (var i64 st_lp [256])
  (static) (var i64 st_hp [256][8])
  (static) (var int st_hi [256])
  ;;; AND THE LAST CHARACTER A WRITE PUT IN IT, plus one, 0 none (3.56.0):
  ;;; where write_term/3's partial(true) begins, as swipl's begins at the
  ;;; stream's lastc. user_output and user_error take the console's.
  (static) (var i64 st_lc1 [256])

  ;;; the code that ends TEXT[0..N), -1 for no text, U+DC00 plus a byte
  ;;; that ends no UTF-8 character
  (static)
  (func st_text_lastc ((const char * text) (size_t n)) (out i64)
        (if (== n 0) (return -1))
        (let ((size_t b . #'(- n 1)) (size_t j . 0) (i64 c . 0))
          (while (and (> b 0) (and (< (- n b) 4) (== (bitand (cast int (nth b text)) 192) 128)))
            (set b (- b 1)))
          (set j b)
          (set c (coco_m_utf8_get text n (aof j)))
          (if (== j n) (return c))
          (return (+ 56320 (bitand (cast int (nth (- n 1) text)) 255)))))

  ;;; THE CURRENT INPUT AND OUTPUT. Input is only the module's: get_char/1,
  ;;; read/1 and the rest read slot `st_cur_in'. Output is not only the
  ;;; module's, because write/1, format/2 and nl/0 are the ENGINE's and write
  ;;; to the literal stdout -- so `set_output(S)' points FILE DESCRIPTOR 1 at
  ;;; the stream's file, which is the mechanism with_output_to/2 already uses
  ;;; for the same reason. `st_saved_fd' keeps the real stdout while that
  ;;; lasts, and `st_term' is a FILE on a copy of it, so that user_output
  ;;; named explicitly still reaches the terminal, as ISO says it does.
  (static) (var int st_cur_in . 0)
  (static) (var int st_cur_out . 1)
  (static) (var int st_saved_fd . -1)
  (static) (var FILE * st_term . nil)

  ;;; An encoding's class, as the table above names them, and a stream's
  ;;; encoding set: a binary stream's is octet, which open/4 and
  ;;; set_stream/2 see to.
  (static)
  (func st_enc_class ((int enc)) (out int)
        (if (or (== enc 1) (or (== enc 2) (== enc 3))) (return 1))
        (if (or (== enc 5) (== enc 7)) (return 2))
        (if (or (== enc 6) (== enc 8)) (return 3))
        (if (== enc 9) (return 4))
        (return 0))

  (static)
  (func st_set_enc ((int s) (int enc)) (out void)
        (set (nth s st_enc) enc)
        (set (nth s st_cls) (st_enc_class enc)))

  ;;; The largest code a stream of one byte a character takes: ascii's 127
  ;;; (a text stream's), every other 255.
  (static)
  (func st_lim ((int s)) (out i64)
        (return (? (and (!= (nth s st_kind) 2) (== (nth s st_enc) 2)) 127 255)))

  ;;; How many of the FILE's bytes the UTF-8 byte C handed up stands for: one
  ;;; of a UTF-8 or an octet stream; of a UTF-16 one a character's first byte
  ;;; its two bytes, or four past U+FFFF (a first byte from 240), and the
  ;;; bytes after it none; of a UCS-4 one a character's first byte four.
  (static)
  (func st_rawn ((int s) (int c)) (out i64)
        (let ((int k . #'(nth s st_cls)))
          (if (< k 2) (return 1))
          (if (== (bitand c 192) 128) (return 0))
          (if (== k 4) (return 4))
          (return (? (>= c 240) 4 2))))

  ;;; The same for a byte the decoder handed up: a character's first byte
  ;;; stands for the bytes it took (`st_praw'), which a malformed one makes
  ;;; other than its value says -- swipl's count of what it read. The
  ;;; pushback of a UTF-16 or UCS-4 stream holds the character decoded last
  ;;; and no other: the decoder runs only when the pushback is empty.
  (static)
  (func st_rawd ((int s) (int c)) (out i64)
        (if (and (>= (nth s st_cls) 2) (!= (bitand c 192) 128)) (return (cast i64 (nth s st_praw))))
        (return (st_rawn s c)))

  ;;; Characters, line and column after N more bytes of BUF, by the rules
  ;;; `st_count' keeps: a continuation byte is no character of a text
  ;;; stream, and every byte is one of a binary stream (BIN), swipl's octets.
  (static)
  (func st_pos_walk ((const u8 * buf) (size_t n) (int bin) (i64 * nc) (i64 * nl) (i64 * lp)) (out void)
        (for ((size_t i . 0)) (< i n) ((++ i))
             (let ((int c . #'(cast int (nth i buf))))
               (if (or bin (!= (bitand c 192) 128))
                   (block
                     (set (cof nc) (+ (cof nc) 1))
                     (cond ((== c 10) (set (cof nl) (+ (cof nl) 1)) (set (cof lp) 0))
                           ((== c 13) (set (cof lp) 0))
                           ((== c 9) (set (cof lp) (+ (bitor (cof lp) 7) 1)))
                           ((== c 8) (if (> (cof lp) 0) (set (cof lp) (- (cof lp) 1))))
                           (#t (set (cof lp) (+ (cof lp) 1)))))))))

  ;;; What a write put in a stream: the console's column for user_output
  ;;; and user_error, and for a file, since 3.16.0, its position --
  ;;; characters, line, column and bytes from the open, as swipl counts an
  ;;; output stream's. The column is where format's `~N' and its column
  ;;; stops begin (3.33.0; through 3.32.0 a flag of its own said whether a
  ;;; line was open, the last byte written no newline)
  (static)
  (func st_wrote ((int s) (const char * buf) (size_t n)) (out void)
        (if (== n 0) (return))
        (if (or (== s 1) (== s 2)) (block (coco_m_out_note s buf n) (return)))
        (if (>= s 3)
            (block
              ;; its last character plus one, where partial(true) begins
              ;; (3.56.0): a byte of a stream of one byte a character, and of
              ;; any stream where it is ASCII
              (let ((i64 lc . #'(bitand (cast i64 (nth (- n 1) buf)) 255)))
                (if (and (> lc 127) (!= (nth s st_cls) 1)) (set lc (st_text_lastc buf n)))
                (set (nth s st_lc1) (+ lc 1)))
              (set (nth s st_nb) (+ (nth s st_nb) (cast i64 n)))
              (st_pos_walk (cast (const u8 *) buf) n (== (nth s st_cls) 1)
                           (aof (nth s st_nc)) (aof (nth s st_nl)) (aof (nth s st_lp))))))

  ;;; What a write of a UTF-16 or UCS-4 stream put in it: the UTF-8 TEXT of
  ;;; its N bytes counted as characters, and RAW bytes in the file
  (static)
  (func st_wrote_wide ((int s) (const char * text) (size_t n) (size_t raw)) (out void)
        (if (== n 0) (return))
        (if (or (== s 1) (== s 2)) (block (coco_m_out_note s text n) (return)))
        (if (>= s 3)
            (block
              (set (nth s st_lc1) (+ (st_text_lastc text n) 1))
              (set (nth s st_nb) (+ (nth s st_nb) (cast i64 raw)))
              (st_pos_walk (cast (const u8 *) text) n 0
                           (aof (nth s st_nc)) (aof (nth s st_nl)) (aof (nth s st_lp))))))

  (static)
  (func st_pos_reset ((int s)) (out void)
        (set (nth s st_nb) 0)
        (set (nth s st_nc) 0)
        (set (nth s st_nl) 1)
        (set (nth s st_lp) 0)
        (set (nth s st_hi) 0))

  (static)
  (func st_setup () (out void)
        (if st_ready (return))
        (set (nth 0 st_file) stdin)  (set (nth 0 st_kind) 1) (set (nth 0 st_mode) 1)
        (set (nth 1 st_file) stdout) (set (nth 1 st_kind) 1) (set (nth 1 st_mode) 2)
        (set (nth 2 st_file) stderr) (set (nth 2 st_kind) 1) (set (nth 2 st_mode) 2)
        (st_pos_reset 0) (st_pos_reset 1) (st_pos_reset 2)
        (set st_ready 1))

  ;;; The FILE a write to slot S goes to: the real terminal for user_output
  ;;; while a file is the current output, the slot's own FILE otherwise.
  (static)
  (func st_fp ((int s)) (out FILE *)
        (if (and (== s 1) (and (>= st_saved_fd 0) (!= st_term nil))) (return st_term))
        (return (nth s st_file)))

  ;;; Is S the file descriptor 1 points at just now, besides its own FILE?
  (static)
  (func st_is_redirect ((int s)) (out int)
        (return (? (and (>= st_saved_fd 0) (and (== s st_cur_out) (!= s 1))) 1 0)))

  ;;; TWO BUFFERS, ONE FILE. While S is the current output the engine's
  ;;; stdout and the stream's FILE both write to one open file, each through
  ;;; a buffer of its own; the order a program wrote in is kept by emptying
  ;;; stdout before the stream writes and the stream after, and a stream's
  ;;; idea of its position is set from the file's before it is asked.
  (static)
  (func st_out_begin ((int s)) (out void)
        (if (not (st_is_redirect s)) (return))
        (fflush stdout)
        (if (>= s 3)
            (let ((long k . 0))
              (fflush (nth s st_file))
              (set k (cast long (lseek (fileno (nth s st_file)) 0 SEEK_CUR)))
              (if (>= k 0) (fseek (nth s st_file) k SEEK_SET)))))

  (static)
  (func st_out_end ((int s)) (out void)
        (if (st_is_redirect s) (fflush (nth s st_file))))

  ;;; Back to the terminal: stdout's buffer goes where it was headed, fd 1
  ;;; is the real stdout again, and the copy is closed.
  (static)
  (func st_restore_output () (out void)
        (fflush stdout)
        (if (>= st_cur_out 2) (fflush (nth st_cur_out st_file)))
        (if (>= st_saved_fd 0)
            (block (dup2 st_saved_fd 1) (close st_saved_fd) (set st_saved_fd -1)))
        (if (!= st_term nil) (block (fclose st_term) (set st_term nil)))
        (set st_cur_out 1))

  ;;; ---- argument helpers; a raise is passed straight through (answers 2) ----
  (static)
  (func st_iarg ((coco_engine * e) (size_t g) (int i) (i64 * v)) (out int)
        (if (coco_m_int e (coco_m_arg e g (cast size_t i)) v) (return 1))
        (return (coco_m_type_error e "integer" (coco_m_arg e g (cast size_t i)))))

  ;;; Argument I as an open slot, with the HANDLE the program wrote at
  ;;; I-1 -- every stream predicate takes both, the slot to index the table
  ;;; and the handle to name in an error, since the C half cannot build a
  ;;; '$stream'(N) of its own. The Coco half has already refused a closed
  ;;; stream by name; this is the guard that keeps a bare integer from
  ;;; reaching the table anyway.
  (static)
  (func st_slot ((coco_engine * e) (size_t g) (int i) (int * s)) (out int)
        (let ((i64 v . 0))
          (st_setup)
          (let ((int rc1 . #'(st_iarg e g i (aof v))))
            (if (!= rc1 1) (return rc1)))
          (if (< v 0) (return (coco_m_existence_error e "stream" (coco_m_arg e g (cast size_t (- i 1))))))
          (if (>= v 256) (return (coco_m_existence_error e "stream" (coco_m_arg e g (cast size_t (- i 1))))))
          (if (== (nth v st_kind) 0) (return (coco_m_existence_error e "stream" (coco_m_arg e g (cast size_t (- i 1))))))
          (set (cof s) (cast int v))
          (return 1)))

  ;;; THE BYTE PREDICATES' KIND CHECK (3.16.0): a binary stream, or swipl's
  ;;; permission_error(Action, text_stream, S), asked after the stream's
  ;;; direction (`st_readable', `st_writable'), as swipl asks them. The
  ;;; character, line and term predicates take either kind: a binary
  ;;; stream's characters are its bytes, swipl's octet encoding. Through
  ;;; 3.15.2 they refused one with permission_error(input, binary_stream, S).
  ;;; Since 3.17.0 a text stream in octet or iso_latin_1 takes bytes as well,
  ;;; as swipl's does; ascii, UTF-8, UTF-16 and UCS-4 ones do not.
  (static)
  (func st_need_binary ((coco_engine * e) (size_t g) (int s) (const char * action)) (out int)
        (if (== (nth s st_kind) 2) (return 1))
        (if (or (== (nth s st_enc) 1) (== (nth s st_enc) 3)) (return 1))
        (return (coco_m_permission_error e action "text_stream" (coco_m_arg e g 0))))

  (static)
  (func st_readable ((coco_engine * e) (size_t g) (int i) (int s)) (out int)
        (if (or (== (nth s st_mode) 1) (== (nth s st_mode) 4)) (return 1))
        (return (coco_m_permission_error e "input" "stream" (coco_m_arg e g (cast size_t i)))))

  (static)
  (func st_writable ((coco_engine * e) (size_t g) (int i) (int s)) (out int)
        (if (>= (nth s st_mode) 2) (return 1))
        (return (coco_m_permission_error e "output" "stream" (coco_m_arg e g (cast size_t i)))))

  ;;; ---- bytes in, through the pushback, counted ----
  ;;; One byte past the position, and back. A continuation byte (10xxxxxx)
  ;;; is the same character and the same column -- of a text stream; a
  ;;; binary stream's every byte is a character (3.16.0, swipl's octets).
  (static)
  (func st_count ((int s) (int c)) (out void)
        (set (nth s st_nb) (+ (nth s st_nb) (st_rawd s c)))
        (set (nth (nth s st_hi) (nth s st_hp)) (nth s st_lp))
        (set (nth s st_hi) (bitand (+ (nth s st_hi) 1) 7))
        (if (and (== (bitand c 192) 128) (!= (nth s st_cls) 1)) (return))
        (set (nth s st_nc) (+ (nth s st_nc) 1))
        (cond ((== c 10) (set (nth s st_nl) (+ (nth s st_nl) 1)) (set (nth s st_lp) 0))
              ((== c 13) (set (nth s st_lp) 0))
              ((== c 9) (set (nth s st_lp) (+ (bitor (nth s st_lp) 7) 1)))
              ((== c 8) (if (> (nth s st_lp) 0) (set (nth s st_lp) (- (nth s st_lp) 1))))
              (#t (set (nth s st_lp) (+ (nth s st_lp) 1)))))

  (static)
  (func st_uncount ((int s) (int c)) (out void)
        (set (nth s st_nb) (- (nth s st_nb) (st_rawd s c)))
        (set (nth s st_hi) (bitand (+ (nth s st_hi) 7) 7))
        (set (nth s st_lp) (nth (nth s st_hi) (nth s st_hp)))
        (if (and (== (bitand c 192) 128) (!= (nth s st_cls) 1)) (return))
        (set (nth s st_nc) (- (nth s st_nc) 1))
        (if (== c 10) (set (nth s st_nl) (- (nth s st_nl) 1))))

  ;;; ONE CHARACTER OF A UTF-16 OR UCS-4 FILE, DECODED (3.19.0), its UTF-8
  ;;; bytes into OUT: how many, 0 at the end. A surrogate pair is one code
  ;;; point; a high surrogate followed by a unit that is no low one is
  ;;; U+FFFD, the two units taken, and so is a character the end of the
  ;;; file cut short, as swipl's are -- whose warnings (`Illegal UTF-16
  ;;; continuation', `EOF in unicode character') are not said here; a low
  ;;; surrogate alone stands as itself, and a UCS-4 one past U+10FFFF is
  ;;; U+FFFD, where swipl hands the number on. The bytes it took are
  ;;; `st_praw'.
  (static)
  (func st_unit ((int s) (int * u)) (out int)
        (let ((FILE * f . #'(nth s st_file)) (int a . 0) (int b . 0))
          (set a (fgetc f))
          (if (< a 0) (return 0))
          (set b (fgetc f))
          (if (< b 0) (return 1))
          (set (cof u) (? (== (nth s st_cls) 2) (bitor (<< a 8) b) (bitor (<< b 8) a)))
          (return 2)))

  (static)
  (func st_decode1 ((int s) (u8 * out)) (out int)
        (let ((i64 cp . 0) (FILE * f . #'(nth s st_file)))
          (if (== (nth s st_cls) 4)
              (let ((int got . 0) (int c . 0))
                (for ((int i . 0)) (< i 4) ((++ i))
                     (set c (fgetc f))
                     (if (< c 0) break)
                     (set cp (bitor cp (<< (cast i64 c) (* 8 i))))
                     (set got (+ got 1)))
                (if (== got 0) (return 0))
                (set (nth s st_praw) got)
                (if (or (< got 4) (> cp 1114111)) (set cp 65533)))
              (let ((int u . 0) (int k . #'(st_unit s (aof u))))
                (if (== k 0) (return 0))
                (set (nth s st_praw) k)
                (if (== k 1)
                    (set cp 65533)
                    (if (and (>= u 55296) (< u 56320))
                        (let ((int v . 0) (int k2 . #'(st_unit s (aof v))))
                          (set (nth s st_praw) (+ k k2))
                          (if (and (== k2 2) (and (>= v 56320) (< v 57344)))
                              (set cp (+ 65536 (+ (<< (cast i64 (- u 55296)) 10) (cast i64 (- v 56320)))))
                              (set cp 65533)))
                        (set cp (cast i64 u))))))
          (return (coco_m_utf8_enc (cast (char *) out) cp))))

  ;;; The FILE's bytes the pushback stands for: what the stream read and
  ;;; has not handed up
  (static)
  (func st_push_raw ((int s)) (out i64)
        (let ((i64 r . 0))
          (for ((int i . 0)) (< i (nth s st_npush)) ((++ i))
               (set r (+ r (st_rawd s (cast int (nth i (nth s st_push)))))))
          (return r)))

  (static)
  (func st_getc ((int s)) (out int)
        (let ((int c . 0))
          ;; a UTF-16 or UCS-4 stream hands up its next character's UTF-8
          ;; bytes through the pushback, uncounted until they are taken
          (if (and (== (nth s st_npush) 0) (>= (nth s st_cls) 2))
              (let ((u8 ch [8]) (int k . #'(st_decode1 s ch)))
                (for ((int j . #'(- k 1))) (>= j 0) ((-- j))
                     (set (nth (nth s st_npush) (nth s st_push)) (nth j ch))
                     (set (nth s st_npush) (+ (nth s st_npush) 1)))))
          (if (> (nth s st_npush) 0)
              (block
                (set (nth s st_npush) (- (nth s st_npush) 1))
                (set c (cast int (nth (nth s st_npush) (nth s st_push)))))
            (set c (fgetc (nth s st_file))))
          (if (>= c 0) (st_count s c))
          (return c)))

  (static)
  (func st_ungetc ((int s) (int c)) (out void)
        (if (< c 0) (return))
        (if (>= (nth s st_npush) 8) (return))
        (st_uncount s c)
        (set (nth (nth s st_npush) (nth s st_push)) (cast u8 c))
        (set (nth s st_npush) (+ (nth s st_npush) 1)))

  ;;; The counters agree with the file, or are counted again from its start
  ;;; up to where the stream stands -- which a seek or a write moved. A
  ;;; stream with no position (a pipe, a terminal) has only the counters.
  (static)
  (func st_pos_sync ((int s)) (out void)
        (let ((long here . #'(ftell (nth s st_file))) (i64 at . 0) (int pr . #'(nth s st_praw)))
          (if (< here 0) (return))
          (set at (- (cast i64 here) (st_push_raw s)))
          (if (== at (nth s st_nb)) (return))
          (st_pos_reset s)
          ;; counted again after the BOM the open read, which is no character
          (if (!= (fseek (nth s st_file) (cast long (nth s st_bomlen)) SEEK_SET) 0) (return))
          (set (nth s st_nb) (cast i64 (nth s st_bomlen)))
          (while (< (nth s st_nb) at)
            (if (>= (nth s st_cls) 2)
                (let ((u8 ch [8]) (int k . #'(st_decode1 s ch)))
                  (if (== k 0) break)
                  (for ((int j . 0)) (< j k) ((++ j)) (st_count s (cast int (nth j ch)))))
                (let ((int c . #'(fgetc (nth s st_file))))
                  (if (< c 0) break)
                  (st_count s c))))
          (set (nth s st_praw) pr)
          (fseek (nth s st_file) here SEEK_SET)))

  ;;; How many bytes a UTF-8 character has, from its first byte.
  (static)
  (func st_utf8_len ((int c)) (out int)
        (if (< c 128) (return 1))
        (if (< c 192) (return 1))     ; a stray continuation byte stands alone
        (if (< c 224) (return 2))
        (if (< c 240) (return 3))
        (return 4))

  ;;; A code list of N bytes, built from the end.
  (static)
  (func st_codes ((coco_engine * e) (const u8 * buf) (size_t n)) (out size_t)
        (let ((size_t acc . #'(coco_m_nil e)))
          (while (> n 0)
            (set n (- n 1))
            (set acc (coco_m_cons e (coco_m_new_int e (cast i64 (nth n buf))) acc)))
          (return acc)))

  ;;; A TEXT stream's codes are the program's (1.13.0): a code point a
  ;;; character under `text_units = characters', a byte otherwise; a binary
  ;;; stream's are its bytes whatever the program counts.
  (static)
  (func st_text_codes ((coco_engine * e) (int s) (const u8 * buf) (size_t n)) (out size_t)
        (if (== (nth s st_cls) 1) (return (st_codes e buf n)))
        (return (coco_m_codes_of e (cast (const char *) buf) n 0 (coco_m_nil e))))

  ;;; A growing byte buffer, for a line, a clause, the rest of a file.
  (static)
  (func st_grow ((u8 ** buf) (size_t * cap) (size_t need)) (out int)
        (if (< need (cof cap)) (return 1))
        (let ((size_t ncap . #'(* (cof cap) 2)))
          (if (< ncap 256) (set ncap 256))
          (while (<= ncap need) (set ncap (* ncap 2)))
          (let ((u8 * nb . #'(cast (u8 *) (realloc (cof buf) ncap))))
            (if (== nb nil) (return 0))
            (set (cof buf) nb)
            (set (cof cap) ncap)
            (return 1))))

  ;;; ---- the one writer: UTF-8 text into a stream, in its encoding ----
  ;;;
  ;;; A write the file refused: swipl's io_error(write, S) with strerror's
  ;;; words (3.16.0; a cocolog_error through 3.15.2)
  (static)
  (func st_io_write ((coco_engine * e) (size_t culprit)) (out int)
        (return (coco_m_error_msg e "io_error" "write" nil culprit (strerror errno))))

  ;;; A character the stream's encoding has no bytes for: swipl's
  ;;; io_error(write, S), 'Encoding cannot represent character', after the
  ;;; characters before it were written
  (static)
  (func st_unrepresentable ((coco_engine * e) (size_t culprit)) (out int)
        (return (coco_m_error_msg e "io_error" "write" nil culprit
                                  "Encoding cannot represent character")))

  ;;; TEXT INTO A STREAM OF ONE BYTE A CHARACTER IS ITS CHARACTERS AS BYTES
  ;;; (3.16.0, swipl's octets; 3.17.0 octet, ascii and iso_latin_1 text
  ;;; streams too): the ones up to a character past the encoding's largest
  ;;; (`st_lim') are written, and that one is `st_unrepresentable'.
  (static)
  (func st_put_octets ((coco_engine * e) (size_t culprit) (int s) (const char * text) (size_t len)) (out int)
        (let ((u8 * buf . #'(cast (u8 *) (malloc (+ len 1)))) (size_t n . 0) (size_t i . 0) (int bad . 0)
              (i64 lim . #'(st_lim s)))
          (if (== buf nil) (return (coco_m_resource_error e "memory")))
          (while (< i len)
            (let ((i64 cp . #'(coco_m_utf8_get text len (aof i))))
              (if (or (< cp 0) (> cp lim)) (block (set bad 1) break))
              (set (nth n buf) (cast u8 cp))
              (set n (+ n 1))))
          (st_out_begin s)
          (let ((size_t w . #'(fwrite buf 1 n (st_fp s))))
            (st_out_end s)
            (st_wrote s (cast (const char *) buf) w)
            (free buf)
            (if (!= w n) (return (st_io_write e culprit))))
          (if bad (return (st_unrepresentable e culprit)))
          (return 1)))

  ;;; TEXT INTO A UTF-16 OR UCS-4 STREAM (3.19.0): each character encoded
  ;;; again, a code point past U+FFFF a surrogate pair in UTF-16; a lone
  ;;; surrogate has no UTF-16 and is `st_unrepresentable', after what came
  ;;; before it, as swipl's is. UCS-4 is little-endian, wchar_t's on Linux
  ;;; and the Mac.
  (static)
  (func st_put_wide ((coco_engine * e) (size_t culprit) (int s) (const char * text) (size_t len)) (out int)
        (let ((u8 * buf . #'(cast (u8 *) (malloc (+ (* len 4) 4)))) (size_t n . 0) (size_t i . 0)
              (size_t done . 0) (int bad . 0) (int k . #'(nth s st_cls)))
          (if (== buf nil) (return (coco_m_resource_error e "memory")))
          (while (< i len)
            (let ((i64 cp . #'(coco_m_utf8_get text len (aof i))))
              (cond
                ((== k 4)
                 (for ((int j . 0)) (< j 4) ((++ j))
                      (set (nth (+ n (cast size_t j)) buf) (cast u8 (bitand (>> cp (* 8 j)) 255))))
                 (set n (+ n 4)))
                ((and (>= cp 55296) (< cp 57344)) (set bad 1))
                ((< cp 65536)
                 (if (== k 2)
                     (block (set (nth n buf) (cast u8 (>> cp 8))) (set (nth (+ n 1) buf) (cast u8 (bitand cp 255))))
                     (block (set (nth n buf) (cast u8 (bitand cp 255))) (set (nth (+ n 1) buf) (cast u8 (>> cp 8)))))
                 (set n (+ n 2)))
                (#t
                 (let ((i64 v . #'(- cp 65536)) (i64 hi . 0) (i64 lo . 0))
                   (set hi (+ 55296 (>> v 10)))
                   (set lo (+ 56320 (bitand v 1023)))
                   (if (== k 2)
                       (block (set (nth n buf) (cast u8 (>> hi 8))) (set (nth (+ n 1) buf) (cast u8 (bitand hi 255)))
                              (set (nth (+ n 2) buf) (cast u8 (>> lo 8))) (set (nth (+ n 3) buf) (cast u8 (bitand lo 255))))
                       (block (set (nth n buf) (cast u8 (bitand hi 255))) (set (nth (+ n 1) buf) (cast u8 (>> hi 8)))
                              (set (nth (+ n 2) buf) (cast u8 (bitand lo 255))) (set (nth (+ n 3) buf) (cast u8 (>> lo 8)))))
                   (set n (+ n 4)))))
              (if bad break)
              (set done i)))
          (st_out_begin s)
          (let ((size_t w . #'(fwrite buf 1 n (st_fp s))))
            (st_out_end s)
            (st_wrote_wide s text done w)
            (free buf)
            (if (!= w n) (return (st_io_write e culprit))))
          (if bad (return (st_unrepresentable e culprit)))
          (return 1)))

  ;;; THE ONE WRITER (3.19.0): what every put, write, format and sink hands a
  ;;; stream is UTF-8 TEXT, written in the stream's encoding -- as it is to a
  ;;; UTF-8 stream, as bytes to one of one byte a character, encoded again to
  ;;; a UTF-16 or UCS-4 one. Answers 1, or the raise's answer.
  (static)
  (func st_emit ((coco_engine * e) (size_t culprit) (int s) (const char * text) (size_t len)) (out int)
        (let ((int k . #'(nth s st_cls)))
          (if (== k 1) (return (st_put_octets e culprit s text len)))
          (if (>= k 2) (return (st_put_wide e culprit s text len)))
          (st_out_begin s)
          (let ((size_t w . #'(fwrite text 1 len (st_fp s))))
            (st_out_end s)
            (st_wrote s text w)
            (if (!= w len) (return (st_io_write e culprit))))
          (return 1)))

  ;;; ---- a BOM ----
  ;;;
  ;;; The encodings swipl looks for a BOM in and writes one for: utf8, and
  ;;; UTF-16 either way round under either of its names.
  (static)
  (func st_bom_enc ((int enc)) (out int)
        (return (? (or (== enc 0) (and (>= enc 5) (<= enc 8))) 1 0)))

  ;;; A BOM at the start of the file is taken off, and sets the encoding --
  ;;; UTF-8's, UTF-16 big-endian's or little-endian's; the bytes it took are
  ;;; counted, as swipl counts them, and no character. Anything else is put
  ;;; back where it was.
  (static)
  (func st_bom_read ((int s)) (out void)
        (let ((FILE * f . #'(nth s st_file)) (u8 h [4]) (size_t got . 0) (int len . 0) (int enc . -1))
          (set got (fread h 1 3 f))
          (cond ((and (>= got 3) (and (== (nth 0 h) 239) (and (== (nth 1 h) 187) (== (nth 2 h) 191))))
                 (set len 3) (set enc 0))
                ((and (>= got 2) (and (== (nth 0 h) 254) (== (nth 1 h) 255)))
                 (set len 2) (set enc 7))
                ((and (>= got 2) (and (== (nth 0 h) 255) (== (nth 1 h) 254)))
                 (set len 2) (set enc 8)))
          (fseek f (cast long len) SEEK_SET)
          (if (< enc 0) (return))
          (st_set_enc s enc)
          (set (nth s st_bom) 1)
          (set (nth s st_bomlen) len)
          (set (nth s st_nb) (cast i64 len))))

  ;;; ---- open, close, the table ----
  ;;;
  ;;; No such file is existence_error(source_sink, Path), ISO's shape and
  ;;; the common mistake; a file that may not be opened is a
  ;;; permission_error naming the path; anything else carries strerror's
  ;;; words. Every file is opened with `b', which is a no-op on POSIX and
  ;;; keeps Windows honest: the text/binary distinction is the module's.
  ;;; '$stream_open'(Path, Mode, Kind, Enc, Bom, N, PI) (3.19.0): ENC the
  ;;; encoding's number, BOM -1 not asked, 0 false, 1 true. A read of a
  ;;; text stream in utf8, unicode_* or utf16* looks for a BOM unless
  ;;; bom(false) said not to, and one found -- UTF-8's, UTF-16's either way
  ;;; round -- is taken off and sets the encoding, swipl's ScheckBOM; a
  ;;; write with bom(true) in one of those writes U+FEFF first, which
  ;;; swipl counts as a character written.
  (func st_p_open ((coco_engine * e) (size_t g)) (out int)
        (let ((char path [4096]) (i64 mode . 0) (i64 kind . 0) (int s . -1)
              (i64 enc . 0) (i64 bom . -1)
              (const char * how . "rb") (FILE * f . nil))
          (st_setup)
          (if (not (coco_m_text e (coco_m_arg e g 0) path (sizeof path)))
              (return (coco_m_type_error e "text" (coco_m_arg e g 0))))
          (let ((int rc2 . #'(st_iarg e g 1 (aof mode)))) (if (!= rc2 1) (return rc2)))
          (let ((int rc3 . #'(st_iarg e g 2 (aof kind)))) (if (!= rc3 1) (return rc3)))
          (let ((int rc3e . #'(st_iarg e g 3 (aof enc)))) (if (!= rc3e 1) (return rc3e)))
          (let ((int rc3b . #'(st_iarg e g 4 (aof bom)))) (if (!= rc3b 1) (return rc3b)))
          (if (== mode 2) (set how "wb"))
          (if (== mode 3) (set how "ab"))
          (if (== mode 4) (set how "r+b"))
          (for ((int i . 3)) (< i 256) ((++ i))
               (if (== (nth i st_kind) 0) (block (set s i) break)))
          (if (< s 0) (return (coco_m_resource_error e "max_files")))
          (set f (fopen path how))
          ;; swipl's file errors (pl-error.c's ERR_FILE_OPERATION, 3.16.0):
          ;; no access, a busy text or a read-only file system may not be
          ;; opened, too many open files is a resource, and anything else --
          ;; a directory too -- does not exist, each with strerror's words as
          ;; the context's message. Through 3.15.2 a directory was
          ;; permission_error and other failures cocolog_error.
          (if (== f nil)
              (let ((int en . errno))
                (if (or (== en EACCES) (or (== en ETXTBSY) (== en EROFS)))
                    (return (coco_m_error_msg e "permission_error" "open" "source_sink"
                                              (coco_m_arg e g 0) (strerror en))))
                (if (or (== en EMFILE) (== en ENFILE))
                    (return (coco_m_error_msg e "resource_error" "max_files" nil
                                              (cast size_t -1) (strerror en))))
                (return (coco_m_error_msg e "existence_error" "source_sink" nil
                                          (coco_m_arg e g 0) (strerror en)))))
          (set (nth s st_file) f)
          (set (nth s st_kind) (cast int kind))
          (set (nth s st_mode) (cast int mode))
          (set (nth s st_path) (strdup path))
          (set (nth s st_npush) 0)
          (set (nth s st_bom) 0)
          (set (nth s st_bomlen) 0)
          (set (nth s st_lc1) 0)
          (st_set_enc s (cast int enc))
          (st_pos_reset s)
          (if (and (== kind 1) (and (!= bom 0) (st_bom_enc (cast int enc))))
              (block
                (if (== mode 1) (st_bom_read s))
                (if (and (== mode 2) (== bom 1))
                    (let ((char m [8]) (int k . #'(coco_m_utf8_enc m 65279)))
                      (set (nth s st_bom) 1)
                      (let ((int rcb . #'(st_emit e (coco_m_arg e g 0) s m (cast size_t k))))
                        (if (!= rcb 1) (return rcb)))))))
          (return (coco_m_unify_int e (coco_m_arg e g 5) (cast i64 s)))))

  (func st_p_close ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc4 . #'(st_slot e g 1 (aof s)))) (if (!= rc4 1) (return rc4)))
          (if (< s 3) (return 1))
          ;; ISO: closing the current output or input makes the standard one current
          (if (== s st_cur_out) (st_restore_output))
          (if (== s st_cur_in) (set st_cur_in 0))
          (if (!= (nth s st_alias) nil) (block (free (nth s st_alias)) (set (nth s st_alias) nil)))
          (fclose (nth s st_file))
          (set (nth s st_file) nil)
          (set (nth s st_kind) 0)
          (set (nth s st_mode) 0)
          (set (nth s st_npush) 0)
          (if (!= (nth s st_path) nil) (block (free (nth s st_path)) (set (nth s st_path) nil)))
          (return 1)))

  ;;; Is this slot open? Answers by failing, which is what the Coco half
  ;;; turns into the existence_error that names the handle.
  (func st_p_open_p ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 v . 0))
          (st_setup)
          (let ((int rc5 . #'(st_iarg e g 0 (aof v)))) (if (!= rc5 1) (return rc5)))
          (if (< v 0) (return 0))
          (if (>= v 256) (return 0))
          (return (? (== (nth v st_kind) 0) 0 1))))

  (func st_p_slots ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t acc . #'(coco_m_nil e)))
          (st_setup)
          (for ((int i . 255)) (>= i 0) ((-- i))
               (if (!= (nth i st_kind) 0)
                   (set acc (coco_m_cons e (coco_m_new_int e (cast i64 i)) acc))))
          (return (coco_m_unify e (coco_m_arg e g 0) acc))))

  (func st_p_info ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc6 . #'(st_slot e g 1 (aof s)))) (if (!= rc6 1) (return rc6)))
          (if (not (coco_m_unify_atom e (coco_m_arg e g 2) (? (== (nth s st_path) nil) "" (nth s st_path))))
              (return 0))
          (if (not (coco_m_unify_int e (coco_m_arg e g 3) (cast i64 (nth s st_mode)))) (return 0))
          (return (coco_m_unify_int e (coco_m_arg e g 4) (cast i64 (nth s st_kind))))))

  ;;; an input stream has nothing to flush: swipl's permission_error(output,
  ;;; stream, S), as a read of an output stream is (3.16.0)
  (func st_p_flush ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc7 . #'(st_slot e g 1 (aof s)))) (if (!= rc7 1) (return rc7)))
          (let ((int rc7b . #'(st_writable e g 0 s))) (if (!= rc7b 1) (return rc7b)))
          (if (st_is_redirect s) (fflush stdout))
          (fflush (st_fp s))
          (return 1)))

  ;;; At the end when nothing is pushed back and the next byte is EOF --
  ;;; read and given back, so asking costs the stream nothing.
  (func st_p_eof ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (int c . 0))
          (let ((int rc8 . #'(st_slot e g 1 (aof s)))) (if (!= rc8 1) (return rc8)))
          (let ((int rc8b . #'(st_readable e g 0 s))) (if (!= rc8b 1) (return rc8b)))
          (if (> (nth s st_npush) 0) (return 0))
          (set c (fgetc (nth s st_file)))
          (if (< c 0) (return 1))
          (ungetc c (nth s st_file))
          (return 0)))

  ;;; The position is ftell's, minus what a peek gave back.
  (func st_p_position ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (long p . 0))
          (let ((int rc9 . #'(st_slot e g 1 (aof s)))) (if (!= rc9 1) (return rc9)))
          (st_out_begin s)
          (set p (ftell (nth s st_file)))
          (if (< p 0) (return (coco_m_permission_error e "reposition" "stream" (coco_m_arg e g 0))))
          (return (coco_m_unify_int e (coco_m_arg e g 2) (- (cast i64 p) (st_push_raw s))))))

  ;;; A seek forgets the pushback: what was peeked is behind the new
  ;;; position or ahead of it, and either way the file knows better.
  (func st_p_seek ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (i64 off . 0) (i64 whence . 0) (int w . SEEK_SET))
          (let ((int rc10 . #'(st_slot e g 1 (aof s)))) (if (!= rc10 1) (return rc10)))
          (let ((int rc11 . #'(st_iarg e g 2 (aof off)))) (if (!= rc11 1) (return rc11)))
          (let ((int rc12 . #'(st_iarg e g 3 (aof whence)))) (if (!= rc12 1) (return rc12)))
          (st_out_begin s)
          (if (== whence 1) (set w SEEK_CUR))
          (if (== whence 2) (set w SEEK_END))
          (if (== whence 1) (set off (- off (st_push_raw s))))
          (set (nth s st_npush) 0)
          (if (!= (fseek (nth s st_file) (cast long off) w) 0)
              (return (coco_m_permission_error e "reposition" "stream" (coco_m_arg e g 0))))
          (return 1)))

  (func st_p_size ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (long here . 0) (long end . 0))
          (let ((int rc13 . #'(st_slot e g 1 (aof s)))) (if (!= rc13 1) (return rc13)))
          (st_out_begin s)
          (set here (ftell (nth s st_file)))
          (if (< here 0) (return (coco_m_permission_error e "reposition" "stream" (coco_m_arg e g 0))))
          (fseek (nth s st_file) 0 SEEK_END)
          (set end (ftell (nth s st_file)))
          (fseek (nth s st_file) here SEEK_SET)
          (return (coco_m_unify_int e (coco_m_arg e g 2) (cast i64 end)))))

  ;;; SWIPL'S POSITION (3.16.0): '$stream_set_pos'(S, N, Char, Line,
  ;;; LinePos, Byte, PI) seeks to Byte and takes the counters as they are
  ;;; given, so a position the property answered is where the stream
  ;;; stands again, counted as it was; '$stream_where'/6 answers them, a
  ;;; stream that reads first counted again if a seek moved it. Through
  ;;; 3.15.2 a position was the byte offset alone.
  (func st_p_set_pos ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (i64 c . 0) (i64 l . 0) (i64 lp . 0) (i64 b . 0))
          (let ((int rc . #'(st_slot e g 1 (aof s)))) (if (!= rc 1) (return rc)))
          (let ((int rc2 . #'(st_iarg e g 2 (aof c)))) (if (!= rc2 1) (return rc2)))
          (let ((int rc3 . #'(st_iarg e g 3 (aof l)))) (if (!= rc3 1) (return rc3)))
          (let ((int rc4 . #'(st_iarg e g 4 (aof lp)))) (if (!= rc4 1) (return rc4)))
          (let ((int rc5 . #'(st_iarg e g 5 (aof b)))) (if (!= rc5 1) (return rc5)))
          (st_out_begin s)
          (set (nth s st_npush) 0)
          (if (!= (fseek (nth s st_file) (cast long b) SEEK_SET) 0)
              (return (coco_m_permission_error e "reposition" "stream" (coco_m_arg e g 0))))
          (set (nth s st_nb) b)
          (set (nth s st_nc) c)
          (set (nth s st_nl) l)
          (set (nth s st_lp) lp)
          (set (nth s st_hi) 0)
          (return 1)))

  (func st_p_where ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc . #'(st_slot e g 1 (aof s)))) (if (!= rc 1) (return rc)))
          ;; the three standard streams share the console's position, as
          ;; swipl's three share one, which the engine keeps over every
          ;; write to user_output and user_error (3.19.0); what this module
          ;; reads from user_input is not counted there
          (if (or (== s 0) (or (== s 1) (== s 2)))
              (let ((i64 nc . 0) (i64 nl . 0) (i64 lp . 0) (i64 nb . 0))
                (coco_m_out_where (aof nc) (aof nl) (aof lp) (aof nb))
                (if (not (coco_m_unify_int e (coco_m_arg e g 2) nc)) (return 0))
                (if (not (coco_m_unify_int e (coco_m_arg e g 3) nl)) (return 0))
                (if (not (coco_m_unify_int e (coco_m_arg e g 4) lp)) (return 0))
                (return (coco_m_unify_int e (coco_m_arg e g 5) nb))))
          (if (or (== (nth s st_mode) 1) (== (nth s st_mode) 4))
              (block (st_out_begin s) (st_pos_sync s)))
          (if (not (coco_m_unify_int e (coco_m_arg e g 2) (nth s st_nc))) (return 0))
          (if (not (coco_m_unify_int e (coco_m_arg e g 3) (nth s st_nl))) (return 0))
          (if (not (coco_m_unify_int e (coco_m_arg e g 4) (nth s st_lp))) (return 0))
          (return (coco_m_unify_int e (coco_m_arg e g 5) (nth s st_nb)))))

  ;;; '$stream_enc'(S, N, Enc, Bom) (3.19.0): the encoding's number, and 1
  ;;; when a BOM was read or written at the open
  (func st_p_enc ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc . #'(st_slot e g 1 (aof s)))) (if (!= rc 1) (return rc)))
          (if (not (coco_m_unify_int e (coco_m_arg e g 2)
                                     (cast i64 (nth s st_enc)))) (return 0))
          (return (coco_m_unify_int e (coco_m_arg e g 3) (cast i64 (nth s st_bom))))))

  ;;; '$stream_set'(S, N, What, V, PI) (3.19.0), set_stream/2's C half:
  ;;; WHAT 0 the encoding to V's number, 1 the type to kind V -- binary
  ;;; makes it octet, text UTF-8, as swipl's does -- 2 the column to V.
  (func st_p_set ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (i64 what . 0) (i64 v . 0))
          (let ((int rc . #'(st_slot e g 1 (aof s)))) (if (!= rc 1) (return rc)))
          (let ((int rc2 . #'(st_iarg e g 2 (aof what)))) (if (!= rc2 1) (return rc2)))
          (let ((int rc3 . #'(st_iarg e g 3 (aof v)))) (if (!= rc3 1) (return rc3)))
          (cond ((== what 0)
                 (if (== (nth s st_kind) 2) (set (nth s st_kind) 1))
                 (st_set_enc s (cast int v)))
                ((== what 1)
                 (set (nth s st_kind) (cast int v))
                 (st_set_enc s (? (== v 2) 1 0)))
                ;; a standard stream's column is the console's, which the
                ;; three share, as swipl's do
                ((< s 3) (coco_m_out_set_column v))
                (#t (set (nth s st_lp) v)))
          (return 1)))

  ;;; '$stream_out'(S, N, PI): a stream the formatted writers may write, or
  ;;; swipl's permission_error(output, stream, S) named by PI (3.16.0)
  (func st_p_out ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc . #'(st_slot e g 1 (aof s)))) (if (!= rc 1) (return rc)))
          (return (st_writable e g 0 s))))

  ;;; A CHARACTER ARGUMENT, AS SWIPL'S PL_get_char_ex READS ONE (3.16.0): a
  ;;; code 0..0x10FFFF, an atom of one character, a string of one, a list of
  ;;; one code or one character -- and with EOF, -1 and end_of_file, both
  ;;; answered -1. An unbound one is instantiation_error, a code past
  ;;; 0x10FFFF domain_error(character, C), anything else type_error(character,
  ;;; T), the whole term. Answers 1 with the code in OUT, or the raise's
  ;;; answer. The put predicates ask it of what they write, before the
  ;;; stream; a get asks it only when its read did not unify, and a peek
  ;;; compares the code it gives, as swipl's do.
  (static)
  (func st_one_char ((const char * s) (size_t n) (i64 * out)) (out int)
        (let ((size_t i . 0) (i64 cp . 0))
          (if (== n 0) (return 0))
          (set cp (coco_m_utf8_get s n (aof i)))
          (if (!= i n) (return 0))
          (set (cof out) cp)
          (return 1)))

  (static)
  (func st_char_code ((coco_engine * e) (size_t t) (int eof) (i64 * out)) (out int)
        (let ((i64 v . 0) (const char * a . nil) (char buf [16]))
          (if (coco_m_is_var e t) (return (coco_m_instantiation_error e)))
          (if (coco_m_int e t (aof v))
              (block
                (if (and eof (== v -1)) (block (set (cof out) -1) (return 1)))
                (if (and (>= v 0) (<= v 1114111)) (block (set (cof out) v) (return 1)))
                (if (> v 1114111) (return (coco_m_domain_error e "character" t)))
                (return (coco_m_type_error e "character" t))))
          (set a (coco_m_atom e t))
          (if (!= a nil)
              (block
                (if (and eof (== 0 (strcmp a "end_of_file"))) (block (set (cof out) -1) (return 1)))
                (if (st_one_char a (strlen a) out) (return 1))
                (return (coco_m_type_error e "character" t))))
          ;; what is left with text -- a string, [Code] or [Char] -- is one character
          (if (and (coco_m_text e t buf (sizeof buf)) (st_one_char buf (strlen buf) out)) (return 1))
          (return (coco_m_type_error e "character" t))))

  ;;; A get's argument that the read did not unify: a character it might
  ;;; have been fails, anything else raises (swipl's order: read, then ask)
  (static)
  (func st_char_fail ((coco_engine * e) (size_t t)) (out int)
        (let ((i64 v . 0) (int rc . #'(st_char_code e t 1 (aof v))))
          (return (? (== rc 1) 0 rc))))

  ;;; '$stream_char'(X, Code, PI): the code of the character to put
  (func st_p_char ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 c . 0))
          (let ((int rc . #'(st_char_code e (coco_m_arg e g 0) 0 (aof c)))) (if (!= rc 1) (return rc)))
          (return (coco_m_unify_int e (coco_m_arg e g 1) c))))

  ;;; ---- bytes ----
  (func st_p_get_byte ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (int c . 0))
          (let ((int rc14 . #'(st_slot e g 1 (aof s)))) (if (!= rc14 1) (return rc14)))
          (let ((int rc16 . #'(st_readable e g 0 s))) (if (!= rc16 1) (return rc16)))
          (let ((int rc15 . #'(st_need_binary e g s "input"))) (if (!= rc15 1) (return rc15)))
          (set c (st_getc s))
          (if (coco_m_unify_int e (coco_m_arg e g 2) (? (< c 0) -1 (cast i64 c))) (return 1))
          (return (st_char_fail e (coco_m_arg e g 2)))))

  ;;; a peek with its argument given compares codes, swipl's: a byte 97 is
  ;;; `a' too, and a term that is no character raises
  (func st_p_peek_byte ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (int c . 0) (size_t t . #'(coco_m_arg e g 2)) (i64 want . 0))
          (let ((int rc17 . #'(st_slot e g 1 (aof s)))) (if (!= rc17 1) (return rc17)))
          (let ((int rc19 . #'(st_readable e g 0 s))) (if (!= rc19 1) (return rc19)))
          (let ((int rc18 . #'(st_need_binary e g s "input"))) (if (!= rc18 1) (return rc18)))
          (if (not (coco_m_is_var e t))
              (let ((int rc . #'(st_char_code e t 1 (aof want)))) (if (!= rc 1) (return rc))))
          (set c (st_getc s))
          (st_ungetc s c)
          (if (coco_m_is_var e t) (return (coco_m_unify_int e t (? (< c 0) -1 (cast i64 c)))))
          (return (? (== want (? (< c 0) -1 (cast i64 c))) 1 0))))

  ;;; the byte itself is checked by the Coco half, before the stream
  (func st_p_put_byte ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (i64 b . 0))
          (let ((int rc20 . #'(st_slot e g 1 (aof s)))) (if (!= rc20 1) (return rc20)))
          (let ((int rc22 . #'(st_writable e g 0 s))) (if (!= rc22 1) (return rc22)))
          (let ((int rc21 . #'(st_need_binary e g s "output"))) (if (!= rc21 1) (return rc21)))
          (let ((int rc23 . #'(st_iarg e g 2 (aof b)))) (if (!= rc23 1) (return rc23)))
          (st_out_begin s)
          (let ((int w . #'(fputc (cast int b) (st_fp s))) (char one . #'(cast char b)))
            (st_out_end s)
            (if (< w 0) (return (st_io_write e (coco_m_arg e g 0))))
            (st_wrote s (aof one) 1))
          (return 1)))

  ;;; Up to N bytes, fewer at the end, [] when there is nothing: the shape
  ;;; a reading loop wants, since a short read at the end is not an error.
  (func st_p_read_bytes ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (i64 n . 0) (u8 * buf . nil) (size_t got . 0))
          (let ((int rc24 . #'(st_slot e g 1 (aof s)))) (if (!= rc24 1) (return rc24)))
          (let ((int rc26 . #'(st_readable e g 0 s))) (if (!= rc26 1) (return rc26)))
          (let ((int rc25 . #'(st_need_binary e g s "input"))) (if (!= rc25 1) (return rc25)))
          (let ((int rc27 . #'(st_iarg e g 2 (aof n)))) (if (!= rc27 1) (return rc27)))
          (if (< n 0) (return (coco_m_domain_error e "not_less_than_zero" (coco_m_arg e g 2))))
          (set buf (cast (u8 *) (malloc (cast size_t (+ n 1)))))
          (if (== buf nil) (return (coco_m_error e "stream_read_bytes" "no memory")))
          (while (< (cast i64 got) n)
            (let ((int c . #'(st_getc s)))
              (if (< c 0) break)
              (set (nth got buf) (cast u8 c))
              (set got (+ got 1))))
          (let ((size_t lst . #'(st_codes e buf got)))
            (free buf)
            (return (coco_m_unify e (coco_m_arg e g 3) lst)))))

  ;;; The writer both byte and formatted output go through: a code list
  ;;; into the file, checked to be bytes. BYTES is 1 for the byte predicate,
  ;;; which a binary stream alone takes, and 0 for the text ones, which take
  ;;; either kind -- a binary stream's codes are its bytes (3.16.0).
  (static)
  (func st_write_list ((coco_engine * e) (size_t g) (int bytes)) (out int)
        (let ((int s . -1) (size_t * items . nil) (size_t n . 0) (u8 * buf . nil))
          (let ((int rc28 . #'(st_slot e g 1 (aof s)))) (if (!= rc28 1) (return rc28)))
          (let ((int rc30 . #'(st_writable e g 0 s))) (if (!= rc30 1) (return rc30)))
          (if bytes
              (let ((int rc29 . #'(st_need_binary e g s "output"))) (if (!= rc29 1) (return rc29))))
          (if (not (coco_m_list_array e (coco_m_arg e g 2) (aof items) (aof n)))
              (return (coco_m_type_error e "list" (coco_m_arg e g 2))))
          (if (== n 0) (block (free items) (return 1)))
          (set buf (cast (u8 *) (malloc n)))
          (if (== buf nil) (block (free items) (return (coco_m_error e "stream_write" "no memory"))))
          ;; UNDER `text_units = characters' (1.13.0) a text stream's code
          ;; is a code point and goes as its UTF-8, up to four bytes each --
          ;; and every code is a character of a stream in another encoding
          ;; than UTF-8 (3.19.0), written by `st_emit'
          (if (and (not bytes) (or (!= (nth s st_cls) 0) (coco_m_text_chars e)))
              (let ((size_t at . 0))
                (free buf)
                (set buf (cast (u8 *) (malloc (* n 4))))
                (if (== buf nil) (block (free items) (return (coco_m_error e "stream_write" "no memory"))))
                (for ((size_t j . 0)) (< j n) ((++ j))
                     (let ((i64 c . 0) (int k . 0))
                       (if (coco_m_int e (nth j items) (aof c))
                           (set k (coco_m_utf8_enc (cast (char *) (+ buf at)) c)))
                       (if (== k 0)
                           (let ((size_t bad . #'(nth j items)))
                             (free buf) (free items)
                             (return (coco_m_type_error e "character_code" bad))))
                       (set at (+ at (cast size_t k)))))
                (set n at))
              (for ((size_t j . 0)) (< j n) ((++ j))
                   (let ((i64 b . 0))
                     (if (or (not (coco_m_int e (nth j items) (aof b))) (or (< b 0) (> b 255)))
                         (let ((size_t bad . #'(nth j items)))
                           (free buf) (free items)
                           (return (coco_m_type_error e "byte" bad))))
                     (set (nth j buf) (cast u8 b)))))
          (free items)
          (if (not bytes)
              (let ((int rce . #'(st_emit e (coco_m_arg e g 0) s (cast (const char *) buf) n)))
                (free buf)
                (return rce)))
          (st_out_begin s)
          (let ((size_t w . #'(fwrite buf 1 n (st_fp s))))
            (st_out_end s)
            (st_wrote s (cast (const char *) buf) w)
            (free buf)
            (if (!= w n) (return (st_io_write e (coco_m_arg e g 0)))))
          (return 1)))

  (func st_p_write_bytes ((coco_engine * e) (size_t g)) (out int)
        (return (st_write_list e g 1)))

  (func st_p_write_codes ((coco_engine * e) (size_t g)) (out int)
        (return (st_write_list e g 0)))

  ;;; The rest of the stream, whatever its kind: a file as codes is what
  ;;; every text predicate here already takes.
  (func st_p_read_all ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (u8 * buf . nil) (size_t cap . 0) (size_t n . 0))
          (let ((int rc31 . #'(st_slot e g 1 (aof s)))) (if (!= rc31 1) (return rc31)))
          (let ((int rc32 . #'(st_readable e g 0 s))) (if (!= rc32 1) (return rc32)))
          (while (> (nth s st_npush) 0)
            (if (not (st_grow (aof buf) (aof cap) (+ n 1)))
                (block (free buf) (return (coco_m_error e "stream_read_all" "no memory"))))
            (set (nth n buf) (cast u8 (st_getc s)))
            (set n (+ n 1)))
          ;; a UTF-16 or UCS-4 stream's rest is decoded a character at a time
          (while (>= (nth s st_cls) 2)
            (let ((int c . #'(st_getc s)))
              (if (< c 0) break)
              (if (not (st_grow (aof buf) (aof cap) (+ n 1)))
                  (block (free buf) (return (coco_m_error e "stream_read_all" "no memory"))))
              (set (nth n buf) (cast u8 c))
              (set n (+ n 1))))
          (while (< (nth s st_cls) 2)
            (if (not (st_grow (aof buf) (aof cap) (+ n 65536)))
                (block (free buf) (return (coco_m_error e "stream_read_all" "no memory"))))
            (let ((size_t got . #'(fread (+ buf n) 1 65536 (nth s st_file))))
              (for ((size_t i . 0)) (< i got) ((++ i))
                   (st_count s (cast int (nth (+ n i) buf))))
              (set n (+ n got))
              (if (< got 65536) break)))
          (let ((size_t lst . #'(st_text_codes e s buf n)))
            (free buf)
            (return (coco_m_unify e (coco_m_arg e g 2) lst)))))

  ;;; ---- characters ----
  ;;;
  ;;; One UTF-8 character: the first byte says how many follow, and a
  ;;; sequence cut short by the end of the file is answered as far as it
  ;;; went rather than lost.
  (static)
  (func st_read_char ((int s) (u8 * out)) (out int)
        (let ((int c . #'(st_getc s)) (int n . 1))
          (if (< c 0) (return 0))
          (set (nth 0 out) (cast u8 c))
          (set n (st_utf8_len c))
          (for ((int i . 1)) (< i n) ((++ i))
               (let ((int d . #'(st_getc s)))
                 (if (< d 0) (return i))
                 (if (!= (bitand d 192) 128)
                     (block (st_ungetc s d) (return i)))
                 (set (nth i out) (cast u8 d))))
          (return n)))

  ;;; ONE CHARACTER'S CODE POINT (1.13.0): its bytes read as `st_read_char'
  ;;; reads them and decoded, any byte the decoding did not take given back;
  ;;; PEEK gives them all back. -1 at the end.
  (static)
  (func st_get_cp ((int s) (int peek)) (out i64)
        (let ((u8 ch [8]) (int n . #'(st_read_char s ch)) (size_t i . 0) (i64 cp . 0))
          (if (== n 0) (return -1))
          (set cp (coco_m_utf8_get (cast (const char *) ch) (cast size_t n) (aof i)))
          (for ((int j . #'(- n 1))) (>= j (? peek 0 (cast int i))) ((-- j))
               (st_ungetc s (cast int (nth j ch))))
          (return cp)))

  ;;; The code a peek sees, -1 at the end: a binary stream's byte, a text
  ;;; stream's code point -- its byte under `text_units = bytes' when UNITS
  ;;; asks, which the codes predicates do
  (static)
  (func st_peek_cp ((coco_engine * e) (int s) (int units)) (out i64)
        (if (or (== (nth s st_cls) 1) (and units (not (coco_m_text_chars e))))
            (let ((int c . #'(st_getc s)))
              (st_ungetc s c)
              (return (? (< c 0) -1 (cast i64 c)))))
        (return (st_get_cp s 1)))

  ;;; The character a get or a peek read, as the atom that names it: a
  ;;; binary stream's byte is the character of that code (swipl's octet
  ;;; encoding, 3.16.0), a text stream's UTF-8 character its own bytes; 0
  ;;; for the end. PEEK gives what it read back.
  (static)
  (func st_char_name ((int s) (int peek) (char * name)) (out int)
        (let ((u8 ch [8]) (int n . 0))
          (if (== (nth s st_cls) 1)
              (let ((int c . #'(st_getc s)))
                (if peek (st_ungetc s c))
                (if (>= c 0) (set n (coco_m_utf8_enc name (cast i64 c)))))
              (block
                (set n (st_read_char s ch))
                (if peek (for ((int i . #'(- n 1))) (>= i 0) ((-- i)) (st_ungetc s (cast int (nth i ch)))))
                (memcpy name ch (cast size_t n))))
          (set (nth n name) (cast char 0))
          (return n)))

  ;;; CODE C INTO STREAM S, put_char/2's and put_code/2's: a stream of one
  ;;; byte a character takes it as one byte, and one past its encoding's
  ;;; largest (`st_lim') is swipl's io_error(write, S), 'Encoding cannot
  ;;; represent character'; a UTF-8 text stream its UTF-8, or, for
  ;;; put_code/2 (CODE) under `text_units = bytes', one byte below 256; a
  ;;; UTF-16 or UCS-4 one its UTF-8, through `st_emit' (3.19.0).
  (static)
  (func st_put_cp ((coco_engine * e) (size_t g) (int s) (i64 c) (int code)) (out int)
        (let ((u8 b [8]) (size_t k . 0))
          (cond
            ((== (nth s st_cls) 1)
             (if (> c (st_lim s)) (return (st_unrepresentable e (coco_m_arg e g 0))))
             (set (nth 0 b) (cast u8 c))
             (set k 1))
            ((and code (and (not (coco_m_text_chars e)) (and (< c 256) (== (nth s st_cls) 0))))
             (set (nth 0 b) (cast u8 c))
             (set k 1))
            (#t
             (set k (cast size_t (coco_m_utf8_enc (cast (char *) b) c)))
             (if (== k 0) (return (coco_m_type_error e "character" (coco_m_arg e g 2))))
             (if (>= (nth s st_cls) 2) (return (st_emit e (coco_m_arg e g 0) s (cast (const char *) b) k)))))
          (st_out_begin s)
          (let ((size_t w . #'(fwrite b 1 k (st_fp s))))
            (st_out_end s)
            (st_wrote s (cast (const char *) b) w)
            (if (!= w k) (return (st_io_write e (coco_m_arg e g 0)))))
          (return 1)))

  ;;; A GET UNIFIES WHAT IT READ, AND ONLY THEN ASKS ITS ARGUMENT (swipl's
  ;;; order, 3.16.0): get_char(S, 97) reads `a' and fails, get_char(S, ab)
  ;;; reads it and raises type_error(character, ab). A PEEK with its
  ;;; argument given compares codes: peek_char(S, 97) holds before an `a'.
  (func st_p_get_char ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (char name [8]) (int n . 0))
          (let ((int rc33 . #'(st_slot e g 1 (aof s)))) (if (!= rc33 1) (return rc33)))
          (let ((int rc35 . #'(st_readable e g 0 s))) (if (!= rc35 1) (return rc35)))
          (set n (st_char_name s 0 name))
          (if (coco_m_unify_atom e (coco_m_arg e g 2) (? (== n 0) "end_of_file" name)) (return 1))
          (return (st_char_fail e (coco_m_arg e g 2)))))

  (func st_p_peek_char ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (char name [8]) (int n . 0) (size_t t . #'(coco_m_arg e g 2)) (i64 want . 0))
          (let ((int rc36 . #'(st_slot e g 1 (aof s)))) (if (!= rc36 1) (return rc36)))
          (let ((int rc38 . #'(st_readable e g 0 s))) (if (!= rc38 1) (return rc38)))
          (if (not (coco_m_is_var e t))
              (block
                (let ((int rc . #'(st_char_code e t 1 (aof want)))) (if (!= rc 1) (return rc)))
                (return (? (== want (st_peek_cp e s 0)) 1 0))))
          (set n (st_char_name s 1 name))
          (return (coco_m_unify_atom e t (? (== n 0) "end_of_file" name)))))

  ;;; the character's code was made of the program's term by '$stream_char'/3
  (func st_p_put_char ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (i64 c . 0))
          (let ((int rc39 . #'(st_slot e g 1 (aof s)))) (if (!= rc39 1) (return rc39)))
          (let ((int rc41 . #'(st_writable e g 0 s))) (if (!= rc41 1) (return rc41)))
          (let ((int rc40 . #'(st_iarg e g 2 (aof c)))) (if (!= rc40 1) (return rc40)))
          (return (st_put_cp e g s c 0))))

  ;;; A line: up to and not including the newline, a CR before it taken
  ;;; off too. `end_of_file' only when NOTHING was read -- a last line
  ;;; with no newline is still a line. A binary stream's are its bytes.
  (func st_p_read_line ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (u8 * buf . nil) (size_t cap . 0) (size_t n . 0) (int c . 0) (int any . 0))
          (let ((int rc42 . #'(st_slot e g 1 (aof s)))) (if (!= rc42 1) (return rc42)))
          (let ((int rc44 . #'(st_readable e g 0 s))) (if (!= rc44 1) (return rc44)))
          (while 1
            (set c (st_getc s))
            (if (< c 0) break)
            (set any 1)
            (if (== c 10) break)
            (if (not (st_grow (aof buf) (aof cap) (+ n 1)))
                (block (free buf) (return (coco_m_resource_error e "memory"))))
            (set (nth n buf) (cast u8 c))
            (set n (+ n 1)))
          (if (not any) (block (free buf) (return (coco_m_unify_atom e (coco_m_arg e g 2) "end_of_file"))))
          (if (and (> n 0) (== (nth (- n 1) buf) 13)) (set n (- n 1)))
          (let ((size_t lst . #'(st_text_codes e s buf n)))
            (free buf)
            (return (coco_m_unify e (coco_m_arg e g 2) lst)))))

  ;;; Text as its characters: an atom, an integer, a string, a code or a
  ;;; char list, which is what `coco_m_text' already turns into bytes. A
  ;;; text with a NUL in it is refused there and is a type error here. A
  ;;; binary stream takes the characters as bytes (`st_put_octets').
  (func st_p_write_text ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (char * buf . nil) (size_t cap . 65536))
          (let ((int rc45 . #'(st_slot e g 1 (aof s)))) (if (!= rc45 1) (return rc45)))
          (let ((int rc47 . #'(st_writable e g 0 s))) (if (!= rc47 1) (return rc47)))
          ;; a text longer than the buffer doubles it until it fits, up to 64 MB
          (while 1
            (set buf (cast (char *) (malloc cap)))
            (if (== buf nil) (return (coco_m_resource_error e "memory")))
            (if (coco_m_text e (coco_m_arg e g 2) buf cap) break)
            (free buf)
            (set buf nil)
            (set cap (* cap 2))
            (if (> cap 67108864) (return (coco_m_type_error e "text" (coco_m_arg e g 2)))))
          (let ((int rc . #'(st_emit e (coco_m_arg e g 0) s buf (strlen buf))))
            (free buf)
            (return rc))))

  ;;; ---- a term: one clause of text, then the engine's reader ----
  ;;;
  ;;; THE SCANNER KNOWS WHERE A CLAUSE ENDS AND NOTHING ELSE, and asks the
  ;;; engine's raw walk, swipl's raw read (3.11.0, `coco_m_raw_walk'): at
  ;;; each `.' that layout, a `%' or the end of the stream follows, the walk
  ;;; of what was collected says whether that is the clause's full stop --
  ;;; not inside a quoted item, a comment or a run of symbols (`=..'), not
  ;;; a `0'c' code -- so a stream is cut into clauses where a load cuts a
  ;;; file. Through 3.10.1 a scanner of its own did it, and an octal or hex
  ;;; escape's closing backslash (`'\x41\''), a radix's quote (`16'ff') and
  ;;; `0'''' each put the end elsewhere. What it collects goes to
  ;;; `coco_m_read_clause', the reader `consult' uses. Answers 1 with the
  ;;; text -- a clause the end of the stream cut short as well, whose error
  ;;; the reader gives as a load's -- 0 at a clean end (layout and comments
  ;;; only), -2 when memory ran out.
  ;;; Layout: the space and tab to return, the vertical tab and the form
  ;;; feed among them (3.35.0), as the engine's reader takes them
  (static)
  (func st_layout ((int c)) (out int)
        (return (? (or (== c 32) (and (>= c 9) (<= c 13))) 1 0)))

  ;;; A CODE PAST ASCII AFTER A `.' (3.35.0): its bytes, D its first, read
  ;;; onto BUF after its N bytes and given back to the stream, and the walk
  ;;; asked of the text with them -- a space past ASCII (U+00A0, U+3000)
  ;;; ends a clause as an ASCII one does, which the walk alone knows. 1 when
  ;;; the clause ends at N; -2 when memory ran out.
  (static)
  (func st_wide_stop ((int s) (u8 ** buf) (size_t * cap) (size_t n) (int d)) (out int)
        (let ((u8 got [4]) (int k . 1) (int want . 1) (size_t end . 0) (int kind . 0))
          (set (nth 0 got) (cast u8 d))
          (cond ((== (bitand d 224) 192) (set want 2))
                ((== (bitand d 240) 224) (set want 3))
                ((== (bitand d 248) 240) (set want 4)))
          (while (< k want)
            (let ((int b . #'(st_getc s)))
              (if (< b 0) break)
              (if (!= (bitand b 192) 128) (block (st_ungetc s b) break))
              (set (nth k got) (cast u8 b))
              (set k (+ k 1))))
          (if (not (st_grow buf cap (+ n (+ (cast size_t k) 2))))
              (block (for ((int j . #'(- k 1))) (>= j 0) ((-- j)) (st_ungetc s (cast int (nth j got))))
                     (return -2)))
          (for ((int j . 0)) (< j k) ((++ j)) (set (nth (+ n (cast size_t j)) (cof buf)) (nth j got)))
          (set kind (coco_m_raw_walk (cast (const char *) (cof buf)) (+ n (cast size_t k)) (aof end)))
          (for ((int j . #'(- k 1))) (>= j 0) ((-- j)) (st_ungetc s (cast int (nth j got))))
          (return (? (and (or (== kind 0) (== kind 6)) (== end n)) 1 0))))

  (static)
  (func st_read_clause ((int s) (u8 ** out) (size_t * len)) (out int)
        (let ((u8 * buf . nil) (size_t cap . 0) (size_t n . 0) (int c . 0)
              (size_t end . 0) (int kind . 0))
          (while 1
            (set c (st_getc s))
            (if (< c 0) break)
            (if (not (st_grow (aof buf) (aof cap) (+ n 2))) (block (free buf) (return -2)))
            (set (nth n buf) (cast u8 c))
            (set n (+ n 1))
            (if (== c 46)
                (let ((int d . #'(st_getc s)))
                  (if (>= d 0) (st_ungetc s d))
                  (if (or (< d 0) (or (st_layout d) (== d 37)))
                      (block
                        (set kind (coco_m_raw_walk (cast (const char *) buf) n (aof end)))
                        (if (and (or (== kind 0) (== kind 6)) (== end n))
                            (block (set (cof out) buf) (set (cof len) n) (return 1))))
                    (if (>= d 128)
                        (let ((int w . 0))
                          (st_getc s)
                          (set w (st_wide_stop s (aof buf) (aof cap) n d))
                          (if (== w -2) (block (free buf) (return -2)))
                          (if (== w 1) (block (set (cof out) buf) (set (cof len) n) (return 1)))))))))
          (if (== (coco_m_raw_walk (cast (const char *) buf) n (aof end)) 2)
              (block (free buf) (return 0)))
          (set (cof out) buf)
          (set (cof len) n)
          (return 1)))

  ;;; One clause: '$stream_read_term'(S, N, Kind, T, Names, Message), Kind
  ;;; term, end_of_file or syntax_error, Message then '$syntax'(Id, Line,
  ;;; LinePos, CharNo), which the Coco half throws in swipl's shape.
  ;;; '$stream_read_term_pos'/11 (WANT) adds Pos, SWI's subterm_positions
  ;;; as the engine's reader builds them, and Char, Line, LinePos and Byte,
  ;;; where the term begins -- at the end of the file, where that is --
  ;;; which the Coco half makes '$stream_position'/4.

  ;;; Where the stream stands now, into arguments 7 to 10.
  (static)
  (func st_unify_where ((coco_engine * e) (size_t g) (i64 c) (i64 l) (i64 p) (i64 b)) (out int)
        (if (not (coco_m_unify_int e (coco_m_arg e g 7) c)) (return 0))
        (if (not (coco_m_unify_int e (coco_m_arg e g 8) l)) (return 0))
        (if (not (coco_m_unify_int e (coco_m_arg e g 9) p)) (return 0))
        (return (coco_m_unify_int e (coco_m_arg e g 10) b)))

  ;;; A CLAUSE THAT WILL NOT READ (3.11.0): Kind syntax_error and Message
  ;;; '$syntax'(Id, Line, LinePos, CharNo), swipl's id and its place in the
  ;;; stream, which the Coco half makes file(F, L, LP, C) or stream(S, L,
  ;;; LP, C). The stream stands after the clause's full stop, or at its end,
  ;;; as swipl's does. BUF is freed.
  (static)
  (func st_syntax ((coco_engine * e) (size_t g) (u8 * buf) (i64 c0) (i64 l0) (i64 p0)) (out int)
        (let ((size_t t . #'(coco_m_syntax_at e (cast (const char *) buf) c0 l0 p0)))
          (free buf)
          ;; the reader that refused the text reads it again the same way
          (if (== t 0) (return (coco_m_error e "read_term" "a clause read once and not again")))
          (if (not (coco_m_unify_atom e (coco_m_arg e g 2) "syntax_error")) (return 0))
          (return (coco_m_unify e (coco_m_arg e g 5) t))))

  ;;; A BINARY STREAM'S CLAUSE IS ITS BYTES AS CHARACTERS (3.16.0, swipl's
  ;;; octets): each byte past 127 is made the UTF-8 of its code, the text
  ;;; the engine's reader reads. *BUF is freed and replaced; 0 for no memory.
  (static)
  (func st_octets_utf8 ((u8 ** buf) (size_t * n)) (out int)
        (let ((u8 * u . #'(cast (u8 *) (malloc (+ (* (cof n) 2) 2)))) (size_t k . 0) (u8 * b . #'(cof buf)))
          (if (== u nil) (return 0))
          (for ((size_t i . 0)) (< i (cof n)) ((++ i))
               (let ((int c . #'(cast int (nth i b))))
                 (if (< c 128)
                     (block (set (nth k u) (cast u8 c)) (set k (+ k 1)))
                     (block
                       (set (nth k u) (cast u8 (bitor 192 (>> c 6))))
                       (set (nth (+ k 1) u) (cast u8 (bitor 128 (bitand c 63))))
                       (set k (+ k 2))))))
          (free b)
          (set (cof buf) u)
          (set (cof n) k)
          (return 1)))

  (static)
  (func st_read_term ((coco_engine * e) (size_t g) (int want)) (out int)
        (let ((int s . -1) (u8 * buf . nil) (size_t n . 0) (int rc . 0)
              (size_t t . 0) (size_t names . 0) (size_t pos . 0) (size_t start . 0)
              (i64 b0 . 0) (i64 c0 . 0) (i64 l0 . 0) (i64 p0 . 0) (i64 bstart . 0)
              (char err [192]))
          (let ((int rc48 . #'(st_slot e g 1 (aof s)))) (if (!= rc48 1) (return rc48)))
          (let ((int rc50 . #'(st_readable e g 0 s))) (if (!= rc50 1) (return rc50)))
          ;; where the text about to be read begins, layout and all: the term's
          ;; positions and a syntax error's place are counted on from there
          (st_pos_sync s)
          (set b0 (nth s st_nb)) (set c0 (nth s st_nc))
          (set l0 (nth s st_nl)) (set p0 (nth s st_lp))
          (set rc (st_read_clause s (aof buf) (aof n)))
          (if (== rc -2) (return (coco_m_resource_error e "memory")))
          (if (== rc 0)
              (block
                (if (not (coco_m_unify_atom e (coco_m_arg e g 2) "end_of_file")) (return 0))
                (if (not want) (return 1))
                (return (st_unify_where e g (nth s st_nc) (nth s st_nl) (nth s st_lp) (nth s st_nb)))))
          (if (and (== (nth s st_cls) 1) (not (st_octets_utf8 (aof buf) (aof n))))
              (block (free buf) (return (coco_m_resource_error e "memory"))))
          ;; the scanner grows its buffer to two past every byte it keeps (the
          ;; octets' copy too), so the NUL that makes it a C string has its slot
          (set (nth n buf) (cast u8 0))
          (if want
              (set rc (coco_m_read_clause_pos e (cast (char *) buf) c0 (aof t) (aof names)
                                              (aof pos) (aof start) err (sizeof err)))
            (set rc (coco_m_read_clause e (cast (char *) buf) (aof t) (aof names) err (sizeof err))))
          (if (== rc -1) (return (st_syntax e g buf c0 l0 p0)))
          ;; where the term begins: a stream of one byte a character's bytes
          ;; are its characters, and a UTF-16 or UCS-4 one's are counted from
          ;; its UTF-8, a character's first byte by `st_rawn'
          (if (and want (== rc 1))
              (let ((i64 cb . c0))
                (st_pos_walk buf start 0 (aof c0) (aof l0) (aof p0))
                (set bstart (? (== (nth s st_cls) 1) (- c0 cb) (cast i64 start)))
                (if (>= (nth s st_cls) 2)
                    (block
                      (set bstart 0)
                      (for ((size_t j . 0)) (< j start) ((++ j))
                           (set bstart (+ bstart (st_rawn s (cast int (nth j buf))))))))))
          (free buf)
          (if (== rc 0)
              (block
                (if (not (coco_m_unify_atom e (coco_m_arg e g 2) "end_of_file")) (return 0))
                (if (not want) (return 1))
                (return (st_unify_where e g (nth s st_nc) (nth s st_nl) (nth s st_lp) (nth s st_nb)))))
          (if (not (coco_m_unify_atom e (coco_m_arg e g 2) "term")) (return 0))
          (if (not (coco_m_unify e (coco_m_arg e g 3) t)) (return 0))
          (if (not (coco_m_unify e (coco_m_arg e g 4) names)) (return 0))
          (if (not want) (return 1))
          (if (not (coco_m_unify e (coco_m_arg e g 6) pos)) (return 0))
          (return (st_unify_where e g c0 l0 p0 (+ b0 bstart)))))

  (func st_p_read_term ((coco_engine * e) (size_t g)) (out int)
        (return (st_read_term e g 0)))

  (func st_p_read_term_pos ((coco_engine * e) (size_t g)) (out int)
        (return (st_read_term e g 1)))

  ;;; ---- codes ----
  ;;;
  ;;; A text stream's code is a code point (`text_units = characters', the
  ;;; default since 2.0.0) or a byte (`bytes'), as atom_codes/2 counts one;
  ;;; a binary stream's is a byte. A get unifies what it read and then asks
  ;;; its argument, a peek with one given compares codes, and the code a
  ;;; put writes was made of the program's term by '$stream_char'/3, as
  ;;; swipl's PL_get_char_ex makes it (3.16.0).
  (func st_p_get_code ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (i64 v . 0))
          (let ((int rc51 . #'(st_slot e g 1 (aof s)))) (if (!= rc51 1) (return rc51)))
          (let ((int rc53 . #'(st_readable e g 0 s))) (if (!= rc53 1) (return rc53)))
          (if (and (!= (nth s st_cls) 1) (coco_m_text_chars e))
              (set v (st_get_cp s 0))
              (let ((int c . #'(st_getc s)))
                (set v (? (< c 0) -1 (cast i64 c)))))
          (if (coco_m_unify_int e (coco_m_arg e g 2) v) (return 1))
          (return (st_char_fail e (coco_m_arg e g 2)))))

  (func st_p_peek_code ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (size_t t . #'(coco_m_arg e g 2)) (i64 want . 0) (i64 v . 0))
          (let ((int rc54 . #'(st_slot e g 1 (aof s)))) (if (!= rc54 1) (return rc54)))
          (let ((int rc56 . #'(st_readable e g 0 s))) (if (!= rc56 1) (return rc56)))
          (if (not (coco_m_is_var e t))
              (let ((int rc . #'(st_char_code e t 1 (aof want)))) (if (!= rc 1) (return rc))))
          (set v (st_peek_cp e s 1))
          (if (coco_m_is_var e t) (return (coco_m_unify_int e t v)))
          (return (? (== want v) 1 0))))

  (func st_p_put_code ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (i64 c . 0))
          (let ((int rc57 . #'(st_slot e g 1 (aof s)))) (if (!= rc57 1) (return rc57)))
          (let ((int rc59 . #'(st_writable e g 0 s))) (if (!= rc59 1) (return rc59)))
          (let ((int rc60 . #'(st_iarg e g 2 (aof c)))) (if (!= rc60 1) (return rc60)))
          (return (st_put_cp e g s c 1))))

  ;;; ---- aliases, and the current input and output ----
  ;;;
  ;;; Argument I as an open slot, with no handle beside it: these are asked
  ;;; by the Coco half about slots it already holds, so a free one FAILS.
  (static)
  (func st_nslot ((coco_engine * e) (size_t g) (int i) (int * s)) (out int)
        (let ((i64 v . 0))
          (st_setup)
          (let ((int rc61 . #'(st_iarg e g i (aof v)))) (if (!= rc61 1) (return rc61)))
          (if (< v 0) (return 0))
          (if (>= v 256) (return 0))
          (if (== (nth v st_kind) 0) (return 0))
          (set (cof s) (cast int v))
          (return 1)))

  (func st_p_set_alias ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (const char * a . nil))
          (let ((int rc62 . #'(st_nslot e g 0 (aof s)))) (if (!= rc62 1) (return rc62)))
          (set a (coco_m_atom e (coco_m_arg e g 1)))
          (if (== a nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 1))))
          (if (!= (nth s st_alias) nil) (free (nth s st_alias)))
          (set (nth s st_alias) (strdup a))
          (return 1)))

  ;;; '$stream_drop_alias'(N): slot N gives its alias up (3.19.0, set_stream/2)
  (func st_p_drop_alias ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc . #'(st_nslot e g 0 (aof s)))) (if (!= rc 1) (return rc)))
          (if (!= (nth s st_alias) nil) (block (free (nth s st_alias)) (set (nth s st_alias) nil)))
          (return 1)))

  (func st_p_by_alias ((coco_engine * e) (size_t g)) (out int)
        (let ((const char * a . nil))
          (st_setup)
          (set a (coco_m_atom e (coco_m_arg e g 0)))
          (if (== a nil) (return 0))
          (for ((int i . 3)) (< i 256) ((++ i))
               (if (and (!= (nth i st_alias) nil) (== 0 (strcmp (nth i st_alias) a)))
                   (return (coco_m_unify_int e (coco_m_arg e g 1) (cast i64 i)))))
          (return 0)))

  (func st_p_alias_of ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc63 . #'(st_nslot e g 0 (aof s)))) (if (!= rc63 1) (return rc63)))
          (if (== (nth s st_alias) nil) (return 0))
          (return (coco_m_unify_atom e (coco_m_arg e g 1) (nth s st_alias)))))

  ;;; '$stream_cur'(0, N) is the current input, (1, N) the current output.
  (func st_p_cur ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 which . 0))
          (st_setup)
          (let ((int rc64 . #'(st_iarg e g 0 (aof which)))) (if (!= rc64 1) (return rc64)))
          (return (coco_m_unify_int e (coco_m_arg e g 1)
                                    (cast i64 (? (== which 0) st_cur_in st_cur_out))))))

  (func st_p_set_input ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc65 . #'(st_slot e g 1 (aof s)))) (if (!= rc65 1) (return rc65)))
          (let ((int rc66 . #'(st_readable e g 0 s))) (if (!= rc66 1) (return rc66)))
          (set st_cur_in s)
          (return 1)))

  ;;; FD 1 AT THE STREAM'S FILE, the real stdout kept aside; user_output puts
  ;;; the terminal back, and user_error points fd 1 at fd 2. A binary stream
  ;;; is taken, as swipl takes one (3.16.0; refused through 3.15.2), and the
  ;;; engine's writers write their text into it as they write it, UTF-8.
  (func st_p_set_output ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc67 . #'(st_slot e g 1 (aof s)))) (if (!= rc67 1) (return rc67)))
          (let ((int rc69 . #'(st_writable e g 0 s))) (if (!= rc69 1) (return rc69)))
          (if (== s st_cur_out) (return 1))
          (if (== s 1) (block (st_restore_output) (return 1)))
          (fflush stdout)
          (if (>= st_cur_out 2) (fflush (nth st_cur_out st_file)))
          (if (< st_saved_fd 0)
              (block
                (set st_saved_fd (dup 1))
                (if (< st_saved_fd 0) (return (coco_m_error e "set_output" (strerror errno))))
                (let ((int t . #'(dup st_saved_fd)))
                  (if (>= t 0) (set st_term (fdopen t "w"))))))
          (fflush (nth s st_file))
          (if (< (dup2 (fileno (nth s st_file)) 1) 0)
              (return (coco_m_error e "set_output" (strerror errno))))
          (set st_cur_out s)
          (return 1)))

  ;;; ---- the sink hook: format/3 and with_output_to/2 into a stream ----
  ;;;
  ;;; The engine asks this about every sink before its own: '$stream'(N),
  ;;; an alias this table holds, and user_output while a file is the current
  ;;; output (so that it still means the terminal). Anything else answers 0
  ;;; and the engine carries on as it always has.
  (static)
  (func st_sink ((coco_engine * e) (size_t sink) (const char * text) (size_t len)) (out int)
        (let ((u32 ar . 0) (const char * nm . nil) (int s . -1))
          (st_setup)
          (set nm (coco_m_functor e sink (aof ar)))
          (if (== nm nil) (return 0))
          (if (and (== ar 1) (== 0 (strcmp nm "$stream")))
              (let ((i64 v . 0))
                (if (not (coco_m_int e (coco_m_arg e sink 0) (aof v))) (return 0))
                (if (< v 0) (return (coco_m_existence_error e "stream" sink)))
                (if (>= v 256) (return (coco_m_existence_error e "stream" sink)))
                (if (== (nth v st_kind) 0) (return (coco_m_existence_error e "stream" sink)))
                (set s (cast int v))))
          (if (== ar 0)
              (block
                (if (== 0 (strcmp nm "user_output"))
                    (block (if (< st_saved_fd 0) (return 0)) (set s 1)))
                (if (< s 0)
                    (for ((int i . 3)) (< i 256) ((++ i))
                         (if (and (!= (nth i st_alias) nil) (== 0 (strcmp (nth i st_alias) nm)))
                             (block (set s i) break))))))
          (if (< s 0) (return 0))
          (if (< (nth s st_mode) 2) (return (coco_m_permission_error e "output" "stream" sink)))
          ;; a binary stream takes text as its characters' bytes (3.16.0,
          ;; swipl's octets; permission_error(output, binary_stream, S)
          ;; through 3.15.2), and every stream in its encoding (3.19.0)
          (return (st_emit e sink s text len))))

  ;;; The slot of a sink of this table (3.56.0, out of st_sink_column):
  ;;; '$stream'(N) or an alias, 256 for a '$stream'(N) past the table,
  ;;; -1 none of its own
  (static)
  (func st_sink_slot ((coco_engine * e) (size_t sink)) (out int)
        (let ((u32 ar . 0) (const char * nm . nil) (int s . -1))
          (st_setup)
          (set nm (coco_m_functor e sink (aof ar)))
          (if (== nm nil) (return -1))
          (if (and (== ar 1) (== 0 (strcmp nm "$stream")))
              (let ((i64 v . 0))
                (if (not (coco_m_int e (coco_m_arg e sink 0) (aof v))) (return -1))
                (if (or (< v 0) (>= v 256)) (return 256))
                (set s (cast int v))))
          (if (and (== ar 0) (< s 0))
              (for ((int i . 3)) (< i 256) ((++ i))
                   (if (and (!= (nth i st_alias) nil) (== 0 (strcmp (nth i st_alias) nm)))
                       (block (set s i) break))))
          (return s)))

  ;;; Slot S's last character (3.56.0), -1 none: the console's for
  ;;; user_output and user_error, a file's its own
  (static)
  (func st_slot_lastc ((int s)) (out i64)
        (if (or (== s 1) (== s 2)) (return (coco_m_out_lastc s)))
        (if (or (< s 0) (or (>= s 256) (== (nth s st_kind) 0))) (return -1))
        (return (- (nth s st_lc1) 1)))

  ;;; The column a sink of this table stands at (2.16.0 whether a line was
  ;;; open, for `~N'; 3.33.0 the column, for its column stops too), or -1
  ;;; not one of its own -- the sinks st_sink takes, user_output and
  ;;; user_error by the console's column, a file by its own. A slot that is
  ;;; no stream answers 0, and format raises after.
  (static)
  (func st_sink_column ((coco_engine * e) (size_t sink)) (out int)
        (let ((int s . #'(st_sink_slot e sink)))
          (if (< s 0) (return -1))
          (if (or (== s 1) (== s 2)) (return (cast int (coco_m_out_column s))))
          (if (or (>= s 256) (== (nth s st_kind) 0)) (return 0))
          (return (cast int (nth s st_lp)))))

  ;;; And the last character written there (3.56.0), where a format's `~W'
  ;;; of partial(true) begins: -1 none, -2 no sink of this table's
  (static)
  (func st_sink_lastc ((coco_engine * e) (size_t sink)) (out i64)
        (let ((int s . #'(st_sink_slot e sink)))
          (if (< s 0) (return -2))
          (return (st_slot_lastc s))))

  ;;; '$stream_lastc'(S, C) (3.56.0): C is the last character written to S,
  ;;; -1 none or no stream of this table -- whose error is the write's to
  ;;; raise. write_term/3 asks it before its capture begins, where
  ;;; user_output's is still the console's, and its write begins there by
  ;;; '$stream_lastc_set'(C), so that partial(true) begins at S's last
  ;;; character, as swipl's begins at the stream's lastc
  (func st_p_lastc ((coco_engine * e) (size_t g)) (out int)
        (let ((size_t a . #'(coco_m_arg e g 0)) (int s . #'(st_sink_slot e a))
              (const char * nm . #'(coco_m_atom e a)))
          (if (and (< s 0) (!= nm nil))
              (block (if (== 0 (strcmp nm "user_output")) (set s 1))
                     (if (== 0 (strcmp nm "user_error")) (set s 2))))
          (return (coco_m_unify_int e (coco_m_arg e g 1) (? (and (>= s 0) (< s 256)) (st_slot_lastc s) -1)))))

  (func st_p_lastc_set ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 c . -1))
          (if (coco_m_int e (coco_m_arg e g 0) (aof c)) (coco_m_out_lastc_set 1 c))
          (return 1)))

  ;;; Loaded: the standard slots, and the hooks installed. Idempotent, since
  ;;; a module's init runs once for every store that loads it.
  (static)
  (func st_init ((coco_engine * e)) (out int)
        (st_setup)
        (coco_m_sink_install st_sink)
        (coco_m_sink_column_install st_sink_column)
        (coco_m_sink_lastc_install st_sink_lastc)
        (return 1))

  (static) (coco-emit-module-dispatch st_dispatch *stream-predicates*)
  (coco-deflibrary "stream" st_dispatch *stream-prolog* st_init)

  ) ; source

  ;;; A line: up to and not including the newline, a CR before it taken
  ;;; off too. `end_of_file' only when NOTHING was read -- a last line
  ;;; with no newline is still a line.
  (func st_p_read_line ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (u8 * buf . nil) (size_t cap . 0) (size_t n . 0) (int c . 0) (int any . 0))
          (let ((int rc42 . #'(st_slot e g 1 (aof s)))) (if (!= rc42 1) (return rc42)))
          (let ((int rc43 . #'(st_need e g 0 s 1 "input"))) (if (!= rc43 1) (return rc43)))
          (let ((int rc44 . #'(st_readable e g 0 s))) (if (!= rc44 1) (return rc44)))

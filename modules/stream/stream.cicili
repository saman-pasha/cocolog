          (return 1)))

  ;;; ---- a term: one clause of text, then the engine's reader ----
  ;;;
  ;;; THE SCANNER KNOWS WHERE A CLAUSE ENDS AND NOTHING ELSE: a `.' that
  ;;; is not part of a symbol atom (`=..'), outside a quoted atom, a
  ;;; string, a back-quoted text, a `0'c' code and both kinds of comment,
  ;;; and followed by layout, a `%' or the end of the file. What it
  ;;; collects goes to `coco_m_read_term', which is the reader `consult'
  ;;; uses, operators and all -- so a file this reads is a file cocolog
  ;;; would consult. Answers 1 with the text, 0 at a clean end (layout and
  ;;; comments only), -1 for a clause the end of the file cut short.
  (static)
  (func st_is_symbol ((int c)) (out int)
        (return (? (!= (strchr "+-*/\\\\^<>=~:.?@#&$" c) nil) 1 0)))

  ;;; Does a `0' at buf[n-2] begin a number? Not when a name character
  ;;; stands right before it: `a0'b' is a quoted atom after an atom.
  (static)
  (func st_number_start ((const u8 * buf) (size_t n)) (out int)
        (if (< n 3) (return 1))
        (let ((int b . #'(cast int (nth (- n 3) buf))))
          (if (== b 95) (return 0))
          (if (and (>= b 48) (<= b 57)) (return 0))
          (if (and (>= b 65) (<= b 90)) (return 0))
          (if (and (>= b 97) (<= b 122)) (return 0))
          (return 1)))

  (static)
  (func st_read_clause ((int s) (u8 ** out) (size_t * len)) (out int)
        (let ((u8 * buf . nil) (size_t cap . 0) (size_t n . 0)
              (int c . 0) (int prev . 32) (int state . 0))

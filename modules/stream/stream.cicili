          (if (and (>= b 48) (<= b 57)) (return 0))
          (if (and (>= b 65) (<= b 90)) (return 0))
          (if (and (>= b 97) (<= b 122)) (return 0))
          (return 1)))

  (static)
  (func st_read_clause ((int s) (u8 ** out) (size_t * len)) (out int)

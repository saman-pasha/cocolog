  (func st_p_write_bytes ((coco_engine * e) (size_t g)) (out int)
        (return (st_write_list e g 2)))

  (func st_p_write_codes ((coco_engine * e) (size_t g)) (out int)
        (return (st_write_list e g 1)))

  ;;; The rest of the stream, whatever its kind: a file as codes is what
  ;;; every text predicate here already takes.

                           (let ((int b . #'(cast int (nth i buf))))
                             (cond
                               ((== st 4) (if (== b 10) (set st 0)))
                               ((== st 5) (if (and (== b 47) (== pv 42)) (set st 0)))
                               ((== b 37) (set st 4))
                               ((and (== b 42) (== pv 47)) (set st 5))
                               ((and (!= b 32) (and (!= b 10) (and (!= b 9) (and (!= b 13) (!= b 47)))))
                                (set clean 0)))
                             (set pv b)))))
                (if clean (block (free buf) (return 0)))))
          (set (cof out) buf)
          (set (cof len) n)
          (return -1)))

  (func st_p_read_term ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (u8 * buf . nil) (size_t n . 0) (int rc . 0) (size_t t . 0))
          (let ((int rc48 . #'(st_slot e g 1 (aof s)))) (if (!= rc48 1) (return rc48)))
          (let ((int rc49 . #'(st_need e g 0 s 1 "input"))) (if (!= rc49 1) (return rc49)))
          (let ((int rc50 . #'(st_readable e g 0 s))) (if (!= rc50 1) (return rc50)))
          (set rc (st_read_clause s (aof buf) (aof n)))
          (if (== rc 0) (return (coco_m_unify_atom e (coco_m_arg e g 2) "end_of_file")))
          ;; the scanner grows its buffer to two past every byte it keeps, so
          ;; the NUL that makes it a C string always has its slot
          (set (nth n buf) (cast u8 0))
          (if (== rc -1)
              (let ((char msg [256]))
                (snprintf msg (sizeof msg) "the end of the file inside a clause: %.120s" (cast (char *) buf))
                (free buf)
                (return (coco_m_error e "stream_read_term" msg))))
          (set t (coco_m_read_term e (cast (char *) buf)))
          (if (== t 0)
              (let ((char msg [256]))
                (snprintf msg (sizeof msg) "syntax error in: %.160s" (cast (char *) buf))
                (free buf)
                (return (coco_m_error e "stream_read_term" msg))))
          (free buf)
          (return (coco_m_unify e (coco_m_arg e g 2) t))))

  (static) (coco-emit-module-dispatch st_dispatch *stream-predicates*)
  (coco-deflibrary "stream" st_dispatch *stream-prolog*)

  ) ; source

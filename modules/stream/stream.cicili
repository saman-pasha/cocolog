        (let ((int s . -1) (char * buf . nil) (size_t cap . 65536))
          (let ((int rc45 . #'(st_slot e g 1 (aof s)))) (if (!= rc45 1) (return rc45)))
          (let ((int rc46 . #'(st_need e g 0 s 1 "output"))) (if (!= rc46 1) (return rc46)))
          (let ((int rc47 . #'(st_writable e g 0 s))) (if (!= rc47 1) (return rc47)))

          (return 1)))

  (func ray_p_text ((coco_engine * e) (size_t g)) (out int)
        (let ((char text [2048]) (i64 v [3]) (i64 c [4]))
          (if (not (coco_m_text e (coco_m_arg e g 0) text (sizeof text)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (for ((int j . 0)) (< j 3) ((++ j))
               (let ((int rc20 . #'(ray_iarg e g (+ j 1) (+ v j))))
                 (if (!= rc20 1) (return rc20))))
          (let ((int rc21 . #'(ray_carg e g 4 c)))
            (if (!= rc21 1) (return rc21)))
          (DrawText text (cast int (nth 0 v)) (cast int (nth 1 v)) (cast int (nth 2 v))
                    (ray_color c))
          (return 1)))

  (func ray_p_draw_fps ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 x . 0) (i64 y . 0))
          (let ((int rc22 . #'(ray_iarg e g 0 (aof x))))
            (if (!= rc22 1) (return rc22)))
          (let ((int rc23 . #'(ray_iarg e g 1 (aof y))))
            (if (!= rc23 1) (return rc23)))
          (DrawFPS (cast int x) (cast int y))
          (return 1)))

  ;;; A regular polygon: X Y Sides Radius Rotation, then the color. Both
  ;;; predicates read the same nine arguments; only the raylib call
  ;;; differs, so the reading is one helper.
  (static)
  (func ray_poly_args ((coco_engine * e) (size_t g) (double * p) (i64 * sides) (i64 * c)) (out int)
        (let ((int rc24 . #'(ray_farg e g 0 (+ p 0))))
          (if (!= rc24 1) (return rc24)))
        (let ((int rc25 . #'(ray_farg e g 1 (+ p 1))))
          (if (!= rc25 1) (return rc25)))
        (let ((int rc26 . #'(ray_iarg e g 2 sides)))
          (if (!= rc26 1) (return rc26)))
        (let ((int rc27 . #'(ray_farg e g 3 (+ p 2))))
          (if (!= rc27 1) (return rc27)))
        (let ((int rc28 . #'(ray_farg e g 4 (+ p 3))))
          (if (!= rc28 1) (return rc28)))
        (return (ray_carg e g 5 c)))

  (func ray_p_poly ((coco_engine * e) (size_t g)) (out int)
        (let ((double p [4]) (i64 sides . 0) (i64 c [4]))
          (let ((int rc29 . #'(ray_poly_args e g p (aof sides) c)))
            (if (!= rc29 1) (return rc29)))
          (DrawPoly (ray_v2 (nth 0 p) (nth 1 p)) (cast int sides)
                    (cast float (nth 2 p)) (cast float (nth 3 p)) (ray_color c))
          (return 1)))

  (func ray_p_poly_lines ((coco_engine * e) (size_t g)) (out int)
        (let ((double p [4]) (i64 sides . 0) (i64 c [4]))
          (let ((int rc30 . #'(ray_poly_args e g p (aof sides) c)))
            (if (!= rc30 1) (return rc30)))
          (DrawPolyLines (ray_v2 (nth 0 p) (nth 1 p)) (cast int sides)
                         (cast float (nth 2 p)) (cast float (nth 3 p)) (ray_color c))
          (return 1)))

  ;;; ---- 3D ----
  ;;; A camera at P looking at T, up the Y axis, in perspective: the one
  ;;; camera a game written as clauses has asked for so far.
  (func ray_p_begin3d ((coco_engine * e) (size_t g)) (out int)
        (let ((double v [7]) (Camera3D cam . '{ 0 }))
          (for ((int j . 0)) (< j 7) ((++ j))
               (let ((int rc31 . #'(ray_farg e g j (+ v j))))
                 (if (!= rc31 1) (return rc31))))
          (set ($ cam position) (ray_v3 (nth 0 v) (nth 1 v) (nth 2 v)))
          (set ($ cam target) (ray_v3 (nth 3 v) (nth 4 v) (nth 5 v)))
          (set ($ cam up) (ray_v3 0.0 1.0 0.0))
          (set ($ cam fovy) (cast float (nth 6 v)))
          (set ($ cam projection) CAMERA_PERSPECTIVE)
          (BeginMode3D cam)
          (return 1)))

  (func ray_p_end3d ((coco_engine * e) (size_t g)) (out int)
        (EndMode3D) (return 1))

  (func ray_p_cube ((coco_engine * e) (size_t g)) (out int)
        (let ((double p [6]) (i64 c [4]))
          (for ((int j . 0)) (< j 6) ((++ j))
               (let ((int rc32 . #'(ray_farg e g j (+ p j))))
                 (if (!= rc32 1) (return rc32))))
          (let ((int rc33 . #'(ray_carg e g 6 c)))
            (if (!= rc33 1) (return rc33)))
          (DrawCube (ray_v3 (nth 0 p) (nth 1 p) (nth 2 p))
                    (cast float (nth 3 p)) (cast float (nth 4 p)) (cast float (nth 5 p))
                    (ray_color c))
          (return 1)))

  (func ray_p_cube_wires ((coco_engine * e) (size_t g)) (out int)
        (let ((double p [6]) (i64 c [4]))
          (for ((int j . 0)) (< j 6) ((++ j))
               (let ((int rc34 . #'(ray_farg e g j (+ p j))))
                 (if (!= rc34 1) (return rc34))))
          (let ((int rc35 . #'(ray_carg e g 6 c)))
            (if (!= rc35 1) (return rc35)))
          (DrawCubeWires (ray_v3 (nth 0 p) (nth 1 p) (nth 2 p))
                         (cast float (nth 3 p)) (cast float (nth 4 p)) (cast float (nth 5 p))
                         (ray_color c))
          (return 1)))

  (func ray_p_sphere ((coco_engine * e) (size_t g)) (out int)
        (let ((double p [4]) (i64 c [4]))
          (for ((int j . 0)) (< j 4) ((++ j))
               (let ((int rc36 . #'(ray_farg e g j (+ p j))))
                 (if (!= rc36 1) (return rc36))))
          (let ((int rc37 . #'(ray_carg e g 4 c)))
            (if (!= rc37 1) (return rc37)))
          (DrawSphere (ray_v3 (nth 0 p) (nth 1 p) (nth 2 p)) (cast float (nth 3 p))
                      (ray_color c))
          (return 1)))

  (func ray_p_grid ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 slices . 0) (double spacing . 0.0))
          (let ((int rc38 . #'(ray_iarg e g 0 (aof slices))))
            (if (!= rc38 1) (return rc38)))
          (let ((int rc39 . #'(ray_farg e g 1 (aof spacing))))
            (if (!= rc39 1) (return rc39)))
          (DrawGrid (cast int slices) (cast float spacing))
          (return 1)))

  ;;; ---- input, polled ----
  (func ray_p_key_down ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 k . 0))
          (let ((int rc40 . #'(ray_iarg e g 0 (aof k))))
            (if (!= rc40 1) (return rc40)))
          (return (ray_yes (IsKeyDown (cast int k))))))

  (func ray_p_key_pressed ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 k . 0))
          (let ((int rc41 . #'(ray_iarg e g 0 (aof k))))
            (if (!= rc41 1) (return rc41)))
          (return (ray_yes (IsKeyPressed (cast int k))))))

  (func ray_p_mouse ((coco_engine * e) (size_t g)) (out int)
        (if (not (coco_m_unify_int e (coco_m_arg e g 0) (cast i64 (GetMouseX))))
            (return 0))
        (return (coco_m_unify_int e (coco_m_arg e g 1) (cast i64 (GetMouseY)))))

  (func ray_p_mouse_down ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 b . 0))
          (let ((int rc42 . #'(ray_iarg e g 0 (aof b))))
            (if (!= rc42 1) (return rc42)))
          (return (ray_yes (IsMouseButtonDown (cast int b))))))

  ;;; THE EDGE, WHICH THE LEVEL READ CANNOT GIVE. `IsMouseButtonDown' is
  ;;; the button's state at the moment it is asked, and raylib refreshes
  ;;; that state once a frame inside EndDrawing -- so a click whose press
  ;;; AND release both land between two frames was never down as far as a
  ;;; program can tell. raylib keeps the previous frame's state for
  ;;; exactly this, and `IsMouseButtonPressed' is true on the one frame
  ;;; the button went down, whatever it did afterwards.
  ;;;
  ;;; It is `ray_key_pressed/1' for the mouse, and it is here for the same
  ;;; reason that one is: a tap is shorter than a frame. A macOS trackpad
  ;;; two-finger tap measures under ten milliseconds of synthetic
  ;;; button-down, which a sixty- or even a hundred-and-twenty-frame loop
  ;;; misses most times it is tried.
  (func ray_p_mouse_pressed ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 b . 0))
          (let ((int rc43 . #'(ray_iarg e g 0 (aof b))))
            (if (!= rc43 1) (return rc43)))
          (return (ray_yes (IsMouseButtonPressed (cast int b))))))

  ;;; ---- time ----
  (func ray_p_frame_time ((coco_engine * e) (size_t g)) (out int)
        (return (coco_m_unify_float e (coco_m_arg e g 0) (cast double (GetFrameTime)))))

  (func ray_p_time ((coco_engine * e) (size_t g)) (out int)
        (return (coco_m_unify_float e (coco_m_arg e g 0) (GetTime))))

  ;;; ---- the headless witness ----
  ;;; NOT raylib's TakeScreenshot, which strips the directory off the
  ;;; path and writes the basename into its own storage dir -- a test
  ;;; that names /tmp/frame.png should get /tmp/frame.png. This goes
  ;;; through LoadImageFromScreen + ExportImage, which honours the path
  ;;; AND says whether it worked, so a full disk is a goal that FAILS
  ;;; rather than a warning on a log level the caller turned off.
  (func ray_p_screenshot ((coco_engine * e) (size_t g)) (out int)
        (let ((char path [4096]))
          (if (not (coco_m_text e (coco_m_arg e g 0) path (sizeof path)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (let ((Image img . #'(LoadImageFromScreen)))
            (let ((bool ok . #'(ExportImage img path)))
              (UnloadImage img)
              (return (ray_yes ok))))))

  ;;; One pixel of the framebuffer, as four numbers. The image raylib
  ;;; reads back is the RENDER size, which a HiDPI window makes larger than
  ;;; the screen a program draws in; the coordinates here are the screen's,
  ;;; the ones `ray_rect' took, scaled to the image. Out of the window
  ;;; FAILS -- raylib would answer a blank pixel and log about it, and a
  ;;; test that asks about a pixel that is not there should hear no.
  (func ray_p_screen_pixel ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 x . 0) (i64 y . 0) (i64 sw . 0) (i64 sh . 0)
              (i64 rx . 0) (i64 ry . 0) (i64 c [4]))
          (let ((int rc44 . #'(ray_iarg e g 0 (aof x))))
            (if (!= rc44 1) (return rc44)))
          (let ((int rc45 . #'(ray_iarg e g 1 (aof y))))
            (if (!= rc45 1) (return rc45)))
          (set sw (cast i64 (GetScreenWidth)))
          (set sh (cast i64 (GetScreenHeight)))
          (if (< x 0) (return 0))
          (if (< y 0) (return 0))
          (if (>= x sw) (return 0))
          (if (>= y sh) (return 0))
          (let ((Image shot . #'(LoadImageFromScreen)))
            (set rx (/ (* x (cast i64 ($ shot width))) sw))
            (set ry (/ (* y (cast i64 ($ shot height))) sh))
            (let ((Color px . #'(GetImageColor shot (cast int rx) (cast int ry))))
              (set (nth 0 c) (cast i64 ($ px r)))
              (set (nth 1 c) (cast i64 ($ px g)))
              (set (nth 2 c) (cast i64 ($ px b)))
              (set (nth 3 c) (cast i64 ($ px a))))
            (UnloadImage shot))
          (for ((int j . 0)) (< j 4) ((++ j))
               (if (not (coco_m_unify_int e (coco_m_arg e g (+ j 2)) (nth j c)))
                   (return 0)))
          (return 1)))

  ;;; ---- textures ----
  ;;; No such file is an existence_error, the ISO shape and the common
  ;;; mistake; a file that IS there and would not decode FAILS, and raylib
  ;;; has said why on its log at whatever level the caller left it. A
  ;;; failed load answers a texture with id 0, which is nothing to unload.
  (func ray_p_texture_load ((coco_engine * e) (size_t g)) (out int)
        (let ((char path [4096]) (int s . -1))
          (if (not (coco_m_text e (coco_m_arg e g 0) path (sizeof path)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
          (if (not (FileExists path))
              (return (coco_m_existence_error e "file" (coco_m_arg e g 0))))
          (set s (ray_slot_new))
          (if (< s 0) (return 0))
          (let ((Texture2D t . #'(LoadTexture path)))
            (set (nth s ray_tex) t)
            (if (== ($ t id) 0) (return 0))
            (if (<= ($ t width) 0) (return 0))
            (if (<= ($ t height) 0) (return 0))
            (if (not (coco_m_unify_int e (coco_m_arg e g 1) (cast i64 s)))
                (block (UnloadTexture t) (return 0)))
            (set (nth s ray_tex_kind) 1)
            (return 1))))

  (func ray_p_texture_unload ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc46 . #'(ray_tex_arg e g 0 (aof s))))
            (if (!= rc46 1) (return rc46)))
          (ray_slot_free s)
          (return 1)))

  (func ray_p_texture_size ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc47 . #'(ray_tex_arg e g 0 (aof s))))
            (if (!= rc47 1) (return rc47)))
          (if (not (coco_m_unify_int e (coco_m_arg e g 1) (cast i64 ($ (nth s ray_tex) width))))
              (return 0))
          (return (coco_m_unify_int e (coco_m_arg e g 2) (cast i64 ($ (nth s ray_tex) height))))))

  ;;; The whole texture at X, Y. A canvas goes through DrawTextureRec
  ;;; with its whole extent as the source, flipped by `ray_source'.
  (func ray_p_texture ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (i64 x . 0) (i64 y . 0) (i64 c [4])
              (double sy . 0.0) (double sh . 0.0))
          (let ((int rc48 . #'(ray_tex_arg e g 0 (aof s))))
            (if (!= rc48 1) (return rc48)))
          (let ((int rc49 . #'(ray_iarg e g 1 (aof x))))
            (if (!= rc49 1) (return rc49)))
          (let ((int rc50 . #'(ray_iarg e g 2 (aof y))))
            (if (!= rc50 1) (return rc50)))
          (let ((int rc51 . #'(ray_carg e g 3 c)))
            (if (!= rc51 1) (return rc51)))
          (if (== (nth s ray_tex_kind) 1)
              (block
                (DrawTexture (nth s ray_tex) (cast int x) (cast int y) (ray_color c))
                (return 1)))
          (set sh (cast double ($ (nth s ray_tex) height)))
          (ray_source s (aof sy) (aof sh))
          (DrawTextureRec (nth s ray_tex)
                          (ray_rec 0.0 sy (cast double ($ (nth s ray_tex) width)) sh)
                          (ray_v2 (cast double x) (cast double y))
                          (ray_color c))
          (return 1)))

  ;;; Rotated and scaled. DrawTextureEx has no source rectangle to flip,
  ;;; so a canvas is drawn as raylib draws it inside: DrawTexturePro over
  ;;; the whole source, into a destination scaled by the factor.
  (func ray_p_texture_ex ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (double p [4]) (i64 c [4])
              (double w . 0.0) (double h . 0.0) (double sy . 0.0) (double sh . 0.0))
          (let ((int rc52 . #'(ray_tex_arg e g 0 (aof s))))
            (if (!= rc52 1) (return rc52)))
          (for ((int j . 0)) (< j 4) ((++ j))
               (let ((int rc53 . #'(ray_farg e g (+ j 1) (+ p j))))
                 (if (!= rc53 1) (return rc53))))
          (let ((int rc54 . #'(ray_carg e g 5 c)))
            (if (!= rc54 1) (return rc54)))
          (if (== (nth s ray_tex_kind) 1)
              (block
                (DrawTextureEx (nth s ray_tex) (ray_v2 (nth 0 p) (nth 1 p))
                               (cast float (nth 2 p)) (cast float (nth 3 p)) (ray_color c))
                (return 1)))
          (set w (cast double ($ (nth s ray_tex) width)))
          (set h (cast double ($ (nth s ray_tex) height)))
          (set sh h)
          (ray_source s (aof sy) (aof sh))
          (DrawTexturePro (nth s ray_tex)
                          (ray_rec 0.0 sy w sh)
                          (ray_rec (nth 0 p) (nth 1 p) (* w (nth 3 p)) (* h (nth 3 p)))
                          (ray_v2 0.0 0.0) (cast float (nth 2 p)) (ray_color c))
          (return 1)))

  ;;; A cell of the texture at X, Y: Src is SX SY SW SH, top-down.
  (func ray_p_sprite ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (double p [6]) (i64 c [4]))
          (let ((int rc55 . #'(ray_tex_arg e g 0 (aof s))))
            (if (!= rc55 1) (return rc55)))
          (for ((int j . 0)) (< j 6) ((++ j))
               (let ((int rc56 . #'(ray_farg e g (+ j 1) (+ p j))))
                 (if (!= rc56 1) (return rc56))))
          (let ((int rc57 . #'(ray_carg e g 7 c)))
            (if (!= rc57 1) (return rc57)))
          (ray_source s (+ p 1) (+ p 3))
          (DrawTextureRec (nth s ray_tex)
                          (ray_rec (nth 0 p) (nth 1 p) (nth 2 p) (nth 3 p))
                          (ray_v2 (nth 4 p) (nth 5 p))
                          (ray_color c))
          (return 1)))

  ;;; A cell into a destination rect, rotated about an origin: the eleven
  ;;; numbers are SX SY SW SH, DX DY DW DH, OX OY, Rotation.
  (func ray_p_sprite_ex ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (double p [11]) (i64 c [4]))
          (let ((int rc58 . #'(ray_tex_arg e g 0 (aof s))))
            (if (!= rc58 1) (return rc58)))
          (for ((int j . 0)) (< j 11) ((++ j))
               (let ((int rc59 . #'(ray_farg e g (+ j 1) (+ p j))))
                 (if (!= rc59 1) (return rc59))))
          (let ((int rc60 . #'(ray_carg e g 12 c)))
            (if (!= rc60 1) (return rc60)))
          (ray_source s (+ p 1) (+ p 3))
          (DrawTexturePro (nth s ray_tex)
                          (ray_rec (nth 0 p) (nth 1 p) (nth 2 p) (nth 3 p))
                          (ray_rec (nth 4 p) (nth 5 p) (nth 6 p) (nth 7 p))
                          (ray_v2 (nth 8 p) (nth 9 p))
                          (cast float (nth 10 p)) (ray_color c))
          (return 1)))

  (func ray_p_texture_filter ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (i64 n . 0))
          (let ((int rc61 . #'(ray_tex_arg e g 0 (aof s))))
            (if (!= rc61 1) (return rc61)))
          (let ((int rc62 . #'(ray_iarg e g 1 (aof n))))
            (if (!= rc62 1) (return rc62)))
          (SetTextureFilter (nth s ray_tex) (cast int n))
          (return 1)))

  (func ray_p_texture_wrap ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1) (i64 n . 0))
          (let ((int rc63 . #'(ray_tex_arg e g 0 (aof s))))
            (if (!= rc63 1) (return rc63)))
          (let ((int rc64 . #'(ray_iarg e g 1 (aof n))))
            (if (!= rc64 1) (return rc64)))
          (SetTextureWrap (nth s ray_tex) (cast int n))
          (return 1)))

  ;;; ---- a canvas: a texture drawn INTO, then drawn like any other ----
  (func ray_p_canvas ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 w . 0) (i64 h . 0) (int s . -1))
          (let ((int rc65 . #'(ray_iarg e g 0 (aof w))))
            (if (!= rc65 1) (return rc65)))
          (let ((int rc66 . #'(ray_iarg e g 1 (aof h))))
            (if (!= rc66 1) (return rc66)))
          (if (<= w 0) (return 0))
          (if (<= h 0) (return 0))
          (set s (ray_slot_new))
          (if (< s 0) (return 0))
          (let ((RenderTexture2D r . #'(LoadRenderTexture (cast int w) (cast int h))))
            (set (nth s ray_rt) r)
            (set (nth s ray_tex) ($ r texture))
            (if (== ($ r id) 0) (return 0))
            (if (== ($ r texture id) 0) (return 0))
            (if (not (coco_m_unify_int e (coco_m_arg e g 2) (cast i64 s)))
                (block (UnloadRenderTexture r) (return 0)))
            (set (nth s ray_tex_kind) 2)
            (return 1))))

  ;;; Only a canvas can be drawn into; a texture from a file fails here.
  (func ray_p_canvas_begin ((coco_engine * e) (size_t g)) (out int)
        (let ((int s . -1))
          (let ((int rc67 . #'(ray_tex_arg e g 0 (aof s))))
            (if (!= rc67 1) (return rc67)))
          (if (!= (nth s ray_tex_kind) 2) (return 0))
          (BeginTextureMode (nth s ray_rt))
          (return 1)))

  (func ray_p_canvas_end ((coco_engine * e) (size_t g)) (out int)
        (EndTextureMode) (return 1))

  ;;; ---- what library(clay_ray) asked for: text measured and drawn with
  ;;; a spacing of the caller's, a clip box, a rounded rect, the wheel ----
  ;;;
  ;;; `ray_text_ex' takes FLOATS where `ray_text' takes integers, because a
  ;;; layout engine answers floats and DrawTextEx takes a Vector2; and it
  ;;; takes the spacing explicitly, where DrawText decides one from the
  ;;; size (size/10), so a text measured elsewhere can be drawn to the
  ;;; width it was measured at.
  (func ray_p_text_ex ((coco_engine * e) (size_t g)) (out int)
        (let ((char text [16384]) (double v [4]) (i64 c [4]))
          (if (not (coco_m_text e (coco_m_arg e g 0) text (sizeof text)))
              (return (coco_m_type_error e "text" (coco_m_arg e g 0))))
          (for ((int j . 0)) (< j 4) ((++ j))
               (let ((int rc68 . #'(ray_farg e g (+ j 1) (+ v j))))
                 (if (!= rc68 1) (return rc68))))
          (let ((int rc69 . #'(ray_carg e g 5 c)))
            (if (!= rc69 1) (return rc69)))
          (DrawTextEx (GetFontDefault) text (ray_v2 (nth 0 v) (nth 1 v))
                      (cast float (nth 2 v)) (cast float (nth 3 v)) (ray_color c))
          (return 1)))

  ;;; MeasureText, which is what DrawText draws: the default font needs
  ;;; the window, so this answers 0 for everything before ray_open.
  (func ray_p_text_width ((coco_engine * e) (size_t g)) (out int)
        (let ((char text [16384]) (i64 size . 0))
          (if (not (coco_m_text e (coco_m_arg e g 0) text (sizeof text)))
              (return (coco_m_type_error e "text" (coco_m_arg e g 0))))
          (let ((int rc70 . #'(ray_iarg e g 1 (aof size))))
            (if (!= rc70 1) (return rc70)))
          (return (coco_m_unify_int e (coco_m_arg e g 2) (cast i64 (MeasureText text (cast int size)))))))

  (func ray_p_rect_rounded ((coco_engine * e) (size_t g)) (out int)
        (let ((double v [5]) (i64 segs . 0) (i64 c [4]))
          (for ((int j . 0)) (< j 5) ((++ j))
               (let ((int rc71 . #'(ray_farg e g j (+ v j))))
                 (if (!= rc71 1) (return rc71))))
          (let ((int rc72 . #'(ray_iarg e g 5 (aof segs))))
            (if (!= rc72 1) (return rc72)))
          (let ((int rc73 . #'(ray_carg e g 6 c)))
            (if (!= rc73 1) (return rc73)))
          (DrawRectangleRounded (ray_rec (nth 0 v) (nth 1 v) (nth 2 v) (nth 3 v))
                                (cast float (nth 4 v)) (cast int segs) (ray_color c))
          (return 1)))

  (func ray_p_scissor_begin ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 v [4]))
          (for ((int j . 0)) (< j 4) ((++ j))
               (let ((int rc74 . #'(ray_iarg e g j (+ v j))))
                 (if (!= rc74 1) (return rc74))))
          (BeginScissorMode (cast int (nth 0 v)) (cast int (nth 1 v))
                            (cast int (nth 2 v)) (cast int (nth 3 v)))
          (return 1)))

  (func ray_p_scissor_end ((coco_engine * e) (size_t g)) (out int)
        (EndScissorMode) (return 1))

  (func ray_p_mouse_wheel ((coco_engine * e) (size_t g)) (out int)
        (let ((Vector2 w . #'(GetMouseWheelMoveV)))
          (if (not (coco_m_unify_float e (coco_m_arg e g 0) (cast double ($ w x))))
              (return 0))
          (return (coco_m_unify_float e (coco_m_arg e g 1) (cast double ($ w y))))))

  (func ray_p_log_level ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 n . 0))
          (let ((int rc75 . #'(ray_iarg e g 0 (aof n))))
            (if (!= rc75 1) (return rc75)))
          (SetTraceLogLevel (cast int n))
          (return 1)))

  (static) (coco-emit-module-dispatch ray_dispatch *ray-predicates*)
  (coco-deflibrary "ray" ray_dispatch *ray-prolog*)

  ) ; source

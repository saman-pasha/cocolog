            (if (!= rc11 1) (return rc11)))
          (let ((int rc12 . #'(ray_iarg e g 1 (aof y))))
            (if (!= rc12 1) (return rc12)))
          (let ((int rc13 . #'(ray_farg e g 2 (aof rad))))
            (if (!= rc13 1) (return rc13)))
          (let ((int rc14 . #'(ray_carg e g 3 c)))
            (if (!= rc14 1) (return rc14)))
          (DrawCircle (cast int x) (cast int y) (cast float rad) (ray_color c))
          (return 1)))

  (func ray_p_line ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 v [4]) (i64 c [4]))

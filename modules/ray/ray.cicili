;;;; cocolog -- library(ray): raylib as cocolog predicates. 2D, 3D, input.
;;;;
;;;; THE GAME LOOP IS A PROLOG PREDICATE. raylib was chosen over every
;;;; other engine for one property the module seam cannot fake: the
;;;; CALLER owns the loop. Input is POLLED (`IsKeyDown'), a frame is
;;;; whatever happens between BeginDrawing and EndDrawing, and nothing in
;;;; the library ever calls back -- so a game here is
;;;;
;;;;   loop :- ray_begin, ray_clear(raywhite), draw, ray_end,
;;;;           ( ray_closing -> true ; loop ).
;;;;
;;;; with `draw' made of clauses, which is the point: the WORLD is the
;;;; knowledge base. Entities are facts, rules decide what is drawn, and
;;;; everything this family already proves about clauses -- freeze/thaw,
;;;; a shared store, deterministic replay -- applies to a game state for
;;;; free. The C tick stays in C where it belongs; what the game IS lives
;;;; in Prolog.
;;;;
;;;; THE DIVISION IS curl.cicili's, exactly. The C half is FLAT -- one
;;;; scalar per argument, `$ray_rect'(X,Y,W,H,R,G,B,A) -- because that is
;;;; what the seam passes well. The Coco half is the friendly surface:
;;;; colors are NAMES (`ray_rect(10,10,64,64, maroon)') or `rgb(R,G,B)'
;;;; or `rgba(R,G,B,A)' terms, keys are names (`ray_key_down(space)'),
;;;; and the resolvers are clauses where they read better as clauses.
;;;;
;;;; RAYLIB IS DECLARED, NOT PASTED. raylib passes small structs BY
;;;; VALUE -- every draw call takes a `Color', the 3D block a `Camera3D',
;;;; a sprite a `Rectangle' -- and for a long time this file said that
;;;; describing those structs to Cicili would emit a second definition
;;;; beside raylib.h's, and carried forty-odd one-line C wrappers in
;;;; `(code "...")' to build them at the call site. That was wrong, and
;;;; the owner said so: a `(decl) (struct ...)' in a BINDING emits
;;;; nothing and only teaches inference the shape, which is exactly how
;;;; lib/std/c declares `sockaddr_in' and lib/net/curl.cicili declares
;;;; libcurl. `./binding.cicili' is that file for raylib -- the ten value
;;;; types and every entry point this module reaches, offered to the
;;;; Cicili tree as a `lib/c/raylib.cicili' -- and the C half below is
;;;; Cicili throughout: a Color is `(ray_color c)', a camera is a
;;;; `Camera3D' local set field by field, and raylib is called by name
;;;; with the compiler checking every call against raylib.h. There is no
;;;; `(code ...)' left in this file.
;;;;
;;;; HEADLESS IS A FIRST-CLASS ARRANGEMENT, because the suite runs where
;;;; there is no screen: `ray_screenshot/1' writes the framebuffer to a
;;;; PNG, and `ray_screen_pixel/6' reads one pixel of it back as numbers,
;;;; so under Xvfb a test can draw a frame and then LOOK AT IT --
;;;; test/ray.pl checks pixels, not exit codes.
;;;;
;;;; A TEXTURE IS A HANDLE, the shape library(tcp) gives a socket: an
;;;; index into a table this module owns, never raylib's GL name. The
;;;; table remembers what KIND each slot is -- a texture loaded from a
;;;; file, or a CANVAS (raylib's RenderTexture: a texture you draw INTO,
;;;; between `ray_canvas_begin' and `ray_canvas_end') -- because a canvas
;;;; is a framebuffer and a framebuffer's row 0 is the BOTTOM of what was
;;;; drawn, so read through a texture it is upside down. That is raylib's
;;;; best-known FAQ, and the answer everywhere else is a negative source
;;;; height at every draw; here the kind decides, in `ray_source', and a
;;;; canvas draws like any texture. A SPRITE is a rectangle of a texture
;;;; -- `rect(X, Y, W, H)', top-down like everything 2D -- which is what an
;;;; atlas is: one PNG of tiles, one fact per tile naming its cell. An
;;;; integer this module did not hand out is not a texture and the call
;;;; FAILS, which is the difference between a failed goal and a draw from
;;;; a stale GL name. `ray_close/0' forgets every slot, because the GL
;;;; context that owned them goes with the window.
;;;;
;;;; WHAT IS NOT HERE YET, honestly: models from files, sound, gamepads,
;;;; shaders. The surface below is the loop, 2D shapes
;;;; and text, textures and a canvas, a 3D camera with primitives,
;;;; keyboard and mouse -- enough to write a real game as clauses, and
;;;; each absence is a predicate away rather than a redesign.
;;;;
;;;; ---- the surface -------------------------------------------------------
;;;;
;;;; A Color is a palette name, rgb(R,G,B) or rgba(R,G,B,A); a Key is a name
;;;; (space, escape, left, ...) or a letter or digit standing for itself; a
;;;; coordinate takes an integer, or a float where raylib takes one.
;;;;
;;;;   ray_open(+Width, +Height, +Title)                  InitWindow; fails if no window came
;;;;   ray_close/0
;;;;   ray_closing/0                                      WindowShouldClose: the loop's exit
;;;;   ray_ready/0
;;;;   ray_screen_size(-W, -H)                            GetScreenWidth/Height: the window's, in the units ray_rect draws in
;;;;   ray_fps(+Target)                                   SetTargetFPS
;;;;   ray_begin/0                                        a frame is what happens between
;;;;   ray_end/0                                          ... these two
;;;;   ray_clear(+Color)
;;;;   ray_rect(+X, +Y, +W, +H, +Color)
;;;;   ray_circle(+X, +Y, +Radius, +Color)
;;;;   ray_line(+X1, +Y1, +X2, +Y2, +Color)
;;;;   ray_pixel(+X, +Y, +Color)
;;;;   ray_poly(+X, +Y, +Sides, +Radius, +Rotation, +Color)        regular, filled
;;;;   ray_poly_lines(+X, +Y, +Sides, +Radius, +Rotation, +Color)  its outline
;;;;   ray_text(+Text, +X, +Y, +Size, +Color)
;;;;   ray_text_ex(+Text, +X, +Y, +Size, +Spacing, +Color)     DrawTextEx: the default font, floats, a spacing you choose
;;;;   ray_text_width(+Text, +Size, -Width)               MeasureText, as ray_text draws it; after ray_open
;;;;   ray_rect_rounded(+X, +Y, +W, +H, +Roundness, +Segments, +Color)   DrawRectangleRounded: Roundness 0..1 of the short side
;;;;   ray_scissor_begin(+X, +Y, +W, +H)                 clip every draw to this box ...
;;;;   ray_scissor_end/0                                  ... until here
;;;;   ray_draw_fps(+X, +Y)
;;;;   ray_begin3d(+PX, +PY, +PZ, +TX, +TY, +TZ, +Fov)    a camera at P looking at T
;;;;   ray_end3d/0
;;;;   ray_cube(+X, +Y, +Z, +W, +H, +L, +Color)
;;;;   ray_cube_wires(+X, +Y, +Z, +W, +H, +L, +Color)
;;;;   ray_sphere(+X, +Y, +Z, +Radius, +Color)
;;;;   ray_grid(+Slices, +Spacing)
;;;;   ray_key_down(+Key)                                 held, polled
;;;;   ray_key_pressed(+Key)                              this frame only
;;;;   ray_mouse(-X, -Y)
;;;;   ray_mouse_down(+Button)                            left, right, middle -- HELD, level
;;;;   ray_mouse_pressed(+Button)                         went down THIS frame -- edge
;;;;   ray_mouse_wheel(-X, -Y)                            GetMouseWheelMoveV: this frame's notches, floats
;;;;   ray_frame_time(-Seconds)                           the last frame's
;;;;   ray_time(-Seconds)                                 since the window opened
;;;;   ray_screenshot(+Path)                              the framebuffer as a PNG, at that path
;;;;   ray_screen_pixel(+X, +Y, -R, -G, -B, -A)            one pixel of the framebuffer, read back
;;;;   ray_texture_load(+Path, -Tex)                      LoadTexture: a handle; existence_error for no such file, fails if it would not decode
;;;;   ray_texture_unload(+Tex)                           the GPU memory and the slot; a canvas too
;;;;   ray_texture_size(+Tex, -W, -H)
;;;;   ray_texture(+Tex, +X, +Y)                          DrawTexture, untinted
;;;;   ray_texture(+Tex, +X, +Y, +Tint)                   ... tinted: white is as loaded
;;;;   ray_texture_ex(+Tex, +X, +Y, +Rotation, +Scale, +Tint)     DrawTextureEx: degrees, and a factor
;;;;   ray_sprite(+Tex, +Source, +X, +Y)                  DrawTextureRec: Source is rect(SX, SY, SW, SH), a cell of an atlas
;;;;   ray_sprite(+Tex, +Source, +X, +Y, +Tint)
;;;;   ray_sprite_ex(+Tex, +Source, +Dest, +OX, +OY, +Rotation, +Tint)  DrawTexturePro: into a rect/4, rotated about the origin
;;;;   ray_texture_filter(+Tex, +Filter)                  point bilinear trilinear anisotropic_4x anisotropic_8x anisotropic_16x
;;;;   ray_texture_wrap(+Tex, +Wrap)                      repeat clamp mirror_repeat mirror_clamp
;;;;   ray_canvas(+W, +H, -Tex)                           LoadRenderTexture: a texture you draw INTO ...
;;;;   ray_canvas_begin(+Tex)                             ... between these two, and then draw like any texture
;;;;   ray_canvas_end/0
;;;;   ray_log_level(+Level)                              all trace debug info warning error fatal none
;;;;   ray_color(?Name, ?R, ?G, ?B)                       the palette, as facts a program can query
;;;;   ray_rgba(+Color, -R, -G, -B, -A)                   a color spec resolved
;;;;   ray_key(?Name, ?Code)                              the key table
;;;;   ray_keycode(+Key, -Code)                           a name, a letter, or a code as itself
;;;;   ray_button(?Name, ?Code)
;;;;   ray_level(?Name, ?Code)
;;;;   ray_filter(?Name, ?Code)                           the texture filter table
;;;;   ray_wrap(?Name, ?Code)                             and the wrap table

(DEFPARAMETER *ray-predicates*
  '(("ray_open"        3 ray_p_open)
    ("ray_close"       0 ray_p_close)
    ("ray_closing"     0 ray_p_closing)
    ("ray_ready"       0 ray_p_ready)
    ("ray_screen_size" 2 ray_p_screen_size)
    ("ray_fps"         1 ray_p_fps)
    ("ray_begin"       0 ray_p_begin)
    ("ray_end"         0 ray_p_end)
    ("$ray_clear"      4 ray_p_clear)
    ("$ray_rect"       8 ray_p_rect)
    ("$ray_circle"     7 ray_p_circle)
    ("$ray_line"       8 ray_p_line)
    ("$ray_pixel"      6 ray_p_pixel)
    ("$ray_poly"       9 ray_p_poly)
    ("$ray_poly_lines" 9 ray_p_poly_lines)
    ("$ray_text"       8 ray_p_text)
    ("$ray_text_ex"    9 ray_p_text_ex)
    ("ray_text_width"  3 ray_p_text_width)
    ("$ray_rect_rounded" 10 ray_p_rect_rounded)
    ("ray_scissor_begin" 4 ray_p_scissor_begin)
    ("ray_scissor_end"   0 ray_p_scissor_end)
    ("ray_draw_fps"    2 ray_p_draw_fps)
    ("ray_begin3d"     7 ray_p_begin3d)
    ("ray_end3d"       0 ray_p_end3d)
    ("$ray_cube"      10 ray_p_cube)
    ("$ray_cube_wires" 10 ray_p_cube_wires)
    ("$ray_sphere"     8 ray_p_sphere)
    ("ray_grid"        2 ray_p_grid)
    ("$ray_key_down"    1 ray_p_key_down)
    ("$ray_key_pressed" 1 ray_p_key_pressed)
    ("ray_mouse"       2 ray_p_mouse)
    ("ray_mouse_wheel" 2 ray_p_mouse_wheel)
    ("$ray_mouse_down" 1 ray_p_mouse_down)
    ("$ray_mouse_pressed" 1 ray_p_mouse_pressed)
    ("ray_frame_time"  1 ray_p_frame_time)
    ("ray_time"        1 ray_p_time)
    ("ray_screenshot"  1 ray_p_screenshot)
    ("ray_screen_pixel" 6 ray_p_screen_pixel)
    ("ray_texture_load"   2 ray_p_texture_load)
    ("ray_texture_unload" 1 ray_p_texture_unload)
    ("ray_texture_size"   3 ray_p_texture_size)
    ("$ray_texture"       7 ray_p_texture)
    ("$ray_texture_ex"    9 ray_p_texture_ex)
    ("$ray_sprite"       11 ray_p_sprite)
    ("$ray_sprite_ex"    16 ray_p_sprite_ex)
    ("$ray_texture_filter" 2 ray_p_texture_filter)
    ("$ray_texture_wrap"   2 ray_p_texture_wrap)
    ("ray_canvas"         3 ray_p_canvas)
    ("ray_canvas_begin"   1 ray_p_canvas_begin)
    ("ray_canvas_end"     0 ray_p_canvas_end)
    ("$ray_log_level"  1 ray_p_log_level)))

;;;; ------------------------------------------------------------------
;;;; The Coco half: names for what C wants as numbers
;;;; ------------------------------------------------------------------
;;; A Cicili string literal cannot carry a newline, so clauses are joined
;;; with spaces; commentary lives out here.
;;;
;;; THE COLOR TABLE IS raylib's OWN PALETTE, name for name and byte for
;;; byte -- raylib.h's LIGHTGRAY..RAYWHITE defines, which a `#define' is
;;; invisible to Cicili and would be invisible to Prolog too. Written
;;; once, here, as facts a program can also QUERY -- `ray_color(N,R,G,B)'
;;; enumerates the palette, which no #define can.
(DEFPARAMETER *ray-prolog*
  (FORMAT NIL "~{~A ~}"
          (LIST
           ;; ---- the palette, raylib.h byte for byte ----
           "ray_color(lightgray, 200, 200, 200)."
           "ray_color(gray, 130, 130, 130)."
           "ray_color(darkgray, 80, 80, 80)."
           "ray_color(yellow, 253, 249, 0)."
           "ray_color(gold, 255, 203, 0)."
           "ray_color(orange, 255, 161, 0)."
           "ray_color(pink, 255, 109, 194)."
           "ray_color(red, 230, 41, 55)."
           "ray_color(maroon, 190, 33, 55)."
           "ray_color(green, 0, 228, 48)."
           "ray_color(lime, 0, 158, 47)."
           "ray_color(darkgreen, 0, 117, 44)."
           "ray_color(skyblue, 102, 191, 255)."
           "ray_color(blue, 0, 121, 241)."
           "ray_color(darkblue, 0, 82, 172)."
           "ray_color(purple, 200, 122, 255)."
           "ray_color(violet, 135, 60, 190)."
           "ray_color(darkpurple, 112, 31, 126)."
           "ray_color(beige, 211, 176, 131)."
           "ray_color(brown, 127, 106, 79)."
           "ray_color(darkbrown, 76, 63, 47)."
           "ray_color(white, 255, 255, 255)."
           "ray_color(black, 0, 0, 0)."
           "ray_color(magenta, 255, 0, 255)."
           "ray_color(raywhite, 245, 245, 245)."

           ;; ---- a color SPEC is a name, rgb/3 or rgba/4 ----
           "ray_rgba(rgba(R, G, B, A), R, G, B, A) :- !."
           "ray_rgba(rgb(R, G, B), R, G, B, 255) :- !."
           "ray_rgba(Name, R, G, B, 255) :- ray_color(Name, R, G, B), !."

           ;; ---- the friendly drawing surface over the flat C half ----
           "ray_clear(C) :- ray_rgba(C, R, G, B, A), '$ray_clear'(R, G, B, A)."
           "ray_rect(X, Y, W, H, C) :- ray_rgba(C, R, G, B, A), '$ray_rect'(X, Y, W, H, R, G, B, A)."
           "ray_circle(X, Y, Rad, C) :- ray_rgba(C, R, G, B, A), '$ray_circle'(X, Y, Rad, R, G, B, A)."
           "ray_line(X1, Y1, X2, Y2, C) :- ray_rgba(C, R, G, B, A), '$ray_line'(X1, Y1, X2, Y2, R, G, B, A)."
           "ray_pixel(X, Y, C) :- ray_rgba(C, R, G, B, A), '$ray_pixel'(X, Y, R, G, B, A)."
           ;; A regular polygon at a center: six sides and rotation 30 is
           ;; a pointy-top hex on library(hex)'s pixel centers.
           "ray_poly(X, Y, Sides, Radius, Rot, C) :- ray_rgba(C, R, G, B, A), '$ray_poly'(X, Y, Sides, Radius, Rot, R, G, B, A)."
           "ray_poly_lines(X, Y, Sides, Radius, Rot, C) :- ray_rgba(C, R, G, B, A), '$ray_poly_lines'(X, Y, Sides, Radius, Rot, R, G, B, A)."
           "ray_text(T, X, Y, Size, C) :- ray_rgba(C, R, G, B, A), '$ray_text'(T, X, Y, Size, R, G, B, A)."
           "ray_text_ex(T, X, Y, Size, Sp, C) :- ray_rgba(C, R, G, B, A), '$ray_text_ex'(T, X, Y, Size, Sp, R, G, B, A)."
           "ray_rect_rounded(X, Y, W, H, Rd, Segs, C) :- ray_rgba(C, R, G, B, A), '$ray_rect_rounded'(X, Y, W, H, Rd, Segs, R, G, B, A)."
           "ray_cube(X, Y, Z, W, H, L, C) :- ray_rgba(C, R, G, B, A), '$ray_cube'(X, Y, Z, W, H, L, R, G, B, A)."
           "ray_cube_wires(X, Y, Z, W, H, L, C) :- ray_rgba(C, R, G, B, A), '$ray_cube_wires'(X, Y, Z, W, H, L, R, G, B, A)."
           "ray_sphere(X, Y, Z, Rad, C) :- ray_rgba(C, R, G, B, A), '$ray_sphere'(X, Y, Z, Rad, R, G, B, A)."

           ;; ---- textures: a tint is a color spec, a sprite is a rect/4 ----
           ;; Untinted means WHITE, which is raylib's own idiom: the tint
           ;; multiplies, and white leaves the pixels as loaded.
           "ray_texture(T, X, Y) :- ray_texture(T, X, Y, white)."
           "ray_texture(T, X, Y, C) :- ray_rgba(C, R, G, B, A), '$ray_texture'(T, X, Y, R, G, B, A)."
           "ray_texture_ex(T, X, Y, Rot, Scale, C) :- ray_rgba(C, R, G, B, A), '$ray_texture_ex'(T, X, Y, Rot, Scale, R, G, B, A)."
           "ray_sprite(T, Src, X, Y) :- ray_sprite(T, Src, X, Y, white)."
           "ray_sprite(T, rect(SX, SY, SW, SH), X, Y, C) :- ray_rgba(C, R, G, B, A), '$ray_sprite'(T, SX, SY, SW, SH, X, Y, R, G, B, A)."
           "ray_sprite_ex(T, rect(SX, SY, SW, SH), rect(DX, DY, DW, DH), OX, OY, Rot, C) :- ray_rgba(C, R, G, B, A), '$ray_sprite_ex'(T, SX, SY, SW, SH, DX, DY, DW, DH, OX, OY, Rot, R, G, B, A)."
           ;; raylib.h's TextureFilter and TextureWrap enums, in order
           "ray_filter(point, 0). ray_filter(bilinear, 1). ray_filter(trilinear, 2)."
           "ray_filter(anisotropic_4x, 3). ray_filter(anisotropic_8x, 4). ray_filter(anisotropic_16x, 5)."
           "ray_texture_filter(T, F) :- ray_filter(F, N), '$ray_texture_filter'(T, N)."
           "ray_wrap(repeat, 0). ray_wrap(clamp, 1). ray_wrap(mirror_repeat, 2). ray_wrap(mirror_clamp, 3)."
           "ray_texture_wrap(T, W) :- ray_wrap(W, N), '$ray_texture_wrap'(T, N)."

           ;; ---- keys are names; raylib's codes stay in one table ----
           "ray_key(space, 32).  ray_key(apostrophe, 39). ray_key(comma, 44)."
           "ray_key(minus, 45).  ray_key(period, 46).     ray_key(slash, 47)."
           "ray_key(semicolon, 59). ray_key(equal, 61)."
           "ray_key(escape, 256). ray_key(enter, 257). ray_key(tab, 258)."
           "ray_key(backspace, 259). ray_key(insert, 260). ray_key(delete, 261)."
           "ray_key(right, 262). ray_key(left, 263). ray_key(down, 264). ray_key(up, 265)."
           "ray_key(page_up, 266). ray_key(page_down, 267). ray_key(home, 268). ray_key(end, 269)."
           "ray_key(left_shift, 340). ray_key(left_control, 341). ray_key(left_alt, 342)."
           "ray_key(right_shift, 344). ray_key(right_control, 345). ray_key(right_alt, 346)."
           ;; a single letter or digit is its own name: `a' is KEY_A.
           "ray_keycode(K, K) :- integer(K), !."
           "ray_keycode(K, C) :- ray_key(K, C), !."
           "ray_keycode(K, C) :- atom_codes(K, [X]), ( X >= 0'a, X =< 0'z -> C is X - 32 ; C = X )."
           "ray_key_down(K) :- ray_keycode(K, C), '$ray_key_down'(C)."
           "ray_key_pressed(K) :- ray_keycode(K, C), '$ray_key_pressed'(C)."

           ;; ---- mouse buttons and log levels, same shape ----
           "ray_button(left, 0). ray_button(right, 1). ray_button(middle, 2)."
           "ray_mouse_down(B) :- ray_button(B, C), '$ray_mouse_down'(C)."
           "ray_mouse_pressed(B) :- ray_button(B, C), '$ray_mouse_pressed'(C)."
           "ray_level(all, 0). ray_level(trace, 1). ray_level(debug, 2). ray_level(info, 3)."
           "ray_level(warning, 4). ray_level(error, 5). ray_level(fatal, 6). ray_level(none, 7)."
           "ray_log_level(L) :- ray_level(L, N), '$ray_log_level'(N).")))

;;;; ------------------------------------------------------------------
;;;; The C half
;;;; ------------------------------------------------------------------
(source "ray.c"
  (make :std #t :compile #f)

  (include <raylib.h>)

  ;;; raylib's types and entry points, declared to Cicili in
  ;;; ./binding.cicili: a Color, a Vector2, a Camera3D and a Texture2D
  ;;; are values here, built with `$' and passed by value exactly as
  ;;; raylib.h takes them. The binding EMITS nothing -- raylib.h stays
  ;;; the one definition -- and the compiler checks every call against
  ;;; the real prototypes.
  (import "./binding.cicili")
  (import "./sdk.cicili")
  (coco-sdk)

  ;;; ---- argument helpers, so the predicates stay one line per arg ----
  ;;;
  ;;; AND THE CALLER MUST PASS WHAT THESE ANSWER STRAIGHT THROUGH, because
  ;;; a raise is not a failure. `coco_m_type_error' answers **2** -- the
  ;;; builtin protocol's "the continuation is already set", the recovery
  ;;; goal being on it -- and every guard here used to read that as
  ;;; `(if (not ...) (return 0))'. `not 2' is FALSE, so the guard did not
  ;;; fire: the predicate carried on with an uninitialised coordinate and
  ;;; then answered 1, success, with a ball in flight and the engine about
  ;;; to put the caller's continuation back over the recovery. Reported
  ;;; from CivV, where `ray_circle(20.5, 20.5, 5.5, white)' -- an icon's
  ;;; centre computed as `X + Size * 0.64' -- ENDED THE PROCESS rather
  ;;; than raising something `catch/3' could hold. The shape is
  ;;; `(let ((int rc . #'(ray_iarg ...))) (if (!= rc 1) (return rc)))',
  ;;; which carries 0 as a failure, 2 as a ball and -1 as an error, and
  ;;; is what every guard here says.
  ;;;
  ;;; An integer argument, or a type error that names the culprit.
  (static)
  (func ray_iarg ((coco_engine * e) (size_t g) (int i) (i64 * v)) (out int)
        (if (coco_m_int e (coco_m_arg e g (cast size_t i)) v) (return 1))
        (return (coco_m_type_error e "integer" (coco_m_arg e g (cast size_t i)))))

  ;;; A number: an integer is welcome where a coordinate is a float.
  (static)
  (func ray_farg ((coco_engine * e) (size_t g) (int i) (double * v)) (out int)
        (let ((i64 n . 0))
          (if (coco_m_int e (coco_m_arg e g (cast size_t i)) (aof n))
              (block (set (cof v) (cast double n)) (return 1)))
          (if (coco_m_float e (coco_m_arg e g (cast size_t i)) v) (return 1))
          (return (coco_m_type_error e "number" (coco_m_arg e g (cast size_t i))))))

  ;;; Four integers from argument FROM on: a color's R, G, B and A, which
  ;;; the Coco half resolved from a name or an rgb/rgba term.
  (static)
  (func ray_carg ((coco_engine * e) (size_t g) (int from) (i64 * c)) (out int)
        (for ((int j . 0)) (< j 4) ((++ j))
             (let ((int rc . #'(ray_iarg e g (+ from j) (+ c j))))
               (if (!= rc 1) (return rc))))
        (return 1))

  ;;; raylib answers a C bool where the seam wants 1 or 0.
  (static)
  (func ray_yes ((bool b)) (out int)
        (if b (return 1))
        (return 0))

  ;;; ---- raylib's value types, built as values ----
  ;;;
  ;;; Every draw call takes a Color BY VALUE, the 3D block a Camera3D, a
  ;;; sprite a Rectangle and a Vector2. Four bytes make a color; a
  ;;; program's integers are narrowed here and nowhere else.
  (static)
  (func ray_color ((i64 * c)) (out Color)
        (let ((Color r . '{ 0 }))
          (set ($ r r) (cast u8 (nth 0 c)))
          (set ($ r g) (cast u8 (nth 1 c)))
          (set ($ r b) (cast u8 (nth 2 c)))
          (set ($ r a) (cast u8 (nth 3 c)))
          (return r)))

  (static)
  (func ray_v2 ((double x) (double y)) (out Vector2)
        (let ((Vector2 r . '{ 0 }))
          (set ($ r x) (cast float x))
          (set ($ r y) (cast float y))
          (return r)))

  (static)
  (func ray_v3 ((double x) (double y) (double z)) (out Vector3)
        (let ((Vector3 r . '{ 0 }))
          (set ($ r x) (cast float x))
          (set ($ r y) (cast float y))
          (set ($ r z) (cast float z))
          (return r)))

  (static)
  (func ray_rec ((double x) (double y) (double w) (double h)) (out Rectangle)
        (let ((Rectangle r . '{ 0 }))
          (set ($ r x) (cast float x))
          (set ($ r y) (cast float y))
          (set ($ r width) (cast float w))
          (set ($ r height) (cast float h))
          (return r)))

  ;;; ---- the texture table: a handle is a slot, and the slot knows its kind ----
  ;;; 0 is free, 1 a texture from a file, 2 a canvas. Zero as "free" is
  ;;; right here where tcp's table needed -1: a slot is not a descriptor,
  ;;; and a static array of zeros is a table with nothing in it. A canvas
  ;;; keeps its RenderTexture in `ray_rt' AND its texture in `ray_tex',
  ;;; so every draw reads one table whatever the kind.
  (static) (var int ray_tex_kind [256])
  (static) (var Texture2D ray_tex [256])
  (static) (var RenderTexture2D ray_rt [256])

  (static)
  (func ray_slot_new () (out int)
        (for ((int i . 0)) (< i 256) ((++ i))
             (if (== (nth i ray_tex_kind) 0) (return i)))
        (return -1))

  ;;; Free a slot whatever it holds; a free one is left alone.
  (static)
  (func ray_slot_free ((int s)) (out void)
        (if (== (nth s ray_tex_kind) 1) (UnloadTexture (nth s ray_tex)))
        (if (== (nth s ray_tex_kind) 2) (UnloadRenderTexture (nth s ray_rt)))
        (set (nth s ray_tex_kind) 0))

  ;;; The lookup every texture predicate goes through: argument I as a
  ;;; handle THIS MODULE handed out, or 0. An out-of-range integer and a
  ;;; free slot both fail the call rather than reaching a GL name.
  (static)
  (func ray_tex_arg ((coco_engine * e) (size_t g) (int i) (int * slot)) (out int)
        (let ((i64 v . 0))
          (let ((int rc1 . #'(ray_iarg e g i (aof v))))
            (if (!= rc1 1) (return rc1)))
          (if (< v 0) (return 0))
          (if (>= v 256) (return 0))
          (if (== (nth v ray_tex_kind) 0) (return 0))
          (set (cof slot) (cast int v))
          (return 1)))

  ;;; A CANVAS IS A FRAMEBUFFER, AND A FRAMEBUFFER'S ROW 0 IS THE BOTTOM of
  ;;; what was drawn into it -- so read through a texture it is upside
  ;;; down. raylib's spelling of the flip is a NEGATIVE source height,
  ;;; with the source's y moved to where the region's top row sits counted
  ;;; from the bottom. This turns a caller's top-down rect into that when
  ;;; the slot is a canvas, and leaves a texture's alone; the caller never
  ;;; sees the difference, which is the point of the kind being in the
  ;;; table rather than in every draw call a program writes.
  (static)
  (func ray_source ((int s) (double * sy) (double * sh)) (out void)
        (if (== (nth s ray_tex_kind) 2)
            (block
              (set (cof sy) (- (- (cast double ($ (nth s ray_tex) height)) (cof sy)) (cof sh)))
              (set (cof sh) (- 0.0 (cof sh))))))

  ;;; ---- the window and the frame ----
  (func ray_p_open ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 w . 0) (i64 h . 0) (char title [512]))
          (let ((int rc2 . #'(ray_iarg e g 0 (aof w))))
            (if (!= rc2 1) (return rc2)))
          (let ((int rc3 . #'(ray_iarg e g 1 (aof h))))
            (if (!= rc3 1) (return rc3)))
          (if (not (coco_m_text e (coco_m_arg e g 2) title (sizeof title)))
              (return (coco_m_type_error e "atom" (coco_m_arg e g 2))))
          (InitWindow (cast int w) (cast int h) title)
          (return (ray_yes (IsWindowReady)))))

  ;;; The GL context goes with the window, and every texture with it: the
  ;;; slots are freed FIRST, while unloading is still a thing that can be
  ;;; done, and a handle from a closed window is not a handle any more.
  (func ray_p_close ((coco_engine * e) (size_t g)) (out int)
        (for ((int i . 0)) (< i 256) ((++ i)) (ray_slot_free i))
        (CloseWindow) (return 1))

  (func ray_p_closing ((coco_engine * e) (size_t g)) (out int)
        (return (ray_yes (WindowShouldClose))))

  (func ray_p_ready ((coco_engine * e) (size_t g)) (out int)
        (return (ray_yes (IsWindowReady))))

  ;;; The window's size in the coordinates a program draws in -- what a
  ;;; layout wants before it lays out the frame. A HiDPI render is larger
  ;;; and is `ray_screen_pixel''s business, not this one's.
  (func ray_p_screen_size ((coco_engine * e) (size_t g)) (out int)
        (if (not (coco_m_unify_int e (coco_m_arg e g 0) (cast i64 (GetScreenWidth))))
            (return 0))
        (return (coco_m_unify_int e (coco_m_arg e g 1) (cast i64 (GetScreenHeight)))))

  (func ray_p_fps ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 n . 0))
          (let ((int rc4 . #'(ray_iarg e g 0 (aof n))))
            (if (!= rc4 1) (return rc4)))
          (SetTargetFPS (cast int n))
          (return 1)))

  (func ray_p_begin ((coco_engine * e) (size_t g)) (out int)
        (BeginDrawing) (return 1))

  (func ray_p_end ((coco_engine * e) (size_t g)) (out int)
        (EndDrawing) (return 1))

  (func ray_p_clear ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 c [4]))
          (let ((int rc5 . #'(ray_carg e g 0 c)))
            (if (!= rc5 1) (return rc5)))
          (ClearBackground (ray_color c))
          (return 1)))

  ;;; ---- 2D ----
  (func ray_p_rect ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 v [4]) (i64 c [4]))
          (for ((int j . 0)) (< j 4) ((++ j))
               (let ((int rc9 . #'(ray_iarg e g j (+ v j))))
                 (if (!= rc9 1) (return rc9))))
          (let ((int rc10 . #'(ray_carg e g 4 c)))
            (if (!= rc10 1) (return rc10)))
          (DrawRectangle (cast int (nth 0 v)) (cast int (nth 1 v))
                         (cast int (nth 2 v)) (cast int (nth 3 v))
                         (ray_color c))
          (return 1)))

  (func ray_p_circle ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 x . 0) (i64 y . 0) (double rad . 0.0) (i64 c [4]))

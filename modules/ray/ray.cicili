          (return 1)))

  (func ray_p_pixel ((coco_engine * e) (size_t g)) (out int)
        (let ((i64 x . 0) (i64 y . 0) (i64 c [4]))
          (let ((int rc17 . #'(ray_iarg e g 0 (aof x))))
            (if (!= rc17 1) (return rc17)))
          (let ((int rc18 . #'(ray_iarg e g 1 (aof y))))
            (if (!= rc18 1) (return rc18)))
          (let ((int rc19 . #'(ray_carg e g 2 c)))
            (if (!= rc19 1) (return rc19)))

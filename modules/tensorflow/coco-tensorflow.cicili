;;;; coco-tensorflow.cicili -- library(tensorflow): the tensor_* predicates over
;;;; TensorFlow's C library, as a second BACKEND behind library(torch)'s switch.
;;;;
;;;;   use_module(library(torch)).          % first: it owns the predicates and the switch
;;;;   use_module(library(tensorflow)).     % Linux; registers itself with the torch module
;;;;   tensor_execution(tensorflow, graph). % from here every tensor_* call is TensorFlow's
;;;;
;;;; THE FRONT END IS THIS FILE: the dispatcher the torch module hands calls to,
;;;; the arguments read out of the engine and the answers put back. THE BACK END
;;;; IS backend.c: TensorFlow's C API, wrapped once, in C, as the operations
;;;; below ask for -- eager ops, executed now, under tensor_execution(tensorflow,
;;;; eager), recorded nodes under (tensorflow, graph); and under both a read
;;;; or a gradient compiles the closure it needs, once, into a TensorFlow
;;;; function the eager runtime calls, with tensor_grad/3 as TF_AddGradients
;;;; inside it -- TensorFlow's own symbolic differentiation, on either path.
;;;;
;;;; What this module registers as ITS OWN predicates is only what names the
;;;; library: tensorflow_version/1 and tensorflow_seed/1. The tensor_* names
;;;; stay the torch module's, which forwards them here while the backend is
;;;; selected -- one surface, two implementations, and never both at once.
;;;;
;;;; Linux only, by design: it is built by build.sh against the pip tensorflow
;;;; package's C library, and the script says so elsewhere.

(source "coco-tensorflow.c"
  (make :compile #f)
  (include <stdio.h>)
  (include <stdint.h>)
  (include <string.h>)
  (include <stdlib.h>)
  (include <stdbool.h>)

  ;; ---- the slice of cocolog this module is written against ----------
  (decl) (struct coco_engine)
  (decl) (struct coco_machine)
  (decl) (func coco_module_register ((const char * name)
                                     (func dispatch ((coco_engine * e) (const char * nm)
                                                     (uint32_t arity) (size_t g)
                                                     (int * found)) (out int))
                                     (const char * prolog)
                                     (func init ((coco_engine * e)) (out int))) (out int))
  (decl) (func coco_m_arg ((coco_engine * e) (size_t g) (uint32_t i)) (out size_t))
  (decl) (func coco_m_machine ((coco_engine * e)) (out coco_machine *))
  (decl) (func coco_m_is_atom ((coco_engine * e) (size_t t)) (out int))
  (decl) (func coco_m_atom ((coco_engine * e) (size_t t)) (out const char *))
  (decl) (func coco_m_int ((coco_engine * e) (size_t t) (int64_t * out)) (out int))
  (decl) (func coco_m_float ((coco_engine * e) (size_t t) (double * out)) (out int))
  (decl) (func coco_m_text ((coco_engine * e) (size_t t) (char * buf) (size_t cap)) (out int))
  (decl) (func coco_m_unify ((coco_engine * e) (size_t a) (size_t b)) (out int))
  (decl) (func coco_m_unify_int ((coco_engine * e) (size_t t) (int64_t v)) (out int))
  (decl) (func coco_m_unify_float ((coco_engine * e) (size_t t) (double v)) (out int))
  (decl) (func coco_m_list ((coco_engine * e) (const size_t * cells) (size_t n)) (out size_t))
  (decl) (func coco_m_list_array ((coco_engine * e) (size_t t) (size_t ** cells) (size_t * n)) (out int))
  (decl) (func coco_m_type_error ((coco_engine * e) (const char * what) (size_t t)) (out int))
  (decl) (func coco_m_domain_error ((coco_engine * e) (const char * what) (size_t t)) (out int))
  (decl) (func coco_deref ((coco_machine * m) (size_t t)) (out size_t))
  (decl) (func coco_new_float ((coco_machine * m) (double v)) (out size_t))
  (decl) (func coco_new_int ((coco_machine * m) (int64_t v)) (out size_t))
  (decl) (func coco_new_atom ((coco_machine * m) (const char * name)) (out size_t))
  (decl) (func coco_make1 ((coco_machine * m) (const char * name) (size_t a)) (out size_t))
  (decl) (func coco_make ((coco_machine * m) (const char * name) (uint32_t n) (const size_t * args)) (out size_t))

  ;; ---- the back end, backend.c -----------------------------------------
  (decl) (func tfb_attach ((func fn ((coco_engine * e) (const char * nm) (uint32_t arity) (size_t g) (int * found)) (out int))) (out int))
  (decl) (func tfb_error () (out const char *))
  (decl) (func tfb_version () (out const char *))
  (decl) (func tfb_device_set ((int kind)) (out int))
  (decl) (func tfb_on_gpu () (out int))
  (decl) (func tfb_seed ((int64_t s)) (out void))
  (decl) (func tfb_mode () (out int))
  (decl) (func tfb_exists ((int64_t h)) (out int))
  (decl) (func tfb_free ((int64_t h)) (out int))
  (decl) (func tfb_force ((int64_t h)) (out int))
  (decl) (func tfb_from_doubles ((const double * data) (const int64_t * shape) (int nd)) (out int64_t))
  (decl) (func tfb_from_ints ((const int64_t * data) (int64_t n)) (out int64_t))
  (decl) (func tfb_values ((int64_t h) (int64_t * n) (int64_t * shape) (int * nd)) (out double *))
  (decl) (func tfb_is_int ((int64_t h)) (out int))
  (decl) (func tfb_shape ((int64_t h) (int64_t * shape) (int * nd)) (out int))
  (decl) (func tfb_unary ((const char * nm) (int64_t a)) (out int64_t))
  (decl) (func tfb_binary ((const char * nm) (int64_t a) (int64_t b)) (out int64_t))
  (decl) (func tfb_scalar ((const char * nm) (int64_t a) (double v)) (out int64_t))
  (decl) (func tfb_agg ((const char * nm) (int64_t a)) (out int64_t))
  (decl) (func tfb_argmax ((int64_t a) (int64_t dim)) (out int64_t))
  (decl) (func tfb_reshape ((int64_t a) (const int64_t * shape) (int nd)) (out int64_t))
  (decl) (func tfb_cat ((const int64_t * hs) (int n) (int64_t dim)) (out int64_t))
  (decl) (func tfb_gather ((int64_t a) (int64_t idx)) (out int64_t))
  (decl) (func tfb_slice ((int64_t a) (int axis) (int64_t from) (int64_t to)) (out int64_t))
  (decl) (func tfb_standardise ((int64_t a) (int64_t ntrain)) (out int64_t))
  (decl) (func tfb_fill ((const int64_t * shape) (int nd) (double v)) (out int64_t))
  (decl) (func tfb_random ((const int64_t * shape) (int nd) (int normal)) (out int64_t))
  (decl) (func tfb_eye ((int64_t n)) (out int64_t))
  (decl) (func tfb_arange ((int64_t n)) (out int64_t))
  (decl) (func tfb_randperm ((int64_t n)) (out int64_t))
  (decl) (func tfb_parameter ((int64_t a)) (out int64_t))
  (decl) (func tfb_step ((int64_t w) (int64_t g) (double lr)) (out int64_t))
  (decl) (func tfb_grad ((int64_t loss) (const int64_t * ps) (int n) (int64_t * gs)) (out int))
  (decl) (func tfb_stats ((llong * rec) (llong * exe) (llong * rep) (llong * pend)) (out void))
  (decl) (func tfb_load_csv ((const char * path)) (out int64_t))

  ;; ---- reading arguments ---------------------------------------------------

  ;; a handle: an integer naming a live slot, or -1
  (func harg ((coco_engine * e) (size_t t)) (out int64_t)
    (let ((int64_t h . 0))
      (if (not (coco_m_int e t (aof h))) (return -1))
      (if (not (tfb_exists h)) (return -1))
      (return h)))

  ;; a number, integer or float, as a double
  (func numarg ((coco_engine * e) (size_t t) (double * out)) (out int)
    (let ((double v . 0.0) (int64_t iv . 0))
      (if (coco_m_float e t (aof v)) (block (set (cof out) v) (return 1)))
      (if (coco_m_int e t (aof iv)) (block (set (cof out) (cast double iv)) (return 1)))
      (return 0)))

  ;; a shape: a list of up to 8 integers; answers the count, or -1
  (func shape_arg ((coco_engine * e) (size_t t) (int64_t * out)) (out int)
    (let ((size_t * cells . nil) (size_t n . 0) (size_t i . 0) (int ok . 1))
      (if (not (coco_m_list_array e t (aof cells) (aof n))) (return -1))
      (if (> n 8) (block (free (cast (void *) cells)) (return -1)))
      (while (< i n)
        (let ((int64_t v . 0))
          (if (not (coco_m_int e (nth i cells) (aof v))) (set ok 0) (set (nth i out) v)))
        (set i (+ i 1)))
      (free (cast (void *) cells))
      (if (not ok) (return -1))
      (return (cast int n))))

  ;; a list of handles, at most 8
  (func handles_arg ((coco_engine * e) (size_t t) (int64_t * out)) (out int)
    (let ((size_t * cells . nil) (size_t n . 0) (size_t i . 0) (int ok . 1))
      (if (not (coco_m_list_array e t (aof cells) (aof n))) (return -1))
      (if (> n 64) (block (free (cast (void *) cells)) (return -1)))
      (while (< i n)
        (let ((int64_t h . #'(harg e (nth i cells))))
          (if (< h 0) (set ok 0) (set (nth i out) h)))
        (set i (+ i 1)))
      (free (cast (void *) cells))
      (if (not ok) (return -1))
      (return (cast int n))))

  ;; the error the back end left, as the domain of the goal
  (func refuse ((coco_engine * e) (size_t g)) (out int)
    (return (coco_m_domain_error e (tfb_error) g)))

  ;; a made handle unified with the answer argument, or the refusal
  (func answer ((coco_engine * e) (size_t g) (uint32_t i) (int64_t h)) (out int)
    (if (< h 0) (return (refuse e g)))
    (return (coco_m_unify_int e (coco_m_arg e g i) h)))

  ;; ---- the predicates --------------------------------------------------------

  ;; tensor_from_list(+L, -T): a flat list of numbers -> [N], a list of rows
  ;; -> [R, C]; FLOAT either way, as torch's is -- an index tensor is a float
  ;; tensor of whole values, cast where index_rows reads it
  (func p_from_list ((coco_engine * e) (size_t g)) (out int)
    (let ((size_t lt . #'(coco_m_arg e g 0))
          (size_t * rows . nil) (size_t nrows . 0))
      (if (not (coco_m_list_array e lt (aof rows) (aof nrows))) (return (coco_m_type_error e "list" lt)))
      (if (== nrows 0) (block (if (!= rows nil) (free (cast (void *) rows))) (return (coco_m_domain_error e "non_empty_list" lt))))
      (let ((double probe . 0.0) (int64_t iprobe . 0))
        (if (or (coco_m_float e (nth 0 rows) (aof probe)) (coco_m_int e (nth 0 rows) (aof iprobe)))
            ;; ---- flat: all integers make an index tensor, otherwise floats
            (let ((double * data . #'(cast (double *) (malloc (* nrows (sizeof double)))))
                  (int ok . 1) (size_t i . 0))
              (while (< i nrows)
                (let ((double v . 0.0) (int64_t iv . 0))
                  (cond
                    ((coco_m_int e (nth i rows) (aof iv)) (set (nth i data) (cast double iv)))
                    ((coco_m_float e (nth i rows) (aof v)) (set (nth i data) v))
                    (#t (set ok 0))))
                (set i (+ i 1)))
              (free (cast (void *) rows))
              (if (not ok) (block (free (cast (void *) data)) (return (coco_m_type_error e "number" lt))))
              (let ((int64_t h . 0) (int64_t shape [1]))
                (set (nth 0 shape) (cast int64_t nrows))
                (set h (tfb_from_doubles data shape 1))
                (free (cast (void *) data))
                (return (answer e g 1 h))))
          ;; ---- rows
          (let ((size_t * cols . nil) (size_t ncols . 0))
            (if (not (coco_m_list_array e (nth 0 rows) (aof cols) (aof ncols)))
                (block (free (cast (void *) rows)) (return (coco_m_type_error e "tensor_data" lt))))
            (if (!= cols nil) (free (cast (void *) cols)))
            (let ((double * data . #'(cast (double *) (malloc (* (* nrows ncols) (sizeof double)))))
                  (int ok . 1) (size_t r . 0))
              (while (< r nrows)
                (let ((size_t * cs . nil) (size_t nc . 0))
                  (if (or (not (coco_m_list_array e (nth r rows) (aof cs) (aof nc))) (!= nc ncols)) (set ok 0)
                    (let ((size_t c . 0))
                      (while (< c nc)
                        (if (not (numarg e (nth c cs) (aof (nth (+ (* r ncols) c) data)))) (set ok 0))
                        (set c (+ c 1)))))
                  (if (!= cs nil) (free (cast (void *) cs))))
                (set r (+ r 1)))
              (free (cast (void *) rows))
              (if (not ok) (block (free (cast (void *) data)) (return (coco_m_type_error e "tensor_data" lt))))
              (let ((int64_t shape [2]) (int64_t h . 0))
                (set (nth 0 shape) (cast int64_t nrows)) (set (nth 1 shape) (cast int64_t ncols))
                (set h (tfb_from_doubles data shape 2))
                (free (cast (void *) data))
                (return (answer e g 1 h)))))))))

  ;; the values of a handle as a Prolog list: rows for a matrix, integers for an index tensor
  (func values_list ((coco_engine * e) (int64_t h) (size_t * out)) (out int)
    (let ((int64_t n . 0) (int64_t shape [8]) (int nd . 0)
          (double * buf . #'(tfb_values h (aof n) shape (aof nd)))
          (coco_machine * m . #'(coco_m_machine e))
          (int isint . #'(tfb_is_int h)))
      (if (== buf nil) (return 0))
      (let ((size_t * cells . #'(cast (size_t *) (malloc (* (cast size_t (? (> n 0) n 1)) (sizeof size_t)))))
            (int64_t i . 0))
        (while (< i n)
          (if isint (set (nth i cells) (coco_new_int m (cast int64_t (nth i buf))))
            (set (nth i cells) (coco_new_float m (nth i buf))))
          (set i (+ i 1)))
        (if (and (== nd 2) (> (nth 1 shape) 0))
            (let ((int64_t nr . #'(nth 0 shape)) (int64_t nc . #'(nth 1 shape))
                  (size_t * rcells . #'(cast (size_t *) (malloc (* (cast size_t (? (> nr 0) nr 1)) (sizeof size_t)))))
                  (int64_t r . 0))
              (while (< r nr)
                (set (nth r rcells) (coco_m_list e (aof (nth (* r nc) cells)) (cast size_t nc)))
                (set r (+ r 1)))
              (set (cof out) (coco_m_list e rcells (cast size_t nr)))
              (free (cast (void *) rcells)))
          (set (cof out) (coco_m_list e cells (cast size_t n))))
        (free (cast (void *) cells)) (free (cast (void *) buf))
        (return 1))))

  (func p_to_list ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t h . #'(harg e (coco_m_arg e g 0))) (size_t lst . 0))
      (if (< h 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (not (values_list e h (aof lst))) (return (refuse e g)))
      (return (coco_m_unify e (coco_m_arg e g 1) lst))))

  (func p_item ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t h . #'(harg e (coco_m_arg e g 0))) (int64_t n . 0) (int64_t shape [8]) (int nd . 0))
      (if (< h 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (let ((double * buf . #'(tfb_values h (aof n) shape (aof nd))))
        (if (== buf nil) (return (refuse e g)))
        (if (!= n 1) (block (free (cast (void *) buf)) (return (coco_m_domain_error e "scalar_tensor" (coco_m_arg e g 0)))))
        (let ((double v . #'(nth 0 buf)))
          (free (cast (void *) buf))
          (return (coco_m_unify_float e (coco_m_arg e g 1) v))))))

  (func p_shape ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t h . #'(harg e (coco_m_arg e g 0))) (int64_t shape [8]) (int nd . 0)
          (coco_machine * m . #'(coco_m_machine e)))
      (if (< h 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (not (tfb_shape h shape (aof nd))) (return (refuse e g)))
      (let ((size_t cells [8]) (int i . 0))
        (while (< i nd) (set (nth i cells) (coco_new_int m (nth i shape))) (set i (+ i 1)))
        (return (coco_m_unify e (coco_m_arg e g 1) (coco_m_list e cells (cast size_t nd)))))))

  (func p_new ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t shape [8]) (int nd . #'(shape_arg e (coco_m_arg e g 0) shape))
          (const char * kind . #'(coco_m_atom e (coco_m_arg e g 1))))
      (if (< nd 1) (return (coco_m_type_error e "shape" (coco_m_arg e g 0))))
      (if (== kind nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 1))))
      (cond
        ((== 0 (strcmp kind "zeros")) (return (answer e g 2 (tfb_fill shape nd 0.0))))
        ((== 0 (strcmp kind "ones"))  (return (answer e g 2 (tfb_fill shape nd 1.0))))
        ((== 0 (strcmp kind "randn")) (return (answer e g 2 (tfb_random shape nd 1))))
        ((== 0 (strcmp kind "rand"))  (return (answer e g 2 (tfb_random shape nd 0))))
        (#t (return (coco_m_domain_error e "tensor_kind" (coco_m_arg e g 1)))))))

  (func p_full ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t shape [8]) (int nd . #'(shape_arg e (coco_m_arg e g 0) shape)) (double v . 0.0))
      (if (< nd 1) (return (coco_m_type_error e "shape" (coco_m_arg e g 0))))
      (if (not (numarg e (coco_m_arg e g 1) (aof v))) (return (coco_m_type_error e "number" (coco_m_arg e g 1))))
      (return (answer e g 2 (tfb_fill shape nd v)))))

  (func p_by_count ((coco_engine * e) (size_t g) (int which)) (out int)
    (let ((int64_t n . 0))
      (if (not (coco_m_int e (coco_m_arg e g 0) (aof n))) (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
      (if (< n 1) (return (coco_m_domain_error e "positive_integer" (coco_m_arg e g 0))))
      (cond
        ((== which 0) (return (answer e g 1 (tfb_eye n))))
        ((== which 1) (return (answer e g 1 (tfb_arange n))))
        (#t (return (answer e g 1 (tfb_randperm n)))))))

  (func p_unary ((coco_engine * e) (size_t g)) (out int)
    (let ((const char * op . #'(coco_m_atom e (coco_m_arg e g 0))) (int64_t a . #'(harg e (coco_m_arg e g 1))))
      (if (== op nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
      (if (< a 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 1))))
      (return (answer e g 2 (tfb_unary op a)))))

  (func p_binary ((coco_engine * e) (size_t g)) (out int)
    (let ((const char * op . #'(coco_m_atom e (coco_m_arg e g 0)))
          (int64_t a . #'(harg e (coco_m_arg e g 1))) (int64_t b . #'(harg e (coco_m_arg e g 2))))
      (if (== op nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
      (if (or (< a 0) (< b 0)) (return (coco_m_domain_error e "tensor" g)))
      (return (answer e g 3 (tfb_binary op a b)))))

  (func p_scalar ((coco_engine * e) (size_t g)) (out int)
    (let ((const char * op . #'(coco_m_atom e (coco_m_arg e g 0)))
          (int64_t a . #'(harg e (coco_m_arg e g 1))) (double v . 0.0))
      (if (== op nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
      (if (< a 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 1))))
      (if (not (numarg e (coco_m_arg e g 2) (aof v))) (return (coco_m_type_error e "number" (coco_m_arg e g 2))))
      (return (answer e g 3 (tfb_scalar op a v)))))

  (func p_agg ((coco_engine * e) (size_t g)) (out int)
    (let ((const char * op . #'(coco_m_atom e (coco_m_arg e g 0))) (int64_t a . #'(harg e (coco_m_arg e g 1))))
      (if (== op nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
      (if (< a 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 1))))
      (return (answer e g 2 (tfb_agg op a)))))

  ;; tensor_reduce(+Op, +T, -X): the aggregate, read as a number
  (func p_reduce ((coco_engine * e) (size_t g)) (out int)
    (let ((const char * op . #'(coco_m_atom e (coco_m_arg e g 0))) (int64_t a . #'(harg e (coco_m_arg e g 1))))
      (if (== op nil) (return (coco_m_type_error e "atom" (coco_m_arg e g 0))))
      (if (< a 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 1))))
      (let ((int64_t r . #'(tfb_agg op a)) (int64_t n . 0) (int64_t shape [8]) (int nd . 0))
        (if (< r 0) (return (refuse e g)))
        (let ((double * buf . #'(tfb_values r (aof n) shape (aof nd))))
          (tfb_free r)
          (if (== buf nil) (return (refuse e g)))
          (let ((double v . #'(nth 0 buf)))
            (free (cast (void *) buf))
            (return (coco_m_unify_float e (coco_m_arg e g 2) v)))))))

  (func p_argmax ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t a . #'(harg e (coco_m_arg e g 0))) (int64_t dim . 0))
      (if (< a 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (not (coco_m_int e (coco_m_arg e g 1) (aof dim))) (return (coco_m_type_error e "integer" (coco_m_arg e g 1))))
      (return (answer e g 2 (tfb_argmax a dim)))))

  (func p_reshape ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t a . #'(harg e (coco_m_arg e g 0))) (int64_t shape [8]) (int nd . #'(shape_arg e (coco_m_arg e g 1) shape)))
      (if (< a 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (< nd 1) (return (coco_m_type_error e "shape" (coco_m_arg e g 1))))
      (return (answer e g 2 (tfb_reshape a shape nd)))))

  (func p_cat ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t hs [64]) (int n . #'(handles_arg e (coco_m_arg e g 0) hs)) (int64_t dim . 0))
      (if (< n 1) (return (coco_m_type_error e "tensor_list" (coco_m_arg e g 0))))
      (if (not (coco_m_int e (coco_m_arg e g 1) (aof dim))) (return (coco_m_type_error e "integer" (coco_m_arg e g 1))))
      (return (answer e g 2 (tfb_cat hs n dim)))))

  (func p_index_rows ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t a . #'(harg e (coco_m_arg e g 0))) (int64_t i . #'(harg e (coco_m_arg e g 1))))
      (if (or (< a 0) (< i 0)) (return (coco_m_domain_error e "tensor" g)))
      (return (answer e g 2 (tfb_gather a i)))))

  (func p_slice ((coco_engine * e) (size_t g) (int axis)) (out int)
    (let ((int64_t a . #'(harg e (coco_m_arg e g 0))) (int64_t from . 0) (int64_t to . 0))
      (if (< a 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (or (not (coco_m_int e (coco_m_arg e g 1) (aof from))) (not (coco_m_int e (coco_m_arg e g 2) (aof to))))
          (return (coco_m_type_error e "integer" g)))
      (return (answer e g 3 (tfb_slice a axis from to)))))

  (func p_standardise ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t a . #'(harg e (coco_m_arg e g 0))) (int64_t n . 0))
      (if (< a 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (not (coco_m_int e (coco_m_arg e g 1) (aof n))) (return (coco_m_type_error e "integer" (coco_m_arg e g 1))))
      (return (answer e g 2 (tfb_standardise a n)))))

  (func p_parameter ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t a . #'(harg e (coco_m_arg e g 0))))
      (if (< a 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (return (answer e g 1 (tfb_parameter a)))))

  (func p_step ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t w . #'(harg e (coco_m_arg e g 0))) (int64_t gr . #'(harg e (coco_m_arg e g 1))) (double lr . 0.0))
      (if (or (< w 0) (< gr 0)) (return (coco_m_domain_error e "tensor" g)))
      (if (not (numarg e (coco_m_arg e g 2) (aof lr))) (return (coco_m_type_error e "number" (coco_m_arg e g 2))))
      (return (answer e g 3 (tfb_step w gr lr)))))

  ;; tensor_grad(+Loss, +Ps, -Gs)
  (func p_grad ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t loss . #'(harg e (coco_m_arg e g 0))) (int64_t ps [64]) (int64_t gs [64])
          (int n . #'(handles_arg e (coco_m_arg e g 1) ps))
          (coco_machine * m . #'(coco_m_machine e)))
      (if (< loss 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (< n 0) (return (coco_m_type_error e "tensor_list" (coco_m_arg e g 1))))
      (if (not (tfb_grad loss ps n gs)) (return (refuse e g)))
      (let ((size_t cells [64]) (int i . 0))
        (while (< i n) (set (nth i cells) (coco_new_int m (nth i gs))) (set i (+ i 1)))
        (return (coco_m_unify e (coco_m_arg e g 2) (coco_m_list e cells (cast size_t n)))))))

  (func p_free ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t h . 0))
      (if (not (coco_m_int e (coco_m_arg e g 0) (aof h))) (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
      (return (tfb_free h))))

  (func p_force ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t h . #'(harg e (coco_m_arg e g 0))))
      (if (< h 0) (return (coco_m_domain_error e "tensor" (coco_m_arg e g 0))))
      (if (not (tfb_force h)) (return (refuse e g)))
      (return 1)))

  (func p_stats ((coco_engine * e) (size_t g)) (out int)
    (let ((llong rec . 0) (llong exe . 0) (llong rep . 0) (llong pend . 0)
          (coco_machine * m . #'(coco_m_machine e)) (size_t args [4]))
      (tfb_stats (aof rec) (aof exe) (aof rep) (aof pend))
      (set (nth 0 args) (coco_make1 m "recorded" (coco_new_int m (cast int64_t rec))))
      (set (nth 1 args) (coco_make1 m "executed" (coco_new_int m (cast int64_t exe))))
      (set (nth 2 args) (coco_make1 m "replayed" (coco_new_int m (cast int64_t rep))))
      (set (nth 3 args) (coco_make1 m "pending" (coco_new_int m (cast int64_t pend))))
      (return (coco_m_unify e (coco_m_arg e g 0) (coco_make m "stats" 4 args)))))

  (func p_load_csv ((coco_engine * e) (size_t g)) (out int)
    (let ((char path [4096]))
      (if (not (coco_m_text e (coco_m_arg e g 0) path 4096)) (return (coco_m_type_error e "text" (coco_m_arg e g 0))))
      (return (answer e g 1 (tfb_load_csv path)))))

  (func p_seed ((coco_engine * e) (size_t g)) (out int)
    (let ((int64_t s . 0))
      (if (not (coco_m_int e (coco_m_arg e g 0) (aof s))) (return (coco_m_type_error e "integer" (coco_m_arg e g 0))))
      (tfb_seed s)
      (return 1)))

  ;; tensor_execution(+Backend, +Mode, ?Device), the device third: cpu | cuda |
  ;; auto sets where the NEXT producer runs, unbound asks. The torch module has
  ;; set the backend and the mode by the time this is reached. cuda on a
  ;; machine without one is not an error here: the work goes to the CPU, and
  ;; this says so, once per call.
  (func p_execution3 ((coco_engine * e) (size_t g)) (out int)
    (let ((coco_machine * m . #'(coco_m_machine e))
          (size_t d . #'(coco_deref m (coco_m_arg e g 2))))
      (if (coco_m_is_atom e d)
          (let ((const char * nm . #'(coco_m_atom e d)))
            (cond
              ((== 0 (strcmp nm "cpu"))  (tfb_device_set 0) (return 1))
              ((== 0 (strcmp nm "auto")) (tfb_device_set 2) (return 1))
              ((== 0 (strcmp nm "cuda"))
               (if (not (tfb_device_set 1))
                   (fprintf stderr "cocolog: tensor_execution: no cuda for tensorflow on this machine -- running on cpu\n"))
               (return 1))
              (#t (return (coco_m_domain_error e "device" d))))))
      (return (coco_m_unify e d (coco_new_atom m (? (tfb_on_gpu) "cuda" "cpu"))))))

  (func p_version ((coco_engine * e) (size_t g)) (out int)
    (let ((coco_machine * m . #'(coco_m_machine e)))
      (return (coco_m_unify e (coco_m_arg e g 0) (coco_new_atom m (tfb_version))))))

  ;; ---- the two dispatchers ------------------------------------------------------
  ;; THE BACKEND'S: every tensor_* name, handed here by the torch module while
  ;; tensor_execution(tensorflow, _) is in force.
  (func tf_backend_dispatch ((coco_engine * e) (const char * name) (uint32_t arity) (size_t g) (int * found)) (out int)
    (set (cof found) 1)
    (cond
      ((== arity 1)
       (cond
         ((== 0 (strcmp name "tensor_free"))        (return (p_free e g)))
         ((== 0 (strcmp name "tensor_force"))       (return (p_force e g)))
         ((== 0 (strcmp name "tensor_graph_stats")) (return (p_stats e g)))
         (#t (set (cof found) 0) (return 0))))
      ((== arity 2)
       (cond
         ((== 0 (strcmp name "tensor_from_list"))  (return (p_from_list e g)))
         ((== 0 (strcmp name "tensor_to_list"))    (return (p_to_list e g)))
         ((== 0 (strcmp name "tensor_shape"))      (return (p_shape e g)))
         ((== 0 (strcmp name "tensor_item"))       (return (p_item e g)))
         ((== 0 (strcmp name "tensor_eye"))        (return (p_by_count e g 0)))
         ((== 0 (strcmp name "tensor_arange"))     (return (p_by_count e g 1)))
         ((== 0 (strcmp name "tensor_randperm"))   (return (p_by_count e g 2)))
         ((== 0 (strcmp name "tensor_parameter"))  (return (p_parameter e g)))
         ((== 0 (strcmp name "tensor_load_csv"))   (return (p_load_csv e g)))
         (#t (set (cof found) 0) (return 0))))
      ((== arity 3)
       (cond
         ((== 0 (strcmp name "tensor_unary"))       (return (p_unary e g)))
         ((== 0 (strcmp name "tensor_new"))         (return (p_new e g)))
         ((== 0 (strcmp name "tensor_full"))        (return (p_full e g)))
         ((== 0 (strcmp name "tensor_agg"))         (return (p_agg e g)))
         ((== 0 (strcmp name "tensor_reduce"))      (return (p_reduce e g)))
         ((== 0 (strcmp name "tensor_argmax"))      (return (p_argmax e g)))
         ((== 0 (strcmp name "tensor_reshape"))     (return (p_reshape e g)))
         ((== 0 (strcmp name "tensor_cat"))         (return (p_cat e g)))
         ((== 0 (strcmp name "tensor_index_rows"))  (return (p_index_rows e g)))
         ((== 0 (strcmp name "tensor_standardise")) (return (p_standardise e g)))
         ((== 0 (strcmp name "tensor_grad"))        (return (p_grad e g)))
         ((== 0 (strcmp name "tensor_execution"))   (return (p_execution3 e g)))
         (#t (set (cof found) 0) (return 0))))
      ((== arity 4)
       (cond
         ((== 0 (strcmp name "tensor_binary"))  (return (p_binary e g)))
         ((== 0 (strcmp name "tensor_scalar"))  (return (p_scalar e g)))
         ((== 0 (strcmp name "tensor_rows"))    (return (p_slice e g 0)))
         ((== 0 (strcmp name "tensor_cols"))    (return (p_slice e g 1)))
         ((== 0 (strcmp name "tensor_step"))    (return (p_step e g)))
         (#t (set (cof found) 0) (return 0))))
      (#t (set (cof found) 0) (return 0))))

  ;; THE MODULE'S OWN: only what names the library. The tensor_* names are
  ;; the torch module's, so that a program keeps to one backend at a time.
  (func tf_module_dispatch ((coco_engine * e) (const char * name) (uint32_t arity) (size_t g) (int * found)) (out int)
    (set (cof found) 1)
    (if (== arity 1)
        (cond
          ((== 0 (strcmp name "tensorflow_version")) (return (p_version e g)))
          ((== 0 (strcmp name "tensorflow_seed"))    (return (p_seed e g)))))
    (set (cof found) 0)
    (return 0))

  ;; THE ONE SYMBOL THE LOADER CALLS. Attaches to torch.so beside this file
  ;; -- the switch and the predicates are its -- then registers itself.
  (func coco_library_entry () (out int)
    (if (not (tfb_attach tf_backend_dispatch))
        (block (fprintf stderr "cocolog: library(tensorflow): %s\n" (tfb_error)) (return 0)))
    (if (not (coco_module_register "tensorflow" tf_module_dispatch nil nil)) (return 0))
    (return 1)))

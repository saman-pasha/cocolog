;;;; library(der) -- Distinguished Encoding Rules, as cocolog predicates.
;;;;
;;;; A LOADABLE Cicili module against lib/sdk.cicili, over `Zigurat::DER'
;;;; from ZiguratIP's Core. It is the layer everything X.509 stands on: a
;;;; certificate, a key, a signing request and a signature algorithm are
;;;; all DER, and a program that can take one apart can reason about all
;;;; of them.
;;;;
;;;;   der_encode(+Term, -Hex)          a term as DER
;;;;   der_decode(+Hex, -Term)          DER as a term
;;;;   der_tlv(+Hex, -Tag, -Value, -Rest)   ONE tag-length-value, raw
;;;;   der_wrap(+Tag, +ContentHex, -Hex)    the inverse of der_tlv/4
;;;;   der_prim(+Kind, +Value, -Hex)        one primitive, encoded
;;;;   der_unprim(+Kind, +Hex, -Value)      one primitive, decoded
;;;;   der_tag(?Kind, ?Tag)                 the table, both ways
;;;;
;;;; THE TERM VOCABULARY, which is the whole interface:
;;;;
;;;;   boolean(true) boolean(false)
;;;;   integer(N)              a DECIMAL ATOM -- see below
;;;;   bit_string(Hex)  octet_string(Hex)
;;;;   null
;;;;   oid('1.2.840.113549.1.1.1')
;;;;   utf8(A)  printable(A)  ia5(A)
;;;;   utc_time(Unix)  generalized_time(Unix)
;;;;   sequence([T1, T2, ...])   set([T1, ...])
;;;;   context(N, T)           [N] EXPLICIT, which X.509 v3 needs
;;;;   unknown(Tag, Hex)       anything the table has no name for
;;;;
;;;; `unknown/2' IS NOT A FAILURE, and it matters that it is in the
;;;; vocabulary: a parser that refused every tag it did not recognise
;;;; could not read a certificate carrying an extension somebody else
;;;; invented. It round-trips exactly, so a document read and written
;;;; again is the same bytes whether or not this module understood it.
;;;;
;;;; `integer(N)' IS A DECIMAL ATOM, not a cocolog integer, and that is
;;;; not fussiness: an RSA modulus is two thousand bits and cocolog's
;;;; integers are sixty-four, so a modulus read into one would WRAP IN
;;;; SILENCE. An atom of digits is what `library(bigint)' also speaks, so
;;;; the two compose without a conversion nobody would remember to write.
;;;;
;;;; TWO'S COMPLEMENT, SHORTEST FORM, is what DER INTEGER actually is,
;;;; and it is where a hand-rolled encoder goes wrong: 127 is `02 01 7F'
;;;; and 128 is `02 02 00 80', because a leading zero has to be added
;;;; when the top bit would otherwise read as a sign. Negative numbers
;;;; are the complement plus one under the same rule. That is done here,
;;;; by hand, because Zigurat's `encode_integer' overloads take a
;;;; magnitude and a sign the caller does not get to state.
;;;;
;;;; THE STRUCTURE IS PROLOG AND THE BYTES ARE C++, which is the split
;;;; this whole tree is built on. The Cicili half over Zigurat::DER knows one TLV: read a tag
;;;; and a length, hand back the content and the rest. Walking a sequence
;;;; of them is a two-clause recursion, and a two-clause recursion is
;;;; better said in Prolog than as a loop with a cursor in it.
;;;;
;;;; THE ROUND TRIP IS THE REAL TEST, exactly as it is for `library(xml)'
;;;; and the other two document libraries: write a term, read it, write
;;;; it again, compare the BYTES. A reader and a writer that disagree
;;;; about the same certificate are worse than either alone, and no
;;;; amount of hand-written expectations on each half finds it.

(DEFPARAMETER *der-predicates*
  '(("der_prim"   3 dr_p_prim)
    ("der_unprim" 3 dr_p_unprim)
    ("der_tlv"    4 dr_p_tlv)
    ("der_wrap"   3 dr_p_wrap)))

;;; ---- the Coco half: the structure, and the vocabulary ----------------
;;;
;;; ONE CLAUSE PER LINE, which is why this is a list of strings rather
;;; than one: a Cicili string literal may not contain a newline, so a
;;; module's Prolog half is joined with spaces -- and a list keeps the
;;; source readable a clause at a time.
(DEFPARAMETER *der-prolog*
  (FORMAT NIL "~{~A ~}"
          (LIST
           ;; The tag table, as clauses, so it runs both ways: der_tag(oid, T)
           ;; asks and der_tag(K, 6) answers. The encoding half has the same table
           ;; and they are checked against each other by the tutorial.
           "der_tag(boolean, 1)."
           "der_tag(integer, 2)."
           "der_tag(bit_string, 3)."
           "der_tag(octet_string, 4)."
           "der_tag(null, 5)."
           "der_tag(oid, 6)."
           "der_tag(utf8, 12)."
           "der_tag(printable, 19)."
           "der_tag(ia5, 22)."
           "der_tag(utc_time, 23)."
           "der_tag(generalized_time, 24)."

           ;; ENCODING. A constructed term encodes its children first and
           ;; wraps the result; a primitive goes straight to the encoding half.
           "der_encode(sequence(L), Hex) :- !, der_encode_list(L, C), der_wrap(48, C, Hex)."
           "der_encode(set(L), Hex) :- !, der_encode_list(L, C), der_wrap(49, C, Hex)."
           "der_encode(context(N, T), Hex) :- !, der_encode(T, C), Tag is 160 + N, der_wrap(Tag, C, Hex)."
           "der_encode(unknown(Tag, Hex), Out) :- !, der_wrap(Tag, Hex, Out)."
           "der_encode(null, Hex) :- !, der_prim(null, '', Hex)."
           "der_encode(T, Hex) :- T =.. [Kind, V], der_tag(Kind, _), !, der_prim(Kind, V, Hex)."
           "der_encode(T, _) :- throw(error(domain_error(der_term, T), der_encode/2))."

           ;; BOTH BASE CASES END IN A CUT, and the second one has to. Ask
           ;; for a further solution -- which `cocolog query' does, and so
           ;; does any caller that backtracks -- and without it
           ;; `der_decode_list' retries its second clause with an EMPTY
           ;; string, `der_tlv' is handed no bytes at all, and a decode
           ;; that had already succeeded raises `not well formed DER'.
           ;; The error names the data and the data was fine.
           "der_encode_list([], '') :- !."
           "der_encode_list([T|Ts], Hex) :- der_encode(T, H), der_encode_list(Ts, R), atom_concat(H, R, Hex)."

           ;; DECODING. One TLV off the front, then the tag decides.
           "der_decode(Hex, Term) :- der_tlv(Hex, Tag, Value, Rest), ( Rest == '' -> true ; throw(error(domain_error(one_der_value, Rest), der_decode/2)) ), der_term(Tag, Value, Term)."

           "der_term(48, V, sequence(L)) :- !, der_decode_list(V, L)."
           "der_term(49, V, set(L)) :- !, der_decode_list(V, L)."
           "der_term(Tag, V, context(N, T)) :- Tag >= 160, Tag =< 191, !, N is Tag - 160, der_decode(V, T)."
           "der_term(5, _, null) :- !."
           ;; A BIT STRING IS NOT QUITE A PRIMITIVE. Its content begins
           ;; with a count of the bits at the end that are not part of
           ;; the value, and for everything X.509 does with one -- a
           ;; public key, a signature over a DER document -- that count
           ;; is zero. `bit_string(H)' is that case, and a bit string
           ;; that really does declare spare bits comes back as
           ;; `unknown(3, Content)', which round-trips exactly rather
           ;; than quietly losing them.
           "der_term(3, V, T) :- !, ( sub_atom(V, 0, 2, _, '00') -> sub_atom(V, 2, _, 0, H), T = bit_string(H) ; T = unknown(3, V) )."
           "der_term(Tag, V, Term) :- der_tag(Kind, Tag), !, der_wrap(Tag, V, Tlv), der_unprim(Kind, Tlv, Value), Term =.. [Kind, Value]."
           "der_term(Tag, V, unknown(Tag, V))."

           "der_decode_list('', []) :- !."
           "der_decode_list(Hex, [T|Ts]) :- der_tlv(Hex, Tag, V, Rest), der_term(Tag, V, T), der_decode_list(Rest, Ts).")))

;;; A METHOD CALL AS A CONDITION goes through `bool?': the emitter takes a
;;; bare (($ x empty)) in an `if' for a construct, and (not (not ...)) is
;;; the same truth written as an expression it does read.
(DEFMACRO bool? (x) `(not (not ,x)))

(source "coco-der.cpp"
  (make :cpp #t :compile #f)

  ;;; The includes come BEFORE the SDK block: those prototypes name
  ;;; `size_t' and `int64_t', and emitted above <cstdint> they are twenty
  ;;; errors about unknown type names.
  (include <cstdio>)
  (include <cstdint>)
  (include <cstddef>)
  (include <cstring>)
  (include <cstdlib>)
  (include <string>)
  (include <vector>)

  ;;; THE LINKAGE, FIRST AND RAW. In a `:cpp #t' target C++ gives the
  ;;; SDK's prototypes C++ LINKAGE, and `use_module' then fails with a
  ;;; mangled `undefined symbol' for a function the interpreter exports
  ;;; unmangled. Wrapping `(coco-sdk)' in `(extern-c ...)' is not the
  ;;; fix -- a Cicili macro must emit ONE form, and several leaves every
  ;;; symbol unregistered. C++ gives a redeclaration the linkage of the
  ;;; first one it saw, so these come first.
  (code "extern \"C\" {")
  (code "int coco_module_register(const char*, int (*)(struct coco_engine_opaque*, const char*, uint32_t, size_t, int*), const char*, int (*)(struct coco_engine_opaque*));")
  (code "size_t coco_m_arg(struct coco_engine_opaque*, size_t, uint32_t);")
  (code "int coco_m_int(struct coco_engine_opaque*, size_t, int64_t*);")
  (code "int coco_m_text(struct coco_engine_opaque*, size_t, char*, size_t);")
  (code "int coco_m_unify_atom(struct coco_engine_opaque*, size_t, const char*);")
  (code "int coco_m_unify_int(struct coco_engine_opaque*, size_t, int64_t);")
  (code "int coco_m_type_error(struct coco_engine_opaque*, const char*, size_t);")
  (code "int coco_m_domain_error(struct coco_engine_opaque*, const char*, size_t);")
  (code "int coco_m_error(struct coco_engine_opaque*, const char*, const char*);")
  (code "}")

  (import "./sdk.cicili")
  (coco-sdk)

  (include <der.hpp>)
  (include <bufferstream.hpp>)
  (import "lib/cpp/zigurat/stream.cicili")
  (import "lib/cpp/zigurat/der.cicili")

  ;;; ---- DER, as Cicili clauses over Zigurat::DER --------------------------
  ;;;
  ;;; ONE LANGUAGE, ONE TARGET: a :cpp target, so an encoder is
  ;;; (Zigurat::DER::encode_oid b o) over the declarations in
  ;;; cicili/lib/cpp/zigurat, and the C++ compiler sees ordinary C++ against
  ;;; <der.hpp>. Bytes travel as std::string, because DER content is
  ;;; arbitrary bytes and a zero is an ordinary one; a bufferstream is
  ;;; BUILT from a string (its setter is a second signature under the
  ;;; getter's name, which the language does not hold). The seam to the
  ;;; engine stays four functions wide, each an integer saying what went
  ;;; wrong.

  (static) (func de_hexval ((int c)) (out int)
    (if (and (>= c 48) (<= c 57)) (return (- c 48)))
    (if (and (>= c 97) (<= c 102)) (return (+ (- c 97) 10)))
    (if (and (>= c 65) (<= c 70)) (return (+ (- c 65) 10)))
    (return -1))

  ;;; Hex in, bytes out. Answers 0 on anything that is not an even run of
  ;;; hex digits -- an odd length included, because half a byte is not a
  ;;; byte.
  (static) (func de_unhex ((const char * s) (std::string & out)) (out int)
    (let ((size_t n . #'(strlen s)))
      (if (!= 0 (% n 2)) (return 0))
      (($ out clear))
      (($ out reserve) (/ n 2))
      (for ((size_t i . 0)) (< i n) ((set i (+ i 2)))
        (let ((int hi . #'(de_hexval (cast int (cast u8 (nth i s)))))
              (int lo . #'(de_hexval (cast int (cast u8 (nth (+ i 1) s))))))
          (if (or (< hi 0) (< lo 0)) (return 0))
          (($ out push_back) (cast char (bitor (<< hi 4) lo)))))
      (return 1)))

  (static) (func de_tohex ((const std::string & b) (char * out) (size_t cap)) (out int)
    (let ((const char * d . "0123456789abcdef"))
      (if (> (+ (* 2 (($ b size))) 1) cap) (return 0))
      (for ((size_t i . 0)) (< i (($ b size))) ((++ i))
        (let ((int c . #'(cast int (cast u8 (nth i b)))))
          (set (nth (* 2 i) out) (nth (>> c 4) d))
          (set (nth (+ (* 2 i) 1) out) (nth (bitand c 15) d))))
      (set (nth (* 2 (($ b size))) out) 0)
      (return 1)))

  ;;; ---- decimal, for an INTEGER that does not fit in sixty-four bits ----
  ;;;
  ;;; An RSA modulus is two thousand bits, so `integer(N)' cannot be a
  ;;; cocolog integer and cannot be an int64_t either. It is a DECIMAL ATOM,
  ;;; and these turn one into magnitude bytes and back: repeated multiply-
  ;;; by-ten and divide-by-ten over a byte string, the same arithmetic
  ;;; modules/bigint uses, for the same reason and by the same argument.

  (static) (func de_mul10_add ((std::string & m) (int d))
    (let ((int carry . d))
      (for ((size_t i . #'(($ m size)))) (> i 0) ((-- i))
        (let ((int v . #'(+ (* (cast int (cast u8 (nth (- i 1) m))) 10) carry)))
          (set (nth (- i 1) m) (cast char (bitand v 255)))
          (set carry (>> v 8))))
      (while (!= carry 0)
        (($ m insert) 0 1 (cast char (bitand carry 255)))
        (set carry (>> carry 8)))))

  (static) (func de_divmod10 ((std::string & m)) (out int)
    (let ((int rem . 0))
      (for ((size_t i . 0)) (< i (($ m size))) ((++ i))
        (let ((int cur . #'(bitor (<< rem 8) (cast int (cast u8 (nth i m))))))
          (set (nth i m) (cast char (/ cur 10)))
          (set rem (% cur 10))))
      (while (and (> (($ m size)) 1) (== 0 (cast int (cast u8 (nth 0 m)))))
        (($ m erase) 0 1))
      (return rem)))

  (static) (func de_mag_zero ((const std::string & m)) (out int)
    (for ((size_t i . 0)) (< i (($ m size))) ((++ i))
      (if (!= 0 (cast int (cast u8 (nth i m)))) (return 0)))
    (return 1))

  (static) (func de_dec_to_mag ((const char * s) (std::string & mag) (int * neg)) (out int)
    (set (cof neg) 0)
    (let ((const char * p . s))
      (if (== (cast int (nth 0 p)) 45) (block (set (cof neg) 1) (set p (+ p 1))))
      (if (== (cast int (nth 0 p)) 0) (return 0))
      (($ mag assign) 1 (cast char 0))
      (for ((size_t i . 0)) (!= (cast int (nth i p)) 0) ((++ i))
        (let ((int c . #'(cast int (nth i p))))
          (if (or (< c 48) (> c 57)) (return 0))
          (if (> (($ mag size)) 1024) (return 0))
          (de_mul10_add mag (- c 48))))
      (while (and (> (($ mag size)) 1) (== 0 (cast int (cast u8 (nth 0 mag)))))
        (($ mag erase) 0 1))
      (if (de_mag_zero mag) (set (cof neg) 0))
      (return 1)))

  ;; the magnitude is consumed: it arrives by value
  (static) (func de_mag_to_dec ((std::string mag) (int neg) (std::string & out))
    (letin* ((d (std::string)))
      (if (de_mag_zero mag)
          (set out (std::string "0"))
          (block
            (while (not (de_mag_zero mag))
              (($ d push_back) (cast char (+ 48 (de_divmod10 mag)))))
            (($ out clear))
            (if neg (($ out push_back) (cast char 45)))
            (for ((size_t i . #'(($ d size)))) (> i 0) ((-- i))
              (($ out push_back) (nth (- i 1) d)))))))

  ;;; TWO'S COMPLEMENT, WHICH IS WHAT DER INTEGER ACTUALLY IS, and the place
  ;;; a hand-rolled encoder gets it wrong. The content is signed big-endian
  ;;; with the SHORTEST representation: a leading 0x00 is added when the top
  ;;; bit of the magnitude is set (else a positive number reads as negative),
  ;;; and a negative number is the complement plus one with a leading 0xFF
  ;;; added on the same rule. 127 is `02 01 7F' and 128 is `02 02 00 80'.
  (static) (func de_mag_to_twos ((const std::string & mag) (int neg) (std::string & out))
    (letin* ((v (std::string mag)))
      (while (and (> (($ v size)) 1) (== 0 (cast int (cast u8 (nth 0 v)))))
        (($ v erase) 0 1))
      (if (not neg)
          (if (!= 0 (bitand (cast int (cast u8 (nth 0 v))) 128)) (($ v insert) 0 1 (cast char 0)))
          (block
            (for ((size_t i . 0)) (< i (($ v size))) ((++ i))
              (set (nth i v) (cast char (~ (cast int (cast u8 (nth i v)))))))
            (let ((int carry . 1))
              (for ((size_t i . #'(($ v size)))) (and (> i 0) (!= carry 0)) ((-- i))
                (let ((int t . #'(+ (cast int (cast u8 (nth (- i 1) v))) carry)))
                  (set (nth (- i 1) v) (cast char (bitand t 255)))
                  (set carry (>> t 8))))
              (if (!= carry 0) (($ v insert) 0 1 (cast char 1))))
            (if (== 0 (bitand (cast int (cast u8 (nth 0 v))) 128)) (($ v insert) 0 1 (cast char 255)))
            (while (and (> (($ v size)) 1)
                        (and (== 255 (cast int (cast u8 (nth 0 v)))) (!= 0 (bitand (cast int (cast u8 (nth 1 v))) 128))))
              (($ v erase) 0 1))))
      (set out v)))

  (static) (func de_twos_to_mag ((const std::string & b) (std::string & mag) (int * neg))
    (letin* ((v (std::string b)))
      (if (bool? (($ v empty)))
          (block (($ mag assign) 1 (cast char 0)) (set (cof neg) 0))
          (block
            (set (cof neg) (? (!= 0 (bitand (cast int (cast u8 (nth 0 v))) 128)) 1 0))
            (if (cof neg)
                (let ((int carry . 1))
                  (for ((size_t i . #'(($ v size)))) (> i 0) ((-- i))
                    (let ((int t . #'(+ (cast int (cast u8 (~ (cast int (cast u8 (nth (- i 1) v)))))) carry)))
                      (set (nth (- i 1) v) (cast char (bitand t 255)))
                      (set carry (>> t 8))))))
            (while (and (> (($ v size)) 1) (== 0 (cast int (cast u8 (nth 0 v)))))
              (($ v erase) 0 1))
            (set mag v)
            (if (de_mag_zero mag) (set (cof neg) 0))))))

  ;;; ---- the kinds, as one table -----------------------------------------
  ;;; The tag a kind carries, so the Prolog half never spells 0x13 and the
  ;;; two sides cannot drift. -1 means the name is not one of ours.
  (static) (func de_tag_of ((const char * kind)) (out int)
    (cond ((== 0 (strcmp kind "boolean")) (return 1))
          ((== 0 (strcmp kind "integer")) (return 2))
          ((== 0 (strcmp kind "bit_string")) (return 3))
          ((== 0 (strcmp kind "octet_string")) (return 4))
          ((== 0 (strcmp kind "null")) (return 5))
          ((== 0 (strcmp kind "oid")) (return 6))
          ((== 0 (strcmp kind "utf8")) (return 12))
          ((== 0 (strcmp kind "printable")) (return 19))
          ((== 0 (strcmp kind "ia5")) (return 22))
          ((== 0 (strcmp kind "utc_time")) (return 23))
          ((== 0 (strcmp kind "generalized_time")) (return 24))
          ((== 0 (strcmp kind "bmp")) (return 30))
          (#t (return -1))))

  (static) (func de_parse_oid ((const char * s) ((t<> std::vector u32) & out)) (out int)
    (($ out clear))
    (let ((u64 node . 0) (int any . 0) (const char * p . s))
      (while 1
        (let ((int c . #'(cast int (nth 0 p))))
          (cond ((and (>= c 48) (<= c 57))
                 (set node (+ (* node 10) (cast u64 (- c 48))))
                 (if (> node 4294967295) (return 0))
                 (set any 1))
                ((or (== c 46) (== c 0))
                 (if (not any) (return 0))
                 (($ out push_back) (cast u32 node))
                 (set node 0)
                 (set any 0)
                 (if (== c 0) break))
                (#t (return 0))))
        (set p (+ p 1)))
      (return (? (>= (($ out size)) 2) 1 0))))

  ;;; 0 ok. -1 unknown kind, -2 not hex or not the value the kind wants,
  ;;; -3 malformed DER, -4 the answer does not fit, -5 the library threw.
  (static) (func coco_der_prim ((const char * kind) (const char * value) (char * out) (size_t cap)) (out int)
    (let ((int tag . #'(de_tag_of kind)))
      (if (< tag 0) (return -1))
      (try
        (block
          (letin* ((b (Zigurat::bufferstream)))
            (cond
              ((== tag 1)
               (if (and (!= 0 (strcmp value "true")) (!= 0 (strcmp value "false"))) (return -2))
               (Zigurat::DER::encode_boolean b (== 0 (strcmp value "true"))))
              ;; THE CONTENT IS WRITTEN AS A TLV BY HAND, and deliberately: the
              ;; encode_integer overloads take a MAGNITUDE and a sign the caller
              ;; does not get to state, so a negative number could not be said.
              ;; The length header is still Zigurat's.
              ((== tag 2)
               (letin* ((mag (std::string)) (content (std::string)) (len (Zigurat::bufferstream)) (s (std::string)))
                 (let ((int neg . 0))
                   (if (not (de_dec_to_mag value mag (aof neg))) (return -2))
                   (de_mag_to_twos mag neg content)
                   (Zigurat::DER::encode_length len (($ content size)))
                   (($ s push_back) (cast char 2))
                   (set s (+ s (($ len string))))
                   (set s (+ s content))
                   (return (? (de_tohex s out cap) 0 -4)))))
              ;; BY HAND, because `encode_bit_string' reads its array as a
              ;; big-endian NUMBER and works out how many bits at the end are
              ;; unused -- which is right for an RSA signature and wrong for
              ;; everything X.509 does with a BIT STRING, where the content is a
              ;; DER document and the unused-bit count is zero. Given 0a0b it
              ;; answered `03 02 02 0a': a byte dropped and two bits declared
              ;; spare. Here the octet is 0x00 and the bytes are verbatim.
              ((== tag 3)
               (letin* ((bytes (std::string)) (content (std::string)) (len (Zigurat::bufferstream)) (s (std::string)))
                 (if (not (de_unhex value bytes)) (return -2))
                 (($ content push_back) (cast char 0))
                 (set content (+ content bytes))
                 (Zigurat::DER::encode_length len (($ content size)))
                 (($ s push_back) (cast char 3))
                 (set s (+ s (($ len string))))
                 (set s (+ s content))
                 (return (? (de_tohex s out cap) 0 -4))))
              ((== tag 4)
               (letin* ((bytes (std::string)))
                 (if (not (de_unhex value bytes)) (return -2))
                 (Zigurat::DER::encode_octet_string b (cast (const u8 *) (($ bytes data))) (($ bytes size)))))
              ((== tag 5) (Zigurat::DER::encode_null b))
              ((== tag 6)
               (letin* ((o ((t<> std::vector u32))))
                 (if (not (de_parse_oid value o)) (return -2))
                 (Zigurat::DER::encode_oid b o)))
              ((== tag 12) (Zigurat::DER::encode_utf8_string b (std::string value)))
              ((== tag 19) (Zigurat::DER::encode_printable_string b (std::string value)))
              ((== tag 22) (Zigurat::DER::encode_ia5_string b (std::string value)))
              ((== tag 23) (Zigurat::DER::encode_utc_time b (cast long (strtoll value nil 10)) false))
              ((== tag 24) (Zigurat::DER::encode_generalized_time b (cast long (strtoll value nil 10)) false))
              (#t (return -1)))
            (letin* ((all (($ b string))))
              (return (? (de_tohex all out cap) 0 -4)))))
        (catch () (return -5)))))

  (static) (func coco_der_unprim ((const char * kind) (const char * tlv_hex) (char * out) (size_t cap)) (out int)
    (let ((int tag . #'(de_tag_of kind)))
      (if (< tag 0) (return -1))
      (letin* ((bytes (std::string)))
        (if (not (de_unhex tlv_hex bytes)) (return -2))
        (try
          (block
            (letin* ((b (Zigurat::bufferstream bytes)))
              (cond
                ((== tag 1)
                 (let ((int v . #'(Zigurat::DER::decode_boolean b)))
                   (let ((const char * s . #'(? v "true" "false")))
                     (if (> (+ (strlen s) 1) cap) (return -4))
                     (strcpy out s)
                     (return 0))))
                ;; THE CONTENT IS READ BY HAND for the same reason it is written by
                ;; hand: DER::Integer answers a fixed-width C++ integer or a BigInt,
                ;; and neither carries a two thousand bit modulus back out as text.
                ((== tag 2)
                 (let ((int t . #'(cast int (Zigurat::DER::decode_tag b))))
                   (if (!= t 2) (return -3))
                   (let ((u64 n . #'(Zigurat::DER::decode_length b)))
                     (if (or (== n 0) (> n (($ bytes size)))) (return -3))
                     (letin* ((content (std::string)) (mag (std::string)) (dec (std::string)))
                       (for ((u64 i . 0)) (< i n) ((++ i)) (($ content push_back) (cast char (($ b get)))))
                       (let ((int neg . 0))
                         (de_twos_to_mag content mag (aof neg))
                         (de_mag_to_dec mag neg dec)
                         (if (> (+ (($ dec size)) 1) cap) (return -4))
                         (strcpy out (($ dec c_str)))
                         (return 0))))))
                ;; The inverse of the encoder above: strip the unused-bit octet and
                ;; hand back the rest. -7 for a bit string that really does declare
                ;; spare bits -- the Prolog half turns that into `unknown(3, ...)',
                ;; which round-trips exactly rather than losing them.
                ((== tag 3)
                 (if (< (($ bytes size)) 3) (return -3))
                 (let ((size_t p . 2) (int l0 . #'(cast int (cast u8 (nth 1 bytes)))) (size_t n . 0))
                   (if (< l0 128)
                       (set n (cast size_t l0))
                       (let ((size_t k . #'(cast size_t (bitand l0 127))))
                         (if (or (== k 0) (> k 8)) (return -3))
                         (for ((size_t i . 0)) (< i k) ((++ i))
                           (set n (bitor (<< n 8) (cast size_t (cast u8 (nth p bytes)))))
                           (set p (+ p 1)))))
                   (if (or (== n 0) (> n (- (($ bytes size)) p))) (return -3))
                   (if (!= 0 (cast int (cast u8 (nth p bytes)))) (return -7))
                   (letin* ((sub (($ bytes substr) (+ p 1) (- n 1))))
                     (return (? (de_tohex sub out cap) 0 -4)))))
                ((== tag 4)
                 (letin* ((v (Zigurat::bufferstream)))
                   (Zigurat::DER::decode_octet_string b v)
                   (letin* ((vs (($ v string))))
                     (return (? (de_tohex vs out cap) 0 -4)))))
                ((== tag 5)
                 (Zigurat::DER::decode_null b)
                 (if (< cap 1) (return -4))
                 (set (nth 0 out) 0)
                 (return 0))
                ;; DOTTED, not `oid_to_string''s `{ 1 2 840 }' -- that is a debug
                ;; shape, and what everything outside this process writes an OID as
                ;; is 1.2.840.113549.1.1.1.
                ((== tag 6)
                 (letin* ((o (Zigurat::DER::decode_oid b)) (s (std::string)))
                   (for ((size_t i . 0)) (< i (($ o size))) ((++ i))
                     (let ((char tmp [16]))
                       (if (!= i 0) (($ s push_back) (cast char 46)))
                       (snprintf tmp 16 "%u" (cast u32 (($ o at) i)))
                       (set s (+ s (std::string tmp)))))
                   (if (> (+ (($ s size)) 1) cap) (return -4))
                   (strcpy out (($ s c_str)))
                   (return 0)))
                ((or (== tag 12) (or (== tag 19) (== tag 22)))
                 (let ((int t . #'(cast int (Zigurat::DER::decode_tag b))))
                   (if (!= t tag) (return -3))
                   (let ((u64 n . #'(Zigurat::DER::decode_length b)))
                     (if (> (+ n 1) cap) (return -4))
                     (for ((u64 i . 0)) (< i n) ((++ i)) (set (nth i out) (cast char (($ b get)))))
                     (set (nth n out) 0)
                     (return 0))))
                ((or (== tag 23) (== tag 24))
                 (let ((long v . #'(? (== tag 23) (Zigurat::DER::decode_utc_time b) (Zigurat::DER::decode_generalized_time b)))
                       (char tmp [32]))
                   (snprintf tmp 32 "%ld" v)
                   (if (> (+ (strlen tmp) 1) cap) (return -4))
                   (strcpy out tmp)
                   (return 0)))
                (#t (return -1)))))
          (catch () (return -3))))))

  ;;; ONE TLV OFF THE FRONT: the tag, the content, and everything after it.
  ;;; This is the whole of what this side owes the Prolog side about
  ;;; STRUCTURE -- a sequence is a tag whose content is more TLVs, and
  ;;; walking that is a two-clause recursion better written in Prolog than
  ;;; in a loop here.
  ;;;
  ;;; THE HEADER IS PARSED BY HAND, and it was worth the fifteen lines.
  ;;; Reading it with decode_tag/decode_length off a bufferstream means
  ;;; asking the stream how far it has got, and `length()' answers the
  ;;; stream's SIZE rather than its position -- so the header width came
  ;;; out zero and every value was the first bytes of its own envelope.
  ;;; The rule itself is small: a length below 0x80 is that length, and
  ;;; 0x80|k means the next k bytes are the length, big-endian. 0x80 on its
  ;;; own is INDEFINITE LENGTH, which BER allows and DER forbids outright.
  (static) (func coco_der_tlv ((const char * hex) (long * tag) (char * value) (size_t vcap)
                               (char * rest) (size_t rcap)) (out int)
    (letin* ((b (std::string)))
      (if (not (de_unhex hex b)) (return -2))
      (if (< (($ b size)) 2) (return -3))
      (let ((size_t p . 2) (int t . #'(cast int (cast u8 (nth 0 b)))) (int l0 . #'(cast int (cast u8 (nth 1 b)))) (u64 n . 0))
        (if (< l0 128)
            (set n (cast u64 l0))
            (let ((size_t k . #'(cast size_t (bitand l0 127))))
              (if (or (== k 0) (> k 8)) (return -3))
              (if (> (+ p k) (($ b size))) (return -3))
              (for ((size_t i . 0)) (< i k) ((++ i))
                (set n (bitor (<< n 8) (cast u64 (cast u8 (nth p b)))))
                (set p (+ p 1)))))
        (if (> n (- (($ b size)) p)) (return -3))
        (set (cof tag) (cast long t))
        (letin* ((v (($ b substr) p (cast size_t n)))
                 (r (($ b substr) (+ p (cast size_t n)) (- (($ b size)) (+ p (cast size_t n))))))
          (if (not (de_tohex v value vcap)) (return -4))
          (if (not (de_tohex r rest rcap)) (return -4))
          (return 0)))))

  ;;; A tag and its content, wrapped: what makes a sequence, a set or a
  ;;; context tag out of the bytes the Prolog side already built.
  (static) (func coco_der_wrap ((long tag) (const char * content_hex) (char * out) (size_t cap)) (out int)
    (letin* ((bytes (std::string)))
      (if (not (de_unhex content_hex bytes)) (return -2))
      (if (or (< tag 0) (> tag 255)) (return -2))
      (try
        (block
          (letin* ((len (Zigurat::bufferstream)) (s (std::string)))
            (Zigurat::DER::encode_length len (($ bytes size)))
            (($ s push_back) (cast char (cast u8 tag)))
            (set s (+ s (($ len string))))
            (set s (+ s bytes))
            (return (? (de_tohex s out cap) 0 -4))))
        (catch () (return -5)))))

  ;;; ---- the Cicili side: arguments, errors, dispatch ------------------
  ;;;
  ;;; The buffers are 262144 hex characters -- 128 KiB of DER, which is a
  ;;; long certificate chain and then some. Written out as numbers rather
  ;;; than as a `#define': a `#define' is raw C, so Cicili cannot see it
  ;;; and a form naming one fails with `unknown symbol'.

  (static) (func dr_fail ((coco_engine * e) (int rc) (size_t kind) (size_t data))
                 (out int)
    (cond
      ((== rc -1) (return (coco_m_domain_error e "der_kind" kind)))
      ((== rc -2) (return (coco_m_type_error e "a value of that DER kind" data)))
      ((== rc -3) (return (coco_m_error e "der_error" "the bytes are not well formed DER")))
      ((== rc -4) (return (coco_m_error e "representation_error" "der buffer")))
      ((== rc -7) (return (coco_m_error e "der_error" "a bit string with unused bits is not bit_string/1")))
      (#t (return (coco_m_error e "der_error" "the encoder refused")))))

  (static) (func dr_p_prim ((coco_engine * e) (size_t g)) (out int)
    (coco-mod-args e g ((sk 0) (sv 1) (sr 2))
      (let ((char kind [64]) (char val [262144]) (char out [262144]))
        (if (not (coco_m_text e sk kind 64))
            (return (coco_m_type_error e "an atom naming a DER kind" sk)))
        ;; AN EMPTY VALUE IS LEGITIMATE -- `null' has none, and an empty
        ;; octet string is a thing a certificate really carries -- so a
        ;; failed read is only an error when the term is not text at all.
        (if (not (coco_m_text e sv val 262144)) (set (nth 0 val) 0))
        (let ((int rc . #'(coco_der_prim kind val out 262144)))
          (if (!= rc 0) (return (dr_fail e rc sk sv)))
          (return (coco_m_unify_atom e sr out))))))

  (static) (func dr_p_unprim ((coco_engine * e) (size_t g)) (out int)
    (coco-mod-args e g ((sk 0) (sh 1) (sr 2))
      (let ((char kind [64]) (char hex [262144]) (char out [262144]))
        (if (not (coco_m_text e sk kind 64))
            (return (coco_m_type_error e "an atom naming a DER kind" sk)))
        (if (not (coco_m_text e sh hex 262144))
            (return (coco_m_type_error e "a hexadecimal atom" sh)))
        (let ((int rc . #'(coco_der_unprim kind hex out 262144)))
          (if (!= rc 0) (return (dr_fail e rc sk sh)))
          (return (coco_m_unify_atom e sr out))))))

  (static) (func dr_p_tlv ((coco_engine * e) (size_t g)) (out int)
    (coco-mod-args e g ((sh 0) (st 1) (sv 2) (sr 3))
      (let ((char hex [262144]) (char val [262144]) (char rest [262144])
            (long tag . 0))
        (if (not (coco_m_text e sh hex 262144))
            (return (coco_m_type_error e "a hexadecimal atom" sh)))
        (let ((int rc . #'(coco_der_tlv hex (aof tag) val 262144 rest 262144)))
          (if (!= rc 0) (return (dr_fail e rc sh sh)))
          (if (not (coco_m_unify_int e st (cast i64 tag))) (return 0))
          (if (not (coco_m_unify_atom e sv val)) (return 0))
          (return (coco_m_unify_atom e sr rest))))))

  (static) (func dr_p_wrap ((coco_engine * e) (size_t g)) (out int)
    (coco-mod-args e g ((st 0) (sc 1) (sr 2))
      (let ((char hex [262144]) (char out [262144]) (i64 tag . 0))
        (if (not (coco_m_int e st (aof tag)))
            (return (coco_m_type_error e "an integer tag" st)))
        (if (not (coco_m_text e sc hex 262144)) (set (nth 0 hex) 0))
        (let ((int rc . #'(coco_der_wrap (cast long tag) hex out 262144)))
          (if (!= rc 0) (return (dr_fail e rc st sc)))
          (return (coco_m_unify_atom e sr out))))))

  (extern-c
    (coco-emit-module-dispatch coco_der_dispatch *der-predicates*)
    (coco-deflibrary "der" coco_der_dispatch *der-prolog*)))

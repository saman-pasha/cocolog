;;;; cocolog -- the program
;;;
;;; A driver over the interpreter in lib/cocolog. What it is for, beyond being
;;; a way to run a query, is the `step' command: run a machine for a fixed
;;; number of inferences and then SUSPEND it back into the database. That turns
;;; the database into a run queue and any number of processes into workers on
;;; it -- which is the arrangement the whole design was for, and demo/turns.sh
;;; is it running.
;;;
;;; Usage:
;;;
;;;   cocolog [options] consult FILE...     read programs into the knowledge base
;;;   cocolog [options] query GOAL          prove it here and now
;;;   cocolog [options] run FILE... [GOAL]  consult and prove, in one process;
;;;                                          GOAL defaults to `main'. The shape
;;;                                          of `swipl -q -g GOAL -t halt FILE'
;;;   cocolog [options] start NAME GOAL     begin a machine and suspend it
;;;   cocolog [options] step NAME           run it a while and suspend it again
;;;   cocolog [options] finish NAME         run it to the end
;;;   cocolog [options] work WORKER [MACHINE]
;;;                                          claim machines and advance them;
;;;                                          with MACHINE, only that one
;;;   cocolog [options] forget [NAME ARITY] empty the knowledge base, or one
;;;                                          predicate of it
;;;   cocolog [options] list                what machines are suspended
;;;   cocolog [options] drop NAME           forget one
;;;
;;;   --kb NAME      which knowledge base   (default main)
;;;   --host HOST    (default 127.0.0.1)
;;;   --port PORT    the binary protocol    (default 2160)
;;;   --http PORT    read over Zeytun instead of the binary protocol
;;;   --local        no database at all: everything in memory
;;;   --steps N      inferences per `step'  (default 2000)
;;;   --timeout S    socket timeout, seconds (default 20)
;;;   --lock PATH    make cocolog processes take turns through PATH, for a
;;;                  server whose storage engine is not concurrency safe;
;;;                  `auto' names one per host and port. Off by default.
;;;   --answers N    stop after N solutions (default 10, 0 for all)
;;;
;;; WHY `step' PRINTS NOTHING MUCH. It is meant to be run by a script, over and
;;; over, possibly by several processes at once. What it says is whether the
;;; machine finished, and if so with what.

;;;; ------------------------------------------------------------------
;;;; What one turn came to
;;;; ------------------------------------------------------------------
;;; A WORKER HAS TO TELL FOUR THINGS APART, and only one of them used to have
;;; a name. `step\' answered 0, 1 or 2 -- finished, something went wrong, more
;;; to do -- which is enough for a person at a terminal and not enough for a
;;; worker, because "something went wrong" covers both the case where running
;;; it again is pointless (the program is bad) and the case where running it
;;; again is exactly right (the connection went and nothing was committed).
;;; Under one worker the two never had to be told apart. Under four they are
;;; the difference between recovering and giving up.
;;;
;;; The table is here rather than as three defines so that the codes and the
;;; reasons cannot drift apart, and so `turn-is\' folds to a comparison
;;; against a literal.
(DEFPARAMETER *turn-outcomes*
  '((FINISHED 0 "proved out; the machine is gone from the database")
    (FAILED   1 "the program is wrong -- running it again goes wrong again")
    (MORE     2 "suspended with work left, and committed")
    (LOST     3 "the connection ended mid-turn. NOTHING was committed, so the
                 turn did not happen and may simply be done again")))

(DEFUN turn-value (name)
  (LET ((row (ASSOC name *turn-outcomes* :TEST #'STRING=)))
    (UNLESS row (ERROR "cocolog: unknown turn outcome ~A" name))
    (SECOND row)))

;;; the code itself, for a `return\'
(DEFMACRO turn (name) (turn-value name))

;;; whether a code is that outcome
(DEFMACRO turn-is (name v) `(== ,v ,(turn-value name)))

(source "cocolog.c"
  (make :std #t
        :compile ("-Iclient"
                  "-c" "cocolog.c")
        :link ("-lcocolog.o"
               "-Lbuild"
               "-lcocologc" "-lm" "-lpthread" "-o" "cocolog"))

  (include <math.h>)
  ;; the swarm command's worker threads
  (include <pthread.h>)
  ;; usleep, for the worker that waits its turn on a machine another worker
  ;; is holding. lib/std/c/posix declares it for inference; the header still
  ;; has to be included by the target that emits code.
  (include <unistd.h>)
  ;; the Files module reaches stat, opendir, glob and realpath
  (include <sys/stat.h>)
  (include <sys/types.h>)
  (include <dirent.h>)
  (include <glob.h>)
  (include <limits.h>)
  (include <zigurat.h>)
  (include <zeytun.h>)

  (import "./lib/zigurat.cicili" :zg)
  (import "./lib/zeytun.cicili" :zt)
  (import "./lib/term.cicili")
  (import "./lib/syntax.cicili")
  (import "./lib/dcg.cicili")
  (import "./lib/kb.cicili")
  (import "./lib/solve.cicili")
  (import "./lib/module.cicili")
  (import "./lib/files.cicili")
  (import "./lib/lists.cicili")
  (import "./lib/apply.cicili")
  (import "./lib/builtins.cicili")
  (import "./lib/state.cicili")
  (import "./lib/zigurat-kb.cicili")
  (import "./lib/zeytun-kb.cicili")

  (decl-term)   (impl-term)
  (decl-syntax) (impl-syntax)
  ;; the grammar-rule translator comes BEFORE the knowledge base, because
  ;; `coco_assert' calls it: every clause reaching the store passes through
  ;; there, so that is the one place a `-->' rule can be rewritten no matter
  ;; whether it was consulted from a file or asserted by a running program.
  (decl-dcg)    (impl-dcg)
  (decl-kb)     (impl-kb)
  (decl-solve)  (impl-solve)
  (decl-module) (impl-module)
  (decl-files)  (impl-files)
  (decl-lists)  (impl-lists)
  (decl-apply)  (impl-apply)
  (decl-builtins) (impl-builtins)
  ;; ...and the half that needs an engine comes after there is one
  (decl-dcg-module) (impl-dcg-module)
  (decl-state)  (impl-state)
  (decl-zigurat-kb) (impl-zigurat-kb)
  (decl-zeytun-kb)  (impl-zeytun-kb)

  ;;; Everything the command line said, in one place.
  (struct coco_opts
    (member const char * kb)
    (member const char * host)
    (member const char * port)
    (member const char * http)
    (member int          local)
    (member u64          steps)
    ;; Seconds a socket operation may block. Short in a test, because a worker
    ;; that is waiting on a server that will never answer should say so quickly
    ;; rather than sit there for the default.
    (member int          timeout)
    (member int          answers)
    ;; Where cocolog processes take turns, so that no two of them are inside
    ;; ZiguratIP's storage engine at once. Null means "work one out from the
    ;; host and port"; the string "none" means do not take turns at all.
    (member const char * lock)
    ;; A directory for the EMBEDDED knowledge base: the store lives inside
    ;; this process, no server and no socket. Needs a build that linked the
    ;; embedded engine -- `make embed' -- and belongs to one process at a
    ;; time: concurrency inside it is the `swarm' command's threads.
    (member const char * store)
    ;; Where each swarm worker writes what it did (DIR/WORKER.log); null
    ;; means everybody onto stdout together.
    (member const char * outdir))

  (var coco_opts opts . '{ "main" "127.0.0.1" "2160" nil 0 2000 20 10 nil nil nil })

  ;;; The one connection, when there is one. THREAD-LOCAL, because the
  ;;; `swarm' command runs one worker per thread and each opens its own:
  ;;; everything below reaches the connection of the thread it runs on,
  ;;; and a single-threaded command sees exactly what it always did.
  (thread-local) (var zg_conn * db . nil)

  ;;; Where this thread's worker narrates -- answers, took/suspended lines,
  ;;; the closing summary. stdout, until a swarm thread points it at the
  ;;; worker's own log file so twelve narrations do not interleave.
  (thread-local) (var FILE * wlog . nil)
  (func wout () (out FILE *) (return (? (== wlog nil) stdout wlog)))

  ;;; HOW LONG A WORKER WAITS, and why there are two numbers rather than one.
  ;;;
  ;;; POLL is how often a worker with nothing to do asks again. Short, because
  ;;; the machine it wants is usually in the middle of somebody else's turn and
  ;;; will be free in milliseconds.
  ;;;
  ;;; YIELD is how long a worker waits after FINISHING a turn, before claiming
  ;;; anything again -- and it is deliberately longer than POLL. Without it the
  ;;; worker that has just put a machine down is the one that picks it up:
  ;;; it is already awake, already connected, and its partner is asleep between
  ;;; polls. One worker then runs the whole machine and the other never gets a
  ;;; turn, which passes every test about ANSWERS and quietly fails the thing
  ;;; the design is actually for. Waiting longer than a poll hands the next
  ;;; turn to whoever is waiting, and costs a worker running alone twenty
  ;;; milliseconds a turn.
  (var const useconds_t COCO_POLL_US  . 5000)
  (var const useconds_t COCO_YIELD_US . 20000)

  ;;; How many consecutive polls a worker will wait for a machine that exists
  ;;; but is claimed by somebody else. At COCO_POLL_US that is about a minute --
  ;;; long enough that a busy partner is never mistaken for a dead one, short
  ;;; enough that a machine stranded by a worker that was killed mid-turn does
  ;;; not keep the rest waiting for ever.
  (var const int COCO_IDLE_LIMIT . 12000)

  ;;; How many polls in a row a machine has to be out of sight before a worker
  ;;; believes it has finished rather than being mid-save.
  ;;;
  ;;; IT USED TO BE THREE HUNDRED, and the story of how it got to two is the
  ;;; story of two bugs in the database it talks to. Saving a machine deletes its
  ;;; row and inserts a replacement. A reader at READ COMMITTED first WAITED on
  ;;; the old row's lock -- and by the time the wait ended the old version had
  ;;; been retired and the new one was at an address the reader had gone past, so
  ;;; a machine being saved did not exist as far as its partners were concerned,
  ;;; for as long as the save took. Under load those windows ran together and a
  ;;; fifth of a second of absence proved nothing.
  ;;;
  ;;; With the wait gone, what was left was the narrower version of the same
  ;;; thing: a scan spans time, so one that passed the replacement before it was
  ;;; committed could still reach the original after it was retired.
  ;;;
  ;;; Both are fixed in ZiguratIP. A reader takes the version that was current
  ;;; when its statement began, decided against a microsecond clock, so a machine
  ;;; being saved is there throughout and is there exactly once. `exists' is now
  ;;; an answer rather than a symptom.
  ;;;
  ;;; Two polls, then, and not none -- a worker's `exists' and its next `claim'
  ;;; are separate transactions, and a partner may drop the machine between them.
  ;;; Asking twice costs ten milliseconds and covers it. And a number like this
  ;;; is allowed to be a judgement in the first place because what it decides is
  ;;; only WHEN A WORKER GOES HOME: it cannot make two workers advance one
  ;;; machine, lose a turn, or produce an answer twice. The claim settles all of
  ;;; that exactly, inside one SERIALIZABLE transaction.
  (var const int COCO_GONE_CONFIRM . 2)

  ;;; And how long a worker waits for a machine it has NEVER SEEN. Much longer,
  ;;; because absence means something different before the first sighting: not
  ;;; "it finished" but "it is not there yet". A worker started before the
  ;;; machine it is meant to help with -- which is the sane way to start a pool,
  ;;; and the only way to start twelve of them without the first few finishing
  ;;; the work before the last are running -- would otherwise decide in a second
  ;;; and a half that there was never anything to do.
  (var const int COCO_APPEAR_LIMIT . 4000)

  (func usage ()
        (fprintf stderr "cocolog -- a Prolog interpreter with its knowledge base in Zigurat\n\n")
        (fprintf stderr "  cocolog [options] consult FILE...\n")
        (fprintf stderr "  cocolog [options] query GOAL\n")
        (fprintf stderr "  cocolog [options] start NAME GOAL\n")
        (fprintf stderr "  cocolog [options] step NAME\n")
        (fprintf stderr "  cocolog [options] finish NAME\n")
        (fprintf stderr "  cocolog [options] work WORKER [MACHINE]\n")
        (fprintf stderr "  cocolog [options] swarm WORKER MACHINE [WORKER MACHINE...]\n")
        (fprintf stderr "  cocolog [options] forget [NAME ARITY]\n")
        (fprintf stderr "  cocolog [options] list\n")
        (fprintf stderr "  cocolog [options] drop NAME\n\n")
        (fprintf stderr "  --kb NAME     knowledge base            (default main)\n")
        (fprintf stderr "  --host HOST   (default 127.0.0.1)\n")
        (fprintf stderr "  --port PORT   binary protocol           (default 2160)\n")
        (fprintf stderr "  --http PORT   read over Zeytun instead\n")
        (fprintf stderr "  --local       no database; all in memory\n")
        (fprintf stderr "  --steps N     inferences per step       (default 2000)\n")
        (fprintf stderr "  --timeout S   socket timeout in seconds  (default 20)\n")
        (fprintf stderr "  --answers N   stop after N solutions    (default 10, 0 for all)\n")
        (fprintf stderr "  --lock PATH   take turns through PATH, for a server that\n")
        (fprintf stderr "                cannot take concurrent clients; `auto' names\n")
        (fprintf stderr "                one per host and port. Off by default.\n")
        (fprintf stderr "  --store DIR   the knowledge base EMBEDDED in this process,\n")
        (fprintf stderr "                no server (needs a `make embed' build)\n")
        (fprintf stderr "  --out DIR     swarm only: each worker logs to DIR/WORKER.log\n"))

  ;;; Reads a whole file. Answers nil if it cannot, with the reason printed.
  (func slurp ((const char * path)) (out char *)
        (let ((FILE * f . #'(fopen path "rb")) (char * buf . nil) (long n . 0))
          (if (== f nil)
              (block (fprintf stderr "cocolog: cannot read %s\n" path) (return nil)))
          (fseek f 0 SEEK_END)
          (set n (ftell f))
          (fseek f 0 SEEK_SET)
          (set buf (cast (char *) (malloc (cast size_t (+ n 1)))))
          (if (== buf nil) (block (fclose f) (return nil)))
          (fread buf 1 (cast size_t n) f)
          (set (nth n buf) (cast char 0))
          (fclose f)
          (return buf)))

  ;;; The query as it now stands -- which is the answer. Writing the query
  ;;; rather than a list of variable bindings is deliberate: a machine that has
  ;;; been suspended and resumed no longer has the variable NAMES, because
  ;;; those belong to the text that was read and not to the machine. The
  ;;; instantiated goal says the same thing and survives the round trip.
  ;;;
  ;;; IT IS COLLECTED RATHER THAN PRINTED, and INTO is where. A turn's answers
  ;;; are only true if the turn's state reaches the database: a worker that
  ;;; printed as it went and then lost its connection would have announced
  ;;; answers the rolled-back machine is going to produce again on the next
  ;;; turn, and the same answer twice is exactly what a suspendable machine
  ;;; must never do. So a turn buffers what it found and prints it after the
  ;;; commit, and a turn that fails throws the buffer away with the work.
  (func show_answer ((coco_engine * e) (int n) (coco_strbuf * into))
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_term ($ (cof e) m) (aof b) ($ (cof e) query) 0 0)
          (if (== into nil)
              (printf "  %d. %s\n" n (? (== ($ b s) nil) "true" ($ b s)))
            (block (coco_sb_put into "  ")
                   (coco_sb_put_i64 into (cast i64 n))
                   (coco_sb_put into ". ")
                   (coco_sb_put into (? (== ($ b s) nil) "true" ($ b s)))
                   (coco_sb_putc into (cast char 10))))
          (coco_sb_free (aof b))))

  ;;; Opens the connection the options ask for, or leaves db null for --local.
  ;;;
  ;;; NOT CALLED `connect'. It was, and the program recursed until the stack
  ;;; ran out: connect(2) is what the client calls to open its socket, and a
  ;;; global function of that name in the program takes the link ahead of the
  ;;; one in libc. Nothing warns -- it links, it runs, and it dies twenty
  ;;; thousand frames later inside a function that never called itself.
  (func open_connection () (out int)
        (let ((char err [512]) (char turnfile [512]) (const char * path))
          (if ($ opts local) (return 1))
          (if (!= ($ opts store) nil)
              (block
                (set db (zg_open_embed ($ opts store) err (sizeof err)))
                (if (== db nil)
                    (block (fprintf stderr "cocolog: no embedded store at %s -- %s\n"
                                    ($ opts store) err)
                           (return 0)))
                (return 1)))
          (set db (zg_open ($ opts host) ($ opts port) ($ opts timeout) err (sizeof err)))
          (if (== db nil)
              (block (fprintf stderr "cocolog: no server at %s:%s -- %s\n"
                              ($ opts host) ($ opts port) err)
                     (return 0)))

          ;; TAKING TURNS IS OFF BY DEFAULT, AND THAT IS THE WHOLE POINT OF THE
          ;; PROJECT. Interpreters that queue behind one another are not
          ;; concurrent interpreters; they are one interpreter with extra
          ;; processes. So cocolog talks to the server the way any client
          ;; should -- all at once -- and the server is expected to cope.
          ;;
          ;; IT EXISTS AT ALL because for a while the server did not cope, and
          ;; the reason is worth keeping to hand. ZiguratIP serves every
          ;; connection on its own thread but through ONE shared pair of page
          ;; streams, and an indexed WHERE walked its B-tree straight through
          ;; them holding no lock at all: two clients at once read from each
          ;; other's file position, which surfaced as `hexmap ends inside the
          ;; chunk at NNNNN' and, often enough, as a dead server and a store
          ;; that had to be thrown away. That is fixed in ZiguratIP itself now
          ;; (MVCCS/memory.hpp, Memory::Streams) rather than worked around
          ;; here.
          ;;
          ;;   --lock PATH   take turns through PATH, for a server that has not
          ;;                 got the fix. One flock(2) per transaction: correct,
          ;;                 and about as concurrent as a queue.
          ;;   --lock auto   the same, through a file named for the host and
          ;;                 port, so everything talking to one server queues
          ;;                 together and two servers do not queue behind each
          ;;                 other.
          (set path ($ opts lock))
          (if (and (!= path nil) (== 0 (strcmp path "auto")))
              (block
               (let ((const char * tmp . #'(getenv "TMPDIR")))
                 (if (or (== tmp nil) (== (nth 0 tmp) (cast char 0))) (set tmp "/tmp"))
                 (snprintf turnfile (sizeof turnfile) "%s/cocolog-%s-%s.turn"
                           tmp ($ opts host) ($ opts port))
                 (set path turnfile))))
          (if (and (!= path nil) (== 0 (strcmp path "none"))) (set path nil))
          (if (not (zg_serialise db path ($ opts timeout)))
              (block (fprintf stderr "cocolog: %s\n" (zg_error db)) (return 0)))
          (return 1)))

  ;;; ---- the commands ------------------------------------------------------

  (func cmd_consult ((int argc) (char ** argv) (int from)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_zg z) (char err [256]) (int total . 0))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (if (not ($ opts local)) (coco_zg_attach (aof z) db (aof m) (aof st) ($ opts kb)))
          (for ((int i . from)) (< i argc) ((++ i))
            (let ((char * text . #'(slurp (nth i argv))) (int n))
              (if (== text nil) (block (coco_store_free (aof st)) (coco_machine_free (aof m))
                                       (return 1)))
              (set n (coco_consult (aof st) (aof m) text err (sizeof err)))
              (free text)
              (if (< n 0)
                  (block (fprintf stderr "cocolog: %s: %s\n" (nth i argv) err)
                         (coco_store_free (aof st)) (coco_machine_free (aof m))
                         (return 1)))
              (set total (+ total n))))
          (if (!= db nil) (zg_commit db))
          (printf "consulted %d clause(s) into '%s'\n" total ($ opts kb))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return 0)))

  ;;; Attaches whichever backend the options asked for. Both fill in the same
  ;;; hook; nothing below this line knows which.
  (func attach ((coco_zg * z) (coco_zt * zt) (coco_machine * m) (coco_store * st))
        (if ($ opts local) (return))
        (if (!= ($ opts http) nil)
            (coco_zt_attach zt ($ opts host) ($ opts http) m st ($ opts kb))
          (coco_zg_attach z db m st ($ opts kb))))

  (func cmd_query ((const char * goal)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_engine e) (coco_zg z) (coco_zt zt)
              (int n . 0) (int rc . 1))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_engine_init (aof e) (aof m) (aof st))
          (set ($ e max_steps) 0)
          (attach (aof z) (aof zt) (aof m) (aof st))

          (if (not (coco_engine_ask_text (aof e) goal))
              (block (fprintf stderr "cocolog: %s\n" ($ e err)) (return 1)))
          (while 1
            (set rc (coco_engine_next (aof e)))
            (if (!= rc 1) break)
            (set n (+ n 1))
            (show_answer (aof e) n nil)
            (if (and (!= ($ opts answers) 0) (>= n ($ opts answers))) break))
          (if (== rc -1) (fprintf stderr "cocolog: %s\n" ($ e err)))

          ;; A QUERY CAN WRITE. `assert', `retract' and `dynamic' reach the
          ;; database through the store's hooks, and until this commit was here
          ;; every one of them was rolled back when the connection closed: the
          ;; goal succeeded, said so, and changed nothing. A query that ended in
          ;; an error is rolled back instead, whole -- half of a failed goal's
          ;; assertions is not a state any program asked for.
          (if (!= db nil)
              (if (== rc -1) (zg_rollback db) (zg_commit db)))

          (if (== n 0) (printf "false.\n") (printf "%d answer(s).\n" n))
          (coco_engine_free (aof e))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return (? (== rc -1) 1 0))))

  ;;; Begins a machine and suspends it before it has done anything. What that
  ;;; is for: the machine exists in the database from this moment, so any
  ;;; worker can pick it up.
  (func cmd_start ((const char * name) (const char * goal)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_engine e) (coco_zg z))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: start needs a database\n") (return 1)))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_engine_init (aof e) (aof m) (aof st))
          (set ($ e max_steps) 0)
          (coco_zg_attach (aof z) db (aof m) (aof st) ($ opts kb))
          (if (not (coco_engine_ask_text (aof e) goal))
              (block (fprintf stderr "cocolog: %s\n" ($ e err)) (return 1)))
          (if (not (coco_zg_save (aof z) (aof e) name goal))
              (block (fprintf stderr "cocolog: %s\n" ($ z err)) (return 1)))
          (zg_commit db)
          (printf "started '%s'\n" name)
          (coco_engine_free (aof e))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return 0)))

  ;;; THE COMMAND THE DESIGN IS FOR. Pick a machine up, run it for a bounded
  ;;; number of inferences, and put it back. A worker that does this in a loop
  ;;; is a scheduler; several of them are a scheduler with several workers, and
  ;;; the database is the run queue.
  ;;;
  ;;; BUDGET IS NOT AN ERROR. The engine answers -1 when the step limit is
  ;;; reached, the same as for a real error -- so the two are told apart by
  ;;; asking whether the machine ran out of budget rather than by the code.
  ;;;
  ;;; A TURN IS ALL OR NOTHING, AND THAT IS WHAT MAKES A RETRY SAFE. The load,
  ;;; the proving, the save and the commit are one unit: either the commit
  ;;; lands and the turn's answers are printed, or the connection went and the
  ;;; server rolled the whole transaction back and NOTHING is printed. Nothing
  ;;; reaches the terminal from a turn that did not reach the database, so a
  ;;; worker that redials and does the turn again cannot announce an answer
  ;;; twice -- and announcing an answer twice is precisely the failure a
  ;;; suspendable machine exists to avoid.
  ;;;
  ;;; Every call is checked for the same reason. An unchecked commit was the
  ;;; original sin here: it made a turn that had actually been rolled back look
  ;;; exactly like a turn that had been saved.
  (func cmd_step ((const char * name) (int to_the_end)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_engine e) (coco_zg z) (coco_strbuf out)
              (int n . 0) (int rc . 1) (int done . 0)
              (int outcome . 0) (int broke . 0))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: step needs a database\n")
                     (return (turn FAILED))))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_engine_init (aof e) (aof m) (aof st))
          (coco_sb_init (aof out))
          (coco_zg_attach (aof z) db (aof m) (aof st) ($ opts kb))
          (set outcome (turn FAILED))

          ;; ONE WAY OUT. There are now six things that can go wrong here and
          ;; every one of them has three structures to free, so the body is a
          ;; run-once loop and the freeing is written once after it. The old
          ;; shape returned from the middle and leaked the machine each time.
          (while 1
            (if (not (coco_zg_load (aof z) (aof e) (aof m) (aof st) name))
                (block (fprintf stderr "cocolog: %s\n" ($ z err))
                       (set outcome (? (zg_is_open db) (turn FAILED) (turn LOST)))
                       break))

            ;; The budget is counted from where this machine already was, so a
            ;; machine resumed after a million inferences gets its own slice
            ;; and not what is left of somebody else's.
            (set ($ e max_steps) (? to_the_end 0 (+ ($ e steps) ($ opts steps))))

            (while 1
              (set rc (coco_engine_next (aof e)))
              (if (!= rc 1) break)
              (set n (+ n 1))
              (show_answer (aof e) n (aof out))
              (if (and (!= ($ opts answers) 0) (>= n ($ opts answers)))
                  (block (set done 1) break)))

            ;; A proof with no clauses left to try is finished. So is one that
            ;; broke -- but that is the program's fault and it will break the
            ;; same way next time, so it is FAILED and not something to retry.
            (if (== rc 0) (set done 1))
            (if (and (== rc -1) (== 0 (strcmp ($ e err) "inference limit reached")))
                (set done 0)
              (if (== rc -1)
                  (block (fprintf stderr "cocolog: %s\n" ($ e err))
                         (set done 1)
                         (set broke 1))))

            ;; The database half. Anything that fails in here takes the turn
            ;; with it, and the answer buffer goes unprinted along with it.
            (if done
                (if (not (coco_zg_drop (aof z) name))
                    (block (fprintf stderr "cocolog: %s\n" ($ z err))
                           (set outcome (? (zg_is_open db) (turn FAILED) (turn LOST)))
                           break))
              (if (not (coco_zg_save (aof z) (aof e) name "suspended by step"))
                  (block (fprintf stderr "cocolog: %s\n" ($ z err))
                         (set outcome (? (zg_is_open db) (turn FAILED) (turn LOST)))
                         break)))

            ;; AN UNCHECKED COMMIT WAS THE ORIGINAL SIN HERE. It made a turn
            ;; the server had rolled back look exactly like a turn that was
            ;; saved, so a worker printed answers for work that had not
            ;; happened and then did the same work again.
            (if (not (zg_commit db))
                (block (fprintf stderr "cocolog: %s: commit: %s\n" name (zg_error db))
                       (set outcome (turn LOST))
                       break))

            ;; Committed. Only now is any of it true.
            (if (!= ($ out s) nil) (fputs ($ out s) (wout)))
            (if done
                (fprintf (wout) "%s: finished after %llu inference(s), %d answer(s) this turn\n"
                        name (cast ullong ($ e steps)) n)
              (fprintf (wout) "%s: suspended at %llu inference(s), %d answer(s) this turn\n"
                      name (cast ullong ($ e steps)) n))
            (set outcome (? done (? broke (turn FAILED) (turn FINISHED)) (turn MORE)))
            break)

          (coco_sb_free (aof out))
          (coco_engine_free (aof e))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return outcome)))

  ;;; Redials, in place, after the server ended the connection.
  ;;;
  ;;; WHY A WORKER HAS TO BE ABLE TO DO THIS AT ALL. ZiguratIP's request loop
  ;;; answers every exception the same way: it writes EXCEPTION_THROWN and
  ;;; breaks out of the loop, so a refusal ends the CONNECTION and not merely
  ;;; the call. Under one client that never shows -- a client that got an error
  ;;; was usually about to stop anyway. Under four it shows constantly, because
  ;;; the storage engine raises transient errors when two threads are in it at
  ;;; once (MVCCS/memory.cpp, Memory::_pointer, which seeks and reads the
  ;;; shared hexmap stream without holding the mutex that truncate takes). The
  ;;; error is not damage -- the store is intact afterwards and the work simply
  ;;; did not happen -- so the answer is to dial again and do the turn over.
  ;;;
  ;;; IT IS THE SAME zg_conn AFTERWARDS. Everything holding the connection --
  ;;; every coco_zg attached to it -- keeps working, which closing and reopening
  ;;; would not allow.
  ;;;
  ;;; The wait grows with ATTEMPT and is nudged by the pid, so two workers that
  ;;; collided do not come back at the same instant and collide again.
  (func recover ((const char * worker) (int attempt)) (out int)
        (let ((useconds_t back . 0))
          (if (== db nil) (return 0))
          (set back (cast useconds_t (* 2000 (+ 1 (% (cast int (getpid)) 5)))))
          (set back (cast useconds_t (* (cast int back) (+ 1 attempt))))
          (usleep back)
          (if (not (zg_reopen db ($ opts host) ($ opts port) ($ opts timeout)))
              (block (fprintf stderr "%s: cannot redial %s:%s -- %s\n"
                              worker ($ opts host) ($ opts port) (zg_error db))
                     (return 0)))
          (return 1)))

  ;;; Puts a machine back in the pool. Best effort by nature: it is called
  ;;; where a turn has already gone wrong.
  ;;;
  ;;; WHY IT IS NEEDED. The claim is committed before the machine is touched,
  ;;; so a worker whose connection dies during the turn leaves the machine
  ;;; marked as its own with none of the work done -- claimed by a worker that
  ;;; is no longer doing anything about it. Nothing else would ever pick it up:
  ;;; a claim looks only for `suspended'. So the worker that broke puts it
  ;;; back itself, on its new connection.
  (func release ((const char * worker) (const char * name)) (out int)
        (let ((zg_result_t r))
          (if (not (zg_call db "cocolog::machine_release"))
              (block (fprintf stderr "%s: release '%s': %s\n" worker name (zg_error db))
                     (return 0)))
          (if (not (zg_write_string db name)) (return 0))
          (while 1
            (if (not (zg_result db (aof r))) (return 0))
            (if (== r ZG_SUCCESSFUL_DONE) break)
            (cond
              ((== r ZG_RETURN_VALUE) (zg_skip_field db))
              ((== r ZG_CURSOR_FETCH) break)
              (#t (block))))
          (return (? (zg_commit db) 1 0))))

  ;;; Whether a machine is still in the database at all: 1 yes, 0 gone,
  ;;; -1 the call did not happen.
  ;;;
  ;;; This is what tells a worker whose claim came back empty whether to wait or
  ;;; to stop. `cocolog::machine_claim_named' answers the same empty string for
  ;;; "somebody else has it" and for "there is no such machine", and those are
  ;;; opposite instructions.
  ;;; Looks at a machine without touching it. Answers -1 for a lost connection,
  ;;; 0 if there is no such row, 1 if there is one somebody else is holding, and
  ;;; 2 if there is one nobody holds.
  ;;;
  ;;; TELLING 1 FROM 2 IS WHAT MAKES A CROWD CHEAP. A worker whose machine is
  ;;; busy used to find that out by ATTEMPTING THE CLAIM -- a write transaction,
  ;;; at SERIALIZABLE, committed, several times a second, per waiting worker.
  ;;; Twelve workers over four machines meant eight of them were always doing
  ;;; that, and the eight idle ones cost more than the four doing the work: the
  ;;; same run took 8s with one worker per machine and 52s with three. This is a
  ;;; read at the default level and it answers the same question.
  ;;;
  ;;; It is only ever a HINT. Between this answering 2 and the claim landing, a
  ;;; partner may have taken the machine -- so the claim stays exactly as
  ;;; atomic as it was, and a claim that comes back empty is still the truth.
  (func exists ((const char * worker) (const char * name)) (out int)
        (let ((zg_result_t r) (char cols [256]) (int rows . 0) (int free . 0))
          (if (not (zg_call db "cocolog::machine_find")) (return -1))
          (if (not (zg_write_string db name)) (return -1))
          (while 1
            (if (not (zg_result db (aof r)))
                (block (fprintf stderr "%s: machine_find: %s\n" worker (zg_error db))
                       (return -1)))
            (if (== r ZG_SUCCESSFUL_DONE) break)
            (cond
              ((== r ZG_CURSOR_OPEN) (zg_columns db cols 256))
              ((== r ZG_CURSOR_FETCH)
               (let ((i64 id . 0) (char kb [128]) (char status [128]) (i32 chunks . 0))
                 (if (not (zg_read_long db (aof id) nil)) (return -1))
                 (if (not (zg_read_string db kb (sizeof kb) nil)) (return -1))
                 (if (not (zg_read_string db status (sizeof status) nil)) (return -1))
                 (if (not (zg_read_int db (aof chunks) nil)) (return -1))
                 ;; `suspended' is what machine_claim_named looks for; anything
                 ;; else in this column is the name of the worker holding it
                 (if (== 0 (strcmp status "suspended")) (set free 1))
                 (set rows (+ rows 1))))
              ((== r ZG_RETURN_VALUE) (zg_skip_field db))
              (#t (block))))
          (if (not (zg_commit db)) (return -1))
          (if (== rows 0) (return 0))
          (return (? free 2 1))))

  ;;; Claims one suspended machine for this worker, atomically.
  ;;;
  ;;;   1  it is ours, and NAME says which
  ;;;   0  nothing is free -- either the queue is empty or another worker has it
  ;;;  -1  the call did not happen: the connection is gone
  ;;;
  ;;; THOSE THREE USED TO BE TWO, and the missing one cost a day. A claim that
  ;;; answered 0 for both "nobody is waiting" and "the server hung up" made a
  ;;; worker whose connection had just died print `nothing left to do' and exit
  ;;; successfully, while the machine it had been given sat in the database
  ;;; still marked as its own. The run looked finished and had done nothing.
  ;;;
  ;;; THE CLAIM IS WHY SEVERAL WORKERS ARE A SCHEDULER AND NOT A RACE. Two that
  ;;; loaded the same machine would both advance it and both save it, and the
  ;;; second save would quietly throw the first one's work away. The procedure
  ;;; does the find and the status change in one transaction, so exactly one
  ;;; worker comes away with a given name.
  ;;; WANTED names one machine, or is null for "whatever is free". Naming one
  ;;; is what lets two workers share a single machine while two others share a
  ;;; different one -- four interpreters, two states, and no group touching the
  ;;; other's.
  (func claim ((const char * worker) (const char * wanted)
               (char * name) (size_t cap)) (out int)
        (let ((zg_result_t r) (char cols [256]) (int got . 0))
          (set (nth 0 name) (cast char 0))
          (if (== wanted nil)
              (block (if (not (zg_call db "cocolog::machine_claim")) (return -1))
                     (if (not (zg_write_string db ($ opts kb))) (return -1)))
            (block (if (not (zg_call db "cocolog::machine_claim_named")) (return -1))
                   (if (not (zg_write_string db wanted)) (return -1))))
          (if (not (zg_write_string db worker)) (return -1))
          (while 1
            (if (not (zg_result db (aof r))) (return -1))
            (if (== r ZG_SUCCESSFUL_DONE) break)
            (cond
              ((== r ZG_CURSOR_OPEN) (zg_columns db cols 256))
              ((== r ZG_RETURN_VALUE)
               (if (zg_read_string db name cap nil) (set got 1)))
              ((== r ZG_CURSOR_FETCH) break)
              (#t (block))))
          ;; The claim has to stand before the machine is touched, so it is
          ;; committed here rather than left to the end of the turn.
          (if (not (zg_commit db)) (return -1))
          (return (? (and got (!= (nth 0 name) (cast char 0))) 1 0))))

  ;;; Claim, advance, put back. A worker loop, and several of these against one
  ;;; server is the whole point of the project: the database is the run queue
  ;;; and a machine's state is the work item.
  ;;;
  ;;; WHAT MAKES IT SURVIVE THE OTHER THREE. Every database call here can fail
  ;;; for a reason that has nothing to do with this worker -- another worker
  ;;; happened to be inside the storage engine at the same moment -- and the
  ;;; failure takes the connection with it. So the loop treats a lost
  ;;; connection as a thing to recover from rather than a thing to stop for:
  ;;;
  ;;;   * a claim that could not be made      -> redial and claim again
  ;;;   * a turn that could not be committed  -> redial, hand the machine back,
  ;;;                                            and let anyone take it next
  ;;;
  ;;; and only a bounded number of times, so a worker facing a server that has
  ;;; genuinely gone away says so and exits instead of spinning.
  ;;;
  ;;; HANDING IT BACK RATHER THAN RETRYING IT is deliberate. A worker that
  ;;; insisted on redoing its own lost turn would be the one thing that can
  ;;; starve the other member of the group; giving the machine up means the
  ;;; partner may take that turn, which is the arrangement the whole thing is
  ;;; for and is why the group's answers still come out in order.
  (func cmd_work ((const char * worker) (const char * wanted)) (out int)
        (let ((char name [256]) (int turns . 0) (int idle . 0) (int gone . 0)
              (int hurt . 0) (int rc . 0) (int got . 0) (int seen . 0)
              (int look . 0))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: work needs a database\n") (return 1)))
          (while 1
            ;; A CHEAP READ BEFORE THE EXPENSIVE WRITE, when the machine is
            ;; named. `exists' answers whether anyone is holding it, at the
            ;; default isolation level and without writing anything; the claim
            ;; is only attempted when the answer is that nobody is. See the
            ;; head of `exists' for what that is worth -- it is the difference
            ;; between eight idle workers costing nothing and costing more than
            ;; the four doing the work.
            ;;
            ;; The answer is kept, because the code below needs the same fact
            ;; and asking twice would give back half of what this saves.
            (set look (? (== wanted nil) 2 (exists worker wanted)))
            (if (== look -1)
                (block
                 (set hurt (+ hurt 1))
                 (if (> hurt 40)
                     (block (fprintf stderr "%s: giving up after %d lost connection(s)\n"
                                     worker hurt)
                            break))
                 (if (not (recover worker hurt)) break)
                 continue))
            (set got (? (== look 2) (claim worker wanted name (sizeof name)) 0))

            (if (== got -1)
                (block
                 ;; The connection, not the queue. Redial and go round again;
                 ;; nothing was committed, so there is nothing to undo.
                 (set hurt (+ hurt 1))
                 (if (> hurt 40)
                     (block (fprintf stderr "%s: giving up after %d lost connection(s)\n"
                                     worker hurt)
                            break))
                 (if (not (recover worker hurt)) break)
                 continue))

            (if (== got 0)
                (block
                 ;; AN EMPTY CLAIM MEANS TWO DIFFERENT THINGS, and stopping on
                 ;; the wrong one is what made every machine get finished by
                 ;; whichever worker happened to reach it first. The machine is
                 ;; either GONE -- proved out and dropped, so there is nothing
                 ;; left to do -- or BUSY in a partner, which is the normal
                 ;; state of affairs for most of a run and no reason at all to
                 ;; stop. Counting empty claims and giving up after enough of
                 ;; them treats the second as the first: a worker that started a
                 ;; few hundred milliseconds late, or whose partners were mid
                 ;; turn, quietly exited having done nothing, and the test that
                 ;; asks whether every member of a group took a turn was right
                 ;; to fail.
                 ;;
                 ;; So ask -- which the top of the loop has already done, and
                 ;; `look' is the answer.
                 ;; AND ONE READING OF `GONE' IS NOT PROOF EITHER. Saving a
                 ;; machine rewrites its row -- cocolog::machine_open deletes
                 ;; the old one and inserts a replacement -- and for as long as
                 ;; that transaction is open, a reader at READ COMMITTED sees
                 ;; NEITHER version: the delete is not committed and the insert
                 ;; is not either. The row is briefly nowhere, which is MVCC
                 ;; being right rather than being broken, and a partner that
                 ;; happened to look during that window concluded the machine
                 ;; had finished and went home. It is why `exists' answers a
                 ;; question that has to be asked more than once.
                 ;;
                 ;; A worker gives up only after the machine has been out of
                 ;; sight CONTINUOUSLY for COCO_GONE_CONFIRM polls. A partner
                 ;; between turns has committed and is yielding, so the row is
                 ;; plainly there for COCO_YIELD_US at a time; a run of absences
                 ;; that long means it really has been dropped.
                 (if (== wanted nil) break)
                 (if (== look 0)
                     (block (set gone (+ gone 1))
                            (if (> gone (? seen COCO_GONE_CONFIRM COCO_APPEAR_LIMIT)) break)
                            (usleep COCO_POLL_US)
                            continue))
                 (set gone 0)
                 (set seen 1)
                 ;; There, and somebody else has it. Wait, and keep a wall clock
                 ;; on it so that a machine stranded by a worker that died does
                 ;; not hold the rest here for ever.
                 (set idle (+ idle 1))
                 (if (> idle COCO_IDLE_LIMIT)
                     (block (fprintf stderr "%s: '%s' stayed claimed by somebody else\n"
                                     worker wanted)
                            break))
                 (usleep COCO_POLL_US)
                 continue))

            (set idle 0)
            (set gone 0)
            (set seen 1)
            (fprintf (wout) "%s: took '%s'\n" worker name)
            (set rc (cmd_step name 0))

            (if (turn-is LOST rc)
                (block
                 (set hurt (+ hurt 1))
                 (fprintf stderr "%s: lost the connection during '%s'; turn rolled back\n"
                          worker name)
                 (if (> hurt 40)
                     (block (fprintf stderr "%s: giving up after %d lost connection(s)\n"
                                     worker hurt)
                            break))
                 (if (not (recover worker hurt)) break)
                 ;; The claim was committed, so the machine is still marked as
                 ;; ours even though the turn is not. Put it back.
                 (release worker name)
                 continue))

            ;; A turn that happened. FAILED means the program is wrong, and it
            ;; will be wrong again, so the machine is left where cmd_step left
            ;; it and this worker stops.
            (set turns (+ turns 1))
            (if (turn-is FAILED rc) break)
            ;; Stand back and let somebody else have the next one.
            (if (turn-is MORE rc) (usleep COCO_YIELD_US)))
          ;; WHAT IT DID AND WHY IT STOPPED, in one line. A worker that ends
          ;; having taken no turns is either a scheduler working correctly --
          ;; its partners got there first -- or a bug, and the two are
          ;; indistinguishable from `nothing left to do'. The counts say which:
          ;; a worker that never saw the machine at all made no claims worth
          ;; speaking of, one that was always too late made hundreds.
          (fprintf (wout) "%s: nothing left to do after %d turn(s) (%d claim attempt(s), %d absent, %d busy)\n"
                  worker turns (+ (+ gone idle) turns) gone idle)
          (return 0)))

  ;;; ---- the swarm: cmd_work, one worker per thread ------------------------
  ;;;
  ;;; Twelve processes taking turns through a server is one benchmark; the
  ;;; same twelve workers as THREADS of one process is the embedded store's
  ;;; natural shape, because an embedded engine belongs to a single process.
  ;;; Each thread opens its own connection -- embedded when --store is given,
  ;;; a socket of its own otherwise -- sets the thread-local `db', and runs
  ;;; the very same cmd_work the processes run. Nothing in the work loop
  ;;; knows which arrangement it is in.

  (struct swarm_job
    (member char worker [64])
    (member char machine [128])
    (member char logpath [512])
    (member int rc))

  (func swarm_thread ((void * arg)) (out void *)
        (let ((swarm_job * j . #'(cast (swarm_job *) arg))
              (char err [512]))
          (if (!= ($ opts store) nil)
              (set db (zg_open_embed ($ opts store) err (sizeof err)))
            (set db (zg_open ($ opts host) ($ opts port) ($ opts timeout) err (sizeof err))))
          (if (== db nil)
              (block (fprintf stderr "%s: cannot open -- %s\n" (-> j worker) err)
                     (set (-> j rc) 1)
                     (return nil)))
          (if (!= (nth 0 (-> j logpath)) (cast char 0))
              (set wlog (fopen (-> j logpath) "w")))
          (set (-> j rc) (cmd_work (-> j worker) (-> j machine)))
          (if (!= wlog nil) (block (fclose wlog) (set wlog nil)))
          (zg_close db)
          (set db nil)
          (return nil)))

  (func cmd_swarm ((int argc) (char ** argv) (int from)) (out int)
        (let ((int pairs . #'(/ (- argc from) 2)) (int bad . 0))
          (if (<= pairs 0)
              (block (fprintf stderr "cocolog: swarm needs WORKER MACHINE pairs\n")
                     (return 1)))
          (if (> pairs 32)
              (block (fprintf stderr "cocolog: a swarm is at most 32 workers\n")
                     (return 1)))
          (let ((swarm_job jobs [32]) (pthread_t tids [32]))
            (for ((int k . 0)) (< k pairs) ((++ k))
              (snprintf ($ (nth k jobs) worker) 64 "%s" (nth (+ from (* k 2)) argv))
              (snprintf ($ (nth k jobs) machine) 128 "%s" (nth (+ from (+ (* k 2) 1)) argv))
              (if (!= ($ opts outdir) nil)
                  (snprintf ($ (nth k jobs) logpath) 512 "%s/%s.log"
                            ($ opts outdir) ($ (nth k jobs) worker))
                (set (nth 0 ($ (nth k jobs) logpath)) (cast char 0)))
              (set ($ (nth k jobs) rc) 0)
              (pthread_create (aof (nth k tids)) nil swarm_thread
                              (cast (void *) (aof (nth k jobs)))))
            (for ((int k . 0)) (< k pairs) ((++ k))
              (pthread_join (nth k tids) nil)
              (if (!= ($ (nth k jobs) rc) 0) (set bad 1)))
            (return bad))))

  (func cmd_list () (out int)
        (let ((zg_result_t r) (char cols [256]) (int rows . 0))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: list needs a database\n") (return 1)))
          (if (not (zg_call db "cocolog::machine_list")) (return 1))
          (if (not (zg_write_string db ($ opts kb))) (return 1))
          (while 1
            (if (not (zg_result db (aof r))) break)
            (if (== r ZG_SUCCESSFUL_DONE) break)
            (cond
              ((== r ZG_CURSOR_OPEN) (zg_columns db cols 256))
              ((== r ZG_CURSOR_FETCH)
               (let ((char nm [256]) (char status [64]) (i32 chunks . 0))
                 (if (not (zg_read_string db nm (sizeof nm) nil)) break)
                 (if (not (zg_read_string db status (sizeof status) nil)) break)
                 (if (not (zg_read_int db (aof chunks) nil)) break)
                 (printf "  %-28s %-12s %d chunk(s)\n" nm status chunks)
                 (set rows (+ rows 1))))
              ((== r ZG_RETURN_VALUE) (zg_skip_field db))
              (#t (block))))
          (if (== rows 0) (printf "  no suspended machines in '%s'\n" ($ opts kb)))
          (return 0)))

  ;;; Forgets clauses. With no predicate, the whole knowledge base.
  ;;;
  ;;; WHY A PROGRAM THAT ONLY EVER ADDS CLAUSES NEEDS THIS. `consult' asserts;
  ;;; it does not replace. Run it twice on the same file and the knowledge base
  ;;; holds two copies of every clause, and a proof then answers everything
  ;;; twice and a recursive one may not terminate at all. That is correct
  ;;; behaviour for assertz and a trap for anything that loads a program more
  ;;; than once -- a test that runs repeatedly, most of all, where it looks
  ;;; like the interpreter has started producing duplicate answers.
  (func cmd_forget ((const char * name) (int arity)) (out int)
        (let ((zg_result_t r) (char cols [256]) (i64 gone . 0))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: forget needs a database\n") (return 1)))
          (if (== name nil)
              (block (if (not (zg_call db "cocolog::forget_all")) (return 1))
                     (if (not (zg_write_string db ($ opts kb))) (return 1)))
            (block (if (not (zg_call db "cocolog::forget")) (return 1))
                   (if (not (zg_write_string db ($ opts kb))) (return 1))
                   (if (not (zg_write_string db name)) (return 1))
                   (if (not (zg_write_int db arity)) (return 1))))
          (while 1
            (if (not (zg_result db (aof r)))
                (block (fprintf stderr "cocolog: forget: %s\n" (zg_error db)) (return 1)))
            (if (== r ZG_SUCCESSFUL_DONE) break)
            (cond
              ((== r ZG_CURSOR_OPEN) (zg_columns db cols 256))
              ((== r ZG_RETURN_VALUE) (zg_read_long db (aof gone) nil))
              ((== r ZG_CURSOR_FETCH) break)
              (#t (block))))
          (if (not (zg_commit db))
              (block (fprintf stderr "cocolog: forget: %s\n" (zg_error db)) (return 1)))
          (if (== name nil)
              (printf "forgot %lld clause(s) in '%s'\n" (cast llong gone) ($ opts kb))
            (printf "forgot %lld clause(s) of %s/%d\n" (cast llong gone) name arity))
          (return 0)))

  (func cmd_drop ((const char * name)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_zg z))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: drop needs a database\n") (return 1)))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_zg_attach (aof z) db (aof m) (aof st) ($ opts kb))
          (coco_zg_drop (aof z) name)
          (zg_commit db)
          (printf "dropped '%s'\n" name)
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return 0)))

  ;;; ---- the command line ---------------------------------------------------

  ;; THE TORCH MODULE IS REACHED THROUGH A WEAK SYMBOL: `make torch'
  ;; links torch/coco-torch.o and the registration runs; the plain build
  ;; leaves the symbol null and the torch predicates are unknown
  ;; procedures, which is the right answer for a build without torch.
  ;; Raw C, because a null-checked call through a weak function is a C
  ;; idiom Cicili has no clause for.
  (code "extern int coco_torch_module(void) __attribute__((weak));")
  (code "static int coco_torch_try(void) { return coco_torch_module ? coco_torch_module() : 1; }")
  (decl) (func coco_torch_try () (out int))

  ;;; Every module this build carries. Registration is here and not inside the
  ;;; modules because a build decides what it contains -- a module cannot add
  ;;; itself, and the order is the order of precedence when two claim a name.
  (func install_modules () (out int)
        (coco_module_init)
        (if (not (coco_files_module))
            (block (fprintf stderr "cocolog: the files module would not register\n")
                   (return 0)))
        (if (not (coco_lists_module))
            (block (fprintf stderr "cocolog: the lists module would not register\n")
                   (return 0)))
        (if (not (coco_apply_module))
            (block (fprintf stderr "cocolog: the apply module would not register\n")
                   (return 0)))
        (if (not (coco_builtins_module))
            (block (fprintf stderr "cocolog: the builtins module would not register\n")
                   (return 0)))
        (if (not (coco_dcg_module))
            (block (fprintf stderr "cocolog: the dcg module would not register\n")
                   (return 0)))
        (if (not (coco_torch_try))
            (block (fprintf stderr "cocolog: the torch module would not register\n")
                   (return 0)))
        (return 1))

  ;;; Consults FILES and proves GOAL once, in one process, with no database.
  ;;;
  ;;; WHAT IT IS FOR is running the same Prolog file under cocolog and under
  ;;; another Prolog and comparing what they print -- which is how the Files
  ;;; module is tested, because a library that claims to be SWI's has to be
  ;;; checked against SWI rather than against its own author. It is deliberately
  ;;; the shape of `swipl -q -g GOAL -t halt FILE': nothing is printed but what
  ;;; the program itself writes, success is 0 and failure is 1.
  (func cmd_run ((int argc) (char ** argv) (int from) (const char * goal)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_engine e) (coco_zg z) (coco_zt zt)
              (char err [256]) (int rc . 0))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_engine_init (aof e) (aof m) (aof st))
          (set ($ e max_steps) 0)
          (attach (aof z) (aof zt) (aof m) (aof st))

          (for ((int i . from)) (< i argc) ((++ i))
            (let ((char * text . #'(slurp (nth i argv))))
              (if (== text nil)
                  (block (coco_engine_free (aof e)) (coco_store_free (aof st))
                         (coco_machine_free (aof m)) (return 1)))
              (if (< (coco_consult (aof st) (aof m) text err (sizeof err)) 0)
                  (block (fprintf stderr "cocolog: %s: %s\n" (nth i argv) err)
                         (free text) (coco_engine_free (aof e)) (coco_store_free (aof st))
                         (coco_machine_free (aof m)) (return 1)))
              (free text)))

          (if (not (coco_engine_ask_text (aof e) goal))
              (block (fprintf stderr "cocolog: %s\n" ($ e err))
                     (coco_engine_free (aof e)) (coco_store_free (aof st))
                     (coco_machine_free (aof m)) (return 1)))
          (set rc (coco_engine_next (aof e)))
          (if (== rc -1) (fprintf stderr "cocolog: %s\n" ($ e err)))
          (if (!= db nil) (if (== rc 1) (zg_commit db) (zg_rollback db)))
          (coco_engine_free (aof e))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return (? (== rc 1) 0 1))))

  (func main ((int argc) (char ** argv))
        (out int)
        (let ((int i . 1) (int rc . 0))
          ;; options first, then the command
          (while (< i argc)
            (let ((const char * a . #'(nth i argv)))
              (if (!= (nth 0 a) (cast char 45)) break)
              (cond
                ((== 0 (strcmp a "--local")) (set ($ opts local) 1) (set i (+ i 1)))
                ((== 0 (strcmp a "--help")) (usage) (return 0))
                (#t
                 (if (>= (+ i 1) argc)
                     (block (fprintf stderr "cocolog: %s needs a value\n" a) (return 1)))
                 (let ((const char * v . #'(nth (+ i 1) argv)))
                   (cond
                     ((== 0 (strcmp a "--kb"))      (set ($ opts kb) v))
                     ((== 0 (strcmp a "--host"))    (set ($ opts host) v))
                     ((== 0 (strcmp a "--port"))    (set ($ opts port) v))
                     ((== 0 (strcmp a "--http"))    (set ($ opts http) v))
                     ((== 0 (strcmp a "--steps"))   (set ($ opts steps) (strtoull v nil 10)))
                     ((== 0 (strcmp a "--timeout")) (set ($ opts timeout) (atoi v)))
                     ((== 0 (strcmp a "--lock"))    (set ($ opts lock) v))
                     ((== 0 (strcmp a "--store"))   (set ($ opts store) v))
                     ((== 0 (strcmp a "--out"))     (set ($ opts outdir) v))
                     ((== 0 (strcmp a "--answers")) (set ($ opts answers) (atoi v)))
                     (#t (block (fprintf stderr "cocolog: unknown option %s\n" a)
                                (return 1)))))
                 (set i (+ i 2))))))

          (if (>= i argc) (block (usage) (return 1)))

          (if (not (install_modules)) (return 1))
          (if (not (open_connection)) (return 1))

          (let ((const char * cmd . #'(nth i argv)))
            (cond
              ((== 0 (strcmp cmd "consult"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: consult needs a file\n") (set rc 1))
                 (set rc (cmd_consult argc argv (+ i 1)))))
              ((== 0 (strcmp cmd "run"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: run needs a file\n") (set rc 1))
                 ;; the goal is the last argument when there is more than one,
                 ;; and `main' when there is not -- which is the swipl default
                 (set rc (? (>= (+ i 2) argc)
                            (cmd_run (+ i 2) argv (+ i 1) "main")
                            (cmd_run (- argc 1) argv (+ i 1) (nth (- argc 1) argv))))))
              ((== 0 (strcmp cmd "query"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: query needs a goal\n") (set rc 1))
                 (set rc (cmd_query (nth (+ i 1) argv)))))
              ((== 0 (strcmp cmd "start"))
               (if (>= (+ i 2) argc)
                   (block (fprintf stderr "cocolog: start needs a name and a goal\n") (set rc 1))
                 (set rc (cmd_start (nth (+ i 1) argv) (nth (+ i 2) argv)))))
              ((== 0 (strcmp cmd "step"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: step needs a name\n") (set rc 1))
                 (set rc (cmd_step (nth (+ i 1) argv) 0))))
              ((== 0 (strcmp cmd "finish"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: finish needs a name\n") (set rc 1))
                 (set rc (cmd_step (nth (+ i 1) argv) 1))))
              ((== 0 (strcmp cmd "work"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: work needs a worker name\n") (set rc 1))
                 (set rc (cmd_work (nth (+ i 1) argv)
                                   (? (>= (+ i 2) argc) nil (nth (+ i 2) argv))))))
              ((== 0 (strcmp cmd "swarm"))
               (set rc (cmd_swarm argc argv (+ i 1))))
              ((== 0 (strcmp cmd "forget"))
               (if (>= (+ i 2) argc)
                   (set rc (cmd_forget nil 0))
                 (set rc (cmd_forget (nth (+ i 1) argv) (atoi (nth (+ i 2) argv))))))
              ((== 0 (strcmp cmd "list")) (set rc (cmd_list)))
              ((== 0 (strcmp cmd "drop"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: drop needs a name\n") (set rc 1))
                 (set rc (cmd_drop (nth (+ i 1) argv)))))
              (#t (block (fprintf stderr "cocolog: unknown command %s\n" cmd)
                         (usage) (set rc 1)))))

          (if (!= db nil) (zg_close db))
          (return rc)))
  )

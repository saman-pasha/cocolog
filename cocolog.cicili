;;;; cocolog -- the program
;;;
;;; A driver over the interpreter in lib/cocolog. What it is for, beyond being
;;; a way to run a query, is the `step' command: run a machine for a fixed
;;; number of inferences and then SUSPEND it back into the database. That turns
;;; the database into a run queue and any number of processes into workers on
;;; it -- which is the arrangement the whole design was for, and demo/turns.sh
;;; is it running.
;;;
;;; Usage:
;;;
;;;   cocolog [options]                     no command at all: the toplevel.
;;;                                          `?- ', the query's own variable
;;;                                          names, `;' for more, halt. leaves
;;;   cocolog [options] consult FILE...     read programs into the knowledge base
;;;   cocolog [options] query GOAL          prove it here and now
;;;   cocolog [options] run FILE... [GOAL]  consult and prove, in one process;
;;;                                          GOAL defaults to `main'. The shape
;;;                                          of `swipl -q -g GOAL -t halt FILE'
;;;   cocolog [options] start NAME GOAL     begin a machine and suspend it
;;;   cocolog [options] step NAME           run it a while and suspend it again
;;;   cocolog [options] finish NAME         run it to the end
;;;   cocolog [options] work WORKER [MACHINE]
;;;                                          claim machines and advance them;
;;;                                          with MACHINE, only that one
;;;   cocolog [options] forget [NAME ARITY] empty the knowledge base, or one
;;;                                          predicate of it
;;;   cocolog [options] vacuum              reclaim what deleted rows still
;;;                                          hold -- spends point-in-time reads
;;;   cocolog [options] list                what machines are suspended
;;;   cocolog [options] drop NAME           forget one
;;;
;;;   --kb NAME      which knowledge base   (default main)
;;;   --host HOST    (default 127.0.0.1)
;;;   --tcp [PORT]   the binary protocol, in the clear (2160)
;;;   --tls [PORT]   the binary protocol over TLS, same port -- what
;;;                  ZiguratIP's SERVER/TLS_MODE: TRUE puts on it. A client
;;;                  certificate is optional (SERVER/TLS_CLIENT_AUTH says),
;;;                  and mandatory under SECURITY/PERMISSIONS_MODE
;;;   --http [PORT]  read over Zeytun instead of the binary protocol (80)
;;;   --https [PORT] the same, over TLS (443) -- what an edge speaks
;;;   --port PORT    DEPRECATED, and still accepted: exactly `--tcp PORT'.
;;;                  It named a number when there was one transport; there
;;;                  are four now, and --tcp/--tls/--http/--https say which
;;;                  as well as where. Nothing warns -- it is a spelling,
;;;                  not a mistake -- and nothing in this tree uses it.
;;;   --local        no database at all: everything in memory
;;;   --steps N      inferences per `step'  (default 2000)
;;;   --timeout S    socket timeout, seconds (default 20)
;;;   --lock PATH    make cocolog processes take turns through PATH, for a
;;;                  server whose storage engine is not concurrency safe;
;;;                  `auto' names one per host and port. Off by default.
;;;   --answers N    stop after N solutions (default 10, 0 for all)
;;;   --vacuum       let programs call vacuum_kb/0,1; without it the builtin
;;;                  raises permission_error, because the pass gives up the
;;;                  store's point-in-time reads
;;;
;;; WHY `step' PRINTS NOTHING MUCH. It is meant to be run by a script, over and
;;; over, possibly by several processes at once. What it says is whether the
;;; machine finished, and if so with what.

;;;; ------------------------------------------------------------------
;;;; What one turn came to
;;;; ------------------------------------------------------------------
;;; A WORKER HAS TO TELL FOUR THINGS APART, and only one of them used to have
;;; a name. `step\' answered 0, 1 or 2 -- finished, something went wrong, more
;;; to do -- which is enough for a person at a terminal and not enough for a
;;; worker, because "something went wrong" covers both the case where running
;;; it again is pointless (the program is bad) and the case where running it
;;; again is exactly right (the connection went and nothing was committed).
;;; Under one worker the two never had to be told apart. Under four they are
;;; the difference between recovering and giving up.
;;;
;;; The table is here rather than as three defines so that the codes and the
;;; reasons cannot drift apart, and so `turn-is\' folds to a comparison
;;; against a literal.
(DEFPARAMETER *turn-outcomes*
  '((FINISHED 0 "proved out; the machine is gone from the database")
    (FAILED   1 "the program is wrong -- running it again goes wrong again")
    (MORE     2 "suspended with work left, and committed")
    (LOST     3 "the connection ended mid-turn. NOTHING was committed, so the
                 turn did not happen and may simply be done again")))

(DEFUN turn-value (name)
  (LET ((row (ASSOC name *turn-outcomes* :TEST #'STRING=)))
    (UNLESS row (ERROR "cocolog: unknown turn outcome ~A" name))
    (SECOND row)))

;;; the code itself, for a `return\'
(DEFMACRO turn (name) (turn-value name))

;;; whether a code is that outcome
(DEFMACRO turn-is (name v) `(== ,v ,(turn-value name)))

(source "cocolog.c"
  (make :std #t
        :compile ("-Iclient"
                  ;; two clang-only complaints about the transpiler's
                  ;; correct emission: the paren-wrapped while condition
                  ;; and the unbraced else-if chain. gcc ignores unknown
                  ;; -Wno- options, so both flags travel to every platform
                  "-Wno-parentheses-equality" "-Wno-dangling-else"
                  ;; -O3's fortify pass flags snprintf into the fixed
                  ;; 256-byte error buffers as possible truncation; the
                  ;; truncation is the design (an error message is capped,
                  ;; never grown), and Cicili treats any unrecognised
                  ;; compiler chatter as fatal, so the class is silenced
                  "-Wno-format-truncation"
                  "-c" "cocolog.c"))
        ;; no :link -- the Makefile makes the ONE full link, with the
        ;; embedded engine beside this object. A partial link here leaves
        ;; the ce_* hooks unresolved, which ELF treats as null weak
        ;; references and macOS's ld64 refuses outright; nothing has ever
        ;; run the partial binary. torch and bigint used to be named here
        ;; too and are loadable modules now.

  (include <math.h>)
  ;; the swarm command's worker threads
  (include <pthread.h>)
  ;; usleep, for the worker that waits its turn on a machine another worker
  ;; is holding. lib/std/c/posix declares it for inference; the header still
  ;; has to be included by the target that emits code.
  (include <unistd.h>)
  ;; the toplevel's line editor puts the terminal in raw mode; everything
  ;; termios is reached through `(code ...)' escapes, so only C sees it
  (include <termios.h>)
  ;; the Files module reaches stat, opendir, glob and realpath
  (include <sys/stat.h>)
  (include <sys/types.h>)
  (include <dirent.h>)
  ;; and open(2), for read_file_to_codes/2 -- the same rule as <unistd.h>
  ;; above: lib/std/c/posix/fcntl.cicili declares `open' and O_RDONLY so
  ;; Cicili can infer through them, and the target still has to name the
  ;; header so the emitted C has them too
  (include <fcntl.h>)
  ;; SOCKETS ARE NOT HERE ANY MORE. They went with library(tcp) into
  ;; modules/tcp, which names its own headers -- and this is the visible
  ;; half of why a module belongs in a module directory: the includes now
  ;; sit beside the code that needs them instead of in the interpreter.
  (include <errno.h>)
  (include <glob.h>)
  (include <limits.h>)
  ;; the library loader: use_module dlopen's a compiled module
  (include <dlfcn.h>)
  (include <zigurat.h>)
  (include <zeytun.h>)

  ;;; What the client is told about TLS, once, before the first fetch.
  ;;; `zt_tls_options' is a C struct in `client/zeytun.h' and Cicili needs
  ;;; the name to declare a local of it -- a type is ONE token, and this
  ;;; one already is.
  ;;; FLAT, not the struct form. A Cicili form reaching into a C struct
  ;;; needs that struct's MEMBERS declared to it and not merely its name --
  ;;; `($ t cacert)' on a type it only knows the name of stops the
  ;;; transpile with `unknown struct type: zt_tls_options'. Six arguments
  ;;; say the same thing with nothing to declare.
  (decl) (func coco_client_tls_configure_flat ((const char * cacert) (const char * capath)
                                      (const char * cert) (const char * key)
                                      (const char * key_pass) (int insecure)))
  ;;; THE SAME SIX, FOR THE BINARY PROTOCOL. Two setters rather than one
  ;;; shared global, because the two clients are two translation units and
  ;;; a cocolog reaches one server through ONE of them -- a single global
  ;;; would work today and be a trap the first time something wanted a
  ;;; Zeytun and a Zigurat at once.
  (decl) (func zg_tls_configure_flat ((const char * cacert) (const char * capath)
                                      (const char * cert) (const char * key)
                                      (const char * key_pass) (int insecure)))
  (decl) (func coco_client_tls_available () (out int))

  (import "./lib/zigurat.cicili" :zg)
  (import "./lib/zeytun.cicili" :zt)
  (import "./lib/term.cicili")
  (import "./lib/syntax.cicili")
  (import "./lib/dcg.cicili")
  (import "./lib/kb.cicili")
  (import "./lib/solve.cicili")
  (import "./lib/module.cicili")
  (import "./lib/files.cicili")
  (import "./lib/lists.cicili")
  (import "./lib/apply.cicili")
  (import "./lib/builtins.cicili")
  (import "./lib/library.cicili")
  (import "./lib/state.cicili")
  (import "./lib/zigurat-kb.cicili")
  (import "./lib/zigurat-mod.cicili")
  (import "./lib/zeytun-kb.cicili")

  (decl-term)   (impl-term)
  (decl-syntax) (impl-syntax)
  ;; the grammar-rule translator comes BEFORE the knowledge base, because
  ;; `coco_assert' calls it: every clause reaching the store passes through
  ;; there, so that is the one place a `-->' rule can be rewritten no matter
  ;; whether it was consulted from a file or asserted by a running program.
  (decl-dcg)    (impl-dcg)
  (decl-kb)     (impl-kb)
  (decl-solve)  (impl-solve)
  (decl-module) (impl-module)
  (decl-files)  (impl-files)
  (decl-lists)  (impl-lists)
  (decl-apply)  (impl-apply)
  (decl-builtins) (impl-builtins)
  ;; the library loader sits above the module layer it registers into
  (decl-library) (impl-library)
  ;; ...and the half that needs an engine comes after there is one
  (decl-dcg-module) (impl-dcg-module)
  (decl-state)  (impl-state)
  (decl-zigurat-kb) (impl-zigurat-kb)
  (decl-zigurat-mod) (impl-zigurat-mod)
  (decl-zeytun-kb)  (impl-zeytun-kb)

  ;;; Everything the command line said, in one place.
  (struct coco_opts
    (member const char * kb)
    (member const char * host)
    (member const char * port)
    (member const char * http)
    ;; HTTPS IS THE SAME ARRANGEMENT WITH A DIFFERENT TRANSPORT, which is
    ;; why `http' still holds the SERVICE for both and this is only a
    ;; flag: every `(!= ($ opts http) nil)' below -- the arrangement
    ;; test, in five places -- is unchanged, and there is no second
    ;; backend to keep in step.
    ;; WHICH TRANSPORT, for whichever arrangement was chosen. `secure' is
    ;; Zeytun's and `bsecure' the binary protocol's, and they cannot both
    ;; be on: `--https' and `--tls' name different servers.
    (member int secure)
    (member int bsecure)
    (member const char * cacert)
    (member const char * capath)
    (member const char * cert)
    (member const char * key)
    (member const char * keypass)
    (member int insecure)
    (member int          local)
    (member u64          steps)
    ;; Seconds a socket operation may block. Short in a test, because a worker
    ;; that is waiting on a server that will never answer should say so quickly
    ;; rather than sit there for the default.
    (member int          timeout)
    (member int          answers)
    ;; Where cocolog processes take turns, so that no two of them are inside
    ;; ZiguratIP's storage engine at once. Null means "work one out from the
    ;; host and port"; the string "none" means do not take turns at all.
    (member const char * lock)
    ;; A directory for the EMBEDDED knowledge base: the store lives inside
    ;; this process, no server and no socket. The one binary links the
    ;; embedded engine in, and a store belongs to one process at a
    ;; time: concurrency inside it is the `swarm' command's threads.
    (member const char * store)
    ;; Where each swarm worker writes what it did (DIR/WORKER.log); null
    ;; means everybody onto stdout together.
    (member const char * outdir)
    ;; Whether programs this process runs may call `vacuum_kb' -- reclaiming
    ;; dead rows spends the store's point-in-time reads, so it is an opt-in
    ;; (`--vacuum') and not a default. The `vacuum' COMMAND ignores this: the
    ;; operator typing the verb is the opt-in.
    (member int          vacuum))

  ;; kb, host and port start EMPTY rather than at their defaults, because
  ;; whether any of them was written is what picks the arrangement: see the
  ;; decision after the option loop. They take their old defaults there.
  ;; POSITIONAL, so the order here is the order of the members above and
  ;; adding one in the middle means adding one here. Getting it wrong is a
  ;; wall of `incompatible integer to pointer conversion' naming this line
  ;; and not the member that moved.
  ;;   kb host port http | secure bsecure cacert capath cert key keypass insecure
  ;;   | local steps timeout answers lock store outdir vacuum
  (var coco_opts opts . '{ nil nil nil nil
                           0 0 nil nil nil nil nil 0
                           0 2000 20 10 nil nil nil 0 })

  ;;; The one connection, when there is one. THREAD-LOCAL, because the
  ;;; `swarm' command runs one worker per thread and each opens its own:
  ;;; everything below reaches the connection of the thread it runs on,
  ;;; and a single-threaded command sees exactly what it always did.
  (thread-local) (var zg_conn * db . nil)

  ;;; Where this thread's worker narrates -- answers, took/suspended lines,
  ;;; the closing summary. stdout, until a swarm thread points it at the
  ;;; worker's own log file so twelve narrations do not interleave.
  (thread-local) (var FILE * wlog . nil)
  (func wout () (out FILE *) (return (? (== wlog nil) stdout wlog)))

  ;;; HOW LONG A WORKER WAITS, and why there are two numbers rather than one.
  ;;;
  ;;; POLL is how often a worker with nothing to do asks again. Short, because
  ;;; the machine it wants is usually in the middle of somebody else's turn and
  ;;; will be free in milliseconds.
  ;;;
  ;;; YIELD is how long a worker waits after FINISHING a turn, before claiming
  ;;; anything again -- and it is deliberately longer than POLL. Without it the
  ;;; worker that has just put a machine down is the one that picks it up:
  ;;; it is already awake, already connected, and its partner is asleep between
  ;;; polls. One worker then runs the whole machine and the other never gets a
  ;;; turn, which passes every test about ANSWERS and quietly fails the thing
  ;;; the design is actually for. Waiting longer than a poll hands the next
  ;;; turn to whoever is waiting, and costs a worker running alone twenty
  ;;; milliseconds a turn.
  (var const useconds_t COCO_POLL_US  . 5000)
  (var const useconds_t COCO_YIELD_US . 20000)

  ;;; How many consecutive polls a worker will wait for a machine that exists
  ;;; but is claimed by somebody else. At COCO_POLL_US that is about a minute --
  ;;; long enough that a busy partner is never mistaken for a dead one, short
  ;;; enough that a machine stranded by a worker that was killed mid-turn does
  ;;; not keep the rest waiting for ever.
  (var const int COCO_IDLE_LIMIT . 12000)

  ;;; How many polls in a row a machine has to be out of sight before a worker
  ;;; believes it has finished rather than being mid-save.
  ;;;
  ;;; IT USED TO BE THREE HUNDRED, and the story of how it got to two is the
  ;;; story of two bugs in the database it talks to. Saving a machine deletes its
  ;;; row and inserts a replacement. A reader at READ COMMITTED first WAITED on
  ;;; the old row's lock -- and by the time the wait ended the old version had
  ;;; been retired and the new one was at an address the reader had gone past, so
  ;;; a machine being saved did not exist as far as its partners were concerned,
  ;;; for as long as the save took. Under load those windows ran together and a
  ;;; fifth of a second of absence proved nothing.
  ;;;
  ;;; With the wait gone, what was left was the narrower version of the same
  ;;; thing: a scan spans time, so one that passed the replacement before it was
  ;;; committed could still reach the original after it was retired.
  ;;;
  ;;; Both are fixed in ZiguratIP. A reader takes the version that was current
  ;;; when its statement began, decided against a microsecond clock, so a machine
  ;;; being saved is there throughout and is there exactly once. `exists' is now
  ;;; an answer rather than a symptom.
  ;;;
  ;;; Two polls, then, and not none -- a worker's `exists' and its next `claim'
  ;;; are separate transactions, and a partner may drop the machine between them.
  ;;; Asking twice costs ten milliseconds and covers it. And a number like this
  ;;; is allowed to be a judgement in the first place because what it decides is
  ;;; only WHEN A WORKER GOES HOME: it cannot make two workers advance one
  ;;; machine, lose a turn, or produce an answer twice. The claim settles all of
  ;;; that exactly, inside one SERIALIZABLE transaction.
  (var const int COCO_GONE_CONFIRM . 2)

  ;;; And how long a worker waits for a machine it has NEVER SEEN. Much longer,
  ;;; because absence means something different before the first sighting: not
  ;;; "it finished" but "it is not there yet". A worker started before the
  ;;; machine it is meant to help with -- which is the sane way to start a pool,
  ;;; and the only way to start twelve of them without the first few finishing
  ;;; the work before the last are running -- would otherwise decide in a second
  ;;; and a half that there was never anything to do.
  (var const int COCO_APPEAR_LIMIT . 4000)

  ;;; Whether a word is one of the command verbs. `--embed' takes its
  ;;; directory optionally, and this is how the parser tells a directory
  ;;; from the command that follows a bare --embed.
  (func is_verb ((const char * a)) (out int)
        (if (== 0 (strcmp a "consult")) (return 1))
        (if (== 0 (strcmp a "run"))     (return 1))
        (if (== 0 (strcmp a "query"))   (return 1))
        (if (== 0 (strcmp a "start"))   (return 1))
        (if (== 0 (strcmp a "step"))    (return 1))
        (if (== 0 (strcmp a "finish"))  (return 1))
        (if (== 0 (strcmp a "work"))    (return 1))
        (if (== 0 (strcmp a "swarm"))   (return 1))
        (if (== 0 (strcmp a "forget"))  (return 1))
        (if (== 0 (strcmp a "vacuum"))  (return 1))
        (if (== 0 (strcmp a "list"))    (return 1))
        (if (== 0 (strcmp a "drop"))    (return 1))
        (return 0))

  (func usage ()
        (fprintf stderr "cocolog -- a Prolog interpreter with its knowledge base in Zigurat\n\n")
        (fprintf stderr "  cocolog [options]             the toplevel: a `?- ' prompt, answers\n")
        (fprintf stderr "                                under the query's own variable names,\n")
        (fprintf stderr "                                `;' for another solution, halt. leaves\n")
        (fprintf stderr "  cocolog [options] consult FILE...\n")
        (fprintf stderr "  cocolog [options] query GOAL\n")
        (fprintf stderr "  cocolog [options] start NAME GOAL\n")
        (fprintf stderr "  cocolog [options] step NAME\n")
        (fprintf stderr "  cocolog [options] finish NAME\n")
        (fprintf stderr "  cocolog [options] work WORKER [MACHINE]\n")
        (fprintf stderr "  cocolog [options] swarm WORKER MACHINE [WORKER MACHINE...]\n")
        (fprintf stderr "  cocolog [options] forget [NAME ARITY]\n")
        (fprintf stderr "  cocolog [options] vacuum\n")
        (fprintf stderr "  cocolog [options] list\n")
        (fprintf stderr "  cocolog [options] drop NAME\n\n")
        (fprintf stderr "  --kb NAME     knowledge base            (default main)\n")
        (fprintf stderr "  --host HOST   (default 127.0.0.1)\n")
        (fprintf stderr "  --tcp [PORT]  the binary protocol, in the clear (default 2160)\n")
        (fprintf stderr "  --tls [PORT]  the binary protocol over TLS -- ZiguratIP's\n")
        (fprintf stderr "                SERVER/TLS_MODE: TRUE, same port (default 2160)\n")
        (fprintf stderr "                A client certificate is OPTIONAL -- the server\n")
        (fprintf stderr "                decides, with TLS_CLIENT_AUTH -- and MANDATORY\n")
        (fprintf stderr "                under SECURITY/PERMISSIONS_MODE, where a TLS peer\n")
        (fprintf stderr "                without one reaches nothing\n")
        (fprintf stderr "  --http [PORT] read over Zeytun, plain HTTP (default port 80)\n")
        (fprintf stderr "  --https [PORT] the same over TLS (default port 443)\n")
        (fprintf stderr "  --port PORT   DEPRECATED: --tcp PORT says the same and\n")
        (fprintf stderr "                names the transport. Still accepted, silently\n")
        (fprintf stderr "  --cacert F    the authority to check the server against\n")
        (fprintf stderr "  --capath D    a directory of them; neither means the system store\n")
        (fprintf stderr "  --cert F --key F   this end's certificate, for a Zeytun that asks\n")
        (fprintf stderr "  --key-pass P  its pass phrase\n")
        (fprintf stderr "  --insecure    do not verify the server AT ALL\n")
        (fprintf stderr "  --local       no database; all in memory. THE DEFAULT:\n")
        (fprintf stderr "                naming --kb, --host or --tcp chooses the\n")
        (fprintf stderr "                server, --http Zeytun, --embed the embedded\n")
        (fprintf stderr "  --steps N     inferences per step       (default 2000)\n")
        (fprintf stderr "  --timeout S   socket timeout in seconds  (default 20)\n")
        (fprintf stderr "  --answers N   stop after N solutions    (default 10, 0 for all)\n")
        (fprintf stderr "  --lock PATH   take turns through PATH, for a server that\n")
        (fprintf stderr "                cannot take concurrent clients; `auto' names\n")
        (fprintf stderr "                one per host and port. Off by default.\n")
        (fprintf stderr "  --embed [DIR] the knowledge base EMBEDDED in this process,\n")
        (fprintf stderr "                no server; a bare --embed opens ./KB. A store\n")
        (fprintf stderr "                named like a command is written ./run.\n")
        (fprintf stderr "                One binary, four arrangements: --local (the\n")
        (fprintf stderr "                default), the server, --http, --embed\n")
        (fprintf stderr "  --out DIR     swarm only: each worker logs to DIR/WORKER.log\n")
        (fprintf stderr "  --vacuum      let programs call vacuum_kb/0,1 -- reclaims dead\n")
        (fprintf stderr "                rows at the cost of point-in-time reads\n")
        (fprintf stderr "  --trace       the four-port tracer, SWI's format, on stderr:\n")
        (fprintf stderr "                Call, Exit, Redo and Fail for every goal proved.\n")
        (fprintf stderr "                trace/0 and notrace/0 switch it from inside\n"))

  ;;; Reads a whole file. Answers nil if it cannot, with the reason printed.
  (func slurp ((const char * path)) (out char *)
        (let ((FILE * f . #'(fopen path "rb")) (char * buf . nil) (long n . 0)
              (size_t got . 0))
          (if (== f nil)
              (block (fprintf stderr "cocolog: cannot read %s\n" path) (return nil)))
          (fseek f 0 SEEK_END)
          (set n (ftell f))
          (fseek f 0 SEEK_SET)
          (set buf (cast (char *) (malloc (cast size_t (+ n 1)))))
          (if (== buf nil) (block (fclose f) (return nil)))
          ;; a short read terminates at what actually arrived
          (set got (fread buf 1 (cast size_t n) f))
          (set (nth got buf) (cast char 0))
          (fclose f)
          (return buf)))

  ;;; The query as it now stands -- which is the answer. Writing the query
  ;;; rather than a list of variable bindings is deliberate: a machine that has
  ;;; been suspended and resumed no longer has the variable NAMES, because
  ;;; those belong to the text that was read and not to the machine. The
  ;;; instantiated goal says the same thing and survives the round trip.
  ;;;
  ;;; IT IS COLLECTED RATHER THAN PRINTED, and INTO is where. A turn's answers
  ;;; are only true if the turn's state reaches the database: a worker that
  ;;; printed as it went and then lost its connection would have announced
  ;;; answers the rolled-back machine is going to produce again on the next
  ;;; turn, and the same answer twice is exactly what a suspendable machine
  ;;; must never do. So a turn buffers what it found and prints it after the
  ;;; commit, and a turn that fails throws the buffer away with the work.
  (func show_answer ((coco_engine * e) (int n) (coco_strbuf * into))
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_term ($ (cof e) m) (aof b) ($ (cof e) query) 0 0)
          (if (== into nil)
              (printf "  %d. %s\n" n (? (== ($ b s) nil) "true" ($ b s)))
            (block (coco_sb_put into "  ")
                   (coco_sb_put_i64 into (cast i64 n))
                   (coco_sb_put into ". ")
                   (coco_sb_put into (? (== ($ b s) nil) "true" ($ b s)))
                   (coco_sb_putc into (cast char 10))))
          (coco_sb_free (aof b))))

  ;;; Opens the connection the options ask for, or leaves db null for --local.
  ;;;
  ;;; NOT CALLED `connect'. It was, and the program recursed until the stack
  ;;; ran out: connect(2) is what the client calls to open its socket, and a
  ;;; global function of that name in the program takes the link ahead of the
  ;;; one in libc. Nothing warns -- it links, it runs, and it dies twenty
  ;;; thousand frames later inside a function that never called itself.
  (func open_connection () (out int)
        (let ((char err [512]) (char turnfile [512]) (const char * path))
          (if ($ opts local) (return 1))
          ;; ZEYTUN NEEDS NO BINARY CONNECTION, and until now it opened one
          ;; anyway -- so `--http' dialled the server on 2160 as well, and a
          ;; querier that could only reach the HTTP edge got
          ;; `no server at NAME:2160' from an arrangement that was never
          ;; going to use it. That is the whole point of the tunnel: the
          ;; VM is reachable at one port and nothing else.
          ;;
          ;; IT WENT UNNOTICED BECAUSE THE SUITE ALWAYS HAS A SERVER. The
          ;; `tunnel' case raises an edge stand-in on localhost, where 2160
          ;; is answering too, so the extra connection succeeded and paid
          ;; for nothing. Every read in this arrangement goes through
          ;; `zt_get'; `db' staying null is what the five
          ;; `(and (!= db nil) (== ($ opts http) nil))' guards below already
          ;; expect.
          (if (!= ($ opts http) nil) (return 1))
          (if (!= ($ opts store) nil)
              (block
                (set db (zg_open_embed ($ opts store) err (sizeof err)))
                (if (== db nil)
                    (block (fprintf stderr "cocolog: no embedded store at %s -- %s\n"
                                    ($ opts store) err)
                           (return 0)))
                (return 1)))
          (set db (zg_open ($ opts host) ($ opts port) ($ opts timeout) err (sizeof err)))
          (if (== db nil)
              (block (fprintf stderr "cocolog: no server at %s:%s -- %s\n"
                              ($ opts host) ($ opts port) err)
                     (return 0)))

          ;; TAKING TURNS IS OFF BY DEFAULT, AND THAT IS THE WHOLE POINT OF THE
          ;; PROJECT. Interpreters that queue behind one another are not
          ;; concurrent interpreters; they are one interpreter with extra
          ;; processes. So cocolog talks to the server the way any client
          ;; should -- all at once -- and the server is expected to cope.
          ;;
          ;; IT EXISTS AT ALL because for a while the server did not cope, and
          ;; the reason is worth keeping to hand. ZiguratIP serves every
          ;; connection on its own thread but through ONE shared pair of page
          ;; streams, and an indexed WHERE walked its B-tree straight through
          ;; them holding no lock at all: two clients at once read from each
          ;; other's file position, which surfaced as `hexmap ends inside the
          ;; chunk at NNNNN' and, often enough, as a dead server and a store
          ;; that had to be thrown away. That is fixed in ZiguratIP itself now
          ;; (MVCCS/memory.hpp, Memory::Streams) rather than worked around
          ;; here.
          ;;
          ;;   --lock PATH   take turns through PATH, for a server that has not
          ;;                 got the fix. One flock(2) per transaction: correct,
          ;;                 and about as concurrent as a queue.
          ;;   --lock auto   the same, through a file named for the host and
          ;;                 port, so everything talking to one server queues
          ;;                 together and two servers do not queue behind each
          ;;                 other.
          (set path ($ opts lock))
          (if (and (!= path nil) (== 0 (strcmp path "auto")))
              (block
               (let ((const char * tmp . #'(getenv "TMPDIR")))
                 (if (or (== tmp nil) (== (nth 0 tmp) (cast char 0))) (set tmp "/tmp"))
                 (snprintf turnfile (sizeof turnfile) "%s/cocolog-%s-%s.turn"
                           tmp ($ opts host) ($ opts port))
                 (set path turnfile))))
          (if (and (!= path nil) (== 0 (strcmp path "none"))) (set path nil))
          (if (not (zg_serialise db path ($ opts timeout)))
              (block (fprintf stderr "cocolog: %s\n" (zg_error db)) (return 0)))
          (return 1)))

  ;;; ---- the commands ------------------------------------------------------

  ;;; The vacuum gate, run after every attach: the backend installs the
  ;;; `vacuum' hook because it CAN, and this clears it again unless the
  ;;; operator said this run MAY (`--vacuum'). `vacuum_kb' finding the hook
  ;;; null raises permission_error -- see kb.cicili. It is a gate at the
  ;;; composition root rather than a flag the engine reads, so the engine
  ;;; never has to know the option exists.
  (func gate_vacuum ((coco_store * st))
        (if (not ($ opts vacuum)) (set (-> st vacuum) nil)))

  (func cmd_consult ((int argc) (char ** argv) (int from)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_zg z) (char err [256]) (int total . 0))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (if (not ($ opts local)) (coco_zg_attach (aof z) db (aof m) (aof st) ($ opts kb)))
          (gate_vacuum (aof st))
          ;; batched: each consulted predicate is written ONCE, at the end,
          ;; instead of being re-synced whole on every clause -- which was
          ;; quadratic, and 61 measured seconds for one 150-clause file
          (if (!= db nil) (coco_zg_batch (aof z) 1))
          (for ((int i . from)) (< i argc) ((++ i))
            (let ((char * text . #'(slurp (nth i argv))) (int n))
              (if (== text nil) (block (coco_store_free (aof st)) (coco_machine_free (aof m))
                                       (return 1)))
              (set n (coco_consult (aof st) (aof m) text err (sizeof err)))
              (free text)
              (if (< n 0)
                  (block (fprintf stderr "cocolog: %s: %s\n" (nth i argv) err)
                         (coco_store_free (aof st)) (coco_machine_free (aof m))
                         (return 1)))
              (set total (+ total n))))
          (if (!= db nil)
              (if (not (coco_zg_batch (aof z) 0))
                  (block (fprintf stderr "cocolog: writing the consulted clauses: %s\n"
                                  (zg_error db))
                         (zg_rollback db)
                         (coco_store_free (aof st)) (coco_machine_free (aof m))
                         (return 1))))
          (if (!= db nil)
              (if (not (zg_commit db))
                  (block (fprintf stderr "cocolog: commit failed: %s\n" (zg_error db))
                         (coco_store_free (aof st)) (coco_machine_free (aof m))
                         (return 1))))
          (printf "consulted %d clause(s) into '%s'\n" total ($ opts kb))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return 0)))

  ;;; Attaches whichever backend the options asked for. Both fill in the same
  ;;; hook; nothing below this line knows which.
  (func attach ((coco_zg * z) (coco_zt * zt) (coco_machine * m) (coco_store * st))
        (if ($ opts local) (return))
        (if (!= ($ opts http) nil)
            (coco_zt_attach zt ($ opts host) ($ opts http) m st ($ opts kb))
          (coco_zg_attach z db m st ($ opts kb)))
        (gate_vacuum st))

  ;;; ---- a thread's own knowledge base ----------------------------------
  ;;;
  ;;; What `coco_m_kb_install' asks for, and the reason library(httpd)'s
  ;;; worker pool can serve a page that reads the database at all. Before
  ;;; this a thread was a `--local' proof whatever the parent was, because
  ;;; `db' is thread-local and null on a new thread.
  ;;;
  ;;; IT IS THE SWARM COMMAND'S SHAPE, and deliberately: one connection
  ;;; per thread, opened by the thread, attached to the thread's own
  ;;; store. Two threads through one Zigurat connection is the wedge
  ;;; STATUS.md spent a day on.
  ;;;
  ;;; THE ATTACHMENT STRUCTS OUTLIVE THE CALL, which is why there is a
  ;;; holder at all: `attach' points the store's five hooks INTO `z' and
  ;;; `zt', and cmd_query can keep those on its stack because its proof
  ;;; ends before its frame does. A thread's proof outlives this function
  ;;; by the whole life of the thread, so they go on the heap.
  ;;; THE PREVIOUS CONNECTION IS SAVED, because these NEST. A worker
  ;;; thread's own proof has one, and every request it serves runs as an
  ;;; isolated proof of its own with another -- `db' is one thread-local
  ;;; slot, so without saving it the inner open would overwrite the outer
  ;;; one and the inner close would shut a connection its owner still
  ;;; thought it had.
  (struct thread_kb
    (member coco_zg z)
    (member coco_zt zt)
    (member zg_conn * prev))

  (func thread_kb_open ((coco_machine * m) (coco_store * st) (void ** ctx)) (out int)
        (let ((thread_kb * k . nil) (zg_conn * saved . nil))
          (set (cof ctx) nil)
          ;; NO DATABASE IN THIS ARRANGEMENT IS NOT A FAILURE. `--local'
          ;; says it every time and a thread there is exactly what it was.
          (if ($ opts local) (return 0))
          (set saved db)
          (set db nil)
          (if (not (open_connection))
              (block (set db saved) (return 0)))
          (set k (cast (thread_kb *) (malloc (sizeof thread_kb))))
          (if (== k nil)
              (block (if (!= db nil) (zg_close db)) (set db saved) (return 0)))
          (memset k 0 (sizeof thread_kb))
          (set (-> k prev) saved)
          (attach (aof (-> k z)) (aof (-> k zt)) m st)
          (set (cof ctx) (cast (void *) k))
          (return 1)))

  ;;; A CONNECTION THAT WROTE AND THEN FAILED ROLLS BACK. The same rule
  ;;; cmd_query has, for the same reason: half of a failed goal's
  ;;; assertions is not a state anybody asked for. Zeytun reads only, so
  ;;; there is nothing to commit there and `db' is null.
  (func thread_kb_close ((void * ctx) (int ok))
        (let ((thread_kb * k . #'(cast (thread_kb *) ctx)))
          (if (!= db nil)
              (if ok
                  (if (not (zg_commit db))
                      (fprintf stderr "cocolog: a thread's commit failed: %s\n"
                               (zg_error db)))
                (zg_rollback db)))
          (if (!= db nil) (zg_close db))
          ;; back to whoever had it, which is null unless this was nested
          (set db (? (== k nil) nil (-> k prev)))
          (if (!= k nil) (free (cast (void *) k)))))

  (func cmd_query ((const char * goal)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_engine e) (coco_zg z) (coco_zt zt)
              (int n . 0) (int rc . 1))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_engine_init (aof e) (aof m) (aof st))
          (set ($ e max_steps) 0)
          (attach (aof z) (aof zt) (aof m) (aof st))

          (if (not (coco_engine_ask_text (aof e) goal))
              (block (fprintf stderr "cocolog: %s\n" ($ e err)) (return 1)))
          (while 1
            (set rc (coco_engine_next (aof e)))
            (if (!= rc 1) break)
            (set n (+ n 1))
            (show_answer (aof e) n nil)
            (if (and (!= ($ opts answers) 0) (>= n ($ opts answers))) break))
          (if (== rc -1) (fprintf stderr "cocolog: %s\n" ($ e err)))

          ;; A QUERY CAN WRITE. `assert', `retract' and `dynamic' reach the
          ;; database through the store's hooks, and until this commit was here
          ;; every one of them was rolled back when the connection closed: the
          ;; goal succeeded, said so, and changed nothing. A query that ended in
          ;; an error is rolled back instead, whole -- half of a failed goal's
          ;; assertions is not a state any program asked for.
          (if (!= db nil)
              (if (== rc -1)
                  (zg_rollback db)
                (if (not (zg_commit db))
                    (block (fprintf stderr "cocolog: commit failed: %s\n" (zg_error db))
                           (set rc -1)))))

          (if (== n 0) (printf "false.\n") (printf "%d answer(s).\n" n))
          (coco_engine_free (aof e))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return (? (== rc -1) 1 0))))

  ;;; ---- the line editor ----------------------------------------------------
  ;;;
  ;;; A small readline of cocolog's own, written rather than linked: GNU
  ;;; readline's license is not this project's, and a line editor is not
  ;;; much code. Emacs keys (C-a C-e C-b C-f C-k C-u C-w C-l), the arrows
  ;;; and Home/End/Delete by their escape sequences, and a history walked
  ;;; with C-p/C-n or up/down that survives in ~/.cocolog_history. It is
  ;;; byte-based -- a multi-byte character arrives as its bytes and the
  ;;; arrows step through them -- and single-line: a goal wider than the
  ;;; terminal wraps visually while the editing stays correct. Only the
  ;;; toplevel at a terminal comes near it; piped input never does.

  (var char ** coco_ln_hist . nil)
  (var int coco_ln_hist_len . 0)
  (var const int COCO_LN_HIST_MAX . 1000)

  (func coco_ln_hist_add ((const char * s))
        (if (or (== s nil) (== (nth 0 s) (cast char 0))) (return))
        ;; consecutive duplicates collapse, as readline collapses them
        (if (and (> coco_ln_hist_len 0)
                 (== 0 (strcmp (nth (- coco_ln_hist_len 1) coco_ln_hist) s)))
            (return))
        (if (== coco_ln_hist nil)
            (set coco_ln_hist
                 (cast (char **) (malloc (* (cast size_t COCO_LN_HIST_MAX)
                                            (sizeof (char *)))))))
        (if (== coco_ln_hist nil) (return))
        (if (>= coco_ln_hist_len COCO_LN_HIST_MAX)
            (block (free (nth 0 coco_ln_hist))
                   (for ((int k . 1)) (< k COCO_LN_HIST_MAX) ((++ k))
                     (set (nth (- k 1) coco_ln_hist) (nth k coco_ln_hist)))
                   (set coco_ln_hist_len (- coco_ln_hist_len 1))))
        (set (nth coco_ln_hist_len coco_ln_hist) (strdup s))
        (set coco_ln_hist_len (+ coco_ln_hist_len 1)))

  (func coco_ln_hist_load ((const char * path))
        (let ((FILE * f . #'(fopen path "r")) (char buf [4096]))
          (if (== f nil) (return))
          (while (!= (fgets buf (sizeof buf) f) nil)
            (let ((size_t n . #'(strlen buf)))
              (while (and (> n 0) (or (== (nth (- n 1) buf) (cast char 10))
                                      (== (nth (- n 1) buf) (cast char 13))))
                (set n (- n 1))
                (set (nth n buf) (cast char 0)))
              (coco_ln_hist_add buf)))
          (fclose f)))

  (func coco_ln_hist_save ((const char * path))
        (let ((FILE * f . #'(fopen path "w")))
          (if (== f nil) (return))
          (for ((int k . 0)) (< k coco_ln_hist_len) ((++ k))
            (fprintf f "%s\n" (nth k coco_ln_hist)))
          (fclose f)))

  ;;; Repaints the line: prompt, buffer, erase rightward, cursor placed.
  (func coco_ln_refresh ((const char * prompt) (const char * buf) (int cur))
        (printf "\r%s%s\x1b[0K" prompt buf)
        (let ((int col . #'(+ (cast int (strlen prompt)) cur)))
          (if (> col 0) (printf "\r\x1b[%dC" col) (printf "\r")))
        (fflush stdout))

  ;;; Reads one line with editing, the terminal put in raw mode for the
  ;;; duration and put back before every way out. Answers a malloc'd line,
  ;;; or nil at end of input (C-d on an empty line, or the terminal gone).
  ;;; C-c drops the line and answers empty, which the toplevel reads as
  ;;; "fresh prompt".
  (func coco_ln_edit ((const char * prompt)) (out char *)
        (let ((char buf [4096]) (char saved [4096]) (char c . 0)
              (int len . 0) (int cur . 0) (int nr . 0)
              (int browse . #'coco_ln_hist_len))
          (code "struct termios ln_orig, ln_raw;")
          (if (!= 0 (cast int (code "tcgetattr(0, &ln_orig)"))) (return nil))
          (code "ln_raw = ln_orig;")
          (code "ln_raw.c_iflag &= ~(BRKINT | ICRNL | INPCK | ISTRIP | IXON);")
          (code "ln_raw.c_lflag &= ~(ECHO | ICANON | IEXTEN | ISIG);")
          (code "ln_raw.c_cflag |= CS8;")
          (code "ln_raw.c_cc[VMIN] = 1; ln_raw.c_cc[VTIME] = 0;")
          (code "tcsetattr(0, TCSADRAIN, &ln_raw);")
          (set (nth 0 buf) (cast char 0))
          (set (nth 0 saved) (cast char 0))
          (coco_ln_refresh prompt buf 0)
          (while 1
            (set nr (cast int (code "read(0, &c, 1)")))
            (if (<= nr 0)
                (block (code "tcsetattr(0, TCSADRAIN, &ln_orig);")
                       (printf "\r\n") (fflush stdout)
                       (return nil)))

            ;; the escape sequences become their control twins, so every
            ;; key has one arm below: arrows to C-p/C-n/C-f/C-b, Home and
            ;; End to C-a/C-e, Delete to its own 18
            (if (== c (cast char 27))                    ; ESC
                (let ((char s0 . 0) (char s1 . 0) (char s2 . 0))
                  (if (<= (cast int (code "read(0, &s0, 1)")) 0) continue)
                  (if (== s0 (cast char 91))             ; [
                      (block
                       (if (<= (cast int (code "read(0, &s1, 1)")) 0) continue)
                       (cond
                         ((== s1 (cast char 65)) (set c (cast char 16)))  ; A up
                         ((== s1 (cast char 66)) (set c (cast char 14)))  ; B down
                         ((== s1 (cast char 67)) (set c (cast char 6)))   ; C right
                         ((== s1 (cast char 68)) (set c (cast char 2)))   ; D left
                         ((== s1 (cast char 72)) (set c (cast char 1)))   ; H home
                         ((== s1 (cast char 70)) (set c (cast char 5)))   ; F end
                         ((and (>= s1 (cast char 48)) (<= s1 (cast char 57)))
                          (if (<= (cast int (code "read(0, &s2, 1)")) 0) continue)
                          (if (== s1 (cast char 51))     ; 3~ delete
                              (set c (cast char 18))
                            continue))
                         (#t continue)))
                    (if (== s0 (cast char 79))           ; O
                        (block
                         (if (<= (cast int (code "read(0, &s1, 1)")) 0) continue)
                         (cond
                           ((== s1 (cast char 72)) (set c (cast char 1)))
                           ((== s1 (cast char 70)) (set c (cast char 5)))
                           (#t continue)))
                      continue))))

            (cond
              ;; Enter, either ending
              ((or (== c (cast char 13)) (== c (cast char 10)))
               (code "tcsetattr(0, TCSADRAIN, &ln_orig);")
               (printf "\r\n") (fflush stdout)
               (return (strdup buf)))

              ;; C-c: the line is dropped, the prompt is fresh
              ((== c (cast char 3))
               (code "tcsetattr(0, TCSADRAIN, &ln_orig);")
               (printf "^C\r\n") (fflush stdout)
               (return (strdup "")))

              ;; C-d: the end on an empty line, a delete otherwise
              ((== c (cast char 4))
               (if (== len 0)
                   (block (code "tcsetattr(0, TCSADRAIN, &ln_orig);")
                          (printf "\r\n") (fflush stdout)
                          (return nil))
                 (block
                  (if (< cur len)
                      (block (for ((int k . cur)) (< k (- len 1)) ((++ k))
                               (set (nth k buf) (nth (+ k 1) buf)))
                             (set len (- len 1))
                             (set (nth len buf) (cast char 0))
                             (coco_ln_refresh prompt buf cur))))))

              ;; Delete at the cursor
              ((== c (cast char 18))
               (if (< cur len)
                   (block (for ((int k . cur)) (< k (- len 1)) ((++ k))
                            (set (nth k buf) (nth (+ k 1) buf)))
                          (set len (- len 1))
                          (set (nth len buf) (cast char 0))
                          (coco_ln_refresh prompt buf cur))))

              ;; Backspace
              ((or (== c (cast char 127)) (== c (cast char 8)))
               (if (> cur 0)
                   (block (for ((int k . #'(- cur 1))) (< k (- len 1)) ((++ k))
                            (set (nth k buf) (nth (+ k 1) buf)))
                          (set cur (- cur 1))
                          (set len (- len 1))
                          (set (nth len buf) (cast char 0))
                          (coco_ln_refresh prompt buf cur))))

              ((== c (cast char 1))                      ; C-a
               (set cur 0) (coco_ln_refresh prompt buf cur))
              ((== c (cast char 5))                      ; C-e
               (set cur len) (coco_ln_refresh prompt buf cur))
              ((== c (cast char 2))                      ; C-b
               (if (> cur 0) (block (set cur (- cur 1))
                                    (coco_ln_refresh prompt buf cur))))
              ((== c (cast char 6))                      ; C-f
               (if (< cur len) (block (set cur (+ cur 1))
                                      (coco_ln_refresh prompt buf cur))))

              ((== c (cast char 11))                     ; C-k: kill rightward
               (set len cur)
               (set (nth len buf) (cast char 0))
               (coco_ln_refresh prompt buf cur))
              ((== c (cast char 21))                     ; C-u: kill the line
               (set len 0) (set cur 0)
               (set (nth 0 buf) (cast char 0))
               (coco_ln_refresh prompt buf cur))
              ((== c (cast char 23))                     ; C-w: kill a word back
               (let ((int e . cur))
                 (while (and (> cur 0) (== (nth (- cur 1) buf) (cast char 32)))
                   (set cur (- cur 1)))
                 (while (and (> cur 0) (!= (nth (- cur 1) buf) (cast char 32)))
                   (set cur (- cur 1)))
                 (let ((int d . #'(- e cur)))
                   (if (> d 0)
                       (block (for ((int k . cur)) (<= k (- len d)) ((++ k))
                                (set (nth k buf) (nth (+ k d) buf)))
                              (set len (- len d))
                              (coco_ln_refresh prompt buf cur))))))

              ((== c (cast char 12))                     ; C-l: clear screen
               (printf "\x1b[H\x1b[2J")
               (coco_ln_refresh prompt buf cur))

              ((== c (cast char 16))                     ; C-p / up: older
               (if (> coco_ln_hist_len 0)
                   (block
                    (if (== browse coco_ln_hist_len)
                        (memcpy saved buf (cast size_t (+ len 1))))
                    (if (> browse 0)
                        (block (set browse (- browse 1))
                               (snprintf buf (sizeof buf) "%s"
                                         (nth browse coco_ln_hist))
                               (set len (cast int (strlen buf)))
                               (set cur len)
                               (coco_ln_refresh prompt buf cur))))))
              ((== c (cast char 14))                     ; C-n / down: newer
               (if (< browse coco_ln_hist_len)
                   (block
                    (set browse (+ browse 1))
                    (if (== browse coco_ln_hist_len)
                        (snprintf buf (sizeof buf) "%s" saved)
                      (snprintf buf (sizeof buf) "%s" (nth browse coco_ln_hist)))
                    (set len (cast int (strlen buf)))
                    (set cur len)
                    (coco_ln_refresh prompt buf cur))))

              ;; anything printable -- the high half of UTF-8 included,
              ;; whose bytes are negative in a signed char -- is inserted
              (#t
               (if (and (or (< (cast int c) 0) (>= (cast int c) 32))
                        (!= (cast int c) 127)
                        (< len 4094))
                   (block (for ((int k . len)) (> k cur) ((-- k))
                            (set (nth k buf) (nth (- k 1) buf)))
                          (set (nth cur buf) c)
                          (set cur (+ cur 1))
                          (set len (+ len 1))
                          (set (nth len buf) (cast char 0))
                          (coco_ln_refresh prompt buf cur))))))))

  ;;; ---- the toplevel -------------------------------------------------------

  ;;; Appends one physical line of stdin to INTO, without its newline.
  ;;; Answers 1, or 0 at end of input with nothing read.
  (func repl_gets ((coco_strbuf * into)) (out int)
        (let ((int c . 0) (int got . 0))
          (while 1
            (set c (fgetc stdin))
            (if (== c -1) break)
            (set got 1)
            (if (== c 10) break)              ; newline
            (coco_sb_putc into (cast char c)))
          (return got)))

  (func repl_blank ((coco_strbuf * b)) (out int)
        (let ((const char * s . #'(-> b s)))
          (if (== s nil) (return 1))
          (for ((size_t i . 0)) (!= (nth i s) (cast char 0)) ((++ i))
            (if (and (!= (nth i s) (cast char 32))  ; space
                     (!= (nth i s) (cast char 9))   ; tab
                     (!= (nth i s) (cast char 13))) ; CR
                (return 0)))
          (return 1)))

  ;;; Whether the goal gathered so far has reached its full stop -- the last
  ;;; dark character is `.'. The reader has the final say on what the text
  ;;; means; this only decides when to stop asking for more lines.
  (func repl_complete ((coco_strbuf * b)) (out int)
        (let ((const char * s . #'(-> b s)) (size_t n . 0))
          (if (== s nil) (return 0))
          (set n (strlen s))
          (while (and (> n 0)
                      (or (== (nth (- n 1) s) (cast char 32))
                          (== (nth (- n 1) s) (cast char 9))
                          (== (nth (- n 1) s) (cast char 13))
                          (== (nth (- n 1) s) (cast char 10))))
            (set n (- n 1)))
          (return (? (and (> n 0) (== (nth (- n 1) s) (cast char 46))) 1 0)))) ; `.'

  ;;; Consults one file into the session's store, trying `NAME.pl' when NAME
  ;;; itself is not on disk -- `[family].' reads family.pl, as SWI has it.
  (func repl_consult_one ((coco_store * st) (coco_machine * m) (const char * name)) (out int)
        (let ((char withpl [512]) (const char * path . name) (FILE * probe . nil)
              (char err [256]) (char * text . nil) (int n . 0))
          (set probe (fopen name "rb"))
          (if (!= probe nil)
              (fclose probe)
            (block (snprintf withpl (sizeof withpl) "%s.pl" name)
                   (set path withpl)))
          (set text (slurp path))
          (if (== text nil) (return 0))
          (set n (coco_consult st m text err (sizeof err)))
          (free text)
          (if (< n 0)
              (block (fprintf stderr "cocolog: %s: %s\n" path err)
                     (return 0)))
          (return 1)))

  ;;; `[family, jobs].' and `consult(family).' at the toplevel, SWI's reading:
  ;;; a list of atoms consults files. Answers 1 consulted, 0 tried and failed,
  ;;; -1 not a consult at all -- a bare atom is a goal, so only the two
  ;;; wrapped forms reach the disk.
  (func repl_consult_goal ((coco_store * st) (coco_machine * m) (size_t goal)) (out int)
        (let ((size_t t . #'(coco_deref m goal)) (int wrapped . 0))
          (if (and (coco-tag-is FUN (nth t (-> m heap)))
                   (== (coco_arity m t) 1)
                   (== 0 (strcmp (coco_atom_name m (coco_name_of m t)) "consult")))
              (block (set wrapped 1)
                     (set t (coco_deref m (coco_arg m t 0)))))
          (if (and wrapped (coco-tag-is ATOM (nth t (-> m heap)))
                   (!= 0 (strcmp (coco_atom_name m (coco_name_of m t)) "[]")))
              (return (? (repl_consult_one st m (coco_atom_name m (coco_name_of m t))) 1 0)))
          ;; from here T means something only as a proper list of atoms --
          ;; checked WHOLE before any file is opened, so `[good, 3]' does not
          ;; consult half of itself and then turn out not to be a consult
          (let ((size_t p . t) (int shape . 1))
            (while 1
              (if (coco-tag-is ATOM (nth p (-> m heap)))
                  (block (if (!= 0 (strcmp (coco_atom_name m (coco_name_of m p)) "[]"))
                             (set shape 0))
                         break))
              (if (not (and (coco-tag-is FUN (nth p (-> m heap)))
                            (== (coco_arity m p) 2)
                            (== 0 (strcmp (coco_atom_name m (coco_name_of m p)) "."))))
                  (block (set shape 0) break))
              (if (not (coco-tag-is ATOM (nth (coco_deref m (coco_arg m p 0)) (-> m heap))))
                  (block (set shape 0) break))
              (set p (coco_deref m (coco_arg m p 1))))
            (if (not shape)
                (block (if (not wrapped) (return -1))
                       (fprintf stderr "cocolog: consult wants a file name or a list of them\n")
                       (return 0))))
          (let ((size_t p . t))
            (while (not (coco-tag-is ATOM (nth p (-> m heap))))
              (if (not (repl_consult_one st m
                         (coco_atom_name m (coco_name_of m (coco_deref m (coco_arg m p 0))))))
                  (return 0))
              (set p (coco_deref m (coco_arg m p 1)))))
          (return 1)))

  ;;; One completed goal into the history, its newlines flattened to spaces
  ;;; -- the history is a list of lines -- and the file brought up to date
  ;;; at once, so a session that dies keeps what was typed.
  (func repl_history_add ((coco_strbuf * b) (const char * path))
        (let ((const char * s . #'(-> b s)) (char * flat . nil) (size_t n . 0))
          (if (== s nil) (return))
          (set n (strlen s))
          (set flat (cast (char *) (malloc (+ n 1))))
          (if (== flat nil) (return))
          (for ((size_t i . 0)) (<= i n) ((++ i))
            (set (nth i flat) (? (== (nth i s) (cast char 10)) (cast char 32)
                                 (nth i s))))
          (coco_ln_hist_add flat)
          (free flat)
          (if (!= path nil) (coco_ln_hist_save path))))

  ;;; The display name of a still-unbound cell: the LAST of the query's
  ;;; variables standing on it, which is SWI's choice -- `X = Y, f(A,B) =
  ;;; f(B,A)' answers `X = Y' and `A = B'. A `_'-named variable can name a
  ;;; cell too (`X = f(_Q)' shows f(_Q), as SWI shows it), but only when no
  ;;; plainly named one stands there. Answers nil for a cell no query
  ;;; variable stands on.
  (func repl_cell_name ((coco_reader * r) (coco_machine * m) (size_t cell))
        (out const char *)
        (let ((const char * plain . nil) (const char * any . nil))
          (for ((size_t k . 0)) (< k (-> r nvars)) ((++ k))
            (let ((size_t tk . #'(coco_deref m (nth k (-> r var_cells)))))
              (if (and (== tk cell) (coco-tag-is REF (nth tk (-> m heap))))
                  (block (set any (nth k (-> r var_names)))
                         (if (!= (nth 0 (nth k (-> r var_names))) (cast char 95))
                             (set plain (nth k (-> r var_names))))))))
          (return (? (!= plain nil) plain any))))

  ;;; Prints S, giving each still-unbound query variable its own name: the
  ;;; writer says `_G<cell>' and the cell may be one the query has a name
  ;;; for. The token is matched whole -- `_G19' is not the front of `_G195'.
  (func repl_print_value ((coco_reader * r) (coco_machine * m) (const char * s))
        (let ((size_t i . 0) (size_t n . #'(strlen s)))
          (while (< i n)
            (if (and (== (nth i s) (cast char 95))        ; `_'
                     (< (+ i 1) n)
                     (== (nth (+ i 1) s) (cast char 71))) ; `G'
                (block
                 (let ((size_t j . #'(+ i 2)) (size_t cell . 0) (int nd . 0)
                       (const char * name . nil))
                   (while (and (< j n)
                               (>= (nth j s) (cast char 48))
                               (<= (nth j s) (cast char 57)))
                     (set cell (+ (* cell 10) (cast size_t (- (nth j s) (cast char 48)))))
                     (set nd 1)
                     (set j (+ j 1)))
                   (if nd (set name (repl_cell_name r m cell)))
                   (if (!= name nil)
                       (block (printf "%s" name) (set i j))
                     (block (putchar (cast int (nth i s))) (set i (+ i 1))))))
              (block (putchar (cast int (nth i s))) (set i (+ i 1)))))))

  ;;; Prints one solution's bindings the way SWI's toplevel does: `X = 1,' a
  ;;; line each for the query's own named variables, values quoted so they
  ;;; read back. A variable still unbound prints only when it shares its cell
  ;;; with the variable the cell is named for -- `X = Y' -- and the named one
  ;;; itself stays silent, which is why `true' exists: the caller says it
  ;;; when nothing printed. Answers how many bindings it printed.
  (func repl_bindings ((coco_engine * e) (coco_reader * r)) (out int)
        (let ((coco_machine * m . #'(-> e m)) (int printed . 0))
          (for ((size_t i . 0)) (< i (-> r nvars)) ((++ i))
            (let ((const char * name . #'(nth i (-> r var_names)))
                  (size_t t . #'(coco_deref m (nth i (-> r var_cells)))))
              (if (== (nth 0 name) (cast char 95)) continue) ; `_' stays quiet
              (if (coco-tag-is REF (nth t (-> m heap)))
                  (block
                   (let ((const char * chosen . #'(repl_cell_name r m t)))
                     (if (or (== chosen nil) (== 0 (strcmp chosen name))) continue)
                     (if (> printed 0) (printf ",\n"))
                     (printf "%s = %s" name chosen)
                     (set printed (+ printed 1))))
                (block
                 (let ((coco_strbuf vb))
                   (coco_sb_init (aof vb))
                   (coco_write_term m (aof vb) t 1 0)
                   (if (> printed 0) (printf ",\n"))
                   (printf "%s = " name)
                   (if (!= ($ vb s) nil) (repl_print_value r m ($ vb s)))
                   (coco_sb_free (aof vb)))
                 (set printed (+ printed 1))))))
          (return printed)))

  ;;; The toplevel. Bare `cocolog' is what bare `swipl' is: a `?- ' prompt,
  ;;; goals read to their full stop over as many lines as they take, answers
  ;;; under the query's own variable names, `;' for another solution. The
  ;;; punctuation is honest because the engine's choice stack is: a solution
  ;;; that left no choice point ends `.' with nobody asked, one that did ends
  ;;; ` ' and waits. One machine, one store and one engine live for the whole
  ;;; session, so what a goal asserts or consults the next goal sees -- in
  ;;; --local no less than against a database, where each finished goal is
  ;;; one committed transaction, exactly as `query' has it. Prompts appear
  ;;; only at a terminal, and piped input has its unechoed `;' restored on
  ;;; the way out, so a transcript reads as a terminal session does.
  (func cmd_repl () (out int)
        (let ((coco_machine m) (coco_store st) (coco_engine e) (coco_zg z) (coco_zt zt)
              (int tty . #'(isatty 0)) (int quit . 0) (int session_rc . 0)
              (char histpath [512]) (const char * hf . nil))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_engine_init (aof e) (aof m) (aof st))
          (set ($ e max_steps) 0)
          (attach (aof z) (aof zt) (aof m) (aof st))

          (if tty
              (block
               (cond
                 (($ opts local)
                  (fprintf stderr "cocolog toplevel, --local: this session only.\n"))
                 ((!= ($ opts store) nil)
                  (fprintf stderr "cocolog toplevel, the store at %s.\n" ($ opts store)))
                 ((!= ($ opts http) nil)
                  (fprintf stderr "cocolog toplevel over Zeytun, kb '%s' at %s:%s.\n"
                           ($ opts kb) ($ opts host) ($ opts http)))
                 (#t
                  (fprintf stderr "cocolog toplevel, kb '%s' at %s:%s.\n"
                           ($ opts kb) ($ opts host) ($ opts port))))
               (fprintf stderr "A goal ends with `.' -- halt. leaves.\n")))

          ;; the history, at a terminal: what earlier sessions typed is a
          ;; C-p away, and what this one types joins the file as it goes
          (if tty
              (let ((const char * home . #'(getenv "HOME")))
                (if (and (!= home nil) (!= (nth 0 home) (cast char 0)))
                    (block (snprintf histpath (sizeof histpath)
                                     "%s/.cocolog_history" home)
                           (set hf histpath)
                           (coco_ln_hist_load hf)))))

          (while (not quit)
            (let ((coco_strbuf line) (int got . 0) (int first . 1))
              (coco_sb_init (aof line))
              (while 1
                (if tty
                    ;; the line editor draws its own prompt
                    (let ((char * ln . #'(coco_ln_edit (? first "?- " "|    "))))
                      (if (== ln nil)
                          (set got 0)
                        (block (set got 1)
                               (coco_sb_put (aof line) ln)
                               (free ln))))
                  (set got (repl_gets (aof line))))
                (if (== got 0) break)
                (if (repl_complete (aof line)) break)
                (if (repl_blank (aof line))
                    (block (coco_sb_free (aof line))
                           (coco_sb_init (aof line))
                           (set first 1))
                  (block (coco_sb_putc (aof line) (cast char 10))
                         (set first 0))))

              (if (and (== got 0) (not (repl_complete (aof line))))
                  ;; end of input: the session is over -- the editor has
                  ;; already said its farewell newline
                  (set quit 1)
                (let ((coco_reader r) (size_t g . 0) (int prc . 0) (int grc . 0))
                  (if tty (repl_history_add (aof line) hf))
                  (coco_reader_init (aof r) (aof m) (? (== ($ line s) nil) "" ($ line s)))
                  (set prc (coco_read_clause (aof r) (aof g)))
                  (cond
                    ((== prc -1) (fprintf stderr "cocolog: %s\n" ($ r err)))
                    ((== prc 1)
                     (let ((int consulted . #'(repl_consult_goal (aof st) (aof m) g)))
                       (cond
                         ((== consulted 1) (printf "true.\n"))
                         ((== consulted 0) (set grc -1))
                         (#t
                          (coco_engine_ask (aof e) g)
                          (let ((int stop . 0))
                            (while (not stop)
                              (set grc (coco_engine_next (aof e)))
                              (cond
                                ((== grc -1)
                                 (fprintf stderr "cocolog: %s\n" ($ e err))
                                 (set stop 1))
                                ((== grc 0)
                                 (if ($ e halted)
                                     (block (set quit 1)
                                            (set session_rc ($ e halt_code)))
                                   (printf "false.\n"))
                                 (set stop 1))
                                (#t
                                 (if (== (repl_bindings (aof e) (aof r)) 0)
                                     (printf "true"))
                                 (if (== ($ e nchoices) 0)
                                     ;; determinate: nothing to go back to
                                     (block (printf ".\n") (set stop 1))
                                   (block
                                    (printf " ")
                                    (fflush stdout)
                                    (let ((char ans [64]) (int more . 0))
                                      (if (!= (fgets ans (sizeof ans) stdin) nil)
                                          (let ((size_t k . 0))
                                            (while (or (== (nth k ans) (cast char 32))
                                                       (== (nth k ans) (cast char 9)))
                                              (set k (+ k 1)))
                                            (if (== (nth k ans) (cast char 59)) ; `;'
                                                (set more 1))))
                                      (if more
                                          (block (if (not tty) (printf ";\n")))
                                        (block (printf ".\n") (set stop 1))))))))))))
                       ;; one goal, one transaction -- as `query' has it
                       (if (!= db nil)
                           (if (== grc -1)
                               (zg_rollback db)
                             (if (not (zg_commit db))
                                 (fprintf stderr "cocolog: commit failed: %s\n"
                                          (zg_error db))))))))
                  (coco_reader_free (aof r))))
              (coco_sb_free (aof line))))

          (coco_engine_free (aof e))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return session_rc)))

  ;;; Begins a machine and suspends it before it has done anything. What that
  ;;; is for: the machine exists in the database from this moment, so any
  ;;; worker can pick it up.
  (func cmd_start ((const char * name) (const char * goal)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_engine e) (coco_zg z))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: start needs a database\n") (return 1)))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_engine_init (aof e) (aof m) (aof st))
          (set ($ e max_steps) 0)
          (coco_zg_attach (aof z) db (aof m) (aof st) ($ opts kb))
          (gate_vacuum (aof st))
          (if (not (coco_engine_ask_text (aof e) goal))
              (block (fprintf stderr "cocolog: %s\n" ($ e err)) (return 1)))
          (if (not (coco_zg_save (aof z) (aof e) name goal))
              (block (fprintf stderr "cocolog: %s\n" ($ z err)) (return 1)))
          (zg_commit db)
          (printf "started '%s'\n" name)
          (coco_engine_free (aof e))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return 0)))

  ;;; THE COMMAND THE DESIGN IS FOR. Pick a machine up, run it for a bounded
  ;;; number of inferences, and put it back. A worker that does this in a loop
  ;;; is a scheduler; several of them are a scheduler with several workers, and
  ;;; the database is the run queue.
  ;;;
  ;;; BUDGET IS NOT AN ERROR. The engine answers -1 when the step limit is
  ;;; reached, the same as for a real error -- so the two are told apart by
  ;;; asking whether the machine ran out of budget rather than by the code.
  ;;;
  ;;; A TURN IS ALL OR NOTHING, AND THAT IS WHAT MAKES A RETRY SAFE. The load,
  ;;; the proving, the save and the commit are one unit: either the commit
  ;;; lands and the turn's answers are printed, or the connection went and the
  ;;; server rolled the whole transaction back and NOTHING is printed. Nothing
  ;;; reaches the terminal from a turn that did not reach the database, so a
  ;;; worker that redials and does the turn again cannot announce an answer
  ;;; twice -- and announcing an answer twice is precisely the failure a
  ;;; suspendable machine exists to avoid.
  ;;;
  ;;; Every call is checked for the same reason. An unchecked commit was the
  ;;; original sin here: it made a turn that had actually been rolled back look
  ;;; exactly like a turn that had been saved.
  (func cmd_step ((const char * name) (int to_the_end)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_engine e) (coco_zg z) (coco_strbuf out)
              (int n . 0) (int rc . 1) (int done . 0)
              (int outcome . 0) (int broke . 0) (int committed . 0))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: step needs a database\n")
                     (return (turn FAILED))))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_engine_init (aof e) (aof m) (aof st))
          (coco_sb_init (aof out))
          (coco_zg_attach (aof z) db (aof m) (aof st) ($ opts kb))
          (gate_vacuum (aof st))
          (set outcome (turn FAILED))

          ;; ONE WAY OUT. There are now six things that can go wrong here and
          ;; every one of them has three structures to free, so the body is a
          ;; run-once loop and the freeing is written once after it. The old
          ;; shape returned from the middle and leaked the machine each time.
          (while 1
            (if (not (coco_zg_load (aof z) (aof e) (aof m) (aof st) name))
                (block (fprintf stderr "cocolog: %s\n" ($ z err))
                       (set outcome (? (zg_is_open db) (turn FAILED) (turn LOST)))
                       break))

            ;; The budget is counted from where this machine already was, so a
            ;; machine resumed after a million inferences gets its own slice
            ;; and not what is left of somebody else's.
            (set ($ e max_steps) (? to_the_end 0 (+ ($ e steps) ($ opts steps))))

            (while 1
              (set rc (coco_engine_next (aof e)))
              (if (!= rc 1) break)
              (set n (+ n 1))
              (show_answer (aof e) n (aof out))
              (if (and (!= ($ opts answers) 0) (>= n ($ opts answers)))
                  (block (set done 1) break)))

            ;; A proof with no clauses left to try is finished. So is one that
            ;; broke -- but that is the program's fault and it will break the
            ;; same way next time, so it is FAILED and not something to retry.
            (if (== rc 0) (set done 1))
            (if (and (== rc -1) (== 0 (strcmp ($ e err) "inference limit reached")))
                (set done 0)
              (if (== rc -1)
                  (block (fprintf stderr "cocolog: %s\n" ($ e err))
                         (set done 1)
                         (set broke 1))))

            ;; The database half. Anything that fails in here takes the turn
            ;; with it, and the answer buffer goes unprinted along with it.
            (if done
                (if (not (coco_zg_drop (aof z) name))
                    (block (fprintf stderr "cocolog: %s\n" ($ z err))
                           (set outcome (? (zg_is_open db) (turn FAILED) (turn LOST)))
                           break))
              (if (not (coco_zg_save (aof z) (aof e) name "suspended by step"))
                  (block (fprintf stderr "cocolog: %s\n" ($ z err))
                         (set outcome (? (zg_is_open db) (turn FAILED) (turn LOST)))
                         break)))

            ;; AN UNCHECKED COMMIT WAS THE ORIGINAL SIN HERE. It made a turn
            ;; the server had rolled back look exactly like a turn that was
            ;; saved, so a worker printed answers for work that had not
            ;; happened and then did the same work again.
            (if (not (zg_commit db))
                (block (fprintf stderr "cocolog: %s: commit: %s\n" name (zg_error db))
                       (set outcome (turn LOST))
                       break))

            ;; Committed. Only now is any of it true.
            (set committed 1)
            (if (!= ($ out s) nil) (fputs ($ out s) (wout)))
            (if done
                (fprintf (wout) "%s: finished after %llu inference(s), %d answer(s) this turn\n"
                        name (cast ullong ($ e steps)) n)
              (fprintf (wout) "%s: suspended at %llu inference(s), %d answer(s) this turn\n"
                      name (cast ullong ($ e steps)) n))
            (set outcome (? done (? broke (turn FAILED) (turn FINISHED)) (turn MORE)))
            break)

          ;; A turn that did not commit is ROLLED BACK, not abandoned: the
          ;; turn is ONE transaction now, claim included, so the rollback is
          ;; what hands the machine straight back to the pool. A lost
          ;; connection needs nothing -- the server rolls back on the broken
          ;; socket -- and a lost connection is the one case zg_is_open
          ;; excludes.
          (if (and (== committed 0) (zg_is_open db))
              (zg_rollback db))

          (coco_sb_free (aof out))
          (coco_engine_free (aof e))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return outcome)))

  ;;; Redials, in place, after the server ended the connection.
  ;;;
  ;;; WHY A WORKER HAS TO BE ABLE TO DO THIS AT ALL. ZiguratIP's request loop
  ;;; answers every exception the same way: it writes EXCEPTION_THROWN and
  ;;; breaks out of the loop, so a refusal ends the CONNECTION and not merely
  ;;; the call. Under one client that never shows -- a client that got an error
  ;;; was usually about to stop anyway. Under four it shows constantly, because
  ;;; the storage engine raises transient errors when two threads are in it at
  ;;; once (MVCCS/memory.cpp, Memory::_pointer, which seeks and reads the
  ;;; shared hexmap stream without holding the mutex that truncate takes). The
  ;;; error is not damage -- the store is intact afterwards and the work simply
  ;;; did not happen -- so the answer is to dial again and do the turn over.
  ;;;
  ;;; IT IS THE SAME zg_conn AFTERWARDS. Everything holding the connection --
  ;;; every coco_zg attached to it -- keeps working, which closing and reopening
  ;;; would not allow.
  ;;;
  ;;; The wait grows with ATTEMPT and is nudged by the pid, so two workers that
  ;;; collided do not come back at the same instant and collide again.
  (func recover ((const char * worker) (int attempt)) (out int)
        (let ((useconds_t back . 0))
          (if (== db nil) (return 0))
          (set back (cast useconds_t (* 2000 (+ 1 (% (cast int (getpid)) 5)))))
          (set back (cast useconds_t (* (cast int back) (+ 1 attempt))))
          (usleep back)
          (if (not (zg_reopen db ($ opts host) ($ opts port) ($ opts timeout)))
              (block (fprintf stderr "%s: cannot redial %s:%s -- %s\n"
                              worker ($ opts host) ($ opts port) (zg_error db))
                     (return 0)))
          (return 1)))

  ;;; Whether a machine is still in the database at all: 1 yes, 0 gone,
  ;;; -1 the call did not happen.
  ;;;
  ;;; This is what tells a worker whose claim came back empty whether to wait or
  ;;; to stop. `cocolog::machine_claim_named' answers the same empty string for
  ;;; "somebody else has it" and for "there is no such machine", and those are
  ;;; opposite instructions.
  ;;; Looks at a machine without touching it. Answers -1 for a lost connection,
  ;;; 0 if there is no such row, 1 if there is one somebody else is holding, and
  ;;; 2 if there is one nobody holds.
  ;;;
  ;;; TELLING 1 FROM 2 IS WHAT MAKES A CROWD CHEAP. A worker whose machine is
  ;;; busy used to find that out by ATTEMPTING THE CLAIM -- a write transaction,
  ;;; at SERIALIZABLE, committed, several times a second, per waiting worker.
  ;;; Twelve workers over four machines meant eight of them were always doing
  ;;; that, and the eight idle ones cost more than the four doing the work: the
  ;;; same run took 8s with one worker per machine and 52s with three. This is a
  ;;; read at the default level and it answers the same question.
  ;;;
  ;;; It is only ever a HINT. Between this answering 2 and the claim landing, a
  ;;; partner may have taken the machine -- so the claim stays exactly as
  ;;; atomic as it was, and a claim that comes back empty is still the truth.
  (func exists ((const char * worker) (const char * name)) (out int)
        (let ((zg_result_t r) (char cols [256]) (int rows . 0) (int free . 0))
          (if (not (zg_call db "cocolog::machine_find")) (return -1))
          (if (not (zg_write_string db name)) (return -1))
          (while 1
            (if (not (zg_result db (aof r)))
                (block (fprintf stderr "%s: machine_find: %s\n" worker (zg_error db))
                       (return -1)))
            (if (== r ZG_SUCCESSFUL_DONE) break)
            (cond
              ((== r ZG_CURSOR_OPEN) (zg_columns db cols 256))
              ((== r ZG_CURSOR_FETCH)
               (let ((i64 id . 0) (char kb [128]) (char status [128]) (i32 chunks . 0))
                 (if (not (zg_read_long db (aof id) nil)) (return -1))
                 (if (not (zg_read_string db kb (sizeof kb) nil)) (return -1))
                 (if (not (zg_read_string db status (sizeof status) nil)) (return -1))
                 (if (not (zg_read_int db (aof chunks) nil)) (return -1))
                 ;; `suspended' is what machine_claim_named looks for; anything
                 ;; else in this column is the name of the worker holding it
                 (if (== 0 (strcmp status "suspended")) (set free 1))
                 (set rows (+ rows 1))))
              ((== r ZG_RETURN_VALUE) (zg_skip_field db))
              (#t (block))))
          (if (not (zg_commit db)) (return -1))
          (if (== rows 0) (return 0))
          (return (? free 2 1))))

  ;;; Claims one suspended machine for this worker, atomically.
  ;;;
  ;;;   1  it is ours, and NAME says which
  ;;;   0  nothing is free -- either the queue is empty or another worker has it
  ;;;  -1  the call did not happen: the connection is gone
  ;;;
  ;;; THOSE THREE USED TO BE TWO, and the missing one cost a day. A claim that
  ;;; answered 0 for both "nobody is waiting" and "the server hung up" made a
  ;;; worker whose connection had just died print `nothing left to do' and exit
  ;;; successfully, while the machine it had been given sat in the database
  ;;; still marked as its own. The run looked finished and had done nothing.
  ;;;
  ;;; THE CLAIM IS WHY SEVERAL WORKERS ARE A SCHEDULER AND NOT A RACE. Two that
  ;;; loaded the same machine would both advance it and both save it, and the
  ;;; second save would quietly throw the first one's work away. The procedure
  ;;; does the find and the status change in one transaction, so exactly one
  ;;; worker comes away with a given name.
  ;;; WANTED names one machine, or is null for "whatever is free". Naming one
  ;;; is what lets two workers share a single machine while two others share a
  ;;; different one -- four interpreters, two states, and no group touching the
  ;;; other's.
  (func claim ((const char * worker) (const char * wanted)
               (char * name) (size_t cap)) (out int)
        (let ((zg_result_t r) (char cols [256]) (int got . 0))
          (set (nth 0 name) (cast char 0))
          (if (== wanted nil)
              (block (if (not (zg_call db "cocolog::machine_claim")) (return -1))
                     (if (not (zg_write_string db ($ opts kb))) (return -1)))
            (block (if (not (zg_call db "cocolog::machine_claim_named")) (return -1))
                   (if (not (zg_write_string db wanted)) (return -1))))
          (if (not (zg_write_string db worker)) (return -1))
          (while 1
            (if (not (zg_result db (aof r))) (return -1))
            (if (== r ZG_SUCCESSFUL_DONE) break)
            (cond
              ((== r ZG_CURSOR_OPEN) (zg_columns db cols 256))
              ((== r ZG_RETURN_VALUE)
               (if (zg_read_string db name cap nil) (set got 1)))
              ((== r ZG_CURSOR_FETCH) break)
              (#t (block))))
          ;; NOT COMMITTED: the claim rides the turn's one transaction. The
          ;; turn-final commit in cmd_step is what makes it stand, and a
          ;; worker that dies or fails mid-turn takes its claim down with the
          ;; rollback -- the machine goes straight back to the pool instead
          ;; of sitting stranded as that worker's own. The claim procedure
          ;; hands SERIALIZABLE back to READ COMMITTED before returning, so
          ;; the slot of one is held for the claim's few statements, not the
          ;; whole turn.
          (return (? (and got (!= (nth 0 name) (cast char 0))) 1 0))))

  ;;; Claim, advance, put back. A worker loop, and several of these against one
  ;;; server is the whole point of the project: the database is the run queue
  ;;; and a machine's state is the work item.
  ;;;
  ;;; WHAT MAKES IT SURVIVE THE OTHER THREE. Every database call here can fail
  ;;; for a reason that has nothing to do with this worker -- another worker
  ;;; happened to be inside the storage engine at the same moment -- and the
  ;;; failure takes the connection with it. So the loop treats a lost
  ;;; connection as a thing to recover from rather than a thing to stop for:
  ;;;
  ;;;   * a claim that could not be made      -> redial and claim again
  ;;;   * a turn that could not be committed  -> redial, hand the machine back,
  ;;;                                            and let anyone take it next
  ;;;
  ;;; and only a bounded number of times, so a worker facing a server that has
  ;;; genuinely gone away says so and exits instead of spinning.
  ;;;
  ;;; HANDING IT BACK RATHER THAN RETRYING IT is deliberate. A worker that
  ;;; insisted on redoing its own lost turn would be the one thing that can
  ;;; starve the other member of the group; giving the machine up means the
  ;;; partner may take that turn, which is the arrangement the whole thing is
  ;;; for and is why the group's answers still come out in order.
  (func cmd_work ((const char * worker) (const char * wanted)) (out int)
        (let ((char name [256]) (int turns . 0) (int idle . 0) (int gone . 0)
              (int hurt . 0) (int rc . 0) (int got . 0) (int seen . 0)
              (int look . 0))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: work needs a database\n") (return 1)))
          (while 1
            ;; A CHEAP READ BEFORE THE EXPENSIVE WRITE, when the machine is
            ;; named. `exists' answers whether anyone is holding it, at the
            ;; default isolation level and without writing anything; the claim
            ;; is only attempted when the answer is that nobody is. See the
            ;; head of `exists' for what that is worth -- it is the difference
            ;; between eight idle workers costing nothing and costing more than
            ;; the four doing the work.
            ;;
            ;; The answer is kept, because the code below needs the same fact
            ;; and asking twice would give back half of what this saves.
            (set look (? (== wanted nil) 2 (exists worker wanted)))
            (if (== look -1)
                (block
                 (set hurt (+ hurt 1))
                 (if (> hurt 40)
                     (block (fprintf stderr "%s: giving up after %d lost connection(s)\n"
                                     worker hurt)
                            break))
                 (if (not (recover worker hurt)) break)
                 continue))
            (set got (? (== look 2) (claim worker wanted name (sizeof name)) 0))

            (if (== got -1)
                (block
                 ;; The connection, not the queue. Redial and go round again;
                 ;; nothing was committed, so there is nothing to undo.
                 (set hurt (+ hurt 1))
                 (if (> hurt 40)
                     (block (fprintf stderr "%s: giving up after %d lost connection(s)\n"
                                     worker hurt)
                            break))
                 (if (not (recover worker hurt)) break)
                 continue))

            (if (== got 0)
                (block
                 ;; AN EMPTY CLAIM MEANS TWO DIFFERENT THINGS, and stopping on
                 ;; the wrong one is what made every machine get finished by
                 ;; whichever worker happened to reach it first. The machine is
                 ;; either GONE -- proved out and dropped, so there is nothing
                 ;; left to do -- or BUSY in a partner, which is the normal
                 ;; state of affairs for most of a run and no reason at all to
                 ;; stop. Counting empty claims and giving up after enough of
                 ;; them treats the second as the first: a worker that started a
                 ;; few hundred milliseconds late, or whose partners were mid
                 ;; turn, quietly exited having done nothing, and the test that
                 ;; asks whether every member of a group took a turn was right
                 ;; to fail.
                 ;;
                 ;; So ask -- which the top of the loop has already done, and
                 ;; `look' is the answer.
                 ;; AND ONE READING OF `GONE' IS NOT PROOF EITHER. Saving a
                 ;; machine rewrites its row -- cocolog::machine_open deletes
                 ;; the old one and inserts a replacement -- and for as long as
                 ;; that transaction is open, a reader at READ COMMITTED sees
                 ;; NEITHER version: the delete is not committed and the insert
                 ;; is not either. The row is briefly nowhere, which is MVCC
                 ;; being right rather than being broken, and a partner that
                 ;; happened to look during that window concluded the machine
                 ;; had finished and went home. It is why `exists' answers a
                 ;; question that has to be asked more than once.
                 ;;
                 ;; A worker gives up only after the machine has been out of
                 ;; sight CONTINUOUSLY for COCO_GONE_CONFIRM polls. A partner
                 ;; between turns has committed and is yielding, so the row is
                 ;; plainly there for COCO_YIELD_US at a time; a run of absences
                 ;; that long means it really has been dropped.
                 (if (== wanted nil) break)
                 (if (== look 0)
                     (block (set gone (+ gone 1))
                            (if (> gone (? seen COCO_GONE_CONFIRM COCO_APPEAR_LIMIT)) break)
                            (usleep COCO_POLL_US)
                            continue))
                 (set gone 0)
                 (set seen 1)
                 ;; There, and somebody else has it. Wait, and keep a wall clock
                 ;; on it so that a machine stranded by a worker that died does
                 ;; not hold the rest here for ever.
                 (set idle (+ idle 1))
                 (if (> idle COCO_IDLE_LIMIT)
                     (block (fprintf stderr "%s: '%s' stayed claimed by somebody else\n"
                                     worker wanted)
                            break))
                 (usleep COCO_POLL_US)
                 continue))

            (set idle 0)
            (set gone 0)
            (set seen 1)
            (fprintf (wout) "%s: took '%s'\n" worker name)
            (set rc (cmd_step name 0))

            (if (turn-is LOST rc)
                (block
                 (set hurt (+ hurt 1))
                 (fprintf stderr "%s: lost the connection during '%s'; turn rolled back\n"
                          worker name)
                 (if (> hurt 40)
                     (block (fprintf stderr "%s: giving up after %d lost connection(s)\n"
                                     worker hurt)
                            break))
                 (if (not (recover worker hurt)) break)
                 ;; Nothing to put back: the claim rode the turn's one
                 ;; transaction, and the server rolled the whole thing --
                 ;; claim included -- back when the connection went. The
                 ;; machine is already in the pool for whoever gets there
                 ;; first, which may well be this worker on its new
                 ;; connection.
                 continue))

            ;; A turn that happened. FAILED means the program is wrong, and it
            ;; will be wrong again, so the machine is left where cmd_step left
            ;; it and this worker stops.
            (set turns (+ turns 1))
            (if (turn-is FAILED rc) break)
            ;; Stand back and let somebody else have the next one.
            (if (turn-is MORE rc) (usleep COCO_YIELD_US)))
          ;; WHAT IT DID AND WHY IT STOPPED, in one line. A worker that ends
          ;; having taken no turns is either a scheduler working correctly --
          ;; its partners got there first -- or a bug, and the two are
          ;; indistinguishable from `nothing left to do'. The counts say which:
          ;; a worker that never saw the machine at all made no claims worth
          ;; speaking of, one that was always too late made hundreds.
          (fprintf (wout) "%s: nothing left to do after %d turn(s) (%d claim attempt(s), %d absent, %d busy)\n"
                  worker turns (+ (+ gone idle) turns) gone idle)
          (return 0)))

  ;;; ---- the swarm: cmd_work, one worker per thread ------------------------
  ;;;
  ;;; Twelve processes taking turns through a server is one benchmark; the
  ;;; same twelve workers as THREADS of one process is the embedded store's
  ;;; natural shape, because an embedded engine belongs to a single process.
  ;;; Each thread opens its own connection -- embedded when --embed is given,
  ;;; a socket of its own otherwise -- sets the thread-local `db', and runs
  ;;; the very same cmd_work the processes run. Nothing in the work loop
  ;;; knows which arrangement it is in.

  (struct swarm_job
    (member char worker [64])
    (member char machine [128])
    (member char logpath [512])
    (member int rc))

  (func swarm_thread ((void * arg)) (out void *)
        (let ((swarm_job * j . #'(cast (swarm_job *) arg))
              (char err [512]))
          (if (!= ($ opts store) nil)
              (set db (zg_open_embed ($ opts store) err (sizeof err)))
            (set db (zg_open ($ opts host) ($ opts port) ($ opts timeout) err (sizeof err))))
          (if (== db nil)
              (block (fprintf stderr "%s: cannot open -- %s\n" (-> j worker) err)
                     (set (-> j rc) 1)
                     (return nil)))
          (if (!= (nth 0 (-> j logpath)) (cast char 0))
              (block
                (set wlog (fopen (-> j logpath) "w"))
                ;; line buffered, so a frozen or killed swarm still shows in
                ;; its logs how far every worker actually got
                (if (!= wlog nil) (setvbuf wlog nil _IOLBF 0))))
          (set (-> j rc) (cmd_work (-> j worker) (-> j machine)))
          (if (!= wlog nil) (block (fclose wlog) (set wlog nil)))
          (zg_close db)
          (set db nil)
          (return nil)))

  (func cmd_swarm ((int argc) (char ** argv) (int from)) (out int)
        (let ((int pairs . #'(/ (- argc from) 2)) (int bad . 0))
          (if (<= pairs 0)
              (block (fprintf stderr "cocolog: swarm needs WORKER MACHINE pairs\n")
                     (return 1)))
          (if (> pairs 32)
              (block (fprintf stderr "cocolog: a swarm is at most 32 workers\n")
                     (return 1)))
          (let ((swarm_job jobs [32]) (pthread_t tids [32]))
            (for ((int k . 0)) (< k pairs) ((++ k))
              (snprintf ($ (nth k jobs) worker) 64 "%s" (nth (+ from (* k 2)) argv))
              (snprintf ($ (nth k jobs) machine) 128 "%s" (nth (+ from (+ (* k 2) 1)) argv))
              (if (!= ($ opts outdir) nil)
                  (snprintf ($ (nth k jobs) logpath) 512 "%s/%s.log"
                            ($ opts outdir) ($ (nth k jobs) worker))
                (set (nth 0 ($ (nth k jobs) logpath)) (cast char 0)))
              (set ($ (nth k jobs) rc) 0)
              (pthread_create (aof (nth k tids)) nil swarm_thread
                              (cast (void *) (aof (nth k jobs)))))
            (for ((int k . 0)) (< k pairs) ((++ k))
              (pthread_join (nth k tids) nil)
              (if (!= ($ (nth k jobs) rc) 0) (set bad 1)))
            (return bad))))

  (func cmd_list () (out int)
        (let ((zg_result_t r) (char cols [256]) (int rows . 0))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: list needs a database\n") (return 1)))
          (if (not (zg_call db "cocolog::machine_list")) (return 1))
          (if (not (zg_write_string db ($ opts kb))) (return 1))
          (while 1
            (if (not (zg_result db (aof r))) break)
            (if (== r ZG_SUCCESSFUL_DONE) break)
            (cond
              ((== r ZG_CURSOR_OPEN) (zg_columns db cols 256))
              ((== r ZG_CURSOR_FETCH)
               (let ((char nm [256]) (char status [64]) (i32 chunks . 0))
                 (if (not (zg_read_string db nm (sizeof nm) nil)) break)
                 (if (not (zg_read_string db status (sizeof status) nil)) break)
                 (if (not (zg_read_int db (aof chunks) nil)) break)
                 (printf "  %-28s %-12s %d chunk(s)\n" nm status chunks)
                 (set rows (+ rows 1))))
              ((== r ZG_RETURN_VALUE) (zg_skip_field db))
              (#t (block))))
          (if (== rows 0) (printf "  no suspended machines in '%s'\n" ($ opts kb)))
          (return 0)))

  ;;; Forgets clauses. With no predicate, the whole knowledge base.
  ;;;
  ;;; WHY A PROGRAM THAT ONLY EVER ADDS CLAUSES NEEDS THIS. `consult' asserts;
  ;;; it does not replace. Run it twice on the same file and the knowledge base
  ;;; holds two copies of every clause, and a proof then answers everything
  ;;; twice and a recursive one may not terminate at all. That is correct
  ;;; behaviour for assertz and a trap for anything that loads a program more
  ;;; than once -- a test that runs repeatedly, most of all, where it looks
  ;;; like the interpreter has started producing duplicate answers.
  ;;; The verb: reclaims what the store is still holding on to, without
  ;;; `--vacuum' -- the operator typing it IS the opt-in. What it does and
  ;;; what it spends is written at the procedure (parsi/02-procedures.parsi)
  ;;; and in README's "A worked store slows down. Truncate it."; the short
  ;;; form is that it frees only rows committed as deleted that no running
  ;;; transaction can still be entitled to -- a vacuum, not an emptying,
  ;;; safe against a knowledge base in use -- and that the price is the
  ;;; store's point-in-time reads. It is store-wide and not per kb, because
  ;;; a dead row has no kb to belong to any more.
  (func cmd_vacuum () (out int)
        (let ((zg_result_t r) (char cols [256]) (i64 live . 0))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: vacuum needs a database\n") (return 1)))
          (if (!= ($ opts http) nil)
              (block (fprintf stderr "cocolog: vacuum cannot go over Zeytun; use the binary protocol or --embed\n")
                     (return 1)))
          (if (not (zg_call db "cocolog::vacuum"))
              (block (fprintf stderr "cocolog: vacuum: %s\n" (zg_error db)) (return 1)))
          (while 1
            (if (not (zg_result db (aof r)))
                (block (fprintf stderr "cocolog: vacuum: %s\n" (zg_error db)) (return 1)))
            (if (== r ZG_SUCCESSFUL_DONE) break)
            (cond
              ((== r ZG_CURSOR_OPEN) (zg_columns db cols 256))
              ((== r ZG_RETURN_VALUE) (zg_read_long db (aof live) nil))
              ((== r ZG_CURSOR_FETCH) break)
              (#t (block))))
          (if (not (zg_commit db))
              (block (fprintf stderr "cocolog: vacuum: %s\n" (zg_error db)) (return 1)))
          (printf "vacuumed; %lld live row(s) remain\n" (cast llong live))
          (return 0)))

  ;;; ---- forget, without the one giant DELETE ---------------------------
  ;;;
  ;;; `forget' with no name used to be a single forget_all: one transaction
  ;;; deleting every row of the base. CivV's rung-6 test measured that
  ;;; DELETE at ~10ms a row -- ~30s for a 3200-clause base on a FRESH
  ;;; store, longer on an aged one (the engine re-walks the index value
  ;;; chain from the head for every row it unlinks, so one statement's
  ;;; deletes are quadratic in the chain) -- which put it past every client
  ;;; timeout in the house. And a client that gives up mid-call is how a
  ;;; base WEDGES: the server never rolls back a disconnected connection's
  ;;; transaction (handle_client in ZiguratIP's loadzigurat.cpp leaves its
  ;;; loop with no rollback on every error path), the pooled thread keeps
  ;;; the id registered as live, so the stale-lock breaker rightly refuses
  ;;; to break it and every later touch of those rows burns its whole
  ;;; `lock wait timeout' on a transaction nothing will finish -- until
  ;;; that thread happens to serve another connection, or the server
  ;;; restarts and startup recovery rolls the debris back (measured: a
  ;;; restart DOES clear it; what looked like surviving one was every
  ;;; diagnostic forget re-abandoning and re-wedging the base).
  ;;;
  ;;; So the whole-base forget is now PREDICATE AT A TIME: collect the
  ;;; distinct predicates from the clause rows and from the declarations
  ;;; (a predicate can be in either without the other), forget each in a
  ;;; transaction of its own -- bounded by the largest predicate, never
  ;;; the base -- and finish with the old forget_all as a sweep for the
  ;;; tensors and anything that arrived since the collection. The price,
  ;;; named honestly: a whole-base forget is no longer atomic, and a
  ;;; reader mid-forget can see a base with some predicates gone. A base
  ;;; being emptied was never a base to read.

  (var const int COCO_FORGET_CAP    . 2048)   ;; distinct predicates collected
  (var const int COCO_FORGET_STRIDE . 128)    ;; bytes per name, flat storage
  (var char forget_names [262144])            ;; CAP rows of STRIDE bytes
  (var int  forget_arities [2048])

  ;;; Prints the failure, and when the server named a lock wait, the
  ;;; finding above in one line -- the reader at the terminal is mid-wedge.
  (func forget_report ((const char * what)) (out void)
        (fprintf stderr "cocolog: forget: %s\n" what)
        (if (!= (strstr what "lock wait timeout") nil)
            (fprintf stderr "cocolog: a writer -- possibly a disconnected one -- still holds row locks; a server restart sweeps them\n")))

  ;;; One procedure's rows into the flat name/arity tables, deduplicated;
  ;;; answers the new count, -1 on a wire error. Rows past CAP are left to
  ;;; the final sweep. Both procedures answer (name, arity, one-more) --
  ;;; ordinal for predicates_of, dynamic for props_of -- and the third is
  ;;; skipped without knowing which.
  (func forget_collect ((const char * proc) (int count)) (out int)
        (let ((zg_result_t r) (char cols [256]))
          (if (not (zg_call db proc)) (return -1))
          (if (not (zg_write_string db ($ opts kb))) (return -1))
          (while 1
            (if (not (zg_result db (aof r))) (return -1))
            (if (== r ZG_SUCCESSFUL_DONE) break)
            (cond
              ((== r ZG_CURSOR_OPEN) (zg_columns db cols 256))
              ((== r ZG_CURSOR_FETCH)
               (let ((char nm [128]) (i32 ar . 0) (int seen . 0))
                 (if (not (zg_read_string db nm (sizeof nm) nil)) (return -1))
                 (if (not (zg_read_int db (aof ar) nil)) (return -1))
                 (zg_skip_field db)
                 (for ((int i . 0)) (< i count) ((++ i))
                      (if (and (== (nth i forget_arities) (cast int ar))
                               (== 0 (strcmp (+ forget_names (* i COCO_FORGET_STRIDE)) nm)))
                          (set seen 1)))
                 (if (and (== seen 0) (< count COCO_FORGET_CAP))
                     (block
                       (strcpy (+ forget_names (* count COCO_FORGET_STRIDE)) nm)
                       (set (nth count forget_arities) (cast int ar))
                       (set count (+ count 1))))))
              ((== r ZG_RETURN_VALUE) (zg_skip_field db))
              (#t (block))))
          (if (not (zg_commit db)) (return -1))
          (return count)))

  ;;; One call to a forget procedure, one transaction; PNAME nil is the
  ;;; whole-base sweep. Adds how many clauses went to *GONE.
  (func forget_call ((const char * pname) (int parity) (i64 * gone)) (out int)
        (let ((zg_result_t r) (char cols [256]) (i64 g . 0))
          (if (== pname nil)
              (block (if (not (zg_call db "cocolog::forget_all")) (return 0))
                     (if (not (zg_write_string db ($ opts kb))) (return 0)))
            (block (if (not (zg_call db "cocolog::forget")) (return 0))
                   (if (not (zg_write_string db ($ opts kb))) (return 0))
                   (if (not (zg_write_string db pname)) (return 0))
                   (if (not (zg_write_int db parity)) (return 0))))
          (while 1
            (if (not (zg_result db (aof r))) (return 0))
            (if (== r ZG_SUCCESSFUL_DONE) break)
            (cond
              ((== r ZG_CURSOR_OPEN) (zg_columns db cols 256))
              ((== r ZG_RETURN_VALUE) (zg_read_long db (aof g) nil))
              ((== r ZG_CURSOR_FETCH) break)
              (#t (block))))
          (if (not (zg_commit db)) (return 0))
          (set (cof gone) (+ (cof gone) g))
          (return 1)))

  (func cmd_forget ((const char * name) (int arity)) (out int)
        (let ((i64 gone . 0) (int count . 0))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: forget needs a database\n") (return 1)))
          (if (!= name nil)
              (block
                (if (not (forget_call name arity (aof gone)))
                    (block (forget_report (zg_error db)) (return 1)))
                (printf "forgot %lld clause(s) of %s/%d\n" (cast llong gone) name arity)
                (return 0)))
          (set count (forget_collect "cocolog::predicates_of" 0))
          (if (< count 0) (block (forget_report (zg_error db)) (return 1)))
          (set count (forget_collect "cocolog::props_of" count))
          (if (< count 0) (block (forget_report (zg_error db)) (return 1)))
          (for ((int i . 0)) (< i count) ((++ i))
               (if (not (forget_call (+ forget_names (* i COCO_FORGET_STRIDE))
                                     (nth i forget_arities) (aof gone)))
                   (block
                     (forget_report (zg_error db))
                     (fprintf stderr "cocolog: %d of %d predicates forgotten; the base is part-forgotten -- run forget again\n" i count)
                     (return 1))))
          (if (not (forget_call nil 0 (aof gone)))
              (block (forget_report (zg_error db)) (return 1)))
          (printf "forgot %lld clause(s) in '%s'\n" (cast llong gone) ($ opts kb))
          (return 0)))

  (func cmd_drop ((const char * name)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_zg z))
          (if ($ opts local)
              (block (fprintf stderr "cocolog: drop needs a database\n") (return 1)))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_zg_attach (aof z) db (aof m) (aof st) ($ opts kb))
          (gate_vacuum (aof st))
          (coco_zg_drop (aof z) name)
          (zg_commit db)
          (printf "dropped '%s'\n" name)
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return 0)))

  ;;; ---- the command line ---------------------------------------------------

  ;; NO WEAK SYMBOLS ANY MORE. torch and bigint used to be linked into this
  ;; binary and reached through `__attribute__((weak))', so a build without
  ;; them left the symbol null and their predicates undefined. That worked,
  ;; and it meant every link needed libtorch and libCore for two modules
  ;; most programs never call. They are loadable modules now --
  ;; modules/torch and modules/bigint -- and `use_module' finds them.

  ;;; Every module this build carries. Registration is here and not inside the
  ;;; modules because a build decides what it contains -- a module cannot add
  ;;; itself, and the order is the order of precedence when two claim a name.
  (func install_modules () (out int)
        (coco_module_init)
        (if (not (coco_library_module))
            (block (fprintf stderr "cocolog: the library module would not register\n")
                   (return 0)))
        (if (not (coco_files_module))
            (block (fprintf stderr "cocolog: the files module would not register\n")
                   (return 0)))
        ;; The vendored SWI libraries, from lib/swipl beside the binary.
        ;; Their absence is not an error -- see coco_library_preload.
        (coco_library_preload)
        (if (not (coco_lists_module))
            (block (fprintf stderr "cocolog: the lists module would not register\n")
                   (return 0)))
        (if (not (coco_apply_module))
            (block (fprintf stderr "cocolog: the apply module would not register\n")
                   (return 0)))
        (if (not (coco_builtins_module))
            (block (fprintf stderr "cocolog: the builtins module would not register\n")
                   (return 0)))
        (if (not (coco_dcg_module))
            (block (fprintf stderr "cocolog: the dcg module would not register\n")
                   (return 0)))
        (if (not (coco_zigurat_module))
            (block (fprintf stderr "cocolog: the zigurat module would not register\n")
                   (return 0)))
        (return 1))

  ;;; Consults FILES and proves GOAL once, in one process, with no database.
  ;;;
  ;;; WHAT IT IS FOR is running the same Prolog file under cocolog and under
  ;;; another Prolog and comparing what they print -- which is how the Files
  ;;; module is tested, because a library that claims to be SWI's has to be
  ;;; checked against SWI rather than against its own author. It is deliberately
  ;;; the shape of `swipl -q -g GOAL -t halt FILE': nothing is printed but what
  ;;; the program itself writes, success is 0 and failure is 1.
  (func cmd_run ((int argc) (char ** argv) (int from) (const char * goal)) (out int)
        (let ((coco_machine m) (coco_store st) (coco_engine e) (coco_zg z) (coco_zt zt)
              (char err [256]) (int rc . 0))
          (coco_machine_init (aof m))
          (coco_store_init (aof st))
          (coco_engine_init (aof e) (aof m) (aof st))
          (set ($ e max_steps) 0)
          (attach (aof z) (aof zt) (aof m) (aof st))

          ;; batched, as `consult' is: one sync per consulted predicate
          (if (and (!= db nil) (== ($ opts http) nil)) (coco_zg_batch (aof z) 1))
          (for ((int i . from)) (< i argc) ((++ i))
            (let ((char * text . #'(slurp (nth i argv))))
              (if (== text nil)
                  (block (coco_engine_free (aof e)) (coco_store_free (aof st))
                         (coco_machine_free (aof m)) (return 1)))
              (if (< (coco_consult (aof st) (aof m) text err (sizeof err)) 0)
                  (block (fprintf stderr "cocolog: %s: %s\n" (nth i argv) err)
                         (free text) (coco_engine_free (aof e)) (coco_store_free (aof st))
                         (coco_machine_free (aof m)) (return 1)))
              (free text)))
          (if (and (!= db nil) (== ($ opts http) nil))
              (if (not (coco_zg_batch (aof z) 0))
                  (block (fprintf stderr "cocolog: writing the consulted clauses: %s\n"
                                  (zg_error db))
                         (zg_rollback db)
                         (coco_engine_free (aof e)) (coco_store_free (aof st))
                         (coco_machine_free (aof m)) (return 1))))

          (if (not (coco_engine_ask_text (aof e) goal))
              (block (fprintf stderr "cocolog: %s\n" ($ e err))
                     (coco_engine_free (aof e)) (coco_store_free (aof st))
                     (coco_machine_free (aof m)) (return 1)))
          (set rc (coco_engine_next (aof e)))
          (if (== rc -1) (fprintf stderr "cocolog: %s\n" ($ e err)))
          (if (!= db nil)
              (if (== rc 1)
                  (if (not (zg_commit db))
                      (block (fprintf stderr "cocolog: commit failed: %s\n" (zg_error db))
                             (set rc -1)))
                (zg_rollback db)))
          (coco_engine_free (aof e))
          (coco_store_free (aof st))
          (coco_machine_free (aof m))
          (return (? (== rc 1) 0 1))))

  (func main ((int argc) (char ** argv))
        (out int)
        (let ((int i . 1) (int rc . 0))
          ;; options first, then the command
          (while (< i argc)
            (let ((const char * a . #'(nth i argv)))
              (if (!= (nth 0 a) (cast char 45)) break)
              (cond
                ((== 0 (strcmp a "--local")) (set ($ opts local) 1) (set i (+ i 1)))
                ;; the directory is OPTIONAL here: a bare --embed opens ./KB.
                ;; The next word is taken as the directory unless it reads as
                ;; an option or a command -- a store actually named `run' is
                ;; written ./run, which reads as neither.
                ((== 0 (strcmp a "--embed"))
                 (if (and (< (+ i 1) argc)
                          (!= (nth 0 (nth (+ i 1) argv)) (cast char 45))
                          (not (is_verb (nth (+ i 1) argv))))
                     (block (set ($ opts store) (nth (+ i 1) argv))
                            (set i (+ i 2)))
                   (block (set ($ opts store) "./KB")
                          (set i (+ i 1)))))
                ;; THE PORT IS OPTIONAL ON BOTH, the way `--embed's
                ;; directory is: the next word is taken as the service
                ;; unless it reads as an option or a command. 80 and 443
                ;; are the defaults because they are what an edge listens
                ;; on, and a querier behind Cloudflare should not have to
                ;; know that.
                ((or (== 0 (strcmp a "--http")) (== 0 (strcmp a "--https")))
                 (if (== 0 (strcmp a "--https")) (set ($ opts secure) 1))
                 (if (and (< (+ i 1) argc)
                          (!= (nth 0 (nth (+ i 1) argv)) (cast char 45))
                          (not (is_verb (nth (+ i 1) argv))))
                     (block (set ($ opts http) (nth (+ i 1) argv))
                            (set i (+ i 2)))
                   (block (set ($ opts http) (? ($ opts secure) "443" "80"))
                          (set i (+ i 1)))))
                ;; THE BINARY PROTOCOL, SPELLED OUT. `--tcp' is what
                ;; naming `--kb' or `--host' already chose, said
                ;; explicitly; `--tls' is the same port with ZiguratIP's
                ;; `SERVER/TLS_MODE: TRUE' on the other end. The port is
                ;; 2160 for both, because TLS_MODE changes WHAT IS ON the
                ;; port and not where it is -- which is the opposite of
                ;; --http and --https, where 80 and 443 are two ports, and
                ;; the difference is worth knowing.
                ((or (== 0 (strcmp a "--tcp")) (== 0 (strcmp a "--tls")))
                 (if (== 0 (strcmp a "--tls")) (set ($ opts bsecure) 1))
                 (if (and (< (+ i 1) argc)
                          (!= (nth 0 (nth (+ i 1) argv)) (cast char 45))
                          (not (is_verb (nth (+ i 1) argv))))
                     (block (set ($ opts port) (nth (+ i 1) argv))
                            (set i (+ i 2)))
                   (block (if (== ($ opts port) nil) (set ($ opts port) "2160"))
                          (set i (+ i 1)))))
                ((== 0 (strcmp a "--insecure")) (set ($ opts insecure) 1) (set i (+ i 1)))
                ((== 0 (strcmp a "--vacuum")) (set ($ opts vacuum) 1) (set i (+ i 1)))
                ((== 0 (strcmp a "--trace")) (set coco_trace_default 1) (set i (+ i 1)))
                ((== 0 (strcmp a "--help")) (usage) (return 0))
                (#t
                 (if (>= (+ i 1) argc)
                     (block (fprintf stderr "cocolog: %s needs a value\n" a) (return 1)))
                 (let ((const char * v . #'(nth (+ i 1) argv)))
                   (cond
                     ((== 0 (strcmp a "--kb"))      (set ($ opts kb) v))
                     ((== 0 (strcmp a "--host"))    (set ($ opts host) v))
                     ;; DEPRECATED, and deliberately silent. It is exactly
                     ;; `--tcp PORT' -- the same field, the same default, the
                     ;; same choice of arrangement -- so a script that has it
                     ;; keeps working and reads no differently to the parser.
                     ;; NO WARNING, because there is nothing here to fix: the
                     ;; flag is not wrong, only older than the three that
                     ;; joined it, and a line on stderr every run would land
                     ;; in the output of every script that ever piped us.
                     ((== 0 (strcmp a "--port"))    (set ($ opts port) v))
                     ((== 0 (strcmp a "--cacert"))   (set ($ opts cacert) v))
                     ((== 0 (strcmp a "--capath"))   (set ($ opts capath) v))
                     ((== 0 (strcmp a "--cert"))     (set ($ opts cert) v))
                     ((== 0 (strcmp a "--key"))      (set ($ opts key) v))
                     ((== 0 (strcmp a "--key-pass")) (set ($ opts keypass) v))
                     ((== 0 (strcmp a "--steps"))   (set ($ opts steps) (strtoull v nil 10)))
                     ((== 0 (strcmp a "--timeout")) (set ($ opts timeout) (atoi v)))
                     ((== 0 (strcmp a "--lock"))    (set ($ opts lock) v))
                     ((== 0 (strcmp a "--out"))     (set ($ opts outdir) v))
                     ((== 0 (strcmp a "--answers")) (set ($ opts answers) (atoi v)))
                     (#t (block (fprintf stderr "cocolog: unknown option %s\n" a)
                                (return 1)))))
                 (set i (+ i 2))))))

          ;; THE DEFAULT ARRANGEMENT IS LOCAL. Naming any part of another one
          ;; chooses it: --embed the embedded store, --http Zeytun,
          ;; and --kb, --host or --tcp the server -- local keeps no named
          ;; knowledge bases, so asking for one is asking for the database.
          ;; The names then take their old defaults whichever way it went.
          (if (and (== ($ opts local) 0) (== ($ opts store) nil)
                   (== ($ opts http) nil) (== ($ opts kb) nil)
                   (== ($ opts host) nil) (== ($ opts port) nil)
                   (== ($ opts bsecure) 0))
              (set ($ opts local) 1))
          (if (== ($ opts kb) nil)   (set ($ opts kb) "main"))
          (if (== ($ opts host) nil) (set ($ opts host) "127.0.0.1"))
          (if (== ($ opts port) nil) (set ($ opts port) "2160"))

          ;; ---- the client's transport, settled ONCE ------------------------
          ;;
          ;; HERE AND NOT AT THE FETCH, because a cocolog reaches one Zeytun
          ;; in an arrangement chosen from argv before the first goal runs.
          ;; Threading it through `coco_zt' and the four `zt_get' call sites
          ;; in lib/zeytun-kb.cicili would be four chances for one of them to
          ;; stay plaintext; see the note in client/zeytun.h.
          ;;
          ;; THE STRINGS ARE argv, which outlives everything -- the client
          ;; copies the struct and not what it points at, and says so.
          ;; BOTH AT ONCE IS A MISTAKE, not a preference: `--https' names a
          ;; Zeytun and `--tls' a Zigurat, and a run reaches one knowledge
          ;; base through one of them.
          (if (and (!= ($ opts http) nil) ($ opts bsecure))
              (block
                (fprintf stderr "cocolog: --tls names the binary protocol and --http/--https names Zeytun; choose one\n")
                (return 1)))
          (if (or ($ opts secure) ($ opts bsecure))
              (block
                (if (not (coco_client_tls_available))
                    (block
                      (fprintf stderr "cocolog: --https needs a build with OpenSSL; this one has none\n")
                      (return 1)))
                ;; A CERTIFICATE NEEDS BOTH HALVES, and one alone is a
                ;; configuration mistake rather than something to half-apply.
                ;; Refused here as well as in the client, because here the
                ;; message can name the flags.
                (if (or (and (!= ($ opts cert) nil) (== ($ opts key) nil))
                        (and (== ($ opts cert) nil) (!= ($ opts key) nil)))
                    (block
                      (fprintf stderr "cocolog: --cert and --key go together\n")
                      (return 1)))
                ;; SAID OUT LOUD, every time. `--insecure' turns off the
                ;; hostname check and the chain check both, which is the
                ;; whole of what TLS was doing for a reader -- and a flag
                ;; that goes quiet is a flag somebody leaves in a script.
                (if ($ opts insecure)
                    (fprintf stderr "cocolog: --insecure: the server is NOT being verified\n"))
                ;; ONE OR THE OTHER, and the check above has already made
                ;; sure it is not both.
                (if ($ opts secure)
                    (coco_client_tls_configure_flat ($ opts cacert) ($ opts capath)
                                                    ($ opts cert) ($ opts key)
                                                    ($ opts keypass) ($ opts insecure))
                  (zg_tls_configure_flat ($ opts cacert) ($ opts capath)
                                         ($ opts cert) ($ opts key)
                                         ($ opts keypass) ($ opts insecure)))))

          (if (not (install_modules)) (return 1))
          ;; A THREAD GETS THE ARRANGEMENT THIS PROCESS WAS STARTED WITH.
          ;; Installed after the options are settled and before anything
          ;; can spawn, which is the only window where both are true.
          (coco_m_kb_install thread_kb_open thread_kb_close)
          (if (not (open_connection)) (return 1))

          ;; no command at all is the toplevel, as bare `swipl' is
          (if (>= i argc)
              (set rc (cmd_repl))
          (let ((const char * cmd . #'(nth i argv)))
            (cond
              ((== 0 (strcmp cmd "consult"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: consult needs a file\n") (set rc 1))
                 (set rc (cmd_consult argc argv (+ i 1)))))
              ((== 0 (strcmp cmd "run"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: run needs a file\n") (set rc 1))
                 ;; the goal is the last argument when there is more than one,
                 ;; and `main' when there is not -- which is the swipl default
                 (set rc (? (>= (+ i 2) argc)
                            (cmd_run (+ i 2) argv (+ i 1) "main")
                            (cmd_run (- argc 1) argv (+ i 1) (nth (- argc 1) argv))))))
              ((== 0 (strcmp cmd "query"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: query needs a goal\n") (set rc 1))
                 (set rc (cmd_query (nth (+ i 1) argv)))))
              ((== 0 (strcmp cmd "start"))
               (if (>= (+ i 2) argc)
                   (block (fprintf stderr "cocolog: start needs a name and a goal\n") (set rc 1))
                 (set rc (cmd_start (nth (+ i 1) argv) (nth (+ i 2) argv)))))
              ((== 0 (strcmp cmd "step"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: step needs a name\n") (set rc 1))
                 (set rc (cmd_step (nth (+ i 1) argv) 0))))
              ((== 0 (strcmp cmd "finish"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: finish needs a name\n") (set rc 1))
                 (set rc (cmd_step (nth (+ i 1) argv) 1))))
              ((== 0 (strcmp cmd "work"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: work needs a worker name\n") (set rc 1))
                 (set rc (cmd_work (nth (+ i 1) argv)
                                   (? (>= (+ i 2) argc) nil (nth (+ i 2) argv))))))
              ((== 0 (strcmp cmd "swarm"))
               (set rc (cmd_swarm argc argv (+ i 1))))
              ((== 0 (strcmp cmd "forget"))
               (if (>= (+ i 2) argc)
                   (set rc (cmd_forget nil 0))
                 (set rc (cmd_forget (nth (+ i 1) argv) (atoi (nth (+ i 2) argv))))))
              ((== 0 (strcmp cmd "vacuum")) (set rc (cmd_vacuum)))
              ((== 0 (strcmp cmd "list")) (set rc (cmd_list)))
              ((== 0 (strcmp cmd "drop"))
               (if (>= (+ i 1) argc)
                   (block (fprintf stderr "cocolog: drop needs a name\n") (set rc 1))
                 (set rc (cmd_drop (nth (+ i 1) argv)))))
              (#t (block (fprintf stderr "cocolog: unknown command %s\n" cmd)
                         (usage) (set rc 1))))))

          (if (!= db nil) (zg_close db))
          (return rc)))
  )

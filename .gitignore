# build output
build/
cocolog
*.o
*.lo
*.a
.libs/

# Cicili writes the generated C beside the target it came from
cocolog.c
test/*.c
test/cocolog_*_test
# test/run.sh keeps each case's build log next to it
test/.*.build

# parsi/build.sh scratch
parsi/.build.log

# the embedded engine's build output and its symlinks into the two
# checkouts (embed/build.sh makes them; only the sources are tracked)
cocolog-embed
embed/embed.cpp
embed/ce_smoke
embed/Core
embed/StreamIO
embed/mvccs-lib.cicili
embed/generated
embed/ziglib

# the torch module's build output
cocolog-torch
cocolog-full
*.elc
/KB/
test/hoot.c
test/hoot.so

# EVERY LOADABLE MODULE'S OUTPUT. modules/ holds ten of them and they all
# have the same shape: a .cicili, a build.sh, and output -- the .so, the C
# or C++ Cicili generates, and the symlinks each build.sh makes into this
# checkout or into ZiguratIP's. A .so is a compiled x86-64 object linked
# against ONE machine's libraries; it belongs in a release, never here.
library/*.so
modules/tcp/tcp.c
modules/tcp/sdk.cicili
modules/thread/thread.c
modules/thread/sdk.cicili
modules/curl/curl.c
modules/curl/sdk.cicili
modules/process/process.c
modules/process/sdk.cicili
modules/text/text.c
modules/text/sdk.cicili
modules/ray/ray.c
modules/ray/sdk.cicili
modules/os/os.c
modules/os/sdk.cicili
modules/bigint/coco-bigint.cpp
modules/bigint/zigheaders
modules/torch/coco-torch.cpp

# ZiguratIP's cryptography: five more of the same shape. Each carries a
# sdk.cicili symlink into lib/ and a zigheaders symlink into a BUILT
# ZiguratIP's include -- both of which dangle in anyone else's clone.
modules/sha/coco-sha.cpp
modules/sha/sdk.cicili
modules/sha/zigheaders
modules/aes/coco-aes.cpp
modules/aes/sdk.cicili
modules/aes/zigheaders
modules/der/coco-der.cpp
modules/der/sdk.cicili
modules/der/zigheaders
modules/x509/coco-x509.cpp
modules/x509/sdk.cicili
modules/x509/zigheaders
modules/tls/coco-tls.cpp
modules/tls/sdk.cicili
modules/tls/zigheaders

# generated by tools/coco-agent/build.py in under a second
tools/coco-agent/blocklist.json

# python bytecode, from running the agent tools
__pycache__/
*.pyc

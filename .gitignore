# build output
build/
cocolog
*.o
*.lo
*.a
.libs/

# Cicili writes the generated C beside the target it came from
cocolog.c
test/*.c
test/cocolog_*_test
# test/run.sh keeps each case's build log next to it
test/.*.build

# parsi/build.sh scratch
parsi/.build.log

# the embedded engine's build output and its symlinks into the two
# checkouts (embed/build.sh makes them; only the sources are tracked)
cocolog-embed
embed/embed.cpp
embed/ce_smoke
embed/Core
embed/StreamIO
embed/mvccs-lib.cicili
embed/generated
embed/ziglib

# the torch module's build output
cocolog-torch
cocolog-full
torch/coco-torch.cpp
*.elc
/KB/
test/hoot.c
test/hoot.so

# library(curl)'s build output and its symlink into this checkout
# (lib/curl/build.sh makes all three; only build.sh and curl.cicili are
# tracked). A .so is a compiled x86-64 object linked against ONE machine's
# libcurl and OpenSSL -- it belongs in a release, never in the source.
library/*.so
lib/curl/curl.c
lib/curl/sdk.cicili

# library(bigint)'s build output and its symlink into the ZiguratIP
# checkout (lib/bigint/build.sh makes both, and `make' runs it). The same
# shape as torch/coco-torch.cpp above -- and `make clean' already deleted
# these two, so tracking them meant a clean left the tree dirty.
lib/bigint/coco-bigint.cpp
lib/bigint/zigheaders

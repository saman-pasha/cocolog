;;;; The loadable-module fixture: the smallest module that exercises the
;;;; whole SDK -- one C predicate, one Coco clause, one entry point.
;;;; test/library.sh transpiles it with Cicili, compiles the emitted C
;;;; into hoot.so with `gcc -shared -fPIC', puts it on $COCOLOG_LIBRARY,
;;;; and `use_module(library(hoot))' does the rest.

(DEFPARAMETER *hoot-predicates*
  '(("hoot" 1 ht_hoot)))

(DEFPARAMETER *hoot-prolog*
  "double_hoot(X, Y) :- hoot(X), hoot(Y).")

(source "hoot.c"
  (make :std #t :compile #f)

  (import "../lib/sdk.cicili")
  (coco-sdk)

  ;;; hoot(?X): unifies X with the atom this module is proud of.
  (func ht_hoot ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((t 0))
          (return (coco_m_unify_atom e t "hoot_from_c"))))

  (static) (coco-emit-module-dispatch ht_dispatch *hoot-predicates*)
  (coco-deflibrary "hoot" ht_dispatch *hoot-prolog*)

  ) ; source

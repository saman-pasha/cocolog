;;;; test cocolog resolution -- backtracking, cut, negation and the builtins
;;;
;;; The checks are mostly "how many solutions does this goal have", because
;;; that one number catches nearly everything the engine can get wrong: a trail
;;; that undoes too little gives too few, a choice point that is not popped
;;; gives too many, and a cut that truncates to the wrong height gives either.
;;;
;;; Three of them are here for a specific failure rather than for coverage:
;;;
;;;   THE CHOICE STACK MUST NOT GROW WITH A DETERMINISTIC RECURSION. `count'
;;;   below recurses 50000 deep with nothing to backtrack into. If the last
;;;   matching clause does not drop its own choice point, this test does not
;;;   fail -- it allocates 50000 frames and keeps them, which is the kind of
;;;   thing that only shows up in production.
;;;
;;;   CUT MUST BE LOCAL TO ITS CLAUSE. `first/1' has a cut in the first of
;;;   three clauses; a barrier taken from the wrong place either cuts nothing
;;;   or cuts the caller's alternatives too.
;;;
;;;   THE HEAP MUST BE RECLAIMED ON BACKTRACKING. `heap after' compares the
;;;   heap length before and after a goal that fails a great many times; if
;;;   failed branches were not wound back, it would grow without bound.

(source "solve.c"
  (make :std #t
        ;; Apple's clang 21 fires -Wparentheses-equality on the transpiler's
        ;; `while ((x == 0))' where older clangs stayed quiet, and Cicili
        ;; treats chatter as fatal -- the same pair every other target carries
        :compile ("-Wno-parentheses-equality" "-Wno-dangling-else" "-c" "solve.c")
        :link ("-lsolve.o" "-lm" "-o" "cocolog_solve_test"))

  ;; the arithmetic builtins reach pow/sqrt/fabs, so a target that uses
  ;; cocolog includes <math.h> and links -lm
  (include <math.h>)

  (import "../lib/term.cicili")
  (import "../lib/syntax.cicili")
  (import "../lib/dcg.cicili")
  (import "../lib/kb.cicili")
  (import "../lib/solve.cicili")

  (decl-term)   (impl-term)
  (decl-syntax) (impl-syntax)
  (decl-dcg)    (impl-dcg)
  (decl-kb)     (impl-kb)
  (decl-solve)  (impl-solve)

  (var int failures . 0)

  (func check ((const char * what) (llong got) (llong want))
        (if (== got want)
            (printf "ok   %-46s %lld\n" what got)
          (block (printf "FAIL %-46s got %lld want %lld\n" what got want)
                 (set failures (+ failures 1)))))

  (func check_str ((const char * what) (const char * got) (const char * want))
        (if (== 0 (strcmp got want))
            (printf "ok   %-46s %s\n" what got)
          (block (printf "FAIL %-46s got [%s] want [%s]\n" what got want)
                 (set failures (+ failures 1)))))

  ;; Counts the solutions of GOAL, up to a limit so a runaway program fails the
  ;; test instead of hanging it. -1 means the engine reported an error.
  (func count ((coco_engine * e) (const char * goal) (int limit)) (out int)
        (let ((int n . 0) (int rc . 1))
          (if (not (coco_engine_ask_text e goal)) (return -1))
          (while 1
            (set rc (coco_engine_next e))
            (if (== rc -1) (return -1))
            (if (== rc 0) break)
            (set n (+ n 1))
            (if (>= n limit) break))
          (return n)))

  ;; The first solution's binding for the first variable of GOAL, written out.
  ;; The reader keeps the variable names of what it just read, which is the
  ;; only reason this can say "X" rather than a cell number.
  (func first_binding ((coco_engine * e) (const char * goal) (char * out) (size_t cap))
        (out int)
        (let ((coco_reader r) (size_t t) (int rc))
          (set (nth 0 out) (cast char 0))
          (coco_reader_init (aof r) ($ (cof e) m) goal)
          (if (not (coco_read_goal (aof r) (aof t)))
              (block (coco_reader_free (aof r)) (return 0)))
          (if (== ($ r nvars) 0) (block (coco_reader_free (aof r)) (return 0)))
          (coco_engine_ask e t)
          (set rc (coco_engine_next e))
          (if (== rc 1)
              (let ((coco_strbuf b))
                (coco_sb_init (aof b))
                (coco_write_term ($ (cof e) m) (aof b) (nth 0 ($ r var_cells)) 0 0)
                (snprintf out cap "%s" (? (== ($ b s) nil) "" ($ b s)))
                (coco_sb_free (aof b))))
          (coco_reader_free (aof r))
          (return (? (== rc 1) 1 0))))

  (func main ()
    (let ((coco_machine m) (coco_store st) (coco_engine e) (char err [256]) (char buf [256])
          (int clauses . 0))
      (coco_machine_init (aof m))
      (coco_store_init (aof st))
      (coco_engine_init (aof e) (aof m) (aof st))
      ;; a runaway program stops rather than spinning; every goal below is far
      ;; inside this
      (set ($ e max_steps) 20000000)

      ;; A Cicili string is raw -- a newline in one reaches C as a newline
      ;; inside a literal, which C does not allow -- so the program is
      ;; consulted a few clauses at a time rather than as one block of text.
      (set clauses (+ clauses (coco_consult (aof st) (aof m)
        "p(1). p(2). p(3). q(X) :- p(X), X > 1. first(X) :- p(X), !."
        err (sizeof err))))
      (set clauses (+ clauses (coco_consult (aof st) (aof m)
        "parent(tom,bob). parent(tom,liz). parent(bob,ann). parent(bob,pat). parent(pat,jim)."
        err (sizeof err))))
      (set clauses (+ clauses (coco_consult (aof st) (aof m)
        "ancestor(X,Y) :- parent(X,Y). ancestor(X,Y) :- parent(X,Z), ancestor(Z,Y)."
        err (sizeof err))))
      (set clauses (+ clauses (coco_consult (aof st) (aof m)
        "append([],L,L). append([H|T],L,[H|R]) :- append(T,L,R)."
        err (sizeof err))))
      (set clauses (+ clauses (coco_consult (aof st) (aof m)
        "nrev([],[]). nrev([H|T],R) :- nrev(T,RT), append(RT,[H],R)."
        err (sizeof err))))
      (set clauses (+ clauses (coco_consult (aof st) (aof m)
        "len([],0). len([_|T],N) :- len(T,M), N is M + 1."
        err (sizeof err))))
      (set clauses (+ clauses (coco_consult (aof st) (aof m)
        "count(0) :- !. count(N) :- N > 0, M is N - 1, count(M)."
        err (sizeof err))))
      (set clauses (+ clauses (coco_consult (aof st) (aof m)
        "member(X,[X|_]). member(X,[_|T]) :- member(X,T)."
        err (sizeof err))))
      (check "consulted the program" (cast llong clauses) 22)

      ;; ---- plain backtracking ------------------------------------------
      (check "p(X) has three solutions"       (cast llong (count (aof e) "p(X)" 100)) 3)
      (check "q(X) has two"                   (cast llong (count (aof e) "q(X)" 100)) 2)
      (check "p(2) succeeds once"             (cast llong (count (aof e) "p(2)" 100)) 1)
      (check "p(9) fails"                     (cast llong (count (aof e) "p(9)" 100)) 0)
      (check "conjunction of two choices"     (cast llong (count (aof e) "p(X), p(Y)" 100)) 9)

      ;; ---- recursion through the database -------------------------------
      (check "ancestor(tom, X) has five"      (cast llong (count (aof e) "ancestor(tom,X)" 100)) 5)
      (check "ancestor(X, jim) has three"     (cast llong (count (aof e) "ancestor(X,jim)" 100)) 3)

      ;; ---- cut ----------------------------------------------------------
      (check "first(X) is committed"          (cast llong (count (aof e) "first(X)" 100)) 1)
      (first_binding (aof e) "first(X)" buf (sizeof buf))
      (check_str "and it is the first clause" buf "1")
      ;; a cut in the condition of an if-then-else is local to the condition
      (check "( p(X), ! ; true ) has one"
             (cast llong (count (aof e) "( p(X), ! ; true )" 100)) 1)
      (check "call/1 is opaque to cut"
             (cast llong (count (aof e) "p(X), call(!)" 100)) 3)

      ;; ---- disjunction, negation, if-then-else ---------------------------
      (check "disjunction adds"               (cast llong (count (aof e) "p(X) ; p(X)" 100)) 6)
      (check "negation of a truth fails"      (cast llong (count (aof e) "\\+ p(1)" 10)) 0)
      (check "negation of a falsehood holds"  (cast llong (count (aof e) "\\+ p(9)" 10)) 1)
      (check "if-then-else takes one branch"
             (cast llong (count (aof e) "( p(9) -> X = a ; X = b )" 100)) 1)
      (first_binding (aof e) "( p(9) -> X = a ; X = b )" buf (sizeof buf))
      (check_str "and it is the else"         buf "b")
      (check "if-then commits the condition"
             (cast llong (count (aof e) "( p(X) -> true ; true )" 100)) 1)

      ;; ---- arithmetic ----------------------------------------------------
      (first_binding (aof e) "X is 2 + 3 * 4" buf (sizeof buf))
      (check_str "arithmetic respects precedence" buf "14")
      (first_binding (aof e) "X is 7 // 2" buf (sizeof buf))
      (check_str "integer division"           buf "3")
      (first_binding (aof e) "X is 7 / 2" buf (sizeof buf))
      (check_str "inexact division is a float" buf "3.5")
      (first_binding (aof e) "X is 6 / 2" buf (sizeof buf))
      (check_str "exact division stays integer" buf "3")
      (first_binding (aof e) "X is -7 mod 3" buf (sizeof buf))
      (check_str "mod follows the divisor"    buf "2")
      (first_binding (aof e) "X is max(3, 4.5)" buf (sizeof buf))
      (check_str "max across types"           buf "4.5")

      ;; ---- the ISO bitwise functors --------------------------------------
      ;;
      ;; These were missing from BOTH the operator table and the evaluator,
      ;; and the way they were missing is the point. `/\' is a symbolic token
      ;; whether or not it is an operator, so the reader did not refuse
      ;; `X is 12 /\ 10' -- it read `X is 12', met an operator it did not
      ;; know, and stopped with the rest of the term unread. The goal SUCCEEDED
      ;; and bound X to 12. A missing feature that answers is worse than one
      ;; that fails, so each of these checks a VALUE.
      (first_binding (aof e) "X is 12 /\\ 10" buf (sizeof buf))
      (check_str "conjunction"                buf "8")
      (first_binding (aof e) "X is 12 \\/ 3" buf (sizeof buf))
      (check_str "disjunction"                buf "15")
      (first_binding (aof e) "X is 5 xor 3" buf (sizeof buf))
      (check_str "exclusive or"               buf "6")
      (first_binding (aof e) "X is \\ 5" buf (sizeof buf))
      (check_str "complement is two's complement" buf "-6")
      (first_binding (aof e) "X is msb(1024)" buf (sizeof buf))
      (check_str "the most significant bit"   buf "10")
      ;; 500 yfx, so this is (12 /\ 10) + 1 and not 12 /\ (10 + 1) -- the
      ;; priority is what makes `A /\ B =:= C' need no brackets
      (first_binding (aof e) "X is 12 /\\ 10 + 1" buf (sizeof buf))
      (check_str "and it binds like + does"   buf "9")
      ;; the four names that were written pre-escaped in the operator table
      ;; before the table began holding each name as the text the reader sees
      (check "\\+ still negates"              (cast llong (count (aof e) "\\+ fail" 10)) 1)
      (check "\\= still refuses to unify"     (cast llong (count (aof e) "a \\= b" 10)) 1)
      (check "\\== still compares"            (cast llong (count (aof e) "a \\== b" 10)) 1)
      (check "=\\= still compares numbers"    (cast llong (count (aof e) "1 =\\= 2" 10)) 1)
      (check "1 =:= 1.0"                      (cast llong (count (aof e) "1 =:= 1.0" 10)) 1)
      (check "1 == 1.0 is false"              (cast llong (count (aof e) "1 == 1.0" 10)) 0)
      (check "3 < 4"                          (cast llong (count (aof e) "3 < 4" 10)) 1)

      ;; ---- lists ----------------------------------------------------------
      (check "member/2 over three"            (cast llong (count (aof e) "member(X,[a,b,c])" 100)) 3)
      (first_binding (aof e) "append([1,2],[3],X)" buf (sizeof buf))
      (check_str "append/3 forwards"          buf "[1,2,3]")
      (check "append/3 splits four ways"
             (cast llong (count (aof e) "append(X,Y,[1,2,3])" 100)) 4)
      (first_binding (aof e) "nrev([1,2,3,4],X)" buf (sizeof buf))
      (check_str "naive reverse"              buf "[4,3,2,1]")
      (first_binding (aof e) "len([a,b,c,d,e],N)" buf (sizeof buf))
      (check_str "length by recursion"        buf "5")

      ;; ---- term inspection --------------------------------------------------
      (first_binding (aof e) "functor(foo(a,b), N, A)" buf (sizeof buf))
      (check_str "functor/3 takes a name"     buf "foo")
      (first_binding (aof e) "arg(2, foo(a,b), X)" buf (sizeof buf))
      (check_str "arg/3"                      buf "b")
      (first_binding (aof e) "X =.. [foo, 1, 2]" buf (sizeof buf))
      (check_str "=.. builds"                 buf "foo(1,2)")
      (first_binding (aof e) "foo(1,2) =.. X" buf (sizeof buf))
      (check_str "=.. takes apart"            buf "[foo,1,2]")
      (first_binding (aof e) "atom_length(hello, N)" buf (sizeof buf))
      (check_str "atom_length/2"              buf "5")
      (first_binding (aof e) "atom_concat(foo, bar, X)" buf (sizeof buf))
      (check_str "atom_concat/3"              buf "foobar")
      ;; The two modes where the WHOLE is known and one part is not.
      ;; ISO 8.16.6 requires both; refusing them made a prefix test throw
      ;; where every other Prolog answers, and a namespace check written
      ;; the obvious way is exactly that test.
      (first_binding (aof e) "atom_concat(psi_, X, psi_valid)" buf (sizeof buf))
      (check_str "atom_concat/3 splits off a prefix"  buf "valid")
      (first_binding (aof e) "atom_concat(X, valid, psi_valid)" buf (sizeof buf))
      (check_str "atom_concat/3 splits off a suffix"  buf "psi_")
      (first_binding (aof e) "atom_concat(abc, X, abc)" buf (sizeof buf))
      (check_str "atom_concat/3 leaves nothing over"  buf "")
      (first_binding (aof e) "atom_concat('', X, abc)" buf (sizeof buf))
      (check_str "atom_concat/3 takes nothing off"    buf "abc")
      ;; A prefix that is not one FAILS, and does not raise: a wrong
      ;; guess about an atom's shape is an ordinary answer.
      (check "atom_concat/3 refuses a wrong prefix"
             (cast llong (count (aof e) "atom_concat(psi_, _, zeta_valid)" 10)) 0)
      (check "atom_concat/3 refuses a wrong suffix"
             (cast llong (count (aof e) "atom_concat(_, xyz, psi_valid)" 10)) 0)
      (check "atom_concat/3 refuses a prefix longer than the whole"
             (cast llong (count (aof e) "atom_concat(abcd, _, abc)" 10)) 0)
      (first_binding (aof e) "atom_codes(ab, X)" buf (sizeof buf))
      (check_str "atom_codes/2 forwards"      buf "[97,98]")
      (first_binding (aof e) "atom_codes(X, [97,98])" buf (sizeof buf))
      (check_str "atom_codes/2 backwards"     buf "ab")
      (check "copy_term/2 makes it fresh"
             (cast llong (count (aof e) "copy_term(f(X,X), f(a,b))" 10)) 0)
      (check "copy_term/2 keeps the sharing"
             (cast llong (count (aof e) "copy_term(f(X,X), f(a,a))" 10)) 1)

      ;; ---- unification and comparison ------------------------------------
      (check "\\= leaves nothing bound"
             (cast llong (count (aof e) "X \\= 1, X = 2" 10)) 0)
      (check "a @< b"                         (cast llong (count (aof e) "a @< b" 10)) 1)
      (check "1 @< a"                         (cast llong (count (aof e) "1 @< a" 10)) 1)

      ;; ---- the database at run time --------------------------------------
      (check "assertz then query"
             (cast llong (count (aof e) "assertz(r(1)), assertz(r(2)), r(X)" 100)) 2)
      (check "retract removes one"
             (cast llong (count (aof e) "retract(r(1)), r(X)" 100)) 1)
      (check "asserta puts it first"
             (cast llong (count (aof e) "asserta(r(0)), r(X)" 100)) 2)

      ;; ---- retract respects the body -- a CivV capture's finding ----------
      ;; A fact IS `(F :- true)'. The shorthand must not pull a
      ;; same-headed RULE out from over the facts (it did: the body was
      ;; never asked), and the explicit (H :- true) form must reach a
      ;; stored fact (it could not: a fact's missing body read as a
      ;; mismatch). SWI answers all four the way these pin.
      (check "retract of a fact leaves a same-headed rule standing"
             (cast llong (count (aof e)
                    "assertz((mix(N) :- number(N))), assertz(mix(a)), retract(mix(a)), mix(7)" 10)) 1)
      (check "and the fact is the one that went"
             (cast llong (count (aof e) "mix(a)" 10)) 0)
      (check "the explicit true body reaches a stored fact"
             (cast llong (count (aof e) "assertz(fx(1)), retract((fx(1) :- true)), fx(_)" 10)) 0)
      (check "a rule retracts by its own shape, binding the body"
             (cast llong (count (aof e) "retract((mix(X) :- B)), B == number(X)" 10)) 1)
      ;; retractall kept SWI's WIDER contract when retract narrowed
      ;; (every head-match goes, rules included; builtins.cicili asks
      ;; `(C :- _)' for exactly this reason) -- but retractall is
      ;; Prolog from the builtins MODULE, which this bare engine never
      ;; loads, so that pin lives in test/repl.sh against the binary.

      ;; ---- the three that are here for a specific failure -----------------
      (let ((size_t before . #'($ m heap_len)))
        (check "a deterministic recursion 50000 deep"
               (cast llong (count (aof e) "count(50000)" 10)) 1)
        (check "and it left no choice points"  (cast llong ($ e nchoices)) 0))

      ;; A goal with 27 failing branches must not cost 27 branches of heap.
      ;; The comparison is between two identical runs rather than against a
      ;; fixed number: every query parses its own goal on to the heap, so the
      ;; SAME query run twice grows by that fixed cost and by nothing else --
      ;; unless failed branches are being kept, in which case the second run
      ;; grows by thousands of cells instead of tens.
      (let ((size_t a1) (size_t a2) (size_t growth))
        (count (aof e) "p(_), p(_), p(_), fail" 100)
        (set a1 ($ m heap_len))
        (check "a goal that fails everywhere"
               (cast llong (count (aof e) "p(_), p(_), p(_), fail" 100)) 0)
        (set a2 ($ m heap_len))
        (set growth (- a2 a1))
        (check "failed branches are reclaimed" (cast llong (< growth 200)) 1))

      ;; ---- directives and declarations ------------------------------------
      ;;
      ;; `:- dynamic Spec.' in a consulted file and `dynamic(Spec)' as a goal
      ;; are one implementation reached two ways, so both are checked, and
      ;; against all three shapes a spec is written in.
      (let ((char derr [256]))
        (check "a directive is applied and is not a clause"
               (cast llong (coco_consult (aof st) (aof m)
                                       ":- dynamic d1/1. d1(x). d1(y)."
                                       derr (sizeof derr))) 2)
        (let ((size_t pi . #'(coco_pred_find (aof st) (coco_intern (aof m) "d1") 1)))
          (check "and the predicate is marked dynamic"
                 (cast llong (? (< pi ($ st npreds))
                                ($ (nth pi ($ st preds)) dynamic) 0)) 1))

        (check "a conjunction of indicators declares both"
               (cast llong (coco_consult (aof st) (aof m)
                                       ":- dynamic d2/0, d3/2."
                                       derr (sizeof derr))) 0)
        (check "the first of them"
               (cast llong (< (coco_pred_find (aof st) (coco_intern (aof m) "d2") 0)
                              ($ st npreds))) 1)
        (check "the second of them"
               (cast llong (< (coco_pred_find (aof st) (coco_intern (aof m) "d3") 2)
                              ($ st npreds))) 1)

        (check "a list of indicators does too"
               (cast llong (coco_consult (aof st) (aof m)
                                       ":- dynamic [d4/1, d5/3]."
                                       derr (sizeof derr))) 0)
        (check "and declares what is in the list"
               (cast llong (< (coco_pred_find (aof st) (coco_intern (aof m) "d5") 3)
                              ($ st npreds))) 1)

        ;; declaring a predicate is how a program says it exists: it has no
        ;; clauses, so calling it fails, and failing is not an error
        (check "a declared predicate with no clauses fails"
               (cast llong (count (aof e) "d4(_)" 10)) 0)

        ;; `discontiguous' is parsed and deliberately does nothing: cocolog
        ;; keeps a predicate's clauses in one list wherever they were written
        (check "discontiguous is accepted and ignored"
               (cast llong (coco_consult (aof st) (aof m) ":- discontiguous d6/1."
                                       derr (sizeof derr))) 0)

        ;; and a directive nobody implements is REFUSED rather than quietly
        ;; asserted as a clause whose head is `:-', which is what used to happen
        (check "an unknown directive is an error"
               (cast llong (coco_consult (aof st) (aof m) ":- module(nonesuch)."
                                       derr (sizeof derr))) -1)

        (check "dynamic/1 works as a goal too"
               (cast llong (count (aof e) "dynamic(d7/2)" 10)) 1)
        (let ((size_t pi . #'(coco_pred_find (aof st) (coco_intern (aof m) "d7") 2)))
          (check "with the same effect"
                 (cast llong (? (< pi ($ st npreds))
                                ($ (nth pi ($ st preds)) dynamic) 0)) 1))

        ;; anything retractable is dynamic whether or not anybody said so --
        ;; a program that asserts into a predicate and takes it out again has
        ;; declared it by doing so
        (check "retracting marks a predicate dynamic"
               (cast llong (count (aof e) "assertz(d8(1)), retract(d8(1))" 10)) 1)
        (let ((size_t pi . #'(coco_pred_find (aof st) (coco_intern (aof m) "d8") 1)))
          (check "even though nothing declared it"
                 (cast llong (? (< pi ($ st npreds))
                                ($ (nth pi ($ st preds)) dynamic) 0)) 1))

        ;; `listing' writes to stdout, so what is checked here is that it runs
        ;; and answers -- the shape of what it prints is the writer's business
        ;; and syntax.cicili tests that against the reader
        (check "listing/1 answers for a predicate that has clauses"
               (cast llong (count (aof e) "listing(d1/1)" 10)) 1)
        (check "listing/1 by bare name answers too"
               (cast llong (count (aof e) "listing(d1)" 10)) 1)
        (check "and fails for one nothing knows about"
               (cast llong (count (aof e) "listing(d9/7)" 10)) 0)
        (check "listing/0 answers" (cast llong (count (aof e) "listing" 10)) 1))

      ;; ---- grammar rules become ordinary clauses -------------------------
      ;;
      ;; test/files/dcg.pl holds the BEHAVIOUR against SWI. What is checked here
      ;; is the SHAPE cocolog's own translator produces, which SWI is free to
      ;; differ on -- its compiler lifts a leading unification into the head and
      ;; this one does not, so `clause/2' shows something different there.
      (let ((char err [256]))
       (coco_consult (aof st) (aof m)
                     "g1 --> [a], g2. g2 --> [b]. g3 --> []. g4 --> [x], !. g5, [p] --> [q]."
                     err (sizeof err))

       ;; the rule is stored under the non-terminal's name with TWO more
       ;; arguments, so it is callable directly and `-->'/2 is not a predicate
       (check "a grammar rule becomes a clause of arity+2"
              (cast llong (count (aof e) "g1([a,b], [])" 10)) 1)
       (check "and the two arguments are a difference list"
              (cast llong (count (aof e) "g1([a,b,c], [c])" 10)) 1)
       ;; `g3 --> []' consumes nothing, so its two arguments are the same list
       (check "an empty body threads the list straight through"
              (cast llong (count (aof e) "g3(L, L)" 10)) 1)

       ;; the cut inside a body cuts the rule it is in and nothing outside it
       (check "a cut in a body is local to the rule"
              (cast llong (count (aof e) "g4([x], [])" 10)) 1)

       ;; pushback: `g5, [p] --> [q]' eats q and leaves p in front of the rest
       (check "a pushback rule puts its head back on the front"
              (cast llong (count (aof e) "g5([q|R], [p|R])" 10)) 1)

       ;; PHRASE/2,3 IS NOT CHECKED HERE. It is a clause in the dcg module's
       ;; Coco half, and this target links the engine without the module seam --
       ;; so `phrase' is an undefined predicate in it and raises, correctly.
       ;; test/files/dcg.pl exercises it through the built program, against SWI.

       ;; asserting a rule at RUN time goes through the same translation, which
       ;; is the whole reason it lives in `coco_assert' and not in `consult'
       (check "assert translates a grammar rule too"
              (cast llong (count (aof e) "assertz((g6 --> [z])), g6([z], [])" 10)) 1))

      ;; ---- errors are reported, not guessed -------------------------------
      (check "an unbound goal is an error"    (cast llong (count (aof e) "X" 10)) -1)
      (check "arithmetic on a variable is an error"
             (cast llong (count (aof e) "X is Y + 1" 10)) -1)
      ;; UNKNOWN AND EMPTY ARE DIFFERENT, and the difference is the whole reason
      ;; a library written against SWI can be run here at all. Nobody ever
      ;; defined `no_such_thing/1', so calling it raises; `declared_only/1' was
      ;; declared and simply has nothing to prove, so it fails.
      (check "an unknown predicate raises, as SWI does"
             (cast llong (count (aof e) "no_such_thing(1)" 10)) -1)
      (check "the ball is existence_error(procedure, Name/Arity)"
             (cast llong (count (aof e)
                                "catch(no_such_thing(1), error(E,_), true), E == existence_error(procedure, no_such_thing/1)"
                                10)) 1)
      (check "but a declared predicate with no clauses just fails"
             (cast llong (count (aof e) "dynamic(declared_only/1), declared_only(_)" 10)) 0)
      (check "and so does one an assert made and a retract emptied"
             (cast llong (count (aof e) "assertz(made(1)), retract(made(1)), made(_)" 10)) 0)

      (check "machine never ran out of memory" (cast llong ($ m oom)) 0)
      (check "store never ran out of memory"   (cast llong ($ st oom)) 0)

      (printf "\n%s: %d failure(s)\n" (? (== failures 0) "GREEN" "RED") failures)
      (coco_engine_free (aof e))
      (coco_store_free (aof st))
      (coco_machine_free (aof m))
      (return (? (== failures 0) 0 1)))))

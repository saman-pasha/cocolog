;;;; test cocolog syntax -- the reader and the writer, against each other
;;;
;;; THE ROUND TRIP IS THE TEST. Reading `X is 1+2*3' and writing it back must
;;; give text that reads to the same term, and the interesting failures are all
;;; about spacing and brackets: `1- -2' written as `1--2' is a different term,
;;; `-(1)' written as `-1' is an integer, and an operator standing as an
;;; argument needs brackets it does not need at the top. Each of those is one
;;; line below, and each of them was wrong at some point while this was written.

(source "syntax.c"
  (make :std #t
        ;; Apple's clang 21 fires -Wparentheses-equality on the transpiler's
        ;; `while ((x == 0))' where older clangs stayed quiet, and Cicili
        ;; treats chatter as fatal -- the same pair every other target carries
        :compile ("-Wno-parentheses-equality" "-Wno-dangling-else" "-c" "syntax.c")
        :link ("-lsyntax.o" "-o" "cocolog_syntax_test"))

  (import "../lib/term.cicili")
  (import "../lib/syntax.cicili")

  (decl-term)   (impl-term)
  (decl-syntax) (impl-syntax)

  (var int failures . 0)

  (func check_str ((const char * what) (const char * got) (const char * want))
        (if (== 0 (strcmp got want))
            (printf "ok   %-30s %s\n" what got)
          (block (printf "FAIL %-30s got [%s] want [%s]\n" what got want)
                 (set failures (+ failures 1)))))

  (func check ((const char * what) (llong got) (llong want))
        (if (== got want)
            (printf "ok   %-30s %lld\n" what got)
          (block (printf "FAIL %-30s got %lld want %lld\n" what got want)
                 (set failures (+ failures 1)))))

  ;; A variable prints as _G<cell>, and the cell depends on everything the
  ;; machine has built before it -- so a test that named one would have to be
  ;; renumbered whenever a line above it changed. `norm' flattens every _G<n>
  ;; to _V, which keeps the check on the SHAPE of the output where it belongs.
  (func norm ((const char * in) (char * out) (size_t cap))
        (let ((size_t o . 0) (size_t i . 0))
          (while (and (!= (nth i in) (cast char 0)) (< o (- cap 3)))
            (if (and (== (nth i in) (cast char 95))
                     (== (nth (+ i 1) in) (cast char 71)))
                (block (set (nth o out) (cast char 95))
                       (set (nth (+ o 1) out) (cast char 86))
                       (set o (+ o 2))
                       (set i (+ i 2))
                       (while (and (>= (nth i in) (cast char 48))
                                   (<= (nth i in) (cast char 57)))
                         (set i (+ i 1))))
              (block (set (nth o out) (nth i in))
                     (set o (+ o 1))
                     (set i (+ i 1)))))
          (set (nth o out) (cast char 0))))

  ;; read TEXT, write it back, and compare with WANT
  (func trip ((coco_machine * m) (const char * text) (const char * want))
        (let ((size_t t) (coco_strbuf b))
          (coco_sb_init (aof b))
          (if (not (coco_read_term_from m text (aof t)))
              (block (printf "FAIL %-30s did not read\n" text)
                     (set failures (+ failures 1))
                     (coco_sb_free (aof b))
                     (return)))
          (coco_write_canonical m (aof b) t)
          (let ((char flat [512]))
            (norm ($ b s) flat (sizeof flat))
            (check_str text flat want))
          (coco_sb_free (aof b))))

  ;; read TEXT as a clause and check that the reader REFUSES it, and says WANT
  (func refuses ((coco_machine * m) (const char * text) (const char * want))
        (let ((coco_reader r) (size_t t) (int rc))
          (coco_reader_init (aof r) m text)
          (set rc (coco_read_clause (aof r) (aof t)))
          (if (and (== rc -1) (!= nil (strstr ($ r err) want)))
              (printf "ok   %-30s refused: %s\n" text ($ r err))
            (block (printf "FAIL %-30s rc %d, err [%s]\n" text rc ($ r err))
                   (set failures (+ failures 1))))
          (coco_reader_free (aof r))))

  ;; read TEXT, write it, read that, and check the two terms are identical
  (func stable ((coco_machine * m) (const char * text))
        (let ((size_t t1) (size_t t2) (coco_strbuf b))
          (coco_sb_init (aof b))
          (if (not (coco_read_term_from m text (aof t1)))
              (block (printf "FAIL %-30s did not read\n" text)
                     (set failures (+ failures 1)) (coco_sb_free (aof b)) (return)))
          (coco_write_canonical m (aof b) t1)
          (if (not (coco_read_term_from m ($ b s) (aof t2)))
              (block (printf "FAIL %-30s did not re-read [%s]\n" text ($ b s))
                     (set failures (+ failures 1)) (coco_sb_free (aof b)) (return)))
          ;; The two terms are not `==': re-reading makes fresh variables, and
          ;; the standard order tells variables apart by their cell. What must
          ;; match is the TEXT, with the variable numbering flattened.
          (let ((coco_strbuf b2) (char f1 [512]) (char f2 [512]))
            (coco_sb_init (aof b2))
            (coco_write_canonical m (aof b2) t2)
            (norm ($ b s) f1 (sizeof f1))
            (norm ($ b2 s) f2 (sizeof f2))
            (if (== 0 (strcmp f1 f2))
                (printf "ok   re-read is stable: %s\n" f1)
              (block (printf "FAIL re-read differs: %s -> %s\n" f1 f2)
                     (set failures (+ failures 1))))
            (coco_sb_free (aof b2)))
          (coco_sb_free (aof b))))

  (func main ()
    (let ((coco_machine m))
      (coco_machine_init (aof m))

      ;; ---- the operator table, as the macro layer emitted it ------------
      (let ((int p) (int ty))
        (check "is/2 is 700 xfx"
               (cast llong (and (coco_op_infix "is" (aof p) (aof ty)) (== p 700))) 1)
        (check "*/2 binds tighter than +/2"
               (cast llong (and (coco_op_infix "*" (aof p) (aof ty))
                                (== p 400))) 1)
        (check "\\+ is a prefix operator"
               (cast llong (coco_op_prefix "\\+" (aof p) (aof ty))) 1)
        (check "foo is not an operator" (cast llong (coco_op_is_any "foo")) 0))

      ;; ---- precedence and associativity --------------------------------
      (trip (aof m) "1+2*3"        "1+2*3")
      (trip (aof m) "(1+2)*3"      "(1+2)*3")
      (trip (aof m) "1-2-3"        "1-2-3")
      (trip (aof m) "1-(2-3)"      "1-(2-3)")
      (trip (aof m) "a:-b,c"       "a:-b,c")
      (trip (aof m) "X is 1+2"     "_V is 1+2")

      ;; ---- the two that spacing decides --------------------------------
      ;; -(1) is a compound; -1 is an integer. Both must survive being written.
      (trip (aof m) "- 1"          "- 1")
      (trip (aof m) "-1"           "-1")
      (trip (aof m) "1 - -2"       "1- -2")

      ;; ---- spacing: a space appears only where two tokens would merge ----
      ;;
      ;; THE RULE IS THE TOKENISER READ BACKWARDS, and it is SWI's: `a' and
      ;; `-' do not lex as one token, so `a-b'; `-' and `-' do, so `1- -2';
      ;; `mod' and `b' do, so `a mod b'. Every line below was read off a
      ;; running SWI-Prolog 9 and agrees with it exactly.
      (trip (aof m) "a-b"          "a-b")
      (trip (aof m) "a mod b"      "a mod b")
      (trip (aof m) "1 rem 2"      "1 rem 2")
      (trip (aof m) "a>=b"         "a>=b")
      (trip (aof m) "1 =< 2"       "1=<2")
      (trip (aof m) "a=..b"        "a=..b")
      (trip (aof m) "a@<b"         "a@<b")
      (trip (aof m) "1+(-2)"       "1+ -2")
      (trip (aof m) "1*(-2)"       "1* -2")
      (trip (aof m) "2 - (-3) - 4" "2- -3-4")
      ;; a solo character never merges, so no space either side of `,' or `;'
      (trip (aof m) "(a,-1)"       "a,-1")
      (trip (aof m) "(a;-1)"       "a;-1")
      ;; a quoted atom begins with a quote, which merges with nothing
      (trip (aof m) "'hello world'-x" "'hello world'-x")

      ;; ---- and prefix, where the rule is not quite the same --------------
      ;;
      ;; A DIGIT after prefix `-' takes a space even though the two do not
      ;; merge as tokens -- `-1' is not `-' applied to 1, it is the integer.
      ;; That is a rule about prefix position alone: `1-2' is right without
      ;; one.
      (trip (aof m) "-(a)"         "-a")
      (trip (aof m) "-(1.5)"       "- 1.5")
      (trip (aof m) "-(-(a))"      "- -a")
      (trip (aof m) "\\+ (-1)"      "\\+ -1")
      (trip (aof m) "-([a])"       "-[a]")
      (trip (aof m) "-(f(x))"      "-f(x)")
      ;; and an opening parenthesis takes one, which is what SWI does
      (trip (aof m) "-(a+b)"       "- (a+b)")
      ;; but the digit's space is `-''s alone (2.2.3): every other symbolic
      ;; prefix operator before a number reads back as itself applied to it,
      ;; and SWI 9 writes no space there. Through 2.2.2 each took one.
      (trip (aof m) "+(1)"         "+1")
      (trip (aof m) "+(1.5)"       "+1.5")
      (trip (aof m) "\\(1)"        "\\1")
      (trip (aof m) "\\+(1)"       "\\+1")
      (trip (aof m) "?-(1)"        "?-1")
      (trip (aof m) "+(+(1))"      "+ +1")
      (trip (aof m) "-(+(1))"      "- +1")
      (trip (aof m) "+(-(1))"      "+ - 1")
      (trip (aof m) "+(-1)"        "+ -1")
      (trip (aof m) "+(1)^2"       "(+1)^2")
      (trip (aof m) "f(+(1),\\(2))" "f(+1,\\2)")

      ;; ---- every one of those has to read back as what it was ------------
      (stable (aof m) "1- -2")
      (stable (aof m) "- 1")
      (stable (aof m) "-(a+b)")
      (stable (aof m) "a mod b")
      (stable (aof m) "1+ -2")
      (stable (aof m) "(a,-1)")
      (stable (aof m) "-(-(a))")
      (stable (aof m) "+(1)")
      (stable (aof m) "\\(1)")
      (stable (aof m) "?-(1)")
      (stable (aof m) "+(+(1))")
      (stable (aof m) "+(-1)")
      (stable (aof m) "1 - +(1)")

      ;; ---- an operator as an ordinary argument -------------------------
      ;; AN OPERATOR ATOM IS BRACKETED AS AN OPERAND AND NOWHERE ELSE, which
      ;; is SWI's rule. An argument is read at priority 999, so a `-' followed
      ;; by a `,' or a `)' or a `]' cannot be a prefix operator and comes back
      ;; as the atom -- there is nothing to protect it from.
      (trip (aof m) "f(-)"         "f(-)")
      (trip (aof m) "f(-,a)"       "f(-,a)")
      (trip (aof m) "[-]"          "[-]")
      (trip (aof m) "[a,-]"        "[a,-]")
      (trip (aof m) "f(mod)"       "f(mod)")
      ;; but as an operand it is bracketed, because there it really is where an
      ;; operator would be read
      (trip (aof m) "-(-)"         "- (-)")

      ;; ---- an atom that is a prefix operator, and what follows it -------
      ;;
      ;; THE RULE IS WHETHER THE NEXT TOKEN COULD START A TERM. `- - a' is
      ;; prefix `-' applied to `-a', because the second `-' can begin one;
      ;; `- = a' is infix `=' with the atom `-' on its left, because `=' is
      ;; only ever infix and begins nothing. And a QUOTED atom is never a
      ;; prefix operator at all, which is the whole difference between
      ;; `- - a' and `'-' - a'.
      (stable (aof m) "- - a")
      (stable (aof m) "- = a")
      (stable (aof m) "- * a")
      (stable (aof m) "'-' - a")
      (stable (aof m) "f(-, a)")
      (stable (aof m) "- mod a")
      (stable (aof m) "\\+ - a")

      ;; NOT the errors: where SWI refuses `- \\+ a' as an operator clash this
      ;; reader is lenient and reads something. Leniency is the direction that
      ;; costs nothing: it accepts terms SWI rejects and misreads none.

      ;; and every one of them has to read back as what it was
      (stable (aof m) "f(-)")
      (stable (aof m) "[a,-]")
      (stable (aof m) "-(-)")
      (trip (aof m) "f(a,b)"       "f(a,b)")

      ;; ---- lists -------------------------------------------------------
      (trip (aof m) "[]"           "[]")
      (trip (aof m) "[1,2,3]"      "[1,2,3]")
      (trip (aof m) "[a|T]"        "[a|_V]")
      (trip (aof m) "[[1],[2]]"    "[[1],[2]]")

      ;; ---- curly terms and quoting -------------------------------------
      (trip (aof m) "{a,b}"        "{a,b}")
      (trip (aof m) "'hello world'" "'hello world'")
      (trip (aof m) "'it''s'"      "'it''s'")
      (trip (aof m) "[]"           "[]")
      ;; the empty atom as the reader's FIRST token, when nothing has been put
      ;; in its token buffer yet: through 1.10.25 that copied from nil and
      ;; the process died (term_to_atom(T, '''''') did the same)
      (trip (aof m) "''"           "''")
      (trip (aof m) "'' - a"       "''-a")

      ;; ---- TWO RUNS OF SYMBOL CHARACTERS THAT DO NOT READ BACK BARE -------
      ;;
      ;; `.' alone ends a clause and a run that begins `/*' begins a comment,
      ;; so written bare neither comes back as the atom it was: writeq('.')
      ;; wrote `.', and library(flow/chart) drew `root('.')' as `root(.)'. SWI
      ;; quotes the two and nothing else of the kind: `..' and `//*' read
      ;; back bare.
      (trip (aof m) "'.'"          "'.'")
      (trip (aof m) "f('.', '/*')" "f('.','/*')")
      (trip (aof m) "'/**'"        "'/**'")
      (trip (aof m) "'..'"         "..")
      (trip (aof m) "'//*'"        "//*")
      (stable (aof m) "f('.', '/*', '/**', '..', '//*', '*/')")

      ;; ---- numbers ------------------------------------------------------
      (trip (aof m) "0'a"          "97")
      (trip (aof m) "0xff"         "255")
      (trip (aof m) "3.5"          "3.5")
      (trip (aof m) "2.0"          "2.0")
      (trip (aof m) "1.0e3"        "1000.0")

      ;; ---- AN INTEGER IS 64 BITS, AND A LITERAL PAST THEM IS REFUSED ---------
      ;;
      ;; Through 1.8.49 the digits were read into 64 bits -- a decimal
      ;; saturated at the largest, a radix literal wrapped -- and the cell kept
      ;; the low 61 of them, without a word; through 1.15.0 the range was the
      ;; cell's, -2^60 .. 2^60 - 1. Since 2.0.0 it is 64 bits, -2^63 .. 2^63 - 1,
      ;; a value past the cell boxed in the machine's integer table. The cell
      ;; keeps a 60-bit payload since 2.5.0 (the four-bit tag), so the largest
      ;; it holds inline is 2^59 - 1; the magnitude of a negative literal may
      ;; be one more than a positive's, and the least integer's, 2^63, has no
      ;; i64 of its own: the lexer counts the digits in u64 and the reader
      ;; negates.
      (trip (aof m) "576460752303423487"   "576460752303423487")    ; 2^59 - 1, the cell's largest
      (trip (aof m) "576460752303423488"   "576460752303423488")    ; 2^59, boxed
      (trip (aof m) "-576460752303423489"  "-576460752303423489")   ; one past -2^59, boxed
      (trip (aof m) "1152921504606846975"  "1152921504606846975")    ; 2^60 - 1, boxed
      (trip (aof m) "9223372036854775807"  "9223372036854775807")    ; 2^63 - 1
      (trip (aof m) "-9223372036854775808" "-9223372036854775808")   ; -2^63
      (trip (aof m) "0x7fffffffffffffff"   "9223372036854775807")
      (trip (aof m) "-0x8000000000000000"  "-9223372036854775808")
      (trip (aof m) "0o777777777777777777777" "9223372036854775807")
      (trip (aof m) "f(1, 4611686018427387904)" "f(1,4611686018427387904)")
      (refuses (aof m) "9223372036854775808."   "integer out of range")
      (refuses (aof m) "-9223372036854775809."  "integer out of range")
      (refuses (aof m) "99999999999999999999."  "integer out of range")
      (refuses (aof m) "0x8000000000000000."    "integer out of range")
      (refuses (aof m) "-0x8000000000000001."   "integer out of range")
      (refuses (aof m) "0xffffffffffffffff."    "integer out of range")
      (refuses (aof m) "0x10000000000000000."   "integer out of range")
      (refuses (aof m) "0o7777777777777777777777." "integer out of range")
      (refuses (aof m) "f(1, 9223372036854775808)." "integer out of range")

      ;; ---- strings are code lists ---------------------------------------
      (trip (aof m) "\"ab\""       "[97,98]")

      ;; ---- whatever it looks like, it must read back the same ----------
      (stable (aof m) "foo(X, [1,2|Y], 'a b', -3, 1+2*3)")
      (stable (aof m) "a:-b,c;d->e")
      (stable (aof m) "\\+ x")
      (stable (aof m) "- (1)")

      ;; ---- clause-by-clause reading, and variable names ------------------
      (let ((coco_reader r) (size_t t) (int rc . 1) (int n . 0))
        (coco_reader_init (aof r) (aof m) "p(1). p(2). q(X) :- p(X).")
        ;; `set' is a statement, so the read cannot sit in the loop test
        (while (== rc 1)
          (set rc (coco_read_clause (aof r) (aof t)))
          (if (== rc 1) (set n (+ n 1))))
        (check "three clauses read" (cast llong n) 3)
        (check "ended cleanly"      (cast llong rc) 0)
        (coco_reader_free (aof r)))

      (let ((coco_reader r) (size_t t))
        (coco_reader_init (aof r) (aof m) "q(X, Y, X).")
        (coco_read_clause (aof r) (aof t))
        (check "two distinct variables named" (cast llong ($ r nvars)) 2)
        (check "first is X" (cast llong (strcmp (nth 0 ($ r var_names)) "X")) 0)
        (coco_reader_free (aof r)))

      ;; ---- A NAME IS NOT TRUNCATED, AT ANY LENGTH -----------------------
      ;;
      ;; The parser used to copy every NAME token into a `char [256]' with
      ;; snprintf, so an atom past 255 characters came back SILENTLY
      ;; shortened. Nothing on either side of the copy had that limit -- the
      ;; reader's own buffer grows and the atom table stores names by length
      ;; -- so nothing complained; the cut happened in between.
      ;;
      ;; It was found from a long way downstream. A Bitcoin transaction
      ;; written as 408 hex digits reached a hex decoder as 255 of them, an
      ;; odd count, and was refused as not hexadecimal -- a domain error
      ;; about the input, three layers below the reader that damaged it.
      ;; That is the shape of the bug this guards: not a crash, an answer
      ;; about the wrong data.
      ;;
      ;; A thousand characters, checked THREE ways, because the copy happened
      ;; in three places: a bare atom, a functor name, and an operand of an
      ;; infix operator (which `coco_parse_term' copies separately).
      (let ((coco_reader r) (size_t t) (char src [2200]) (size_t at . 0))
        (set (nth at src) (cast char 39)) (set at (+ at 1))   ; '
        (for ((size_t j . 0)) (< j 1000) ((++ j))
          (set (nth at src) (cast char 97)) (set at (+ at 1))) ; a
        (set (nth at src) (cast char 39)) (set at (+ at 1))
        (set (nth at src) (cast char 46)) (set at (+ at 1))    ; .
        (set (nth at src) (cast char 0))
        (coco_reader_init (aof r) (aof m) src)
        (check "a 1000-character atom reads"
               (cast llong (coco_read_clause (aof r) (aof t))) 1)
        (check "and keeps every character"
               (cast llong (strlen (coco_atom_name (aof m) (coco_name_of (aof m) t))))
               1000)
        (coco_reader_free (aof r)))

      (let ((coco_reader r) (size_t t) (char src [2200]) (size_t at . 0))
        (set (nth at src) (cast char 39)) (set at (+ at 1))
        (for ((size_t j . 0)) (< j 700) ((++ j))
          (set (nth at src) (cast char 98)) (set at (+ at 1))) ; b
        (set (nth at src) (cast char 39)) (set at (+ at 1))
        (set (nth at src) (cast char 40)) (set at (+ at 1))    ; (
        (set (nth at src) (cast char 49)) (set at (+ at 1))    ; 1
        (set (nth at src) (cast char 41)) (set at (+ at 1))    ; )
        (set (nth at src) (cast char 46)) (set at (+ at 1))
        (set (nth at src) (cast char 0))
        (coco_reader_init (aof r) (aof m) src)
        (check "a 700-character functor reads"
               (cast llong (coco_read_clause (aof r) (aof t))) 1)
        (check "the compound keeps its name"
               (cast llong (strlen (coco_atom_name (aof m) (coco_name_of (aof m) t))))
               700)
        (check "and its one argument" (cast llong (coco_arity (aof m) t)) 1)
        (coco_reader_free (aof r)))

      (let ((coco_reader r) (size_t t) (char src [2200]) (size_t at . 0))
        (set (nth at src) (cast char 39)) (set at (+ at 1))
        (for ((size_t j . 0)) (< j 400) ((++ j))
          (set (nth at src) (cast char 99)) (set at (+ at 1))) ; c
        (set (nth at src) (cast char 39)) (set at (+ at 1))
        (set (nth at src) (cast char 61)) (set at (+ at 1))    ; =
        (set (nth at src) (cast char 49)) (set at (+ at 1))    ; 1
        (set (nth at src) (cast char 46)) (set at (+ at 1))
        (set (nth at src) (cast char 0))
        (coco_reader_init (aof r) (aof m) src)
        (check "a 400-character operand reads"
               (cast llong (coco_read_clause (aof r) (aof t))) 1)
        (check "the operator kept its left side"
               (cast llong (strlen (coco_atom_name
                                    (aof m)
                                    (coco_name_of
                                     (aof m)
                                     (coco_deref (aof m) (coco_arg (aof m) t 0))))))
               400)
        (coco_reader_free (aof r)))

      ;; ---- a syntax error is reported, not ignored ----------------------
      (let ((coco_reader r) (size_t t))
        (coco_reader_init (aof r) (aof m) "foo(a,).")
        (check "bad clause answers -1" (cast llong (coco_read_clause (aof r) (aof t))) -1)
        (check "and says so" (cast llong (> (strlen ($ r err)) 0)) 1)
        (coco_reader_free (aof r)))

      (check "machine never ran out of memory" (cast llong ($ m oom)) 0)
      (printf "\n%s: %d failure(s)\n" (? (== failures 0) "GREEN" "RED") failures)
      (coco_machine_free (aof m))
      (return (? (== failures 0) 0 1)))))

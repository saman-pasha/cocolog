;;;; test cocolog state -- a machine stopped mid-proof, and resumed elsewhere
;;;
;;; THE CHECK THAT MATTERS is the one in the middle: a query with several
;;; solutions is run until it has produced one, frozen at that point, and the
;;; frozen text is then thawed into a DIFFERENT machine and a DIFFERENT store
;;; -- the originals are freed first, so nothing can be shared by accident --
;;; and the remaining solutions are drawn from the new one. If any part of the
;;; continuation, the trail or the choice stack failed to survive, the second
;;; machine produces the wrong number of answers, or the wrong ones.
;;;
;;; The machine is deliberately frozen at a point where it is deep in a
;;; recursive predicate with clauses still to try: `ancestor/2' over a family
;;; tree leaves choice points at more than one depth, and each of them is a
;;; predicate part way through its clause list.

(source "state.c"
  (make :std #t
        ;; Apple's clang 21 fires -Wparentheses-equality on the transpiler's
        ;; `while ((x == 0))' where older clangs stayed quiet, and Cicili
        ;; treats chatter as fatal -- the same pair every other target carries
        :compile ("-Wno-parentheses-equality" "-Wno-dangling-else" "-c" "state.c")
        :link ("-lstate.o" "-lm" "-o" "cocolog_state_test"))

  (include <math.h>)

  (import "../lib/term.cicili")
  (import "../lib/syntax.cicili")
  (import "../lib/dcg.cicili")
  (import "../lib/kb.cicili")
  (import "../lib/solve.cicili")
  (import "../lib/state.cicili")

  (decl-term)   (impl-term)
  (decl-syntax) (impl-syntax)
  (decl-dcg)    (impl-dcg)
  (decl-kb)     (impl-kb)
  (decl-solve)  (impl-solve)
  (decl-state)  (impl-state)

  (var int failures . 0)

  (func check ((const char * what) (llong got) (llong want))
        (if (== got want)
            (printf "ok   %-46s %lld\n" what got)
          (block (printf "FAIL %-46s got %lld want %lld\n" what got want)
                 (set failures (+ failures 1)))))

  (func check_str ((const char * what) (const char * got) (const char * want))
        (if (== 0 (strcmp got want))
            (printf "ok   %-46s %s\n" what got)
          (block (printf "FAIL %-46s got [%s] want [%s]\n" what got want)
                 (set failures (+ failures 1)))))

  ;; The family tree both machines are given. Loaded into whichever store is
  ;; passed, so the resumed machine reads the same knowledge base the frozen
  ;; one was reading -- which is exactly what a shared database gives you.
  (func load_kb ((coco_store * st) (coco_machine * m)) (out int)
        (let ((char err [256]) (int n . 0))
          (set n (+ n (coco_consult st m
            "parent(tom,bob). parent(tom,liz). parent(bob,ann). parent(bob,pat). parent(pat,jim)."
            nil err (sizeof err))))
          (set n (+ n (coco_consult st m
            "ancestor(X,Y) :- parent(X,Y). ancestor(X,Y) :- parent(X,Z), ancestor(Z,Y)."
            nil err (sizeof err))))
          (return n)))

  ;; Naive reverse, for the machine stopped at every step below.
  (func load_nrev ((coco_store * st) (coco_machine * m)) (out int)
        (let ((char err [256]))
          (return (coco_consult st m
            "app([], L, L). app([H|T], L, [H|R]) :- app(T, L, R). nrev([], []). nrev([H|T], R) :- nrev(T, RT), app(RT, [H], R)."
            nil err (sizeof err)))))

  ;; Writes the current binding of the query's first variable into OUT.
  (func binding_of ((coco_engine * e) (size_t cell) (char * out) (size_t cap))
        (let ((coco_strbuf b))
          (coco_sb_init (aof b))
          (coco_write_term ($ (cof e) m) (aof b) cell 0 0)
          (snprintf out cap "%s" (? (== ($ b s) nil) "" ($ b s)))
          (coco_sb_free (aof b))))

  (func main ()
    (let ((coco_machine m) (coco_store st) (coco_engine e)
          (coco_strbuf frozen) (char buf [256]) (char first [256])
          (size_t xcell))
      (coco_machine_init (aof m))
      (coco_store_init (aof st))
      (coco_engine_init (aof e) (aof m) (aof st))
      (set ($ e max_steps) 10000000)

      (check "knowledge base loaded" (cast llong (load_kb (aof st) (aof m))) 7)

      ;; ---- run until one solution, then stop --------------------------
      (let ((coco_reader r) (size_t g) (int rc))
        (coco_reader_init (aof r) (aof m) "ancestor(tom, X)")
        (coco_read_goal (aof r) (aof g))
        (set xcell (nth 0 ($ r var_cells)))
        (coco_reader_free (aof r))
        (coco_engine_ask (aof e) g)
        (set rc (coco_engine_next (aof e)))
        (check "the first solution came" (cast llong rc) 1)
        (binding_of (aof e) xcell first (sizeof first))
        (check_str "and it is the first child" first "bob"))

      ;; a machine part way through has choice points, and they are what the
      ;; freeze has to carry
      (check "the machine has choice points to keep"
             (cast llong (> ($ e nchoices) 0)) 1)

      ;; ---- freeze ------------------------------------------------------
      (coco_sb_init (aof frozen))
      (check "froze" (cast llong (coco_freeze (aof e) (aof frozen))) 1)
      (check "the frozen form is text" (cast llong (> ($ frozen len) 0)) 1)
      (printf "     frozen machine is %lu bytes\n" (cast ulong ($ frozen len)))

      ;; Keep a copy, then destroy everything the first machine had. Nothing
      ;; below can accidentally read the original: it is freed.
      (let ((char * blob . #'(strdup ($ frozen s))))
        (coco_sb_free (aof frozen))
        (coco_engine_free (aof e))
        (coco_store_free (aof st))
        (coco_machine_free (aof m))

        ;; ---- thaw into a machine that never saw the query ---------------
        (let ((coco_machine m2) (coco_store st2) (coco_engine e2)
              (int rc) (int n . 0))
          (coco_machine_init (aof m2))
          (coco_store_init (aof st2))
          (coco_engine_init (aof e2) (aof m2) (aof st2))

          (check "thawed" (cast llong (coco_thaw (aof e2) (aof m2) (aof st2) blob)) 1)

          ;; the knowledge base is loaded AFTER thawing, so its atoms intern
          ;; against the table the frozen heap refers to
          (check "knowledge base reloaded" (cast llong (load_kb (aof st2) (aof m2))) 7)

          (check "the choice points came back"
                 (cast llong (> ($ e2 nchoices) 0)) 1)

          ;; ---- and now finish the proof in the second machine -----------
          (while 1
            (set rc (coco_engine_next (aof e2)))
            (if (!= rc 1) break)
            (set n (+ n 1))
            (if (> n 20) break))
          (check "the resumed machine found the rest" (cast llong n) 4)
          (check "and then ran out cleanly" (cast llong rc) 0)

          (coco_engine_free (aof e2))
          (coco_store_free (aof st2))
          (coco_machine_free (aof m2)))

        ;; ---- a second round trip, to show the format is stable ----------
        (let ((coco_machine m3) (coco_store st3) (coco_engine e3) (coco_strbuf again))
          (coco_machine_init (aof m3))
          (coco_store_init (aof st3))
          (coco_engine_init (aof e3) (aof m3) (aof st3))
          (coco_thaw (aof e3) (aof m3) (aof st3) blob)
          (load_kb (aof st3) (aof m3))
          (coco_sb_init (aof again))
          (coco_freeze (aof e3) (aof again))
          ;; Freezing what was just thawed must give the same text back. This
          ;; is what says the format loses nothing: any field that were not
          ;; carried would come back as a zero and show up here.
          (check_str "freeze(thaw(x)) == x" ($ again s) blob)
          (coco_sb_free (aof again))
          (coco_engine_free (aof e3))
          (coco_store_free (aof st3))
          (coco_machine_free (aof m3)))

        ;; ---- a blob that is not one is refused, not guessed at ----------
        (let ((coco_machine m4) (coco_store st4) (coco_engine e4))
          (coco_machine_init (aof m4))
          (coco_store_init (aof st4))
          (coco_engine_init (aof e4) (aof m4) (aof st4))
          (check "rubbish is refused"
                 (cast llong (coco_thaw (aof e4) (aof m4) (aof st4) "not a machine")) 0)
          (check "and it says so" (cast llong (> (strlen ($ e4 err)) 0)) 1)
          (coco_engine_free (aof e4))
          (coco_store_free (aof st4))
          (coco_machine_free (aof m4)))

        (free blob))

      ;; ---- a machine frozen INSIDE a catch/3 --------------------------
      ;;
      ;; A catch is a choice-point frame like any other, which is what makes
      ;; this work at all: the frame is written out with its kind, and the
      ;; catcher and the recovery goal ride on the heap in one `'$catch'(C,R)'
      ;; term, which the heap serialiser already carries. If that were not so
      ;; a machine could be suspended inside a catch and come back without it,
      ;; and the throw would escape to the top level instead of being caught.
      (let ((coco_machine m5) (coco_store st5) (coco_engine e5)
            (coco_strbuf f5) (char err5 [256]) (char * blob5 . nil))
        (coco_machine_init (aof m5))
        (coco_store_init (aof st5))
        (coco_engine_init (aof e5) (aof m5) (aof st5))
        (coco_consult (aof st5) (aof m5)
                    "p(1). p(2). p(3). g(R) :- catch((p(X), X > 2, throw(got(X))), got(Y), R = caught(Y))."
                    nil err5 (sizeof err5))
        ;; a budget small enough to stop it part way through the catch
        (set ($ e5 max_steps) 6)
        (coco_engine_ask_text (aof e5) "g(R)")
        (check "it ran out of budget inside the catch"
               (cast llong (coco_engine_next (aof e5))) -1)

        (coco_sb_init (aof f5))
        (check "froze from inside a catch" (cast llong (coco_freeze (aof e5) (aof f5))) 1)
        (set blob5 (strdup ($ f5 s)))
        (coco_sb_free (aof f5))
        (coco_engine_free (aof e5))
        (coco_store_free (aof st5))
        (coco_machine_free (aof m5))

        (let ((coco_machine m6) (coco_store st6) (coco_engine e6) (char err6 [256]))
          (coco_machine_init (aof m6))
          (coco_store_init (aof st6))
          (coco_engine_init (aof e6) (aof m6) (aof st6))
          (check "thawed it" (cast llong (coco_thaw (aof e6) (aof m6) (aof st6) blob5)) 1)
          (coco_consult (aof st6) (aof m6)
                      "p(1). p(2). p(3). g(R) :- catch((p(X), X > 2, throw(got(X))), got(Y), R = caught(Y))."
                      nil err6 (sizeof err6))
          (set ($ e6 max_steps) 1000)
          (check "and the throw was still caught by the frame that came back"
                 (cast llong (coco_engine_next (aof e6))) 1)
          (coco_engine_free (aof e6))
          (coco_store_free (aof st6))
          (coco_machine_free (aof m6)))
        (free blob5))

      ;; ---- a machine stopped at EVERY step, and resumed elsewhere -----
      ;;
      ;; The step hands the first goal of the clause it entered to the next
      ;; step in the engine, not in a `'$k'' frame (`ngoal', 1.8.55), and a
      ;; stop at the inference limit pushes it back as a frame first. So the
      ;; proof is stopped after each of its first sixty steps -- many of
      ;; them right after a clause was entered, with a goal in hand --
      ;; frozen, and finished by a machine that never saw the query. A goal
      ;; missing from the frozen machine would leave the list short or the
      ;; proof failing, and the query checks its own answer.
      (let ((int stopped . 0) (int right . 0))
        (for ((int lim . 1)) (<= lim 60) ((++ lim))
          (let ((coco_machine ma) (coco_store sa) (coco_engine ea) (coco_strbuf fa)
                (char * blobn . nil) (int rca . 0))
            (coco_machine_init (aof ma))
            (coco_store_init (aof sa))
            (coco_engine_init (aof ea) (aof ma) (aof sa))
            (load_nrev (aof sa) (aof ma))
            (set ($ ea max_steps) (cast u64 lim))
            (coco_engine_ask_text (aof ea) "nrev([1,2,3,4,5,6,7], R), R == [7,6,5,4,3,2,1]")
            (set rca (coco_engine_next (aof ea)))
            ;; a budget that sufficed is a right answer with nothing to resume
            (if (== rca 1) (set right (+ right 1)))
            (if (== rca -1)
                (block (set stopped (+ stopped 1))
                       (coco_sb_init (aof fa))
                       (if (coco_freeze (aof ea) (aof fa)) (set blobn (strdup ($ fa s))))
                       (coco_sb_free (aof fa))))
            (coco_engine_free (aof ea))
            (coco_store_free (aof sa))
            (coco_machine_free (aof ma))
            (if (!= blobn nil)
                (let ((coco_machine mb) (coco_store sb) (coco_engine eb))
                  (coco_machine_init (aof mb))
                  (coco_store_init (aof sb))
                  (coco_engine_init (aof eb) (aof mb) (aof sb))
                  (if (coco_thaw (aof eb) (aof mb) (aof sb) blobn)
                      (block (load_nrev (aof sb) (aof mb))
                             (set ($ eb max_steps) 100000)
                             (if (== (coco_engine_next (aof eb)) 1) (set right (+ right 1)))))
                  (coco_engine_free (aof eb))
                  (coco_store_free (aof sb))
                  (coco_machine_free (aof mb))
                  (free blobn)))))
        (check "the proof was stopped inside, again and again" (cast llong (> stopped 30)) 1)
        (check "each stop, frozen and finished elsewhere, came out right" (cast llong right) 60))

      (printf "\n%s: %d failure(s)\n" (? (== failures 0) "GREEN" "RED") failures)
      (return (? (== failures 0) 0 1)))))

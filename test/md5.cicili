;;;; The fixture of test/files/module_context.pl: a loadable module named
;;;; `md5', standing in for swipl 9.0.4's library(md5), whose one predicate,
;;;; md5_hash/3, is FOREIGN -- so swipl names its errors by the module that
;;;; defines it, error(type_error(text, f(x)), context(md5:md5_hash/3, _)),
;;;; and a message begins `md5:md5_hash/3: '. A loadable module of cocolog
;;;; is named the same way since 3.0.2, and the case runs one file under
;;;; both systems: swipl's own library(md5) there, this module here.
;;;;
;;;; IT HASHES NOTHING. It raises what swipl's raises, in swipl's order (the
;;;; options before the data), for the goals the case gives it, each through
;;;; the SDK's helpers as any module raises -- and answers no hash: a goal
;;;; that would have one fails. test/files.pl builds it as test/library.pl
;;;; builds hoot, Cicili with --release and then -O3, into the sandbox's
;;;; library/, which cocolog searches and swipl does not.

(DEFPARAMETER *md5-predicates*
  '(("md5_hash" 3 md_hash)))

(source "md5.c"
  (make :std #t :compile #f)

  (import "../lib/sdk.cicili")
  (coco-sdk)

  ;;; One element of the option list, swipl's way: encoding(E) with E an
  ;;; atom swipl knows, anything else refused. 1 a good one, else the
  ;;; raise's answer.
  (func md_option ((coco_engine * e) (size_t o)) (out int)
        (let ((u32 n . 0) (const char * f . nil) (size_t v . 0) (const char * a . nil))
          (if (coco_m_is_var e o) (return (coco_m_instantiation_error e)))
          (set f (coco_m_functor e o (aof n)))
          (if (or (== f nil) (!= n 1) (!= 0 (strcmp f "encoding")))
              (return (coco_m_type_error e "option" o)))
          (set v (coco_m_arg e o 0))
          (if (coco_m_is_var e v) (return (coco_m_instantiation_error e)))
          (if (not (coco_m_is_atom e v)) (return (coco_m_type_error e "atom" v)))
          (set a (coco_m_atom e v))
          (if (or (== 0 (strcmp a "utf8")) (== 0 (strcmp a "octet"))) (return 1))
          (return (coco_m_domain_error e "encoding" v))))

  ;;; md5_hash(+Data, -Hash, +Options): the options first, then the data
  ;;; -- unbound, the type error 3.0.0 makes an instantiation error;
  ;;; a compound that is no list, type_error(text, Data).
  (func md_hash ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((d 0) (o 2))
          (let ((size_t * items . nil) (size_t n . 0) (u32 k . 0) (const char * f . nil))
            (if (coco_m_is_var e o) (return (coco_m_instantiation_error e)))
            (if (not (coco_m_list_array e o (aof items) (aof n)))
                (return (coco_m_type_error e "list" o)))
            (for ((size_t i . 0)) (< i n) ((++ i))
              (let ((int rc . #'(md_option e (nth i items))))
                (if (!= rc 1) (block (free items) (return rc)))))
            (free items)
            (if (coco_m_is_var e d) (return (coco_m_type_error e "text" d)))
            (set f (coco_m_functor e d (aof k)))
            (if (and (!= f nil) (> k 0) (not (coco_m_list_length e d (aof n))))
                (return (coco_m_type_error e "text" d)))
            (return 0))))

  (static) (coco-emit-module-dispatch md_dispatch *md5-predicates*)
  (coco-deflibrary "md5" md_dispatch)

  ) ; source

digits_value([], Ce6194b_N, Ce6194b_N).
digits_value([Cffd700_D|C4363d8_Ds], Ce6194b_Acc, Ce6194b_N) :-
    C3cb44b_Next is Ce6194b_Acc * 10 + Cffd700_D,
    digits_value(C4363d8_Ds, C3cb44b_Next, Ce6194b_N).

%% ---------------------------------------------------------------- 4 --
%% Reading a line of text into tokens, out of the pieces C-c C-i offers
%% from library(dcg/basics): blanks, nonblanks//1, string//1, eol, eos.
%%
%% Two things trip people up here, and both look like they ought to work:
%%
%%   *  `|' is not "or" in a grammar body.  It is the bar of a list, and
%%      a rule written with it does not parse.  Disjunction is `;', the
%%      same as in an ordinary clause: ( this ; that ).
%%
%%   *  There is no `...'.  "anything up to what comes next" is
%%      string(_) -- it matches as little as it can and gives more back
%%      on backtracking, so string(_), eol reads to the end of the line.
%%
%% The other trap is not the notation: it is writing a rule with no way
%% of stopping.  Each clause below either reads at least one character
%% or ends the list, which is what makes the whole thing terminate.

:- use_module(library(dcg/basics)).

%% ?- phrase(tokens(Ce6194b_Ts), "go on").
%% ?- phrase(tokens(Ce6194b_Ts), "%r\nfunc").
tokens(Ce6194b_Ts) -->
    blanks,
    more_tokens(Ce6194b_Ts).

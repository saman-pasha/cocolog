%% grammar.colog -- grammar rules (DCG) in cocolog-mode
%%
%% A rule written with --> describes a list instead of a relation:
%%
%%     greeting --> [hello], name.
%%
%% Prolog reads that as an ordinary clause with two extra arguments, the
%% list before the rule has read anything and the list left over
%% afterwards.  What the rule matches is the difference between the two:
%%
%%     greeting(S0, S) :- S0 = [hello|S1], name(S1, S).
%%
%% cocolog-mode runs the translated clause, so the graphs below show the
%% S0 and S that thread through the rules -- watch a list get shorter as
%% the parse goes on.  phrase(Rule, List) proves that Rule describes the
%% whole of List; phrase(Rule, List, Rest) leaves Rest over.
%%
%% Colour variables work here as they do anywhere else: pick a colour
%% with C-c C-v, name it with C-c C-n, run the test case with C-c C-t.

%% ---------------------------------------------------------------- 1 --
%% A sentence grammar that builds a parse tree while it reads.

%% ?- phrase(sentence(Ce6194b_Tree), [the, cat, sleeps]).
%% ?- phrase(sentence(_), [the, cat, sees | Ce6194b_Rest]).
sentence(s(Ce6194b_Noun, C4363d8_Verb)) -->
    noun_phrase(Ce6194b_Noun),
    verb_phrase(C4363d8_Verb).
%% ╭── cocolog trace ── ?- phrase(sentence(Ce6194b_Tree), [the, cat, sleeps]).

%% ╰── cocolog: 5 solutions · 49 inferences

noun_phrase(np(Ce6194b_Det, C4363d8_Noun)) -->
    det(Ce6194b_Det),
    noun(C4363d8_Noun).

verb_phrase(vp(Ce6194b_Verb)) -->
    verb(Ce6194b_Verb).
verb_phrase(vp(Ce6194b_Verb, C4363d8_Object)) -->
    verb(Ce6194b_Verb),
    noun_phrase(C4363d8_Object).

det(the) --> [the].
det(a) --> [a].
noun(cat) --> [cat].
noun(mouse) --> [mouse].
verb(sleeps) --> [sleeps].
verb(sees) --> [sees].

%% The second test case above shows the same grammar generating rather
%% than parsing: the list is only half given, and the rules fill in the
%% rest.

%% ---------------------------------------------------------------- 2 --
%% a^n b^n: the grammar every parser generator is jealous of.

%% ?- phrase(ab, [a, a, b, b]).
%% ?- length(Ce6194b_L, 4), phrase(ab, Ce6194b_L).
ab --> [].
ab --> [a], ab, [b].

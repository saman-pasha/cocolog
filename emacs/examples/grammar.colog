%% ╰── cocolog: 1 solution · 91 inferences

digits([Ce6194b_D|C4363d8_Rest]) -->
    digit(Ce6194b_D),
    digits(C4363d8_Rest).
digits([Ce6194b_D]) -->
    digit(Ce6194b_D).

%% phrase/3 hands back what the rule did not read.
%% ?- phrase(digits(Ce6194b_Ds), "12ab", C4363d8_Rest).
digit(Ce6194b_D) -->
    [Cffd700_Code],
    { Cffd700_Code >= 0'0,
      Cffd700_Code =< 0'9,
      Ce6194b_D is Cffd700_Code - 0'0 }.

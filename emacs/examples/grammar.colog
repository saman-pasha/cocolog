%% ---------------------------------------------------------------- 3 --
%% Reading a number out of a string of character codes.  A goal in
%% braces is plain Prolog: it reads nothing off the list, it just has to
%% hold.

%% ?- phrase(number(Ce6194b_N), "407").
number(Ce6194b_N) -->
    digits(C4363d8_Ds),
    { digits_value(C4363d8_Ds, 0, Ce6194b_N) }.

more_tokens([]) --> eos, !.
%% a remark runs to the end of its line, and is not a token
more_tokens(Ce6194b_Ts) -->
    "%", string(_), ( eol ; eos ), !,
    blanks,
    more_tokens(Ce6194b_Ts).
%% anything else up to the next space is one token
more_tokens([C4363d8_Token|Ce6194b_Ts]) -->
    nonblanks(Cffd700_Cs),
    { Cffd700_Cs \= [], atom_codes(C4363d8_Token, Cffd700_Cs) },
    blanks,
    more_tokens(Ce6194b_Ts).

%% ---------------------------------------------------------------- 5 --
%% A rule can put something back on the list.  Whatever is written
%% after the head, before the arrow, is pushed back once the body has
%% read its part, so this one reads two items and leaves them swapped
%% for whoever reads next.
%%
%% Because it always leaves something behind, phrase/2 cannot succeed
%% with it: phrase(Rule, List) is phrase(Rule, List, []), and it asks
%% for the whole list to be used up.  Ask for the rest with phrase/3,
%% or let a later rule read what was put back -- which is what a
%% pushback is for.

%% ?- phrase(swap(Ce6194b_First, C4363d8_Second), [12, 15], C3cb44b_Rest).
%% ?- phrase((swap(_, _), [Ce6194b_First], [C4363d8_Second]), [12, 15]).
%% ?- phrase(swap(_, _), [12, 15]).
swap(Ce6194b_First, C4363d8_Second), [C4363d8_Second], [Ce6194b_First] -->
    [Ce6194b_First],
    [C4363d8_Second].
%% ╭── cocolog trace ── ?- phrase(swap(Ce6194b_First, C4363d8_Second), [12, 15], C3cb44b_Rest).
%% │ swap(Ce6194b_First, C4363d8_Second, [12, 15], C3cb44b_Rest) ✔ swap(12, 15, [12, 15], [15, …
%% │  ╰── ▸1 swap(Ce6194b_First, C4363d8_Second), [C4363d8_Second], [Ce6194b_First] --> [… ✔

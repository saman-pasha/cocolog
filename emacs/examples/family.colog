%% │ ✔ solution 3:  Who = jim
%% ╰── cocolog: 3 solutions · 70 inferences

%% Two test cases, two graphs.
%% ?- childless(ann).
%% ?- childless(tom).
childless(Ce6194b) :-
    \+ parent(Ce6194b, _).
%% ╭── cocolog trace ── ?- childless(ann).
%% │ childless(ann)                                      ✔
%% │  ╰── ▸1 childless(Ce6194b) :- …                     ✔
%% │      ╰── \+ parent(ann, _)                          ✔
%% │          ╰── parent(ann, _)                         ✘
%% │              ╰── ▸1,2,3,4,5 no matching head        ✘
%% │
%% │ ✔ solution 1:  true
%% ╰── cocolog: 1 solution · 9 inferences
%% ╭── cocolog trace ── ?- childless(tom).
%% │ childless(tom)                                      ✘
%% │  ╰── ▸1 childless(Ce6194b) :- …                     ✘
%% │      ╰── \+ parent(tom, _)                          ✘
%% │          ╰── parent(tom, _)                         ✔ parent(tom, bob)
%% │              ╰── ▸1 parent(tom, bob).               ✔
%% ╰── cocolog: no solutions · 6 inferences

%% These three keep the names of their colours: crimson, blue, gold.
%% ?- sibling(ann, Who).
sibling(Ce6194b, C4363d8) :-
    parent(Cffd700, Ce6194b),
    parent(Cffd700, C4363d8),
    Ce6194b \== C4363d8.
%% ╭── cocolog trace ── ?- sibling(ann, Who).
%% │ sibling(ann, Who)                                   ✔ sibling(ann, pat)
%% │  ╰── ▸1 sibling(Ce6194b, C4363d8) :- …              ✔

%% -*- mode: cocolog -*-
%%
%% A cocolog file is ordinary Prolog.  Variables written Cxxxxxx are
%% *colour variables*: cocolog-mode draws them as coloured swatches, and
%% the same colour inside one clause is the same variable.
%%
%% A variable can be a colour and nothing else, and then that is all you
%% see of it.  Give it a name of your own and the name is written after
%% the colour -- Ce6194b_Grandad is the crimson variable called Grandad
%% -- and the name is what you see, on a background of its colour.  The
%% Cxxxxxx part is never shown: C-c C-n names a variable, C-c C-r
%% recolours it, and C-c C-s shows the file as it stands.
%%
%%   C-c C-v   insert a colour variable (opens the palette; n names it)
%%   C-c C-n   name the variable at point, colour and all
%%   C-c C-r   recolour the variable at point, everywhere in its clause
%%   C-c C-u   drop the colour, keep an ordinary variable
%%   C-c C-p   show which colour is which in this clause
%%   C-c C-s   swatch / name / raw text
%%   C-c C-t   run the test case of the rule at point and draw its graph
%%   C-c C-k   remove the graph again

%% ---------------------------------------------------------------- facts

parent(tom, bob).
parent(tom, liz).
parent(bob, ann).
parent(bob, pat).
parent(pat, jim).

male(tom).
male(bob).
male(jim).
female(liz).
female(ann).
female(pat).

%% ---------------------------------------------------------------- rules

%% ?- grandparent(tom, Who).
grandparent(Ce6194b_Grandad, C4363d8_Kid) :-
    parent(Ce6194b_Grandad, C3cb44b_Between),
    parent(C3cb44b_Between, C4363d8_Kid).
%% ╭── cocolog trace ── ?- grandparent(tom, Who).
%% │ grandparent(tom, Who)                               ✔ ×2 grandparent(tom, ann) ; grandpare…
%% │  ╰── ▸1 grandparent(Ce6194b_Grandad, C4363d8_Kid) :- … ✔
%% │      ├── parent(tom, C3cb44b_Between)               ✔ ×2 parent(tom, bob) ; parent(tom, li…
%% │      │   ├── ▸1 parent(tom, bob).                   ✔
%% │      │   ├── ▸2 parent(tom, liz).                   ✔
%% │      │   ╰── ▸3,4,5 no matching head                ✘
%% │      ├── parent(bob, C4363d8_Kid)                   ✔ ×2 parent(bob, ann) ; parent(bob, pa…
%% │      │   ├── ▸1,2 no matching head                  ✘
%% │      │   ├── ▸3 parent(bob, ann).                   ✔
%% │      │   ├── ▸4 parent(bob, pat).                   ✔
%% │      │   ╰── ▸5 parent(pat, jim).                   ✘
%% │      ╰── parent(liz, C4363d8_Kid)                   ✘
%% │          ╰── ▸1,2,3,4,5 no matching head            ✘
%% │
%% │ ✔ solution 1:  Who = ann
%% │ ✔ solution 2:  Who = pat
%% ╰── cocolog: 2 solutions · 25 inferences

%% ?- ancestor(bob, Who).
ancestor(Ce6194b_Old, C4363d8_Young) :-
    parent(Ce6194b_Old, C4363d8_Young).
ancestor(Ce6194b_Old, C4363d8_Young) :-
    parent(Ce6194b_Old, C3cb44b_Between),
    ancestor(C3cb44b_Between, C4363d8_Young).

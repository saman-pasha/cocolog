%% │      │   ├── ▸1,2 no matching head                  ✘
%% │      │   ├── ▸3 parent(bob, ann).                   ✔
%% │      │   ╰── ▸4,5 no matching head                  ✘
%% │      ├── parent(bob, C4363d8)                       ✔ ×2 parent(bob, ann) ; parent(bob, pa…
%% │      │   ├── ▸1,2 no matching head                  ✘
%% │      │   ├── ▸3 parent(bob, ann).                   ✔
%% │      │   ├── ▸4 parent(bob, pat).                   ✔
%% │      │   ╰── ▸5 parent(pat, jim).                   ✘
%% │      ├── ann \== ann                                ✘
%% │      ╰── ann \== pat                                ✔
%% │
%% │ ✔ solution 1:  Who = pat

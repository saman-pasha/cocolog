%% │  │       ├── ▸4 parent(bob, pat).                   ✔
%% │  │       ╰── ▸5 parent(pat, jim).                   ✘
%% │  ╰── ▸2 ancestor(Ce6194b_Old, C4363d8_Young) :- …   ✔
%% │      ├── parent(bob, C3cb44b_Between)               ✔ ×2 parent(bob, ann) ; parent(bob, pa…
%% │      │   ├── ▸1,2 no matching head                  ✘
%% │      │   ├── ▸3 parent(bob, ann).                   ✔
%% │      │   ├── ▸4 parent(bob, pat).                   ✔
%% │      │   ╰── ▸5 parent(pat, jim).                   ✘
%% │      ├── ancestor(ann, C4363d8_Young)               ✘
%% │      │   ├── ▸1 ancestor(Ce6194b_Old, C4363d8_Young) :- … ✘
%% │      │   │   ╰── parent(ann, C4363d8_Young)         ✘
%% │      │   │       ╰── ▸1,2,3,4,5 no matching head    ✘
%% │      │   ╰── ▸2 ancestor(Ce6194b_Old, C4363d8_Young) :- … ✘
%% │      │       ╰── parent(ann, C3cb44b_Between)       ✘
%% │      │           ╰── ▸1,2,3,4,5 no matching head    ✘
%% │      ╰── ancestor(pat, C4363d8_Young)               ✔ ancestor(pat, jim)
%% │          ├── ▸1 ancestor(Ce6194b_Old, C4363d8_Young) :- … ✔
%% │          │   ╰── parent(pat, C4363d8_Young)         ✔ parent(pat, jim)
%% │          │       ├── ▸1,2,3,4 no matching head      ✘
%% │          │       ╰── ▸5 parent(pat, jim).           ✔
%% │          ╰── ▸2 ancestor(Ce6194b_Old, C4363d8_Young) :- … ✘
%% │              ├── parent(pat, C3cb44b_Between)       ✔ parent(pat, jim)
%% │              │   ├── ▸1,2,3,4 no matching head      ✘
%% │              │   ╰── ▸5 parent(pat, jim).           ✔
%% │              ╰── ancestor(jim, C4363d8_Young)       ✘

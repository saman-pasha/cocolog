-- ---------------------------------------------------------------------------
-- cocolog, step 1: the schema.
--
-- cocolog is a Prolog interpreter (in the Cicili repository) that keeps its
-- knowledge base here rather than in its own memory, so that several
-- interpreters can share one set of clauses and can suspend themselves into
-- the database and be resumed somewhere else.
--
-- TWO THINGS ARE STORED, and they are stored differently on purpose.
--
--   CLAUSES are text -- the canonical written form of the term, which the
--   interpreter's own reader can read back. Text loses nothing that matters
--   (the writer and reader are tested against each other), and it buys three
--   things a binary encoding would not: a person can read the table, a Parsi
--   procedure can search it with an ordinary comparison, and the schema is not
--   tied to the interpreter's cell layout. Change a tag in the interpreter and
--   every clause already in here still loads.
--
--   MACHINE STATE is an opaque blob. Nobody reads a suspended machine by hand,
--   and what it has to do is come back exactly, so it is the interpreter's own
--   serialisation and this schema does not look inside it.
--
-- WHY THE STATE IS IN CHUNKS, AND WHY THEY ARE SMALL. A Text is documented as
-- holding 65,535 bytes, and the wire agrees: a value is written with a 16-bit
-- length. THE STORE DOES NOT. A row has to fit inside a page, and MVCCS/PAGE_SIZE
-- is 8192 by default, so a Text of 8192 comes back as `allocation overflow'
-- while 8000 goes in. Measured, not guessed: 1000 through 8000 store, 8192 and
-- above do not.
--
-- So cocolog splits a machine into chunks of 4000 bytes -- comfortably under
-- the smallest page anyone is likely to configure, with room for the rest of
-- the row -- and puts them back together in `seq' order. One row per machine
-- would have worked until the first interesting program and then failed in a
-- way that read like corruption rather than like a size limit.
--
-- WHY `kb' IS A COLUMN AND NOT A SCHEMA. Two unrelated programs sharing one
-- server should not see each other's clauses, and making each one its own
-- Parsi domain would mean compiling new objects to add a knowledge base.
-- A column costs an index and lets a knowledge base be created by inserting
-- into it.
--
-- WHY THE INDEX IS (kb, name) AND NOT kb AND name. Every read of a predicate
-- -- clauses_of, forget_clauses, the page -- asks `kb == K AND name == N', and
-- the compiler drives an index from its leading column only: over a single
-- `kb' index that was a walk of the WHOLE knowledge base filtered by name,
-- so loading a program of 377 predicates walked its 6 778 clauses 377 times
-- (23.8 s over a mapped store; 72 s before it), and a `name' index beside it
-- served nothing but the cost of a map per row. A composite index answers
-- the pair in one descent and `kb == K' alone through its outer level.
-- CHANGING AN INDEX ON A LIVE STORE: the new tree comes up empty and the old
-- ones stay as orphan pages, so `cocolog vacuum' must run before anything
-- else -- its TRUNCATE rebuilds every index from the live rows.
-- ---------------------------------------------------------------------------

TABLE cocolog::clauses
BEGIN
    COLUMN id      AS Long   PRIMARY KEY;
    -- which knowledge base this clause belongs to
    COLUMN kb      AS String NOT NULL;
    -- the predicate: name and arity together are the identity
    COLUMN name    AS String NOT NULL;
    COLUMN arity   AS Int    NOT NULL;
    INDEX KEY (kb, name);
    -- position within the predicate. Clause order is part of the meaning of a
    -- Prolog program, and a cursor is not ordered, so it travels as data and
    -- the client sorts on it.
    COLUMN ordinal AS Long   NOT NULL;
    -- the clause, written canonically: quoted, with operators kept.
    -- Called `body' and not `text' because a column named `text' collides with
    -- the Text type: Parsi folds names to upper case, and the compiler says
    -- "declaration of TEXT changes meaning of TEXT".
    COLUMN body    AS Text   NOT NULL;
END

SEQUENCE cocolog::clauses_seq
BEGIN
    FROM 1;
    TO Long::MAX;
    STEP 1;
END

-- One row per predicate that has been DECLARED rather than merely written to:
-- so far that means `:- dynamic'. It is a property of the predicate and not of
-- any clause, and it has to outlive the process that declared it, or `:-
-- dynamic' would mean nothing in a knowledge base that is shared -- the next
-- interpreter to open the same kb would not know.
--
-- The row exists whether or not the predicate has clauses. That is the point:
-- `:- dynamic queue/1.' followed by nothing says the predicate is there and
-- empty, which is not the same thing as its not being there.
TABLE cocolog::props
BEGIN
    COLUMN id      AS Long   PRIMARY KEY;
    COLUMN kb      AS String NOT NULL;
    COLUMN name    AS String NOT NULL;
    COLUMN arity   AS Int    NOT NULL;
    INDEX KEY (kb, name);
    -- 1 if the predicate was declared dynamic. A column rather than the mere
    -- existence of the row, because the next property to be stored -- and
    -- `discontiguous' is already parsed and ignored -- belongs beside it.
    COLUMN dynamic AS Int    NOT NULL;
END

SEQUENCE cocolog::props_seq
BEGIN
    FROM 1;
    TO Long::MAX;
    STEP 1;
END

-- One row per suspended machine. `chunks' is how many rows of state belong to
-- it, so a loader knows whether it has them all before it tries to resume.
TABLE cocolog::machines
BEGIN
    COLUMN id      AS Long   PRIMARY KEY;
    COLUMN name    AS String UNIQUE KEY NOT NULL;
    COLUMN kb      AS String INDEX KEY NOT NULL;
    -- suspended | done | failed. A machine that is running is not in here at
    -- all: it is in the memory of whichever interpreter is running it.
    COLUMN status  AS String NOT NULL;
    COLUMN chunks  AS Int    NOT NULL;
    -- NOT NULL, and the reason is not tidiness. An empty String lands in the
    -- store as NULL, and a NULL column cannot be read back at all -- the engine
    -- refuses the whole row with `NULL value'. Nothing cocolog does reads this
    -- column, so that stayed hidden until TRUNCATE, which reads whole rows to
    -- unlink their index entries, and so could never reclaim this table.
    COLUMN note    AS String NOT NULL;
END

SEQUENCE cocolog::machines_seq
BEGIN
    FROM 1;
    TO Long::MAX;
    STEP 1;
END

TABLE cocolog::machine_state
BEGIN
    COLUMN id         AS Long PRIMARY KEY;
    COLUMN machine_id AS Long INDEX KEY NOT NULL;
    COLUMN seq        AS Int  NOT NULL;
    COLUMN chunk      AS Text NOT NULL;
END

SEQUENCE cocolog::machine_state_seq
BEGIN
    FROM 1;
    TO Long::MAX;
    STEP 1;
END

-- One tensor as rows: the id columns say WHICH tensor a row belongs to
-- (the knowledge base and the model's name), `seq' orders its pieces,
-- and `vec' is the one vector field -- the parameters themselves, as
-- doubles, not as text. A tensor wider than a page's worth of doubles
-- spans rows by `seq', the way a machine spans machine_state chunks;
-- the torch module splits at 512, well under the 8192-byte page.
TABLE cocolog::tensors
BEGIN
    COLUMN id   AS Long   PRIMARY KEY;
    COLUMN kb   AS String NOT NULL;
    COLUMN name AS String NOT NULL;
    INDEX KEY (kb, name);
    COLUMN seq  AS Long   NOT NULL;
    COLUMN vec  AS Vector<Double> NOT NULL;
END

SEQUENCE cocolog::tensors_seq
BEGIN
    FROM 1;
    TO Long::MAX;
    STEP 1;
END

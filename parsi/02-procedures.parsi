-- ---------------------------------------------------------------------------
-- cocolog, step 2: the procedures a client calls.
--
-- This is the whole interface between the interpreter and the database. The
-- interpreter's knowledge-base backend calls these and nothing else, which is
-- what lets the same interpreter run against a local store, against this over
-- the binary protocol, or against the pages in step 3 over HTTP.
--
-- EVERY CURSOR CARRIES WHAT IT NEEDS TO BE ORDERED. A SELECT is a cursor and
-- the rows arrive in whatever order the storage engine has them; clause order
-- is part of the meaning of a Prolog program, so `ordinal' and `seq' are
-- selected as columns and the client sorts on them. Doing it here would need
-- an ORDER BY the language does not have, and sorting a handful of rows client
-- side costs nothing.
-- ---------------------------------------------------------------------------

-- Adds one clause at the end of a predicate. The caller supplies the ordinal,
-- because the caller is the one that knows whether this is an assertz at the
-- end or an asserta at the front.
PROCEDURE cocolog::assert_clause(p_kb AS String, p_name AS String, p_arity AS Int,
                                 p_ordinal AS Long, p_body AS Text)
RETURNS Long
REQUIRES cocolog::clauses, cocolog::clauses_seq
BEGIN
    DECLARE id AS Long = cocolog::clauses_seq::NEXT();
    INSERT INTO cocolog::clauses VALUES (id, p_kb, p_name, p_arity, p_ordinal, p_body);
    RETURN id;
END

-- The clauses of one predicate, as a cursor of (ordinal, text). This is the
-- call the interpreter's `fetch' hook makes the first time a predicate is
-- reached: everything above it in the interpreter knows only that clauses
-- arrived from somewhere.
PROCEDURE cocolog::clauses_of(p_kb AS String, p_name AS String, p_arity AS Int)
RETURNS Void
REQUIRES cocolog::clauses
BEGIN
    SELECT ordinal, body
    FROM cocolog::clauses
    WHERE kb == p_kb AND name == p_name AND arity == p_arity;
END

-- How many clauses a predicate has, without moving any of them. Cheap enough
-- to be worth having: a client deciding whether a predicate exists at all does
-- not need the text.
PROCEDURE cocolog::clause_count(p_kb AS String, p_name AS String, p_arity AS Int)
RETURNS Long
REQUIRES cocolog::clauses
BEGIN
    DECLARE total AS Long = 0;
    SELECT total = total + 1
    FROM cocolog::clauses
    WHERE kb == p_kb AND name == p_name AND arity == p_arity;
    RETURN total;
END

-- Every predicate in a knowledge base, one row per clause. What `listing'
-- walks, and what a machine about to resume uses to warm its store.
--
-- NOT called `cocolog::predicates', because the PAGE of that name in
-- 03-pages.parsi would take it. A page and a procedure share one namespace and
-- one compiled object -- `_COCOLOG::PREDICATES_.so' -- and pages are compiled
-- last, so the page wins and every call to the procedure dies with
-- `undefined symbol: call'. The suffix matches `clauses_of' and `machines_of'.
PROCEDURE cocolog::predicates_of(p_kb AS String)
RETURNS Void
REQUIRES cocolog::clauses
BEGIN
    SELECT name, arity, ordinal
    FROM cocolog::clauses
    WHERE kb == p_kb;
END

-- ---------------------------------------------------------------------------
-- Predicate properties
-- ---------------------------------------------------------------------------

-- Declares a predicate dynamic, idempotently. `:- dynamic foo/1.' twice, or in
-- two interpreters at once, has to mean the same thing as once -- so the row is
-- counted first and only inserted if it is not already there.
--
-- Answers 1 if it wrote a row and 0 if the declaration was already on record,
-- which is what a caller wanting to know whether it said anything new asks.
PROCEDURE cocolog::declare_dynamic(p_kb AS String, p_name AS String, p_arity AS Int)
RETURNS Long
REQUIRES cocolog::props, cocolog::props_seq
BEGIN
    DECLARE seen AS Long = 0;
    SELECT seen = seen + 1
    FROM cocolog::props
    WHERE kb == p_kb AND name == p_name AND arity == p_arity;

    IF seen > 0 BEGIN
        RETURN 0;
    END

    DECLARE id AS Long = cocolog::props_seq::NEXT();
    INSERT INTO cocolog::props VALUES (id, p_kb, p_name, p_arity, 1);
    RETURN 1;
END

-- Every declared predicate in a knowledge base, as (name, arity, dynamic).
-- Read alongside `predicates_of' when a store warms itself: that one says what
-- has clauses, this one what has been declared, and a predicate can be in
-- either without being in the other.
PROCEDURE cocolog::props_of(p_kb AS String)
RETURNS Void
REQUIRES cocolog::props
BEGIN
    SELECT name, arity, dynamic
    FROM cocolog::props
    WHERE kb == p_kb;
END

-- ---------------------------------------------------------------------------
-- Removing
-- ---------------------------------------------------------------------------

-- Removes a predicate's CLAUSES and leaves its declaration standing. Answers
-- how many went.
--
-- This is what an assert or a retract calls, and it is not `forget'. Writing a
-- predicate back means clearing it and inserting it again -- clauses are stored
-- by ordinal, so putting one in the middle renumbers the rest -- and if that
-- clearing took the `:- dynamic' row with it, then declaring a predicate and
-- then asserting into it would undeclare it. Retracting a dynamic predicate's
-- last clause leaves it declared and empty, which is exactly what it should be.
PROCEDURE cocolog::forget_clauses(p_kb AS String, p_name AS String, p_arity AS Int)
RETURNS Long
REQUIRES cocolog::clauses
BEGIN
    DECLARE total AS Long = 0;
    SELECT total = total + 1
    FROM cocolog::clauses
    WHERE kb == p_kb AND name == p_name AND arity == p_arity;

    DELETE FROM cocolog::clauses
    WHERE kb == p_kb AND name == p_name AND arity == p_arity;

    RETURN total;
END

-- Removes a predicate outright. Answers how many clauses went.
--
-- The declaration goes with it. `forget' is not `retract every clause' -- that
-- would leave a dynamic predicate declared and empty, which is a real state and
-- reachable by retracting -- it is "this predicate is not in this knowledge
-- base", and a predicate that is not there is not declared either.
PROCEDURE cocolog::forget(p_kb AS String, p_name AS String, p_arity AS Int)
RETURNS Long
REQUIRES cocolog::clauses, cocolog::props
BEGIN
    DECLARE total AS Long = 0;
    SELECT total = total + 1
    FROM cocolog::clauses
    WHERE kb == p_kb AND name == p_name AND arity == p_arity;

    DELETE FROM cocolog::clauses
    WHERE kb == p_kb AND name == p_name AND arity == p_arity;

    DELETE FROM cocolog::props
    WHERE kb == p_kb AND name == p_name AND arity == p_arity;

    RETURN total;
END

-- Empties a whole knowledge base. Used by the tests, which want a clean one.
PROCEDURE cocolog::forget_all(p_kb AS String)
RETURNS Long
REQUIRES cocolog::clauses, cocolog::props, cocolog::tensors
BEGIN
    DECLARE total AS Long = 0;
    SELECT total = total + 1 FROM cocolog::clauses WHERE kb == p_kb;
    DELETE FROM cocolog::clauses WHERE kb == p_kb;
    DELETE FROM cocolog::props WHERE kb == p_kb;
    DELETE FROM cocolog::tensors WHERE kb == p_kb;
    RETURN total;
END

-- The vacuum: reclaims what the store is still holding on to. Under MVCC a
-- deleted row is kept so a transaction entitled to an earlier view can still
-- read it, and nothing takes it away afterwards -- while cocolog deletes
-- constantly without anyone asking it to: saving a machine rewrites its row
-- (machine_open deletes the old one and inserts a replacement, thirty times
-- over a proof), and `forget' then `consult' leaves a dead copy of every
-- clause. The store only ever grows, and every read walks what it grew past:
-- README's "A worked store slows down. Truncate it." has the measured cost
-- (12s empty, 60s aged, 16s after one pass here).
--
-- TRUNCATE frees only rows that are committed as deleted and that no running
-- transaction can still be entitled to. Live rows are untouched, which is why
-- this is safe to run against a knowledge base in use and is a vacuum rather
-- than an emptying. It is NOT per knowledge base, and cannot be: a dead row
-- has no kb to belong to any more. And it spends the store's point-in-time
-- reads -- the reclaimed versions are what SNAPSHOT and
-- rollback_transaction_to read from -- which is why reaching it from Prolog
-- (`vacuum_kb/0') is gated behind the operator's `--vacuum'.
--
-- TRUNCATE IS A STATEMENT AND NOT AN EXPRESSION, so it cannot be added up: the
-- engine knows how many rows it reclaimed and Parsi has no way to ask. The
-- count returned here is therefore the number of LIVE rows left behind, which
-- is the more useful number anyway -- run it twice and the second answer being
-- the same is what says there was nothing left to reclaim.
PROCEDURE cocolog::vacuum()
RETURNS Long
REQUIRES cocolog::clauses, cocolog::props, cocolog::machines, cocolog::machine_state, cocolog::tensors
BEGIN
    DECLARE total AS Long = 0;

    -- machine_state before machines only so that the bulkiest table goes
    -- first; nothing here depends on the order.
    TRUNCATE cocolog::machine_state;
    TRUNCATE cocolog::machines;
    TRUNCATE cocolog::clauses;
    TRUNCATE cocolog::props;
    TRUNCATE cocolog::tensors;

    SELECT total = total + 1 FROM cocolog::clauses;
    SELECT total = total + 1 FROM cocolog::props;
    SELECT total = total + 1 FROM cocolog::machines;
    SELECT total = total + 1 FROM cocolog::machine_state;
    SELECT total = total + 1 FROM cocolog::tensors;

    RETURN total;
END

-- ---------------------------------------------------------------------------
-- Suspended machines
-- ---------------------------------------------------------------------------

-- Registers a machine and answers its id. The state chunks go in afterwards,
-- against that id, which is why this is two calls and not one: the state does
-- not fit in a single Text.
PROCEDURE cocolog::machine_open(p_name AS String, p_kb AS String,
                                p_status AS String, p_chunks AS Int, p_note AS String)
RETURNS Long
REQUIRES cocolog::machines, cocolog::machines_seq, cocolog::machine_state
BEGIN
    -- A machine name is unique, so saving over an existing one has to clear
    -- what was there first -- otherwise the old chunks stay behind and a
    -- loader reassembles a machine out of two different ones.
    DECLARE old AS Long = 0;
    SELECT old = id FROM cocolog::machines WHERE name == p_name;
    IF old > 0 BEGIN
        DELETE FROM cocolog::machine_state WHERE machine_id == old;
        DELETE FROM cocolog::machines WHERE id == old;
    END

    DECLARE id AS Long = cocolog::machines_seq::NEXT();
    INSERT INTO cocolog::machines VALUES (id, p_name, p_kb, p_status, p_chunks, p_note);
    RETURN id;
END

-- Saves OVER a machine that is already there, IN PLACE, and this is the one
-- that stops a name from having two rows.
--
-- WHY IT IS NOT machine_open. That procedure looks the predecessor up by name
-- and deletes it by the id it found, so a lookup that MISSES a row that is
-- there inserts a second row of the same name instead of replacing the first
-- -- and a lookup CAN miss, because a partner mid-save is briefly invisible.
-- `name' is a UNIQUE KEY and the store takes the duplicate anyway.
--
-- SO THE ANSWER IS NOT TO LOOK THE ROW UP AT ALL. A worker already holds the
-- id: it read it out of machine_find when it loaded the machine, and it is
-- the id the claim marked. Handing it back turns a save into an UPDATE by
-- PRIMARY KEY -- no delete, no insert, no second row possible, and no window
-- where the header is briefly nowhere for a partner to read. A machine's id
-- is now stable for its whole life instead of changing every turn.
--
-- The id is still checked before the update, so a caller holding a stale one
-- -- a machine dropped and started again -- gets 0 and falls back to
-- machine_open rather than writing into nothing. That check is by primary
-- key, which is the index this table does not churn.
--
-- AND IT DOES NOT FIX THE DUPLICATION IT WAS WRITTEN FOR, which is the part
-- worth reading. Three threads per machine still produce a machine with
-- eighty-odd rows of one name, about two runs in six -- and with this in
-- place a counter on the machine_open path prints FOUR TIMES A RUN, once per
-- `start'. Nothing inserts those rows. They are versions of one row that the
-- store shows as live, which is below Parsi and not something a procedure can
-- reach. Deleting by NAME rather than by the looked-up id was tried first and
-- did not help either -- 87 rows on the fifth run. STATUS.md has the whole
-- measurement.
PROCEDURE cocolog::machine_save(p_id AS Long, p_status AS String,
                                p_chunks AS Int, p_note AS String)
RETURNS Long
REQUIRES cocolog::machines, cocolog::machine_state
BEGIN
    DECLARE found AS Long = 0;
    SELECT found = id FROM cocolog::machines WHERE id == p_id;
    IF found > 0 BEGIN
        -- The chunks are replaced wholesale; the header's `chunks' column is
        -- updated in the same transaction, so the two agree at every commit.
        DELETE FROM cocolog::machine_state WHERE machine_id == p_id;
        UPDATE cocolog::machines SET status = p_status WHERE id == p_id;
        UPDATE cocolog::machines SET chunks = p_chunks WHERE id == p_id;
        UPDATE cocolog::machines SET note = p_note WHERE id == p_id;
    END
    RETURN found;
END

PROCEDURE cocolog::machine_chunk(p_machine_id AS Long, p_seq AS Int, p_chunk AS Text)
RETURNS Long
REQUIRES cocolog::machine_state, cocolog::machine_state_seq
BEGIN
    DECLARE id AS Long = cocolog::machine_state_seq::NEXT();
    INSERT INTO cocolog::machine_state VALUES (id, p_machine_id, p_seq, p_chunk);
    RETURN id;
END

-- The header of one machine: id, kb, status, chunks. A loader reads this,
-- then asks for the chunks.
PROCEDURE cocolog::machine_find(p_name AS String)
RETURNS Void
REQUIRES cocolog::machines
BEGIN
    SELECT id, kb, status, chunks FROM cocolog::machines WHERE name == p_name;
END

-- The state of one machine, as (seq, chunk). Sorted by the client on `seq'.
PROCEDURE cocolog::machine_load(p_machine_id AS Long)
RETURNS Void
REQUIRES cocolog::machine_state
BEGIN
    SELECT seq, chunk FROM cocolog::machine_state WHERE machine_id == p_machine_id;
END

PROCEDURE cocolog::machine_list(p_kb AS String)
RETURNS Void
REQUIRES cocolog::machines
BEGIN
    SELECT name, status, chunks FROM cocolog::machines WHERE kb == p_kb;
END

PROCEDURE cocolog::machine_drop(p_name AS String)
RETURNS Long
REQUIRES cocolog::machines, cocolog::machine_state
BEGIN
    -- `found' rather than `id', because `SELECT id = id' would be the column
    -- assigned to itself and the variable would stay 0.
    DECLARE found AS Long = 0;
    SELECT found = id FROM cocolog::machines WHERE name == p_name;
    IF found > 0 BEGIN
        DELETE FROM cocolog::machine_state WHERE machine_id == found;
        DELETE FROM cocolog::machines WHERE id == found;
    END
    RETURN found;
END

-- ---------------------------------------------------------------------------
-- Claiming
-- ---------------------------------------------------------------------------

-- Takes one suspended machine and marks it as this worker's, atomically.
--
-- THIS IS WHAT MAKES SEVERAL INTERPRETERS A SCHEDULER RATHER THAN A RACE. Two
-- workers that both load the same machine, both advance it and both save it
-- produce one machine that has lost half its work, and nothing anywhere says
-- so. The claim and the status change happen inside one transaction, so at
-- most one worker leaves this procedure holding a given name.
--
-- A CLAIM IS NOT A LEASE. A worker that dies between claiming and saving
-- leaves the machine marked as its own and nothing will pick it up again;
-- `cocolog::machine_release' is how a supervisor puts one back. A lease with
-- an expiry would be the real answer and would need a clock in the schema.
PROCEDURE cocolog::machine_claim(p_kb AS String, p_worker AS String)
RETURNS String
REQUIRES cocolog::machines
BEGIN
    -- SERIALIZABLE, AND THIS IS THE ONE PLACE IN COCOLOG THAT NEEDS IT.
    -- Everything here is a read followed by a write of the row that was read:
    -- find an idle machine, then mark it. Under READ COMMITTED -- which is what
    -- every other procedure runs at, and rightly -- two workers arriving
    -- together both SELECT the row while it still says `suspended' and both
    -- UPDATE it, and both walk away believing they own it. They then advance
    -- the same state from the same point and the answers come out twice. That
    -- is not a hypothetical: it is what twelve workers did the first time they
    -- ran without a lock around the whole transaction.
    --
    -- WHAT IT COSTS, EXACTLY. ZiguratIP's SERIALIZABLE is a semaphore of one,
    -- and only against other SERIALIZABLE transactions -- a READ COMMITTED
    -- transaction never waits for it. So the claims of twelve workers queue
    -- behind each other for the few microseconds each takes, while the work
    -- that matters -- loading a machine, proving, saving it -- goes on at READ
    -- COMMITTED all at once. A short critical section at the strongest level,
    -- and everything else at the weakest that is still correct.
    TRANSACTION ISOLATION LEVEL SERIALIZABLE;

    DECLARE found AS String = '';
    DECLARE idle  AS String = 'suspended';
    DECLARE empty AS String = '';

    SELECT found = name
    FROM cocolog::machines
    WHERE kb == p_kb AND status == idle;

    -- `<>' is Parsi's not-equal; `!=' is not an operator here.
    IF found <> empty BEGIN
        UPDATE cocolog::machines
        SET status = p_worker
        WHERE name == found;
    END

    -- The claim now RIDES THE TURN'S ONE TRANSACTION instead of committing
    -- ahead of it, so the strong level must be handed back here: the stamps
    -- the claim took stay staged until the turn commits, but the statements
    -- after this -- loading, proving, saving -- run at READ COMMITTED, and
    -- the SERIALIZABLE slot of one goes back to the next claimant instead of
    -- being held for a whole turn.
    TRANSACTION ISOLATION LEVEL READ COMMITTED;

    RETURN found;
END

-- Puts a machine back in the queue, whatever claimed it.
PROCEDURE cocolog::machine_release(p_name AS String)
RETURNS Long
REQUIRES cocolog::machines
BEGIN
    DECLARE idle AS String = 'suspended';
    UPDATE cocolog::machines SET status = idle WHERE name == p_name;
    RETURN 1;
END

-- Claims ONE NAMED machine, if it is idle. What the group test needs: two
-- interpreters taking turns on the same machine, and two other interpreters
-- doing the same on a different one, all four at once. Claiming by name rather
-- than by whatever is free is what keeps a group on its own state.
PROCEDURE cocolog::machine_claim_named(p_name AS String, p_worker AS String)
RETURNS String
REQUIRES cocolog::machines
BEGIN
    -- Read then write of the same row, so it needs the same level and for the
    -- same reason as cocolog::machine_claim above.
    TRANSACTION ISOLATION LEVEL SERIALIZABLE;

    DECLARE found AS String = '';
    DECLARE idle  AS String = 'suspended';
    DECLARE empty AS String = '';

    SELECT found = name
    FROM cocolog::machines
    WHERE name == p_name AND status == idle;

    IF found <> empty BEGIN
        UPDATE cocolog::machines
        SET status = p_worker
        WHERE name == found;
    END

    -- Handed back for the same reason as cocolog::machine_claim above.
    TRANSACTION ISOLATION LEVEL READ COMMITTED;

    RETURN found;
END

-- ---------------------------------------------------------------------------
-- Tensors: model parameters as rows of one vector field
-- ---------------------------------------------------------------------------

-- One piece of one tensor. The caller clears the name first (tensors_forget)
-- when it is SAVING over -- put itself only appends, so the pieces of one
-- save arrive without a window where old and new rows mix.
PROCEDURE cocolog::tensor_put(p_kb AS String, p_name AS String,
                              p_seq AS Long, p_vec AS Vector<Double>)
RETURNS Long
REQUIRES cocolog::tensors, cocolog::tensors_seq
BEGIN
    DECLARE id AS Long = cocolog::tensors_seq::NEXT();
    INSERT INTO cocolog::tensors VALUES (id, p_kb, p_name, p_seq, p_vec);
    RETURN id;
END

-- One piece of one tensor, by its seq. The reader walks seq upward until a
-- piece is not there, so the pieces come back in order without the cursor
-- ever being asked to promise one -- the machine loader's contract.
PROCEDURE cocolog::tensor_piece(p_kb AS String, p_name AS String, p_seq AS Long)
RETURNS Void
REQUIRES cocolog::tensors
BEGIN
    SELECT vec FROM cocolog::tensors
    WHERE kb == p_kb AND name == p_name AND seq == p_seq;
END

PROCEDURE cocolog::tensors_forget(p_kb AS String, p_name AS String)
RETURNS Long
REQUIRES cocolog::tensors
BEGIN
    DECLARE total AS Long = 0;
    SELECT total = total + 1 FROM cocolog::tensors WHERE kb == p_kb AND name == p_name;
    DELETE FROM cocolog::tensors WHERE kb == p_kb AND name == p_name;
    RETURN total;
END

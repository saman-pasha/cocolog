#!/bin/sh
# A pre-commit hook: cocolint over the .pl files this commit stages, and the
# dialect card's citations.
#
# NOT INSTALLED BY ANYTHING. .git/hooks is not tracked and a repository that
# installs its own hooks behind your back is a repository nobody trusts, so
# this is a file you copy on purpose:
#
#     ln -s ../../tools/cocolint/pre-commit .git/hooks/pre-commit
#
# A symlink rather than a copy so it follows the branch you are on. To skip it
# once: git commit --no-verify.
#
# OFFLINE by construction -- this repository's own source and nothing else.
# No server, no model, no network, ever.
#
# THE WORK IS lint.sh --staged, which is the same two halves as --auto: the
# dialect card's citations (a commit to lib/, library/json.pl, parsi/ or
# client/ can move a cited line without touching a .pl) and the .pl files the
# index holds, checked out to a temporary tree so a commit whose staged half
# is broken does not pass on the working tree's content. --quiet leaves a
# commit with no staged .pl silent; the card check still runs.
#
# BOTH HALVES NEED A BUILT BINARY, because both are cocolog now -- there is
# no Python left in this directory. Without one the hook says SKIPPED, out
# loud: a guard that exits 0 for a missing file is indistinguishable from a
# hook that passed. The linter half once tested for `lint.py' and went on
# failing silently on every commit since the rewrite; the lesson is the line
# below, not a test for a file name.

ROOT=$(git rev-parse --show-toplevel) || exit 0
AGENT="$ROOT/tools/cocolint"

[ -f "$AGENT/card.pl" ] || exit 0

if [ ! -x "${COCOLOG_BIN:-$ROOT/cocolog}" ]; then
    echo "cocolint: SKIPPED, no built cocolog -- the linter and the dialect"
    echo "          card are cocolog now. Run make to get both."
    exit 0
fi

if ! sh "$AGENT/lint.sh" --staged --quiet; then
    echo
    echo "cocolint found a HARD divergence in a staged .pl file, or the dialect"
    echo "card cites code that is gone, or that it can no longer tell apart from"
    echo "its namesakes. Every HARD finding fails SILENTLY or nearly so at run"
    echo "time -- that is the rule for being HARD. git commit --no-verify to"
    echo "override; the card is read against the source by hand."
    exit 1
fi

exit 0

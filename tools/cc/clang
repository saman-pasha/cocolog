#!/bin/sh
# On Darwin, Cicili names `clang' outright (config.lisp: "clang by name
# rather than gcc"), the way it names `gcc' elsewhere -- so this is the
# same shim as ./gcc, for that platform. The wrapper it hands over to takes
# this directory off PATH before it execs the real `clang' by name
# (coco_path_off in ./compiler.sh); with the directory still in front, that
# name would be this file again.
exec "$(dirname "$0")/cc" "$@"

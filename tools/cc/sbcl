#!/bin/sh
# SBCL WITH ROOM TO TRANSPILE COCOLOG. Every build here runs `sbcl --script
# cicili.lisp ...' by name -- the Makefile's $(SBCL), embed/build.sh, every
# modules/*/build.sh, test/run.pl's .cicili cases -- and each puts this
# directory first on PATH (env.sh, the Makefile's Cicili step, run.pl), so
# `sbcl' there is this file.
#
# Debian's and Ubuntu's SBCL 2.2.9 starts with a 1 GB dynamic space, and the
# transpile of cocolog.cicili does not fit in it: "Heap exhausted during
# garbage collection ... GC invariant lost", midway, in COMPILE-ATOM <
# COMPILE-ARGS < COMPILE-CALL < COMPILE-SIZEOF. A plain `make' stopped there,
# and so did every script that ran one (reported from cicili-lang, Ubuntu
# 24.04). So the real sbcl is handed a dynamic space of 4096 MB whenever its
# own default is smaller and the caller named none; a default that is
# already larger is left alone. The size is reserved, not taken: SBCL maps
# it and touches only what it uses.
#
#   COCO_SBCL_HEAP=N    the size to give, in MB (4096)
#   --dynamic-space-size on the command line is obeyed as written
#
# THE REAL sbcl IS LOOKED UP WITHOUT THIS DIRECTORY, AND RUN WITH IT. Unlike
# ./cc and ./cxx, which take the directory off PATH before they exec the
# compiler, this shim must leave PATH as it found it: the Cicili inside the
# sbcl compiles by naming `gcc', and only this directory's ./gcc makes that
# clang. A first version took the directory off PATH for the sbcl too, and
# that build's objects said `GCC: (Ubuntu 13.3.0...)' in .comment.
#
# NOR IS ANOTHER CHECKOUT'S SHIM THE REAL ONE (3.0.3). With two checkouts'
# tools/cc on PATH -- a worktree's make run from a shell that sourced the
# other checkout's env.sh -- each shim took the other for the real sbcl and
# asked it its dynamic space, which asked the first: the two called each
# other for ever, hundreds of shells deep, and the build never began. A
# sbcl that carries this file's first comment line is a shim, and passed by.
here=$(cd "$(dirname "$0")" && pwd)
real=
save=$IFS; IFS=:
for d in $PATH; do
  [ -n "$d" ] || d=.
  [ "$d" = "$here" ] && continue
  [ -f "$d/sbcl" ] && [ -x "$d/sbcl" ] || continue
  grep -q 'SBCL WITH ROOM TO TRANSPILE COCOLOG' "$d/sbcl" 2>/dev/null && continue
  real=$d/sbcl; break
done
IFS=$save
[ -n "$real" ] || { echo "tools/cc/sbcl: no sbcl on PATH besides this shim" >&2; exit 127; }
want=${COCO_SBCL_HEAP:-4096}
for a in "$@"; do
  case "$a" in --dynamic-space-size|--dynamic-space-size=*) exec "$real" "$@" ;; esac
done
have=$("$real" --noinform --no-sysinit --no-userinit --non-interactive \
         --eval '(progn (princ (floor (sb-ext:dynamic-space-size) 1048576)) (terpri))' 2>/dev/null)
case "$have" in ''|*[!0-9]*) have=0 ;; esac
[ "$have" -lt "$want" ] && exec "$real" --dynamic-space-size "$want" "$@"
exec "$real" "$@"
